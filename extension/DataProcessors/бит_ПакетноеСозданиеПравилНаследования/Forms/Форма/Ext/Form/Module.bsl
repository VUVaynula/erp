&НаКлиенте
Функция ЕстьОшибкиЗаполнения()
	
	Отказ = Ложь;
	ПоляПроверкиЗаполнения = Новый Соответствие;
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству"),
		"СвойствоПродукцииПредставление");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле"),
		"АлгоритмРасчетаЗначения");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму"),
		"АлгоритмРасчетаЗначенияПредставление");
	
	ШаблонСообщения = НСтр("ru = 'Необходимо заполнить значение настройки соответствия в строке %1';
							|en = 'Fill in setting value in line %1'");
	
	Для каждого СтрокаСоответствие Из СоответствиеСвойств Цикл
		
		ПроверяемоеПоле = ПоляПроверкиЗаполнения[СтрокаСоответствие.СпособПодбораЗначения];
		Если ПроверяемоеПоле <> Неопределено И НЕ ЗначениеЗаполнено(СтрокаСоответствие[ПроверяемоеПоле]) Тогда
			ИндексСтроки = СоответствиеСвойств.Индекс(СтрокаСоответствие);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
														СтрШаблон(ШаблонСообщения, ИндексСтроки+1),,
														"СоответствиеСвойств["+ИндексСтроки+"]."+ПроверяемоеПоле,,Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;

КонецФункции

&НаКлиенте
Процедура ПоказатьСкрытьВсеПараметры(Команда)
	
	РежимВсеПараметры = Не РежимВсеПараметры;
	ЗаголовокВсеПараметры();
	НастроитьВидимостьВсеПараметры();  
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьВсеПараметры()
	
	ДоступностьКнопкиСохранения();
	
	Если ПравилаНаследования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимВсеПараметры Тогда            
		Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
			Элементы["ПравилаНаследованияКолонкаЗначение" + сч].Видимость = Истина;
		КонецЦикла;		
	Иначе
		ОпределитьВидимостьКолонокПравилаНаследованияНаСервере();
	КонецЕсли;
	Элементы.ПравилаНаследованияНомер.Ширина = 3;
	
КонецПроцедуры                                                   

&НаСервере
Процедура ОпределитьВидимостьКолонокПравилаНаследованияНаСервере()
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл                                 
		ИмяКолонки = "Изменена" + сч;
		тИзменена = ПравилаНаследования.Выгрузить(, ИмяКолонки);
		тИзменена.Сортировать(ИмяКолонки+ " убыв");
		Элементы["ПравилаНаследованияКолонкаЗначение" + сч].Видимость = тИзменена[0][ИмяКолонки]; 	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаголовокВсеПараметры()
	
	Если РежимВсеПараметры Тогда
		ПрефиксКнопки = "Скрыть";
	Иначе
		ПрефиксКнопки = "Показать";
	КонецЕсли;
	Элементы.ПравилаНаследованияПоказатьСкрытьВсеПараметры.Заголовок = ПрефиксКнопки + " все параметры";
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	ПравилаНаследования.Очистить();
	СоответствиеПравилИнициализация();
	ДоступностьКнопкиСохранения();
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	ТД = Элементы.ПравилаНаследования.ТекущиеДанные;
	Если ТД <> Неопределено Тогда
		
		нов = ПравилаНаследования.Добавить();
		ЗаполнитьЗначенияСвойств(нов, ТД);
		ТД.УникальныйИдентификатор = Строка(Новый УникальныйИдентификатор);
	
		ПересчитатьНумерациюСтрок();
		
		ДобавитьВКоллекциюПравил(ТД.УникальныйИдентификатор);
	
	КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)      
	
	ТекущаяСтрока = Элементы.ПравилаНаследования.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда            
		УдалитьИзСпискаПравил(ТекущаяСтрока.уникальныйИдентификатор);
        ПравилаНаследования.Удалить(ПравилаНаследования.НайтиПоИдентификатору(ТекущаяСтрока.ПолучитьИдентификатор()));
	КонецЕсли;  
	ПересчитатьНумерациюСтрок();
	Если Элементы.ПравилаНаследования.ТекущиеДанные <> Неопределено Тогда
		ТекущийУид = Элементы.ПравилаНаследования.ТекущиеДанные.уникальныйИдентификатор;
		ОбновитьНастройкуСоответствия();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствПриИзменении(Элемент)

	ОпределениеИзмененияНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределениеИзмененияНастройки()
	
	ТД = Элементы.СоответствиеСвойств.ТекущиеДанные;
	НастройкаСоответствия = Новый Структура(УправлениеДаннымиОбИзделияхКлиентСервер.РеквизитыНастройкаСоответствияСвойств());
	ЗаполнитьЗначенияСвойств(НастройкаСоответствия, ТД);
	
	
	СтрокаИсходныхДанных = СоответствиеСвойствИсходныеЗначения.НайтиСтроки(Новый Структура("СвойствоМатериала", ТД.СвойствоМатериала))[0];
	
	НастройкаСоответствияИсхДанных = Новый Структура(УправлениеДаннымиОбИзделияхКлиентСервер.РеквизитыНастройкаСоответствияСвойств());
	ЗаполнитьЗначенияСвойств(НастройкаСоответствияИсхДанных, СтрокаИсходныхДанных);
	ТД.Изменена = Ложь;
	Для каждого стр из НастройкаСоответствия Цикл
		Если стр.Значение <> НастройкаСоответствияИсхДанных[стр.Ключ] Тогда
			ТД.Изменена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	
КонецПроцедуры
&НаКлиенте
Процедура Добавить(Команда)              
	
	Если ЕстьОшибкиЗаполнения() Тогда
		Возврат;
	КонецЕсли;
	
	ИД = Строка(Новый УникальныйИдентификатор);
	ДобавитьВКоллекциюПравил(ИД);
	
	нов = ПравилаНаследования.Добавить();  
	нов.Количество = 1;
	нов.УникальныйИдентификатор = ИД;
	
	ЗаполнитьЗначенияСтрокиПравилНаследования(нов);
	
	ПересчитатьНумерациюСтрок();
	
	Элементы.ПравилаНаследования.ТекущаяСтрока = нов.ПолучитьИдентификатор(); 
    ДоступностьКнопкиСохранения();
	// перерисуем нижнюю ТЧ
	НастроитьВидимостьВсеПараметры();
	
КонецПроцедуры               

&НаСервере
Процедура ДобавитьВКоллекциюПравил(ИД)
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	Соответствие.Вставить(ИД, СоответствиеСвойств.Выгрузить());
	АдресСпискаПравил = ПоместитьВоВременноеХранилище(Соответствие, УИДАдреса);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИзСпискаПравил(ИД)
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	Соответствие.Удалить(ИД);
	АдресСпискаПравил = ПоместитьВоВременноеХранилище(Соответствие, УИДАдреса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияСтрокиПравилНаследования(нов) 
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл         
		СпособПодбораЗначения = СоответствиеСвойств[сч].СпособПодбораЗначения;
		
		нов["СпособПодбораЗначения" + сч] = СпособПодбораЗначения;      
		Если СпособПодбораЗначения 		= ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству") Тогда
			
			ЗначениеСвойства 			= СоответствиеСвойств[сч].СвойствоПродукции;
			ЗначениеСвойстваПоУмолчанию = СоответствиеСвойствИсходныеЗначения[сч].СвойствоПродукции;
			
		ИначеЕсли СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению") 
			Или СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение") Тогда
			
			ЗначениеСвойства 			= СоответствиеСвойств[сч].ЗначениеСвойства;
			ЗначениеСвойстваПоУмолчанию = СоответствиеСвойствИсходныеЗначения[сч].ЗначениеСвойства;
			
		ИначеЕсли СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле") Тогда
			
			ЗначениеСвойства 			= СоответствиеСвойств[сч].АлгоритмРасчетаЗначения;
			ЗначениеСвойстваПоУмолчанию = СоответствиеСвойствИсходныеЗначения[сч].АлгоритмРасчетаЗначения; 
			
		ИначеЕсли СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму") Тогда
			
			ЗначениеСвойства 			= СоответствиеСвойств[сч].АлгоритмРасчетаЗначенияПредставление;
			ЗначениеСвойстваПоУмолчанию = СоответствиеСвойствИсходныеЗначения[сч].АлгоритмРасчетаЗначенияПредставление;
			
		Иначе
			ЗначениеСвойства = "";        
			ЗначениеСвойстваПоУмолчанию = "";
		КонецЕсли;
		
		нов["КолонкаЗначение" + сч] = ЗначениеСвойства;
		нов["Изменена" + сч] = ЗначениеСвойства <> ЗначениеСвойстваПоУмолчанию;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНумерациюСтрок()
	
	Для сч = 0 по ПравилаНаследования.Количество() - 1 Цикл
		ПравилаНаследования[сч].Номер = сч + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНаследованияПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент <> Неопределено Тогда
		ИмяЯчейки = Элемент.ТекущийЭлемент.Имя;
		Если ИмяЯчейки = "ПравилаНаследованияНомер"
			Или ИмяЯчейки = "ПравилаНаследованияКоличество"
			Или ИмяЯчейки = "ПравилаНаследованияУникальныйИдентификатор" Тогда
			Возврат;
		КонецЕсли;
		
		ИмяЯчейки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ПравилаНаследованияКолонкаЗначение", "СпособПодбораЗначения");
		ТД = Элементы.ПравилаНаследования.ТекущиеДанные;
		Если ТД <> Неопределено Тогда 
			СпособОпределенияХарактеристики = ТД[ИмяЯчейки];
			
			Если ТекущийУид <> ТД.УникальныйИдентификатор Тогда
				ТекущийУид = ТД.УникальныйИдентификатор; 
				
				ОбновитьНастройкуСоответствия(); 
			КонецЕсли;
			// установить текущую строку               
			ИндексСтрокиНастройки = Число(СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ПравилаНаследованияКолонкаЗначение", ""));
			Элементы.СоответствиеСвойств.ТекущаяСтрока = СоответствиеСвойств[ИндексСтрокиНастройки].ПолучитьИдентификатор();
		Иначе                                 
			СпособОпределенияХарактеристики = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПустаяСсылка");
		КонецЕсли;                            
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкуСоответствия()
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	СоответствиеСвойств.Загрузить(Соответствие.Получить(ТекущийУид));
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	ЗаполнитьПоУмолчаниюНаСервере();
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()
	СоответствиеСвойств.Загрузить(СоответствиеСвойствИсходныеЗначения.Выгрузить());
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствСвойствоПродукцииПриИзменении(Элемент)
	ОпределениеИзмененияНастройки();
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствЗначениеСвойстваПриИзменении(Элемент)
	ОпределениеИзмененияНастройки();
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствАлгоритмРасчетаЗначенияПриИзменении(Элемент)
	ОпределениеИзмененияНастройки();
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствФункцияРасчетаЗначенияПриИзменении(Элемент)
	ОпределениеИзмененияНастройки();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)           
	Если ТекущийУид = "" Или ПравилаНаследования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьОшибкиЗаполнения() Тогда
