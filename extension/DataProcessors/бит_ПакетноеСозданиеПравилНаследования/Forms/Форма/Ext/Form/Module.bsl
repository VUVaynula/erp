// Получает значение параметра ВИ.
// Вместо варианта исполнения понимает структуры
//   - глПолучитьСтруктуруПараметровВИ()
//   - глПолучитьСтруктуруПараметровВИ()
//
// Параметры:
//  ВхВариантИсп_Объект	 - ВИОбъект, структура	 - 
//  ВхПараметр			 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция глПолучитьЗначениеПараметраВИ(ВхВариантИсп_Объект, ВхПараметр) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] + 
	
	Если глПустоеЗначение(ВхВариантИсп_Объект) Тогда
		//_ТекстОшибки = "Не указан ВИ";
		Возврат Неопределено;
	КонецЕсли;
	
	_БазовыйВИ = ВхВариантИсп_Объект;//?(ВхВариантИсп_Объект.ЭтоСлужебныйПолуфабрикат, ВхВариантИсп_Объект.БазовыйВариантИсполнения, ВхВариантИсп_Объект);
	
	Если ТипЗнч(ВхПараметр) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		
		строка_ТЧПараметры = _БазовыйВИ.ДополнительныеРеквизиты.Найти(ВхПараметр, "Свойство");
		Если строка_ТЧПараметры = Неопределено Тогда
			//_ТекстОшибки = "Параметр отсутствует у ВИ";
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат строка_ТЧПараметры.Значение;
		
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("Строка") Тогда
		
		Если Лев(ВхПараметр, 8) = "Параметр" Тогда
			
			_Параметр = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(Сред(ВхПараметр, 9, 3));
			Если _Параметр = Неопределено Тогда
				//_ТекстОшибки = "Ошибка идентификации параметра";
				Возврат Неопределено;
			КонецЕсли;
			
			строка_ТЧПараметры = _БазовыйВИ.ДополнительныеРеквизиты.Найти(_Параметр, "Свойство");
			Если строка_ТЧПараметры = Неопределено Тогда
				//_ТекстОшибки = "Параметр отсутствует у ВИ";
				Возврат Неопределено;
			КонецЕсли;
			
			Возврат строка_ТЧПараметры.Значение;
			
		Иначе
			
			_ИмяПараметра = СокрЛП(ВхПараметр);
			
			Попытка
				
				Возврат _БазовыйВИ[_ИмяПараметра];
				
			Исключение

				Возврат Неопределено;
				
			КонецПопытки
			
		КонецЕсли;
		
	Иначе
		
		//_ТекстОшибки = "Недопустимый тип";
		Возврат Неопределено;
		
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] -
	
КонецФункции //

