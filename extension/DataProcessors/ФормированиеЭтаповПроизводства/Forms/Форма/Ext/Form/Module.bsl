Процедура бит_СобратьРаспоряженияИзСтрокДерева(СтрокиДерева, МассивРаспоряжений) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.17]  [VUVaynula@1cbit.ru] [30.03.2026 3:56:44] +        
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Распоряжение) И ТипЗнч(СтрокаДерева.Распоряжение) = Тип("ДокументСсылка.ЗаказНаПроизводство2_2") Тогда
			Если МассивРаспоряжений.Найти(СтрокаДерева.Распоряжение) = Неопределено Тогда
				МассивРаспоряжений.Добавить(СтрокаДерева.Распоряжение);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			бит_СобратьРаспоряженияИзСтрокДерева(СтрокаДерева.Строки, МассивРаспоряжений);
		КонецЕсли;
		
	КонецЦикла;
	// }}ПервыйБИТ ЛистТребований [ЛТ6.17]  [VUVaynula@1cbit.ru] [30.03.2026 3:56:44] -
