Функция ПолучитьХарактеристикиНоменклатуры(Владелец)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Характеристики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|ГДЕ
	|	Характеристики.Владелец в (&Владелец)
	|	И Не Характеристики.ПометкаУдаления";
	
	мВладелец = Новый Массив;
	мВладелец.Добавить(Владелец);
	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда 
		// добавим еще и вид номенклатуры
		мВладелец.Добавить(Владелец.ВидНоменклатуры);
	КонецЕсли;
	
	тзРезультат = Запрос.Выполнить().Выгрузить();
	Если тзРезультат.Количество() Тогда
		Результат = тзРезультат.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Результат;
	
