		Возврат;
	КонецЕсли;
	
	мВидовНоменклатур = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыДляСозданияПодчиненныхХарактеристик);
	Если мВидовНоменклатур.Найти(ВидНом) = Неопределено Тогда
		Возврат;
	КонецЕсли;                                                                                  
	
	Если РесурснаяСпецификацияОбъект = Неопределено Тогда                        
		Спецификация = Неопределено;
