	//СписокНоменклатуры = Новый Массив;  
	// Построить дерево спецификаций
	Если Спецификация <> Неопределено Тогда
		РесурснаяСпецификацияОбъект = Спецификация.ПолучитьОбъект();
	Иначе
		Возврат;
	КонецЕсли;
	
	ДеревоСпецификаций = ПостроитьДеревоСпецификации(РесурснаяСпецификацияОбъект);
	// проверить характеристики и создать при необходимости          
	СписокХарактеристик = ПолучитьХарактеристикиНоменклатуры(Номенклатура);
	Для каждого стр из СписокХарактеристик Цикл
		ТекущиеДанные = ДеревоСпецификаций.НайтиПоИдентификатору(0);
		Если ТекущиеДанные.ВидСтроки = ПредопределенноеЗначение("Перечисление.ВидыСтрокДереваСпецификаций.ВыходноеИзделие") Тогда
			ИмяТЧ = "ВыходныеИзделия";
		Иначе
			ИмяТЧ = "МатериалыИУслуги";
		КонецЕсли;
		
		
	КонецЦикла;
	


