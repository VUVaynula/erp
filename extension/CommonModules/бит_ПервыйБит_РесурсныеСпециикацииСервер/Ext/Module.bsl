// {{ПервыйБИТ ЛистТребований [ЛТ6.12]  [VUVaynula@1cbit.ru] [20.04.2026 15:05:23] +        
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.РесурсныеСпецификации") Тогда
