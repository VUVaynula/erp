Процедура РаспределитьСверхнормативныеМатериалы(ЗаказНаПроизводство) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.17]  [VUVaynula@1cbit.ru] [29.03.2026 20:40:07] +      
	// Для каждого материала сначала происходит удаление строк из этапов производства по совпадению ключей 
	// "Номенклатура" + "Характеристика" + "Статья калькуляции". 
	
	// Далее происходит повторное распределение материала между этапами "Заказа на производство" 
	// пропорционально использованному материала от общего объема в заказе на производство по логике, аналогичной в задаче 1, за исключением:
	
	// Если этап находится в статусе "Закрыт", то происходит перезаполнение не только вкладки "Обеспечение", 
	// но и вкладки "Расход". 
	
	// На вкладке "Обеспечение" устанавливается признак "Отгрузить". 
	// "Дата отгрузки" в строке распределенного материала устанавливается "Текущая дата" для обоих вкладок документа. 
	// На вкладке "Дополнительно" в поле "Завершен" устанавливается текущая  дата. 
	мЭтапов = Документы.ЗаказНаПроизводство2_2.бит_СобратьЭтапыПоЗаказу(ЗаказНаПроизводство.Ссылка, Истина);  
	Если мЭтапов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	ТекДата = ТекущаяДатаСеанса();
	
	НачатьТранзакцию();
	Попытка           
		// получим объект заказа
		Если ТипЗнч(ЗаказНаПроизводство) = Тип("ДокументОбъект.ЗаказНаПроизводство2_2") Тогда
			ОбъектЗаказ = ЗаказНаПроизводство; 
			ЭтоСсылка = Ложь;
		Иначе
			ОбъектЗаказ = ЗаказНаПроизводство.ПолучитьОбъект();
			ЭтоСсылка = Истина;
		КонецЕсли;
		// Строки сверхнормативных материалов, которые еще не распределены
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.Номенклатура КАК Номенклатура,
		                      |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.Характеристика КАК Характеристика,
		                      |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.СтатьяКалькуляции КАК СтатьяКалькуляции,
		                      |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.Количество КАК Количество, 
							  |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.Склад КАК Склад,
		                      |	ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.НомерСтроки КАК НомерСтроки
		                      |ПОМЕСТИТЬ втТаблицаКРаспредению
		                      |ИЗ
		                      |	Документ.ЗаказНаПроизводство2_2.бит_СверхнормативныеМатериалы КАК ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы
		                      |ГДЕ
		                      |	НЕ ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.ПризнакРаспределенияМатериалов
		                      |	И ЗаказНаПроизводство2_2бит_СверхнормативныеМатериалы.Ссылка = &ЗаказНаПроизводство
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка КАК Этап,
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.НомерСтроки КАК НомерСтроки
		                      |ИЗ
		                      |	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТаблицаКРаспредению КАК втТаблицаКРаспредению
		                      |		ПО ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = втТаблицаКРаспредению.Номенклатура
		                      |			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика = втТаблицаКРаспредению.Характеристика
		                      |			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.СтатьяКалькуляции = втТаблицаКРаспредению.СтатьяКалькуляции
		                      |ГДЕ
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка В(&мЭтапов)
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	Этап,
		                      |	НомерСтроки УБЫВ
		                      |ИТОГИ ПО
		                      |	Этап
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	ЭтапПроизводства2_2РасходМатериаловИРабот.Ссылка КАК Этап,
		                      |	ЭтапПроизводства2_2РасходМатериаловИРабот.НомерСтроки КАК НомерСтроки
		                      |ИЗ
		                      |	Документ.ЭтапПроизводства2_2.РасходМатериаловИРабот КАК ЭтапПроизводства2_2РасходМатериаловИРабот
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТаблицаКРаспредению КАК втТаблицаКРаспредению
		                      |		ПО ЭтапПроизводства2_2РасходМатериаловИРабот.Номенклатура = втТаблицаКРаспредению.Номенклатура
		                      |			И ЭтапПроизводства2_2РасходМатериаловИРабот.Характеристика = втТаблицаКРаспредению.Характеристика
		                      |			И ЭтапПроизводства2_2РасходМатериаловИРабот.СтатьяКалькуляции = втТаблицаКРаспредению.СтатьяКалькуляции
		                      |ГДЕ
		                      |	ЭтапПроизводства2_2РасходМатериаловИРабот.Ссылка В(&мЭтапов)
		                      |	И ЭтапПроизводства2_2РасходМатериаловИРабот.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	Этап,
		                      |	НомерСтроки УБЫВ
		                      |ИТОГИ ПО
		                      |	Этап
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка КАК Этап,
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика КАК Характеристика,
		                      |	СУММА(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество) КАК Количество
		                      |ИЗ
		                      |	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТаблицаКРаспредению КАК втТаблицаКРаспредению
		                      |		ПО ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = втТаблицаКРаспредению.Номенклатура
		                      |			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика = втТаблицаКРаспредению.Характеристика
		                      |ГДЕ
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка В(&мЭтапов)
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка,
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура,
		                      |	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика");
		Запрос.УстановитьПараметр("ЗаказНаПроизводство", ЗаказНаПроизводство.Ссылка);  
		Запрос.УстановитьПараметр("мЭтапов", мЭтапов);     
		Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		ТаблицаКРаспредению 		= Результат[0].Выгрузить();
		ВыборкаКУдалениюматериалы   = Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаКУдалениюРасход		= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ТаблицаКДобавлению 			= Результат[3].Выгрузить();
		
		// Получим соответствие этап ссылка - этап объект в память один раз  
		ЭтапыПоСсылке = Новый Соответствие;
		Для Каждого ЭтапСсылка Из мЭтапов Цикл
			Если ЗначениеЗаполнено(ЭтапСсылка) Тогда
				ЭтапыПоСсылке.Вставить(ЭтапСсылка, ЭтапСсылка.ПолучитьОбъект());
			КонецЕсли;
		КонецЦикла;
		// Сначала удаляем старые строки из этапов по полному ключу: Номенклатура + Характеристика + СтатьяКалькуляции
			// ОбеспечениеМатериаламиИРаботами
		Пока ВыборкаКУдалениюМатериалы.Следующий() Цикл
			ЭтапОбъект = ЭтапыПоСсылке.Получить(ВыборкаКУдалениюматериалы.Этап); 
			ЭтапОбъект.ДополнительныеСвойства.Вставить("Изменен", истина);
			Детали = ВыборкаКУдалениюМатериалы.Выбрать();
			Пока Детали.Следующий() Цикл
				СтрокаКУдалению = ЭтапОбъект.ОбеспечениеМатериаламиИРаботами.Найти(Детали.НомерСтроки, "НомерСтроки");
				ЭтапОбъект.ОбеспечениеМатериаламиИРаботами.Удалить(СтрокаКУдалению);
			КонецЦикла;
		КонецЦикла;
			// РасходМатериаловИРабот 
		Пока ВыборкаКУдалениюРасход.Следующий() Цикл
			ЭтапОбъект = ЭтапыПоСсылке.Получить(ВыборкаКУдалениюРасход.Этап);
			Если не ЭтапОбъект.ДополнительныеСвойства.Свойство("Изменен") Тогда
				ЭтапОбъект.ДополнительныеСвойства.Вставить("Изменен", истина);
			КонецЕсли;
			
			Детали = ВыборкаКУдалениюРасход.Выбрать();
			Пока Детали.Следующий() Цикл
				СтрокаКУдалению = ЭтапОбъект.РасходМатериаловИРабот.Найти(Детали.НомерСтроки, "НомерСтроки");
				ЭтапОбъект.РасходМатериаловИРабот.Удалить(СтрокаКУдалению);
			КонецЦикла;
		КонецЦикла;
		// ------------------------------------------------------------------------------------------------------------
		// Теперь распределяем:
		РаспределитьПоЭтапам(ЭтапыПоСсылке, ТаблицаКРаспредению, ТаблицаКДобавлению);
		// ------------------------------------------------------------------------------------------------------------
		// записываем все оставшиеся этапы
		Для каждого стр из ЭтапыПоСсылке Цикл
			Если стр.Значение.ДополнительныеСвойства.Свойство("Изменен") Тогда
				стр.Значение.Записать();
			КонецЕсли;
		КонецЦикла;
		// проставляем флаг в заказе распределено = истина 
		// (необязательно, т.к. все равно пересчитывается, но сделаем - вдруг понадобится где то еще)
		Для каждого стр из ТаблицаКРаспредению Цикл
			строкаПоКлючу = ОбъектЗаказ.бит_СверхнормативныеМатериалы.Найти(стр.НомерСтроки, "НомерСтроки");
			строкаПоКлючу.ПризнакРаспределенияМатериалов = Истина;
		КонецЦикла;
		// если передан объект то записывать не будем. Если ссылка - будем.
		Если ЭтоСсылка Тогда
			ОбъектЗаказ.Записать();
		КонецЕсли;
		// ------------------------------
		ЗафиксироватьТранзакцию();
	Исключение               
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось завершить распределение по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтменитьТранзакцию();
