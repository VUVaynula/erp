Функция бит_СобратьЭтапыПоЗаказу(ЗаказНаПроизводствоСсылка, ТолькоДокументы = Ложь) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.17]  [VUVaynula@1cbit.ru] [29.03.2026 18:33:09] +        
	Если Не ЗначениеЗаполнено(ЗаказНаПроизводствоСсылка) Тогда   
		Возврат бит_СоздатьПустуюТаблицуПар();
	КонецЕсли;
	
	ПФ = Новый Структура;
	ПФ.Вставить("Заказ", ЗаказНаПроизводствоСсылка);
	ПФ.Вставить("ПоказыватьЭтапы", Истина);
	ПФ.Вставить("ПоказыватьПеремещения", Ложь);
	ПФ.Вставить("ПоказыватьМатериалы", Истина);
	ПФ.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	ПФ.Вставить("Этапы", Новый ФиксированныйМассив(Новый Массив));
	
	СтруктураЭтапыАналитика = Новый Структура;
	СтруктураЭтапыАналитика.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());	
	СтруктураЭтапыАналитика.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	СтруктураЭтапыАналитика.Вставить("Склад", Неопределено);
	СтруктураЭтапыАналитика.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());  
	
	ПФ.Вставить("ЭтапыАналитика", СтруктураЭтапыАналитика);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено);
	
	// Отчет строит дерево через менеджер                                                    
	Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ПостроитьДеревоЗаказа(ПФ, АдресХранилища);
	
	ДеревоДанных = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Результат = Новый Массив;
	
	Если ДеревоДанных <> Неопределено Тогда
		Если ТипЗнч(ДеревоДанных) = Тип("ДеревоЗначений") Тогда
			бит_СобратьЭтапы(ДеревоДанных.Строки, Результат, ТолькоДокументы);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = новый Запрос("ВЫБРАТЬ
	                      |	ЭтапПроизводства2_2.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	                      |ГДЕ
	                      |	ЭтапПроизводства2_2.Проведен
	                      |	И ЭтапПроизводства2_2.Распоряжение = &Распоряжение
	                      |	И НЕ ЭтапПроизводства2_2.Ссылка В (&мЭтапов)");
	Запрос.УстановитьПараметр("мЭтапов", Результат);
	Запрос.УстановитьПараметр("Распоряжение", ЗаказНаПроизводствоСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Возврат Результат;
	// }}ПервыйБИТ ЛистТребований [ЛТ6.17]  [VUVaynula@1cbit.ru] [29.03.2026 18:33:09] -
КонецФункции

Функция бит_СоздатьПустуюТаблицуПар() 
	// {{ПервыйБИТ ЛистТребований [ЛТ6.6]  [VUVaynula@1cbit.ru] [25.03.2026 19:01:01] +        
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Характеристика");
	
	Возврат Таблица;
	// }}ПервыйБИТ ЛистТребований [ЛТ6.6]  [VUVaynula@1cbit.ru] [25.03.2026 19:01:01] -	
КонецФункции

Процедура бит_СобратьЭтапы(СтрокиДерева, Результат, ТолькоДокументы)
// {{ПервыйБИТ ЛистТребований [ЛТ6.6]  [VUVaynula@1cbit.ru] [25.03.2026 19:01:16] +        
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.ЭтапСсылка) Тогда
			Если ТолькоДокументы Тогда
				Если ТипЗнч(СтрокаДерева.ЭтапСсылка) = Тип("ДокументСсылка.ЭтапПроизводства2_2") Тогда
					Результат.Добавить(СтрокаДерева.ЭтапСсылка);
				КонецЕсли;
			Иначе
				Результат.Добавить(СтрокаДерева.ЭтапСсылка);
			КонецЕсли;
				
		КонецЕсли;
				
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			бит_СобратьЭтапы(СтрокаДерева.Строки, Результат, ТолькоДокументы);
		КонецЕсли;
		
	КонецЦикла;
	// }}ПервыйБИТ ЛистТребований [ЛТ6.6]  [VUVaynula@1cbit.ru] [25.03.2026 19:01:16] -	
КонецПроцедуры

