&НаСервере
Процедура УстановитьРасценкуВидаРабот(ВидРабот, ВидРабочегоЦентра, ДатаРасценки)
	
	////Расценка по разряду (ЧТС) RT -из базовой тарифной сетки
	////+Кратность K - из обрабатываемой строки   Табличной части "Трудозатраты" справочника "Технологический процессы"
	////+% участия PU - из обрабатываемой строки   Табличной части "Трудозатраты" справочника "Технологический процессы"
	////+Процент надбавки за работу на НВО NS - из   регистра сведений "Признаки ВРЦ  для ОТиЗ"
	////+Основное  количество ходов KO - из   регистра сведений "Признаки ВРЦ  для ОТиЗ	
	////+Рассчитываемое количество ходов FK - из текущего справочника
	////+Человеко-часов на (норма выработки) HH - из текущего справочника
	////+Коэффициент выполнения KV - из текущего справочника,  хранится в справочнике, но не влияет на расчет расценки.
	////Коэффициент Многостаночности MO - берется из  дополнительных реквизитов "Вида рабочего центра" справочника "Технологические операции" подчинённые справочник 
	////+Коэффициент за условия труда UT - из   регистра сведений "Признаки ВРЦ  для ОТиЗ"
	
	RT = ПолучитьРасценкуПоРазряду(ВидРабот.бит_ОсновнаяТарифнаяСетка, ВидРабот.КвалификационныйРазряд);                             
	NS = ПолучитьЗначениеОТИЗ(ВидРабочегоЦентра, Перечисления.бит_ТипыПризнаковДляОТиЗ.ПроцентНадбавкиЗаРаботуНаНВО);
	KO = ПолучитьЗначениеОТИЗ(ВидРабочегоЦентра, Перечисления.бит_ТипыПризнаковДляОТиЗ.ОсновноеКоличествоХодов);
	UT = ПолучитьЗначениеОТИЗ(ВидРабочегоЦентра, Перечисления.бит_ТипыПризнаковДляОТиЗ.КоэффициентЗаУсловияТруда);
	
	K = ВидРабот.бит_ТехПроцесс.Трудозатраты[ВидРабот.бит_НомерСтрокиТрудозатратВТехПроцессе - 1].бит_Кратность;
	PU = ВидРабот.бит_ТехПроцесс.Трудозатраты[ВидРабот.бит_НомерСтрокиТрудозатратВТехПроцессе -1].бит_ПроцентУчастия;
	
	FK = ВидРабот.бит_РассчитываемоеКоличествоХодов;
	HH = ВидРабот.КратностьТрудоемкости;
	
	//KV = 
	
	MO = ВидРабот.бит_КоэффициентМногостаночности; 
	
	Расценка = 0;
	
	////Если основное количество ходов совпадет с рассчитываемым (КО = FK) 
	////	Расценка Шаг1 = RT * (PU / 100)
	////	
	////	Расценка Шаг2 = Расценка Шаг1 * (1 + UT)
	////	
	////	Расценка Шаг3 = Расценка Шаг2 * (1 + NS)
	////	
	////	Расценка Итог = Расценка Шаг3  /   HH
	////	
	////Если основное количество ходов меньше рассчитываемого (КО < FK)
	////	Расценка Шаг1 = RT * (PU / 100)
	////		
	////	Расценка Шаг2 = Расценка Шаг1 * (1 + UT)
	////		
	////	Расценка Шаг3 = Расценка Шаг2 * (1 + NS)
	////		
	////	Расценка Шаг4 =Расценка Шаг3 * ( 1 + (( 100 * FK ) / KO - 100 ) * МО * 0.01)
	////		
	////	Расценка Итог = Расценка Шаг4  /   HH
	////		
	////Если код оборудования "25_01" значит расценка относится к 25 Цеху  (Участок транспортного обеспечения)
	////	Расценка Шаг1 = RT * (PU / 100)
	////			
	////	Расценка Шаг2 = Расценка Шаг1 * (1 + UT)
	////			
	////	Расценка Итог = Расценка Шаг2  /   HH
	
	Если HH <> 0 Тогда
		
		Если ВидРабочегоЦентра.Подразделение.Код = "25_01" Тогда
			Расценка = RT * (PU / 100);	
			Расценка = Расценка * (1 + UT);
			Расценка = Расценка / HH;
		ИначеЕсли KO = FK или KO = 0 Тогда
			Расценка = RT * (PU / 100);
			Расценка = Расценка * (1 + UT);
			Расценка = Расценка * (1 + NS);
			Расценка = Расценка /   HH;
		ИначеЕсли KO < FK И KO <> 0 Тогда
			Расценка = RT * (PU / 100);	
			Расценка = Расценка * (1 + UT);				
			Расценка = Расценка * (1 + NS);				
			Расценка = Расценка * ( 1 + (( 100 * FK ) / KO - 100 ) * MO * 0.01);				
			Расценка = Расценка / HH;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если Расценка <> 0 Тогда
		
		НоваяЗапись = РегистрыСведений.РасценкиРаботСотрудников.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ДатаРасценки;
		НоваяЗапись.ВидРабот = ВидРабот.Ссылка;
		НоваяЗапись.КвалификационныйРазряд = ВидРабот.КвалификационныйРазряд;
		НоваяЗапись.Расценка = Расценка;
		НоваяЗапись.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРасценкуПоРазряду(ВидРабот, КвалификационныйРазряд)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасценкиРаботСотрудниковСрезПоследних.Период КАК Период,
		|	РасценкиРаботСотрудниковСрезПоследних.ВидРабот КАК ВидРабот,
		|	РасценкиРаботСотрудниковСрезПоследних.КвалификационныйРазряд КАК КвалификационныйРазряд,
		|	РасценкиРаботСотрудниковСрезПоследних.Расценка КАК Расценка
		|ИЗ
		|	РегистрСведений.РасценкиРаботСотрудников.СрезПоследних(&Дата, ) КАК РасценкиРаботСотрудниковСрезПоследних
		|ГДЕ
		|	РасценкиРаботСотрудниковСрезПоследних.ВидРабот = &ВидРабот
		|	И РасценкиРаботСотрудниковСрезПоследних.КвалификационныйРазряд = &КвалификационныйРазряд";
	
	Запрос.УстановитьПараметр("ВидРабот", ВидРабот);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("КвалификационныйРазряд", КвалификационныйРазряд);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Расценка;
	КонецЦикла;
	
	Возврат 1;
	
КонецФункции  

&НаСервере
Функция ПолучитьЗначениеОТИЗ(ИмяВРЦ, ТипПризнакаДляОТиЗ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПризнакиВРЦДляОТиЗ.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	бит_ПризнакиВРЦДляОТиЗ.ПризнакОТиЗ КАК ПризнакОТиЗ,
		|	бит_ПризнакиВРЦДляОТиЗ.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.бит_ПризнакиВРЦДляОТиЗ КАК бит_ПризнакиВРЦДляОТиЗ
		|ГДЕ
		|	бит_ПризнакиВРЦДляОТиЗ.ВидРабочегоЦентра = &ВидРабочегоЦентра
		|	И бит_ПризнакиВРЦДляОТиЗ.ПризнакОТиЗ = &ПризнакОТиЗ";
	
	Запрос.УстановитьПараметр("ВидРабочегоЦентра", ИмяВРЦ);
	Запрос.УстановитьПараметр("ПризнакОТиЗ", ТипПризнакаДляОТиЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Значение;
	КонецЦикла;
	
    Возврат 0;
	
КонецФункции


