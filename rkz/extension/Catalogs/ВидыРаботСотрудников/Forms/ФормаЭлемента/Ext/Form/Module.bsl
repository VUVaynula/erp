&НаСервере
Функция ПолучитьВРЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыРаботСотрудников.Ссылка КАК ВидРабот,
		|	ТехнологическиеПроцессы.Ссылка КАК ТехПроцесс,
		|	ТехнологическиеОперации.РабочийЦентр КАК ВРЦ
		|ИЗ
		|	Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеПроцессы КАК ТехнологическиеПроцессы
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|			ПО ТехнологическиеПроцессы.Ссылка = ТехнологическиеОперации.Владелец
		|		ПО ВидыРаботСотрудников.бит_ТехПроцесс = ТехнологическиеПроцессы.Ссылка
		|ГДЕ
		|	ВидыРаботСотрудников.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ВРЦ;
	КонецЦикла;
	
