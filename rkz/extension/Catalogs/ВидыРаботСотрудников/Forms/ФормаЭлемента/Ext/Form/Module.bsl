&НаКлиенте
Процедура ТехПроцессПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.бит_ТехПроцесс) Тогда
		Объект.бит_Должность = ПолучитьДолжность();
		Объект.бит_КодОперации = ПолучитьКодОперации();
		Объект.бит_КодВРЦ = ПолучитьКодВРЦ();
	Иначе	
		Объект.бит_Должность = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДолжность()
	Возврат Объект.бит_ТехПроцесс.Трудозатраты[Объект.бит_НомерСтрокиТрудозатратВТехПроцессе - 1].бит_Должность;
КонецФункции 

&НаСервере
Функция ПолучитьКодОперации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеОперации.бит_КодОперации КАК бит_КодОперации
		|ИЗ
		|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|ГДЕ
		|	ТехнологическиеОперации.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.бит_ТехПроцесс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.бит_КодОперации; 
	КонецЦикла;
	
	Возврат Неопределено
	
КонецФункции


&НаСервере
Функция ПолучитьКодВРЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТехнологическиеОперации.РабочийЦентр ССЫЛКА Справочник.РабочиеЦентры
		|			ТОГДА ТехнологическиеОперации.РабочийЦентр.ВидРабочегоЦентра
		|		ИНАЧЕ ТехнологическиеОперации.РабочийЦентр
		|	КОНЕЦ КАК Код_ВРЦ
		|ИЗ
		|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|ГДЕ
		|	ТехнологическиеОперации.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.бит_ТехПроцесс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Код_ВРЦ; 
	КонецЦикла;
	
	Возврат Неопределено
	
