&НаСервере
Процедура бит_СоздатьВидыРаботПоТехПроцессуНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		//|Должность	КодОборудования + "" / "" + КодОперации + "" / "" + КодТМЦ КАК НаименованиеВидаРабот,
		//|	ТЗ._01 КАК КодОборудования,
		//|	ТЗ._02 КАК Наименование,
		//|	ТЗ._03 КАК КодОперации,
		//|	ТЗ._04 КАК НаименованиеОперации,
		//|	ТЗ._05 КАК КодТМЦ,
		//Должность + НаименованиеВидаРабот;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеПроцессыТрудозатраты.Ссылка КАК ТехнологическийПроцесс,
		|	ТехнологическиеОперации.Ссылка КАК ТехнологическаяОперация,
		|	ТехнологическиеОперации.РабочийЦентр КАК ВРЦ,
		|	ТехнологическиеОперации.бит_КодОперации КАК КодОперации,
		|	ТехнологическиеПроцессыТрудозатраты.Ссылка.бит_Номенклатура КАК Номенклатура,
		|	ТехнологическиеПроцессыТрудозатраты.бит_Должность КАК Должность,
		|	ТехнологическиеПроцессыТрудозатраты.бит_Кратность КАК Кратность,
		|	ТехнологическиеПроцессыТрудозатраты.бит_ПроцентУчастия КАК ПроцентУчастия,
		|	ТехнологическиеПроцессыТрудозатраты.бит_Разряд КАК Разряд,
		|	ВидыРаботСотрудников.Ссылка КАК ВидРаботы,
		|	ТехнологическиеПроцессыТрудозатраты.НомерСтроки КАК НомерСтроки,
		|	ТехнологическиеПроцессыТрудозатраты.ВидРабот КАК ОсновнаяТарифнаяСетка
		|ИЗ
		|	Справочник.ТехнологическиеПроцессы.Трудозатраты КАК ТехнологическиеПроцессыТрудозатраты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|		ПО ТехнологическиеПроцессыТрудозатраты.Ссылка = ТехнологическиеОперации.Владелец
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
		|		ПО ТехнологическиеПроцессыТрудозатраты.Ссылка = ВидыРаботСотрудников.бит_ТехПроцесс
		|			И ТехнологическиеПроцессыТрудозатраты.НомерСтроки = ВидыРаботСотрудников.бит_НомерСтрокиТрудозатратВТехПроцессе
		|ГДЕ
		|	ТехнологическиеПроцессыТрудозатраты.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТехнологическаяОперация) и
				НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидРаботы) Тогда
				
				НовыйВидРабот = Справочники.ВидыРаботСотрудников.СоздатьЭлемент();
				НовыйВидРабот.бит_ТехПроцесс = Объект.Ссылка;
				НовыйВидРабот.бит_НомерСтрокиТрудозатратВТехПроцессе = ВыборкаДетальныеЗаписи.НомерСтроки;
				НовыйВидРабот.бит_Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
				НовыйВидРабот.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаИзмерения;
				НовыйВидРабот.бит_ОсновнаяТарифнаяСетка = ВыборкаДетальныеЗаписи.ОсновнаяТарифнаяСетка;
				НовыйВидРабот.КвалификационныйРазряд = ВыборкаДетальныеЗаписи.Разряд;
				
				//Должность + "/"	КодОборудования + "" / "" + КодОперации + "" / "" + КодТМЦ КАК НаименованиеВидаРабот
				Должность = ВыборкаДетальныеЗаписи.Должность.Наименование;
				КодОборудования = ВыборкаДетальныеЗаписи.ВРЦ.бит_КодВРЦ;
				КодОперации = ВыборкаДетальныеЗаписи.КодОперации.Наименование;
				КодТМЦ = ВыборкаДетальныеЗаписи.Номенклатура.Артикул;
				
				НовыйВидРабот.Наименование = Должность + " / " + КодОборудования + " / " + КодОперации + " / " + КодТМЦ;
				
				НовыйВидРабот.Записать();
				
				Сообщить("Создан вид работ: " + НовыйВидРабот.Наименование);
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЕсли;

КонецПроцедуры
