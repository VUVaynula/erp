&НаКлиенте
Процедура бит_ОбновитьНомерДоговора()
	
//1БИТ ЛТ13 KAKravchenko@1cbit.ru 11.12.2024 +
	Если ЗначениеЗаполнено(Объект.бит_Префикс) Тогда
		Объект.Номер = Объект.бит_Префикс + "/" + СтрЗаменить(Строка(Объект.бит_НомерДоговора),Символы.НПП, "");
	Иначе  
		Объект.Номер = СтрЗаменить(Строка(Объект.бит_НомерДоговора),Символы.НПП, "");
	КонецЕсли;
//1БИТ ЛТ13 KAKravchenko@1cbit.ru 11.12.2024 -

КонецПроцедуры


