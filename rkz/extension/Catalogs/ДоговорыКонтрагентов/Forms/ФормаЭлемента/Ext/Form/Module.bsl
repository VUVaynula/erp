
&НаСервере
&После("ПриСозданииНаСервере")
Процедура бит_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
//1БИТ ЛТ13 KAKravchenko@1cbit.ru 11.12.2024 +	
	НовыйЭлемент = Элементы.Добавить("бит_НомерДоговора", Тип("ПолеФормы"), Элементы.ГруппаШапкаЛево);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.бит_НомерДоговора";   
	НовыйЭлемент.МаксимальнаяШирина = 29;
	//НовыйЭлемент.Ширина = 29;  
	НовыйЭлемент.РастягиватьПоГоризонтали = ИСТИНА; 
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	НовыйЭлемент.АвтоМаксимальнаяШирина = ЛОЖЬ;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_НомерДоговораПриИзменении");
	
	НовыйЭлемент = Элементы.Добавить("бит_Префикс", Тип("ПолеФормы"), Элементы.ГруппаШапкаЛево);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.бит_Префикс";  
	НовыйЭлемент.МаксимальнаяШирина = 29;  
	НовыйЭлемент.АвтоМаксимальнаяШирина = ЛОЖЬ;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_ПрефиксПриИзменении"); 
	 
	Элементы.Номер.ТолькоПросмотр = ИСТИНА;
//1БИТ ЛТ13 KAKravchenko@1cbit.ru 11.12.2024 -  

КонецПроцедуры  


