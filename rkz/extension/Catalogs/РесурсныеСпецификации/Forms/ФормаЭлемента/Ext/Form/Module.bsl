&НаСервереБезКонтекста
Процедура ПолучитьОперацию1(ДеревоОбъект, Операция)
	               		
	Для каждого ТекСтрока Из ДеревоОбъект.Строки Цикл
		Если ТекСтрока.ВидЭлемента = "Операция" И ТекСтрока.Номер = 1 Тогда
			Операция = ТекСтрока.Ссылка;  
			Возврат;
		КонецЕсли;
		Если ТекСтрока.Строки.Количество() > 0 Тогда
			ПолучитьОперацию1(ТекСтрока, Операция);
		КонецЕсли;
		Если Операция <> Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
