&НаСервереБезКонтекста
Функция ПолучитьСтрокуМатериалов(ТекСпецификация, Номенклатура)
	// {{ПервыйБИТ ЛистТребований [ЛТ 1.3.4.1]  [VUVaynula@1cbit.ru] [02.03.2025 19:43:47] +
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_КоэфицентыСпецификаций.Номенклатура КАК Номенклатура,
	                      |	бит_КоэфицентыСпецификаций.КоличествоПозиций КАК КоличествоПозиций,
	                      |	ВЫБОР
	                      |		КОГДА бит_КоэфицентыСпецификаций.КоэффициентУкрутки = 0
	                      |			ТОГДА 1
	                      |		ИНАЧЕ бит_КоэфицентыСпецификаций.КоэффициентУкрутки
	                      |	КОНЕЦ КАК КоэффициентУкрутки,
						  //|	бит_КоэфицентыСпецификаций.ТехОтходПроцент КАК ТехОтходПроцент,
						  //|	бит_КоэфицентыСпецификаций.АгрегирующийКоэффициент КАК АгрегирующийКоэффициент,
	                      |	бит_КоэфицентыСпецификаций.РасходСУчетомПотерь КАК РасходСУчетомПотерь,
	                      |	бит_КоэфицентыСпецификаций.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	                      |ИЗ
	                      |	РегистрСведений.бит_КоэфицентыСпецификаций КАК бит_КоэфицентыСпецификаций
	                      |ГДЕ
	                      |	бит_КоэфицентыСпецификаций.РесурснаяСпецификация = &РесурснаяСпецификация
	                      |	И бит_КоэфицентыСпецификаций.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("РесурснаяСпецификация", ТекСпецификация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() = Ложь Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ 1.3.4.1]  [VUVaynula@1cbit.ru] [02.03.2025 19:43:47] -
