				СообщениеПользователю.Сообщить();
			Иначе	
				Объект.бит_Вариант = ВыборкаДетальныеЗаписи.бит_Вариант + 1;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли; 
	
