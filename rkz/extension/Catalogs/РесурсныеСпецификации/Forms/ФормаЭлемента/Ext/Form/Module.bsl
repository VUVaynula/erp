&НаСервере
Процедура ПроцентВыполненияОперацииПриИзмененииНаСервере()
	
	бит_ПроцентВыполненияОперацииПредыдущий = ЭтаФорма["бит_ПроцентВыполненияОперацииПредыдущий"];
	
	Для Каждого СтрокаТЧ Из Объект.Трудозатраты Цикл
		СтрокаТЧ.Количество = (СтрокаТЧ.Количество / бит_ПроцентВыполненияОперацииПредыдущий) * Объект.бит_ПроцентВыполненияОперации;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтапыПроизводства.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|ГДЕ
		|	ЭтапыПроизводства.НомерСледующегоЭтапа = 0
		|	И ЭтапыПроизводства.Владелец = &Спецификация";
	
	Запрос.УстановитьПараметр("Спецификация", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка) Тогда
			ЭтапПроизводстваОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			Для Каждого СтрокаТЧ Из ЭтапПроизводстваОбъект.ВидыРабочихЦентров Цикл
				СтрокаТЧ.ВремяРаботы = (СтрокаТЧ.ВремяРаботы / бит_ПроцентВыполненияОперацииПредыдущий ) * Объект.бит_ПроцентВыполненияОперации;	
			КонецЦикла;	
			ЭтапПроизводстваОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма["бит_ПроцентВыполненияОперацииПредыдущий"] = Объект.бит_ПроцентВыполненияОперации;
	
КонецПроцедуры


