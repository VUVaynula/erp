			ДеревоОбъект = РеквизитФормыВЗначение("ПроизводственныйПроцесс");
			Операция = Неопределено;
			ПолучитьОперацию1(ДеревоОбъект, Операция);
		КонецЕсли;
		Если Операция = Неопределено Тогда
			ДанныеСтроки.бит_АгрегирующийКоэффициент = 0;
		Иначе 
			КэшЭлементов = ПроизводственныйПроцессПолучитьКэшЭлементов();
			Если КэшЭлементов = Неопределено Тогда       
				ДанныеСтроки.бит_АгрегирующийКоэффициент = 0;
			Иначе
