&После("ПриСозданииНаСервере")
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	//Первыйбит ЛТ1 ЛапшовГ "GVLapshov@1cbit.ru" 23.09.2024 +  
	ДобавляемыеРеквизиты	= Новый Массив;
	Реквизит_Бит_НаименованиеСФормойСобственности = Новый РеквизитФормы("Бит_НаименованиеСФормойСобственности",	Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(1024)),	, "Наименование с формой собственности (Бит)");
	Реквизит_Бит_ФормаСобственности = Новый РеквизитФормы("Бит_ФормаСобственности",	Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(1024)),	, "Форма собственности (Бит)");
	Реквизит_Бит_Зона = Новый РеквизитФормы("Бит_Зона",	Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(1024)),	, "Зона (Бит)");
	Реквизит_Бит_ИДКлиента = Новый РеквизитФормы("Бит_ИДКлиента",	Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(100)),	, "ИДКлиента");
		
	ДобавляемыеРеквизиты.Добавить(Реквизит_Бит_НаименованиеСФормойСобственности); 
	ДобавляемыеРеквизиты.Добавить(Реквизит_Бит_ФормаСобственности);
	ДобавляемыеРеквизиты.Добавить(Реквизит_Бит_Зона);
	ДобавляемыеРеквизиты.Добавить(Реквизит_Бит_ИДКлиента);
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);   
	
	Если Не КонтрагентПартнера.Пустая() Тогда
			КонтрагентОбъект = КонтрагентПартнера.ПолучитьОбъект(); 	
			ЭтаФорма.Бит_НаименованиеСФормойСобственности = КонтрагентОбъект.Бит_НаименованиеСФормойСобственности;
			ЭтаФорма.Бит_ФормаСобственности = КонтрагентОбъект.Бит_ФормаСобственности;
			ЭтаФорма.Бит_Зона = КонтрагентОбъект.Бит_Зона;	
			ЭтаФорма.Бит_ИДКлиента = КонтрагентОбъект.Бит_ИДКлиента;
	КонецЕсли;
		
	НовыйЭлемент = Элементы.Добавить("Бит_ГруппаДополнительныеРеквизиты", Тип("ГруппаФормы"), Элементы.ГруппаСтраницы);
	НовыйЭлемент.Вид = ВидГруппыФормы.Страница;
	НовыйЭлемент.Заголовок = "Дополнительно (Бит)"; 
			
		НовыйЭлемент = Элементы.Добавить("Бит_НаименованиеСФормойСобственности", Тип("ПолеФормы"), Элементы.Бит_ГруппаДополнительныеРеквизиты);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Бит_НаименованиеСФормойСобственности"; 
		
		НовыйЭлемент = Элементы.Добавить("Бит_ФормаСобственности", Тип("ПолеФормы"), Элементы.Бит_ГруппаДополнительныеРеквизиты);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Бит_ФормаСобственности";
		
		НовыйЭлемент = Элементы.Добавить("Бит_Зона", Тип("ПолеФормы"), Элементы.Бит_ГруппаДополнительныеРеквизиты);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Бит_Зона";
		
		НовыйЭлемент = Элементы.Добавить("Бит_ИДКлиента", Тип("ПолеФормы"), Элементы.Бит_ГруппаДополнительныеРеквизиты);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Бит_ИДКлиента"; 
	//Первыйбит ЛТ1 ЛапшовГ "GVLapshov@1cbit.ru" 23.09.2024 -
			
КонецПроцедуры    

&ИзменениеИКонтроль("ЗаписатьКонтрагентаПартнера")
&НаСервере
Процедура бит_ЗаписатьКонтрагентаПартнера()
	
	СоздатьКонтрагента = КонтрагентПартнера.Пустая();
	
	Если СоздатьКонтрагента Тогда
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	Иначе
		КонтрагентОбъект = КонтрагентПартнера.ПолучитьОбъект();
	КонецЕсли;
	
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, КонтрагентОбъект);
	
	КонтрагентОбъект.Наименование = Объект.Наименование;
	КонтрагентОбъект.НаименованиеПолное        = Объект.НаименованиеПолное;
	КонтрагентОбъект.НаименованиеМеждународное = НаименованиеМеждународное;  
	КонтрагентОбъект.НаименованиеВТранскрипции = НаименованиеВТранскрипции;
	КонтрагентОбъект.Партнер                   = Объект.Ссылка;
	КонтрагентОбъект.ЮрФизЛицо                 = ЮрФизЛицо;
	КонтрагентОбъект.ОбособленноеПодразделение = ОбособленноеПодразделение;
	КонтрагентОбъект.СтранаРегистрации         = СтранаРегистрации;
	КонтрагентОбъект.РегистрационныйНомер      = РегистрационныйНомер;
	КонтрагентОбъект.НалоговыйНомер            = НалоговыйНомер;
	КонтрагентОбъект.ИНН                       = ИНН;
	КонтрагентОбъект.ИсторияНаименований.Загрузить(ИсторияНаименований.Выгрузить()); 
	#Вставка
	//Первыйбит ЛТ1 ЛапшовГ "GVLapshov@1cbit.ru" 23.09.2024 +
	КонтрагентОбъект.Бит_НаименованиеСФормойСобственности =  ЭтаФорма.Бит_НаименованиеСФормойСобственности;    
	КонтрагентОбъект.Бит_ФормаСобственности =  ЭтаФорма.Бит_ФормаСобственности; 
	КонтрагентОбъект.Бит_Зона =  ЭтаФорма.Бит_Зона;
	КонтрагентОбъект.Бит_ИДКлиента =  ЭтаФорма.Бит_ИДКлиента; 
	//Первыйбит ЛТ1 ЛапшовГ "GVLapshov@1cbit.ru" 23.09.2024 -
    #КонецВставки  
	
	Если Не ЗначениеЗаполнено(ГоловнойКонтрагент) И Не ОбособленноеПодразделение Тогда
		
		Если СоздатьКонтрагента Тогда
			НоваяСсылка = Справочники.Контрагенты.ПолучитьСсылку();
			КонтрагентОбъект.УстановитьСсылкуНового(НоваяСсылка);
			ГоловнойКонтрагент = КонтрагентОбъект.ПолучитьСсылкуНового();
		Иначе
			ГоловнойКонтрагент = КонтрагентПартнера;
		КонецЕсли;
		
	КонецЕсли;
	КонтрагентОбъект.ГоловнойКонтрагент = ГоловнойКонтрагент;
	ПартнерыИКонтрагенты.ЗаполнитьКонтактнуюИнформациюКонтрагентаПартнера(КонтрагентОбъект, ЭтотОбъект, Объект.КонтактнаяИнформация);
	ПартнерыИКонтрагентыЛокализация.ПередЗаписьюКонтрагентаПартнера(КонтрагентОбъект, ЭтаФорма);
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПередЗаписьюНаСервереКонтрагент(ЭтотОбъект, КонтрагентОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	КонтрагентОбъект.Записать();
	
	КонтрагентПартнера = КонтрагентОбъект.Ссылка;
	
КонецПроцедуры 
