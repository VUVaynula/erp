Процедура Отменить(Команда)  
	
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)    
	
	Если КоличествоДлин = 0 Или ДлинаОтрезка = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("КоличествоДлин, ДлинаОтрезка", КоличествоДлин, ДлинаОтрезка));   
	
КонецПроцедуры
