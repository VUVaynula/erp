&НаСервере
Процедура бит_СоздатьЭлементыБит()

	// Первыйбит ЛТ8.10.9 ЛапшовГ "GVLapshov@1cbit.ru" 28.04.2025 +
	НоваяГруппа  = Элементы.Добавить("бит_ГруппаДополнительныеРеквизиты",Тип("ГруппаФормы"), ЭтаФорма);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Истина; 
	НоваяГруппа.Заголовок = "(бит) Дополнтельно";  
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;  
	//НоваяГруппа.Группировка = ГруппировкаКолонок.Вертикальная;
	
	//(бит) № заказа
	Если ЭтаФорма.Элементы.Найти("бит_НомерЗаказа") = Неопределено Тогда 
		НовыйЭлемент = Элементы.Вставить("бит_НомерЗаказа", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_НомерЗаказа";
	КонецЕсли;

	//(бит) Намотки 
	Если ЭтаФорма.Элементы.Найти("бит_Намотки") = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить("бит_Намотки", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_Намотки";
	КонецЕсли;
	
	//(бит) Брутто, кг 
	Если ЭтаФорма.Элементы.Найти("бит_Брутто") = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить("бит_Брутто", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_Брутто";
	КонецЕсли;

	//(бит) Примечание
	Если ЭтаФорма.Элементы.Найти("бит_Примечание") = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить("бит_Примечание", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_Примечание";
	КонецЕсли;

	//(бит) Тара
	Если ЭтаФорма.Элементы.Найти("бит_ТипБарабана") = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить("бит_ТипБарабана", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_ТипБарабана";
	КонецЕсли;

	//(бит) Прежний № тары 
	Если ЭтаФорма.Элементы.Найти("бит_ПрежнийНомерТары") = Неопределено Тогда
		НовыйЭлемент = Элементы.Вставить("бит_ПрежнийНомерТары", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.бит_ПрежнийНомерТары";
	КонецЕсли;
    // Первыйбит ЛТ8.10.9 ЛапшовГ "GVLapshov@1cbit.ru" 28.04.2025 - 
	
КонецПроцедуры

