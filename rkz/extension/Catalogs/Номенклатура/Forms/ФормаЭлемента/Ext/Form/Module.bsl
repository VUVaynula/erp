Процедура бит_ЗаполнитьПризнакиНоменклатуры(ОбъектКопирования)

	// Первыйбит ЛТ2.2 ЛапшовГ "GVLapshov@1cbit.ru" 21.01.2025 + 
	Если ОбъектКопирования.ЭтоГруппа = Ложь Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак КАК бит_Признак,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации КАК бит_ПризнакСертификации,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК бит_Значение
		|ИЗ
		|	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
		|ГДЕ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &ОбъектКопирования";
		
		Запрос.УстановитьПараметр("ОбъектКопирования", ОбъектКопирования);
		
		ВыборкаПризнаков = Запрос.Выполнить().Выгрузить();
		
		Попытка 
			ЭтотОбъект.Записать();
			
			Номенклатура = Объект.Ссылка;
			
			НаборЗаписей = РегистрыСведений.бит_ЗначенияПризнаковНоменклатуры.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.бит_Номенклатура.Установить(Номенклатура); 
			
			Для Каждого Строка Из ВыборкаПризнаков Цикл 
				
				НоваяЗапись = НаборЗаписей.Добавить(); 
				
				НоваяЗапись.бит_Номенклатура 					= Номенклатура; 
				НоваяЗапись.бит_Признак 						= Строка.бит_Признак; 
				НоваяЗапись.бит_ПризнакСертификации 			= Строка.бит_ПризнакСертификации;
				НоваяЗапись.бит_Значение 						= Строка.бит_Значение;
				
			КонецЦикла; 
			
			НаборЗаписей.Записать(); 
		Исключение
		ТекстСообщения = "Признаки не удалось скопировать!";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	// Первыйбит ЛТ2.2 ЛапшовГ "GVLapshov@1cbit.ru" 21.01.2025 -
	
КонецПроцедуры

