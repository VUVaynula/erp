	ИначеЕсли ВидРезультатаПроверки = ПЧ.бит_СтроковоеЗначение Тогда 		
		ВидимостьЭлемента("бит_Значение", 				ЛОЖЬ);
		ВидимостьЭлемента("бит_МинимальноеЗначение", 	ЛОЖЬ);
		ВидимостьЭлемента("бит_МаксимальноеЗначение", 	ЛОЖЬ);
		ВидимостьЭлемента("бит_СтроковоеЗначение", 		ИСТИНА);
