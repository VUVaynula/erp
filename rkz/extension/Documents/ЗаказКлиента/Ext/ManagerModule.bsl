	ТабличныйДокумент.Вывести(ОбластьОбласть3);
	ТабличныйДокумент.Вывести(ОбластьОбласть4);
	ТабличныйДокумент.Вывести(ОбластьОбласть5);
	ТабличныйДокумент.Вывести(ОбластьОбласть6);
	ТабличныйДокумент.Вывести(ОбластьОбласть7);
	ТабличныйДокумент.Вывести(ОбластьОбласть8);
	ТабличныйДокумент.Вывести(ОбластьОбласть9);  
	ТабличныйДокумент.Вывести(ОбластьОбласть10); 
	ТабличныйДокумент.Вывести(ОбластьПодвал); 
	
	//КОЛОНТИТУЛЫ
	ТабличныйДокумент.ВерхнийКолонтитул.НачальнаяСтраница 		= 1; 
	ТабличныйДокумент.ВерхнийКолонтитул.ВертикальноеПоложение 	= ВертикальноеПоложение.Центр;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева				= "телефон/факс: " 		+ ВыборкаЗаказ.ОрганизацияТелефон;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстСправа				= "Счет-договор №   " 	+ ВыборкаЗаказ.Номер + "   от " + Формат(ВыборкаЗаказ.Дата, "ДФ=dd.MM.yyyy")+ "   Стр. [&НомерСтраницы] из [&СтраницВсего]";
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить				= Истина;   
			
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница 		= 1; 
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение 	= ВертикальноеПоложение.Центр; 
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева 				= "Исполнитель: " 	+ ВыборкаЗаказ.МенеджерНаименование;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре				= "Тел./Факс: " 	+ ВыборкаЗаказ.МенеджерТелефон;
    ТабличныйДокумент.НижнийКолонтитул.ТекстСправа 				= "e-mail: " 		+ ВыборкаЗаказ.МенеджерЭлПочта; 
    ТабличныйДокумент.НижнийКолонтитул.Выводить 				= Истина; 
		
	Возврат ТабличныйДокумент;

