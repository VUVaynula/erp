Функция ПолучитьНамоткуНоменклатуры(НоменклатураГП, УпаковкаГП, НоменклатураТара)

 	// {{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] +
	
	Запрос = Новый Запрос;
