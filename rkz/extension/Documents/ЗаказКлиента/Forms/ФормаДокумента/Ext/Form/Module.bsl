&НаКлиенте
Процедура ПолучитьНамоткуПоТаре(ТекущиеДанные, Структура)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [02.09.2024] +        
	
	Намотка = Структура.Намотка;

	Если ЗначениеЗаполнено(Структура.Номенклатура) Тогда
		
		Если Структура.Несопоставимо Тогда
			
			ПоказатьПредупреждение(, "Выбраны несопоставимые данные!");	
			
			ТекущиеДанные.бит_ТипТары = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			
			РасчитатьВес(ТекущиеДанные, 0)
			
		Иначе	
			
			ТекущиеДанные.бит_ТипТары = Структура.Номенклатура;
			
			ТекущиеДанные.бит_Намотка = Намотка;
			
			РасчитатьВес(ТекущиеДанные, Намотка);
			
		КонецЕсли;
		
	Иначе
		
		РасчитатьВес(ТекущиеДанные, 0);
		
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [02.09.2024] -
		
КонецПроцедуры

