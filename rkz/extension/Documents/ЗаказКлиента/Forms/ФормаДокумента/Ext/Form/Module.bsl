&НаСервере
Функция ПолучитьТаруПоУмолчанию(Номенклатура)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [06.12.2024] +        
	
	Структура = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НамоткаНоменклатуры.НоменклатураГП КАК НоменклатураГП,
		|	бит_НамоткаНоменклатуры.ЕдИзм КАК ЕдИзм,
		|	бит_НамоткаНоменклатуры.НоменклатураТара КАК НоменклатураТара,
		|	бит_НамоткаНоменклатуры.ПоУмолчанию КАК ПоУмолчанию,
		|	бит_НамоткаНоменклатуры.Намотка КАК Намотка,
		|	бит_НамоткаНоменклатуры.Несопоставимо КАК Несопоставимо
		|ИЗ
		|	РегистрСведений.бит_НамоткаНоменклатуры КАК бит_НамоткаНоменклатуры
		|ГДЕ
		|	бит_НамоткаНоменклатуры.НоменклатураГП = &НоменклатураГП
		|	И бит_НамоткаНоменклатуры.ПоУмолчанию";
	
	Запрос.УстановитьПараметр("НоменклатураГП", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Структура.Вставить("НоменклатураТара", ВыборкаДетальныеЗаписи.НоменклатураТара);
		Структура.Вставить("Намотка", ВыборкаДетальныеЗаписи.Намотка);
		
		Возврат Структура
		
	КонецЦикла;	

	Возврат  Неопределено;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [06.12.2024] -
		
