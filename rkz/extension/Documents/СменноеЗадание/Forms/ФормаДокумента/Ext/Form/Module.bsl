&НаСервере
Процедура СоздатьЗапланированнуюВнеплановуюОперацию(Штрихкод, Операция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_КодыОпераций.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ вт_КодОперации
	|ИЗ
	|	Справочник.бит_КодыОпераций КАК бит_КодыОпераций
	|ГДЕ
	|	бит_КодыОпераций.Наименование = &Код
	|	И бит_КодыОпераций.ВнеплановаяОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_КодОперации.Ссылка КАК КодОперации,
	|	ТехнологическиеОперации.Ссылка КАК ТехОперация,
	|	ТехнологическиеОперации.Владелец КАК ТехПроцесс,
	|	ПроизводственнаяОперация2_2.Ссылка КАК ПроизводственнаяОперация
	|ИЗ
	|	вт_КодОперации КАК вт_КодОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	|		ПО вт_КодОперации.Ссылка = ТехнологическиеОперации.бит_КодОперации
	|			И (ТехнологическиеОперации.Владелец ССЫЛКА Справочник.ТехнологическиеПроцессы)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
	|		ПО вт_КодОперации.Ссылка.НаименованиеОперации = ПроизводственнаяОперация2_2.Наименование
	|			И (ПроизводственнаяОперация2_2.СменноеЗадание = &СменноеЗадание)
	|			И (ПроизводственнаяОперация2_2.Проведен)
	|ГДЕ
	|	ТехнологическиеОперации.РабочийЦентр = &ВРЦ";
	
	Запрос.УстановитьПараметр("СменноеЗадание", Объект.Ссылка);
	Запрос.УстановитьПараметр("Код", Штрихкод);
	Запрос.УстановитьПараметр("ВРЦ", Операция.ВидРабочегоЦентра);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОперацияОбъект = Неопределено;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПроизводственнаяОперация) Тогда
			
			ОперацияОбъект = ВыборкаДетальныеЗаписи.ПроизводственнаяОперация.ПолучитьОбъект();
			ОперацияОбъект.Количество = ОперацияОбъект.Количество + 1;
			
			Для Каждого СтрокаТЧ Из ОперацияОбъект.Трудозатраты Цикл
				СтрокаТЧ.Количество = ОперацияОбъект.Количество;
			КонецЦикла;
			
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Иначе
			
			ОперацияОбъект = Документы.ПроизводственнаяОперация2_2.СоздатьДокумент();
			ОперацияОбъект.Дата = Объект.Дата;
			ОперацияОбъект.Организация = Операция.Организация;
			ОперацияОбъект.Статус = Перечисления.СтатусыПроизводственныхОпераций.Выполнена;
			ОперацияОбъект.СменноеЗадание = Объект.Ссылка; 
			ОперацияОбъект.Операция = ВыборкаДетальныеЗаписи.ТехОперация;
			ОперацияОбъект.Наименование = ВыборкаДетальныеЗаписи.КодОперации.НаименованиеОперации;
			ОперацияОбъект.Этап  = Операция.Этап;
			ОперацияОбъект.Исполнитель  = Операция.Исполнитель;
			ОперацияОбъект.Подразделение = Операция.Подразделение; 
			ОперацияОбъект.ВидРабочегоЦентра = Операция.ВидРабочегоЦентра;
			ОперацияОбъект.Количество = 1;
			//ОперацияОбъект.Трудозатраты.Загрузить(ВыборкаДетальныеЗаписи.ТехПроцесс.Трудозатраты.Выгрузить());	
			ЗаполнитьТрудозатратыПоТехПроцессу(ОперацияОбъект, ВыборкаДетальныеЗаписи.ТехПроцесс);
			ОперацияОбъект.бит_СоставБригады.Загрузить(Операция.бит_СоставБригады.Выгрузить());	
			
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТрудозатратыПоТехПроцессу(ОперацияОбъект, ТехПроцесс)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыРаботСотрудников.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
	|ГДЕ
	|	ВидыРаботСотрудников.бит_ТехПроцесс = &бит_ТехПроцесс
	|	И НЕ ВидыРаботСотрудников.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("бит_ТехПроцесс", ТехПроцесс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ОперацияОбъект.Трудозатраты.Добавить();
		НоваяСтрока.ВидРабот = ВыборкаДетальныеЗаписи.Ссылка;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.НазначениеРабот = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.бит_СтатьиКалькуляцииФОТБезПремии, ЭтотОбъект, Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставИсполнителей()
	
	//Если Объект.Статус = Перечисления.СтатусыСменныхЗаданий.Закрыто Тогда
	Начисление_002 = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.Начисление_002, ЭтотОбъект, Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизводственнаяОперация2_2.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
		|ГДЕ
		|	ПроизводственнаяОперация2_2.Проведен
		|	И ПроизводственнаяОперация2_2.СменноеЗадание = &СменноеЗадание";
		
		Запрос.УстановитьПараметр("СменноеЗадание", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Ссылка.бит_СоставБригады.Количество() = 0 Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот КАК ВидРабот,
				|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот.КвалификационныйРазряд КАК ВидРаботКвалификационныйРазряд,
				|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот.бит_Должность КАК ВидРаботбит_Должность
				|ПОМЕСТИТЬ вт_Трудозатраты
				|ИЗ
				|	Документ.ПроизводственнаяОперация2_2.Трудозатраты КАК ПроизводственнаяОперация2_2Трудозатраты
				|ГДЕ
				|	ПроизводственнаяОперация2_2Трудозатраты.Ссылка = &Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт_Трудозатраты.ВидРабот КАК ВидРабот,
				|	бит_СоставИсполнителейИВремяВыполнения.Сотрудник КАК Сотрудник,
				|	бит_СоставИсполнителейИВремяВыполнения.Должность КАК Должность,
				|	бит_СоставИсполнителейИВремяВыполнения.Разряд КАК Разряд,
				|	бит_СоставИсполнителейИВремяВыполнения.Начисление КАК Начисление
				|ИЗ
				|	вт_Трудозатраты КАК вт_Трудозатраты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
				|		ПО вт_Трудозатраты.ВидРаботКвалификационныйРазряд = бит_СоставИсполнителейИВремяВыполнения.Разряд
				|			И вт_Трудозатраты.ВидРаботбит_Должность = бит_СоставИсполнителейИВремяВыполнения.Должность
				|ГДЕ
				|	бит_СоставИсполнителейИВремяВыполнения.Смена = &Смена
				|	И бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства = НЕОПРЕДЕЛЕНО
				|	И ВЫБОР
				|			КОГДА &ЭтоБригада
				|				ТОГДА бит_СоставИсполнителейИВремяВыполнения.Бригада = &Исполнитель
				|			ИНАЧЕ бит_СоставИсполнителейИВремяВыполнения.Сотрудник = &Исполнитель
				|		КОНЕЦ
				|	И бит_СоставИсполнителейИВремяВыполнения.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)";
				
				Запрос.УстановитьПараметр("Ссылка", ВыборкаДетальныеЗаписи.Ссылка);
				Запрос.УстановитьПараметр("Смена", Объект.Ссылка);
				Запрос.УстановитьПараметр("ЭтоБригада", ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка.Исполнитель) = Тип("СправочникСсылка.Бригады"));
				Запрос.УстановитьПараметр("Исполнитель", ВыборкаДетальныеЗаписи.Ссылка.Исполнитель);
					
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаСостав = РезультатЗапроса.Выбрать();
				
				ДокументОперация = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				ДокументОперация.Статус = Перечисления.СтатусыПроизводственныхОпераций.Выполнена;
				
				Пока ВыборкаСостав.Следующий() Цикл
					СтрокаСостав = ДокументОперация.бит_СоставБригады.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаСостав, ВыборкаСостав);
					СтрокаСостав.ВремяФакт = ДокументОперация.ВремяВыполнения;
					//СтрокаСостав.Начисление = Начисление_002;
				КонецЦикла;
				
				ДокументОперация.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
			
		КонецЦикла;
		
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("УстановитьСтатусЗакрыто")
Процедура бит_УстановитьСтатусЗакрыто(Команда)

	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда

		ТекстВопроса = НСтр("ru = 'Для изменения статуса требуется записать документ.
		|Записать и продолжить?';
		|en = 'To change status, it is required to save the document. 
		|Save and continue?'");

		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьДокументИУстановитьСтатусЗакрытоЗавершение", ЭтотОбъект);

		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

	Иначе
		
		#Вставка
		ЗаполнитьСоставИсполнителей();
		#КонецВставки
		
		ПроверитьВыполнитьДействияПередУстановкойСтатусаЗакрыто();

	КонецЕсли;

КонецПроцедуры
