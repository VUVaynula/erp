	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("СменноеЗадание", Объект.Ссылка);                                 
	Запрос.УстановитьПараметр("СтатьяЗП", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.бит_СтатьиКалькуляцииФОТБезПремии, ЭтотОбъект, Истина).Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаБригада = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаБригада.Следующий() Цикл 
		
		ВыборкаВРЦ = ВыборкаБригада.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВРЦ.Следующий() Цикл
			
			ЗаписыватьДокумент = ВыборкаВРЦ.ВидРаботЗаполнен; 
				
			НовыйДокумент = Документы.бит_Наряд.СоздатьДокумент();
			
			НовыйДокумент.Дата = Объект.Дата;
			
			НовыйДокумент.Оборудование  = ВыборкаВРЦ.НаименованиеВРЦ;			
			НовыйДокумент.Подразделение = Объект.Подразделение;
			НовыйДокумент.ДокументОснование = Объект.Ссылка;
			НовыйДокумент.Смена   = Объект.Смена;
			
			ВыборкаДетальныеЗаписи =  ВыборкаВРЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);			
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НовыйДокумент.Организация = ВыборкаДетальныеЗаписи.ДокументОснование.Организация;
				НовыйДокумент.Исполнитель = ВыборкаДетальныеЗаписи.Бригада;
				НоваяСтрока = НовыйДокумент.Операции.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
				
				Если НЕ ВыборкаДетальныеЗаписи.ВидРаботЗаполнен Тогда
					
					СообщениеПользователю = Новый СообщениеПользователю;
					//СообщениеПользователю.Поле = "ТЗПодъезд" + ИдентификаторИмени + "[0].Количество_" + НомерЭтажа; 
					СообщениеПользователю.Текст = "Не удалось подобрать вид работ по операции: " + ВыборкаДетальныеЗаписи.ДокументОснование;
					СообщениеПользователю.УстановитьДанные(ВыборкаДетальныеЗаписи.ДокументОснование);
					СообщениеПользователю.Сообщить();
						
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ЕдиницаИзмерения <> ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов тогда
					
					ДанныеОбУпаковке = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентВесОбъемПрочиеРеквизитыУпаковки(ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов, ВыборкаДетальныеЗаписи.Номенклатура, , Ложь);
					
					НоваяСтрока.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов;
					НоваяСтрока.КоличествоФакт = НоваяСтрока.КоличествоФакт / ДанныеОбУпаковке.Коэффициент;
					
					НоваяСтрока.СуммаПоОперации = НоваяСтрока.Расценка * НоваяСтрока.КоличествоФакт;
					
				КонецЕсли;
				
				НоваяСтрока.ИдентификаторСтроки = НоваяСтрока.НаименованиеОперации.УникальныйИдентификатор();
				
			КонецЦикла;
			
			//Если ТипЗнч(НовыйДокумент.Исполнитель) = Тип("СправочникСсылка.Сотрудники") Тогда
			//	Для Каждого СтрокаТЧ Из НовыйДокумент.Операции Цикл
			//		Если СтрокаТЧ.ДокументОснование.Трудозатраты.Количество() <> 0 Тогда
			//			СтрокаТЧ.ВидРабот = СтрокаТЧ.ДокументОснование.Трудозатраты[0].ВидРабот;
			//			СтрокаТЧ.ДолжностьОперации = СтрокаТЧ.ВидРабот.бит_Должность;
			//			СтрокаТЧ.РазрядОперации = СтрокаТЧ.ВидРабот.КвалификационныйРазряд;
			//		КонецЕсли;
			//	КонецЦикла;
