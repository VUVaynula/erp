			НовыйДокумент.ДокументОснование = Объект.Ссылка;
			НовыйДокумент.Смена   = Объект.Смена;
			НовыйДокумент.Исполнитель = ВыборкаВРЦ.Сотрудник;
			
			ВыборкаДетальныеЗаписи =  ВыборкаВРЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);			
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НовыйДокумент.Организация = ВыборкаДетальныеЗаписи.ДокументОснование.Организация;
				НоваяСтрока = НовыйДокумент.Операции.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
				
				Если НЕ ВыборкаДетальныеЗаписи.ВидРаботЗаполнен Тогда
					
					СообщениеПользователю = Новый СообщениеПользователю;
					//СообщениеПользователю.Поле = "ТЗПодъезд" + ИдентификаторИмени + "[0].Количество_" + НомерЭтажа; 
					СообщениеПользователю.Текст = "Не удалось подобрать вид работ по операции: " + ВыборкаДетальныеЗаписи.ДокументОснование;
					СообщениеПользователю.КлючДанных = ВыборкаДетальныеЗаписи.ДокументОснование;
					СообщениеПользователю.УстановитьДанные(ВыборкаДетальныеЗаписи.ДокументОснование);
					СообщениеПользователю.Сообщить();
						
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ЕдиницаИзмерения <> ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов тогда
					
					ДанныеОбУпаковке = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентВесОбъемПрочиеРеквизитыУпаковки(ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов, ВыборкаДетальныеЗаписи.Номенклатура, , Ложь);
					
					НоваяСтрока.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.Номенклатура.ЕдиницаДляОтчетов;
					НоваяСтрока.КоличествоФакт = НоваяСтрока.КоличествоФакт / ДанныеОбУпаковке.Коэффициент;
					
					НоваяСтрока.СуммаПоОперации = НоваяСтрока.Расценка * НоваяСтрока.КоличествоФакт;
					
				КонецЕсли;
				
				НоваяСтрока.ИдентификаторСтроки = НоваяСтрока.НаименованиеОперации.УникальныйИдентификатор();
				
			КонецЦикла;
					
			ТЗ = НовыйДокумент.Операции.Выгрузить();
			ТЗ.Свернуть("Сотрудник, ДолжностьОперации, РазрядОперации, ДолжностьСотрудника, РазрядСотрудника, НаименованиеОперации, НаименованиеВРЦ, Начисление, ИдентификаторСтроки");
			
			НовыйДокумент.Исполнители.Загрузить(ТЗ);
			
			ЧасыСмены = ПолучитьКоличествоЧасовВСмене(НовыйДокумент);
			
			Если ЗаписыватьДокумент Тогда
								
				Для Каждого СтрокаТЧ Из НовыйДокумент.Исполнители Цикл
					
					НормоЧасы = 0;
					
					Для Каждого СтрокаОперации Из НовыйДокумент.Операции Цикл
						
						Если СтрокаТЧ.Начисление = СтрокаОперации.Начисление 
							И СтрокаТЧ.ДолжностьОперации = СтрокаОперации.ДолжностьОперации 
							И СтрокаТЧ.РазрядОперации = СтрокаОперации.РазрядОперации Тогда
							
							НормоЧасы = НормоЧасы + СтрокаОперации.НормоЧасы;
														
						КонецЕсли;
						
					КонецЦикла;
					
					СтрокаТЧ.НормоЧасы = НормоЧасы;
					
					СтрокаТЧ.ПроцентВыполненияПоНормоЧасам = (СтрокаТЧ.НормоЧасы / ЧасыСмены) * 100;		
					
				КонецЦикла;
				
				ЗаполнитьИтоговыеСтроки(НовыйДокумент);	
						
				НовыйДокумент.Записать();
				
				СообщениеПользователю = Новый СообщениеПользователю; 
				СообщениеПользователю.Текст = "По Исполнителю: " + ВыборкаСотрудник.Сотрудник + " создан новый документ! " + Строка(НовыйДокумент.Ссылка);
				СообщениеПользователю.КлючДанных = НовыйДокумент.Ссылка;
				СообщениеПользователю.УстановитьДанные(НовыйДокумент.Ссылка);
				СообщениеПользователю.Сообщить();
				
			Иначе
				
				Сообщить("Наряд по Сотруднику: " + ВыборкаВРЦ.Сотрудник + " и ВРЦ: " + ВыборкаВРЦ.НаименованиеВРЦ + " не сформирован!");
				
			КонецЕсли;
				
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоговыеСтроки(НовыйДокумент)

	ТЗОперация = НовыйДокумент.Операции.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗОперация.Сотрудник КАК Сотрудник,
	|	ТЗОперация.Номенклатура КАК Номенклатура,
	|	ТЗОперация.НаименованиеВРЦ КАК НаименованиеВРЦ,
	|	ТЗОперация.КоличествоХодов КАК КоличествоХодов,
	|	ТЗОперация.КоличествоФакт КАК КоличествоФакт,
	|	ТЗОперация.СуммаПоОперации КАК СуммаПоОперации,
	|	ТЗОперация.НормоЧасы КАК НормоЧасы,
	|	ТЗОперация.ЧасыФакт КАК ЧасыФакт,
	|	ИСТИНА КАК ИтоговаяСтрока
	|ПОМЕСТИТЬ вт_ИтоговыеСтроки
	|ИЗ
	|	&ТЗОперация КАК ТЗОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ИтоговыеСтроки.Сотрудник КАК Сотрудник,
	|	вт_ИтоговыеСтроки.Номенклатура КАК Номенклатура,
	|	вт_ИтоговыеСтроки.НаименованиеВРЦ КАК НаименованиеВРЦ,
	|	вт_ИтоговыеСтроки.КоличествоХодов КАК КоличествоХодов,
	|	СУММА(вт_ИтоговыеСтроки.КоличествоФакт) КАК КоличествоФакт,
	|	СУММА(вт_ИтоговыеСтроки.СуммаПоОперации) КАК СуммаПоОперации,
	|	СУММА(вт_ИтоговыеСтроки.НормоЧасы) КАК НормоЧасы,
	|	СУММА(вт_ИтоговыеСтроки.ЧасыФакт) КАК ЧасыФакт,
	|	вт_ИтоговыеСтроки.ИтоговаяСтрока КАК ИтоговаяСтрока
	|ИЗ
	|	вт_ИтоговыеСтроки КАК вт_ИтоговыеСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ИтоговыеСтроки.КоличествоХодов,
	|	вт_ИтоговыеСтроки.ИтоговаяСтрока,
	|	вт_ИтоговыеСтроки.Сотрудник,
	|	вт_ИтоговыеСтроки.НаименованиеВРЦ,
	|	вт_ИтоговыеСтроки.Номенклатура";
	
	Запрос.УстановитьПараметр("ТЗОперация", ТЗОперация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = НовыйДокумент.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		//НоваяСтрока.Сотрудник = Неопределено;
		//НоваяСтрока.Номенклатура = Неопределено;
		//НоваяСтрока.НаименованиеВРЦ = Неопределено;
		//НоваяСтрока.КоличествоХодов = Неопределено;
		НоваяСтрока.СтрокаИтого = "ИТОГО:";
	КонецЦикла;
	
	НовыйДокумент.Операции.Сортировать("Сотрудник, Номенклатура, НаименованиеВРЦ, КоличествоХодов, ИтоговаяСтрока ВОЗР");
	
КонецПроцедуры

