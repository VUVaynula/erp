Процедура бит_СформироватьНарядыНаСервере() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроизводственнаяОперация2_2.Ссылка КАК Ссылка,
	|	бит_НарядОперации.Ссылка КАК Наряд
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_Наряд.Операции КАК бит_НарядОперации
	|		ПО (бит_НарядОперации.ДокументОснование = ПроизводственнаяОперация2_2.Ссылка)
	|ГДЕ
	|	ПроизводственнаяОперация2_2.Ссылка В
	|			(ВЫБРАТЬ
	|				бит_НарядОперации.ДокументОснование КАК ДокументОснование
	|			ИЗ
	|				Документ.бит_Наряд.Операции КАК бит_НарядОперации
	|			ГДЕ
	|				НЕ бит_НарядОперации.Ссылка.ПометкаУдаления)
	|	И ПроизводственнаяОперация2_2.СменноеЗадание = &СменноеЗадание
	|	И НЕ бит_НарядОперации.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НарядОперации.Ссылка,
	|	ПроизводственнаяОперация2_2.Ссылка";
	
	Запрос.УстановитьПараметр("СменноеЗадание", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СообщениеПользователю = Новый СообщениеПользователю; 
		СообщениеПользователю.Текст = "По операции: " + ВыборкаДетальныеЗаписи.Ссылка + " уже создан наряд: " + ВыборкаДетальныеЗаписи.Наряд;
		СообщениеПользователю.КлючДанных = ВыборкаДетальныеЗаписи.Наряд;
		СообщениеПользователю.УстановитьДанные(ВыборкаДетальныеЗаписи.Наряд);
		СообщениеПользователю.Сообщить();
	КонецЦикла;
	
	
	//Исполнитель Бригада
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроизводственнаяОперация2_2.Ссылка КАК ПроизводственнаяОперация,
