	ОперацииРегистр.ТекстЗапроса = СтрЗаменить(ОперацииРегистр.ТекстЗапроса, 
	"ОперацииПереопределяемый.Подразделение            КАК Подразделение,", 
	"ОперацииПереопределяемый.Подразделение            КАК Подразделение,
	|ОперацииПереопределяемый.ВидРабочегоЦентра.бит_КодВРЦ КАК бит_КодВРЦ,
	|ОперацииПереопределяемый.Этап.КоличествоУпаковокПлан КАК бит_ПланПоЭтапу,");
	//|ОперацииПереопределяемый.бит_КоличествоХодовОперация КАК бит_КоличествоХодовОперация,
		
	НовыйЭлемент = Этаформа.Элементы.Вставить("бит_ОперацииРегистр_КодВРЦ", Тип("ПолеФормы"), Элементы.ОперацииРегистр, Элементы.ОперацииРегистрКоличество);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОперацииРегистр.бит_КодВРЦ";
	НовыйЭлемент.Заголовок = "(бит) Код ВРЦ";
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("бит_ОперацииРегистрПланПоЭтапу", Тип("ПолеФормы"), Элементы.ОперацииРегистр, Элементы.ОперацииРегистрКоличество);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОперацииРегистр.бит_ПланПоЭтапу";
	НовыйЭлемент.Заголовок = "(бит) План по этапу";
	
	//НовыйЭлемент = Этаформа.Элементы.Вставить("бит_ОперацииРегистрКоличествоХодовОперация", Тип("ПолеФормы"), Элементы.ОперацииРегистр, Элементы.ОперацииРегистрКоличество);
	//НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	//НовыйЭлемент.ПутьКДанным = "ОперацииРегистр.бит_КоличествоХодовОперация";
	//НовыйЭлемент.Заголовок = "(бит) Количество ходов операция";
	
	ТекстБригадир = 
	"ВЫБРАТЬ
	|	бит_СоставИсполнителейИВремяВыполнения.Смена КАК Смена,
	|	бит_СоставИсполнителейИВремяВыполнения.Бригада КАК Бригада,
	|	бит_СоставИсполнителейИВремяВыполнения.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ вт_БригадирРегистр
	|ИЗ
	|	РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
	|ГДЕ
	|	бит_СоставИсполнителейИВремяВыполнения.Смена = &СменноеЗадание
	|	И бит_СоставИсполнителейИВремяВыполнения.Бригада <> ЗНАЧЕНИЕ(Справочник.Бригады.ПустаяСсылка)
	|	И бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства = НЕОПРЕДЕЛЕНО
	|	И бит_СоставИсполнителейИВремяВыполнения.Бригадир
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_СоставИсполнителейИВремяВыполнения.Смена,
	|	бит_СоставИсполнителейИВремяВыполнения.Бригада,
	|	бит_СоставИсполнителейИВремяВыполнения.Сотрудник
	|ИЗ
	|	РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
	|ГДЕ
	|	бит_СоставИсполнителейИВремяВыполнения.Смена = &СменноеЗадание
	|	И бит_СоставИсполнителейИВремяВыполнения.Бригада <> ЗНАЧЕНИЕ(Справочник.Бригады.ПустаяСсылка)
	|	И ТИПЗНАЧЕНИЯ(бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства) = ТИПЗНАЧЕНИЯ(ЗНАЧЕНИЕ(Документ.ПроизводственнаяОперация2_2.ПустаяСсылка))
	|	И бит_СоставИсполнителейИВремяВыполнения.Бригадир
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
		
	ОперацииДокумент.ТекстЗапроса = ТекстБригадир + ОперацииДокумент.ТекстЗапроса;
	
	ОперацииДокумент.Параметры.УстановитьЗначениеПараметра("СменноеЗадание", Объект.Ссылка);

	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка,", 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка, 
	|ОперацииПереопределяемый.ВидРабочегоЦентра.бит_КодВРЦ КАК бит_КодВРЦ,
	| Выбор Когда вт_БригадирРегистр.Сотрудник = Значение(Справочник.Сотрудники.ПустаяСсылка) Тогда """" Иначе вт_БригадирРегистр.Сотрудник Конец  КАК бит_Бригадир,
	|ОперацииПереопределяемый.бит_ВремяВыполненияНорма КАК бит_ВремяВыполненияНорма,
	|ОперацииПереопределяемый.ВремяВыполнения КАК бит_ВремяВыполнения,
	|ОперацииПереопределяемый.бит_ПроцентВыполненияВремени КАК бит_ПроцентВыполненияВремени,
	//|ОперацииПереопределяемый.бит_КоличествоХодовОперация КАК бит_КоличествоХодовОперация,
	|ОперацииПереопределяемый.Этап.КоличествоУпаковокПлан КАК бит_ПланПоЭтапу,
	|ОперацииПереопределяемый.бит_КоличествоПлан КАК бит_КоличествоПлан,
	|ОперацииПереопределяемый.бит_КоличествоФакт КАК бит_КоличествоФакт,");
	
	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый", 
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_БригадирРегистр КАК вт_БригадирРегистр
	|		ПО ОперацииПереопределяемый.СменноеЗадание = вт_БригадирРегистр.Смена
	|			И ОперацииПереопределяемый.Исполнитель = вт_БригадирРегистр.Бригада");

	НовыйЭлемент = Этаформа.Элементы.Вставить("бит_Бригадир", Тип("ПолеФормы"), Элементы.ОперацииДокумент, Элементы.ОперацииДокументИсполнитель);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОперацииДокумент.бит_Бригадир";
	НовыйЭлемент.Заголовок = "(бит) Бригадир";
	
	ТекстНаряды = "ВЫБРАТЬ
	|	бит_НарядОперации.Ссылка КАК Наряд,
	|	бит_НарядОперации.ДокументОснование КАК ПроизводственнаяОперация
	|ПОМЕСТИТЬ вт_Наряды
	|ИЗ
	|	Документ.бит_Наряд.Операции КАК бит_НарядОперации
	|ГДЕ
	|	НЕ бит_НарядОперации.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НарядОперации.ДокументОснование,
	|	бит_НарядОперации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ОперацииДокумент.ТекстЗапроса = ТекстНаряды + ОперацииДокумент.ТекстЗапроса; 
	
	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый",
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый
	|	ЛЕВОЕ СОЕДИНЕНИЕ вт_Наряды КАК вт_Наряды
	|		ПО вт_Наряды.ПроизводственнаяОперация = ОперацииПереопределяемый.Ссылка");
	
	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка,", 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка, 
	|вт_Наряды.Наряд КАК бит_Наряд,");
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("бит_ОперацииДокументНаряд", Тип("ПолеФормы"), Элементы.ОперацииДокумент, Элементы.ОперацииДокументКоличество);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОперацииДокумент.бит_Наряд";
	НовыйЭлемент.Заголовок = "(бит) Наряд";
	
	ТекстОшибкиВОперациях =  "ВЫБРАТЬ
	|	ПроизводственнаяОперация2_2.Ссылка КАК ПроизводственнаяОперация,
	|	бит_СоставИсполнителейИВремяВыполнения.Должность КАК ДолжностьИзСостава,
	|	бит_СоставИсполнителейИВремяВыполнения.Разряд КАК РазрядИзСостава
	|ПОМЕСТИТЬ вт_СотрудникиПоОперации
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
	|		ПО ПроизводственнаяОперация2_2.Ссылка = бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства
	|ГДЕ
	|	бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства.Проведен
	|	И бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства.СменноеЗадание = &СменноеЗадание
	|	И ПроизводственнаяОперация2_2.Проведен
	|	И ПроизводственнаяОперация2_2.СменноеЗадание = &СменноеЗадание
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СоставИсполнителейИВремяВыполнения.Разряд,
	|	ПроизводственнаяОперация2_2.Ссылка,
	|	бит_СоставИсполнителейИВремяВыполнения.Должность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_СотрудникиПоОперации.ПроизводственнаяОперация КАК ПроизводственнаяОперация,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Трудозатраты.ВидРабот ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ВидРаботЗаполнен
	|ПОМЕСТИТЬ вт_ВидыРаботПоОперации
	|ИЗ
	|	вт_СотрудникиПоОперации КАК вт_СотрудникиПоОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПроизводственнаяОперация2_2.Трудозатраты КАК Трудозатраты
	|		ПО вт_СотрудникиПоОперации.ДолжностьИзСостава = Трудозатраты.ВидРабот.бит_Должность
	|			И вт_СотрудникиПоОперации.РазрядИзСостава = Трудозатраты.ВидРабот.КвалификационныйРазряд
	|			И вт_СотрудникиПоОперации.ПроизводственнаяОперация = Трудозатраты.Ссылка
	|			И (Трудозатраты.Ссылка В
	|				(ВЫБРАТЬ
	|					вт_СотрудникиПоОперации.ПроизводственнаяОперация КАК ПроизводственнаяОперация
	|				ИЗ
	|					вт_СотрудникиПоОперации КАК вт_СотрудникиПоОперации))
	|			И (Трудозатраты.Ссылка.Проведен)
	|			И (Трудозатраты.Ссылка.СменноеЗадание = &СменноеЗадание)
	|			И (Трудозатраты.НазначениеРабот = &СтатьяЗП)
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_СотрудникиПоОперации.ПроизводственнаяОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ОперацииДокумент.ТекстЗапроса = ТекстОшибкиВОперациях + ОперацииДокумент.ТекстЗапроса;
	
	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый",
	"Документ.ПроизводственнаяОперация2_2 КАК ОперацииПереопределяемый
	|	ЛЕВОЕ СОЕДИНЕНИЕ вт_ВидыРаботПоОперации КАК вт_ВидыРаботПоОперации
	|		ПО вт_ВидыРаботПоОперации.ПроизводственнаяОперация = ОперацииПереопределяемый.Ссылка");
	
	ОперацииДокумент.ТекстЗапроса = СтрЗаменить(ОперацииДокумент.ТекстЗапроса, 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка,", 
	"ОперацииПереопределяемый.Ссылка КАК Ссылка, 
	|вт_ВидыРаботПоОперации.ВидРаботЗаполнен КАК бит_ВидРаботЗаполнен,");
	
	ОперацииДокумент.Параметры.УстановитьЗначениеПараметра("СтатьяЗП", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.бит_СтатьиКалькуляцииФОТБезПремии, ЭтотОбъект, Истина).Наименование);
		
	НовыйЭлемент = Этаформа.Элементы.Вставить("бит_ОперацииДокументВидРаботЗаполнен", Тип("ПолеФормы"), Элементы.ОперацииДокумент, Элементы.ОперацииДокументКоличество);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОперацииДокумент.бит_ВидРаботЗаполнен";
	НовыйЭлемент.Заголовок = "(бит) Вид работ заполнен";
	НовыйЭлемент.Видимость = Ложь;
	
	//Условное оформление
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОперацииДокумент.Имя);
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Статус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СтатусыСменныхЗаданий.Закрыто;
	ОтборЭлемента.Использование = Истина;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОперацииДокумент.бит_Наряд");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборЭлемента.ПравоеЗначение = Истина;
	ОтборЭлемента.Использование = Истина;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОперацииДокумент.бит_ВидРаботЗаполнен");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
