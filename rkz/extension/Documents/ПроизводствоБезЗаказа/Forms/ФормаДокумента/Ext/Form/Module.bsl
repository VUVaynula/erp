		ОписаниеОповещения = Новый ОписаниеОповещения("бит_СформироватьНарядыЗавершение", ЭтотОбъект); 
		
		ПоказатьВопрос(ОписаниеОповещения, "Создать наряды по документу?", РежимДиалогаВопрос.ДаНет);
		
