&НаСервере
Процедура бит_СформироватьНарядыНаСервере() 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроизводствоБезЗаказа.Ссылка КАК Ссылка,
	|	бит_НарядОперации.Ссылка КАК Наряд
	|ИЗ
	|	Документ.ПроизводствоБезЗаказа КАК ПроизводствоБезЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_Наряд.Операции КАК бит_НарядОперации
	|		ПО (бит_НарядОперации.ДокументОснование = ПроизводствоБезЗаказа.Ссылка)
	|ГДЕ
	|	ПроизводствоБезЗаказа.Ссылка = &ПроизводствоБезЗаказа
	|	И ПроизводствоБезЗаказа.Ссылка В
	|			(ВЫБРАТЬ
	|				бит_НарядОперации.ДокументОснование КАК ДокументОснование
	|			ИЗ
	|				Документ.бит_Наряд.Операции КАК бит_НарядОперации
	|			ГДЕ
	|				НЕ бит_НарядОперации.Ссылка.ПометкаУдаления)
	|	И НЕ бит_НарядОперации.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НарядОперации.Ссылка,
	|	ПроизводствоБезЗаказа.Ссылка";
	
	Запрос.УстановитьПараметр("ПроизводствоБезЗаказа", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СообщениеПользователю = Новый СообщениеПользователю; 
		СообщениеПользователю.Текст = "По операции: " + ВыборкаДетальныеЗаписи.Ссылка + " уже создан наряд: " + ВыборкаДетальныеЗаписи.Наряд;
		СообщениеПользователю.КлючДанных = ВыборкаДетальныеЗаписи.Наряд;
		СообщениеПользователю.УстановитьДанные(ВыборкаДетальныеЗаписи.Наряд);
		СообщениеПользователю.Сообщить();
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизводствоБезЗаказабит_СоставБригады.Ссылка КАК ПроизводственнаяОперация,
		|	ПроизводствоБезЗаказабит_СоставБригады.Сотрудник КАК Сотрудник,
		|	КадроваяИсторияСотрудниковИнтервальный.ДолжностьПоШтатномуРасписанию.Должность КАК ДолжностьСотрудника,
		|	КадроваяИсторияСотрудниковИнтервальный.ДолжностьПоШтатномуРасписанию.РазрядКатегория КАК РазрядСотрудника,
		|	ПроизводствоБезЗаказабит_СоставБригады.Ссылка.бит_Оборудование КАК НаименованиеВРЦ,
		|	ПроизводствоБезЗаказабит_СоставБригады.Должность КАК ДолжностьОперция,
		|	ПроизводствоБезЗаказабит_СоставБригады.Разряд КАК РазрядОперация,
		|	ПроизводствоБезЗаказабит_СоставБригады.КодОперации КАК КодОперации,
		|	ПроизводствоБезЗаказабит_СоставБригады.Начисление КАК Начисление
		|ПОМЕСТИТЬ вт_СотрудникиПоОперации
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.бит_СоставБригады КАК ПроизводствоБезЗаказабит_СоставБригады
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадроваяИсторияСотрудниковИнтервальный
		|		ПО ПроизводствоБезЗаказабит_СоставБригады.Сотрудник = КадроваяИсторияСотрудниковИнтервальный.Сотрудник
		|			И (&Дата МЕЖДУ КадроваяИсторияСотрудниковИнтервальный.ДатаНачала И КадроваяИсторияСотрудниковИнтервальный.ДатаОкончания)
		|ГДЕ
		|	НЕ ПроизводствоБезЗаказабит_СоставБригады.Ссылка В
		|				(ВЫБРАТЬ
		|					бит_НарядОперации.ДокументОснование КАК ДокументОснование
		|				ИЗ
		|					Документ.бит_Наряд.Операции КАК бит_НарядОперации
		|				ГДЕ
		|					НЕ бит_НарядОперации.Ссылка.ПометкаУдаления)
		|	И ПроизводствоБезЗаказабит_СоставБригады.Ссылка = &ПроизводствоБезЗаказа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПроизводствоБезЗаказаТрудозатраты.Ссылка КАК ПроизводственнаяОперация,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот КАК ВидРабот,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот.бит_Должность КАК ДолжностьОперации,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот.КвалификационныйРазряд КАК РазрядОперации,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот.Трудоемкость КАК НормоЧасы,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот.бит_РассчитываемоеКоличествоХодов КАК КоличествоХодов,
		|	ПроизводствоБезЗаказаТрудозатраты.ВидРабот.бит_ТехнологическаяСкорость КАК Скорость
		|ПОМЕСТИТЬ вт_ВидыРаботПоОперации
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.Трудозатраты КАК ПроизводствоБезЗаказаТрудозатраты
		|ГДЕ
		|	ПроизводствоБезЗаказаТрудозатраты.Ссылка В
		|			(ВЫБРАТЬ
		|				вт_СотрудникиПоОперации.ПроизводственнаяОперация КАК ПроизводственнаяОперация
		|			ИЗ
		|				вт_СотрудникиПоОперации КАК вт_СотрудникиПоОперации)
		|	И ПроизводствоБезЗаказаТрудозатраты.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПроизводствоБезЗаказаВыходныеИзделия.Ссылка КАК ПроизводственнаяОперация,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Номенклатура КАК Номенклатура,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Характеристика КАК Характеристика,
		|	СУММА(ПроизводствоБезЗаказаВыходныеИзделия.КоличествоУпаковок) КАК КоличествоФакт,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ вт_НоменклатураОперации
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК ПроизводствоБезЗаказаВыходныеИзделия
		|ГДЕ
		|	ПроизводствоБезЗаказаВыходныеИзделия.Ссылка.Проведен
		|	И ПроизводствоБезЗаказаВыходныеИзделия.Ссылка = &ПроизводствоБезЗаказа
		|
		|СГРУППИРОВАТЬ ПО
		|	ПроизводствоБезЗаказаВыходныеИзделия.Номенклатура,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Ссылка,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Характеристика,
		|	ПроизводствоБезЗаказаВыходныеИзделия.Упаковка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасценкиРаботСотрудниковСрезПоследних.ВидРабот КАК ВидРабот,
		|	РасценкиРаботСотрудниковСрезПоследних.КвалификационныйРазряд КАК КвалификационныйРазряд,
		|	РасценкиРаботСотрудниковСрезПоследних.Расценка КАК Расценка
		|ПОМЕСТИТЬ вт_РасценкиПоОперации
		|ИЗ
		|	РегистрСведений.РасценкиРаботСотрудников.СрезПоследних(
		|			&Дата,
		|			(ВидРабот, КвалификационныйРазряд) В
		|				(ВЫБРАТЬ
		|					вт_ВидыРаботПоОперации.ВидРабот КАК ВидРабот,
		|					вт_ВидыРаботПоОперации.РазрядОперации КАК РазрядОперации
		|				ИЗ
		|					вт_ВидыРаботПоОперации КАК вт_ВидыРаботПоОперации)) КАК РасценкиРаботСотрудниковСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_СотрудникиПоОперации.ПроизводственнаяОперация КАК ДокументОснование,
		|	вт_СотрудникиПоОперации.НаименованиеВРЦ КАК НаименованиеВРЦ,
		|	вт_СотрудникиПоОперации.Сотрудник КАК Сотрудник,
		|	вт_ВидыРаботПоОперации.ВидРабот КАК ВидРабот,
		|	вт_СотрудникиПоОперации.КодОперации КАК НаименованиеОперации,
		|	вт_ВидыРаботПоОперации.ДолжностьОперации КАК ДолжностьОперации,
		|	вт_ВидыРаботПоОперации.РазрядОперации КАК РазрядОперации,
		|	вт_СотрудникиПоОперации.ДолжностьСотрудника КАК ДолжностьСотрудника,
		|	вт_СотрудникиПоОперации.РазрядСотрудника КАК РазрядСотрудника,
		|	вт_НоменклатураОперации.Номенклатура КАК Номенклатура,
		|	вт_НоменклатураОперации.Упаковка КАК ЕдиницаИзмерения,
		|	вт_НоменклатураОперации.КоличествоФакт КАК КоличествоФакт,
		|	вт_РасценкиПоОперации.Расценка КАК Расценка,
		|	вт_РасценкиПоОперации.Расценка * вт_НоменклатураОперации.КоличествоФакт КАК СуммаПоОперации,
		|	вт_ВидыРаботПоОперации.НормоЧасы * вт_НоменклатураОперации.КоличествоФакт КАК НормоЧасы,
		|	вт_ВидыРаботПоОперации.КоличествоХодов КАК КоличествоХодов,
		|	вт_ВидыРаботПоОперации.Скорость КАК Скорость,
		|	вт_СотрудникиПоОперации.Начисление КАК Начисление
		|ИЗ
		|	вт_СотрудникиПоОперации КАК вт_СотрудникиПоОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ВидыРаботПоОперации КАК вт_ВидыРаботПоОперации
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт_РасценкиПоОперации КАК вт_РасценкиПоОперации
		|			ПО вт_ВидыРаботПоОперации.ВидРабот = вт_РасценкиПоОперации.ВидРабот
		|				И вт_ВидыРаботПоОперации.РазрядОперации = вт_РасценкиПоОперации.КвалификационныйРазряд
		|		ПО вт_СотрудникиПоОперации.ПроизводственнаяОперация = вт_ВидыРаботПоОперации.ПроизводственнаяОперация
		|			И вт_СотрудникиПоОперации.КодОперации = вт_ВидыРаботПоОперации.ВидРабот.бит_КодОперации
		|			И вт_СотрудникиПоОперации.ДолжностьОперция = вт_ВидыРаботПоОперации.ДолжностьОперации
		|			И вт_СотрудникиПоОперации.РазрядОперация = вт_ВидыРаботПоОперации.РазрядОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_НоменклатураОперации КАК вт_НоменклатураОперации
		|		ПО вт_СотрудникиПоОперации.ПроизводственнаяОперация = вт_НоменклатураОперации.ПроизводственнаяОперация
		|ИТОГИ ПО
		|	НаименованиеВРЦ,
		|	Сотрудник";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("РабочийЦентр", Объект.бит_Оборудование);
	Запрос.УстановитьПараметр("бит_КодОперации", ?(Объект.бит_Операции.Количество() <> 0, Объект.бит_Операции[0].Операция, Неопределено));
	Запрос.УстановитьПараметр("ПроизводствоБезЗаказа", Объект.Ссылка);                                 
	Запрос.УстановитьПараметр("СтатьяЗП", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.бит_СтатьиКалькуляцииФОТБезПремии, ЭтотОбъект, Истина).Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВРЦ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаВРЦ.Следующий() Цикл 
		
		ВыборкаСотрудники = ВыборкаВРЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСотрудники.Следующий() Цикл
			
			ВыборкаДетальныеЗаписи = ВыборкаСотрудники.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			НовыйДокумент = Документы.бит_Наряд.СоздатьДокумент();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НовыйДокумент.Дата = Объект.Дата;
				НовыйДокумент.Организация = ВыборкаДетальныеЗаписи.ДокументОснование.Организация;
				НовыйДокумент.Подразделение = Объект.Подразделение;
				
				НовыйДокумент.Исполнитель = ВыборкаДетальныеЗаписи.Сотрудник;
				НовыйДокумент.Оборудование  = ВыборкаДетальныеЗаписи.НаименованиеВРЦ;
				//НовыйДокумент.Смена   = Объект.Смена;
				
				НовыйДокумент.ДокументОснование = Объект.Ссылка;
				
				НоваяСтрока = НовыйДокумент.Операции.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
				
				НоваяСтрока.ИдентификаторСтроки = НоваяСтрока.НаименованиеОперации.УникальныйИдентификатор();
					
			КонецЦикла;
			
			ТЗ = НовыйДокумент.Операции.Выгрузить();
			ТЗ.Свернуть("Сотрудник, ДолжностьСотрудника, РазрядСотрудника, ДолжностьОперации, РазрядОперации, НаименованиеОперации, Начисление, НаименованиеВРЦ, ИдентификаторСтроки");
			
			НовыйДокумент.Исполнители.Загрузить(ТЗ);
			
			ЗаполнитьИтоговыеСтроки(НовыйДокумент);
			
			НовыйДокумент.Записать();
			
			СообщениеПользователю = Новый СообщениеПользователю; 
			СообщениеПользователю.Текст = "По Исполнителю: " + ВыборкаДетальныеЗаписи.Сотрудник + " создан новый документ! " + Строка(НовыйДокумент.Ссылка);
			СообщениеПользователю.КлючДанных = НовыйДокумент.Ссылка;
			СообщениеПользователю.УстановитьДанные(НовыйДокумент.Ссылка);
			СообщениеПользователю.Сообщить();
			
		КонецЦикла; 
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИтоговыеСтроки(НовыйДокумент)

	ТЗОперация = НовыйДокумент.Операции.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗОперация.Сотрудник КАК Сотрудник,
	|	ТЗОперация.Номенклатура КАК Номенклатура,
	|	ТЗОперация.НаименованиеВРЦ КАК НаименованиеВРЦ,
	|	ТЗОперация.КоличествоХодов КАК КоличествоХодов,
	|	ТЗОперация.КоличествоФакт КАК КоличествоФакт,
	|	ТЗОперация.СуммаПоОперации КАК СуммаПоОперации,
	|	ТЗОперация.НормоЧасы КАК НормоЧасы,
	|	ТЗОперация.ЧасыФакт КАК ЧасыФакт,
	|	ИСТИНА КАК ИтоговаяСтрока
	|ПОМЕСТИТЬ вт_ИтоговыеСтроки
	|ИЗ
	|	&ТЗОперация КАК ТЗОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ИтоговыеСтроки.Сотрудник КАК Сотрудник,
	|	вт_ИтоговыеСтроки.Номенклатура КАК Номенклатура,
	|	вт_ИтоговыеСтроки.НаименованиеВРЦ КАК НаименованиеВРЦ,
	|	вт_ИтоговыеСтроки.КоличествоХодов КАК КоличествоХодов,
	|	СУММА(вт_ИтоговыеСтроки.КоличествоФакт) КАК КоличествоФакт,
	|	СУММА(вт_ИтоговыеСтроки.СуммаПоОперации) КАК СуммаПоОперации,
	|	СУММА(вт_ИтоговыеСтроки.НормоЧасы) КАК НормоЧасы,
	|	СУММА(вт_ИтоговыеСтроки.ЧасыФакт) КАК ЧасыФакт,
	|	вт_ИтоговыеСтроки.ИтоговаяСтрока КАК ИтоговаяСтрока
	|ИЗ
	|	вт_ИтоговыеСтроки КАК вт_ИтоговыеСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ИтоговыеСтроки.КоличествоХодов,
	|	вт_ИтоговыеСтроки.ИтоговаяСтрока,
	|	вт_ИтоговыеСтроки.Сотрудник,
	|	вт_ИтоговыеСтроки.НаименованиеВРЦ,
	|	вт_ИтоговыеСтроки.Номенклатура";
	
	Запрос.УстановитьПараметр("ТЗОперация", ТЗОперация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = НовыйДокумент.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		//НоваяСтрока.Сотрудник = Неопределено;
		//НоваяСтрока.Номенклатура = Неопределено;
		//НоваяСтрока.НаименованиеВРЦ = Неопределено;
		//НоваяСтрока.КоличествоХодов = Неопределено;
		НоваяСтрока.СтрокаИтого = "ИТОГО:";
	КонецЦикла;
	
	НовыйДокумент.Операции.Сортировать("Сотрудник, Номенклатура, НаименованиеВРЦ, КоличествоХодов, ИтоговаяСтрока ВОЗР");
	
КонецПроцедуры


&НаКлиенте
Процедура бит_СоставБригадыСотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.бит_СоставБригады.ТекущиеДанные;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("бит_СоставБригадыСотрудникНачалоВыбораЗавершение", ЭтотОбъект);
	
	ПроизводствоКлиент.ОткрытьФормуВыбораИсполнителя(
	Объект.Организация,
	Объект.Подразделение,
	ТекущиеДанные.Сотрудник,                
	Объект.Дата,
	Истина,
	ОписаниеОповещения);
	
КонецПроцедуры 

&НаКлиенте
Процедура бит_СоставБригадыСотрудникНачалоВыбораЗавершение(Результат, Параметры) Экспорт
	
	ТекущиеДанные = Элементы.бит_СоставБригады.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Результат) Тогда
		
		ТекущиеДанные.Сотрудник = Результат;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ИсполнительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("бит_ИсполнительНачалоВыбораЗавершение", ЭтотОбъект);
	
	ПроизводствоКлиент.ОткрытьФормуВыбораИсполнителя(
	Объект.Организация,
	Объект.Подразделение,
	Объект.бит_Исполнитель,                
	Объект.Дата,
	,
	ОписаниеОповещения);
	
КонецПроцедуры 

&НаКлиенте
Процедура бит_ИсполнительНачалоВыбораЗавершение(Результат, Параметры) Экспорт
	
	Если  ЗначениеЗаполнено(Результат) Тогда
		
		Объект.бит_Исполнитель = Результат;
		Модифицированность = Истина;
		
		//Элементы.бит_СтраницаСоставБригады.Видимость = ТипЗнч(Объект.бит_Исполнитель) = Тип("СправочникСсылка.Бригады");
	
		УстановитьИсполнителяВТрудозатратах();
		
		Если ТипЗнч(Объект.бит_Исполнитель) = Тип("СправочникСсылка.Бригады") Тогда
			Объект.бит_СоставБригады.Очистить();	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_СоставБригадыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда

        Элемент.ТекущиеДанные.ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час");

	КонецЕсли;
	
КонецПроцедуры

