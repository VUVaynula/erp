Процедура ОперацияПриИзменении()
	
	ТекущиеДанные = Элементы.бит_Операции.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
	
		ОперацияПриИзмененииНаСервере(ТекущиеДанные.Операция, ТекущиеДанные.ГруппаЗатрат, ТекущиеДанные.НомерГруппыЗатрат);

	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ОперацияПриИзмененииНаСервере(Операция, ГруппаЗатрат, НомерГруппыЗатрат)
	

	ТЗ = Объект.ВыходныеИзделия.Выгрузить();
	//ТЗ.Свернуть("Номенклатура");
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.КоличествоУпаковок КАК Количество,
		|	ТЗ.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ вт_Номенклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыРаботСотрудников.Ссылка КАК Ссылка,
		|	вт_Номенклатура.Количество КАК Количество,
		|	вт_Номенклатура.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	вт_Номенклатура КАК вт_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
		|		ПО вт_Номенклатура.Номенклатура = ВидыРаботСотрудников.бит_Номенклатура
		|ГДЕ
		|	ВидыРаботСотрудников.бит_КодОперации = &бит_КодОперации
		|	И ВидыРаботСотрудников.бит_КодВРЦ = &бит_КодВРЦ
		|	И НЕ ВидыРаботСотрудников.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		Запрос.УстановитьПараметр("бит_КодВРЦ", Объект.бит_Оборудование);
		Запрос.УстановитьПараметр("бит_КодОперации", Операция);		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяСтрока = Объект.Трудозатраты.Добавить();
			НоваяСтрока.ВидРабот = ВыборкаДетальныеЗаписи.Ссылка;
			НоваяСтрока.Подразделение = Объект.Подразделение;
			НоваяСтрока.Количество = ВыборкаДетальныеЗаписи.Количество;
			НоваяСтрока.СтатьяКалькуляции = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.бит_СтатьиКалькуляцииФОТБезПремии, ЭтаФорма, Истина);
			НоваяСтрока.НомерГруппыЗатрат = НомерГруппыЗатрат;
			НоваяСтрока.ГруппаЗатрат = ГруппаЗатрат;
			НоваяСтрока.Исполнитель = Объект.бит_Исполнитель;
		КонецЦикла;
		
	
КонецПроцедуры
 
