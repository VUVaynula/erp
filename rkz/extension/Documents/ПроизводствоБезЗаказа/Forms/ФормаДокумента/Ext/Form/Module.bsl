	ЭтаФорма.Элементы.бит_Выполнено.ЦветФона = ?(Объект.бит_Выполнено, WebЦвета.БледноЗеленый, Новый Цвет(255,255,255));
	ЭтаФорма.Элементы.бит_Выполнено.Пометка = Объект.бит_Выполнено; 
	
	Если Объект.бит_Выполнено Тогда
		
