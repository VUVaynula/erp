&После("ДобавитьКомандыПечати")
Процедура бит_ДобавитьКомандыПечати(КомандыПечати)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.1.5] [ASHolyavko@1cbit.ru] [29.10.2025] +        
	
	КомандаПечати = КомандыПечати.Добавить();
