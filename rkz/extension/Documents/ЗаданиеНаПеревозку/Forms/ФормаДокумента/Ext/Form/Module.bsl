&НаКлиенте
Процедура бит_ДекорацияСостояниеРасчетовНажатиеНаКлиенте(Элемент, СтандартнаяОбработка)
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] + 
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = бит_ПолучитьСтруктуруПараметровРасчетов();
	
	Если Не СтруктураПараметров = Неопределено Тогда
		ВзаиморасчетыКлиентСервер.ПроверитьОбязательныеПараметры(СтруктураПараметров,
		"Дата, ВалютаДокумента, Договор, СуммаДокумента");
		
		ПараметрОтчета = СтруктураПараметров.ОбъектРасчетов;
		
		Если ТипЗнч(ПараметрОтчета) = Тип("Массив") Тогда
			ПараметрОтчета = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПараметрОтчета);
			Если ПараметрОтчета.Количество() = 1 Тогда
				ПараметрОтчета = ПараметрОтчета[0];
			КонецЕсли;
		КонецЕсли;
		
		ОтчетыУТКлиентПереопределяемый.ОткрытьОтчетКарточкаРасчетовСПоставщиками("КарточкаРасчетовСПоставщикамиПоДокументамКонтекст", ПараметрОтчета);
	КонецЕсли;
    // ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] -
	
КонецПроцедуры	

&НаСервере
Функция бит_ПолучитьСтруктуруПараметровРасчетов()
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] + 
	Если ЗначениеЗаполнено(Объект.бит_ПриобретениеУслугПеревозки) Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Дата", Объект.бит_ПриобретениеУслугПеревозки.Дата);
		СтруктураПараметров.Вставить("ВалютаДокумента", Объект.бит_ПриобретениеУслугПеревозки.Валюта); 
		СтруктураПараметров.Вставить("Договор", Объект.бит_ПриобретениеУслугПеревозки.Договор); 
		СтруктураПараметров.Вставить("СуммаДокумента", Объект.бит_ПриобретениеУслугПеревозки.СуммаДокумента);
		СтруктураПараметров.Вставить("ОбъектРасчетов", Объект.бит_ПриобретениеУслугПеревозки.Ссылка);
		
		Возврат СтруктураПараметров;  
		
	Иначе   
		
		Возврат Неопределено;  
		
	КонецЕсли;
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] - 

КонецФункции

