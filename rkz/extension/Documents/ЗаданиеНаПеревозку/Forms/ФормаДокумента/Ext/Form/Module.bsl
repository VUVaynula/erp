&НаСервере
Процедура бит_ОбновитьТекстГиперссылкиСостояниеРасчетов() 
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] + 
	ЭлементНадписьРасчеты = ЭтаФорма.Элементы.бит_ДекорацияСостояниеРасчетов;
	
	Если ЗначениеЗаполнено(Объект.бит_ПриобретениеУслугПеревозки) Тогда
		
		ДокументПриобретения = Объект.бит_ПриобретениеУслугПеревозки;
		ВалютаВзаиморасчетов  = ДокументПриобретения.ВалютаВзаиморасчетов;
		ЭлементНадписьРасчеты = ЭтаФорма.Элементы.бит_ДекорацияСостояниеРасчетов; 
		
		ТекстПредупреждения = "";
		Если НЕ ВзаиморасчетыСервер.ОтложенноеОбновлениеРегистровВзаиморасчетовЗавершено() Тогда
			ТекстПредупреждения = НСтр("ru = 'Данные могут быть неточными, выполняется обновление ИБ.';
			|en = 'The data might be inaccurate. Updating the infobase.'");
		КонецЕсли;
		
		СостояниеВзаиморасчетов = бит_СостояниеВзаиморасчетов(ДокументПриобретения);
		СуммаОплат   = Макс(0, СостояниеВзаиморасчетов.СуммаОплат);
		ПроцентОплат = Макс(0, бит_ОкруглитьПроценты(СостояниеВзаиморасчетов.ПроцентОплат));
		
		ЭлементНадписьРасчеты.Заголовок = НСтр("ru = 'Оплачено';
		|en = 'Amount paid'") + ": " + Формат(СуммаОплат, "ЧДЦ=2; ЧН=") + " " + ВалютаВзаиморасчетов + " " + ПроцентОплат + "%"
		+ ?(ПустаяСтрока(ТекстПредупреждения), "", " ") + ТекстПредупреждения; 
		
	Иначе
		
		ЭлементНадписьРасчеты.Заголовок = НСтр("ru = 'Оплачено';
		|en = 'Amount paid'") + ": 0.00 руб. 0%";
		
	КонецЕсли;
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] -
	
КонецПроцедуры  

&НаСервере
Функция бит_СостояниеВзаиморасчетов(ДокументПриобретения) 
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] +
	СуммаВзаиморасчетов = ?(ДокументПриобретения.СуммаВзаиморасчетов = 0 ,ДокументПриобретения.СуммаДокумента, ДокументПриобретения.СуммаВзаиморасчетов);
	Организация         = ДокументПриобретения.Организация;
	ТипРасчетов         = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	ПорядокРасчетов     = ДокументПриобретения.ПорядокРасчетов;
	
	ОбъектРасчетов = ДокументПриобретения.ОбъектРасчетов;
	Если ТипЗнч(ОбъектРасчетов) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ОбъектРасчетов, ПредопределенноеЗначение("Справочник.ОбъектыРасчетов.ПустаяСсылка"));
		ОбъектРасчетов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ОбъектРасчетов);
		Если ОбъектРасчетов.Количество() = 1 Тогда
			ОбъектРасчетов = ОбъектРасчетов[0];
			СуммаВзаиморасчетов = 0;
		Иначе
			ОбъектРасчетов = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВзаиморасчетыСервер.СостояниеВзаиморасчетовОбъектаРасчетов(ОбъектРасчетов, СуммаВзаиморасчетов, ТипРасчетов, Организация, Ложь, Ложь);
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] - 
	
КонецФункции 

&НаСервере
Функция бит_ОкруглитьПроценты(ОкругляемоеЧисло)
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] +
	Если ОкругляемоеЧисло > 99
		И ОкругляемоеЧисло < 100 Тогда
		Результат = 99;
	ИначеЕсли ОкругляемоеЧисло > 0
		И ОкругляемоеЧисло < 1 Тогда
		Результат = 1;
	Иначе
		Результат = Окр(ОкругляемоеЧисло);
	КонецЕсли;
	
	Возврат Результат; 
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] -
	
