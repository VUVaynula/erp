&НаСервере
Процедура ПересчитатьНормуИФактВремени()
	
	ЕдИзмеренияСпецификации = Спецификация.ОсновноеИзделиеУпаковка;	
	НоменклатураВыпуска = Спецификация.ОсновноеИзделиеНоменклатура;
	ЕдИзмеренияИзделия = Спецификация.ОсновноеИзделиеНоменклатура.ЕдиницаИзмерения;
	
	КоэффициентВыпуска = Объект.КоличествоФакт / Объект.Количество;
	
	НормаВремени = 0;
	
	Если ЕдИзмеренияИзделия <> ЕдИзмеренияСпецификации Тогда
	КонецЕсли;	
	
	Для Каждого СтрокаТрудозатрат из Объект.Трудозатраты Цикл
		
		НормаВремениТрудозатрат = СтрокаТрудозатрат.Количество * СтрокаТрудозатрат.ВидРабот.Трудоемкость; 
		НормаВремениТрудозатрат = НормаВремениТрудозатрат * КоэффициентВыпуска;
		
		Если ЕдИзмеренияСпецификации <> СтрокаТрудозатрат.ВидРабот.ЕдиницаИзмерения Тогда
			
			//ДанныеОбУпаковке = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентВесОбъемПрочиеРеквизитыУпаковки(СтрокаТрудозатрат.ВидРабот.ЕдиницаИзмерения, НоменклатураВыпуска, , Ложь);
			//
			//КоэффициентВыпуска = (Объект.КоличествоФакт / ДанныеОбУпаковке.Коэффициент) * ;
			
		КонецЕсли;
		
		НормаВремени = НормаВремени + НормаВремениТрудозатрат;
		
	КонецЦикла;
	
	//Если Объект.ВремяВыполненияЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута Тогда
	//	НормаВремени = НормаВремени * 60;
	//КонецЕсли;
	
	Для Каждого СтрокаСоставБригады из Объект.бит_СоставБригады Цикл
		СтрокаСоставБригады.ВремяФакт = НормаВремени;
		СтрокаСоставБригады.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час;
	КонецЦикла;
	
	Объект.бит_ВремяВыполненияНорма = НормаВремени;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ВыходныеИзделияКоличествоУпаковокПриИзмененииПосле(Элемент)
	РасчитатьИтоговоеЗначениеКоличествоФакт();	
КонецПроцедуры  

&НаСервере
Функция ПолучитьНоменклатуруСпецификации(Спецификация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура КАК ОсновноеИзделиеНоменклатура
		|ИЗ
		|	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
		|ГДЕ
		|	РесурсныеСпецификации.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Спецификация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ОсновноеИзделиеНоменклатура;
	КонецЦикла;
	
	Возврат ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	
	
КонецФункции

&НаКлиенте
Процедура бит_ВыходныеИзделияПриИзмененииПосле(Элемент)
	РасчитатьИтоговоеЗначениеКоличествоФакт();
КонецПроцедуры   

&НаКлиенте
Процедура РасчитатьИтоговоеЗначениеКоличествоФакт()
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("Номенклатура", ПолучитьНоменклатуруСпецификации(Спецификация));
	
	НайденныеСтроки = Объект.ВыходныеИзделия.НайтиСтроки(ОтборСтрок);
	
	Количество = 0;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Количество = Количество + НайденнаяСтрока.КоличествоУпаковок;
	КонецЦикла;
	
	Объект.бит_КоличествоФакт = Количество
				
КонецПроцедуры
