&НаСервере
Процедура ПолучитьВидРаботПоКоличествуХодов()

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("КодВРЦ", Объект.ВидРабочегоЦентра);
	СтруктураОтбора.Вставить("КодОперации", Объект.Операция.бит_КодОперации);
	СтруктураОтбора.Вставить("Номенклатура", Спецификация.ОсновноеИзделиеНоменклатура);
	СтруктураОтбора.Вставить("РассчитываемоеКоличествоХодов", Объект.бит_КоличествоХодовОперация);
	
	ВидРабот = Документы.ПроизводственнаяОперация2_2.ПолучитьВидРаботПоОтбор(СтруктураОтбора);
	
	Если ЗначениеЗаполнено(ВидРабот) Тогда
		Объект.ВремяВыполнения = ВидРабот.бит_ВремяВыполнения;
		Объект.бит_ВремяВыполненияНорма = ВидРабот.бит_ВремяВыполнения;
	КонецЕсли;
	
КонецПроцедуры

