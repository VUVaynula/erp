&НаСервере
Процедура бит_ЗаполнитьСоставБригадыНаСервере()
	
	Объект.бит_СоставБригады.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот КАК ВидРабот,
		|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот.бит_Должность КАК ВидРаботбит_Должность,
		|	ПроизводственнаяОперация2_2Трудозатраты.ВидРабот.КвалификационныйРазряд КАК ВидРаботКвалификационныйРазряд
		|ПОМЕСТИТЬ вт_Трудозатраты
		|ИЗ
		|	Документ.ПроизводственнаяОперация2_2.Трудозатраты КАК ПроизводственнаяОперация2_2Трудозатраты
		|ГДЕ
		|	ПроизводственнаяОперация2_2Трудозатраты.Ссылка = &ДокументПроизводства
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_СоставИсполнителейИВремяВыполнения.Сотрудник КАК Сотрудник,
		|	бит_СоставИсполнителейИВремяВыполнения.Должность КАК Должность,
		|	бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства КАК ДокументПроизводства,
		|	бит_СоставИсполнителейИВремяВыполнения.Разряд КАК Разряд,
		|	бит_СоставИсполнителейИВремяВыполнения.Начисление КАК Начисление,
		|	бит_СоставИсполнителейИВремяВыполнения.ЧасыНорма КАК ЧасыНорма,
		|	бит_СоставИсполнителейИВремяВыполнения.ЧасыФакт КАК ЧасыФакт,
		|	вт_Трудозатраты.ВидРабот КАК ВидРабот
		|ИЗ
		|	вт_Трудозатраты КАК вт_Трудозатраты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
		|		ПО вт_Трудозатраты.ВидРаботбит_Должность = бит_СоставИсполнителейИВремяВыполнения.Должность
		|			И вт_Трудозатраты.ВидРаботКвалификационныйРазряд = бит_СоставИсполнителейИВремяВыполнения.Разряд
		|ГДЕ
		|	бит_СоставИсполнителейИВремяВыполнения.Смена = &Смена
		|	И бит_СоставИсполнителейИВремяВыполнения.ДокументПроизводства = НЕОПРЕДЕЛЕНО
		|	И ВЫБОР
		|			КОГДА &ЭтоБригада
		|				ТОГДА бит_СоставИсполнителейИВремяВыполнения.Бригада = &Исполнитель
		|						И бит_СоставИсполнителейИВремяВыполнения.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|			ИНАЧЕ бит_СоставИсполнителейИВремяВыполнения.Сотрудник = &Исполнитель
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ДокументПроизводства", Объект.Ссылка);
	Запрос.УстановитьПараметр("ЭтоБригада", ТипЗнч(Объект.Исполнитель) = Тип("СправочникСсылка.Бригады"));
	Запрос.УстановитьПараметр("Исполнитель", Объект.Исполнитель);
    Запрос.УстановитьПараметр("Смена", Объект.СменноеЗадание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = Объект.бит_СоставБригады.Добавить();
		НоваяСтрока.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
		НоваяСтрока.Должность = ВыборкаДетальныеЗаписи.Должность;
		НоваяСтрока.Разряд = ВыборкаДетальныеЗаписи.Разряд;
		НоваяСтрока.Начисление = ВыборкаДетальныеЗаписи.Начисление;
		НоваяСтрока.ВремяФакт = ВыборкаДетальныеЗаписи.ЧасыФакт;
		НоваяСтрока.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час;	
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

