				ПФ = Новый Структура("Ключ, Документ, Номенклатура, Упаковка, Количество, КоличествоУпаковок, НомерСтроки",
								СписокСерий[0].Серия,
								Объект.Ссылка, 
								ТД.Номенклатура,
								ТД.Упаковка,
								ТД.Количество,
								ТД.КоличествоУпаковок,
								ТД.НомерСтроки);
			Иначе
				ОткрытьПодборСерий(ИмяТЧ);
			КонецЕсли;
		КонецЕсли;   
	КонецЕсли;
	Если ПФ <> Неопределено Тогда
		ОткрытьФорму("Справочник.СерииНоменклатуры.Форма.бит_ФормаАтрибутыТары", ПФ, ЭтаФорма, УникальныйИдентификатор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
