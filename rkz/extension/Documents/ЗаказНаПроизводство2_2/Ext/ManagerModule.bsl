&После("ДобавитьКомандыПечати")
Процедура бит_ДобавитьКомандыПечати(КомандыПечати)
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] + 
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "бит_СуточныйЗапуск";
	КомандаПечати.Представление = НСтр("ru = '(бит) Суточный запуск'"); 
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецПроцедуры

&После("Печать")
Процедура бит_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "бит_СуточныйЗапуск");
	Если ПечатнаяФорма <> Неопределено Тогда
		
		Заголовок = НСтр("ru = '(бит) Суточный запуск'");
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"бит_СуточныйЗапуск", 
				Заголовок,
				бит_СформироватьПечатнуюФормуСуточныйЗапуск(МассивОбъектов),
				,
				"Документ.ЗаказНаПроизводство2_2.бит_ПФ_MXL_СуточныйЗапуск");
	КонецЕсли; 
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -

КонецПроцедуры   

Функция бит_СформироватьПечатнуюФормуСуточныйЗапуск(МассивОбъектов)
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +

	УстановитьПривилегированныйРежим(Истина); 
	
	СправочникЗанченияПоУмолчанию = Справочники.бит_ЗначенияПоУмолчанию;
	
	ВидИсполнения 	= СправочникЗанченияПоУмолчанию.ПолучитьМассивЗначений(СправочникЗанченияПоУмолчанию.ПризнакВидИсполненияГотовойПродукции, Неопределено, Истина); 
	Сечение	 		= СправочникЗанченияПоУмолчанию.ПолучитьМассивЗначений(СправочникЗанченияПоУмолчанию.ПризнакРазмерГотовойПродукции, Неопределено, Истина); 
	ТоннажCu 		= СправочникЗанченияПоУмолчанию.ПолучитьМассивЗначений(СправочникЗанченияПоУмолчанию.ПризнакМедь, Неопределено, Истина); 
	ТоннажAl 		= СправочникЗанченияПоУмолчанию.ПолучитьМассивЗначений(СправочникЗанченияПоУмолчанию.ПризнакАлюминий, Неопределено, Истина);
	
	ПараметрыПечати = ИСТИНА;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ПолеСлева = 5;
	ТабличныйДокумент.ПолеСправа = 5;
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 0;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабличныйДокумент.КлючПараметровПечати = "бит_СуточныйЗапуск";
	
	Макет = ПолучитьМакет("бит_ПФ_MXL_СуточныйЗапуск");
	
	ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок");   
	ОбластьШапкаТаблицы 	= Макет.ПолучитьОбласть("ШапкаТаблицы"); 
	ОбластьСтрокаСклад 		= Макет.ПолучитьОбласть("СтрокаСклад"); 
	ОбластьСтрокаТаблицы 	= Макет.ПолучитьОбласть("СтрокаТаблицы");  
	ОбластьСтрокаИтог 		= Макет.ПолучитьОбласть("СтрокаИтог"); 
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИСТИНА КАК НеВключатьВСуточныйПакет,
		|	Номенклатура.Ссылка КАК Номенклатура
		|ПОМЕСТИТЬ вт_НоменклатураНеВСуточномПакете
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_НеВключатьВСуточныйПакет КАК бит_НеВключатьВСуточныйПакет
		|		ПО (Номенклатура.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры)
		|ГДЕ
		|	НЕ бит_НеВключатьВСуточныйПакет.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказНаПроизводство2_2Продукция.Ссылка КАК Ссылка,
		|	ЗаказНаПроизводство2_2Продукция.НомерСтроки КАК НомерСтроки,
		|	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
		|	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика,
		|	ЗаказНаПроизводство2_2Продукция.Упаковка КАК Упаковка,
		|	ЗаказНаПроизводство2_2Продукция.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ЗаказНаПроизводство2_2Продукция.Количество КАК Количество,
		|	ЗаказНаПроизводство2_2Продукция.Спецификация КАК Спецификация,
		|	ЗаказНаПроизводство2_2Продукция.Склад КАК Склад,
		|	ЗаказНаПроизводство2_2Продукция.Подразделение КАК Подразделение,
		|	вт_НоменклатураНеВСуточномПакете.НеВключатьВСуточныйПакет КАК НеВключатьВСуточныйПакет
		|ПОМЕСТИТЬ вт_ЗаказНаПроизводствоПродукция
		|ИЗ
		|	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_НоменклатураНеВСуточномПакете КАК вт_НоменклатураНеВСуточномПакете
		|		ПО ЗаказНаПроизводство2_2Продукция.Номенклатура = вт_НоменклатураНеВСуточномПакете.Номенклатура
		|ГДЕ
		|	ЗаказНаПроизводство2_2Продукция.Ссылка В(&МассивОбъектов)
		|	И ЕСТЬNULL(вт_НоменклатураНеВСуточномПакете.НеВключатьВСуточныйПакет, 0) = 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	Спецификация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЭтапыПроизводства.Владелец КАК Владелец,
		|	ЭтапыПроизводства.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ вт_ЗаключительныеЭтапыПроизводства
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|		ПО вт_ЗаказНаПроизводствоПродукция.Спецификация = ЭтапыПроизводства.Владелец
		|ГДЕ
		|	ЭтапыПроизводства.НомерСледующегоЭтапа = 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаключительныеЭтапыПроизводства.Подразделение.Наименование КАК ПодразделениеПредставление,
		|	СпрНоменклатура.Марка КАК Марка,
		|	СпрНоменклатура.Представление КАК НоменклатураПредставление,
		|	ВЫБОР
		|		КОГДА вт_ЗаказНаПроизводствоПродукция.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяССылка)
		|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения
		|		ИНАЧЕ вт_ЗаказНаПроизводствоПродукция.Упаковка
		|	КОНЕЦ КАК ЕдИзм,
		|	ВЫБОР
		|		КОГДА вт_ЗаказНаПроизводствоПродукция.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяССылка)
		|			ТОГДА вт_ЗаказНаПроизводствоПродукция.Количество
		|		ИНАЧЕ вт_ЗаказНаПроизводствоПродукция.КоличествоУпаковок
		|	КОНЕЦ КАК Количество,
		|	ЗаказНаПроизводство2_2.бит_ПереданВПроизводство КАК ДатаЗапуска,
		|	ЗаказНаПроизводство2_2.Комментарий КАК ПримечаниеКЗаказу,
		|	СпрНоменклатура.Артикул КАК КодАртикул,
		|	СпрНоменклатура.Ссылка КАК НоменклатураСсылка,
		|	ЗаказНаПроизводство2_2.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ вт_ВыборкаБезЗаказовКлиентовДавальцев
		|ИЗ
		|	Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|			ПО вт_ЗаказНаПроизводствоПродукция.Номенклатура = СпрНоменклатура.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт_ЗаключительныеЭтапыПроизводства КАК вт_ЗаключительныеЭтапыПроизводства
		|			ПО вт_ЗаказНаПроизводствоПродукция.Спецификация = вт_ЗаключительныеЭтапыПроизводства.Владелец
		|		ПО ЗаказНаПроизводство2_2.Ссылка = вт_ЗаказНаПроизводствоПродукция.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументОснование,
		|	НоменклатураСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ЗаказКлиентаТовары.ДатаОтгрузки) КАК ДатаОтгрузкиТоваров,
		|	ЗаказКлиентаТовары.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ПО вт_ЗаказНаПроизводствоПродукция.Ссылка.ДокументОснование = ЗаказКлиентаТовары.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МАКСИМУМ(ЗаказДавальца2_5Продукция.ДатаОтгрузки),
		|	ЗаказДавальца2_5Продукция.Ссылка
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца2_5.Продукция КАК ЗаказДавальца2_5Продукция
		|		ПО вт_ЗаказНаПроизводствоПродукция.Ссылка.ДокументОснование = ЗаказДавальца2_5Продукция.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказДавальца2_5Продукция.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ЗаказКлиента.ДатаОтгрузки > вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.ДатаОтгрузкиТоваров
		|			ТОГДА ЗаказКлиента.ДатаОтгрузки
		|		ИНАЧЕ вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.ДатаОтгрузкиТоваров
		|	КОНЕЦ КАК МаксимальнаяДатаОтгрузки,
		|	ЗаказКлиента.Номер КАК Номер,
		|	ЗаказКлиента.бит_Толеранс КАК бит_Толеранс
		|ПОМЕСТИТЬ вт_ЗаказыКлиентовДавальцев
		|ИЗ
		|	вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца КАК вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ПО вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.Ссылка = ЗаказКлиента.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.Ссылка,
		|	ВЫБОР
		|		КОГДА ЗаказДавальца2_5.ДатаОтгрузки > вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.ДатаОтгрузкиТоваров
		|			ТОГДА ЗаказДавальца2_5.ДатаОтгрузки
		|		ИНАЧЕ вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.ДатаОтгрузкиТоваров
		|	КОНЕЦ,
		|	ЗаказДавальца2_5.Номер + "" (Дав)"",
		|	ЗаказДавальца2_5.бит_Толеранс
		|ИЗ
		|	вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца КАК вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца2_5 КАК ЗаказДавальца2_5
		|		ПО вт_МаксимумДатыОтгрузкиЗаказКлиентаДавальца.Ссылка = ЗаказДавальца2_5.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаказНаПроизводствоПродукция.Номенклатура КАК Номенклатура,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК Сечение
		|ПОМЕСТИТЬ вт_Сечение
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
		|		ПО (вт_ЗаказНаПроизводствоПродукция.Номенклатура = бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура)
		|ГДЕ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &Сечение
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаказНаПроизводствоПродукция.Номенклатура КАК Номенклатура,
		|	СУММА(ВЫРАЗИТЬ(бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК ЧИСЛО(15, 5))) КАК ТоннажCu
		|ПОМЕСТИТЬ вт_ТоннажCu
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
		|		ПО (вт_ЗаказНаПроизводствоПродукция.Номенклатура = бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура)
		|ГДЕ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &ТоннажCu
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ЗаказНаПроизводствоПродукция.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаказНаПроизводствоПродукция.Номенклатура КАК Номенклатура,
		|	СУММА(ВЫРАЗИТЬ(бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК ЧИСЛО(15, 5))) КАК ТоннажAl
		|ПОМЕСТИТЬ вт_ТоннажAl
		|ИЗ
		|	вт_ЗаказНаПроизводствоПродукция КАК вт_ЗаказНаПроизводствоПродукция
