
&После("ОбработкаЗаполнения")
Процедура бит_ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ9/12] [ASHolyavko@1cbit.ru] [19.08.2024] +        
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("Основание") Тогда // создание на основании заказа	
			ТипОснования = ТипЗнч(ДанныеЗаполнения.Основание);
			Если ТипОснования = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				Комментарий = ДанныеЗаполнения.Основание.Комментарий;
				бит_Толеранс = ДанныеЗаполнения.Основание.бит_Толеранс;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ9/12] [ASHolyavko@1cbit.ru] [19.08.2024] -
	
КонецПроцедуры  

&После("ОбработкаПроверкиЗаполнения")
Процедура бит_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +  
		
	Если ЭтотОбъект.бит_ПереданВПроизводство = Дата('00010101') 
		И (ЭтотОбъект.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.КПроизводству ИЛИ ЭтотОбъект.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.Закрыт) Тогда
		
		//Заказы с пустой датой передачи в производство не содержащие суточную номенклатуру нельзя переводить в рабочие статусы
		Если НЕ бит_ЗаказСодержитНоменклатуруНеВключатьВСуточныйПакет() Тогда
			ОбщегоНазначения.СообщитьПользователю("Необходимо заполнить реквизит ""Перадан в производство"" (ЛТ29)");   
			Отказ = ИСТИНА;
			Возврат; 	
		КонецЕсли;
		
		//Нельзя очищать дату передачи в производство в рабочих заказах
		Если НЕ Ссылка.бит_ПереданВПроизводство = Дата('00010101') Тогда
			ОбщегоНазначения.СообщитьПользователю("Нельзя очищать реквизит ""Перадан в производство"" в заказ в статусах ""К производству"" или ""Закрыт"" (ЛТ29)");   
			Отказ = ИСТИНА;                                                                     	
			Возврат; 	
		КонецЕсли;
		
	КонецЕсли;		
	
	// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецПроцедуры

&НаСервере
Функция бит_ЗаказСодержитНоменклатуруНеВключатьВСуточныйПакет() Экспорт
	
// }}ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +      
	
	ПродукцияЗаказа = Новый ТаблицаЗначений;
	ПродукцияЗаказа = ЭтотОбъект.Продукция.Выгрузить(,"Номенклатура");
	
	//Находим всех родителей номенклатуры, т.к. нет типовой функции 
	
	ЗапросРодителиНоменклатуры = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номенклатура.Родитель КАК Родитель
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&Номенклатура)
		|ИТОГИ ПО
		|	Родитель ТОЛЬКО ИЕРАРХИЯ");
	
	ЗапросРодителиНоменклатуры.УстановитьПараметр("Номенклатура", ПродукцияЗаказа);
	
	РезультатЗапроса = ЗапросРодителиНоменклатуры.Выполнить();
	РодителиНоменклатуры = РезультатЗапроса.Выгрузить();  
	
	//Смотрим есть ли элементы в бит_НеВключатьВСуточныйПакет 
	
	ЗапросНеВключатьВСуточныйПакет = Новый Запрос("ВЫБРАТЬ
	                                              |	бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры КАК ГруппаНоменклатуры
	                                              |ИЗ
	                                              |	Справочник.бит_НеВключатьВСуточныйПакет КАК бит_НеВключатьВСуточныйПакет
	                                              |ГДЕ
	                                              |	бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры В(&ГруппаНоменклатуры)
	                                              |	И НЕ бит_НеВключатьВСуточныйПакет.ПометкаУдаления");

	ЗапросНеВключатьВСуточныйПакет.УстановитьПараметр("ГруппаНоменклатуры", РодителиНоменклатуры);   
	
	РезультатЗапроса = ЗапросНеВключатьВСуточныйПакет.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда 
		Возврат ЛОЖЬ;		
	Иначе 
		Возврат ИСТИНА;		
	КонецЕсли;	
	
// }}ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] - 
	
КонецФункции

&После("ОбработкаПроведения")
Процедура бит_ОбработкаПроведения(Отказ, РежимПроведения) 
	
	// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +
		
	Если ЭтотОбъект.бит_ПереданВПроизводство = Дата('00010101') Тогда	
			
		ОчисткаЗаписей = РегистрыСведений.бит_ПакетыЗаказовВПроизводство.СоздатьНаборЗаписей();
		ОчисткаЗаписей.Отбор.ЗаказНаПроизводство.Установить(ЭтотОбъект.Ссылка);
		ОчисткаЗаписей.Записать();
		
	Иначе
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	бит_ПакетыЗаказовВПроизводствоСрезПоследних.Период КАК Период,
		|	бит_ПакетыЗаказовВПроизводствоСрезПоследних.ЗаказНаПроизводство КАК ЗаказНаПроизводство
		|ИЗ
		|	РегистрСведений.бит_ПакетыЗаказовВПроизводство.СрезПоследних(, ЗаказНаПроизводство = &ЗаказНаПроизводство И Период = &Дата) КАК бит_ПакетыЗаказовВПроизводствоСрезПоследних");
		
		Запрос.УстановитьПараметр("Дата", ЭтотОбъект.бит_ПереданВПроизводство);
		Запрос.УстановитьПараметр("ЗаказНаПроизводство", ЭтотОбъект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить(); 
		
		Если РезультатЗапроса.Пустой() Тогда 	
			Запись = РегистрыСведений.бит_ПакетыЗаказовВПроизводство.СоздатьНаборЗаписей();
			Запись.Отбор.ЗаказНаПроизводство.Установить(ЭтотОбъект.Ссылка);
			
			НоваяЗапись = Запись.Добавить(); 
			НоваяЗапись.Период 				= ЭтотОбъект.бит_ПереданВПроизводство; 
			НоваяЗапись.ЗаказНаПроизводство = ЭтотОбъект.Ссылка; 
			НоваяЗапись.НомерПакета 		= 0;  
			
			Запись.Записать();	
		КонецЕсли;
		
	КонецЕсли;
		
	// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецПроцедуры

