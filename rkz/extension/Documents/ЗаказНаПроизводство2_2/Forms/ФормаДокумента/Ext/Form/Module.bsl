&НаКлиенте
Процедура бит_ПродукцияНазначениеПриИзмененииПосле(Элемент)
		
	// {{ПервыйБИТ ЛистТребований [ЛТ5.30] [ASHolyavko@1cbit.ru] [22.10.2025] +        
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.бит_ТипТары = Неопределено;
		ТекущиеДанные.бит_КоличествоТары = 0;
		ТекущиеДанные.бит_Толеранс = 0;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Назначение) 
			И ЕстьЗаказКлиентаВНазначении(ТекущиеДанные.Назначение) Тогда
			
			Структура = ПолучитьТипТарыИКоличество(ТекущиеДанные.Назначение, ТекущиеДанные.Номенклатура);
			
			ТекущиеДанные.бит_ТипТары = Структура.бит_ТипТары;
			ТекущиеДанные.бит_КоличествоТары = Структура.бит_КоличествоТары;
			ТекущиеДанные.бит_Толеранс = Структура.бит_Толеранс
			
		Иначе
			
			МассивМатериалов = Новый Массив;
			ПолучитьМатериалыСпецификации(ТекущиеДанные.Спецификация, МассивМатериалов, Объект.Дата);
			
			ТекущиеДанные.бит_ТипТары = УстановитьТипТарыПоСпецификации(МассивМатериалов);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ5.30] [ASHolyavko@1cbit.ru] [22.10.2025] -
	
КонецПроцедуры

&НаСервере
Функция УстановитьТипТарыПоСпецификации(МассивМатериалов)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ВидНоменклатуры В (&ВидНоменклатурыТара)
		|	И Номенклатура.Ссылка В(&МассивНоменклатуры)";
	
	Запрос.УстановитьПараметр("ВидНоменклатурыТара", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.Тара, ЭтотОбъект));
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивМатериалов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
		
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьОсновнуюСпецификацию(Номенклатура, НачалоПроизводства)
	
	ПараметрыВыбораСпецификаций = УправлениеДаннымиОбИзделияхКлиентСервер.ПараметрыВыбораСпецификаций();
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоНоменклатуре", Истина);
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоСпискуНоменклатуры", Ложь);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеПараметрыНазначения", Новый Массив);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеУточненияПрименения", Новый Массив);
	
	ДанныеОбИзделии = УправлениеДаннымиОбИзделияхКлиентСервер.СтруктураДанныхОбИзделииДляВыбораСпецификации();
	ДанныеОбИзделии.Номенклатура = Номенклатура;	
	ДанныеОбИзделии.НачалоПроизводства = НачалоПроизводства;
	
	Результат = УправлениеДаннымиОбИзделиях.СпецификацииИзделия(ДанныеОбИзделии, ПараметрыВыбораСпецификаций);
	
	ИсключитьСпецификацию = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Спецификации             = Новый Массив;
	ПриоритетнаяСпецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Для Индекс = 0 По Результат.ВГраница() Цикл
		ТекущаяСпецификация = Результат[Индекс].Спецификация;
		Если ПриоритетнаяСпецификация.Пустая()
				И Результат[Индекс].ПодбираетсяАвтоматически = Истина Тогда
			ПриоритетнаяСпецификация = ТекущаяСпецификация;
		КонецЕсли;
		Если ТекущаяСпецификация <> ИсключитьСпецификацию Тогда
			Спецификации.Добавить(ТекущаяСпецификация);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ПриоритетнаяСпецификация;
	
КонецФункции

&НаСервере
Функция ПолучитьМатериалыСпецификации(Спецификация, МассивСтруктурМатериалов, НачалоПроизводства)
	
	Попытка
		
		Для Каждого СтрокаМатериалы Из Спецификация.МатериалыИУслуги Цикл
			
			Если СтрокаМатериалы.ПроизводитсяВПроцессе 
				И СтрокаМатериалы.СпособПолученияМатериала = Перечисления.СпособыПолученияМатериаловВСпецификации.ПроизвестиПоСпецификации Тогда
							
				СпецификацияНоменклатуры = ПолучитьОсновнуюСпецификацию(СтрокаМатериалы.Номенклатура, НачалоПроизводства);
				ПолучитьМатериалыСпецификации(СпецификацияНоменклатуры, МассивСтруктурМатериалов, НачалоПроизводства);
							
			Иначе
				
							
				//СтруктураМатериалов = Новый Структура;
				//СтруктураМатериалов.Вставить("Номенклатура", СтрокаМатериалы.Номенклатура);
				
								
				МассивСтруктурМатериалов.Добавить(СтрокаМатериалы.Номенклатура);                    
				
			КонецЕсли;
			
		КонецЦикла;	
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ЕстьЗаказКлиентаВНазначении(Назначение) 
	Возврат ЗначениеЗаполнено(Назначение.Заказ);
КонецФункции

&НаСервере
Функция ПолучитьТипТарыИКоличество(Назначение, Номенклатура) 

	Результат = Новый Структура;
	Результат.Вставить("бит_ТипТары", Неопределено);
	Результат.Вставить("бит_КоличествоТары", 0);
	Результат.Вставить("бит_Толеранс", 0);
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("Номенклатура", Номенклатура);
	
	НайденныеСтрок = Назначение.Заказ.Товары.НайтиСтроки(ОтборСтрок);

	Если НайденныеСтрок.Количество() <> 0 Тогда
		Результат.бит_ТипТары = НайденныеСтрок[0].бит_ТипТары;
		Результат.бит_КоличествоТары = НайденныеСтрок[0].бит_КоличествоТары;
		Результат.бит_Толеранс = НайденныеСтрок[0].бит_Толеранс;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

