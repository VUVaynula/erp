
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	МАКСИМУМ(бит_ПакетыЗаказовВПроизводствоСрезПоследних.НомерПакета) КАК НомерПакета
		|ПОМЕСТИТЬ ВременнаяТаблица
		|ИЗ
		|	РегистрСведений.бит_ПакетыЗаказовВПроизводство.СрезПоследних(, Период = &ТекущаяДата) КАК бит_ПакетыЗаказовВПроизводствоСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблица.НомерПакета КАК НомерПакета
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица
		|ГДЕ
		|	НЕ ЕСТЬNULL(ВременнаяТаблица.НомерПакета, 0) = 0");

	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));

	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда 
		ЭтотОбъект.бит_НомерНовогоПакета = 1; 
	Иначе 
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();  
		
		ЭтотОбъект.бит_НомерНовогоПакета = Выборка.НомерПакета + 1;
	КонецЕсли;
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецПроцедуры	
	
&НаСервере
Функция СформироватьПакетЗаказовНаСервере() 
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] + 
	ДокументыДляПечати = Новый Массив; 
	ДатаЗаписи = НачалоДня(ТекущаяДата()); 
	
	//Перепроверяю актуальность номера пакета
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	МАКСИМУМ(бит_ПакетыЗаказовВПроизводствоСрезПоследних.НомерПакета) КАК НомерПакета
		|ПОМЕСТИТЬ ВременнаяТаблица
		|ИЗ
		|	РегистрСведений.бит_ПакетыЗаказовВПроизводство.СрезПоследних(, Период = &ТекущаяДата) КАК бит_ПакетыЗаказовВПроизводствоСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблица.НомерПакета КАК НомерПакета
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица
		|ГДЕ
		|	НЕ ЕСТЬNULL(ВременнаяТаблица.НомерПакета, 0) = 0");

	Запрос.УстановитьПараметр("ТекущаяДата", ДатаЗаписи);

	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда 
		НомерНовогоПакета = 1; 
	Иначе 
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		НомерНовогоПакета = Выборка.НомерПакета + 1;
	КонецЕсли;
	
	//Ищу нужные заказы
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИСТИНА КАК НеВключатьВСуточныйПакет,
		|	Номенклатура.Ссылка КАК Номенклатура
		|ПОМЕСТИТЬ вт_НоменклатураНеВСуточномПакете
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_НеВключатьВСуточныйПакет КАК бит_НеВключатьВСуточныйПакет
		|		ПО (Номенклатура.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры
		|				ИЛИ Номенклатура.Родитель.Родитель.Родитель.Родитель = бит_НеВключатьВСуточныйПакет.бит_ГруппаНоменклатуры)
		|ГДЕ
		|	НЕ бит_НеВключатьВСуточныйПакет.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказНаПроизводство.Ссылка КАК ЗаказНаПроизводство
		|ИЗ
		|	Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт_НоменклатураНеВСуточномПакете КАК вт_НоменклатураНеВСуточномПакете
		|			ПО (вт_НоменклатураНеВСуточномПакете.Номенклатура = ЗаказНаПроизводство2_2Продукция.Номенклатура)
		|		ПО (ЗаказНаПроизводство2_2Продукция.Ссылка = ЗаказНаПроизводство.Ссылка)
		|ГДЕ
		|	ЗаказНаПроизводство.Проведен
		|	И ЗаказНаПроизводство.бит_ПереданВПроизводство = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И ЗаказНаПроизводство.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.Формируется)
		|	И ЕСТЬNULL(вт_НоменклатураНеВСуточномПакете.НеВключатьВСуточныйПакет, 0) = 0");


	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
		
	Пока Выборка.Следующий() Цикл 
		
		ДокументыДляПечати.Добавить(Выборка.ЗаказНаПроизводство);
		
		ОбъектЗаказНаПроизводство = Выборка.ЗаказНаПроизводство.ПолучитьОбъект(); 
		ОбъектЗаказНаПроизводство.бит_ПереданВПроизводство = ДатаЗаписи;
		ОбъектЗаказНаПроизводство.Записать();
		
		//Добавляю записи и затираю предыдущие данные по заказам
		Запись = РегистрыСведений.бит_ПакетыЗаказовВПроизводство.СоздатьНаборЗаписей();
		Запись.Отбор.ЗаказНаПроизводство.Установить(Выборка.ЗаказНаПроизводство);
		
		НоваяЗапись = Запись.Добавить(); 
		НоваяЗапись.Период 				= ДатаЗаписи; 
		НоваяЗапись.ЗаказНаПроизводство = Выборка.ЗаказНаПроизводство; 
		НоваяЗапись.НомерПакета 		= НомерНовогоПакета;  
		
		Запись.Записать();
		
	КонецЦикла; 
	
	Если НЕ ДокументыДляПечати.Количество() = 0 Тогда
		ЭтотОбъект.бит_НомерНовогоПакета = НомерНовогоПакета + 1;
	КонецЕсли;
	
	Возврат ДокументыДляПечати; 	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакетЗаказов(Команда) 
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] +  	
	ДокументыДляПечати = СформироватьПакетЗаказовНаСервере(); 
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.ЗаказНаПроизводство2_2", "бит_СуточныйЗапуск", ДокументыДляПечати, ЭтаФорма,);	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -  

КонецПроцедуры

&НаСервере
Функция РаспечататьПакетЗаказовНаСервере()
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] + 	
	ДокументыДляПечати = Новый Массив;
	Дата = НачалоДня(ЭтотОбъект.бит_ДатаЗарегестрированногоПакета); 
	Номер = ЭтотОбъект.бит_НомераЗарегистрированныхПакетов;
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	бит_ПакетыЗаказовВПроизводствоСрезПоследних.ЗаказНаПроизводство КАК ЗаказНаПроизводство
		|ИЗ
		|	РегистрСведений.бит_ПакетыЗаказовВПроизводство.СрезПоследних(, Период = &ТекущаяДата И НомерПакета = &НомерПакета) КАК бит_ПакетыЗаказовВПроизводствоСрезПоследних");

	Запрос.УстановитьПараметр("НомерПакета", Номер);
	Запрос.УстановитьПараметр("ТекущаяДата", Дата);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл   	
		ДокументыДляПечати.Добавить(Выборка.ЗаказНаПроизводство);	
	КонецЦикла;

	Возврат ДокументыДляПечати;
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] -
	
КонецФункции

&НаКлиенте
Процедура РаспечататьПакетЗаказов(Команда)
	
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] + 	  
	ДокументыДляПечати = РаспечататьПакетЗаказовНаСервере(); 
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.ЗаказНаПроизводство2_2", "бит_СуточныйЗапуск", ДокументыДляПечати, ЭтаФорма,);
// ПервыйБИТ ЛистТребований [ЛТ29] [KAKravchenko@1cbit.ru] [20.09.2024] - 

КонецПроцедуры

