Функция ПолучитьГОСТ(Номенклатура)
	
	ГОСТ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак КАК бит_Признак,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации КАК бит_ПризнакСертификации,
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК бит_Значение
		|ИЗ
		|	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
		|ГДЕ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &бит_Номенклатура
		|	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак.Код = ""GOST""";
	
	Запрос.УстановитьПараметр("бит_Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ГОСТ = ГОСТ + ?(ЗначениеЗаполнено(ГОСТ), ", ", "") + ВыборкаДетальныеЗаписи.бит_Значение.Наименование;
	КонецЦикла;
	
	Возврат ГОСТ;
	
КонецФункции

Функция ПолучитьПунктыСтандарта(Номенклатура, ПоказателиПроверки)
	
    Пункты = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПунктыНДКПоказателямПроверок.бит_Номенклатура КАК бит_Номенклатура,
		|	бит_ПунктыНДКПоказателямПроверок.бит_НормативныйДокумент КАК бит_НормативныйДокумент,
		|	бит_ПунктыНДКПоказателямПроверок.бит_ПунктНормативногоДокумента КАК бит_ПунктНормативногоДокумента
		|ИЗ
		|	РегистрСведений.бит_ПунктыНДКПоказателямПроверок КАК бит_ПунктыНДКПоказателямПроверок
		|ГДЕ
		|	бит_ПунктыНДКПоказателямПроверок.бит_Номенклатура = &бит_Номенклатура
		|	И бит_ПунктыНДКПоказателямПроверок.бит_ПоказательПроверкиНоменклатуры = &бит_ПоказательПроверкиНоменклатуры
		|ИТОГИ ПО
		|	бит_Номенклатура,
		|	бит_НормативныйДокумент";
	
	Запрос.УстановитьПараметр("бит_Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("бит_ПоказательПроверкиНоменклатуры", ПоказателиПроверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборкабит_Номенклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборкабит_Номенклатура.Следующий() Цикл
		// Вставить обработку выборки Выборкабит_Номенклатура
	
		Выборкабит_НормативныйДокумент = Выборкабит_Номенклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока Выборкабит_НормативныйДокумент.Следующий() Цикл
			
			
			Пункты = Пункты + Выборкабит_НормативныйДокумент.бит_НормативныйДокумент + " ";
			
			ВыборкаДетальныеЗаписи = Выборкабит_НормативныйДокумент.Выбрать();
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Пункты = Пункты + 
					?(Выборкабит_НормативныйДокумент.бит_НормативныйДокумент = ВыборкаДетальныеЗаписи.бит_ПунктНормативногоДокумента
						, ""
						, ВыборкаДетальныеЗаписи.бит_ПунктНормативногоДокумента)+ " ";
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Пункты;
	
КонецФункции

Функция бит_СформироватьПечатнуюФормуДокументОКачестве(МассивОбъектов)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ9.5] [ASHolyavko@1cbit.ru] [30.05.2025] +        
	
	УстановитьПривилегированныйРежим(Истина);  
	ПараметрыПечати = ИСТИНА;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;	
	ТабличныйДокумент.КлючПараметровПечати = "бит_ДокументОКачестве";
	
	Макет = ПолучитьМакет("бит_ПФ_MXL_ДокументОКачестве");
	
	Для Каждого ЭлементМассива Из МассивОбъектов Цикл
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДвижениеПродукцииИМатериаловТовары.Ссылка.Дата КАК Дата,
		|	ДвижениеПродукцииИМатериаловТовары.Номенклатура КАК Номенклатура,
		|	ДвижениеПродукцииИМатериаловТовары.Серия КАК Серия,
		|	ДвижениеПродукцииИМатериаловТовары.Номенклатура КАК Марка,
		|	ДвижениеПродукцииИМатериаловТовары.КоличествоУпаковок КАК Длина,
		|	ДвижениеПродукцииИМатериаловТовары.Серия.Номер КАК НомерБарабана,
		|	ДвижениеПродукцииИМатериаловТовары.Серия.бит_ТипБарабана КАК Тип,
		|	Адрес.Представление КАК Адрес,
		|	Телефон.Представление КАК Телефон,
		|	Email.Представление КАК Email,
		|	Факс.Представление КАК Факс
		|ИЗ
		|	Документ.ДвижениеПродукцииИМатериалов.Товары КАК ДвижениеПродукцииИМатериаловТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК Адрес
		|		ПО ДвижениеПродукцииИМатериаловТовары.Ссылка.Организация = Адрес.Ссылка
		|			И (Адрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
		|			И (Адрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК Телефон
		|		ПО ДвижениеПродукцииИМатериаловТовары.Ссылка.Организация = Телефон.Ссылка
		|			И (Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		|			И (Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК Email
		|		ПО ДвижениеПродукцииИМатериаловТовары.Ссылка.Организация = Email.Ссылка
		|			И (Email.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
		|			И (Email.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailОрганизации))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК Факс
		|		ПО ДвижениеПродукцииИМатериаловТовары.Ссылка.Организация = Факс.Ссылка
		|			И (Факс.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Факс))
		|			И (Факс.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФаксОрганизации))
		|ГДЕ
		|	ДвижениеПродукцииИМатериаловТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
