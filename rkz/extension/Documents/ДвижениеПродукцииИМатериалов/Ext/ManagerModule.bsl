	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	ТабличныйДокумент.КлючПараметровПечати = "бит_НакладнаяНаСдачуГотовойПродукцииБарабаны";
	
	Макет = ПолучитьМакет("бит_ПФ_MXL_НакладнаяНаСдачуГотовойПродукцииБарабаны");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаОрганизацияАдрес = Макет.ПолучитьОбласть("СтрокаОрганизацияАдрес");  
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");  
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Первый = Истина;
	Для Каждого ЭлементМассива Из МассивОбъектов Цикл
		Если Первый Тогда
			Первый = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Сведения = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ЭлементМассива.Организация, ЭлементМассива.Дата);
		
		СП = Новый Структура;
	    СП.Вставить("СокращенноеНаименованиеОрганизации", Сведения.СокращенноеНаименование);
		СП.Вставить("НомерДокумента", ЭлементМассива.Номер);
		СП.Вставить("Отправитель", ЭлементМассива.Отправитель);
		СП.Вставить("ДатаПередачи", Формат(ЭлементМассива.Дата, "ДФ=dd.MM.yyyy"));
		СП.Вставить("ФактическийАдресОрганизации", Сведения.ФактическийАдрес);
		
		ОбластьШапка.Параметры.Заполнить(СП);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ОбластьСтрокаОрганизацияАдрес.Параметры.Заполнить(СП);
		ТабличныйДокумент.Вывести(ОбластьСтрокаОрганизацияАдрес);
		
		КоллекцияДанных = ПолучитьДанныеТЧ(ЭлементМассива);              
		
		СП = Новый Структура;
		СП.Вставить("СуммаКолВо"	, КоллекцияДанных.Итог("КолВоПрод"));
		
		Для каждого стр из КоллекцияДанных Цикл
			ОбластьСтрока.Параметры.Заполнить(стр); 
			сч = 1;                 
			КолВоПрод = Строка(стр.КолВоПрод);
			Если ЗначениеЗаполнено(стр.Серия) Тогда
				Для каждого намотка из стр.Серия.бит_ПереченьДлинНаБарабане Цикл
					КолВоПрод = КолВоПрод + Символы.ПС + Символы.ПС + "N" + сч + "(" + намотка.Длина + ")"; 
					сч = сч + 1;
				КонецЦикла;             
			КонецЕсли;
			ОбластьСтрока.Параметры.КолВоПрод = КолВоПрод;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		СП.Вставить("КоличествоМеди", КоллекцияДанных.Итог("КоличествоМеди"));
		СП.Вставить("КолВоАлюминия"	, КоллекцияДанных.Итог("КолВоАлюминия"));
		
		ОбластьПодвал.Параметры.Заполнить(СП);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
						
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
