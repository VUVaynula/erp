&НаСервере
Процедура бит_ТипАдресаПриИзмененииНаСервере()
	// {{ПервыйБИТ ЛистТребований [5.14]  [VUVaynula@1cbit.ru] [17.06.2025 18:35:36] +        
	Если Объект.Товары.Количество() = 0 Тогда   
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В табличной части не введено ни одной строки");  
		ПустойБитАдрес();
		Возврат;
	КонецЕсли;
	
	ЗаказНазначения = Неопределено;
	Для каждого стр из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.Назначение) 
			И ЗначениеЗаполнено(стр.Назначение.Заказ) 
			И ТипЗнч(стр.Назначение.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			ЗаказНазначения = стр.Назначение.Заказ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗаказНазначения = Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В назначениях табличной части найден заказ клиента");  
		ПустойБитАдрес();
		Возврат;
	КонецЕсли;
	Контрагент = ЗаказНазначения.Контрагент;
	Грузополучатель = Контрагент.НаименованиеПолное;
	Адрес = "";
	Если ЭтаФорма.бит_ТипАдреса = 0 Тогда
		ТипАдреса = Неопределено;
	ИначеЕсли ЭтаФорма.бит_ТипАдреса = 1 Тогда 
		ТипАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
	Иначе                                                 
		ТипАдреса = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
	КонецЕсли;    
	
	Если ТипАдреса <> Неопределено Тогда
		ДатаДок = ?(Объект.Дата = Дата("00010101"), ТекущаяДатаСеанса(), ОБъект.Дата);
		Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, ТипАдреса, ДатаДок, Истина);
	КонецЕсли;
	Объект.бит_Адрес = Грузополучатель + " " + Адрес;  
	Объект.бит_ТипАдреса = ЭтаФорма.бит_ТипАдреса;
	// }}ПервыйБИТ ЛистТребований [5.14]  [VUVaynula@1cbit.ru] [17.06.2025 18:35:36] -
КонецПроцедуры 

