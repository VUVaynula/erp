#Область ОбработчикиСобытийФормы
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] +  
	НовыйЭлемент = Элементы.Добавить("бит_ГруппаКомПанель", Тип("ГруппаФормы"));
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа; 
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь; 
	НовыйЭлемент.Объединенная = Истина ;
	НовыйЭлемент.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	//Создаем Команду бит_Согласовать
	НоваяКоманда = ЭтаФорма.Команды.Добавить("бит_Согласовать");
	НоваяКоманда.Действие = "бит_СогласоватьНаКлиенте";//Имя процедуры
	НоваяКоманда.Заголовок = "Согласовать";
	
	//Создаем Кнопку бит_Согласовать
	НоваяКнопка = Элементы.Добавить("бит_Согласовать", Тип("КнопкаФормы"), Элементы.бит_ГруппаКомПанель);
	НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НоваяКнопка.ИмяКоманды = "бит_Согласовать";	
	НоваяКнопка.КнопкаПоУмолчанию = Истина;
	
	//Создаем Команду бит_Отменить
	НоваяКоманда = ЭтаФорма.Команды.Добавить("бит_Отменить");
	НоваяКоманда.Действие = "бит_ОтменитьНаКлиенте";//Имя процедуры
	НоваяКоманда.Заголовок = "Отменить";
	
	//Создаем Кнопку бит_Отменить
	НоваяКнопка = Элементы.Добавить("бит_Отменить", Тип("КнопкаФормы"),Элементы.бит_ГруппаКомПанель);
	НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НоваяКнопка.ИмяКоманды = "бит_Отменить";	
	
	НовыйЭлемент = Элементы.Добавить("бит_ГруппаДанные", Тип("ГруппаФормы"));
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа; 
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь; 
	НовыйЭлемент.Объединенная = Истина ;
	НовыйЭлемент.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	НовыйЭлемент = Элементы.Добавить("бит_ВсегоКОплате", Тип("ПолеФормы"), Элементы.бит_ГруппаДанные);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ВсегоКОплате";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Добавить("бит_Оплатить", Тип("ПолеФормы"), Элементы.бит_ГруппаДанные);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Оплатить"; 
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_ОплатитьПриИзмененииНаКлиенте");
	
	НовыйЭлемент = Элементы.Добавить("бит_ГруппаОтложить", Тип("ГруппаФормы"), Элементы.бит_ГруппаДанные);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа; 
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь; 
	НовыйЭлемент.Объединенная = Истина ;
	НовыйЭлемент.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	НовыйЭлемент = Элементы.Добавить("бит_Отложить", Тип("ПолеФормы"), Элементы.бит_ГруппаОтложить);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Отложить";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_ОтложитьПриИзмененииНаКлиенте");
	
	НовыйЭлемент = Элементы.Добавить("бит_ОтложитьНаДату", Тип("ПолеФормы"), Элементы.бит_ГруппаОтложить);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОтложитьНаДату";
	НовыйЭлемент.Заголовок = "на";
	
	Если Параметры.Свойство("ВсегоКОплате") Тогда
		ВсегоКОплате = Параметры.ВсегоКОплате;
	КонецЕсли;  
	
	Если Параметры.Свойство("ОтложитьНаДату") Тогда
		
		ОтложитьНаДату = Параметры.ОтложитьНаДату;
		
		Если  ОтложитьНаДату < ТекущаяДатаСеанса() Тогда
			ОтложитьНаДату = КонецДня(ТекущаяДатаСеанса()) + 1; 
		КонецЕсли;
		
	КонецЕсли;
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] - 
	
КонецПроцедуры  

&НаКлиенте
Процедура бит_ОплатитьПриИзмененииНаКлиенте(Элемент) 
	
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] +  
	Отложить = ВсегоКОплате - Оплатить;	
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] -  
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ОтложитьПриИзмененииНаКлиенте(Элемент)
	
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] + 
	Оплатить = ВсегоКОплате - Отложить;		
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] -	 
	
КонецПроцедуры

&НаКлиенте
Процедура бит_СогласоватьНаКлиенте(Элемент)
	
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] + 
	ПараметрыСогласования = Новый Структура;
	ПараметрыСогласования.Вставить("СуммаОплаты", Оплатить);
	ПараметрыСогласования.Вставить("СуммаОтложить", Отложить);
	ПараметрыСогласования.Вставить("ОтложитьНаДату", ОтложитьНаДату);
	
	Закрыть(ПараметрыСогласования);
	// ПервыйБИТ ЛистТребований [21]  [Пасенов В.В.] [24.06.2024] -	 
	
КонецПроцедуры

