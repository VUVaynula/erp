&НаСервере
Процедура бит_УстановитьОтборЗаданияНаПеревозкуПоОплате()
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] +	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.бит_Оплата) Тогда 
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаданияНаПеревозкуВРаботе,
		"бит_Оплата",,,,Ложь);   
		
	ИначеЕсли ЭтотОбъект.бит_Оплата = "Оплачен" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаданияНаПеревозкуВРаботе,
		"бит_Оплата", "Оплачен" , ВидСравненияКомпоновкиДанных.Равно,,Истина); 
		
	ИначеЕсли ЭтотОбъект.бит_Оплата = "Частично оплачен" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаданияНаПеревозкуВРаботе,
		"бит_Оплата", "Частично оплачен" , ВидСравненияКомпоновкиДанных.Равно,,Истина);  
		
	ИначеЕсли ЭтотОбъект.бит_Оплата = "Не оплачен" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаданияНаПеревозкуВРаботе,
		"бит_Оплата", "Не оплачен" , ВидСравненияКомпоновкиДанных.Равно,,Истина);
		
	КонецЕсли;
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] -
	
КонецПроцедуры

