#Область ОбработчикиСобытийФормы
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] +  	
	ДобавляемыеРеквизиты = Новый Массив();
	
	// Описываем новые ревизиты формы
	бит_ОплатаРеквизит = Новый РеквизитФормы(
	"бит_Оплата",
	Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(16)),
	,
	"(бит) Оплата"
	);  
	
	бит_ПриобретениеУслугПеревозкиРеквизит = Новый РеквизитФормы(
	"бит_ПриобретениеУслугПеревозки",
	Новый ОписаниеТипов("ДокументСсылка.ПриобретениеУслугПрочихАктивов"),
	,
	"(бит) Приобретение услуг перевозки"
	);
	
	// Заполняем массив новых реквизитов
	ДобавляемыеРеквизиты.Добавить(бит_ОплатаРеквизит);
	ДобавляемыеРеквизиты.Добавить(бит_ПриобретениеУслугПеревозкиРеквизит);
	
	// Добавляем новые реквизиты в форму
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);	
	
	НовыйЭлемент = Элементы.Вставить("бит_Оплата", Тип("ПолеФормы"), Элементы.ЗаданияНаПеревозкуВРаботеОтбор, Элементы.КоманднаяПанельЗаданияНаПеревозкуВРаботе);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_Оплата";
	НовыйЭлемент.Заголовок = "(бит) Оплата"; 
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.КнопкаВыпадающегоСписка = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_ОплатаПриИзмененииКлиент");
	НовыйЭлемент.УстановитьДействие("Очистка", "бит_ОплатаОчисткаКлиент"); 
	
	НовыйЭлемент = Элементы.Вставить("бит_ПриобретениеУслугПеревозки", Тип("ПолеФормы"), Элементы.ЗаданияНаПеревозкуВРаботеОтбор, Элементы.КоманднаяПанельЗаданияНаПеревозкуВРаботе);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_ПриобретениеУслугПеревозки";
	НовыйЭлемент.Заголовок = "(бит) Приобретение услуг перевозки"; 
	НовыйЭлемент.КнопкаОчистки = Истина; 
	НовыйЭлемент.КнопкаСоздания = Ложь;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "бит_ПриобретениеУслугПеревозкиПриИзмененииКлиент");
	НовыйЭлемент.УстановитьДействие("Очистка", "бит_ПриобретениеУслугПеревозкиОчисткаКлиент");
	
	бит_ЗаполнитьСпискиВыбораОплат();
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] -
	
КонецПроцедуры  

&НаСервере
Процедура бит_ЗаполнитьСпискиВыбораОплат()
	
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] +	
	СписокВыбора = Элементы.бит_Оплата.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить("Оплачен", "Оплачен");
	СписокВыбора.Добавить("Частично оплачен", "Частично оплачен");
	СписокВыбора.Добавить("Не оплачен", "Не оплачен");
	// ПервыйБИТ ЛистТребований [23]  [Пасенов В.В.] [26.06.2024] - 
	
КонецПроцедуры

