&НаКлиенте
&ИзменениеИКонтроль("Назначить")
Процедура бит_Назначить(Команда)

	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
	"Обработка.ФормированиеСменныхЗаданий.Форма.РабочееМесто.НазначитьОперации");

	Если Элементы.Смены.ТекущиеДанные = Неопределено Тогда

		ПоказатьПредупреждениеНеВыбранаСмена();

	Иначе

		КлючиОпераций = ПроверитьПолучитьОперацииДляНазначения(Элементы.Операции.ВыделенныеСтроки);

		Если КлючиОпераций <> Неопределено Тогда
			
			#Вставка
			бит_УстановитьКоличествоХодовНаСервере(КлючиОпераций);
			#КонецВставки
			
			НазначитьОперацииВыбраннойСтроке(КлючиОпераций, Элементы.Смены.ТекущиеДанные);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура бит_УстановитьКоличествоХодовНаСервере(КлючиОпераций)
	
	Порядок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОперацииТЗ = РегистрыСведений.ОперацииКСозданиюСменныхЗаданий.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Для каждого Ключ Из КлючиОпераций Цикл
		НоваяСтрока = ОперацииТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Ключ);
		НоваяСтрока.Порядок = Порядок;
		
		Порядок = Порядок + 1;
	КонецЦикла;
	
	//КоличествоХодовОперация = бит_ПолучитьКоличествоХодовОперации(ОперацииТЗ);
	
	Документы.СменноеЗадание.УстановитьКоличествоХодовИВремя(ОперацииТЗ);	
	
КонецПроцедуры
