&НаКлиенте
Процедура бит_СменаПриАктивизацииСтроки()
	
	ТекущиеДанные  = Элементы.бит_Смена.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
				
		//СтруктураОтбора = Новый Структура;
		
		//ТЗСостав = Элементы.бит_Состав;
		//Элементы.бит_Состав.ОтборСтрок = Новый ФиксированнаяСтруктура("СменноеЗадание, ОперацияВыпуска, Бригада", ТекущиеДанные.СменноеЗадание, ТекущиеДанные.ОперацияВыпуска, ТекущиеДанные.Бригада);
		ЭтаФорма["бит_СоставСписок"].Параметры.УстановитьЗначениеПараметра("Смена", ТекущиеДанные.СменноеЗадание);
		ЭтаФорма["бит_СоставСписок"].Параметры.УстановитьЗначениеПараметра("Бригада", ТекущиеДанные.Бригада);

	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура бит_СоставСотрудникПриИзменении(Элемент)
	
	ТекущиеДанныеСмена  = Элементы.бит_Смена.ТекущиеДанные;
	
	Если ТекущиеДанныеСмена <> Неопределено Тогда
		
		ТекущиеДанныеСостав  = Элементы.бит_Состав.ТекущиеДанные;
		
		СменноеЗадание = ТекущиеДанныеСмена.СменноеЗадание;
		ОперацияВыпуска = ТекущиеДанныеСмена.ОперацияВыпуска;
		Бригада = ТекущиеДанныеСмена.Бригада; 
		Сотрудник = ТекущиеДанныеСостав.Сотрудник;            
		
		ТекущиеДанныеСостав.СменноеЗадание = СменноеЗадание;
		ТекущиеДанныеСостав.ОперацияВыпуска = ОперацияВыпуска;
		ТекущиеДанныеСостав.Бригада = Бригада;
		
		Если СотрудникаНетВСоставе(СменноеЗадание, Бригада, Сотрудник) Тогда
		
			ЗаписатьСоставИсполнителей(СменноеЗадание, Бригада);
			
		Иначе
			
			ЭтаФорма.бит_Состав.Удалить(ЭтаФорма.бит_Состав.НайтиПоИдентификатору(Элементы.бит_Состав.ТекущаяСтрока));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_СоставПослеУдаления(Элемент)
	
	ТекущиеДанныеСмена  = Элементы.бит_Смена.ТекущиеДанные;
	
	Если ТекущиеДанныеСмена <> Неопределено Тогда
		
		СменноеЗадание = ТекущиеДанныеСмена.СменноеЗадание;
		ОперацияВыпуска = ТекущиеДанныеСмена.ОперацияВыпуска;
		Бригада = ТекущиеДанныеСмена.Бригада; 
		//Сотрудник = ТекущиеДанныеСостав.Сотрудник;
		
		ЗаписатьСоставИсполнителей(СменноеЗадание, Бригада);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СотрудникаНетВСоставе(Смена, Бригада, Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СоставИсполнителейИВремяВыполнения.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.бит_СоставИсполнителейИВремяВыполнения КАК бит_СоставИсполнителейИВремяВыполнения
		|ГДЕ
		|	бит_СоставИсполнителейИВремяВыполнения.Смена = &Смена
		|	И бит_СоставИсполнителейИВремяВыполнения.Бригада = &Бригада
		|	И бит_СоставИсполнителейИВремяВыполнения.Сотрудник = &Сотрудник
		|	И бит_СоставИсполнителейИВремяВыполнения.Регистратор = &Смена";
	
	Запрос.УстановитьПараметр("Бригада", Бригада);
	Запрос.УстановитьПараметр("Смена", Смена);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции

