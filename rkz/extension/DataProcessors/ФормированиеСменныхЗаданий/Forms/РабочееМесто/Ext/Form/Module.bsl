&НаСервере
Процедура ВывестиСообщенияФормирования(Результат, ТекущийЭтап)
				
	СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат);
	
	Ошибки = СтруктураРезультата.Ошибки;
	
	Для Каждого СтрокаОшибок Из Ошибки Цикл
		Если ЗначениеЗаполнено(СтрокаОшибок.Сообщения) Тогда
			
			Сообщить("Ошибка формирование этапа!");
			
			//СообщениеПользователю = Новый СообщениеПользователю;
			//СообщениеПользователю.Текст = "Создан новый документ: " + Строка(СтрокаРезультата.Документ);
			//СообщениеПользователю.УстановитьДанные(СтрокаРезультата.Документ);
			//СообщениеПользователю.Сообщить();
			
		КонецЕсли;
	КонецЦикла;
	
	РезультатФормирования = СтруктураРезультата.РезультатФормирования;
	
	СозданНовыйЭтап = Ложь;
	
	Для Каждого СтрокаРезультата Из РезультатФормирования Цикл
		Если ЗначениеЗаполнено(СтрокаРезультата.Документ) Тогда
			
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = "Создан новый документ: " + Строка(СтрокаРезультата.Документ);
			СообщениеПользователю.КлючДанных = СтрокаРезультата.Документ;
			СообщениеПользователю.УстановитьДанные(СтрокаРезультата.Документ);
			СообщениеПользователю.Сообщить();
			
			СозданНовыйЭтап = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если СозданНовыйЭтап Тогда
		
		ПричинаОтмены = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПричинаЗаменыОборудования, ЭтотОбъект, Истина);
		
		СтарыйЭтапОбъект = ТекущийЭтап.ПолучитьОбъект();
		СтарыйЭтапОбъект.КоличествоУпаковокОтменено = СтарыйЭтапОбъект.КоличествоУпаковокПлан - СтарыйЭтапОбъект.КоличествоУпаковокФакт;
		//СтарыйЭтапОбъект.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
		СтарыйЭтапОбъект.ОтразитьКоличествоОтмененоВТЧ(ПричинаОтмены);
		СтарыйЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//СтарыйЭтапОбъект.ПометкаУдаления = Истина;
		//СтарыйЭтапОбъект.Записать(); 
		
		//СообщениеПользователю = Новый СообщениеПользователю;
		//СообщениеПользователю.Текст = "Этап: " + Строка(ТекущийЭтап) + " помечен на удаление!";
		//СообщениеПользователю.КлючДанных = ТекущийЭтап;
		//СообщениеПользователю.УстановитьДанные(ТекущийЭтап);
		//СообщениеПользователю.Сообщить();
		
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацииКСозданиюСменныхЗаданий.Подразделение КАК Подразделение,
		|	ОперацииКСозданиюСменныхЗаданий.СменноеЗадание КАК СменноеЗадание,
		|	ОперацииКСозданиюСменныхЗаданий.Этап КАК Этап,
		|	ОперацииКСозданиюСменныхЗаданий.Операция КАК Операция,
		|	ОперацииКСозданиюСменныхЗаданий.ИдентификаторОперации КАК ИдентификаторОперации,
		|	ОперацииКСозданиюСменныхЗаданий.Исполнитель КАК Исполнитель,
		|	ОперацииКСозданиюСменныхЗаданий.Участок КАК Участок,
		|	ОперацииКСозданиюСменныхЗаданий.РабочийЦентр КАК РабочийЦентр,
		|	ОперацииКСозданиюСменныхЗаданий.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	ОперацииКСозданиюСменныхЗаданий.НазначатьНеРанее КАК НазначатьНеРанее
		|ИЗ
		|	РегистрСведений.ОперацииКСозданиюСменныхЗаданий КАК ОперацииКСозданиюСменныхЗаданий
		|ГДЕ
		|	ОперацииКСозданиюСменныхЗаданий.Этап = &Этап
		|	И ОперацииКСозданиюСменныхЗаданий.СменноеЗадание = ЗНАЧЕНИЕ(Документ.СменноеЗадание.ПустаяСсылка)";
		
		Запрос.УстановитьПараметр("Этап", ТекущийЭтап);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			//	
			НЗ = РегистрыСведений.ОперацииКСозданиюСменныхЗаданий.СоздатьНаборЗаписей();
			
			НЗ.Отбор.Подразделение.Установить(ВыборкаДетальныеЗаписи.Подразделение);
			НЗ.Отбор.СменноеЗадание.Установить(ВыборкаДетальныеЗаписи.СменноеЗадание);
			НЗ.Отбор.Этап.Установить(ВыборкаДетальныеЗаписи.Этап);
			НЗ.Отбор.Операция.Установить(ВыборкаДетальныеЗаписи.Операция);
			НЗ.Отбор.ИдентификаторОперации.Установить(ВыборкаДетальныеЗаписи.ИдентификаторОперации);
			НЗ.Отбор.Исполнитель.Установить(ВыборкаДетальныеЗаписи.Исполнитель);
			НЗ.Отбор.Участок.Установить(ВыборкаДетальныеЗаписи.Участок);
			НЗ.Отбор.РабочийЦентр.Установить(ВыборкаДетальныеЗаписи.РабочийЦентр);
			НЗ.Отбор.ВидРабочегоЦентра.Установить(ВыборкаДетальныеЗаписи.ВидРабочегоЦентра);
			НЗ.Отбор.НазначатьНеРанее.Установить(ВыборкаДетальныеЗаписи.НазначатьНеРанее);
			
			НЗ.Записать();
			
		КонецЦикла;
		
		

		
	КонецЕсли;
	
	Элементы.Операции.Обновить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТЗОперации(КлючиОпераций)
	
	Порядок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОперацииТЗ = РегистрыСведений.ОперацииКСозданиюСменныхЗаданий.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Для каждого Ключ Из КлючиОпераций Цикл
		
		НоваяСтрока = ОперацииТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Ключ);
		НоваяСтрока.Порядок = Порядок;
		
		Порядок = Порядок + 1;
		
	КонецЦикла;
	
	Адрес = ПоместитьВоВременноеХранилище(ОперацииТЗ);
	
	Возврат Адрес;
	
КонецФункции

