	//НовыйЭтап.Дата = ТекущаяДата();
	//НовыйЭтап.НомерЭтапа = НомерЭтапа + 1;
	//НовыйЭтап.НомерСледующегоЭтапа = 0;//НомерЭтапа + 1;
	//НовыйЭтап.НомерПартииЗапуска = НомерПартииЗапуска + 1;//НомерЭтапа + 1;
	//НовыйЭтап.НомерЭтапаВПартииЗапуска = 1;
	//НовыйЭтап.Номер = Неопределено;
	//НовыйЭтап.Распоряжение = Заказ;
	//НовыйЭтап.Спецификация = СпецификацияНовогоЭтапа.Ссылка;
	//НовыйЭтап.КоличествоУпаковокПлан = КоличествоКВыпуску;
	////НовыйЭтап.ПартияПроизводства = Неопределено;
	////НовыйЭтап.Назначение = Неопределено;
	//НовыйЭтап.ВыходныеИзделия.Очистить(); 
