
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресТЗОперации") Тогда
		
		Операции = ПолучитьИзВременногоХранилища(Параметры.АдресТЗОперации);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Операции.Подразделение КАК Подразделение,
		|	Операции.Этап КАК Этап,
		|	Операции.Операция КАК Операция,
		|	Операции.ИдентификаторОперации КАК ИдентификаторОперации,
		|	Операции.СменноеЗадание КАК СменноеЗадание,
		|	Операции.Исполнитель КАК Исполнитель,
		|	Операции.РабочийЦентр КАК РабочийЦентр,
		|	Операции.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	Операции.НазначатьНеРанее КАК НазначатьНеРанее,
		|	Операции.Порядок КАК Порядок
		|ПОМЕСТИТЬ ВТОперацииНазначение
		|ИЗ
		|	&Операции КАК Операции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОперацииНазначение.Подразделение КАК Подразделение,
		|	ОперацииНазначение.Этап КАК Этап,
		|	ОперацииНазначение.Операция КАК Операция,
		|	ОперацииНазначение.ИдентификаторОперации КАК ИдентификаторОперации,
		|	ОперацииНазначение.СменноеЗадание КАК СменноеЗадание,
		|	ОперацииНазначение.Исполнитель КАК Исполнитель,
		|	ОперацииНазначение.РабочийЦентр КАК РабочийЦентр,
		|	ОперацииНазначение.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	ОперацииНазначение.НазначатьНеРанее КАК НазначатьНеРанее,
		|	ЕСТЬNULL(ОперацииКСозданиюСменныхЗаданий.Количество, 1) КАК Количество,
		|	ОперацииКСозданиюСменныхЗаданий.ВремяШтучное КАК ВремяШтучное,
		|	ОперацииКСозданиюСменныхЗаданий.ВремяПЗ КАК ВремяПЗ,
		|	ОперацииКСозданиюСменныхЗаданий.ВремяЕдИзм КАК ВремяЕдИзм,
		|	ОперацииКСозданиюСменныхЗаданий.МожноНазначать КАК МожноНазначать,
		|	ОперацииКСозданиюСменныхЗаданий.НужноНазначать КАК НужноНазначать,
		|	ОперацииКСозданиюСменныхЗаданий.НарушенПорядокНазначения КАК НарушенПорядокНазначения,
		//|	ОперацииКСозданиюСменныхЗаданий.бит_КоличествоХодовОперация КАК бит_КоличествоХодовОперация,
		|	ОперацииКСозданиюСменныхЗаданий.Распоряжение КАК Распоряжение,
		|	ОперацииКСозданиюСменныхЗаданий.НомерОперации КАК НомерОперации,
		|	ОперацииКСозданиюСменныхЗаданий.НомерСледующейОперации КАК НомерСледующейОперации,
		|	ОперацииКСозданиюСменныхЗаданий.Порядок КАК ПорядокСтарый,
		|	ОперацииНазначение.Порядок КАК ПорядокНовый,
		|	ОперацииКСозданиюСменныхЗаданий.Этап.Спецификация.ОсновноеИзделиеНоменклатура КАК ВыходноеИзделие,
		|	ЭтапыПроизводства.Ссылка КАК Ссылка,
		|	ТехнологическиеОперации.бит_КодОперации КАК бит_КодОперации
		|ИЗ
		|	ВТОперацииНазначение КАК ОперацииНазначение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииКСозданиюСменныхЗаданий КАК ОперацииКСозданиюСменныхЗаданий
		|		ПО ОперацииНазначение.Подразделение = ОперацииКСозданиюСменныхЗаданий.Подразделение
		|			И ОперацииНазначение.Этап = ОперацииКСозданиюСменныхЗаданий.Этап
		|			И ОперацииНазначение.Операция = ОперацииКСозданиюСменныхЗаданий.Операция
		|			И ОперацииНазначение.ИдентификаторОперации = ОперацииКСозданиюСменныхЗаданий.ИдентификаторОперации
		|			И ОперацииНазначение.СменноеЗадание = ОперацииКСозданиюСменныхЗаданий.СменноеЗадание
		|			И ОперацииНазначение.Исполнитель = ОперацииКСозданиюСменныхЗаданий.Исполнитель
		|			И ОперацииНазначение.РабочийЦентр = ОперацииКСозданиюСменныхЗаданий.РабочийЦентр
		|			И ОперацииНазначение.ВидРабочегоЦентра = ОперацииКСозданиюСменныхЗаданий.ВидРабочегоЦентра
		|			И ОперацииНазначение.НазначатьНеРанее = ОперацииКСозданиюСменныхЗаданий.НазначатьНеРанее
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|			ПО ЭтапыПроизводства.Ссылка = ТехнологическиеОперации.Владелец
		|				И (ТехнологическиеОперации.НомерСледующейОперации = 0)
		|		ПО (ОперацииКСозданиюСменныхЗаданий.Этап.Спецификация = ЭтапыПроизводства.Владелец)
		|			И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)");
		
		Запрос.УстановитьПараметр("Операции", Операции);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Заказ = Выборка.Распоряжение;
			Этап = Выборка.Этап;
			ВыходноеИзделие = Выборка.ВыходноеИзделие;
			ТекущееОборудование = Выборка.ВидРабочегоЦентра;
			КоличествоКВыпуску = Выборка.Количество;
			Время = Выборка.ВремяШтучное * Выборка.Количество;
			//КоличествоХодов = Выборка.бит_КоличествоХодовОперация;
			//НовоеОборудование = Выборка.ВидРабочегоЦентра;
			СпецификацияЭтапа = Этап.Спецификация;		
			КодОперации = Выборка.бит_КодОперации;
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПосчитатьСкорость();
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьОборудование(Команда)
	
	//Если Не ЗначениеЗаполнено(ПричинаЗаменыОборудования) Тогда
	//	Сообщить("Не указана причина замены оборудования");
	//	Возврат;
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеОборудование)
		И НовоеОборудование <> ТекущееОборудование Тогда
		
		СтруктураПараметров = Новый Структура;
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросСоздатьНовыйЭтап", ЭтотОбъект, СтруктураПараметров); 
		ПоказатьВопрос(ОписаниеОповещения, "Создать новый этап на новом оборудовании?", РежимДиалогаВопрос.ДаНет);
			
	ИначеЕсли НовоеОборудование = ТекущееОборудование Тогда
		
		Сообщить("Новое оборудование совпадает со старым!");
		
	ИначеЕсли НовоеОборудование = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.ПустаяСсылка") Тогда
		
		Сообщить("Не указано новое оборудование!");
		
	Иначе
		
		//Закрыть(Этап);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросСоздатьНовыйЭтап(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Результат = СоздатьНовыйЭтапНаСервере();
		Закрыть(Результат);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьНовыйЭтапНаСервере() 
		
	Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
		
		СпецификацияНовогоЭтапа = Этап.Спецификация.Скопировать();
		СпецификацияНовогоЭтапа.ВариантПодбораВДокументы = Перечисления.ВариантыПодбораСпецификацииВДокументы.Вручную;
		СпецификацияНовогоЭтапа.НачалоДействия = НачалоДня(ТекущаяДатаСеанса());
		СпецификацияНовогоЭтапа.Статус  = Перечисления.СтатусыСпецификаций.ВРазработке;
		СпецификацияНовогоЭтапа.бит_НужнаПроверкаТО = Истина;
		СпецификацияНовогоЭтапа.Записать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеОперации.Ссылка КАК ТехнологическаяОперация,
		|	ЭтапыПроизводства.Ссылка КАК ЭтапПроизводства,
		|	ЭтапыПроизводства.НомерЭтапа КАК НомерЭтапа
		|ИЗ
		|	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|		ПО ЭтапыПроизводства.Ссылка = ТехнологическиеОперации.Владелец
		|			И (ТехнологическиеОперации.НомерСледующейОперации = 0)
		|			И (НЕ ТехнологическиеОперации.ПометкаУдаления)
		|ГДЕ
		|	ЭтапыПроизводства.Владелец = &РесурснаяСпецификация
		|	И ЭтапыПроизводства.НомерСледующегоЭтапа = 0
		|	И НЕ ЭтапыПроизводства.ПометкаУдаления
		|	И ТехнологическиеОперации.бит_КодОперации = &КодОперации";
		
		Запрос.УстановитьПараметр("РесурснаяСпецификация", Этап.Спецификация);
		Запрос.УстановитьПараметр("КодОперации", КодОперации);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НовыйТехнологическаяОперация = ВыборкаДетальныеЗаписи.ТехнологическаяОперация.Скопировать();
			НовыйЭтапПроизводства = ВыборкаДетальныеЗаписи.ЭтапПроизводства.Скопировать();
			
			НовыйЭтапПроизводства.Владелец = СпецификацияНовогоЭтапа.Ссылка;
			НовыйЭтапПроизводства.НомерЭтапа = 1;
			НовыйЭтапПроизводства.НомерСледующегоЭтапа = 0;
			Для Каждого СтрокаТЧ Из НовыйЭтапПроизводства.ВидыРабочихЦентров Цикл
				СтрокаТЧ.ВидРабочегоЦентра = НовоеОборудование;
			КонецЦикла;
			НовыйЭтапПроизводства.Записать();
			
			НовыйТехнологическаяОперация.Владелец = НовыйЭтапПроизводства.Ссылка;
			НовыйТехнологическаяОперация.НомерОперации = 1;
			НовыйТехнологическаяОперация.НомерСледующейОперации = 0;
			НовыйТехнологическаяОперация.РабочийЦентр = НовоеОборудование;			
			НовыйТехнологическаяОперация.Записать();
			
			СпецификацияНовогоЭтапа.Статус  = Перечисления.СтатусыСпецификаций.Действует;
			СпецификацияНовогоЭтапа.Записать();
			
			НомерЭтапа = ВыборкаДетальныеЗаписи.НомерЭтапа;
			ЭтапПроизводства = НовыйЭтапПроизводства.Ссылка;
			
		КонецЦикла;
		
	Иначе
		
		СпецификацияНовогоЭтапа = Спецификация;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтапыПроизводства.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
