	ПараметрыОткрытия.Вставить("ОтображениеТаблицы", ОтображениеТаблицы.Список);
	
	ОткрытьФорму("Справочник.РесурсныеСпецификации.ФормаВыбора", ПараметрыОткрытия, Элемент);
	
КонецПроцедуры


&НаСервере
Процедура СпецификацияПриИзмененииНаСервере()

	//ВыходноеИзделие =  Этап.Спецификация.ОсновноеИзделиеНоменклатура;
	//СпецификацияЭтапа = Этап.Спецификация;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеОперации.РабочийЦентр.ВидРабочегоЦентра КАК ТекущееОборудование
		|ИЗ
		|	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|		ПО ЭтапыПроизводства.Ссылка = ТехнологическиеОперации.Владелец
		|			И (ТехнологическиеОперации.НомерСледующейОперации = 0
		|				И НЕ ТехнологическиеОперации.ПометкаУдаления)
		|ГДЕ
		|	ЭтапыПроизводства.Владелец = &РесурснаяСпецификация
		|	И ЭтапыПроизводства.НомерСледующегоЭтапа = 0
		|	И НЕ ЭтапыПроизводства.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("РесурснаяСпецификация", Спецификация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовоеОборудование = ВыборкаДетальныеЗаписи.ТекущееОборудование;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура СпецификацияПриИзменении(Элемент)
	СпецификацияПриИзмененииНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура НовоеОборудованиеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Ссылка", ПолучитьВРЦ());

	ПараметрыОткрытия = Новый Структура;
    ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	ПараметрыОткрытия.Вставить("НеТекущееОборудование", ТекущееОборудование);
	ПараметрыОткрытия.Вставить("ОтображениеТаблицы", ОтображениеТаблицы.Список);
	ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
	
	ОткрытьФорму("Справочник.ВидыРабочихЦентров.ФормаВыбора", ПараметрыОткрытия, Элемент);

КонецПроцедуры

&НаСервере
Функция ПолучитьВРЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабочихЦентров.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
		|ГДЕ
		|	ВидыРабочихЦентров.Подразделение = &Подразделение";
	
	Запрос.УстановитьПараметр("Подразделение", ТекущееОборудование.Подразделение);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервере
Процедура НовоеОборудованиеПриИзмененииНаСервере()
	
	Элементы.ЗаменитьОборудование.Доступность = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеОперации.Владелец КАК ЭтапПроизводства,
		|	ЭтапыПроизводства.Владелец КАК РесурснаяСпецификация,
		|	ЭтапыПроизводства.НомерЭтапа КАК НомерЭтапа
		|ИЗ
		|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|		ПО ТехнологическиеОперации.Владелец = ЭтапыПроизводства.Ссылка
		|			И (НЕ ЭтапыПроизводства.ПометкаУдаления)
		|			И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)
		|			И (ЭтапыПроизводства.Владелец.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует))
		|ГДЕ
		|	ТехнологическиеОперации.РабочийЦентр = &НовоеОборудование
		|	И ТехнологическиеОперации.НомерСледующейОперации = 0
		|	И НЕ ТехнологическиеОперации.ПометкаУдаления
		|	И ТехнологическиеОперации.Спецификация.ОсновноеИзделиеНоменклатура = &ОсновноеИзделиеНоменклатура
		|	И ТехнологическиеОперации.бит_КодОперации = &КодОперации";
	
	Запрос.УстановитьПараметр("НовоеОборудование", НовоеОборудование);
	Запрос.УстановитьПараметр("ОсновноеИзделиеНоменклатура", ВыходноеИзделие);
	Запрос.УстановитьПараметр("КодОперации", КодОперации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Спецификация = ВыборкаДетальныеЗаписи.РесурснаяСпецификация;
		НомерЭтапа = ВыборкаДетальныеЗаписи.НомерЭтапа;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическиеОперации.Владелец КАК ЭтапПроизводства,
		|	ЭтапыПроизводства.Владелец КАК РесурснаяСпецификация,
		|	ЭтапыПроизводства.НомерЭтапа КАК НомерЭтапа
		|ИЗ
		|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
		|		ПО ТехнологическиеОперации.Владелец = ЭтапыПроизводства.Ссылка
		|			И (НЕ ЭтапыПроизводства.ПометкаУдаления)
		|			И (ЭтапыПроизводства.НомерСледующегоЭтапа = 0)
		|			И (ЭтапыПроизводства.Владелец.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Закрыта))
		|ГДЕ
		|	ТехнологическиеОперации.РабочийЦентр = &НовоеОборудование
		|	И ТехнологическиеОперации.НомерСледующейОперации = 0
		|	И НЕ ТехнологическиеОперации.ПометкаУдаления
		|	И ТехнологическиеОперации.Спецификация.ОсновноеИзделиеНоменклатура = &ОсновноеИзделиеНоменклатура
		|	И ТехнологическиеОперации.бит_КодОперации = &КодОперации";
		
		Запрос.УстановитьПараметр("НовоеОборудование", НовоеОборудование);
		Запрос.УстановитьПараметр("ОсновноеИзделиеНоменклатура", ВыходноеИзделие);
		Запрос.УстановитьПараметр("КодОперации", КодОперации);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Сообщить("Есть закрытая спецификация с таким видом оборудования. Данный маршрут запрещен технологами!");
			Элементы.ЗаменитьОборудование.Доступность = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура НовоеОборудованиеПриИзменении(Элемент)
	
	Спецификация = Неопределено;
	ОчиститьСообщения();

	Если НовоеОборудование = ТекущееОборудование Тогда
		НовоеОборудование = Неопределено;
		Сообщить("Новое оборудование должно отличаться от текущего!");
	ИначеЕсли ПолучитьВРЦ().Найти(НовоеОборудование) = Неопределено Тогда
		НовоеОборудование = Неопределено;
		Сообщить("Подразделение нового обородувания отличается от текущего обрудования!");
	Иначе
		НовоеОборудованиеПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

