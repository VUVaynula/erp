		|	И ЭтапыПроизводства.Владелец = &Спецификация
		|	И ЭтапыПроизводства.НомерСледующегоЭтапа = 0";
		
		Запрос.УстановитьПараметр("Спецификация", СпецификацияНовогоЭтапа);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ЭтапПроизводства = ВыборкаДетальныеЗаписи.Ссылка
		КонецЦикла;
			
	КонецЕсли;
	
	СпецификацияНовогоЭтапа = СпецификацияНовогоЭтапа.Ссылка;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ ПЕРВЫЕ 1
	//	|	ЭтапПроизводства2_2.НомерПартииЗапуска КАК НомерПартииЗапуска
