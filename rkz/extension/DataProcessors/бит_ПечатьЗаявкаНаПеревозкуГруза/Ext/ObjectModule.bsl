
Функция СведенияОВнешнейОбработке() Экспорт
	
	ИмяОбъекта = ЭтотОбъект.Метаданные().Имя; 
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","ПечатнаяФорма"); //может быть – ПечатнаяФорма, ЗаполнениеОбъекта (для вн.обработки), ДополнительныйОтчет, СозданиеСвязанныхОбъектов… 
	ПараметрыРегистрации.Вставить("Наименование", "(бит) Заявка на перевозку груза"); //имя под которым обработка будет зарегестрирована в справочнике внешних обработок
	ПараметрыРегистрации.Вставить("Версия", "1.0.2");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Внешняя печатная форма (бит) Заявка на перевозку груза (ЛТ 22)"); //так будет выглядеть описание вн.отчета для пользователя
	
	// Объявим еще одну переменную, которая нам потребуется ниже
	МассивНазначений = Новый Массив;
	
	// Теперь нам необходимо передать в виде массива имен, к чему будет подключена наша ВПФ
	// Имейте ввиду, что можно задать имя в таком виде: Документ.* - в этом случае обработка будет подключена ко всем документам в системе, 
	// которые поддерживают механизм ВПФ
	МассивНазначений.Добавить("Документ.ЗаданиеНаПеревозку");  
	
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	
	// Создадим таблицу команд (подробнее смотрим ниже)
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	// Добавим команду в таблицу
	ДобавитьКоманду(ТаблицаКоманд, "(бит) Заявка на перевозку груза", "(бит) Заявка на перевозку груза", ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода(), Истина, "ПечатьMXL");    
	// Сохраним таблицу команд в параметры регистрации обработки
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	// Теперь вернем системе наши параметры
	Возврат ПараметрыРегистрации;	
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	// Создадим пустую таблицу команд и колонки в ней
	Команды = Новый ТаблицаЗначений;
	
	// Как будет выглядеть описание печатной формы для пользователя
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка")); 
	
	// Имя нашего макета, что бы могли отличить вызванную команду в обработке печати
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	
	// Тут задается, как должна вызваться команда обработки
	// Возможные варианты:
	// - ОткрытиеФормы - в этом случае в колонке идентификатор должно быть указано имя формы, которое должна будет открыть система
	// - ВызовКлиентскогоМетода - вызвать клиентскую экспортную процедуру из модуля формы обработки
	// - ВызовСерверногоМетода - вызвать серверную экспортную процедуру из модуля объекта обработки
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	
	// Следующий параметр указывает, необходимо ли показывать оповещение при начале и завершению работы обработки. Не имеет смысла при открытии формы
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	
	// Для печатной формы должен содержать строку ПечатьMXL 
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	// Добавляем команду в таблицу команд по переданному описанию.
	// Параметры и их значения можно посмотреть в функции ПолучитьТаблицуКоманд
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати.
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "(бит) Заявка на перевозку груза") Тогда
		//МакетУПД = ПолучитьМакет("Макет");	
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"(бит) Заявка на перевозку груза",
		НСтр("ru = '(бит) Заявка на перевозку груза'"),
		СформироватьПечатнуюФормуЗаявкаНаПеревозкуГруза(МассивОбъектов, ОбъектыПечати));
		
		ОписаниеПечатнойФормы = КоллекцияПечатныхФорм.Найти(ВРег("(бит) Заявка на перевозку груза"), "ИмяВРЕГ");
		Если ОписаниеПечатнойФормы <> Неопределено Тогда
			ОписаниеПечатнойФормы.ДоступенВыводНаДругихЯзыках = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыПечати = Новый Структура("ИмяФормы");
	
	//ЗаявкаНаВозвратТоваровОтКлиентаЛокализация.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры  

Функция СформироватьПечатнуюФормуЗаявкаНаПеревозкуГруза(МассивОбъектов, ОбъектыПечати) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ЗаданиеНаПеревозку.Ссылка КАК Ссылка,
	|	ЗаданиеНаПеревозку.Склад КАК Склад,
	|	ЗаданиеНаПеревозку.Операция КАК Операция,
	|	ЗаданиеНаПеревозку.Номер КАК Номер,
	|	ЗаданиеНаПеревозку.Дата КАК Дата,
	|	ЗаданиеНаПеревозку.ДатаВремяРейсаПланС КАК ДатаВремяРейсаПланС,
	|	ЗаданиеНаПеревозку.АвтомобильМарка КАК АвтомобильМарка,
	|	ЗаданиеНаПеревозку.АвтомобильГосударственныйНомер КАК АвтомобильГосударственныйНомер,
	|	ЗаданиеНаПеревозку.ГосударственныйНомерПрицепа КАК ГосударственныйНомерПрицепа,
	|	ЗаданиеНаПеревозку.Перевозчик КАК Перевозчик,
	|	ЗаданиеНаПеревозку.бит_Паспорт КАК бит_Паспорт,
	|	ЗаданиеНаПеревозку.бит_Телефон КАК бит_Телефон,
	|	ЗаданиеНаПеревозку.Склад.ТекущийОтветственный КАК СкладТекущийОтветственный,
	|	ЗаданиеНаПеревозку.бит_СуммаОплаты КАК бит_СуммаОплаты,
	|	ЗаданиеНаПеревозку.ВодительФИО КАК ВодительФИО,
	|	ЗаданиеНаПеревозку.ДополнительнаяИнформация КАК ДополнительнаяИнформация,
	|	ЗаданиеНаПеревозку.Контрагент КАК Контрагент,
	|	ЗаданиеНаПеревозку.ЗаданиеВыполняет КАК ЗаданиеВыполняет
	|ИЗ
	|	Документ.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозку
	|ГДЕ
	|	ЗаданиеНаПеревозку.Ссылка В(&МассивОбъектов)";
	
	ЗаполнитьТабличныйДокументЗаказаПоставщику(ТабличныйДокумент, Запрос, ОбъектыПечати);
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ЗаполнитьТабличныйДокументЗаказаПоставщику(ТабличныйДокумент, Запрос, ОбъектыПечати)
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаданиеНаПеревозку_ЗоаявкаНаПеревозкуГруза";
	
	ДанныеПечати = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьДокумент = Макет.ПолучитьОбласть("Документ");
	
	//Организация = Справочники.Организации.ОрганизацияПоУмолчанию();	
	Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7610093062");
	
	Пока ДанныеПечати.Следующий() Цикл
		
		Если ДанныеПечати.ЗаданиеВыполняет = Перечисления.ТипыИсполнителейЗаданийНаПеревозку.НашаТранспортнаяСлужба Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Заявка на перевозку не может быть сформирована для документа %1 от %2 
										|т.к. перевозка осуществляется своими силами (ЛТ 22)",
										ДанныеПечати.Номер, ДанныеПечати.Дата);
			Сообщение.Сообщить();
			
			Продолжить;
		КонецЕсли;		
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Иначе
			ПервыйДокумент = Ложь;
		КонецЕсли;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		// Вывод шапки документа
		
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("НомерДокумента", ДанныеПечати.Номер);
		СтруктураДанных.Вставить("ДатаДокумента", Формат(ДанныеПечати.Дата, "ДФ=dd.MM.yyyy"));
		СтруктураДанных.Вставить("ДатаЗагрузки", Формат(ДанныеПечати.ДатаВремяРейсаПланС, "ДФ=dd.MM.yyyy"));
		СтруктураДанных.Вставить("СуммаОплаты", ДанныеПечати.бит_СуммаОплаты);
		
		СтруктураДанных.Вставить("Водитель", ДанныеПечати.ВодительФИО); 
		СтруктураДанных.Вставить("Паспорт", ДанныеПечати.бит_Паспорт);  
		СтруктураДанных.Вставить("ТелефонВодителя", ДанныеПечати.бит_Телефон);
		СтруктураДанных.Вставить("Марка", ДанныеПечати.АвтомобильМарка);     
		СтруктураДанных.Вставить("ГосНомер", ДанныеПечати.АвтомобильГосударственныйНомер);
		СтруктураДанных.Вставить("НомерПрицепа", ДанныеПечати.ГосударственныйНомерПрицепа);
		СтруктураДанных.Вставить("ДополнительнаяИнформация", ДанныеПечати.ДополнительнаяИнформация);
		
		ДополнительныеСведениЗаказчика = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, ДанныеПечати.Дата);
		СтруктураДанных.Вставить("Заказчик", ДополнительныеСведениЗаказчика.Представление);
		СтруктураДанных.Вставить("ЗаказчикИНН", ДополнительныеСведениЗаказчика.ИНН);
		СтруктураДанных.Вставить("ЗаказчикКПП", ДополнительныеСведениЗаказчика.КПП);
		СтруктураДанных.Вставить("ЗаказчикАдрес", ДополнительныеСведениЗаказчика.ЮридическийАдрес);
		СтруктураДанных.Вставить("ЗаказчикТелефон", ДополнительныеСведениЗаказчика.Телефоны); 	
		СтруктураДанных.Вставить("ЗаказчикЭлПочта", ДополнительныеСведениЗаказчика.АдресЭлектроннойПочты);											
		
		ДополнительныеСведениИсполнителя = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.Контрагент, ДанныеПечати.Дата);
		СтруктураДанных.Вставить("Исполнитель", ДополнительныеСведениИсполнителя.Представление);		
		СтруктураДанных.Вставить("ИсполнительИНН", ДополнительныеСведениИсполнителя.ИНН);
		СтруктураДанных.Вставить("ИсполнительПП", ДополнительныеСведениИсполнителя.КПП);
		СтруктураДанных.Вставить("ИсполнительАдрес", ДополнительныеСведениИсполнителя.ЮридическийАдрес);
		СтруктураДанных.Вставить("ИсполнительТелефон", ДополнительныеСведениИсполнителя.Телефоны); 	
		СтруктураДанных.Вставить("ИсполнительЭлПочта", ДополнительныеСведениИсполнителя.АдресЭлектроннойПочты);			

		Логист = Пользователи.ТекущийПользователь();
		ДанныеПользователя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Логист,
										Справочники.ВидыКонтактнойИнформации.ТелефонПользователя, ДанныеПечати.Дата, Истина);			
		СтруктураДанных.Вставить("Логист", Логист);			
		СтруктураДанных.Вставить("ЛогистТелефон", ДанныеПользователя);			
		
		
		
		//Вывод многострочных элементов
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозкуМаршрут.Адрес КАК АдресОтправления,
		|	ЗаданиеНаПеревозкуРаспоряжения.ПолучательОтправитель КАК ПолучательОтправитель,
		|	ВЫРАЗИТЬ(ЗаданиеНаПеревозкуРаспоряжения.Распоряжение КАК Документ.ПоручениеЭкспедитору) КАК Распоряжение,
		|	ЗаданиеНаПеревозкуМаршрут.НомерСтроки КАК НомерСтроки,
		|	ЗаданиеНаПеревозкуМаршрут.ДополнительнаяИнформация КАК ДополнительнаяИнформация,
		|	ЗаданиеНаПеревозкуМаршрут.ВремяС КАК ВремяС,
		|	ЗаданиеНаПеревозкуМаршрут.Вес КАК Вес
		|ПОМЕСТИТЬ ВТ_ПорученияЭкспедитору
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку.Маршрут КАК ЗаданиеНаПеревозкуМаршрут
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
		|		ПО ЗаданиеНаПеревозкуМаршрут.Ссылка = ЗаданиеНаПеревозкуРаспоряжения.Ссылка
		|			И ЗаданиеНаПеревозкуМаршрут.КлючСвязи = ЗаданиеНаПеревозкуРаспоряжения.КлючСвязи
		|ГДЕ
		|	ЗаданиеНаПеревозкуМаршрут.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПорученияЭкспедитору.АдресОтправления КАК АдресОтправления,
		|	ВТ_ПорученияЭкспедитору.ПолучательОтправитель КАК ПолучательОтправитель,
		|	ВТ_ПорученияЭкспедитору.НомерСтроки КАК НомерСтроки,
		|	ВТ_ПорученияЭкспедитору.ДополнительнаяИнформация КАК ДополнительнаяИнформация,
		|	ВТ_ПорученияЭкспедитору.Распоряжение.Пункт КАК РаспоряжениеПункт,
		|	ВТ_ПорученияЭкспедитору.Распоряжение.АдресДоставки КАК РаспоряжениеАдресДоставки,
		|	ВТ_ПорученияЭкспедитору.Распоряжение.ОсобыеУсловияПеревозкиОписание КАК РаспоряжениеОсобыеУсловияПеревозкиОписание,
		|	ВТ_ПорученияЭкспедитору.ВремяС КАК ДатаПрибытия,
		|	ВТ_ПорученияЭкспедитору.Распоряжение.КонтактноеЛицо КАК РаспоряжениеКонтактноеЛицо,
		|	ВТ_ПорученияЭкспедитору.Вес КАК Вес
		|ИЗ
		|	ВТ_ПорученияЭкспедитору КАК ВТ_ПорученияЭкспедитору
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеПечати.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ДанныеТЧМаршрут = РезультатЗапроса.Выбрать();		
		
		ДанныеАдресаСклада = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДанныеПечати.Склад,
		Справочники.ВидыКонтактнойИнформации.АдресСклада, ДанныеПечати.Дата, Ложь);		
		
		ГородСклада = "";
		АдресСклада = "";
		Если ДанныеАдресаСклада.Количество()	> 0 Тогда
			ГородСклада = РаботаСАдресами.ГородАдресаКонтактнойИнформации(ДанныеАдресаСклада[0].Значение);  
