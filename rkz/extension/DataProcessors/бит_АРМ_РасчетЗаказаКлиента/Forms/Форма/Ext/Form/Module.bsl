&НаКлиенте
Процедура РасчитатьВес(ТекущиеДанные, Намотка)
	
	// Взято из ЛТ8{{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] +
	
	//_1 "Вес нетто, т" - автоматический расчет (например 1км ГП весит 0,01т - заказали 10 км ГП - Вес нетто = 0,1т)
	//_2 "Вес брутто, т" - автоматический расчет 
	//(например 1км ГП весит 0,01т; 1 шт Тары весит 0,01т - заказали 10 км ГП 
	//(согласно Регистру сведений на 1 шт Тары максимально наматывается 5 км, т.е. необходимо 2шт Тары для намотки 10 км ГП) - Вес брутто = 0,12т)
	//_3 "Тип тары" (номенклатура) - заполняется из справочника Номенклатура - Вид номенклатуры - Тара
	//_4 "Количество тары" - автоматический расчет 
	//(например заказали 10 км ГП, указали Тип тары 
	//(согласно Регистру сведений на 1 шт Тары максимально наматывается 5 км) - Количество тары = 2 шт)
	//_5 "Намотка" - автоматическое заполнение из Регистра сведений (максимальное значение). 
	//При необходимости (по запросу клиента) изменяется на меньшее значение и производится автоматический пересчет значений "Количество тары", "Вес брутто".
				
	Если ТекущиеДанные <> Неопределено Тогда
		ВесНетто = ПолучитьВесНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.ЕдиницаИзмерения);
		ТекущиеДанные.ВесНетто = ВесНетто * ТекущиеДанные.Количество;
		Если Намотка <> 0 Тогда
			ТекущиеДанные.КоличествоТары = ТекущиеДанные.Количество / Намотка;
		Иначе
			ТекущиеДанные.КоличествоТары = 0;
			ТекущиеДанные.Намотка = 0;	
		КонецЕсли;	
		Если Цел(ТекущиеДанные.КоличествоТары) <> ТекущиеДанные.КоличествоТары Тогда
			ТекущиеДанные.КоличествоТары = Цел(ТекущиеДанные.КоличествоТары) + 1;	
		КонецЕсли;
		ВесНетто = ПолучитьВесНоменклатуры(ТекущиеДанные.Тара, ТекущиеДанные.ЕдиницаИзмерения);
		ТекущиеДанные.ВесБрутто = ТекущиеДанные.ВесНетто + (ВесНетто * ТекущиеДанные.КоличествоТары);
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] -
	
КонецПроцедуры   

