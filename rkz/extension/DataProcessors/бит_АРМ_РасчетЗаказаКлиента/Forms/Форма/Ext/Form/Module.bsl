
&НаКлиенте
Процедура СоздатьЗаказ(Команда)
	Если Товары.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет товаров для продажи");
		Возврат;
	КонецЕсли;
	
	ФормаЗаказа = ПолучитьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента");
    ДанныеФормы = ФормаЗаказа.Объект;
    ЗаполнитьНаСервере(ДанныеФормы);
    КопироватьДанныеФормы(ДанныеФормы, ФормаЗаказа.Объект);
    ФормаЗаказа.Открыть();   
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьНаСервере(ДокЗаказ)

	ДокЗаказ.Дата = ДатаПрайса;
	ДокЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Для каждого стр из Товары Цикл
		нов = ДокЗаказ.Товары.Добавить();
		нов.Номенклатура  = стр.Номенклатура;
		нов.Количество 	  = стр.Количество; 
		нов.КоличествоУпаковок = стр.Количество;
		нов.Упаковка 	  = стр.ЕдиницаИзмерения;
		нов.Цена 		  = стр.ЦенаПрайс;
		нов.ПроцентРучнойСкидки = стр.Скидка;
		нов.Сумма 		  = стр.ЦенаПоСчету*стр.Количество;
		нов.бит_ТипТары   = стр.Тара; 
		нов.бит_ВесНетто  = стр.ВесНетто;
		нов.бит_ВесБрутто = стр.ВесБрутто;
		нов.бит_КоличествоТары = стр.КоличествоТары;	
		нов.бит_Намотка	  = стр.Намотка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияПоУмолчанию"); 
	СтруктураДействий.Вставить("ОпределитьЦенуПрайса");
	СтруктураДействий.Вставить("ПересчитатьЦену");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьПоказатели");  
	
	Если Элементы.Товары.ТекущиеДанные.Количество = 0 Тогда 
		Элементы.Товары.ТекущиеДанные.Количество = 1;
	КонецЕсли;
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные, СтруктураДействий);
	
КонецПроцедуры   

&НаКлиенте
Процедура ТоварыЦенаПрайсПриИзменении(Элемент) 
	
	СтруктураДействий = Новый Структура;   
	СтруктураДействий.Вставить("ПересчитатьЦену");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьПоказатели");
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные, СтруктураДействий); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПоСчетуПриИзменении(Элемент)
	
	ТД = Элементы.Товары.ТекущиеДанные;
	Если ТД.ЦенаПрайс = 0 Тогда
		ТД.ЦенаПрайс = ТД.ЦенаПоСчету;
	КонецЕсли;
	СтруктураДействий = Новый Структура;   
	СтруктураДействий.Вставить("ПересчитатьСкидку");  
	СтруктураДействий.Вставить("ПересчитатьСумму");
	
	ПересчитатьСтроку(ТД, СтруктураДействий); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкидкаПриИзменении(Элемент)
// Цена по счету = [Цена (прайс)] / 100 * (100 - [Скидка, %])
// Марж. прибыль на ед. = [Цена по счету] - [Полная с/с с КР на ед.]
// % марж. Прибыли = [Марж. прибыль на ед.] /([Полная с/с с КР на ед.]
	СтруктураДействий = Новый Структура;  
	СтруктураДействий.Вставить("ПересчитатьЦену");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	//СтруктураДействий.Вставить("ПересчитатьПоказатели");    
	СтруктураДействий.Вставить("МаржПрибыльНаЕд");
	СтруктураДействий.Вставить("МаржПрибыльНаКолВо");
	СтруктураДействий.Вставить("ПроцентМаржПрибыли");
	
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные, СтруктураДействий);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьПоказатели");
	ПересчитатьСтроку(Элементы.Товары.ТекущиеДанные, СтруктураДействий);

КонецПроцедуры                                       

&НаКлиенте
Процедура ПересчитатьСтроку(ТекущиеДанные, СтруктураДействий)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                       
	
	Для каждого Действие Из СтруктураДействий Цикл
			
		Если Действие.Ключ = "ЗаполнитьЕдиницуИзмеренияПоУмолчанию" Тогда
			ТекущиеДанные.ЕдиницаИзмерения = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Номенклатура, "ЕдиницаИзмерения");
		ИначеЕсли Действие.Ключ = "ОпределитьЦенуПрайса" Тогда
			ТекущиеДанные.ЦенаПрайс = ОпределитьЦену(ТекущиеДанные.Номенклатура, ДатаПрайса);
		ИначеЕсли Действие.Ключ = "ПересчитатьЦену" Тогда
			ТекущиеДанные.ЦенаПоСчету = ?(ТекущиеДанные.Скидка = 100, 0, ТекущиеДанные.ЦенаПрайс / 100 * (100 - ТекущиеДанные.Скидка));
		ИначеЕсли Действие.Ключ = "ПересчитатьЦенуПоПрибыли" Тогда
			//	Цена по счету = [Полная с/с с КР на ед.] + [Марж. прибыль на ед.]
			ТекущиеДанные.ЦенаПоСчету = ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу + ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу;  
		ИначеЕсли Действие.Ключ = "МаржПрибыльНаЕдПоКоличеству" Тогда
			//Марж. прибыль на ед. = [Марж. прибыль на кол-во] / [Кол-во]
	        ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу = ТекущиеДанные.МаржинальнаяПрибыльНаКоличество / ТекущиеДанные.Количество;
		ИначеЕсли Действие.Ключ = "МаржПрибыльНаЕдПоПроценту" Тогда
			//Марж. прибыль на ед. = [Полная с/с с КР на ед.]] * [% марж. Прибыли]
			ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу = ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу * ТекущиеДанные.МаржинальнаяПрибыльПроцент/100;
		ИначеЕсли Действие.Ключ = "ПересчитатьСкидку" Тогда
			//Скидка, % = 100 - (([Цена по счету] *100)/[Цена (прайс)])	
			Если ТекущиеДанные.ЦенаПрайс = 0 Тогда
				ТекущиеДанные.Скидка = 0;
			Иначе
				ТекущиеДанные.Скидка = 100 - ((ТекущиеДанные.ЦенаПоСчету * 100) / ТекущиеДанные.ЦенаПрайс);
			КонецЕсли;
		ИначеЕсли Действие.Ключ = "ПересчитатьСумму" Тогда 
			// Сумма по счету = [Цена по счету] * [Кол-во]
			ТекущиеДанные.СуммаПоСчету = ТекущиеДанные.ЦенаПоСчету * ТекущиеДанные.Количество;
		ИначеЕсли Действие.Ключ = "ПересчитатьПоказатели" Тогда
			ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу = ОпределитьПолнуюСебестоимостьНаЕдиницу(ТекущиеДанные.Номенклатура, СпособРасчетаСебестоимости, ДатаПрайса); 
			ТекущиеДанные.ПолнаяСебестоимостьНаКоличество = ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу * ТекущиеДанные.Количество; 
			ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу = ТекущиеДанные.ЦенаПоСчету - ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу;
			ТекущиеДанные.МаржинальнаяПрибыльНаКоличество = ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу * ТекущиеДанные.Количество;                                        
			Если ТекущиеДанные.СуммаПоСчету = 0 Тогда      
				ТекущиеДанные.МаржинальнаяПрибыльПроцент = 0;
			иначе
				ТекущиеДанные.МаржинальнаяПрибыльПроцент = ?(ТекущиеДанные.ЦенаПоСчету = 0, 0, Окр((ТекущиеДанные.МаржинальнаяПрибыльНаКоличество / ТекущиеДанные.СуммаПоСчету) * 100, 2));
			КонецЕсли;
		ИначеЕсли Действие.Ключ = "МаржПрибыльНаЕд" Тогда    
			// Марж. прибыль на ед. = [Цена по счету] - [Полная с/с с КР на ед.]
			ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу = ТекущиеДанные.ЦенаПоСчету - ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу;
		ИначеЕсли Действие.Ключ = "МаржПрибыльНаКолВо" Тогда 
			// Марж. прибыль на кол-во = [Марж. прибыль на ед.] * [Кол-во]
			ТекущиеДанные.МаржинальнаяПрибыльНаКоличество = ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу * ТекущиеДанные.Количество;
		ИначеЕсли Действие.Ключ = "ПроцентМаржПрибыли" Тогда 
			// % марж. Прибыли = [Марж. прибыль на ед.] /([Полная с/с с КР на ед.]
			Если ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу = 0 Тогда
				ТекущиеДанные.МаржинальнаяПрибыльПроцент = 0;
			Иначе
				ТекущиеДанные.МаржинальнаяПрибыльПроцент = ?(ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу = 0, 0, ТекущиеДанные.МаржинальнаяПрибыльНаЕдиницу / ТекущиеДанные.ПолнаяСебестоимостьНаЕдиницу);
				ТекущиеДанные.МаржинальнаяПрибыльПроцент = ТекущиеДанные.МаржинальнаяПрибыльПроцент * 100;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьПолнуюСебестоимостьНаЕдиницу(Номенклатура, СпособРасчетаСебестоимости, ДатаПрайса) 
//	Описание механизма расчета себестоимости
//1.Поиск плановой калькуляции
//Шаг 1: Найти последний документ «Плановая калькуляция» для конкретного товара (номенклатуры).
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПлановаяКалькуляция2_2ОбъектыКалькуляции.Ссылка КАК Ссылка,
		|	ПлановаяКалькуляция2_2ОбъектыКалькуляции.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.ПлановаяКалькуляция2_2.ОбъектыКалькуляции КАК ПлановаяКалькуляция2_2ОбъектыКалькуляции
		|ГДЕ
		|	ПлановаяКалькуляция2_2ОбъектыКалькуляции.Номенклатура = &Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ
		|");  
Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда
	ДокументПК = Выборка.Ссылка;
Иначе
	//Шаг 4: В случае, если для номенклатуры не найдена плановая калькуляция, необходимо выдать пользователю оповещение:
	//Сообщение: «Себестоимость не рассчитана, т.к. нет данных для расчета».
	ОбщегоНазначения.СообщитьПользователю("Себестоимость не рассчитана, т.к. нет данных для расчета");
	Возврат 0;
КонецЕсли;
//Регистры: Использовать регистр «Плановые материальные затраты» для получения данных о материальных затратах для номенклатуры.
Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МножителиПартийИПолуфабрикатов.ПартияСпецификацияПродукции КАК ПартияСпецификацияПродукции,
		|	МножителиПартийИПолуфабрикатов.Продукция КАК Продукция,
		|	МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции КАК ХарактеристикаПродукции,
		|	МножителиПартийИПолуфабрикатов.Назначение КАК Назначение,
		|	МАКСИМУМ(МножителиПартийИПолуфабрикатов.Калькуляция.Дата) КАК Период
		|ПОМЕСТИТЬ ПериодыКалькуляций
		|ИЗ
		|	РегистрСведений.МножителиПартийИПолуфабрикатов КАК МножителиПартийИПолуфабрикатов
		|ГДЕ
		|	(МножителиПартийИПолуфабрикатов.Калькуляция.Дата <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			ИЛИ &Период = ДАТАВРЕМЯ(1, 1, 1))
		|	И МножителиПартийИПолуфабрикатов.Калькуляция = &Калькуляция
		|
		|СГРУППИРОВАТЬ ПО
		|	МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции,
		|	МножителиПартийИПолуфабрикатов.Продукция,
		|	МножителиПартийИПолуфабрикатов.ПартияСпецификацияПродукции,
		|	МножителиПартийИПолуфабрикатов.Назначение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПериодыКалькуляций.ПартияСпецификацияПродукции КАК ПартияСпецификацияПродукции,
		|	ПериодыКалькуляций.Продукция КАК Продукция,
		|	ПериодыКалькуляций.ХарактеристикаПродукции КАК ХарактеристикаПродукции,
		|	ПериодыКалькуляций.Назначение КАК Назначение,
		|	МАКСИМУМ(МножителиПартийИПолуфабрикатов.Калькуляция) КАК Калькуляция
		|ПОМЕСТИТЬ ПоследниеКалькуляции
		|ИЗ
		|	ПериодыКалькуляций КАК ПериодыКалькуляций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.МножителиПартийИПолуфабрикатов КАК МножителиПартийИПолуфабрикатов
		|		ПО ПериодыКалькуляций.Период = МножителиПартийИПолуфабрикатов.Калькуляция.Дата
		|			И ПериодыКалькуляций.ПартияСпецификацияПродукции = МножителиПартийИПолуфабрикатов.ПартияСпецификацияПродукции
		|			И ПериодыКалькуляций.Продукция = МножителиПартийИПолуфабрикатов.Продукция
		|			И ПериодыКалькуляций.ХарактеристикаПродукции = МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции
		|			И ПериодыКалькуляций.Назначение = МножителиПартийИПолуфабрикатов.Назначение
		|
		|СГРУППИРОВАТЬ ПО
		|	ПериодыКалькуляций.ПартияСпецификацияПродукции,
		|	ПериодыКалькуляций.Продукция,
		|	ПериодыКалькуляций.ХарактеристикаПродукции,
		|	ПериодыКалькуляций.Назначение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоследниеКалькуляции.Продукция КАК Продукция,
		|	ПоследниеКалькуляции.ХарактеристикаПродукции КАК ХарактеристикаПродукции,
		|	ПоследниеКалькуляции.Назначение КАК Назначение,
		|	ПоследниеКалькуляции.Калькуляция КАК Калькуляция,
		|	ПоследниеКалькуляции.ПартияСпецификацияПродукции КАК ПартияСпецификацияПродукции,
		|	СУММА(МножителиПартийИПолуфабрикатов.КоличествоПолуфабриката) КАК ВсегоКоличество
		|ПОМЕСТИТЬ РассчитанноеКоличество
		|ИЗ
		|	ПоследниеКалькуляции КАК ПоследниеКалькуляции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.МножителиПартийИПолуфабрикатов КАК МножителиПартийИПолуфабрикатов
		|		ПО ПоследниеКалькуляции.Калькуляция = МножителиПартийИПолуфабрикатов.Калькуляция
		|			И ПоследниеКалькуляции.ПартияСпецификацияПродукции = МножителиПартийИПолуфабрикатов.ПартияСпецификацияПродукции
		|			И ПоследниеКалькуляции.Продукция = МножителиПартийИПолуфабрикатов.Продукция
		|			И ПоследниеКалькуляции.ХарактеристикаПродукции = МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции
		|			И ПоследниеКалькуляции.Назначение = МножителиПартийИПолуфабрикатов.Назначение
		|			И (МножителиПартийИПолуфабрикатов.Полуфабрикат = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
		|
		|СГРУППИРОВАТЬ ПО
		|	ПоследниеКалькуляции.Продукция,
		|	ПоследниеКалькуляции.ХарактеристикаПродукции,
		|	ПоследниеКалькуляции.Назначение,
		|	ПоследниеКалькуляции.Калькуляция,
		|	ПоследниеКалькуляции.ПартияСпецификацияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
