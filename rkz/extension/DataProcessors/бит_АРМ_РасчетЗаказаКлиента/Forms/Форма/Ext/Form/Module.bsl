&НаСервереБезКонтекста
Функция ОпределитьЦену(Номенклатура, ДатаПрайса)
	
	Цена = 0; 
	ЭлементВидаЦены = Справочники.бит_ЗначенияПоУмолчанию.БазовыйВидЦеныПродажи;   
	ВидЦены = ЭлементВидаЦены.Значение;
	Если ЗначениеЗаполнено(ВидЦены) Тогда
			
		Запрос = Новый Запрос;
		Если Константы.ИспользуетсяЦенообразование25.Получить() Тогда
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	ЦеныНоменклатуры25СрезПоследних.Цена КАК Цена
		                      |ИЗ
		                      |	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		                      |			&Дата,
		                      |			Номенклатура = &Номенклатура
		                      |				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатуры25СрезПоследних";
		Иначе 
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
			               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
			               |ИЗ
			               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			               |			&Дата,
			               |			Номенклатура = &Номенклатура
			               |				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних"; 
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Дата", ДатаПрайса);   
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Цена = Выборка.Цена;
		КонецЕсли;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не указан Базовый вид цены продажи", ЭлементВидаЦены);
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

