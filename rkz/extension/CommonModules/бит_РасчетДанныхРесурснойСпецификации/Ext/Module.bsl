Функция ПолучитьПризнакИзЗапроса(Номенклатура, Признак)
	
	Запрос = Новый Запрос("ВЫБРАТЬ Первые 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК ЗначениеПризнака
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &Признак
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации 
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ Первые 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Значение
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &Признак
	                      |	И Не бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации ");
	Запрос.УстановитьПараметр("Признак", Признак);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);    
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗначениеПризнака = Выборка.ЗначениеПризнака;
	Иначе                  
		ЗначениеПризнака = Неопределено;
	КонецЕсли;
	
	Возврат ЗначениеПризнака;
		
КонецФункции

Функция ПризнакВысыханиеЛака(Номенклатура)  
	
	Признак = Справочники.бит_ЗначенияПоУмолчанию.ПризнакИспользуетсяКакЛак.Значение;
	Результат = ПолучитьПризнакИзЗапроса(Номенклатура, Признак);
	Если Результат <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Признак = Справочники.бит_ЗначенияПоУмолчанию.ПризнакВысыханиеЛака.Значение;
	Результат = ПолучитьПризнакИзЗапроса(Номенклатура, Признак); 
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Неопределено;
	КонецЕсли;    
	
	Возврат Результат;
	
КонецФункции

Функция ПересчетЕдиницИзмерения(Номенклатура)  
	
	Признак = Справочники.бит_ЗначенияПоУмолчанию.ПризнакИспользуетсяПересчетЕдиницИзмерения.Значение;
	Результат = ПолучитьПризнакИзЗапроса(Номенклатура, Признак);
	Если Результат <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Признак = Справочники.бит_ЗначенияПоУмолчанию.ПризнакПересчетЕдиницИзмерения.Значение;
	Результат = ПолучитьПризнакИзЗапроса(Номенклатура, Признак); 
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Неопределено;
	КонецЕсли;    
	
	Возврат Результат;
	
КонецФункции

Функция Разузловка(Номенклатура, мТара, Отказ)
	
	ВесНетто = 0;
	Спецификация = СпецификацияНоменклатуры(Номенклатура, ТекущаяДатаСеанса());  // Найдем спецификацию
	Если Спецификация.МатериалыИУслуги.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры " + Номенклатура + " в спецификации " + Спецификация + " нет материалов для расчета веса", Спецификация);	
	Иначе	
		Для каждого стр из Спецификация.МатериалыИУслуги Цикл 
			Если мТара.Найти(стр.Номенклатура.ТипНоменклатуры) <> Неопределено Тогда 
				Продолжить; // Тару не берем
			КонецЕсли;
			
			Если стр.ПроизводитсяВПроцессе Тогда
				// Это ПФ. ИщемСпецификацию и разузловка   
				ВесЕдиницы = Разузловка(стр.Номенклатура, мТара, Отказ);
			Иначе
				ВесЕдиницы = НеттоЕдиницы(стр.Номенклатура, Отказ);   
			КонецЕсли;
			Если Отказ Или ВесЕдиницы = Неопределено Тогда
				Возврат ВесЕдиницы;
			КонецЕсли;
			ВесПоСтроке = ВесДляМатериала(ВесЕдиницы, стр, Спецификация);
	        ВесНетто = ВесНетто + ВесПоСтроке;

		КонецЦикла;  
	КонецЕсли;
	
	Если ВесНетто = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры " + Номенклатура + " вес не определен");
		Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
			Отказ = Истина;
		Иначе    
			ВесНетто = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВесНетто; 

КонецФункции  

Функция СпецификацияНоменклатуры(Номенклатура, Дата = Неопределено) Экспорт
	
	Спецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();

	Если ЗначениеЗаполнено(Номенклатура) Тогда
			
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	РесурсныеСпецификации.НачалоДействия КАК НачалоДействия,
			|	РесурсныеСпецификации.Ссылка КАК Спецификация
			|ИЗ
			|	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
			|ГДЕ
			|	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура = &Номенклатура
			|	И РесурсныеСпецификации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует)
			|	И ВЫБОР
			|			КОГДА РесурсныеСпецификации.КонецДействия = ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ИСТИНА
			|			КОГДА РесурсныеСпецификации.КонецДействия >= &Дата
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И РесурсныеСпецификации.НачалоДействия <= &Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	НачалоДействия УБЫВ
			|");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, Дата("00010101"), Дата));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Спецификация = Выборка.Спецификация;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Спецификация;
	
КонецФункции

Функция ПолучитьМассивТиповТара()
	
	тТара = Справочники.бит_ЗначенияПоУмолчанию.ТипНоменклатурыТара.Значения.Выгрузить(, "Значение");
	Если тТара.Количество() Тогда
		мТара = тТара.ВыгрузитьКолонку("Значение");
	Иначе     
		мТара = Новый Массив;
	КонецЕсли;
	
	Возврат мТара;

КонецФункции

