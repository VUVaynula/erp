Функция ВесДляМатериала(Знач ВесЕдиницы, Знач стр, Знач Спецификация, ЭтоЦелеваяСпецификация = Ложь)
	// коэф.укрутки
	КоэффициентУкрутки = ?(ЗначениеЗаполнено(стр.бит_КоэффициентУкрутки), стр.бит_КоэффициентУкрутки, 1);
	ВесПоСтроке = ВесЕдиницы * стр.бит_КоличествоПозиции * КоэффициентУкрутки;
	// высыхание лака
	ПризнакВысыханиеЛака = ПризнакВысыханиеЛака(стр.Номенклатура);
	Если ПризнакВысыханиеЛака <> Неопределено Тогда
		ВесПоСтроке = ВесЕдиницы * стр.бит_КоличествоПозиции * ПризнакВысыханиеЛака;
	КонецЕсли;
	// ИспользуетсяПересчетЕдиницИзмерения
	ПересчетЕдиницИзмерения = ПересчетЕдиницИзмерения(стр.Номенклатура);
	Если ПересчетЕдиницИзмерения <> Неопределено Тогда
		ВесПоСтроке = ВесЕдиницы * стр.бит_КоличествоПозиции * ПересчетЕдиницИзмерения;
	КонецЕсли;    
	
	Если ЭтоЦелеваяСпецификация Тогда // для целевой спецификации не нужно пересчитывать кратность и единицу измерения.
		ВесПоСтрокеНаЕдиницуПоСпецификации = ВесПоСтроке;
	Иначе
		//Посчитаем кратность по спецификации
		ОсновноеИзделиеУпаковка = Спецификация.ОсновноеИзделиеУпаковка; 
		ОсновноеИзделиеКоличествоУпаковок = Спецификация.ОсновноеИзделиеКоличествоУпаковок;
		ОсновноеИзделиеНоменклатура = Спецификация.ОсновноеИзделиеНоменклатура;
		КоэффициентУпаковки = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(ОсновноеИзделиеУпаковка, ОсновноеИзделиеНоменклатура); 	
		КоличествоПоСпецификации = КоэффициентУпаковки * ОсновноеИзделиеКоличествоУпаковок;
		ВесПоСтрокеНаЕдиницуПоСпецификации = ВесПоСтроке/КоличествоПоСпецификации;
	КонецЕсли;
	
	Возврат ВесПоСтрокеНаЕдиницуПоСпецификации;

КонецФункции            

Функция ПолучитьМассивВидовНоменклатурГП()
	
	мВидов = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВидыНоменклатуры.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	                      |ГДЕ
	                      |	ВидыНоменклатуры.Ссылка В ИЕРАРХИИ(&мВидовГП)
	                      |	И НЕ ВидыНоменклатуры.ЭтоГруппа"); 
	
	тВидовГП = Справочники.бит_ЗначенияПоУмолчанию.ВидНоменклатурыГотоваяПродукция;
	Если тВидовГП.Значения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить виды ГП", тВидовГП);
		Возврат мВидов;	
	КонецЕсли; 
	Запрос.УстановитьПараметр("мВидовГП", тВидовГП.Значения.Выгрузить(, "Значение").ВыгрузитьКолонку("Значение")); 
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

