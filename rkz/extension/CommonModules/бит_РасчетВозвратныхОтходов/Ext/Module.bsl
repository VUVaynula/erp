	                      |	КОНЕЦ КАК КоэффициентУкрутки,
						  //|	бит_КоэфицентыСпецификаций.ТехОтходПроцент КАК ТехОтходПроцент,
						  //|	бит_КоэфицентыСпецификаций.АгрегирующийКоэффициент КАК АгрегирующийКоэффициент,
	                      |	бит_КоэфицентыСпецификаций.РасходСУчетомПотерь КАК РасходСУчетомПотерь,
	                      |	бит_КоэфицентыСпецификаций.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	                      |ИЗ
	                      |	РегистрСведений.бит_КоэфицентыСпецификаций КАК бит_КоэфицентыСпецификаций
	                      |ГДЕ
	                      |	бит_КоэфицентыСпецификаций.РесурснаяСпецификация = &РесурснаяСпецификация
	                      |	И бит_КоэфицентыСпецификаций.Номенклатура = &Номенклатура");
	Запрос.УстановитьПараметр("РесурснаяСпецификация", ТекСпецификация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
