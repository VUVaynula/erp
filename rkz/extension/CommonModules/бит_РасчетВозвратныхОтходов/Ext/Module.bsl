Процедура ОбработатьДеревоОбъект(ДеревоОбъект, Знач Коэффициент, ТаблицаИтоговая)   
	// {{ПервыйБИТ ЛистТребований [ЛТ 1.3.4.1]  [VUVaynula@1cbit.ru] [02.03.2025 19:43:47] +
	
	Для каждого ТекСтрока Из ДеревоОбъект.Строки Цикл  
		Если Не ЗначениеЗаполнено(ТекСтрока.Спецификация)
			И ТекСтрока.ВидСтроки = Перечисления.ВидыСтрокДереваСпецификаций.Материал 
			И ТипЗнч(ТекСтрока.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(ТекСтрока.Номенклатура.бит_НоменклатураОтходов) Тогда
			
			Конструкт = 1;
			ОбщийРасход = 1;
			СтрокаАнализа = ТекСтрока;
			ТекСпецификация = ТекСтрока.Родитель.Спецификация;
			Пока Истина Цикл
				Если ТипЗнч(СтрокаАнализа.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
						СтрокаМатериала = ПолучитьСтрокуМатериалов(ТекСпецификация, СтрокаАнализа.Номенклатура);
						Если СтрокаМатериала <> Неопределено Тогда
							ТекКонструкт = СтрокаМатериала.КоличествоПозиций * СтрокаМатериала.КоэффициентУкрутки;
							ТекОбщийРасход = СтрокаМатериала.РасходСУчетомПотерь;
							Если ТекКонструкт <> 0 Тогда
								Конструкт = Конструкт * ТекКонструкт;
							КонецЕсли;
							Если ТекОбщийРасход <> 0 Тогда 
								ОбщийРасход = ОбщийРасход * ТекОбщийРасход;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;                            
					
				СтрокаАнализа = СтрокаАнализа.Родитель;
				Если СтрокаАнализа = Неопределено Тогда
					Прервать;
				КонецЕсли;                              
				Если СтрокаАнализа.Родитель <> Неопределено Тогда
					ТекСпецификация = СтрокаАнализа.Родитель.Спецификация;
				Иначе                                                    
					ТекСпецификация = СтрокаАнализа.Спецификация;
				КонецЕсли;
			КонецЦикла;
			Отход = (ОбщийРасход - Конструкт) * Коэффициент; 
				нов = ТаблицаИтоговая.Добавить(); 
				нов.Номенклатура = ТекСтрока.Номенклатура.бит_НоменклатураОтходов;
				нов.КоличествоУпаковокВсе = Отход;    
				нов.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ЕдиницаХраненияНоменклатуры(нов.Номенклатура);
		КонецЕсли; 
		ОбработатьДеревоОбъект(ТекСтрока, Коэффициент, ТаблицаИтоговая);
	КонецЦикла;    
	// }}ПервыйБИТ ЛистТребований [ЛТ 1.3.4.1]  [VUVaynula@1cbit.ru] [02.03.2025 19:43:47] -
