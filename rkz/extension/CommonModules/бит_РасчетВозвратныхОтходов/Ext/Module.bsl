Процедура ПодпискаПриЗаписиРесурснойСпецификации(РесурснаяСпецификацияСсылка) Экспорт
	
	Если РесурснаяСпецификацияСсылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	НЗ = РегистрыСведений.бит_КоэфицентыСпецификаций.СоздатьНаборЗаписей();
	НЗ.Отбор.РесурснаяСпецификация.Установить(РесурснаяСпецификацияСсылка);
	Если РесурснаяСпецификацияСсылка.ПометкаУдаления = Ложь Тогда  
		ОсновноеИзделиеНоменклатура 		= РесурснаяСпецификацияСсылка.ОсновноеИзделиеНоменклатура;    
		ОсновноеИзделиеУпаковка				= РесурснаяСпецификацияСсылка.ОсновноеИзделиеУпаковка;
		
		КоэффициентУпаковки = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(ОсновноеИзделиеУпаковка, ОсновноеИзделиеНоменклатура);  
		ОсновноеИзделиеКоличествоУпаковок 	= РесурснаяСпецификацияСсылка.ОсновноеИзделиеКоличествоУпаковок * КоэффициентУпаковки;
		ОсновноеИзделиеЕдиницаХранения = Справочники.УпаковкиЕдиницыИзмерения.ЕдиницаХраненияНоменклатуры(ОсновноеИзделиеНоменклатура);
		
		ТЧМатериалы = РесурснаяСпецификацияСсылка.МатериалыИУслуги.Выгрузить(); 
		Для каждого стр из ТЧМатериалы Цикл  
			запись = НЗ.Добавить();
			запись.ИДСтроки 				= стр.НомерСтроки;
			Запись.РесурснаяСпецификация	= РесурснаяСпецификацияСсылка;
			запись.НоменклатураРодитель 	= ОсновноеИзделиеНоменклатура; 
			запись.КоличествоРодитель 		= 1; // ОсновноеИзделиеКоличествоУпаковок;
			запись.ЕдиницаИзмеренияРодитель = ОсновноеИзделиеЕдиницаХранения;
			
			Номенклатура 		= стр.Номенклатура;
			ЕдиницаХранения 	= Справочники.УпаковкиЕдиницыИзмерения.ЕдиницаХраненияНоменклатуры(Номенклатура);
			КоэффициентУпаковки = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(стр.Упаковка, Номенклатура);  
			
			запись.Номенклатура 			= Номенклатура;  
			запись.ЕдиницаИзмерения 		= ЕдиницаХранения;
			
			запись.КоличествоПозиций 		= (стр.бит_КоличествоПозиции * КоэффициентУпаковки) / ОсновноеИзделиеКоличествоУпаковок; 
			запись.КоэффициентУкрутки 		= стр.бит_КоэффициентУкрутки;
			запись.ТехОтходПроцент 			= стр.бит_ТехнологическийОтход;
			запись.АгрегирующийКоэффициент 	= стр.бит_АгрегирующийКоэффициент;
			запись.РасходСУчетомПотерь 		= (стр.КоличествоУпаковок * КоэффициентУпаковки) / ОсновноеИзделиеКоличествоУпаковок; 
			
		 	запись.ЕдиницаИзмерения 		= ЕдиницаХранения;   
		КонецЦикла;
		НЗ.Записать(); 
	Иначе
		//НЗ.Прочитать();
			НЗ.Записать();
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

