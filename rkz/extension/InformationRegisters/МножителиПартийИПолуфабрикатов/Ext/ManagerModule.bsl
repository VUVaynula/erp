Функция бит_ПризнакРасчетаАгрегирующегоК(Номенклатура);

	СписокПризнаков = Справочники.бит_ЗначенияПоУмолчанию.ПризнакиДляРасчетаАгрегКоэффициента.Значения;
	ПризнакРасчетаАгрегирующегоК = Новый Массив;
	Для Каждого Признак Из СписокПризнаков Цикл
		ПризнакРасчетаАгрегирующегоК.Добавить(Признак.Значение);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК бит_Значение
		|ИЗ
		|	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
		|ГДЕ
		|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
		|	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак В(&СписокПризнаков)";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СписокПризнаков", ПризнакРасчетаАгрегирующегоК);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий(); 
		Возврат ВыборкаДетальныеЗаписи.бит_Значение; 
	КонецЕсли;
	
