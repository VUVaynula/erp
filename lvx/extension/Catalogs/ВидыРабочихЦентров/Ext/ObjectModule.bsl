// {{ПервыйБИТ ЛистТребований [ЛТ6.9] [Микляев К.А.] [03.06.2026] +
&Перед("ПередЗаписью")
Процедура бит_ПередЗаписью(Отказ)
	
	Если Не ЭтоГруппа
		И ПустаяСтрока(бит_КодВРЦ) Тогда
		бит_КодВРЦ = бит_НовыйКодВРЦ();
	КонецЕсли;
	
КонецПроцедуры

Функция бит_НовыйКодВРЦ()
	
	НовыйНомер = бит_МаксимальныйКодВРЦ() + 1;
	Если НовыйНомер > 999999 Тогда
		ВызватьИсключение "Не удалось сформировать новый (бит) Код ВРЦ: превышена длина 6 символов.";
	КонецЕсли;
	
	Возврат Формат(НовыйНомер, "ЧЦ=6; ЧВН=; ЧГ=0");
	
КонецФункции

Функция бит_МаксимальныйКодВРЦ()
	
	МаксимальныйКод = 0;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВидыРабочихЦентров.бит_КодВРЦ КАК Код
	|ИЗ
	|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
	|ГДЕ
	|	НЕ ВидыРабочихЦентров.ПометкаУдаления
	|	И НЕ ВидыРабочихЦентров.ЭтоГруппа
	|	И ВидыРабочихЦентров.бит_КодВРЦ <> """"");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодСтрокой = СокрЛП(Выборка.Код);
		Если Не бит_СтрокаСодержитТолькоЦифры(КодСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		
		МаксимальныйКод = Макс(МаксимальныйКод, Число(КодСтрокой));
	КонецЦикла;
	
	Возврат МаксимальныйКод;
	
КонецФункции

Функция бит_СтрокаСодержитТолькоЦифры(Знач СтрокаКода)
	
	Если ПустаяСтрока(СтрокаКода) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По СтрДлина(СтрокаКода) Цикл
		СимволКода = Сред(СтрокаКода, НомерСимвола, 1);
		Если СтрНайти("0123456789", СимволКода) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
