&НаСервере
Процедура бит_ДобавитьКолонкуКодаВРЦ()
	
	Если Элементы.Найти("бит_КодВРЦ") <> Неопределено
		Или Элементы.Найти("Список") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяКолонка = Элементы.Добавить("бит_КодВРЦ", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = "Список.бит_КодВРЦ";
	НоваяКолонка.Заголовок = "(бит) Код ВРЦ";
	НоваяКолонка.ТолькоПросмотр = Истина;
	
КонецПроцедуры
