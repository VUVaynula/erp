// {{ПервыйБИТ ЛистТребований [ЛТ6.9] [Микляев К.А.] [03.06.2026] +
&Перед("ПередЗаписью")
Процедура бит_ПередЗаписью(Отказ)
	
	Если ПустаяСтрока(бит_КодНазначения) Тогда
		бит_КодНазначения = бит_НовыйКодНазначения();
	КонецЕсли;
	
КонецПроцедуры

Функция бит_НовыйКодНазначения()
	
	НовыйНомер = бит_МаксимальныйКодНазначения() + 1;
	Если НовыйНомер > 999999 Тогда
		ВызватьИсключение "Не удалось сформировать новый (бит) Код назначения: превышена длина 6 символов.";
	КонецЕсли;
	
	Возврат Формат(НовыйНомер, "ЧЦ=6; ЧВН=; ЧГ=0");
	
КонецФункции

Функция бит_МаксимальныйКодНазначения()
	
	МаксимальныйКод = 0;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Назначения.бит_КодНазначения КАК Код
	|ИЗ
	|	Справочник.Назначения КАК Назначения
	|ГДЕ
	|	НЕ Назначения.ПометкаУдаления
	|	И Назначения.бит_КодНазначения <> """"");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодСтрокой = СокрЛП(Выборка.Код);
		Если Не бит_СтрокаСодержитТолькоЦифры(КодСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		
		МаксимальныйКод = Макс(МаксимальныйКод, Число(КодСтрокой));
	КонецЦикла;
	
	Возврат МаксимальныйКод;
	
КонецФункции

Функция бит_СтрокаСодержитТолькоЦифры(Знач СтрокаКода)
	
	Если ПустаяСтрока(СтрокаКода) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По СтрДлина(СтрокаКода) Цикл
		СимволКода = Сред(СтрокаКода, НомерСимвола, 1);
		Если СтрНайти("0123456789", СимволКода) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
