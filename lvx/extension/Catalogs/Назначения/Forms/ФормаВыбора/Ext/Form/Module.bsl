&НаСервере
Процедура бит_ДобавитьКолонкуКодаНазначения()
	
	Если Элементы.Найти("бит_КодНазначения") <> Неопределено
		Или Элементы.Найти("Список") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяКолонка = Элементы.Добавить("бит_КодНазначения", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = "Список.бит_КодНазначения";
	НоваяКолонка.Заголовок = "(бит) Код назначения";
	НоваяКолонка.ТолькоПросмотр = Истина;
	
КонецПроцедуры
