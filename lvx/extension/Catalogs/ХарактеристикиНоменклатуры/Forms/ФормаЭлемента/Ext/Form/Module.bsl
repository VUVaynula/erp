&НаСервере
Функция глСпИзСтроки(ВхСтрока, ВхРазделитель = ",", ВхОписаниеТипаЗначенийСписка = Неопределено) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] + 
	
	// сформируем список значений
	_СписокЗначений  = Новый СписокЗначений;
	_ОстСтр = СокрЛП(ВхСтрока);

	_ДлинаРазделителя = СтрДлина(ВхРазделитель);
	
	Пока НЕ ПустаяСтрока(_ОстСтр) Цикл
		
		_Поз = Найти(_ОстСтр, ВхРазделитель); 
		Если _Поз = 0 Тогда
			_Элем   = _ОстСтр;
			_ОстСтр = "";
		Иначе
			_Элем   = Лев(_ОстСтр,  _Поз-1);
			_ОстСтр = Сред(_ОстСтр, _Поз + _ДлинаРазделителя);
		КонецЕсли;	
		
		_СписокЗначений.Добавить(СокрЛП(_Элем));
		
	КонецЦикла;
	
	Если ВхОписаниеТипаЗначенийСписка = Неопределено Тогда
	ИначеЕсли Лев(ВхОписаниеТипаЗначенийСписка, 13) = "Перечисление." Тогда
		
		_ИмяПеречисления = Сред(ВхОписаниеТипаЗначенийСписка, 14);
		Для Каждого _Элемент Из _СписокЗначений Цикл
			_Элемент.Значение = Перечисления[_ИмяПеречисления][_Элемент.Значение];
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение("глСпИзСтроки(): неподддерживаемое значение ВхОписаниеТипаЗначенийСписка - <" + ВхОписаниеТипаЗначенийСписка + ">");
		
