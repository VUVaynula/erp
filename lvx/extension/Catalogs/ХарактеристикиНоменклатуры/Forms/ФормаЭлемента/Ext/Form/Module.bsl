&НаСервере
Функция глПустоеЗначение(ВхЗначение) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] + 
	
	// Сначала примитивные типы
	Если ВхЗначение = NULL 
		Тогда
		
		Возврат Истина;
		
	КонецЕсли;	

	ТипЗначения = ТипЗнч(ВхЗначение);

	Если ТипЗначения = Тип("Неопределено") Тогда
		
		Возврат ВхЗначение = Неопределено;
		
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		
		Возврат ПустаяСтрока(ВхЗначение);
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		
		Возврат ВхЗначение = 0;
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		
		Возврат Ложь; // Булево будем считать не пустым
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		
		Возврат ВхЗначение = '00010101'
			ИЛИ ВхЗначение = '00010101000000'; 
		
	ИначеЕсли ТипЗначения = Тип("СписокЗначений")
		ИЛИ ТипЗначения = Тип("Массив")
		ИЛИ ТипЗначения = Тип("ТаблицаЗначений")
		ИЛИ ТипЗначения = Тип("Структура")
		Тогда
		
		Возврат ВхЗначение.Количество() = 0;
		
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("РежимПроведенияДокумента") Тогда
	
		Возврат НЕ ВхЗначение = РежимПроведенияДокумента.Неоперативный
				И НЕ ВхЗначение = РежимПроведенияДокумента.Оперативный;
		
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("СтрокаДереваЗначений")
			ИЛИ ТипЗначения = Тип("СтрокаТаблицыЗначений")
			Тогда
			
			Возврат Ложь;
			
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("МоментВремени")
			Тогда
			
			
			Возврат глПустоеЗначение(ВхЗначение.Дата) И глПустоеЗначение(ВхЗначение.Ссылка);
			
	// Для остальных будем считать значение пустым, если оно равно
	// дефолтному значению своего типа
	Иначе
		
		Попытка
			
			Возврат ВхЗначение = Новый(ТипЗначения);
			
		Исключение
			
			Возврат Ложь;
			
		КонецПопытки;
		
	КонецЕсли; 
	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] -
	
