
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// {{ПервыйБИТ ЛистТребований [ЛТЛТ6.2] [ASHolyavko@1cbit.ru] [02.04.2026] +        
	
	Если Параметры.Ключ.Пустая() Тогда
		
		РеквизитХарактеристикиПризнакЗаказногоИзделия = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("РеквизитХарактеристикиПризнакЗаказногоИзделия", ЭтаФорма, Истина);
		ЗначениеСтандартногоПризнакаИзделия = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("ЗначениеСтандартногоПризнакаИзделия", ЭтаФорма, Истина);
		
		СтруктураОтбор = Новый Структура;
		СтруктураОтбор.Вставить("Свойство", РеквизитХарактеристикиПризнакЗаказногоИзделия);
		
		НайденныеСтроки = ТаблицаНастроекРеквизитов.НайтиСтроки(СтруктураОтбор);
		
		Если НайденныеСтроки.Количество() <> 0  Тогда
			
			НайденыйРеквизит = НайденныеСтроки[0].ПутьКДанным;
			
			ЭтотОбъект[НайденыйРеквизит] = ЗначениеСтандартногоПризнакаИзделия;
			
		КонецЕсли;
		
	КонецЕсли;
		
	//Добавим обработчики для доп реквизитов
	//НовыйЭлемент.УстановитьДействие("ПриИзменении", "Товары_бит_РеквизитТаблицыПриИзменении");
	//НачалоВыбора
	
	СтруктураОтбор = Новый Структура;
	СтруктураОтбор.Вставить("ЭтоДопРеквизит", Истина);
	
	НайденныеСтроки = ТаблицаНастроекРеквизитов.НайтиСтроки(СтруктураОтбор);
	
	Для Каждого ДопРеквизит Из НайденныеСтроки Цикл
		
		//ЭтаФорма[ТаблицаНастроекРеквизитов[6].ПутьКДАнным]
		
		Элементы[ДопРеквизит.ПутьКДанным].УстановитьДействие("НачалоВыбора", "допРеквизитыНачалоВыбора");	
		Элементы[ДопРеквизит.ПутьКДанным].ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
		Элементы[ДопРеквизит.ПутьКДанным].КнопкаВыпадающегоСписка = Ложь;
		Элементы[ДопРеквизит.ПутьКДанным].ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
		//Элементы[].УстановитьДействие("НачалоВыбора", "допРеквизитыНачалоВыбора");
		
	КонецЦикла;		 	
	
	// }}ПервыйБИТ ЛистТребований [ЛТЛТ6.2] [ASHolyavko@1cbit.ru] [02.04.2026] -
	
КонецПроцедуры

