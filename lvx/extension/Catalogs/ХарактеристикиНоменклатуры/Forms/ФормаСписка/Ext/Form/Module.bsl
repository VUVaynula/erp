
// {{ПервыйБИТ Лист требований [ЛТ6.8] [Микляев К.А.] [14.07.2026] +
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Если Элементы.Найти("бит_КодХарактеристики") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Список построен на произвольном запросе, поэтому поле сначала добавляется в запрос,
	// иначе колонка с таким путем к данным недопустима.
	Если Не бит_ДобавитьПолеВЗапросСписка() Тогда
		Возврат;
	КонецЕсли;

	НоваяКолонка = Элементы.Добавить("бит_КодХарактеристики", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеНадписи;
	НоваяКолонка.ПутьКДанным = "Список.бит_КодХарактеристики";
	НоваяКолонка.Заголовок = "Код характеристики";

КонецПроцедуры

&НаСервере
Функция бит_ДобавитьПолеВЗапросСписка()

	Если ПустаяСтрока(Список.ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(Список.ТекстЗапроса);

		ЗапросСхемы = Схема.ПакетЗапросов[0];

		Для Каждого Оператор Из ЗапросСхемы.Операторы Цикл
			ПсевдонимИсточника = Оператор.Источники[0].Источник.Псевдоним;
			Оператор.ВыбираемыеПоля.Добавить(ПсевдонимИсточника + ".бит_КодХарактеристики");
		КонецЦикла;

		ЗапросСхемы.Колонки[ЗапросСхемы.Колонки.Количество() - 1].Псевдоним = "бит_КодХарактеристики";

		Список.ТекстЗапроса = Схема.ПолучитьТекстЗапроса();
	Исключение
		ЗаписьЖурналаРегистрации("Печать этикеток ГП (ЛТ6.8)",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось добавить код характеристики в запрос списка: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции
