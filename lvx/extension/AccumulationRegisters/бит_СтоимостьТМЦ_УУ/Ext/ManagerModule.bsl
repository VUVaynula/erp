	Запрос.УстановитьПараметр("ТаблицаСтоимостиНоменклатуры", ТаблицаСтоимостиНоменклатуры);
	
	ТаблицаДвижений_СтоимостьТМЦ_УУ = Запрос.Выполнить().Выгрузить();
	
	//Возврат ТаблицаДвижений_СтоимостьТМЦ_УУ;
	
