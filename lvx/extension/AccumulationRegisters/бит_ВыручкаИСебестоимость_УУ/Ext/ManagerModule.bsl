		|			ПО (ПорядокОтраженияНаСчетахУчета.СчетУчета = бит_СоответствияАналитик.ЛеваяАналитика_1
		|					И бит_СоответствияАналитик.ВидСоответствия = &СоответствиеАналитикСчетаУчета)
		|		ПО вт_ТаблицаДвижений.Номенклатура.Номенклатура.ГруппаФинансовогоУчета = ПорядокОтраженияНаСчетахУчета.АналитикаУчета
		|			И (ПорядокОтраженияНаСчетахУчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НаСкладе))";
	
	Запрос.УстановитьПараметр("ТаблицаДвижений_ВыручкаИСебестоимость_УУ", ТаблицаДвижений_ВыручкаИСебестоимость_УУ);
	Запрос.УстановитьПараметр("СоответствиеАналитикСчетаУчета", СоответствиеАналитикСчетаУчета);
	
	ТаблицаДвижений_ВыручкаИСебестоимость_УУ = Запрос.Выполнить().Выгрузить();
		
КонецПроцедуры		
