Функция ПолучитьТаблицуДляДвижений() Экспорт
	
	КвалификаторыСтроки = Новый КвалификаторыСтроки(150);
	ОписаниеСтроки = Новый ОписаниеТипов("Строка", ,КвалификаторыСтроки);
	
	МассивТиповЗаказКлиента = Новый Массив;
	МассивТиповЗаказКлиента.Добавить(Тип("ДокументСсылка.ПеремещениеТоваров"));
	МассивТиповЗаказКлиента.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	МассивТиповЗаказКлиента.Добавить(Тип("ДокументСсылка.ЗаказКлиента"));
	
	ОписаниеЗаказКлиента = Новый ОписаниеТипов(МассивТиповЗаказКлиента);
		
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаЗначений.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаЗначений.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиУчетаНоменклатуры"));
	ТаблицаЗначений.Колонки.Добавить("КорНоменклатура", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиУчетаНоменклатуры"));
	ТаблицаЗначений.Колонки.Добавить("ЗаказКлиента", ОписаниеЗаказКлиента);
	ТаблицаЗначений.Колонки.Добавить("Покупатель", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));	
	ТаблицаЗначений.Колонки.Добавить("Партия", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДокументПартии.Тип));
	ТаблицаЗначений.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаЗначений.Колонки.Добавить("ТипРеализации", Новый ОписаниеТипов("ПеречислениеСсылка.бит_ТипыРеализаций"));
	ТаблицаЗначений.Колонки.Добавить("Менеджер", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаЗначений.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаЗначений.Колонки.Добавить("Соглашение", Новый ОписаниеТипов("СправочникСсылка.СоглашенияСКлиентами"));
	ТаблицаЗначений.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаЗначений.Колонки.Добавить("ХозяйственнаяОперация", Новый ОписаниеТипов("ПеречислениеСсылка.ХозяйственныеОперации"));
	ТаблицаЗначений.Колонки.Добавить("ВидСкидки", Новый ОписаниеТипов("СправочникСсылка.СкидкиНаценки"));
	ТаблицаЗначений.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	ТаблицаЗначений.Колонки.Добавить("СуммаВыручки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));		
	ТаблицаЗначений.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаЗначений.Колонки.Добавить("СуммаСкидки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаЗначений.Колонки.Добавить("ДополнительныеРасходы", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаЗначений.Колонки.Добавить("ДатаНазначения", Новый ОписаниеТипов("Дата"));
	ТаблицаЗначений.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));

	Возврат ТаблицаЗначений;
	
КонецФункции

Процедура ЗаполнитьТаблицуДвижений(ТаблицаДвижений_ВыручкаИСебестоимость_УУ, ТаблицаДвижений_СебестоимостьТоваров, Склад = Неопределено, ПодразделениеЦФО = Неопределено, ЦФОКонтрагент = Неопределено, Менеджер = Неопределено, Соглашение = Неопределено, Договор = Неопределено, Дата) Экспорт
	
	Для Каждого СтрокаСебестоимостьТоваров Из ТаблицаДвижений_СебестоимостьТоваров Цикл
		
		Если СтрокаСебестоимостьТоваров.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			
			Строка_ВыручкаИСебестоимость_УУ = ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Добавить();
			ЗаполнитьЗначенияСвойств(Строка_ВыручкаИСебестоимость_УУ, СтрокаСебестоимостьТоваров, ,"ЗаказКлиента");
			
			Строка_ВыручкаИСебестоимость_УУ.Номенклатура = СтрокаСебестоимостьТоваров.АналитикаУчетаНоменклатуры;
			
			Если СтрокаСебестоимостьТоваров.ВидДвижения = ВидДвиженияНакопления.Расход Тогда 
				Строка_ВыручкаИСебестоимость_УУ.КорНоменклатура = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры;
			КонецЕсли;
			
			Строка_ВыручкаИСебестоимость_УУ.Покупатель = ЦФОКонтрагент;		
			Если ЗначениеЗаполнено(ПодразделениеЦФО) Тогда
				Строка_ВыручкаИСебестоимость_УУ.Подразделение = ПодразделениеЦФО;
			Иначе	                                                            
				ПодразделениеЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СтрокаСебестоимостьТоваров.АналитикаУчетаНоменклатуры.СкладскаяТерритория.Подразделение, Дата); 
				Строка_ВыручкаИСебестоимость_УУ.Подразделение = ПодразделениеЦФО;
			КонецЕсли;
			Строка_ВыручкаИСебестоимость_УУ.ТипРеализации = Перечисления.бит_ТипыРеализаций.ВнешняяРеализация;
			Строка_ВыручкаИСебестоимость_УУ.Менеджер = Менеджер;//СтрокаСебестоимостьТоваров.Регистратор.Ответственный;
			
			Если ЗначениеЗаполнено(Склад) Тогда
				Строка_ВыручкаИСебестоимость_УУ.Склад = Склад;
			Иначе	
				Строка_ВыручкаИСебестоимость_УУ.Склад = СтрокаСебестоимостьТоваров.АналитикаУчетаНоменклатуры.СкладскаяТерритория;
			КонецЕсли;
		
			Строка_ВыручкаИСебестоимость_УУ.Соглашение = Соглашение;
			Строка_ВыручкаИСебестоимость_УУ.Договор = Договор;	
			Если ЗначениеЗаполнено(СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ) 
				И ТипЗнч(СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
							
				Строка_ВыручкаИСебестоимость_УУ.ЗаказКлиента = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ;
				//Строка_ВыручкаИСебестоимость_УУ.Соглашение = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.Соглашение;	
				//Строка_ВыручкаИСебестоимость_УУ.Договор = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.Договор;			
				Строка_ВыручкаИСебестоимость_УУ.ДатаНазначения = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.Дата;
				
			ИначеЕсли ЗначениеЗаполнено(СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ)
				И ЗначениеЗаполнено(СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.ДокументОснование) Тогда
				Строка_ВыручкаИСебестоимость_УУ.ЗаказКлиента = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.ДокументОснование;
				//Строка_ВыручкаИСебестоимость_УУ.Соглашение = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.ДокументОснование.Соглашение;	
				//Строка_ВыручкаИСебестоимость_УУ.Договор = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.ДокументОснование.Договор;			
				Строка_ВыручкаИСебестоимость_УУ.ДатаНазначения = СтрокаСебестоимостьТоваров.КорАналитикаУчетаНоменклатуры.Назначение.Заказ.ДокументОснование.Дата;
			Иначе
				Строка_ВыручкаИСебестоимость_УУ.ЗаказКлиента = СтрокаСебестоимостьТоваров.ЗаказКлиента;
				Если ЗначениеЗаполнено(Строка_ВыручкаИСебестоимость_УУ.Партия) Тогда 
					Строка_ВыручкаИСебестоимость_УУ.ДатаНазначения = Строка_ВыручкаИСебестоимость_УУ.Партия.Дата;
				Иначе     
					Строка_ВыручкаИСебестоимость_УУ.ДатаНазначения = Строка_ВыручкаИСебестоимость_УУ.Период;
				КонецЕсли;		
			КонецЕсли;
			
			Строка_ВыручкаИСебестоимость_УУ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
			
		КонецЕсли;
		
	КонецЦикла;   
		                                                                                 
	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Свернуть("Период, Организация, Номенклатура, КорНоменклатура, ЗаказКлиента, Покупатель, Партия, Подразделение, ТипРеализации, Менеджер, Склад, Соглашение, Договор, ХозяйственнаяОперация, ВидСкидки, ДатаНазначения, ДатаПартии"
		, "Количество, СуммаВыручки, Стоимость, СуммаСкидки, ДополнительныеРасходы");
	
КонецПроцедуры		

Процедура ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_ВыручкаИСебестоимость_УУ, ТаблицаСтоимостиНоменклатурыПартии, ТаблицаСтоимостиНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Период КАК Период,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Организация КАК Организация,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Номенклатура КАК Номенклатура,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.ЗаказКлиента КАК ЗаказКлиента,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Покупатель КАК Покупатель,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Партия КАК Партия,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Подразделение КАК Подразделение,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.ТипРеализации КАК ТипРеализации,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Менеджер КАК Менеджер,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Склад КАК Склад,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Соглашение КАК Соглашение,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Договор КАК Договор,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.ВидСкидки КАК ВидСкидки,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Количество КАК Количество,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.СуммаВыручки КАК СуммаВыручки,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.Стоимость КАК Стоимость,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.СуммаСкидки КАК СуммаСкидки,
		|	ТаблицаДвижений_ВыручкаИСебестоимость_УУ.ДополнительныеРасходы КАК ДополнительныеРасходы
		|ПОМЕСТИТЬ вт_ТаблицаДвижений
		|ИЗ
		|	&ТаблицаДвижений_ВыручкаИСебестоимость_УУ КАК ТаблицаДвижений_ВыручкаИСебестоимость_УУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаСтоимостиНоменклатурыПартии.Номенклатура КАК Номенклатура,
		|	ТаблицаСтоимостиНоменклатурыПартии.Организация КАК Организация,
		|	ТаблицаСтоимостиНоменклатурыПартии.Партия КАК Партия,
		|	ТаблицаСтоимостиНоменклатурыПартии.Подразделение КАК Подразделение,
		|	ТаблицаСтоимостиНоменклатурыПартии.Склад КАК Склад,
		|	ТаблицаСтоимостиНоменклатурыПартии.Цена КАК Цена
		|ПОМЕСТИТЬ вт_ТаблицаСтоимостиПартии
		|ИЗ
		|	&ТаблицаСтоимостиНоменклатурыПартии КАК ТаблицаСтоимостиНоменклатурыПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаСтоимостиНоменклатуры.Номенклатура КАК Номенклатура,
		|	ТаблицаСтоимостиНоменклатуры.Организация КАК Организация,
		|	ТаблицаСтоимостиНоменклатуры.Партия КАК Партия,
		|	ТаблицаСтоимостиНоменклатуры.Подразделение КАК Подразделение,
		|	ТаблицаСтоимостиНоменклатуры.Склад КАК Склад,
		|	ТаблицаСтоимостиНоменклатуры.Цена КАК Цена
		|ПОМЕСТИТЬ вт_ТаблицаСтоимостиВидЦены
		|ИЗ
		|	&ТаблицаСтоимостиНоменклатуры КАК ТаблицаСтоимостиНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТаблицаДвижений.Период КАК Период,
		|	вт_ТаблицаДвижений.Организация КАК Организация,
		|	вт_ТаблицаДвижений.Номенклатура КАК Номенклатура,
		|	вт_ТаблицаДвижений.ЗаказКлиента КАК ЗаказКлиента,
		|	вт_ТаблицаДвижений.Покупатель КАК Покупатель,
		|	вт_ТаблицаДвижений.Партия КАК Партия,
		|	вт_ТаблицаДвижений.Подразделение КАК Подразделение,
		|	вт_ТаблицаДвижений.ТипРеализации КАК ТипРеализации,
		|	вт_ТаблицаДвижений.Менеджер КАК Менеджер,
		|	вт_ТаблицаДвижений.Склад КАК Склад,
		|	вт_ТаблицаДвижений.Соглашение КАК Соглашение,
		|	вт_ТаблицаДвижений.Договор КАК Договор,
		|	вт_ТаблицаДвижений.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	вт_ТаблицаДвижений.ВидСкидки КАК ВидСкидки,
		|	вт_ТаблицаДвижений.Количество КАК Количество,
		|	вт_ТаблицаДвижений.Количество * ЕСТЬNULL(вт_ТаблицаСтоимостиВидЦены.Цена, 0) КАК СуммаВыручки,
		|	вт_ТаблицаДвижений.Количество * ЕСТЬNULL(вт_ТаблицаСтоимостиПартии.Цена, 0) КАК Стоимость,
		|	вт_ТаблицаДвижений.СуммаСкидки КАК СуммаСкидки,
		|	вт_ТаблицаДвижений.ДополнительныеРасходы КАК ДополнительныеРасходы
		|ИЗ
		|	вт_ТаблицаДвижений КАК вт_ТаблицаДвижений
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ТаблицаСтоимостиПартии КАК вт_ТаблицаСтоимостиПартии
		|		ПО вт_ТаблицаДвижений.Номенклатура = вт_ТаблицаСтоимостиПартии.Номенклатура
		|			И вт_ТаблицаДвижений.Партия = вт_ТаблицаСтоимостиПартии.Партия
		|			И вт_ТаблицаДвижений.Подразделение = вт_ТаблицаСтоимостиПартии.Подразделение
		|			И вт_ТаблицаДвижений.Склад = вт_ТаблицаСтоимостиПартии.Склад
		|			И вт_ТаблицаДвижений.Организация = вт_ТаблицаСтоимостиПартии.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ТаблицаСтоимостиВидЦены КАК вт_ТаблицаСтоимостиВидЦены
		|		ПО вт_ТаблицаДвижений.Номенклатура = вт_ТаблицаСтоимостиВидЦены.Номенклатура
		|			И вт_ТаблицаДвижений.Партия = вт_ТаблицаСтоимостиВидЦены.Партия
