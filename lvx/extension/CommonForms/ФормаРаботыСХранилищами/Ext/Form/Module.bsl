&НаКлиенте
Процедура СоздатьНовуюБазуЗавершение(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ПараметрыКоманды =  " /AddInList " + БазаПриемник;
		
		ВыполняемаяКоманда = СтруктураПараметровКоманднойСтроки.КаталогПрограммы +
		
		" CREATEINFOBASE" + 
		" Srvr=""" + АдресСервера + 
		""";Ref=""" + БазаПриемник + 
		""";DBMS=""" + "MSSQLServer" + 
		""";DBSrvr=""" + АдресСервера + 
		""";DB=""" + БазаПриемник +    
		""";DBUID=""" + ИмяПользователяSQL + 
		""";DBPwd=""" + ПарольПользователяSQL + 	
		//SQLYOffs=2000
		""";SQLYOffs=""" + ?(1 = 1, "2000", "0") +	
		""";CrSQLDB=""" + ?(1 = 1, "Y", "N") + 
		//LicDstr=Y
		""";LicDstr=""" + ?(1 = 1, "Y", "N") +	
		""";SchJobDn=""" + ?(1 = 1, "Y", "N") + 	
		""";" + ПараметрыКоманды;
		
		КодВозврата = Неопределено;
		
		ТекстКоманды = ВыполняемаяКоманда;
		
		ЗапуститьПриложение(ВыполняемаяКоманда, , Истина, КодВозврата);
		
		Если КодВозврата = 0 Тогда
			ОчиститьСообщения();
			Сообщить("Создана новая база!");
		ИначеЕсли КодВозврата = 1 Тогда	
			ОчиститьСообщения();
			Сообщить("Не удалось создать новую базу!");
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры


