&НаКлиенте
Процедура СоздатьКопиюБазы(Команда)
	
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(БазаПриемник) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Поле = "БазаПриемник"; 
		СообщениеПользователю.Текст = "Не заполнено имя базы приемника.";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Поле = "АдресСервера"; 
		СообщениеПользователю.Текст = "Не заполнен адрес сервера.";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КаталогБекапов) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Поле = "КаталогБекапов"; 
		СообщениеПользователю.Текст = "Не заполнен каталог бекапов.";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяПользователяSQL) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Поле = "КаталогБекапов"; 
		СообщениеПользователю.Текст = "Не заполнено имя пользователя.";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПарольПользователяSQL) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Поле = "ПарольПользователя"; 
		СообщениеПользователю.Текст = "Не заполнен пароль пользователя.";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьКопиюЗавершение", ЭтотОбъект, Неопределено); 
		ПоказатьВопрос(ОписаниеОповещения, 
		"Вы действительно хотите скопировать базу " + БазаИсточник + " в базу " + БазаПриемник + "?", 
		РежимДиалогаВопрос.ДаНет);					
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКопиюЗавершение(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Адрес = ПолучитьДанныеМакета();
		МакетSQL = ПолучитьИзВременногоХранилища(Адрес);
		ФайлВыполненияSQL = ПолучитьИмяВременногоФайла("exe");
		МакетSQL.Записать(ФайлВыполненияSQL);
		
		Адрес = ПолучитьСкрипт();
		МакетСкрипта = ПолучитьИзВременногоХранилища(Адрес);
		ФайлСкриптаSQL = ПолучитьИмяВременногоФайла("sql");
		МакетСкрипта.Записать(ФайлСкриптаSQL);
		
		КоманднаяСтрока = ФайлВыполненияSQL + " -S " + АдресСервера + " -U " + ИмяПользователяSQL + " -P " + ПарольПользователяSQL + " -i " + ФайлСкриптаSQL;
		
		РезультатВыполнения = Неопределено;	
		ЗапуститьПриложение(КоманднаяСтрока, , Истина, РезультатВыполнения);
		
		УдалитьФайлы(ФайлВыполненияSQL);
		УдалитьФайлы(ФайлСкриптаSQL);
		
		Если РезультатВыполнения = 0 Тогда
		
			Сообщить("Копирование выполнено!");	
			
		Иначе
			
			Сообщить("Не удалось скопировать базу!");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере                    
Функция ПолучитьДанныеМакета()
	
	АдресХранилища = Новый УникальныйИдентификатор();
	
	//Обработка =  РеквизитФормыВЗначение("Объект");
	Макет = ПолучитьОбщийМакет("sqlcmd");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("exe"); 
	Макет.Записать(ВременныйФайл);
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВременныйФайл), АдресХранилища); 
	УдалитьФайлы(ВременныйФайл); 
	
	Возврат Адрес; 
	
КонецФункции

&НаСервере                    
Функция ПолучитьСкрипт()
	
	АдресХранилища = Новый УникальныйИдентификатор();
	
	//Обработка =  РеквизитФормыВЗначение("Объект");
	Макет = ПолучитьОбщийМакет("СкриптSQL_СозданиеИсточник_Приемник");
	
	ТекстСкрипта = Макет.ПолучитьТекст();
	ТекстСкрипта = СтрЗаменить(ТекстСкрипта, "###БазаИсточник###", БазаИсточник);
	ТекстСкрипта = СтрЗаменить(ТекстСкрипта, "###БазаПриемник###", БазаПриемник);
	ТекстСкрипта = СтрЗаменить(ТекстСкрипта, "###КаталогБекапов###", КаталогБекапов);
	Макет.Очистить();
	Макет.УстановитьТекст(ТекстСкрипта);
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("txt"); 
	Макет.Записать(ВременныйФайл);
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВременныйФайл), АдресХранилища); 
	УдалитьФайлы(ВременныйФайл); 
	
	Возврат Адрес; 
	
КонецФункции

