&НаКлиенте
Функция ПутьКБазеДанных(Стр) Экспорт 
	Возврат " /S " + Стр.Srvr + "\" + Стр.BaseName;
КонецФункции

&НаКлиенте
Функция ПользовательПароль()
	Возврат N() + P();
КонецФункции

// */N<имя>		
//Параметр задает имя пользователя. Должно быть указано так же, как в списке пользователей информационной базы. Если в базе данных список пользователей не ведется, данный ключ игнорируется. Если такого пользователя нет в списке пользователей, будет выдано окно авторизации доступа. Если в имени пользователя есть пробел, то значение параметра необходимо взять в кавычки.
//Пример: /N"Иванов Иван"
&НаКлиенте
Функция N() Экспорт 
	Если ЗначениеЗаполнено(ПользовательИБ) Тогда
		Возврат " /N " + "" + ПользовательИБ + "";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

// */P<пароль>		
//Параметр задает пароль пользователя. Если ключ /N не указан или в базе не ведется список пользователей, данный ключ игнорируется. Если пароль пользователя указан неверно, будет выдано окно авторизации доступа. Если в пароле есть пробел, то значение параметра необходимо взять в кавычки.
//Пример: /P"Parol 123"
&НаКлиенте
Функция P() Экспорт 
	Если ЗначениеЗаполнено(ПарольИБ) Тогда
		Возврат " /P " + "" + ПарольИБ + "";
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции


&НаКлиенте          
Функция DisableStartupDialogs(Стр) Экспорт 	
	//Если ЗначениеЗаполнено(Стр.User) Тогда	
	Если DisableStartupDialogs Тогда
		Возврат " /DisableStartupDialogs";
	Иначе 
		Возврат "";
	КонецЕсли;
КонецФункции


