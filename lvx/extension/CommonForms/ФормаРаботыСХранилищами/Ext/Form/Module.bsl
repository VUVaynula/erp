
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КаталогБекапов = "D:\MSSQL\Backup\";
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	Позиция = СтрНайти(СтрокаСоединения, "Ref");
	
	ИмяБазы = Сред(СтрокаСоединения, Позиция + 4);
	
	ИмяБазы = СтрЗаменить(ИмяБазы, ";", "");
	
	ИмяБазы = СтрЗаменить(ИмяБазы, """", "");
	
	БазаИсточник = ИмяБазы;
	НовыйПользовательХранилищаОсн = ИмяБазы;
	НовыйПользовательХранилищаРас = ИмяБазы;
	
	УстановитьОтображениеСостоянияБазы();
	
КонецПроцедуры

