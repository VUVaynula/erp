Процедура ПодключитьсяКХранилищуОсн(Команда)
	
	СтруктураПараметров = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьсяКХранилищуОснЗаверешение", ЭтотОбъект, СтруктураПараметров); 
	ПоказатьВопрос(ОписаниеОповещения, "Подключиться к хранилищу?", РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьсяКХранилищуОснЗаверешение(РезультатВопроса, СтруктураПараметров) Экспорт	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ВыполняемаяКоманда = СтруктураПараметровКоманднойСтроки.КаталогПрограммы +                     
		" DESIGNER" + СтруктураПараметровКоманднойСтроки.ПутьКБазеДанных +
		ПользовательПароль() +
		" /Visible" +
		" /DisableStartupMessages" +
		" /DisableStartupDialogs" +
		//СтруктураПараметровКоманднойСтроки.DisableStartupDialogs + 
		" /ConfigurationRepositoryF " + """" + АдресХранилищаОсновнойКонфигурации + 
		""" /ConfigurationRepositoryN """ + ПользовательХранилищаОсновнойКонфигурации +
		""" /ConfigurationRepositoryP """ + ПарольПользователяХранилищаОсновнойКонфигурации +
		""" /ConfigurationRepositoryBindCfg -forceBindAlreadyBindedUser -forceReplaceCfg";
		//" /UpdateDBCfg";
		
		КодВозврата = Неопределено;
		
		ТекстКоманды = ВыполняемаяКоманда;
		
		ЗапуститьПриложение(ВыполняемаяКоманда, , Истина, КодВозврата);
		
		Если КодВозврата = 0 Тогда
			ОчиститьСообщения();
			Сообщить("Подключение к хранилищу установлено!");
		ИначеЕсли КодВозврата = 1 Тогда	
			ОчиститьСообщения();
			Сообщить("Не удалось подключиться к хранилищу!");
		КонецЕсли;
		
		УстановитьОтображениеСостоянияБазы();		
		
	КонецЕсли;
	
КонецПроцедуры

