Функция ПечатьВыбранныхБегунков(ПараметрыПечати) Экспорт
	
	Если ПараметрыПечати.ОбъектыПечати.Количество() <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Для выбора группировок укажите один заказ на производство. (Лист требований ЛТ6.9)");
		Возврат Неопределено;
	КонецЕсли;
	
	СсылкаЗаказа = ПараметрыПечати.ОбъектыПечати[0];
	АдресГруппировок = бит_ПечатьПроизводственныхЗаданийВызовСервера.ПоместитьГруппировкиПечатиВоВременноеХранилище(
		СсылкаЗаказа,
		ПараметрыПечати.Форма.УникальныйИдентификатор);
	
	ПараметрыФормы = Новый Структура("АдресГруппировок", АдресГруппировок);
	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораГруппировокПечати",
		ЭтотОбъект,
		ПараметрыПечати);
	
	ОткрытьФорму(
		"Документ.ЗаказНаПроизводство2_2.Форма.бит_ФормаВыбораГруппировокПечати",
		ПараметрыФормы,
		ПараметрыПечати.Форма,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПослеВыбораГруппировокПечати(КлючиГруппировок, ПараметрыПечати) Экспорт
	
	Если КлючиГруппировок = Неопределено Или КлючиГруппировок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура(
		"бит_КлючиГруппировок",
		КлючиГруппировок);
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Документ.ЗаказНаПроизводство2_2",
		"бит_ПечатьЗаданияНаПроизводство",
		ПараметрыПечати.ОбъектыПечати,
		ПараметрыПечати.Форма,
		ДополнительныеПараметры);
	
КонецПроцедуры

