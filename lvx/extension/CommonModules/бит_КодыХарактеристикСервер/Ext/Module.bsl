// Возвращает очередной код характеристики, уникальный в пределах подчинения владельцу.
// Владельцем может быть как элемент справочника "Номенклатура", так и элемент справочника
// "Виды номенклатуры" - нумерация ведется независимо в пределах каждого владельца.
//
// Параметры:
//   Владелец - СправочникСсылка.Номенклатура, СправочникСсылка.ВидыНоменклатуры - владелец характеристики.
//   ИсключаемаяХарактеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика,
//                               код которой не учитывается при поиске максимума (сама записываемая).
//
// Возвращаемое значение:
//   Число - код характеристики от 1 до 10 000 000.
//
Функция НовыйКодХарактеристики(Владелец, ИсключаемаяХарактеристика = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат 0;
	КонецЕсли;

	// Занятые коды владельца: по ним же проверяется уникальность нового кода. Максимума
	// недостаточно - в данных могут быть пропуски и коды, проставленные вручную.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ХарактеристикиНоменклатуры.бит_КодХарактеристики КАК Код
	                      |ИЗ
	                      |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                      |ГДЕ
	                      |	ХарактеристикиНоменклатуры.Владелец = &Владелец
	                      |	И ХарактеристикиНоменклатуры.Ссылка <> &ИсключаемаяХарактеристика
	                      |	И ХарактеристикиНоменклатуры.бит_КодХарактеристики > 0");
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("ИсключаемаяХарактеристика",
		?(ИсключаемаяХарактеристика = Неопределено,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),
			ИсключаемаяХарактеристика));

	ЗанятыеКоды = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗанятыеКоды.Вставить(Выборка.Код, Истина);
	КонецЦикла;

	НовыйКод = 1;
	Пока ЗанятыеКоды.Получить(НовыйКод) <> Неопределено Цикл
		НовыйКод = НовыйКод + 1;
	КонецЦикла;

	Если НовыйКод > ПредельныйКодХарактеристики() Тогда
		ВызватьИсключение СтрШаблон(
			"Исчерпан диапазон кодов характеристик для владельца ""%1"". (Лист требований ЛТ6.8)",
			Строка(Владелец));
	КонецЕсли;

	Возврат НовыйКод;

КонецФункции

// Проверяет, что код характеристики не занят другой характеристикой того же владельца.
//
// Параметры:
//   Владелец - СправочникСсылка.Номенклатура, СправочникСсылка.ВидыНоменклатуры - владелец.
//   Код - Число - проверяемый код характеристики.
//   ИсключаемаяХарактеристика - СправочникСсылка.ХарактеристикиНоменклатуры - сама характеристика.
//
// Возвращаемое значение:
//   Булево - Истина, если код свободен (или не заполнен).
//
Функция КодХарактеристикиУникален(Владелец, Код, ИсключаемаяХарактеристика = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат Истина;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                      |ГДЕ
	                      |	ХарактеристикиНоменклатуры.Владелец = &Владелец
	                      |	И ХарактеристикиНоменклатуры.бит_КодХарактеристики = &Код
	                      |	И ХарактеристикиНоменклатуры.Ссылка <> &ИсключаемаяХарактеристика");
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("ИсключаемаяХарактеристика",
		?(ИсключаемаяХарактеристика = Неопределено,
			Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),
			ИсключаемаяХарактеристика));

	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Заполняет код характеристики, если он не заполнен. Вызывается при записи характеристики,
// а также предназначен для программного пакетного создания характеристик из других мест конфигурации.
//
// Параметры:
//   ХарактеристикаОбъект - СправочникОбъект.ХарактеристикиНоменклатуры - заполняемая характеристика.
//
Процедура ЗаполнитьКодХарактеристики(ХарактеристикаОбъект) Экспорт

	Если ЗначениеЗаполнено(ХарактеристикаОбъект.бит_КодХарактеристики) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ХарактеристикаОбъект.Владелец) Тогда
		Возврат;
	КонецЕсли;

	// Блокируется владелец характеристики: у пространства блокировок справочника есть только
	// поле "Ссылка", поэтому сериализуем нумерацию по самому владельцу. Без блокировки два
	// параллельных сеанса выдали бы одинаковый код.
	ПространствоБлокировки = ПространствоБлокировкиВладельца(ХарактеристикаОбъект.Владелец);
	Если ЗначениеЗаполнено(ПространствоБлокировки) Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ПространствоБлокировки);
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ХарактеристикаОбъект.Владелец);
		Блокировка.Заблокировать();
	КонецЕсли;

	ХарактеристикаОбъект.бит_КодХарактеристики = НовыйКодХарактеристики(
		ХарактеристикаОбъект.Владелец,
		ХарактеристикаОбъект.Ссылка);

КонецПроцедуры

// Возвращает имя пространства блокировок владельца характеристики.
//
Функция ПространствоБлокировкиВладельца(Владелец)

	ТипВладельца = ТипЗнч(Владелец);

	Если ТипВладельца = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат "Справочник.Номенклатура";
	ИначеЕсли ТипВладельца = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
		Возврат "Справочник.ВидыНоменклатуры";
	КонецЕсли;

	Возврат "";

КонецФункции

// Верхняя граница диапазона нумерации характеристик.
//
// Возвращаемое значение:
//   Число - предельный код характеристики.
//
Функция ПредельныйКодХарактеристики() Экспорт

	Возврат 10000000;

КонецФункции

