////////////////////////////////////////////////////////////////////////////////
// Создание подчиненных характеристик по ресурсной спецификации.
// Назначение:
// На вход получает ресурсную спецификацию либо характеристику, у которой владелец Номенклатура.
// - Если спецификация, то определяет все характеристики основного изделия.
// - Если характеристика, то ищет приоритетную спецификацию и работает только по переданной характеристике.
// 1. Для каждой характеристики получает список доп.реквизитов - контекст заданных свойств. 
// 2. Обходит состав спецификации. По каждой строке ВыходныеИзделия берет ее КлючСвязи.
// 3. По КлючСвязи берет только нужные строки СоответствиеСвойств - контекст требуемых свойств.
// 4. Рассчитывает свойства
// 5. Ищет или создает характеристику для подчиненной номенклатуры.
// 6. Уходит ниже по приоритетной спецификации найденной/созданной характеристики. 
//                                                                                 
// Сохраняет уникальный контекст для каждой ветки дерева ресурсных спецификаций (само дерево не строит).
// Проверяет для каждой ветки на предмет зацикливания (сохраняет массив обработанных спецификаций), чтобы не свалиться в бесконечный цикл
//
////////////////////////////////////////////////////////////////////////////////

Процедура СозданиеПодчиненныхХарактеристикПолуфабрикатовМатериалов(Источник) Экспорт

	Перем ХарактеристикаОсновногоИзделия;                                                                           
	Перем СпецификацияСсылка;

	Если ТипЗнч(Источник) = Тип("СправочникОбъект.РесурсныеСпецификации") Тогда

		СпецификацияОбъект = Источник;
		СпецификацияСсылка = Источник.Ссылка;
		Номенклатура = Источник.ОсновноеИзделиеНоменклатура;

	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ХарактеристикиНоменклатуры") 
		И ТипЗнч(Источник.Владелец) = Тип("СправочникСсылка.Номенклатура") 
		И ЗначениеЗаполнено(Источник.Владелец) Тогда

			Номенклатура = Источник.Владелец;
			ХарактеристикаОсновногоИзделия = Источник.Ссылка;

		ПолучитьПриоритетнуюСпецификациюПоНоменклатуреИХарактеристике(Номенклатура, ХарактеристикаОсновногоИзделия, СпецификацияСсылка);
		Если НЕ ЗначениеЗаполнено(СпецификацияСсылка) Тогда
			Возврат;
		КонецЕсли;
		СпецификацияОбъект = СпецификацияСсылка.ПолучитьОбъект();

	Иначе
		Возврат;
	КонецЕсли;

	Если НЕ ВидНоменклатурыПодлежитОбработке(Номенклатура.ВидНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	
	// Работать будем либо по текущей характеристике, либо по всем возможным
	Если ЗначениеЗаполнено(ХарактеристикаОсновногоИзделия) Тогда
		МассивХарактеристик = Новый Массив;
		МассивХарактеристик.Добавить(ХарактеристикаОсновногоИзделия);
	Иначе
		МассивХарактеристик = ПолучитьХарактеристикиНоменклатуры(Номенклатура);
	КонецЕсли;

	Для каждого ТекХарактеристикаОсновногоИзделия Из МассивХарактеристик Цикл

		КонтекстСвойств = Новый Соответствие;
		ЗаполнитьКонтекстИзХарактеристики(КонтекстСвойств, ТекХарактеристикаОсновногоИзделия);

		СтекСпецификацийВетки = Новый Массив;

		ОбработатьСпецификациюПоМатериалам(СпецификацияОбъект, КонтекстСвойств, СтекСпецификацийВетки);

	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьСпецификациюПоМатериалам(СпецификацияОбъект, КонтекстРодителя, СтекСпецификацийВетки)

	Если СпецификацияОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СпецификацияОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	// Защита от зацикливания спецификаций в текущей ветке.
	Если СтекСпецификацийВетки.Найти(СпецификацияОбъект.Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтекСпецификацийВетки.Добавить(СпецификацияОбъект.Ссылка);

	Для каждого СтрокаМатериала Из СпецификацияОбъект.МатериалыИУслуги Цикл 
		ОбработатьСтрокуМатериала(СпецификацияОбъект, СтрокаМатериала, КонтекстРодителя, СтекСпецификацийВетки);
	КонецЦикла;

	СтекСпецификацийВетки.Удалить(СтекСпецификацийВетки.Количество() - 1);

КонецПроцедуры

Процедура ОбработатьСтрокуМатериала(СпецификацияОбъект, СтрокаМатериала, КонтекстРодителя, СтекСпецификацийВетки)

	НоменклатураМатериала = СтрокаМатериала.Номенклатура;

	Если НЕ ХарактеристикиИспользуютсяДляНоменклатуры(НоменклатураМатериала) Тогда
		// Характеристик нет — создавать нечего, но дочернюю спецификацию все равно можно обойти.
		ХарактеристикаМатериала = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

		ОбработатьДочернююСпецификациюЕслиНужно(СтрокаМатериала, НоменклатураМатериала, ХарактеристикаМатериала, КонтекстРодителя, СтекСпецификацийВетки);
		Возврат;
	КонецЕсли;

	КонтекстТекущейВетки = СкопироватьСоответствие(КонтекстРодителя);

	ХарактеристикаМатериала = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

	Если ЗначениеЗаполнено(СтрокаМатериала.Характеристика) Тогда
		// Если характеристика уже задана в строке материала — берем ее и добавляем ее свойства в контекст.
		ХарактеристикаМатериала = СтрокаМатериала.Характеристика;
		ЗаполнитьКонтекстИзХарактеристики(КонтекстТекущейВетки, ХарактеристикаМатериала);

	ИначеЕсли СтрокаМатериала.СпособАвтовыбораХарактеристики = Перечисления.СпособыАвтовыбораХарактеристики.ПодбираетсяПоСвойствамПродукции Тогда

		ТребуемыеСвойства = ПолучитьТребуемыеСвойстваМатериала(СпецификацияОбъект, СтрокаМатериала, КонтекстТекущейВетки);

		Если ТребуемыеСвойства.Количество() > 0 Тогда

			ХарактеристикаМатериала = НайтиИлиСоздатьХарактеристику(НоменклатураМатериала, ТребуемыеСвойства);

			Если ЗначениеЗаполнено(ХарактеристикаМатериала) Тогда
				ЗаполнитьКонтекстИзХарактеристики(КонтекстТекущейВетки, ХарактеристикаМатериала);
			Иначе                                               
				// по идее сюда не должен проваливаться
				ОбъединитьКонтекстСвойств(КонтекстТекущейВетки, ТребуемыеСвойства);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ОбработатьДочернююСпецификациюЕслиНужно(СтрокаМатериала, НоменклатураМатериала, ХарактеристикаМатериала, КонтекстТекущейВетки, СтекСпецификацийВетки);

КонецПроцедуры

Процедура ОбработатьДочернююСпецификациюЕслиНужно(СтрокаМатериала, НоменклатураМатериала, ХарактеристикаМатериала, КонтекстТекущейВетки, СтекСпецификацийВетки)

	Если НЕ СтрокаМатериала.ПроизводитсяВПроцессе Тогда
		Возврат;
	КонецЕсли;

	ДочерняяСпецификация = Неопределено;

	Если ЗначениеЗаполнено(СтрокаМатериала.СпецификацияРемонта) Тогда
		ДочерняяСпецификация = СтрокаМатериала.СпецификацияРемонта;
	Иначе
		ДочерняяСпецификация = ПолучитьПриоритетнуюСпецификациюДляНоменклатуры(НоменклатураМатериала, ХарактеристикаМатериала);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДочерняяСпецификация) Тогда
		Возврат;
	КонецЕсли;

	Если СтекСпецификацийВетки.Найти(ДочерняяСпецификация) <> Неопределено Тогда
		// Цикл по текущей ветке. Не падаем в бесконечную рекурсию.
		Возврат;
	КонецЕсли;

	ОбработатьСпецификациюПоМатериалам(ДочерняяСпецификация.ПолучитьОбъект(), КонтекстТекущейВетки, СтекСпецификацийВетки);

КонецПроцедуры

Функция ПолучитьТребуемыеСвойстваМатериала(СпецификацияОбъект, СтрокаМатериала, КонтекстСвойств)

	Результат = Новый Соответствие;
	КлючСвязи = СтрокаМатериала.КлючСвязи;

	Если НЕ ЗначениеЗаполнено(КлючСвязи) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокиПоКлючу = СпецификацияОбъект.СоответствиеСвойств.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
	Для каждого СтрокаСоответствия Из СтрокиПоКлючу Цикл

		ЗначениеСвойства = РассчитатьЗначениеСвойства(СтрокаСоответствия, КонтекстСвойств);

		Если ЗначениеСвойства <> Неопределено Тогда
			Результат.Вставить(СтрокаСоответствия.СвойствоПродукции, ЗначениеСвойства);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РассчитатьЗначениеСвойства(СтрокаСоответствия, КонтекстСвойств)

	Если СтрокаСоответствия.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению Тогда

		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.ЗначениеСвойства) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Значение = СтрокаСоответствия.ЗначениеСвойства;

		// Случай, когда в ЗначениеСвойства лежит ссылка на другое свойство.
		Если КонтекстСвойств.Получить(Значение) <> Неопределено Тогда
			Возврат КонтекстСвойств.Получить(Значение);
		КонецЕсли;

		Возврат Значение;

	КонецЕсли;

	Если СтрокаСоответствия.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству Тогда

		Возврат КонтекстСвойств.Получить(СтрокаСоответствия.СвойствоМатериала);

	КонецЕсли;

	Если СтрокаСоответствия.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму Тогда

		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.АлгоритмРасчетаЗначения) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат РассчитатьЗначениеСвойстваПоАлгоритму(СтрокаСоответствия, КонтекстСвойств);

	КонецЕсли;

	Если СтрокаСоответствия.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле Тогда

		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.АлгоритмРасчетаЗначения) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ДанныеДляВычисления = ПодготовитьФормулуДляВычисленияПоКонтексту(СтрокаСоответствия.АлгоритмРасчетаЗначения, КонтекстСвойств);

		Возврат ОбщегоНазначения.ВычислитьВБезопасномРежиме( ДанныеДляВычисления.Формула, ДанныеДляВычисления.Параметры);

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция РассчитатьЗначениеСвойстваПоАлгоритму(СтрокаСоответствия, КонтекстСвойств)

	ОписанияФункцийАвтовыбора = Новый Соответствие;

	Для каждого Описание Из УправлениеДаннымиОбИзделияхПовтИсп.ОписаниеФункцийАвтовыбораЗначенияСвойстваНоменклатуры() Цикл
		Если ТипЗнч(Описание) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ Описание.Свойство("ИмяФункции") Тогда
			Продолжить;
		КонецЕсли;

		ОписанияФункцийАвтовыбора.Вставить(Описание.ИмяФункции, Описание);
	КонецЦикла;

	Описание = ОписанияФункцийАвтовыбора[СтрокаСоответствия.АлгоритмРасчетаЗначения];

	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("КонтекстСвойств", КонтекстСвойств);
	Параметры.Вставить("СтрокаСоответствия", СтрокаСоответствия);

	Алгоритм = Описание.ИмяМодуля + "." + Описание.ИмяФункции + "(Параметры)";

	Возврат ОбщегоНазначения.ВычислитьВБезопасномРежиме(Алгоритм, Параметры);

КонецФункции

Функция ПодготовитьФормулуДляВычисленияПоКонтексту(АлгоритмРасчета, КонтекстСвойств)

	Параметры = Новый Структура;
	Формула = АлгоритмРасчета;
	Индекс = 0;

	Для каждого ПараСвойства Из КонтекстСвойств Цикл
		ИмяПараметра = СтрШаблон("Параметр%1", Формат(Индекс, "ЧН=; ЧГ="));
		Параметры.Вставить(ИмяПараметра, ПараСвойства.Значение);
		Формула = СтрЗаменить(Формула, "[" + Строка(ПараСвойства.Ключ) + "]", "Параметры." + ИмяПараметра);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Новый Структура("Формула, Параметры", Формула, Параметры);

КонецФункции

Функция НайтиИлиСоздатьХарактеристику(Номенклатура, ТребуемыеСвойства)

	НайденнаяХарактеристика = НайтиХарактеристикуПоСвойствам(Номенклатура, ТребуемыеСвойства);

	Если ЗначениеЗаполнено(НайденнаяХарактеристика) Тогда
		Возврат НайденнаяХарактеристика;
	КонецЕсли;

	Возврат СоздатьХарактеристикуПоСвойствам(Номенклатура, ТребуемыеСвойства);

КонецФункции

Функция НайтиХарактеристикуПоСвойствам(Номенклатура, ТребуемыеСвойства)

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если ТребуемыеСвойства.Количество() = 0 Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	ТипыСтрокой = "ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения,СправочникСсылка.ЗначенияСвойствОбъектов,"; 
	ТипыСтрокой = ТипыСтрокой + "Строка,Число,Булево,Дата,";
	ТипыСтрокой = ТипыСтрокой + "СправочникСсылка.Номенклатура,СправочникСсылка.УпаковкиЕдиницыИзмерения,СправочникСсылка.СегментыНоменклатуры,";
	ТипыСтрокой = ТипыСтрокой + "СправочникСсылка.Организации,СправочникСсылка.СтруктураПредприятия,";
	ТипыСтрокой = ТипыСтрокой + "СправочникСсылка.Проекты,СправочникСсылка.Склады,СправочникСсылка.бит_ДополнительныеЗначенияАналитик";
	МассивТипов = СтрРазделить(ТипыСтрокой, ",");                               
	Для сч = 0 По МассивТипов.ВГраница() Цикл
		МассивТипов[сч] = Тип(МассивТипов[сч]);
	КонецЦикла;
	
	ТаблицаЭталон = Новый ТаблицаЗначений;
	ТаблицаЭталон.Колонки.Добавить("ЗначениеСвойства", Новый ОписаниеТипов(МассивТипов, , , , Новый КвалификаторыСтроки(250)));
    ТаблицаЭталон.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));


	Для каждого Пара Из ТребуемыеСвойства Цикл
		НоваяСтрока = ТаблицаЭталон.Добавить();
		НоваяСтрока.Свойство = Пара.Ключ;
		НоваяСтрока.ЗначениеСвойства = Пара.Значение;
	КонецЦикла;

	Запрос = Новый Запрос("ВЫБРАТЬ
						|	Эталон.Свойство КАК Свойство,
						|	Эталон.ЗначениеСвойства КАК ЗначениеСвойства
						|ПОМЕСТИТЬ ВТ_Эталон
						|ИЗ
						|	&Эталон КАК Эталон
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	Характеристики.Ссылка КАК Характеристика,
						|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Эталон.Свойство) КАК Совпало
						|ИЗ
						|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДопРеквизиты
						|		ПО (ДопРеквизиты.Ссылка = Характеристики.Ссылка)
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Эталон КАК Эталон
						|		ПО (ДопРеквизиты.Свойство = Эталон.Свойство)
						|			И (ДопРеквизиты.Значение = Эталон.ЗначениеСвойства)
						|ГДЕ
						|	Характеристики.Владелец = &Владелец
						|	И НЕ Характеристики.ПометкаУдаления
						|
						|СГРУППИРОВАТЬ ПО
						|	Характеристики.Ссылка
						|
						|ИМЕЮЩИЕ
						|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Эталон.Свойство) = &КоличествоСвойств");
	Запрос.УстановитьПараметр("Владелец", ОпределитьВладельцаХарактеристики(Номенклатура));
	Запрос.УстановитьПараметр("Эталон", ТаблицаЭталон);
	Запрос.УстановитьПараметр("КоличествоСвойств", ТаблицаЭталон.Количество());

	ТаблицаНайденных = Запрос.Выполнить().Выгрузить();

	Если ТаблицаНайденных.Количество() = 1 Тогда
		Возврат ТаблицаНайденных[0].Характеристика;
	КонецЕсли;

	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

КонецФункции

Функция СоздатьХарактеристикуПоСвойствам(Номенклатура, ТребуемыеСвойства)

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если ТребуемыеСвойства.Количество() = 0 Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	ОбъектХарактеристики = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();

	ОбъектХарактеристики.Владелец = ОпределитьВладельцаХарактеристики(Номенклатура);
	ОбъектХарактеристики.ВидНоменклатуры = Номенклатура.ВидНоменклатуры;

	Для каждого Пара Из ТребуемыеСвойства Цикл
		НоваяСтрока = ОбъектХарактеристики.ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.Свойство = Пара.Ключ;
		НоваяСтрока.Значение = Пара.Значение;
	КонецЦикла;

	РеквизитыВидаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.НоваяСтруктураРеквизитыВидаНоменклатуры(Номенклатура.ВидНоменклатуры);
	ОбъектХарактеристики.Наименование = НоменклатураСервер.НаименованиеПоШаблону(РеквизитыВидаНоменклатуры.ШаблонРабочегоНаименованияХарактеристики, ОбъектХарактеристики);
	ОбъектХарактеристики.НаименованиеПолное = НоменклатураСервер.НаименованиеПоШаблону(РеквизитыВидаНоменклатуры.ШаблонНаименованияДляПечатиХарактеристики, ОбъектХарактеристики);
	Если ПустаяСтрока(ОбъектХарактеристики.Наименование) Тогда
		ОбъектХарактеристики.Наименование = СформироватьПростоеНаименованиеХарактеристики(ТребуемыеСвойства);
	КонецЕсли;

	Если ПустаяСтрока(ОбъектХарактеристики.НаименованиеПолное) Тогда
		ОбъектХарактеристики.НаименованиеПолное = ОбъектХарактеристики.Наименование;
	КонецЕсли;
    ОбъектХарактеристики.ОбменДанными.Загрузка = Истина;
	ОбъектХарактеристики.Записать();

	Возврат ОбъектХарактеристики.Ссылка;

КонецФункции

Функция СформироватьПростоеНаименованиеХарактеристики(ТребуемыеСвойства)

	Наименование = "";

	Для каждого Пара Из ТребуемыеСвойства Цикл
		Если НЕ ПустаяСтрока(Наименование) Тогда
			Наименование = Наименование + "; ";
		КонецЕсли;
		Наименование = Наименование + Строка(Пара.Ключ) + ": " + Строка(Пара.Значение);
	КонецЦикла;

	Если ПустаяСтрока(Наименование) Тогда
		Наименование = "Автоматически созданная";
	КонецЕсли;

	Возврат Лев(Наименование, 150);

