Функция ПолучитьПриоритетнуюСпецификациюДляНоменклатуры(Номенклатура, Характеристика = Неопределено)

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Справочники.РесурсныеСпецификации.ПустаяСсылка();
	КонецЕсли;

	Если Характеристика = Неопределено Тогда
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
						|	Спецификации.Ссылка КАК Спецификация
						|ИЗ
						|	Справочник.РесурсныеСпецификации КАК Спецификации
						|ГДЕ
						|	НЕ Спецификации.ПометкаУдаления
						|	И Спецификации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует)
						|	И Спецификации.ТипПроизводственногоПроцесса = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.Сборка)
						|	И Спецификации.ОсновноеИзделиеНоменклатура = &Номенклатура
						|	И (
						|		Спецификации.ОсновноеИзделиеХарактеристика = &Характеристика
						|		ИЛИ Спецификации.ОсновноеИзделиеХарактеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
						|	)
						|УПОРЯДОЧИТЬ ПО
						|	ВЫБОР
						|		КОГДА Спецификации.ОсновноеИзделиеХарактеристика = &Характеристика
						|			ТОГДА 0
						|		ИНАЧЕ 1
						|	КОНЕЦ,
						|	Спецификации.Код УБЫВ");

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Спецификация;
	КонецЕсли;

	Возврат Справочники.РесурсныеСпецификации.ПустаяСсылка();

КонецФункции

Процедура ОбойтиСпецификациюДляСозданияХарактеристик(СпецификацияОбъект, КонтекстРодителя, СтекСпецификаций)

	Если СпецификацияОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СтекСпецификаций.Найти(СпецификацияОбъект.Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтекСпецификаций.Добавить(СпецификацияОбъект.Ссылка);

	Для каждого СтрокаВыходногоИзделия Из СпецификацияОбъект.ВыходныеИзделия Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаВыходногоИзделия.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		НоменклатураСтроки = СтрокаВыходногоИзделия.Номенклатура;

		Если НЕ ВидНоменклатурыПодлежитОбработке(НоменклатураСтроки.ВидНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;

		КонтекстТекущегоУзла = СкопироватьСоответствие(КонтекстРодителя);
		КлючСвязи = СтрокаВыходногоИзделия.КлючСвязи;
		ТребуемыеСвойства = ПолучитьСвойстваПоСпецификации(СпецификацияОбъект, КлючСвязи, НоменклатураСтроки, КонтекстТекущегоУзла);
		Если ТребуемыеСвойства.Количество() > 0 Тогда
			ХарактеристикаСтроки = НайтиИлиСоздатьХарактеристику(НоменклатураСтроки, ТребуемыеСвойства);
			ОбъединитьКонтекстСвойств(КонтекстТекущегоУзла, ТребуемыеСвойства);
		Иначе
			ХарактеристикаСтроки = СтрокаВыходногоИзделия.Характеристика;
		КонецЕсли;

		ДочерняяСпецификация = Неопределено;
		ПолучитьПриоритетнуюСпецификациюПоНоменклатуреИХарактеристике(НоменклатураСтроки, ХарактеристикаСтроки, ДочерняяСпецификация);
		Если ЗначениеЗаполнено(ДочерняяСпецификация) Тогда
			ОбойтиСпецификациюДляСозданияХарактеристик(ДочерняяСпецификация.ПолучитьОбъект(), КонтекстТекущегоУзла, СтекСпецификаций);
		КонецЕсли;

	КонецЦикла;

	СтекСпецификаций.Удалить(СтекСпецификаций.Количество() - 1);

КонецПроцедуры

Функция ПолучитьСвойстваПоСпецификации(СпецификацияОбъект, КлючСвязи, Номенклатура, КонтекстСвойств)

	Результат = Новый Соответствие;

	Если СпецификацияОбъект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для каждого СтрокаСоответствия Из СпецификацияОбъект.СоответствиеСвойств Цикл

		// берем только строки СоответствиеСвойств, относящиеся к конкретной строке ВыходныеИзделия.
		Если ЗначениеЗаполнено(КлючСвязи) И СтрокаСоответствия.КлючСвязи <> КлючСвязи Тогда
			Продолжить;
		КонецЕсли;

		// Если КлючСвязи не задан, берем только строки без ключа.
		Если НЕ ЗначениеЗаполнено(КлючСвязи) И ЗначениеЗаполнено(СтрокаСоответствия.КлючСвязи) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаСоответствия.СвойствоПродукции) Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеСвойства = РассчитатьЗначениеСвойства(СтрокаСоответствия, КонтекстСвойств);

		Если ЗначениеСвойства <> Неопределено Тогда
			Результат.Вставить(СтрокаСоответствия.СвойствоПродукции, ЗначениеСвойства);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

