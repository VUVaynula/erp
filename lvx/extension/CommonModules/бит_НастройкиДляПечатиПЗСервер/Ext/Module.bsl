#Область ПрограммныйИнтерфейс

Функция ПолучитьМассивЗначений(Код, Наименование) Экспорт
	
	ЭлементНастройки = ПолучитьЭлементНастройки(Код, Наименование);
	Если Не ЗначениеЗаполнено(ЭлементНастройки) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат ЭлементНастройки.ПолучитьОбъект().Значения.ВыгрузитьКолонку("Значение");
	
КонецФункции

Функция ПолучитьПервоеЗначение(Код, Наименование) Экспорт
	
	Значения = ПолучитьМассивЗначений(Код, Наименование);
	Если Значения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Значения[0];
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЭлементНастройки(Код, Наименование)
	
	Ссылка = Справочники.бит_ЗначенияПоУмолчанию.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Родитель = ПолучитьПапкуНастроек();
	ОбъектНастройки = Справочники.бит_ЗначенияПоУмолчанию.СоздатьЭлемент();
	ОбъектНастройки.Код = Код;
	ОбъектНастройки.Наименование = Наименование;
	ОбъектНастройки.Родитель = Родитель;
	ОбъектНастройки.Записать();
	
	Возврат ОбъектНастройки.Ссылка;
	
КонецФункции

Функция ПолучитьПапкуНастроек()
	
	КодПапки = "ЛТ6900001";
	Ссылка = Справочники.бит_ЗначенияПоУмолчанию.НайтиПоКоду(КодПапки);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	ОбъектПапки = Справочники.бит_ЗначенияПоУмолчанию.СоздатьГруппу();
	ОбъектПапки.Код = КодПапки;
	ОбъектПапки.Наименование = "Печатная форма Заказа на производство";
	ОбъектПапки.Записать();
	
	Возврат ОбъектПапки.Ссылка;
	
КонецФункции

#КонецОбласти
