// Обработчик команды печати "Этикетка готовой продукции" - печатает этикетки по всем строкам заказа.
//
Функция ПечатьЭтикетокГотовойПродукции(ПараметрыПечати) Экспорт

	ПодготовитьПечатьЭтикеток(ПараметрыПечати, Неопределено);

	Возврат Неопределено;

КонецФункции

// Обработчик команды печати "Этикетки выделенных" - печатает этикетки только по строкам,
// выделенным в табличной части "Продукция" заказа на производство.
//
Функция ПечатьЭтикетокВыделенныхСтрок(ПараметрыПечати) Экспорт

	ВыделенныеСтроки = НомераВыделенныхСтрокПродукции(ПараметрыПечати.Форма);

	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не выделено ни одной строки продукции. (Лист требований ЛТ6.8)");
		Возврат Неопределено;
	КонецЕсли;

	ПодготовитьПечатьЭтикеток(ПараметрыПечати, ВыделенныеСтроки);

	Возврат Неопределено;

КонецФункции

// Обработчик закрытия формы ввода количества упаковок.
//
Процедура ПослеВводаКоличестваУпаковок(КоличествоУпаковок, ДополнительныеПараметры) Экспорт

	Если КоличествоУпаковок = Неопределено Тогда
		// Пользователь нажал "Отмена" - возвращаемся на форму заказа.
		Возврат;
	КонецЕсли;

	ВыполнитьКомандуПечатиЭтикеток(
		ДополнительныеПараметры.ПараметрыПечати,
		ДополнительныеПараметры.ИдентификаторКоманды,
		ДополнительныеПараметры.ВыделенныеСтроки,
		КоличествоУпаковок);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьПечатьЭтикеток(ПараметрыПечати, ВыделенныеСтроки)

	Если ПараметрыПечати.ОбъектыПечати.Количество() <> 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Для печати этикеток укажите один заказ на производство. (Лист требований ЛТ6.8)");
		Возврат;
	КонецЕсли;

	СсылкаЗаказа = ПараметрыПечати.ОбъектыПечати[0];

	Если Не бит_ПечатьЭтикетокГПВызовСервера.ЗаказПроведен(СсылкаЗаказа) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Печать возможна только из проведенного документа (Лист требований ЛТ6.8)");
		Возврат;
	КонецЕсли;

	ИдентификаторКоманды = ?(ВыделенныеСтроки = Неопределено,
		"бит_ЭтикеткаГотовойПродукции",
		"бит_ЭтикеткиВыделенных");

	АдресСтрокПродукции = бит_ПечатьЭтикетокГПВызовСервера.ПоместитьСтрокиБезУпаковокВоВременноеХранилище(
		СсылкаЗаказа,
		ВыделенныеСтроки,
		ПараметрыПечати.Форма.УникальныйИдентификатор);

	Если АдресСтрокПродукции = Неопределено Тогда
		// Структуры хранения упаковок заполнены для всей номенклатуры - ручной ввод не требуется.
		ВыполнитьКомандуПечатиЭтикеток(ПараметрыПечати, ИдентификаторКоманды, ВыделенныеСтроки, Неопределено);
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыПечати", ПараметрыПечати);
	ДополнительныеПараметры.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);

	Оповещение = Новый ОписаниеОповещения(
		"ПослеВводаКоличестваУпаковок",
		бит_ПечатьЭтикетокГПКлиент,
		ДополнительныеПараметры);

	ПараметрыФормы = Новый Структура("АдресСтрокПродукции", АдресСтрокПродукции);

	ОткрытьФорму(
		"Документ.ЗаказНаПроизводство2_2.Форма.бит_ФормаВводаКоличестваУпаковок",
		ПараметрыФормы,
		ПараметрыПечати.Форма,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура ВыполнитьКомандуПечатиЭтикеток(ПараметрыПечати, ИдентификаторКоманды, ВыделенныеСтроки, КоличествоУпаковок)

	ДополнительныеПараметры = Новый Структура;
	Если ВыделенныеСтроки <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("бит_ВыделенныеСтроки", ВыделенныеСтроки);
	КонецЕсли;
	Если КоличествоУпаковок <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("бит_КоличествоУпаковок", КоличествоУпаковок);
	КонецЕсли;

	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Документ.ЗаказНаПроизводство2_2",
		ИдентификаторКоманды,
		ПараметрыПечати.ОбъектыПечати,
		ПараметрыПечати.Форма,
		ДополнительныеПараметры);

КонецПроцедуры

Функция НомераВыделенныхСтрокПродукции(Форма)

	Результат = Новый Массив;

	ЭлементПродукция = Форма.Элементы.Найти("Продукция");
	Если ЭлементПродукция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из ЭлементПродукция.ВыделенныеСтроки Цикл
		СтрокаПродукции = Форма.Объект.Продукция.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаПродукции <> Неопределено Тогда
			Результат.Добавить(СтрокаПродукции.НомерСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

