// Помещает во временное хранилище строки продукции, для которых не заполнен регистр
// "Структуры хранения упаковок" - по ним количество упаковок вводится пользователем вручную.
//
// Возвращаемое значение:
//   Строка, Неопределено - адрес временного хранилища; Неопределено, если таких строк нет.
//
Функция ПоместитьСтрокиБезУпаковокВоВременноеХранилище(СсылкаЗаказа, ВыделенныеСтроки,
	УникальныйИдентификаторФормы) Экспорт

	СтрокиБезУпаковок = бит_ПечатьЭтикетокГПСервер.СтрокиБезСтруктурыУпаковок(
		СсылкаЗаказа,
		ВыделенныеСтроки);

	Если СтрокиБезУпаковок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(СтрокиБезУпаковок, УникальныйИдентификаторФормы);

КонецФункции

// Проверяет, проведен ли заказ на производство: печать этикеток возможна только из
// проведенного документа.
//
Функция ЗаказПроведен(СсылкаЗаказа) Экспорт

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаЗаказа, "Проведен") = Истина;

КонецФункции

