			////Субконто Кт 3. 	Заполняем значением из реквизита Склад
			////Количество. 		Заполняем значением из Количество (ТЧ документа)
			////Сумма Сценария. 	Заполняем значением из Стоимость в Регистре накопления "Стоимость ТМЦ УУ", 
			////					сформированному к этому документу.
			////Сумма Упр. 		Заполняется аналогично Сумма сценария
			////Сумма Регл 		Заполняется аналогично Сумма сценария
			////Содержание. 		Заполняем значением Перемещение ТМЦ
			
			Для Каждого СтрокаДвижений Из ТаблицаДвижений_СтоимостьТМЦ_УУ Цикл
				
				Если СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					
					Проводка = НаборПроводок.Добавить();
					Проводка.Регистратор = Регистратор;
					
					Проводка.Период = Дата;
					Проводка.Сценарий = Справочники.СценарииПланирования.ФАКТ;
					Проводка.ЦФО = СкладОтправительЦФО;
					Проводка.Организация = Организация;
					
					Проводка.СчетДт = СтрокаДвижений.СчетУчетаБюджет;
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СкладПолучательЦФО);
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаДвижений.Номенклатура.Номенклатура);
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СкладПолучатель);
					Проводка.КоличествоДт = СтрокаДвижений.Количество;
					
					Проводка.СчетКт = СтрокаДвижений.СчетУчетаБюджет;
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СкладОтправительЦФО);
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДвижений.Номенклатура.Номенклатура);
					бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СкладОтправитель);	
					Проводка.КоличествоКт = СтрокаДвижений.Количество;
					
					Проводка.СуммаСценарий = СтрокаДвижений.Стоимость;
					Проводка.СуммаУпр = Проводка.СуммаСценарий;
					Проводка.СуммаРегл = Проводка.СуммаСценарий;
					
					Проводка.Содержание = "Перемещение ТМЦ";
					Проводка.СтатьяОборотов = Неопределено;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		////ЭтотОбъект.Движения.бит_Бюджетирование.Записывать = Истина;
		//НаборПроводок.Отбор.Регистратор.Установить(Регистратор);
		НаборПроводок.Записать(Истина);
		
	Иначе
		
		Сообщить("Движения по УУ не сформированы!");
		
	КонецЕсли;
	
