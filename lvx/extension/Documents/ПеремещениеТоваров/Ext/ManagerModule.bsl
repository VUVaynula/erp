
Процедура бит_СформироватьДвижения(Регистратор, ТаблицаДвиженийСебестоимостьТоваров) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8.1] [ASHolyavko@1cbit.ru] [08.05.2026] +        
	
	Дата = Регистратор.Дата;
	Организация = Регистратор.Организация;
	СкладОтправитель = Регистратор.СкладОтправитель;
	СкладПолучатель = Регистратор.СкладПолучатель;
	ФормироватьДвижения = Истина;
	
	Если НЕ ЗначениеЗаполнено(СкладОтправитель.Подразделение) Тогда
		Сообщить("Не заполнено поле ""Подразделение"" в складе отправителе");
		ФормироватьДвижения = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СкладПолучатель.Подразделение) Тогда
		Сообщить("Не заполнено поле ""Подразделение"" в складе получателе");
		ФормироватьДвижения = Ложь;
	КонецЕсли;
	
	Если ФормироватьДвижения Тогда
		
		//ТаблицаДвижений_СебестоимостьТоваров = РегистрыНакопления.СебестоимостьТоваров.бит_ПолучитьТаблицуСебестоимостьТоваров(Ссылка);//ЭтотОбъект.Движения.СебестоимостьТоваров.Выгрузить();			                                            
		ТаблицаДвижений_СебестоимостьТоваров = ТаблицаДвиженийСебестоимостьТоваров;
		
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		РезультатВидЦены = РегистрыСведений.бит_СоответствиеСкладовИВидовЦен.ПолучитьВидЦен(Дата, СкладОтправитель, СкладПолучатель);
		ВидЦены = РезультатВидЦены.ВидЦены; 
		
		ПодразделениеЦФООтправитель = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СкладОтправитель.Подразделение, Дата);
		ПодразделениеЦФОПолучатель = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СкладПолучатель.Подразделение, Дата);
		
		СоответствиеАналитикЦФОКонтрагент = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("СоответствиеАналитикЦФОКонтрагент", , Истина);
		
		ТаблицаДвижений_СтоимостьТМЦ_УУ = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
		ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
		ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
		//ТаблицаСоответствиеАналитикНоменклатуры = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуСоответствияАналитикНоменклатуры(ТаблицаДвижений_СебестоимостьТоваров);
		
		ТаблицаДвижений_ВыручкаИСебестоимость_УУ = РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ПолучитьТаблицуДляДвижений();
		
		////                            
		//Движение по бит_СтоимостьТМЦ_УУ (Себестоимость товаров)
		//4.1.1
		
		//СкладОтправитель
		//Вид движения		Расход
		//Номенклатура		Реквизит Номенклатура из ТЧ документа
		//ГФУ				Реквизит Группа финансового учета в карточке Номенклатура
		//Организация		Реквизит Организация документа
		//Партия			В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
		//Склад				Реквизит Склад Отправитель
		//Подразделение		Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. 
		//					Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, 
		//					с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем реквизитПодразделение..
		//Количество		Реквизит Количество из ТЧ документа
		//Стоимость			Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии (партию определяем по ФИФО) 
		//					и умножаем на количество
		//Доп.расходы		Оставляем не заполненным 
		
		
		РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьТаблицуДвиженийПоВидуДвижения(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СебестоимостьТоваров, ВидДвиженияНакопления.Расход, СкладОтправитель, ПодразделениеЦФООтправитель);		
		РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьТаблицуДвиженийПоВидуДвижения(ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход, ТаблицаДвижений_СебестоимостьТоваров, ВидДвиженияНакопления.Приход, СкладПолучатель, ПодразделениеЦФОПолучатель);		
		
		ТаблицаСтоимостиНоменклатурыПоПартиям = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоПартиям(Дата, ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход); 
		
		РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаСтоимостиНоменклатурыПоПартиям);		
		
		//СкладПолучатель
		//Вид движения		Приход
		//Номенклатура		Реквизит Номенклатура из ТЧ документа
		//ГФУ				Реквизит Группа финансового учета в карточке Номенклатура
		//Организация		Реквизит Организация документа
		//Партия			В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
		//Склад				Реквизит Склад Получатель
		//Подразделение		Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. 
		//					Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, 
		//					с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем реквизитПодразделение..
		//Количество		Реквизит Количество из ТЧ документа
		//Стоимость			Определяем цену на данную номенклатуру, исходя из Вида цены, установленного в регистре сведений "Соответствие складов и видов цен" 
		//					для связки Склад Отправитель-Склад Получатель на дату Заказа покупателя (реквизит Назначение ТЧ документа "Перемещение товаров", 
		//					Заказ покупателя определяется аналогично описанному в в регистре  "Выручка и Себестоимость УУ -Соглашение), 
		//					если оно не заполнено, то на дату выпуска данной партии номенклатуры умноженную на количество товаров. Т.е. цена*количество 
		//Доп.расходы		Оставляем не заполненным
		//*
		//4.2.1. 			В регистре не найдено соответствие Склад отправитель-Склад получатель 
		//Стоимость			Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии (партию определяем по ФИФО) 
		//					и умножаем на количество	
		//*
		
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			
			ТаблицаСтоимостиНоменклатурыПоВидуЦены = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоВидуЦены(ВидЦены, ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход); 
			РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход, ТаблицаСтоимостиНоменклатурыПоВидуЦены);
			
		Иначе
			
			ТаблицаСтоимостиНоменклатурыПоПартиям = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоПартиям(Дата, ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, Истина); 
			РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход, ТаблицаСтоимостиНоменклатурыПоПартиям);		
			
		КонецЕсли;
		
		ОбщегоНазначенияУТКлиентСервер.ДополнитьТаблицу(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СтоимостьТМЦ_УУ);
		ОбщегоНазначенияУТКлиентСервер.ДополнитьТаблицу(ТаблицаДвижений_СтоимостьТМЦ_УУ_Приход, ТаблицаДвижений_СтоимостьТМЦ_УУ);
		
		////
		//Движение по бит_ВыручкаИСебестоимость_УУ (Выручка и себестоимость продаж)
		//4.1.2	
		
		////СкладОтправитель
		//Номенклатура			Реквизит Номенклатура из ТЧ документа
		//Заказ клиента			Документ из реквизита Назначение ТЧ документа "Перемещение товаров"
		//Подразделение			Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. Далее ищем соответствие Подразделение 
		//						-ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. 
		//						И полученным ЦФО заполняем реквизит Подразделение.
		//Покупатель			Исходя из заполненного значение Подразделение (см. строка выше), необходимо найти соответствие 
		//						ЦФО-Контрагент с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия ЦФО-Контрагент. 
		//						И полученным Контрагентом заполняем реквизит Покупатель
		//Партия				В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
		//Тип реализации		Значение по умолчанию Внутренняя реализация
		//Менеджер				Реквизит Ответственный
		//Склад 				Склад отправитель
		//Соглашение			Если в  реквизите Назначение ТЧ документа указан Заказ Клиента, то необходимо вычислить Заказ покупателя 
		//						через цепочку назначений в виде Заказа на перемещение с РЦ на магазин, Заказа на перемещение с Фабрики на РЦ и т.д 
		//						и взять значение из реквизита Соглашение документа , если реквизит Назначение Пустой, то оставляем не заполненным. 
		//Договор				Если в  реквизите Назначение ТЧ документа указан Заказ Клиента, то необходимо вычислить Заказ покупателя 
		//						через цепочку назначений в виде Заказа на перемещение с РЦ на магазин, Заказа на перемещение с Фабрики на РЦ и т.д 
		//						и взять значение из реквизита Договор документа , если реквизит Назначение Пустой, то оставляем не заполненным. 
		//ХозяйственнаяОперация	Значение по умолчанию Перемещение товаров
		//Количество			Реквизит Количество из ТЧ документа
		//Сумма выручки			Определяем цену на данную номенклатуру, исходя из Вида цены, установленного в регистре сведений 
		//						"Соответствие складов и видов цен" для связки Склад Отправитель-Склад Получатель на дату Заказа покупателя 
		//						(реквизит Назначение ТЧ документа "Перемещение товаров", Заказ покупателя определяется аналогично описанному в в регистре 
		//						"Выручка и Себестоимость УУ -Соглашение), если оно не заполнено, то на дату выпуска данной партии номенклатуры 
		//						умноженную на количество товаров. Т.е. цена*количество 
		//Стоимость				Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии 
		//						(партию определяем по ФИФО) и умножаем на количество (Равно Стоимость в регистре "Стоимость ТМЦ УУ" к  документу"
		//Сумма скидки			Оставляем не заполненным
		//Вид скидки			Оставляем не заполненным
		//Доп.расходы			Оставляем не заполненным
		
		//4.2.2. В регистре не найдено соответствие Склад отправитель-Склад получатель //Движений не формируем.
		
		Если ВидЦены <> Справочники.ВидыЦен.ПустаяСсылка() Тогда
			
			//ТаблицаДвижений_СебестоимостьТоваров = ЭтотОбъект.Движения.СебестоимостьТоваров.Выгрузить();
			
			//ТаблицаДвижений_ВыручкаИСебестоимость_УУ = РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ПолучитьТаблицуДляДвижений();
			
			ЦФОКонтрагент = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(СоответствиеАналитикЦФОКонтрагент, ПодразделениеЦФОПолучатель, Дата);	
			
			РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ЗаполнитьТаблицуДвижений(ТаблицаДвижений_ВыручкаИСебестоимость_УУ, ТаблицаДвижений_СебестоимостьТоваров, СкладОтправитель, ПодразделениеЦФООтправитель, ЦФОКонтрагент, Регистратор.Ответственный);		
			
			ТаблицаСтоимостиНоменклатурыПоПартиям = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоПартиям(Дата, ТаблицаДвижений_ВыручкаИСебестоимость_УУ); 
			ТаблицаСтоимостиНоменклатурыПоВидуЦены = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоВидуЦены(ВидЦены, ТаблицаДвижений_ВыручкаИСебестоимость_УУ); 
			
			РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_ВыручкаИСебестоимость_УУ, ТаблицаСтоимостиНоменклатурыПоПартиям, ТаблицаСтоимостиНоменклатурыПоВидуЦены);		
			
		КонецЕсли;
		
		//СкладПолучатель
		//Движений в данном регистре не формируем.
		
		НаборЗаписей = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписей.Загрузить(ТаблицаДвижений_СтоимостьТМЦ_УУ);
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписей.Загрузить(ТаблицаДвижений_ВыручкаИСебестоимость_УУ);
		НаборЗаписей.Записать(Истина);
		
		//4.3
		////Движение по плану счетов бюджетирования
		
		РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ДополнитьСчетаУчатНоменклатуры(ТаблицаДвижений_ВыручкаИСебестоимость_УУ);
		РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ДополнитьСчетаУчатНоменклатуры(ТаблицаДвижений_СтоимостьТМЦ_УУ);
		
		//НаборПроводок = Движения.бит_Бюджетирование;
		
		НаборПроводок = РегистрыБухгалтерии.бит_Бюджетирование.СоздатьНаборЗаписей();
		НаборПроводок.Отбор.Регистратор.Установить(Регистратор);
		
		СкладОтправительЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СкладОтправитель.Подразделение, Дата);
		СкладПолучательЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СкладПолучатель.Подразделение, Дата);
			
		Если ВидЦены <> Справочники.ВидыЦен.ПустаяСсылка() Тогда	
			
			Для Каждого СтрокаДвижений Из ТаблицаДвижений_ВыручкаИСебестоимость_УУ Цикл
				
				Если ЗначениеЗаполнено(СтрокаДвижений.Количество) Тогда
					//4.1.3.1.Проводка №1.
					//Период.			Заполняется значением из документа, реквизит Дата.
					//Сценарий.			Заполняется значением ФАКТ
					//Организация.		Заполняется значением из документа, реквизит Организация.
					//ЦФО.				Изначально берем Подразделение из соответствия Склад-Подразделение в карточке склад, 
					//					для Склада отправителя. Далее ищем  соответствие СтруктураПредприятия_ЦФО с помощью 
					//					Документ.бит_НазначениеСоответствияАналитик,
