&НаСервере
Процедура бит_СоздатьУстановкуЦенНаСервере()
	// {{ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [17.05.2026 23:50:06] +        
	// найдем или создадим документ
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	УстановкаЦенНоменклатуры.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	                      |ГДЕ
	                      |	НЕ УстановкаЦенНоменклатуры.ПометкаУдаления
	                      |	И УстановкаЦенНоменклатуры.ДокументОснование = &ДокументОснование");
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Док = Выборка.Ссылка.ПолучитьОбъект();
		Док.Товары.Очистить();
		Док.Товары2_5.Очистить();
		Док.ВидыЦен.Очистить(); 
		Док.НаборыЗначенийДоступа.Очистить();
		Док.ДополнительныеРеквизиты.очистить();	
	Иначе
		Док = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		//Док.ДокументОснование = Объект.Ссылка; // заполнится само
	КонецЕсли;                                
	Док.Дата = Объект.Дата;
	Док.Ответственный = Пользователи.АвторизованныйПользователь();
	Док.Комментарий = "#(бит) Максимальные цены в категории";
	Док.Согласован = Истина;
	Док.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	//------------------------------------------------------------------------
	ЗаполнитьДокументУстановкаЦенНоменклатуры(Док, Объект.Ссылка);
	ТЧТовары = Док.Товары2_5.Выгрузить(, "Номенклатура, ХарактеристикаЦО");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МножителиПартийИПолуфабрикатов.Продукция КАК Номенклатура,
	                      |	МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции.ХарактеристикаНоменклатурыДляЦенообразования КАК ХарактеристикаЦО,
	                      |	СУММА(МножителиПартийИПолуфабрикатов.СтоимостьРегл) КАК Цена
	                      |ПОМЕСТИТЬ втСтоимости
	                      |ИЗ
	                      |	РегистрСведений.МножителиПартийИПолуфабрикатов КАК МножителиПартийИПолуфабрикатов
	                      |ГДЕ
	                      |	МножителиПартийИПолуфабрикатов.Калькуляция = &Калькуляция
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	МножителиПартийИПолуфабрикатов.Продукция,
	                      |	МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции,
	                      |	МножителиПартийИПолуфабрикатов.ХарактеристикаПродукции.ХарактеристикаНоменклатурыДляЦенообразования
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	тч.Номенклатура КАК Номенклатура,
	                      |	ВЫРАЗИТЬ(тч.ХарактеристикаЦО КАК Справочник.ХарактеристикиНоменклатурыДляЦенообразования) КАК ХарактеристикаЦО
	                      |ПОМЕСТИТЬ тч
	                      |ИЗ
	                      |	&тч КАК тч
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	тч.Номенклатура КАК Номенклатура,
	                      |	тч.ХарактеристикаЦО КАК ХарактеристикаЦО,
	                      |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение КАК Категория,
	                      |	ЕСТЬNULL(втСтоимости.Цена, 0) КАК Цена
	                      |ПОМЕСТИТЬ База
	                      |ИЗ
	                      |	тч КАК тч
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ДополнительныеРеквизитыЦенообразования КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
	                      |		ПО тч.ХарактеристикаЦО = ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка
	                      |			И (ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство = &СвойствоКатегория)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втСтоимости КАК втСтоимости
	                      |		ПО тч.Номенклатура = втСтоимости.Номенклатура
	                      |			И тч.ХарактеристикаЦО = втСтоимости.ХарактеристикаЦО
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	База.Категория КАК Категория,
	                      |	МАКСИМУМ(База.Цена) КАК Цена
	                      |ПОМЕСТИТЬ МаксЦенаВКатегории
	                      |ИЗ
	                      |	База КАК База
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	База.Категория
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	База.Номенклатура КАК Номенклатура,
	                      |	База.ХарактеристикаЦО КАК ХарактеристикаЦО,
	                      |	МаксЦенаВКатегории.Цена КАК Цена
	                      |ИЗ
	                      |	База КАК База
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксЦенаВКатегории КАК МаксЦенаВКатегории
	                      |		ПО База.Категория = МаксЦенаВКатегории.Категория");
	Запрос.УстановитьПараметр("тч", ТЧТовары);
	Запрос.УстановитьПараметр("Период", Объект.Дата);  
	
	РеквизитХарактеристикиКатегория = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиКатегория, , Истина);
	Запрос.УстановитьПараметр("СвойствоКатегория", РеквизитХарактеристикиКатегория);
	Запрос.УстановитьПараметр("ВидЦены", Док.ВидыЦен[0].ВидЦены);
	Запрос.УстановитьПараметр("Калькуляция", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаЦО");
	Пока Выборка.Следующий() Цикл
		СтруктураОтбора.Номенклатура = Выборка.Номенклатура;
		СтруктураОтбора.ХарактеристикаЦО = Выборка.ХарактеристикаЦО;
		СтрокиПоКлючу = Док.Товары2_5.НайтиСтроки(СтруктураОтбора);
		Для каждого стр из СтрокиПоКлючу Цикл
			стр.Цена = Выборка.Цена;	
		КонецЦикла;
		
	КонецЦикла;
	
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);
	Исключение
		Док.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ установки цены " + Док.Ссылка + " по причине " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Док.Ссылка);
	КонецПопытки;
	// }}ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [17.05.2026 23:50:06] -
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьДокументУстановкаЦенНоменклатуры(ДокументУстановки, ДанныеЗаполнения) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [18.05.2026 21:37:28] +        
	НаборВалют = Константы.СоздатьНабор("ВалютаРегламентированногоУчета, ВалютаУправленческогоУчета");
	НаборВалют.Прочитать();
	ВидЦеныДляУЦН = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ВидЦеныПроизводственнаяСебестоимость, , Истина);
	
	//ПлановыйВидЦены = Объект.ВидЦены;
	
	ТабличнаяЧастьТовары = "Товары2_5";
	ТекстЗапроса = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОбъектыКалькуляции.Номенклатура КАК Номенклатура,
			|	ОбъектыКалькуляции.Характеристика.ХарактеристикаНоменклатурыДляЦенообразования КАК ХарактеристикаЦО,
			|	ОбъектыКалькуляции.Номенклатура.ЕдиницаИзмерения КАК Упаковка,
			|	&ПлановыйВидЦены КАК ВидЦены,
			|	0 КАК Цена
			|ИЗ
			|	Документ.ПлановаяКалькуляция2_2.ОбъектыКалькуляции КАК ОбъектыКалькуляции
			|ГДЕ
			|	ОбъектыКалькуляции.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ПлановыйВидЦены", ВидЦеныДляУЦН);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не требуется вводить установку цен номенклатуры на основании документа %1';
				|en = 'It is not required to enter pricing of products based on document %1'"),
			ДанныеЗаполнения);
		ВызватьИсключение Текст;
		
	Иначе
		
		ДанныеТовары = РезультатЗапроса.Выгрузить();
		ДокументУстановки.ДокументОснование = ДанныеЗаполнения;
		ДокументУстановки[ТабличнаяЧастьТовары].Загрузить(РезультатЗапроса.Выгрузить());
		//
		//ДокументУстановки.ВидыЦен.Загрузить(ДанныеТовары);
		//Если ДанныеТовары.Найти(ПлановыйВидЦены, "ВидЦены") = Неопределено Тогда
			НовыйВидЦены = ДокументУстановки.ВидыЦен.Добавить();
			НовыйВидЦены.ВидЦены = ВидЦеныДляУЦН;
		//КонецЕсли;
		
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [18.05.2026 21:37:28] -
