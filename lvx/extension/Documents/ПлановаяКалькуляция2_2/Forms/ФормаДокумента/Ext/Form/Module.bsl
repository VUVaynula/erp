&НаКлиенте
Процедура бит_СоздатьУстановкуЦен()
	// {{ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [17.05.2026 23:39:02] +   
	Если Не Объект.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ не проведен");
		Возврат;
	КонецЕсли;
	РезультатРасчета = РезультатРасчетаКалькуляции(Объект.Ссылка);
	Если РезультатРасчета.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияРасчетаПлановойКалькуляции.Рассчитана") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Калькуляция не рассчитана");
		Возврат;
	КонецЕсли;
	
	бит_СоздатьУстановкуЦенНаСервере();
	// }}ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [17.05.2026 23:39:02] -
