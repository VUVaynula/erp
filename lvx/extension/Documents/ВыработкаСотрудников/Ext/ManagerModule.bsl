			|		&" + ИмяПараметраДаты + "
			|	) КАК Срез";

		ЧастиЗапроса.Добавить(ТекстЧасти);

	КонецЦикла;

	Запрос.Текст = СтрСоединить(ЧастиЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

	Возврат Запрос.Выполнить().Выгрузить();
