Функция НайтиРасценкуПоСтроке(Организация, Подразделение, стр, ИмяКолонкиДата, ТаблицаНастройки = Неопределено, ВидЦены = Неопределено) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.13]  [VUVaynula@1cbit.ru] [13.07.2026 20:06:13] +   
	Если ТаблицаНастройки = Неопределено Тогда      
		мДат = Новый Массив;
		мДат.Добавить(стр[ИмяКолонкиДата]);
		ТаблицаНастройки = ПолучитьТаблицуНастройки(мДат);
	КонецЕсли;
	
	Если ВидЦены = Неопределено Тогда
		ВидЦены = Константы.ВидЦеныПлановойСтоимостиМатериаловРабот.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ----------------------------------------------------------------
	Док = Документы.ПлановаяКалькуляция2_2.СоздатьДокумент();
	Док.Организация = Организация;
	Док.Дата = стр[ИмяКолонкиДата];
	Док.ПодразделениеДиспетчер = Подразделение;
	Док.ОбъектКалькуляции = Перечисления.ОбъектыКалькуляции.РесурснаяСпецификация;
	Док.ВидЦены = ВидЦены;
	
	нов = Док.ОбъектыКалькуляции.Добавить();
	нов.Номенклатура = стр.Распоряжение.Спецификация.ОсновноеИзделиеНоменклатура;
	нов.Объект = стр.Распоряжение.Спецификация;
	нов.Упаковка = нов.Номенклатура.ЕдиницаИзмерения;
	нов.Количество = 1;
	нов.КоличествоУпаковок = 1;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	рс.Состояние КАК Состояние
	                      |ИЗ
	                      |	РегистрСведений.СостоянияПлановыхКалькуляций КАК рс
	                      |ГДЕ
	                      |	рс.Калькуляция = &Калькуляция
						  |	И рс.Состояние В(&мСостояний)
						  |");
	мСостояний = новый Массив;
	мСостояний.Добавить(Перечисления.СостоянияРасчетаПлановойКалькуляции.Рассчитана);
	мСостояний.Добавить(Перечисления.СостоянияРасчетаПлановойКалькуляции.РассчитанаСОшибками);
	мСостояний.Добавить(Перечисления.СостоянияРасчетаПлановойКалькуляции.ОшибкаРасчета);
	
	Состояние = Неопределено;
	
	Запрос.УстановитьПараметр("мСостояний", мСостояний);
	
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Запрос.УстановитьПараметр("Калькуляция", Док.Ссылка);
		
		ТемпДата = ТекущаяДатаСеанса();
		
		Пока ТекущаяДатаСеанса() < ТемпДата + 120 Цикл
			результат = Запрос.Выполнить().Выбрать();
			Если результат.Следующий() Тогда
				Состояние = результат.Состояние;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если состояние = Перечисления.СостоянияРасчетаПлановойКалькуляции.Рассчитана Тогда
			Запрос.УстановитьПараметр("ТаблицаНастройки", ТаблицаНастройки);   
			Запрос.УстановитьПараметр("ДанныеПоСебестоимости", 0); // 0 - без ндс 
			Запрос.УстановитьПараметр("ВидРабот", стр.ВидРабот);
			Запрос.Текст = ЗапросПостатейныхЗатрат();
			
			Результат = Запрос.Выполнить().Выбрать();
			Если результат.Следующий() Тогда
				расценка = результат.СтоимостьЕдиницы;
			Иначе            
				расценка = 0;
			КонецЕсли;       
			Если расценка = Null Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректно рассчитана калькуляция. Ошибка в проводках. " 
																+ стр.ВидРабот + " " 
																+ стр.Распоряжение + " " 
																+ стр.СтатьяКалькуляции + " " 
																+ нов.Номенклатура);
				расценка = 0;
				
			ИначеЕсли расценка = 0 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не рассчитана расценка на вид работ " + стр.ВидРабот + ". Проверьте корректность сопоставления видов работ статье затрат в регистре `Связь процентных видов работ и статей затрат`, статьи калькуляции в спецификации готовой продукции и установку нормативов производственных расходов для статьи затрат или рассчитайте и укажите стоимость вида работ вручную");
				
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось рассчитать калькуляцию для " 
																+ стр.ВидРабот + " " 
																+ стр.Распоряжение + " " 
																+ стр.СтатьяКалькуляции + " " 
																+ нов.Номенклатура + " "
																+ " Статус расчета калькуляции: " + Состояние);
			Расценка = Неопределено;
			
		КонецЕсли;
		
		Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Док.Удалить();
			
	Возврат Расценка;
	// }}ПервыйБИТ ЛистТребований [ЛТ6.13]  [VUVaynula@1cbit.ru] [13.07.2026 20:06:13] -
