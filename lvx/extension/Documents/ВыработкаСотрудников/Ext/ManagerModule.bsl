Функция бит_СвойРасчетСтоимостиВидаРаботЛТ6_13(Таблица, Организация, Подразделение) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.13]  [VUVaynula@1cbit.ru] [13.07.2026 18:30:45] +  
	Если Таблица.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("Дата") <> Неопределено Тогда
		ИмяКолонкиДата = "Дата";
	Иначе
		ИмяКолонкиДата = "ДатаВыполненияРабот";
	КонецЕсли;
	// ------------------------------------------------------	
	КонтекстРассчитанных = Новый ТаблицаЗначений;
	КонтекстРассчитанных.Колонки.Добавить("ВидРабот");
	КонтекстРассчитанных.Колонки.Добавить("СтатьяКалькуляции"); 
	КонтекстРассчитанных.Колонки.Добавить(ИмяКолонкиДата);
	КонтекстРассчитанных.Колонки.Добавить("РасценкаЕдиницы");
	// ------------------------------------------------------
	// получим данные из регистра настроек
	ТаблицаДат = Таблица.Скопировать(, ИмяКолонкиДата);
	ТаблицаДат.Свернуть(ИмяКолонкиДата); 
	ТаблицаНастройки = ПолучитьТаблицуНастройки(ТаблицаДат.ВыгрузитьКолонку(ИмяКолонкиДата));
	// ------------------------------------------------------
	Для каждого стр из Таблица Цикл
		Если ТаблицаНастройки.НайтиСтроки(Новый Структура("ВидРабот", стр.ВидРабот)).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиПоКлючу = КонтекстРассчитанных.НайтиСтроки(Новый Структура("ВидРабот, СтатьяКалькуляции, " + ИмяКолонкиДата, стр.ВидРабот, стр.СтатьяКалькуляции, стр[ИмяКолонкиДата]));
		Если СтрокиПоКлючу.Количество() Тогда 
			РасценкаЕдиницы = СтрокиПоКлючу[0].РасценкаЕдиницы; 
		Иначе
			РасценкаЕдиницы = НайтиРасценкуПоСтроке(Организация, Подразделение, стр, ИмяКолонкиДата, ТаблицаНастройки);  
			
			нов = КонтекстРассчитанных.Добавить();	
			ЗаполнитьЗначенияСвойств(нов, стр);
			нов.РасценкаЕдиницы = РасценкаЕдиницы;
		КонецЕсли;
		
		Если РасценкаЕдиницы <> Неопределено Тогда             
			стр.Расценка = РасценкаЕдиницы; //* стр.Распоряжение.КоличествоУпаковокФакт;
			стр.Сумма = стр.КоличествоКОплате * стр.Расценка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Таблица;	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.13]  [VUVaynula@1cbit.ru] [13.07.2026 18:30:45] -
