
Процедура бит_СформироватьДвижения(Регистратор, ТаблицаДвиженийСебестоимостьТоваров) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8.3] [ASHolyavko@1cbit.ru] [06.05.2026] +        
	
	Дата = Регистратор.Дата;
	Организация = Регистратор.Организация;
	Склад = Регистратор.Склад;
	Подразделение = Регистратор.Подразделение;
	ПодразделениеЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, Склад.Подразделение, Дата);
	
	СкладЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, Склад.Подразделение, Дата);
	//СкладПолучательЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, СкладПолучатель.Подразделение, Дата);
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.Ссылка КАК Ссылка,
		|	Товары.Ссылка.Организация КАК Организация,
		|	Товары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ВидыЗапасов.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	Товары.КлючСвязи КАК КлючСвязи,
		|	Товары.КоличествоУпаковок КАК Количество,
		|	Товары.СуммаСНДС КАК СуммаСНДС
		|ПОМЕСТИТЬ вт_Товары
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК ВидыЗапасов
		|		ПО Товары.Ссылка = ВидыЗапасов.Ссылка
		|			И Товары.АналитикаУчетаНоменклатуры = ВидыЗапасов.АналитикаУчетаНоменклатуры
		|ГДЕ
		|	Товары.Ссылка = &Регистратор
		|	И ВидыЗапасов.Ссылка = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СкидкиНаценки.Ссылка КАК Ссылка,
		|	СкидкиНаценки.КлючСвязи КАК КлючСвязи,
		|	СкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
		|	СкидкиНаценки.СкидкаНаценка.бит_СкидкаЗаСчет КАК СкидкаЗаСчет,
		|	СкидкиНаценки.Сумма КАК СуммаСкидки
		|ПОМЕСТИТЬ вт_Скидки
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.СкидкиНаценки КАК СкидкиНаценки
		|ГДЕ
		|	СкидкиНаценки.Ссылка = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Товары.Ссылка КАК Ссылка,
		|	вт_Товары.Организация КАК Организация,
		|	вт_Товары.Ссылка.Подразделение КАК Подразделение,
		|	вт_Товары.КлючСвязи КАК КлючСвязи,
		|	вт_Товары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	вт_Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	вт_Скидки.СкидкаНаценка КАК СкидкаНаценка,
		|	вт_Скидки.СкидкаЗаСчет КАК СкидкаЗаСчет,
		|	вт_Товары.Количество КАК Количество,
		|	вт_Скидки.СуммаСкидки КАК СуммаСкидки,
		|	вт_Скидки.СуммаСкидки / вт_Товары.Количество КАК СкидкаНаЕдиницу,
		|	вт_Товары.СуммаСНДС КАК СуммаСНДС,
		|	вт_Товары.СуммаСНДС / вт_Товары.Количество КАК Цена
		|ПОМЕСТИТЬ вт_СкидкиВДокументе
		|ИЗ
		|	вт_Товары КАК вт_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Скидки КАК вт_Скидки
		|		ПО вт_Товары.Ссылка = вт_Скидки.Ссылка
		|			И вт_Товары.КлючСвязи = вт_Скидки.КлючСвязи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_СкидкиВДокументе.Ссылка КАК Ссылка,
		|	вт_СкидкиВДокументе.Организация КАК Организация,
		|	Склады.Ссылка КАК Склад,
		|	Склады.Подразделение КАК ПодразделениеСклада,
		|	вт_СкидкиВДокументе.СкидкаЗаСчет КАК СкидкаЗаСчет,
		|	ДействиеСкидокНаценокСрезПоследних.СкидкаНаценка КАК СкидкаНаценка,
		|	ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.НеДействует)) КАК Статус,
		|	ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.НеДействует)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.Действует)
		|		И вт_СкидкиВДокументе.СкидкаЗаСчет <> &ПодразделениеЦФО
		|		И вт_СкидкиВДокументе.СкидкаЗаСчет <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|		И (&Дата МЕЖДУ ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) И ВЫБОР
		|				КОГДА ДействиеСкидокНаценокСрезПоследних.Период ЕСТЬ NULL
		|					ТОГДА ЕСТЬNULL(ДОБАВИТЬКДАТЕ(ДействиеСкидокНаценокСрезПервых.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|				ИНАЧЕ ЕСТЬNULL(ДОБАВИТЬКДАТЕ(Таблица.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|			КОНЕЦ
		|			ИЛИ &Дата > ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1))
		|				И ВЫБОР
		|					КОГДА ДействиеСкидокНаценокСрезПоследних.Период ЕСТЬ NULL
		|						ТОГДА ЕСТЬNULL(ДОБАВИТЬКДАТЕ(ДействиеСкидокНаценокСрезПервых.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|					ИНАЧЕ ЕСТЬNULL(ДОБАВИТЬКДАТЕ(Таблица.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|				КОНЕЦ = ДАТАВРЕМЯ(1, 1, 1)) КАК Использование,
		|	ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
		|	ВЫБОР
		|		КОГДА ДействиеСкидокНаценокСрезПоследних.Период ЕСТЬ NULL
		|			ТОГДА ЕСТЬNULL(ДОБАВИТЬКДАТЕ(ДействиеСкидокНаценокСрезПервых.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|		ИНАЧЕ ЕСТЬNULL(ДОБАВИТЬКДАТЕ(Таблица.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
		|	КОНЕЦ КАК ДатаОкончания,
		|	вт_СкидкиВДокументе.КлючСвязи КАК КлючСвязи,
		|	вт_СкидкиВДокументе.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	вт_СкидкиВДокументе.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	вт_СкидкиВДокументе.СуммаСкидки КАК СуммаСкидки,
		|	вт_СкидкиВДокументе.Количество КАК Количество,
		|	вт_СкидкиВДокументе.СкидкаНаЕдиницу КАК СкидкаНаЕдиницу,
		|	вт_СкидкиВДокументе.Цена КАК Цена
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
		|				&Дата,
		|				СкидкаНаценка В
		|						(ВЫБРАТЬ
		|							вт_Скидки.СкидкаНаценка КАК СкидкаНаценка
		|						ИЗ
		|							вт_Скидки КАК вт_Скидки)
		|					И Источник ССЫЛКА Справочник.Склады) КАК ДействиеСкидокНаценокСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт_СкидкиВДокументе КАК вт_СкидкиВДокументе
		|			ПО ДействиеСкидокНаценокСрезПоследних.СкидкаНаценка = вт_СкидкиВДокументе.СкидкаНаценка
		|		ПО (ДействиеСкидокНаценокСрезПоследних.Источник = Склады.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МИНИМУМ(Т.Период) КАК Период,
		|			Т.Источник КАК Источник,
		|			Срез.СкидкаНаценка КАК СкидкаНаценка
		|		ИЗ
		|			РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(
		|					&Дата,
		|					СкидкаНаценка В
		|							(ВЫБРАТЬ
		|								вт_Скидки.СкидкаНаценка КАК СкидкаНаценка
		|							ИЗ
		|								вт_Скидки КАК вт_Скидки)
		|						И Источник ССЫЛКА Справочник.Склады) КАК Срез
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеСкидокНаценок КАК Т
		|				ПО Срез.Источник = Т.Источник
		|					И (Т.СкидкаНаценка В
		|						(ВЫБРАТЬ
		|							вт_Скидки.СкидкаНаценка КАК СкидкаНаценка
		|						ИЗ
		|							вт_Скидки КАК вт_Скидки))
		|					И (Т.Период > Срез.Период)
		|					И (Т.Статус <> Срез.Статус)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			Т.Источник,
		|			Срез.СкидкаНаценка) КАК Таблица
		|		ПО (Таблица.Источник = Склады.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеСкидокНаценок.СрезПервых(
		|				&Дата,
		|				СкидкаНаценка В
		|						(ВЫБРАТЬ
		|							вт_Скидки.СкидкаНаценка КАК СкидкаНаценка
		|						ИЗ
		|							вт_Скидки КАК вт_Скидки)
		|					И Источник ССЫЛКА Справочник.Склады) КАК ДействиеСкидокНаценокСрезПервых
		|		ПО (ДействиеСкидокНаценокСрезПервых.Источник = Склады.Ссылка)
		|ГДЕ
		|	НЕ Склады.ЭтоГруппа
		|	И Склады.Ссылка = &Склад";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ПодразделениеЦФО", ПодразделениеЦФО);
	
	ТаблицаСкидок = Запрос.Выполнить().Выгрузить();		
	
		
	ТаблицаДвижений_СебестоимостьТоваров = ТаблицаДвиженийСебестоимостьТоваров;
	
	ТаблицаДвижений_СтоимостьТМЦ_УУ = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
	ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
	
	ТаблицаДвижений_ВыручкаИСебестоимость_УУ = РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ПолучитьТаблицуДляДвижений();
		
	//1. Регистр накопления "Стоимость ТМЦ УУ".
	//Вид движения				Расход
	//Номенклатура				Реквизит Номенклатура из ТЧ документа
	//ГФУ						Реквизит Группа финансового учета в карточке Номенклатура
	//Организация				Реквизит Организация документа
	//Партия					В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
	//Склад						Реквизит Склад 
	//Подразделение				Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. 
	//							Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, 
	//							с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем реквизитПодразделение..
	//Количество				Реквизит Количество из ТЧ документа
	//Стоимость					Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии (партию определяем по ФИФО) и умножаем на количество.
	//Доп.расходы				Оставляем не заполненным 
		
	РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьТаблицуДвиженийПоВидуДвижения(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СебестоимостьТоваров, ВидДвиженияНакопления.Расход, Склад, ПодразделениеЦФО);		
	
	ТаблицаСтоимостиНоменклатурыПоПартиям = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоПартиям(Дата, ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, Истина); 
	
	РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаСтоимостиНоменклатурыПоПартиям);
	
	ОбщегоНазначенияУТКлиентСервер.ДополнитьТаблицу(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СтоимостьТМЦ_УУ);
		
	//2. Регистр накопления "Выручка и себестоимость  УУ"
	//2.1.Если скидок в документе нет.	
	//Номенклатура				Реквизит Номенклатура из ТЧ документа
	//Заказ клиента				Если в  реквизите Назначение ТЧ документа указан Заказ Клиента, то заполняем этим значением. 
	//							Иначе оставляем пустым
	//Подразделение				Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем реквизит Подразделение.
	//Покупатель				Заполняем значением из реквизита Клиент 
	//Партия					В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
	//Тип реализации			Значение по умолчанию Внешняя реализация
	//Менеджер					Реквизит Менеджер
	//Склад	           	 		Склад 	
	//Соглашение				Заполняем значением из реквизита Соглашение 
	//Договор					Заполняем значением из реквизита Договор
	//ХозяйственнаяОперация		Значение по умолчанию Реализация
	//Количество				Реквизит Количество из ТЧ документа
	//Сумма выручки				Заполняем значением из реквизита Сумма с НДС, установленного в ТЧ Товары.
	//Стоимость					Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии 
	//							(партию определяем по ФИФО) и умножаем на количество.
	//Сумма скидки				Оставляем не заполненным
	//Вид скидки				Оставляем не заполненным
	//Доп.расходы				Оставляем не заполненным
	
	ПодразделениеЦФОПолучатель = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, Склад.Подразделение, Дата);
	
	СоответствиеАналитикЦФОКонтрагент = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("СоответствиеАналитикЦФОКонтрагент", , Истина);
			
	ЦФОКонтрагент = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(СоответствиеАналитикЦФОКонтрагент, ПодразделениеЦФОПолучатель, Дата);	
	
	РегистрыНакопления.бит_ВыручкаИСебестоимость_УУ.ЗаполнитьТаблицуДвижений(ТаблицаДвижений_ВыручкаИСебестоимость_УУ, ТаблицаДвижений_СебестоимостьТоваров, Склад, ПодразделениеЦФО, ЦФОКонтрагент, Регистратор.Менеджер);		
	
