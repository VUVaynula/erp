Функция ПолучитьФайлыГП(МассивОбъектов) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ6.10]  [VUVaynula@1cbit.ru] [10.07.2026 0:58:03] +        
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.Распоряжение КАК Распоряжение
	                      |ПОМЕСТИТЬ база
	                      |ИЗ
	                      |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	                      |ГДЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка В(&МассивОБъектов)
	                      |	И ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.бит_ПечатьПаспорта
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК Количество,
	                      |	НоменклатураПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл
	                      |ИЗ
	                      |	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	                      |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ база КАК база
	                      |			ПО ЗаказНаПроизводство2_2Продукция.Назначение = база.Назначение
	                      |				И ЗаказНаПроизводство2_2Продукция.Ссылка = база.Распоряжение
	                      |		ПО НоменклатураПрисоединенныеФайлы.ВладелецФайла = ЗаказНаПроизводство2_2Продукция.Номенклатура
	                      |ГДЕ
	                      |	НоменклатураПрисоединенныеФайлы.бит_ТипПрикрепленногоФайла = &Паспорт
	                      |	И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	НоменклатураПрисоединенныеФайлы.Ссылка");
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Паспорт", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ТипПрисоединенногоФайлаПаспорт, , Истина));
	Выборка = Запрос.Выполнить().Выбрать();
	
	ФайлыКПечати = Новый Массив;	
	Пока Выборка.Следующий() Цикл
		
		Для Номер = 1 По Выборка.Количество Цикл
			ФайлыКПечати.Добавить(Выборка.ПрисоединенныйФайл);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ФайлыКПечати;
	
