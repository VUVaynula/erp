&НаСервереБезКонтекста
Функция ПолучитьФайлыГПНаСервере(ТекЭтап)
	// {{ПервыйБИТ ЛистТребований [ЛТ6.10]  [VUVaynula@1cbit.ru] [10.07.2026 1:55:11] +        
	Если не ТекЭтап.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ТекЭтап + "Не проведен. Пропущен");
		Возврат Новый Массив;
	ИначеЕсли ТекЭтап.бит_ПечатьПаспорта = Ложь Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Из этапа " + ТекЭтап + " не печатается паспорт ГП");
		Возврат Новый Массив;
	КонецЕсли;  
	
	МассивЭтапов = Новый Массив;
	МассивЭтапов.Добавить(ТекЭтап);
	
	Возврат Документы.ЭтапПроизводства2_2.ПолучитьФайлыГП(МассивЭтапов);
	// }}ПервыйБИТ ЛистТребований [ЛТ6.10]  [VUVaynula@1cbit.ru] [10.07.2026 1:55:11] -
КонецФункции
