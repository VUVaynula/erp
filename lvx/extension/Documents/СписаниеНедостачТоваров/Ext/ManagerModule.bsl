
Процедура бит_СформироватьДвижения(Регистратор, ТаблицаДвиженийСебестоимостьТоваров) Экспорт
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8.2] [ASHolyavko@1cbit.ru] [06.05.2026] +
	
	Дата = Регистратор.Дата;
	Организация = Регистратор.Организация;
	Склад = Регистратор.Склад;
	Подразделение = Регистратор.Склад.Подразделение;
	СтатьяРасходов = Регистратор.СтатьяРасходов;
	
	ПодразделениеЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, Подразделение, Дата);
	
	ТаблицаДвижений_СебестоимостьТоваров = ТаблицаДвиженийСебестоимостьТоваров;
	
	ТаблицаДвижений_СтоимостьТМЦ_УУ = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
	ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьТаблицуДляДвижений();
	
	//Движения в Регистр накопления "Стоимость ТМЦ УУ".
	//Вид движения		Расход
	//Номенклатура		Реквизит Номенклатура из ТЧ документа. Если номенклатура имеет серийный учет/характеристику, то движения формируем с учетом этого.
	//ГФУ				Реквизит Группа финансового учета в карточке Номенклатура
	//Организация		Реквизит Организация документа
	//Партия			В соответствии с типовым механизмом ЕРП по определению партии номенклатуры
	//Склад				Реквизит Склад 
	//Подразделение		Получаем Подразделение из соответствия Склад-Подразделение в карточке склад. Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем реквизитПодразделение..
	//Количество		Реквизит Количество из ТЧ документа
	//Стоимость			Определяем цену на данную номенклатуру, исходя из партии номенклатуры и цены номенклатуры в этой партии (партию определяем по ФИФО) и умножаем на количество
	//Доп.расходы		Оставляем не заполненным
	
	РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьТаблицуДвиженийПоВидуДвижения(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СебестоимостьТоваров, ВидДвиженияНакопления.Расход, Склад, ПодразделениеЦФО);		
	ТаблицаСтоимостиНоменклатурыПоПартиям = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ПолучитьСтоимостьНоменклатурыПоПартиям(Дата, ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход); 
	
	РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ЗаполнитьСтоимостьВТаблицеДвижений(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаСтоимостиНоменклатурыПоПартиям);
	
	ОбщегоНазначенияУТКлиентСервер.ДополнитьТаблицу(ТаблицаДвижений_СтоимостьТМЦ_УУ_Расход, ТаблицаДвижений_СтоимостьТМЦ_УУ);
	
	НаборЗаписей = РегистрыНакопления.бит_СтоимостьТМЦ_УУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Загрузить(ТаблицаДвижений_СтоимостьТМЦ_УУ);
	НаборЗаписей.Записать();
	
	////Движение по плану счетов бюджетирования
	
	РегистрыНакопления.бит_СтоимостьТМЦ_УУ.ДополнитьСчетаУчатНоменклатуры(ТаблицаДвижений_СтоимостьТМЦ_УУ);
	
	НаборПроводок = РегистрыБухгалтерии.бит_Бюджетирование.СоздатьНаборЗаписей();
	НаборПроводок.Отбор.Регистратор.Установить(Регистратор);
	
	//Период.			Заполняется значением из документа, реквизит Дата.
	//Сценарий.			Заполняется значением ФАКТ
	//Организация.		Заполняется значением из документа, реквизит Организация.
	//ЦФО.				Изначально берем Подразделение из соответствия Склад-Подразделение в карточке склад, для Склада. Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. И заполняем полученным ЦФО 
	//Статья оборотов.	Из реквизита Статья списания (ПланВидовХарактеристик Статьи Расходов) берем Статью расходов и ищем  соответствие Статьи расходов- Статьи оборотов с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Статьи расходов --> статьи оборотов и заполняем полученным значением.
	//Счет Дебет. 		Заполняется значением Счет учета в Группа финансового учета регл. из Статьи расходов в реквизите Статья списания.
	//Субконто Дт 1. 	Изначально берем Подразделение из соответствия Склад-Подразделение в карточке склад, для Склада получателя. Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем субконто
	//Субконто Дт 2. 	Заполняется значением из Статья оборотов.
	//Счет  Кредит. 	Заполняется значением Счет учета в Группа финансового учета из реквизита Номенклатура (ТЧ документа). Если счет учета не заполнен, то выводить сообщение ГФУ Номенклатуры не заполнено
	//Количество. 		Заполняется значением из Реквизит Количество из ТЧ документа
	//Субконто Кт 1. 	Изначально берем Подразделение из соответствия Склад-Подразделение в карточке склад, для Склада. Далее ищем  соответствие Подразделение -ЦФО с помощью Документ.бит_НазначениеСоответствияАналитик, с видом соответствия Структура предприятия --> ЦФО. И полученным ЦФО заполняем субконто
	//Субконто Кт 2.	Заполняем значением реквизита Номенклатура из ТЧ документа 
	//Субконто Кт 3. 	Заполняем значением из реквизита Склад
	//Количество. 		Заполняем значением из Количество (ТЧ документа)
	//Сумма Сценария. 	Заполняем значением из Стоимость в Регистре накопления "Стоимость ТМЦ УУ", сформированному к этому документу.
	//Сумма Упр. 		Заполняется аналогично Сумма сценария
	//Сумма Регл 		Заполняется аналогично Сумма сценария
	//Содержание. 		Заполняем значением Списание недостачи.
	
	СкладЦФО = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(Справочники.бит_ВидыСоответствийАналитик.СтруктураПредприятия_ЦФО, Склад.Подразделение, Дата);
	СоответствиеАналитикСтатьиРасходовСтатьиОборотов = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("СоответствиеАналитикСтатьиРасходовСтатьиОборотов", , Истина);
	СтатьяОборотов = РегистрыСведений.бит_СоответствияАналитик.ПолучитьПравуюАналитику(СоответствиеАналитикСтатьиРасходовСтатьиОборотов, СтатьяРасходов, Дата);
	
	СчетДТ = ПланыСчетов.бит_Бюджетирование.ПустаяСсылка();
	СоответствиеАналитикСчетаУчета = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений("СоответствиеАналитикСчетаУчета", Неопределено, Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокОтраженияНаСчетахУчета.АналитикаУчета КАК АналитикаУчета,
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета КАК СчетУчета,
	|	бит_СоответствияАналитикСрезПоследних.ПраваяАналитика_1 КАК СчетБюджетирования
	|ИЗ
	|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияНаСчетахУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СоответствияАналитик.СрезПоследних(&Дата, ВидСоответствия = &ВидСоответствия) КАК бит_СоответствияАналитикСрезПоследних
	|		ПО ПорядокОтраженияНаСчетахУчета.СчетУчета = бит_СоответствияАналитикСрезПоследних.ЛеваяАналитика_1
	|ГДЕ
	|	ПорядокОтраженияНаСчетахУчета.АналитикаУчета = &АналитикаУчета";
	
	Запрос.УстановитьПараметр("АналитикаУчета", СтатьяРасходов.ГруппаФинансовогоУчета);
	Запрос.УстановитьПараметр("ВидСоответствия", СоответствиеАналитикСчетаУчета);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СчетДТ = ВыборкаДетальныеЗаписи.СчетБюджетирования;
	КонецЦикла;
	
	Для Каждого СтрокаДвижений Из ТаблицаДвижений_СтоимостьТМЦ_УУ Цикл
		
		Если СтрокаДвижений.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			
			Проводка = НаборПроводок.Добавить();
			Проводка.Регистратор = Регистратор;
			
			Проводка.Период = Дата;
			Проводка.Сценарий = Справочники.СценарииПланирования.ФАКТ;
			Проводка.ЦФО = СкладЦФО;
			Проводка.СтатьяОборотов = СтатьяОборотов;
			
			Проводка.Организация = Организация;
			
			Проводка.СчетДт = СчетДТ;
			бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СкладЦФО);
			бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтатьяОборотов);
			//Проводка.КоличествоДт = СтрокаДвижений.Количество;
			
			Проводка.СчетКт = СтрокаДвижений.СчетУчетаБюджет;
			бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СкладЦФО);
			бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДвижений.Номенклатура.Номенклатура);
			бит_БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, Склад);	
			Проводка.КоличествоКт = СтрокаДвижений.Количество;
			
			Проводка.СуммаСценарий = СтрокаДвижений.Стоимость;
			Проводка.СуммаУпр = Проводка.СуммаСценарий;
			Проводка.СуммаРегл = Проводка.СуммаСценарий;
			
			Проводка.Содержание = "Списание недостачи";
			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборПроводок.Записать(Истина);
	
	// }}ПервыйБИТ ЛистТребований [ЛТ8.2] [ASHolyavko@1cbit.ru] [06.05.2026] -	
	
КонецПроцедуры
