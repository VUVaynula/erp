	СтруктураОтбора = Новый Структура("ВидНоменклатуры", ВидНоменклатуры);
	СтрокиСерий = СуществующиеСерии.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиСерий.Количество() = 0 Тогда
