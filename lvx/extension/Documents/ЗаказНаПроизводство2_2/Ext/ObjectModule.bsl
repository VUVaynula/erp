	Для Каждого ОписаниеСерии Из СуществующиеСерии Цикл
		Если ВидыНоменклатурыКГенерации.Получить(ОписаниеСерии.ВидНоменклатуры) = Неопределено Тогда
			УдалитьСериюНоменклатуры(ОписаниеСерии.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеВида Из ВидыНоменклатурыКГенерации Цикл
		СерияНоменклатуры = НайтиСериюПоВиду(СуществующиеСерии, ОписаниеВида.Ключ);
		Если СерияНоменклатуры = Неопределено Тогда
			СерияНоменклатуры = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		Иначе
			СерияНоменклатуры = СерияНоменклатуры.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьСериюНоменклатуры(СерияНоменклатуры, ОписаниеВида.Ключ);
		СерияНоменклатуры.Записать();
