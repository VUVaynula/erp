&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("АдресГруппировок") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеГруппировок = ПолучитьИзВременногоХранилища(Параметры.АдресГруппировок);
	Если ДанныеГруппировок = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Группировки.Загрузить(ДанныеГруппировок);
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	КлючиГруппировок = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.Группировки.ВыделенныеСтроки Цикл
		СтрокаГруппировки = Группировки.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаГруппировки <> Неопределено Тогда
			КлючиГруппировок.Добавить(СтрокаГруппировки.КлючГруппировки);
		КонецЕсли;
	КонецЦикла;
	
	Если КлючиГруппировок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не выбрана ни одна группировка для печати. (Лист требований ЛТ6.9)");
		Возврат;
	КонецЕсли;
	
	Закрыть(КлючиГруппировок);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

