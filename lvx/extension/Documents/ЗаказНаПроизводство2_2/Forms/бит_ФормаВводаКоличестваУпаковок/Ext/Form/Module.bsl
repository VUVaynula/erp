// {{ПервыйБИТ Лист требований [ЛТ6.8] [Микляев К.А.] [15.07.2026] +

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("АдресСтрокПродукции") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ДанныеСтрок = ПолучитьИзВременногоХранилища(Параметры.АдресСтрокПродукции);
	Если ДанныеСтрок = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СтрокиПродукции.Загрузить(ДанныеСтрок);

	УстановитьДоступностьПечати(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КоличествоУпаковокПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.СтрокиПродукции.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Одинаковое количество упаковок для всех строк с той же номенклатурой - требование ЛТ.
	Для Каждого СтрокаТаблицы Из СтрокиПродукции Цикл
		Если СтрокаТаблицы.Номенклатура = ТекущаяСтрока.Номенклатура Тогда
			СтрокаТаблицы.КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок;
		КонецЕсли;
	КонецЦикла;

	УстановитьДоступностьПечати(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПечати(Форма)

	ВсеЗаполнены = Истина;
	Для Каждого СтрокаТаблицы Из Форма.СтрокиПродукции Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КоличествоУпаковок) Тогда
			ВсеЗаполнены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Форма.Элементы.Печать.Доступность = ВсеЗаполнены;

КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)

	КоличествоУпаковокПоСтрокам = Новый Массив;

	Для Каждого СтрокаТаблицы Из СтрокиПродукции Цикл

		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КоличествоУпаковок) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не указано количество упаковок во всех строках. (Лист требований ЛТ6.8)");
			Возврат;
		КонецЕсли;

		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("НомерСтроки", СтрокаТаблицы.НомерСтроки);
		ДанныеСтроки.Вставить("Номенклатура", СтрокаТаблицы.Номенклатура);
		ДанныеСтроки.Вставить("Характеристика", СтрокаТаблицы.Характеристика);
		ДанныеСтроки.Вставить("КоличествоУпаковок", СтрокаТаблицы.КоличествоУпаковок);

		КоличествоУпаковокПоСтрокам.Добавить(ДанныеСтроки);

	КонецЦикла;

	Закрыть(КоличествоУпаковокПоСтрокам);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть();

КонецПроцедуры

