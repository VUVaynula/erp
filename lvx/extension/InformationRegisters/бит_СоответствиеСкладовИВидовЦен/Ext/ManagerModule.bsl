// Получает данные вида цен по соответствию.
//
// Параметры:
//  ДатаОтбора - ДатаОтбора дата на которую необходимо получить вид цен.
//  СкладОтправитель - склад отправитель.
//  СкладПолучатель - склад получатель.
//
// Возвращаемое значение:
//  Структура - "Период, ВидЦен".
//
Функция ПолучитьВидЦен(ДатаОтбора, СкладОтправитель, СкладПолучатель) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Период", '00010101');
	Результат.Вставить("ВидЦены", Справочники.ВидыЦен.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СоответствиеСкладовИВидовЦенСрезПоследних.Период КАК Период,
		|	бит_СоответствиеСкладовИВидовЦенСрезПоследних.СкладОтправитель КАК СкладОтправитель,
		|	бит_СоответствиеСкладовИВидовЦенСрезПоследних.СкладПолучатель КАК СкладПолучатель,
		|	бит_СоответствиеСкладовИВидовЦенСрезПоследних.ВидЦены КАК ВидЦены
		|ИЗ
		|	РегистрСведений.бит_СоответствиеСкладовИВидовЦен.СрезПоследних(
		|			&ДатаОтбора,
		|			СкладОтправитель = &СкладОтправитель
		|				И СкладПолучатель = &СкладПолучатель) КАК бит_СоответствиеСкладовИВидовЦенСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОтбора", ДатаОтбора);
	Запрос.УстановитьПараметр("СкладОтправитель", СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Результат.Период = ВыборкаДетальныеЗаписи.Период;
		Результат.ВидЦены = ВыборкаДетальныеЗаписи.ВидЦены;
		
		Возврат Результат;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	