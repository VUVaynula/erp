	СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле");
	СтрокаПравила["Изменена" + НомерКолонки] = Истина;
	
	СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле");
	СтрокаСоответствия.АлгоритмРасчетаЗначения = Формула;
	
	Элементы.СоответствиеСвойств.ТекущаяСтрока = СтрокаСоответствия.ПолучитьИдентификатор();
	
	ОпределениеИзмененияНастройки();
	ДобавитьВКоллекциюПравил(СтрокаПравила.УникальныйИдентификатор);
	
	Модифицированность = Истина;
	
КонецПроцедуры                                   

&НаСервере
Процедура ДобавитьУОСкрытияКолонкиПравил(ИмяРеквизита, НомерКолонки, НужныйСпособ)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы["ПравилаНаследования" + ИмяРеквизита + НомерКолонки].Имя);
	
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПравилаНаследования.СпособПодбораЗначения" + НомерКолонки);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = НужныйСпособ;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУОИзмененнойКолонкиПравил(ИмяРеквизита, НомерКолонки, Полужирный)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы["ПравилаНаследования" + ИмяРеквизита + НомерКолонки].Имя);
	
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПравилаНаследования.Изменена" + НомерКолонки);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Полужирный);
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНаследованияЗначениеПриИзменении(Элемент)
	
	НомерКолонки = ПолучитьНомерДинамическойКолонкиПравил(Элемент.Имя);
	
	Если НомерКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если СтрокаПравила = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПравила["Изменена" + НомерКолонки] = Истина;
	
	СинхронизироватьНижнююЯчейкуСВерхнейТаблицей(Элемент.Имя, НомерКолонки);
	
	ДобавитьВКоллекциюПравил(СтрокаПравила.УникальныйИдентификатор);
	
	Модифицированность = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура СинхронизироватьНижнююЯчейкуСВерхнейТаблицей(ИмяЭлемента, НомерКолонки)
	
	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если СтрокаПравила = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерКолонки < 0 Или НомерКолонки >= СоответствиеСвойств.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСоответствия = СоответствиеСвойств[НомерКолонки];
	
	Если Найти(ИмяЭлемента, "КолонкаСвойствоПродукции") > 0 Тогда
		
		СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству");
		
		СтрокаСоответствия.СвойствоПродукции = СтрокаПравила["КолонкаСвойствоПродукции" + НомерКолонки];
		
		ЭлементСписка = СтрокаСоответствия.СписокДоступныхСвойств.НайтиПоЗначению(СтрокаСоответствия.СвойствоПродукции);
		
		Если ЭлементСписка <> Неопределено Тогда
			СтрокаСоответствия.СвойствоПродукцииПредставление = ЭлементСписка.Представление;
		Иначе
			СтрокаСоответствия.СвойствоПродукцииПредставление = "";
		КонецЕсли;
		
		СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = СтрокаСоответствия.СпособПодбораЗначения;
		
	ИначеЕсли Найти(ИмяЭлемента, "КолонкаЗначениеСвойства") > 0 Тогда
		
		СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению");
		
		СтрокаСоответствия.ЗначениеСвойства = СтрокаПравила["КолонкаЗначениеСвойства" + НомерКолонки];
		
		СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = СтрокаСоответствия.СпособПодбораЗначения;
		
	ИначеЕсли Найти(ИмяЭлемента, "КолонкаФормула") > 0 Тогда
		
		СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле");
		
		СтрокаСоответствия.АлгоритмРасчетаЗначения = СтрокаПравила["КолонкаФормула" + НомерКолонки];
		
		СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = СтрокаСоответствия.СпособПодбораЗначения;
		
	ИначеЕсли Найти(ИмяЭлемента, "КолонкаАлгоритм") > 0 Тогда
		
		СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму");
		
		СтрокаСоответствия.АлгоритмРасчетаЗначения = СтрокаПравила["КолонкаАлгоритм" + НомерКолонки];
		
		ЭлементСписка = СтрокаСоответствия.СписокДоступныхФункций.НайтиПоЗначению(СтрокаСоответствия.АлгоритмРасчетаЗначения);
		
		Если ЭлементСписка <> Неопределено Тогда
			СтрокаСоответствия.АлгоритмРасчетаЗначенияПредставление = ЭлементСписка.Представление;
		Иначе
			СтрокаСоответствия.АлгоритмРасчетаЗначенияПредставление = "";
		КонецЕсли;
		
		СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = СтрокаСоответствия.СпособПодбораЗначения;
		
	КонецЕсли;
	
	Элементы.СоответствиеСвойств.ТекущаяСтрока = СтрокаСоответствия.ПолучитьИдентификатор();
	
	ОпределениеИзмененияНастройки();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНомерДинамическойКолонкиПравил(ИмяЭлемента)
	
	Префиксы = Новый Массив;
	
	Префиксы.Добавить("ПравилаНаследованияКолонкаСвойствоПродукции");
	Префиксы.Добавить("ПравилаНаследованияКолонкаЗначениеСвойства");
	Префиксы.Добавить("ПравилаНаследованияКолонкаФормула");
	Префиксы.Добавить("ПравилаНаследованияКолонкаАлгоритм");
	Префиксы.Добавить("ПравилаНаследованияСпособПодбораЗначения");
	Префиксы.Добавить("ПравилаНаследованияИзменена");
	
	Для каждого Префикс Из Префиксы Цикл
		
		Если Лев(ИмяЭлемента, СтрДлина(Префикс)) = Префикс Тогда
			Возврат Число(Сред(ИмяЭлемента, СтрДлина(Префикс) + 1));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

