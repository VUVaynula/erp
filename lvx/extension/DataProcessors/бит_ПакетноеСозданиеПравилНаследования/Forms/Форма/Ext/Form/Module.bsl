Процедура ПравилаНаследованияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствЗначениеСвойстваНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Свойство = Элементы.СоответствиеСвойств.ТекущиеДанные.СвойствоМатериала;
	Массив = Новый Массив;
	УстановитьОграниченияВыбораХарактеристики(Свойство, Массив, СтандартнаяОбработка); 
	
	Если ТипЗнч(Массив) = Тип("Массив") Тогда 
		СписокВыбора = новый СписокЗначений;
		СписокВыбора.ЗагрузитьЗначения(Массив);
		ДанныеВыбора = Неопределено;
		ПоказатьВыборИзСписка(новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтотОбъект),СписокВыбора, Элемент, СписокВыбора[0]);
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбЗначение, ДопП) Экспорт
	
	Если ВыбЗначение <> Неопределено Тогда
		ТД = Элементы.СоответствиеСвойств.ТекущиеДанные;
		ТД.ЗначениеСвойства = ВыбЗначение.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияВыбораХарактеристики(Свойство, ДанныеВыбора, СтандартнаяОбработка)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] +        
	
	СтруктураОтбор = Новый Структура;
	СтруктураОтбор.Вставить("Свойство", Свойство);
	
	РеквизитыВидаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.НоваяСтруктураРеквизитыВидаНоменклатуры(Номенклатура.ВидНоменклатуры);
	ТаблицаНастроекРеквизитов = Справочники.Номенклатура.ТаблицаНастроекРеквизитов(РеквизитыВидаНоменклатуры.Ссылка,
	РеквизитыВидаНоменклатуры.ТипНоменклатуры,
	РеквизитыВидаНоменклатуры.ОсобенностьУчета,
	Неопределено,
	Неопределено,
	"ХарактеристикиНоменклатуры");
	
	НайденныеСтроки = ТаблицаНастроекРеквизитов.НайтиСтроки(СтруктураОтбор);
	НетДействующихПравил = Истина;
	
	Если НайденныеСтроки.Количество() <> 0  Тогда
		
		ДопРеквизит = НайденныеСтроки[0];
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НастройкиВыбораИОграниченияЗначенийПараметров.НаборОграничений КАК НаборОграничений
		|ПОМЕСТИТЬ вт_НаборОграничений
		|ИЗ
		|	РегистрСведений.бит_НастройкиВыбораИОграниченияЗначенийПараметров КАК бит_НастройкиВыбораИОграниченияЗначенийПараметров
		|ГДЕ
		|	бит_НастройкиВыбораИОграниченияЗначенийПараметров.АктивностьНастройки = &АктивностьНастройки
		|	И бит_НастройкиВыбораИОграниченияЗначенийПараметров.ВидНоменклатуры = &ВидНоменклатуры
		|	И бит_НастройкиВыбораИОграниченияЗначенийПараметров.РеквизитХарактеристики = &РеквизитХарактеристики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Ссылка КАК Ссылка,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Наименование КАК Наименование,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.УсловияПрименения КАК УсловияПрименения,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.УсловиеОтбора КАК УсловиеОтбора,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.РежимПроверки КАК РежимПроверки,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Хранилище_УсловияПрименения КАК Хранилище_УсловияПрименения,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Хранилище_УсловияОтбора КАК Хранилище_УсловияОтбора,
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Ссылка.РеквизитХарактеристики КАК РеквизитХарактеристики
		|ИЗ
		|	Справочник.бит_НаборыОграниченийИХарактеристик.ПравилаОграничений КАК бит_НаборыОграниченийИХарактеристикПравилаОграничений
		|ГДЕ
		|	бит_НаборыОграниченийИХарактеристикПравилаОграничений.Ссылка В
		|			(ВЫБРАТЬ
		|				вт_НаборОграничений.НаборОграничений КАК НаборОграничений
		|			ИЗ
		|				вт_НаборОграничений КАК вт_НаборОграничений)";
		
		Запрос.УстановитьПараметр("АктивностьНастройки", Истина);
		Запрос.УстановитьПараметр("ВидНоменклатуры", Номенклатура.ВидНоменклатуры);
		Запрос.УстановитьПараметр("РеквизитХарактеристики", ДопРеквизит.Свойство);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ДанныеВыбора = Новый Массив;
		НеДоступныеЗначения = Новый Массив;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			
			ПравилоДействует = ПравилоДействует(ВыборкаДетальныеЗаписи.Хранилище_УсловияПрименения);
			
			Если ПравилоДействует Тогда
				
				НетДействующихПравил = Ложь;
				
				ВыхСхемаКомпоновки = Новый СхемаКомпоновкиДанных;
				Справочники.бит_НаборыОграниченийИХарактеристик.Инициализировать_СхемуКомпоновкиДанныхЗначений(ВыхСхемаКомпоновки, ВыборкаДетальныеЗаписи.РеквизитХарактеристики);
				
				ДобавитьУсловияОтбораЗначенийПараметра(ВыхСхемаКомпоновки, ВыборкаДетальныеЗаписи.Хранилище_УсловияОтбора);
				
				ТабдицаЗначений = РезультатКомпоновкиВТаблицу(ВыхСхемаКомпоновки, Неопределено);
				
				ВсеЗначенияХарактеристики = ПолучитьВсеЗначенияХарактеристики(ВыборкаДетальныеЗаписи.РеквизитХарактеристики);			
				
				Если ВыборкаДетальныеЗаписи.РежимПроверки = Перечисления.бит_РежимПроверкиСозданияХарактеристик.Разрешить Тогда
					Для Каждого СтрокаТЗ Из ТабдицаЗначений Цикл
						Если (ТипЗнч(СтрокаТЗ.ЗначениеСвойства) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов")
							ИЛИ ТипЗнч(СтрокаТЗ.ЗначениеСвойства) = Тип("СправочникСсылка.Номенклатура"))
							И НЕ СтрокаТЗ.ЗначениеСвойства.ЭтоГруппа Тогда	
							ДанныеВыбора.Добавить(СтрокаТЗ.ЗначениеСвойства);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.РежимПроверки = Перечисления.бит_РежимПроверкиСозданияХарактеристик.Запретить ТОгда
					Для Каждого ЭлМассива Из ВсеЗначенияХарактеристики Цикл
						Индекс = ТабдицаЗначений.Найти(ЭлМассива);
						Если Индекс = Неопределено Тогда
							ДанныеВыбора.Добавить(ЭлМассива);
						КонецЕсли;
					КонецЦикла;;
				КонецЕсли;
				
				
				Сообщить(ВыборкаДетальныеЗаписи.Наименование);
				
			КонецЕсли;
			
		КонецЦикла;		
		
		Если НетДействующихПравил Тогда
			СтандартнаяОбработка = Истина;
			ДанныеВыбора = Неопределено;
		КонецЕсли;
		
	КонецЕсли; 
	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] -
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьВсеЗначенияХарактеристики(РеквизитХарактеристики)
	
	Если РеквизитХарактеристики.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Владелец = &Владелец
		|	И НЕ ЗначенияСвойствОбъектов.ЭтоГруппа";
		
		Запрос.УстановитьПараметр("Владелец", РеквизитХарактеристики);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Владелец", РеквизитХарактеристики);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПравилоДействует(Хранилище_УсловияПрименения)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] +        
	
	_Хранилище_УсловияПрименения_Отбор = Хранилище_УсловияПрименения.Получить();
	
	Если _Хранилище_УсловияПрименения_Отбор = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	_ПравилоДействует = Истина;
	Для Каждого _Хранилище_ЭлементОтбора Из _Хранилище_УсловияПрименения_Отбор.Элементы Цикл
		
		Если НЕ _Хранилище_ЭлементОтбора.Использование Тогда
