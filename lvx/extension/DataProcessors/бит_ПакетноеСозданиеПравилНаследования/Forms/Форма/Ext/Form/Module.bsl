	_БазовыйВИ = ВхВариантИсп_Объект;//?(ВхВариантИсп_Объект.ЭтоСлужебныйПолуфабрикат, ВхВариантИсп_Объект.БазовыйВариантИсполнения, ВхВариантИсп_Объект);
	
	Если ТипЗнч(ВхПараметр) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		
		строка_ТЧПараметры = СоответствиеСвойств.Выгрузить().Найти(ВхПараметр, "СвойствоМатериала");
		Если строка_ТЧПараметры = Неопределено Тогда
			//_ТекстОшибки = "Параметр отсутствует у ВИ";
			Возврат Неопределено;
		КонецЕсли;
		СоответствиеСпособПодбораЗначенияКолонкаСодержащаяЗначение = СоответствиеСпособПодбораЗначенияКолонкаСодержащаяЗначение();
		КолонкаТаблицы = СоответствиеСпособПодбораЗначенияКолонкаСодержащаяЗначение.Получить(строка_ТЧПараметры.СпособПодбораЗначения);
		Возврат строка_ТЧПараметры[КолонкаТаблицы];
		
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("Строка") Тогда
		
		Если Лев(ВхПараметр, 8) = "Параметр" Тогда
			
			_Параметр = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(Сред(ВхПараметр, 9, 3));
			Если _Параметр = Неопределено Тогда
				//_ТекстОшибки = "Ошибка идентификации параметра";
				Возврат Неопределено;
			КонецЕсли;
			
			строка_ТЧПараметры = _БазовыйВИ.ДополнительныеРеквизиты.Найти(_Параметр, "Свойство");
			Если строка_ТЧПараметры = Неопределено Тогда
				//_ТекстОшибки = "Параметр отсутствует у ВИ";
				Возврат Неопределено;
			КонецЕсли;
			
			Возврат строка_ТЧПараметры.Значение;
			
		Иначе
			
			_ИмяПараметра = СокрЛП(ВхПараметр);
			
			Попытка
				
				Возврат _БазовыйВИ[_ИмяПараметра];
				
			Исключение
				
				Возврат Неопределено;
				
			КонецПопытки
			
		КонецЕсли;
		
	Иначе
		
		//_ТекстОшибки = "Недопустимый тип";
		Возврат Неопределено;
		
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] -
	
КонецФункции //

&НаСервере
Функция РезультатКомпоновкиВТаблицу(ВхСхемаКомпоновки, ВхТабл_ЗначенияПростыхТипов)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] +        
	
	//////////////////// Получение настроек /////////////////////////////////////////////////////////
	
	//_НастройкиКомпоновки = _СхемаКомпоновки.НастройкиПоУмолчанию;
	
	_КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	_КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ВхСхемаКомпоновки));
	_КомпоновщикНастроек.ЗагрузитьНастройки(ВхСхемаКомпоновки.НастройкиПоУмолчанию);
	
	//================ ЭТОТ КОД ПО ИДЕЕ ПИСАТЬ НЕ НУЖНО, НО БЕЗ НЕГО НЕ РАБОТАЕТ ================================
	
	Для Каждого _ДоступноеПоле Из _КомпоновщикНастроек.Настройки.Выбор.ДоступныеПоляВыбора.Элементы Цикл
		
		Если НЕ _ДоступноеПоле.Папка Тогда
			
			_Поле = _КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			_Поле.Поле 			= _ДоступноеПоле.Поле;
			_Поле.Заголовок     = _ДоступноеПоле.Заголовок;
			_Поле.Использование = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	_Группировка = _КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	_АвтоПоле = _Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	_АвтоПоле.Использование = Истина;	
	
	//=============================================================================================================
	
	_НастройкиКомпоновки = _КомпоновщикНастроек.ПолучитьНастройки();
	
	/////////////////////////////////////////////////////////////////////////////////////////////////
	
	ВнешниеНаборыДанных = Неопределено;
	Если НЕ ВхТабл_ЗначенияПростыхТипов = Неопределено Тогда
		
		ВнешниеНаборыДанных = Новый Структура;
		ВнешниеНаборыДанных.Вставить("табл_ЗначенияПростыхТипов", ВхТабл_ЗначенияПростыхТипов);
		
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ВхСхемаКомпоновки, _НастройкиКомпоновки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	Если ВнешниеНаборыДанных = Неопределено Тогда
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	Иначе
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
	КонецЕсли;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	табл_Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат табл_Результат;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ6.2] [ASHolyavko@1cbit.ru] [03.04.2026] -
	
