&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Видимость поля <СвойствоПродукции>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствСвойствоПродукции.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	
	СписокСпособовОпределения = Новый СписокЗначений;
	СписокСпособовОпределения.Добавить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству);
	СписокСпособовОпределения.Добавить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение);
	
	ОтборЭлемента.ПравоеЗначение = СписокСпособовОпределения;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Видимость поля <ЗначениеСвойства>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствЗначениеСвойства.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Видимость поля <АлгоритмРасчетаЗначения (по формуле)>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствАлгоритмРасчетаЗначения.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Видимость поля <АлгоритмРасчетаЗначения (по алгоритму)>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствФункцияРасчетаЗначения.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Доступность поля <СвойствоПродукции>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствСвойствоПродукции.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	// Оформление пустого списка выбора поля <СвойствоПродукции>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствСвойствоПродукции.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.ЕстьДоступныеСвойстваДляВыбора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<нет свойств доступных для выбора>';
	|en = '<no properties to select>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	// Оформление пустого списка выбора поля <ФункцияРасчетаЗначения>
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствФункцияРасчетаЗначения.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.ЕстьДоступныеФункцииДляВыбора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<нет алгоритмов доступных для выбора>';
	|en = '<no algorithm to select>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	// Оформление поля <Способ определения>
	Для каждого СпособПодбораЗначения Из Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры Цикл
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоответствиеСвойствСпособПодбораЗначения.Имя);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СоответствиеСвойств.СпособПодбораЗначения");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = СпособПодбораЗначения;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НРег(СпособПодбораЗначения));
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСоответствиеВСтроке(ТекущиеДанные)
	
	ТекущиеДанные.СвойствоПродукции = Неопределено;
	ТекущиеДанные.СвойствоПродукцииПредставление = Неопределено;
	ТекущиеДанные.ЗначениеСвойства = Неопределено;
	ТекущиеДанные.АлгоритмРасчетаЗначения = "";
	
КонецПроцедуры

&НаКлиенте
Процедура СвойствоПродукцииНачалоВыбораЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		ТекущиеДанные = Элементы.СоответствиеСвойств.ТекущиеДанные;
		
		ТекущиеДанные.СвойствоПродукции              = ВыбранныйЭлемент.Значение;
		ТекущиеДанные.СвойствоПродукцииПредставление = ВыбранныйЭлемент.Представление;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	ОпределениеИзмененияНастройки();  
	
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмРасчетаЗначенияНачалоВыбораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		ТекущиеДанные = Элементы.СоответствиеСвойств.ТекущиеДанные;
		
		ТекущиеДанные.АлгоритмРасчетаЗначения = СокрЛП(РезультатЗакрытия);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	ОпределениеИзмененияНастройки(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ФункцияРасчетаЗначенияНачалоВыбораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		ТекущиеДанные = Элементы.СоответствиеСвойств.ТекущиеДанные;
		
		ТекущиеДанные.АлгоритмРасчетаЗначения              = РезультатЗакрытия.Значение;
		ТекущиеДанные.АлгоритмРасчетаЗначенияПредставление = РезультатЗакрытия.Представление;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	ОпределениеИзмененияНастройки(); 
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОшибкиЗаполнения()
	
	Отказ = Ложь;
	ПоляПроверкиЗаполнения = Новый Соответствие;
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству"),
	"СвойствоПродукцииПредставление");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле"),
	"АлгоритмРасчетаЗначения");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму"),
	"АлгоритмРасчетаЗначенияПредставление");
	
	ШаблонСообщения = НСтр("ru = 'Необходимо заполнить значение настройки соответствия в строке %1';
	|en = 'Fill in setting value in line %1'");
	
	Для каждого СтрокаСоответствие Из СоответствиеСвойств Цикл
		
		ПроверяемоеПоле = ПоляПроверкиЗаполнения[СтрокаСоответствие.СпособПодбораЗначения];
		Если ПроверяемоеПоле <> Неопределено И НЕ ЗначениеЗаполнено(СтрокаСоответствие[ПроверяемоеПоле]) Тогда
			ИндексСтроки = СоответствиеСвойств.Индекс(СтрокаСоответствие);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(ШаблонСообщения, ИндексСтроки+1),,
			"СоответствиеСвойств["+ИндексСтроки+"]."+ПроверяемоеПоле,,Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Функция ЕстьОшибкиЗаполненияТаблицы(ТаблицаНастройки, НомерПравила)

	Отказ = Ложь;
	ПоляПроверкиЗаполнения = Новый Соответствие;
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству"),
	"СвойствоПродукцииПредставление");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле"),
	"АлгоритмРасчетаЗначения");
	ПоляПроверкиЗаполнения.Вставить(ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму"),
	"АлгоритмРасчетаЗначенияПредставление");
	
	ШаблонСообщения = "Для строки правила %1 необходимо заполнить значение настройки соответствия в строке %2";
	
	Для каждого СтрокаСоответствие Из ТаблицаНастройки Цикл
		
		ПроверяемоеПоле = ПоляПроверкиЗаполнения[СтрокаСоответствие.СпособПодбораЗначения];
		Если ПроверяемоеПоле <> Неопределено И НЕ ЗначениеЗаполнено(СтрокаСоответствие[ПроверяемоеПоле]) Тогда
			ИндексСтроки = ТаблицаНастройки.Индекс(СтрокаСоответствие);
			ТекстСообщения = СтрШаблон(ШаблонСообщения, НомерПравила, ИндексСтроки+1);
			Поле = "СоответствиеСвойств["+ИндексСтроки+"]."+ПроверяемоеПоле;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Поле, , Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;

КонецФункции

&НаКлиенте
Процедура ПоказатьСкрытьВсеПараметры(Команда)
	
	РежимВсеПараметры = Не РежимВсеПараметры;
	ЗаголовокВсеПараметры();
	НастроитьВидимостьВсеПараметры();  
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьВсеПараметры()
	
	ДоступностьКнопкиСохранения();
	
	Если РежимВсеПараметры Тогда
		УстановитьВидимостьВсехКолонокПравилНаСервере();
	Иначе
		СкрытьНеизмененныеКолонкиПравилНаСервере();
	КонецЕсли;
	
	Элементы.ПравилаНаследованияНомер.Ширина = 3;
	
КонецПроцедуры                                                   

&НаСервере
Процедура УстановитьВидимостьВсехКолонокПравилНаСервере()
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		УстановитьВидимостьЭлементаПравил("КолонкаСвойствоПродукции", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаЗначениеСвойства", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаФормула", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаАлгоритм", сч, Истина);
		
		УстановитьВидимостьЭлементаПравил("СпособПодбораЗначения", сч, Ложь);
		УстановитьВидимостьЭлементаПравил("Изменена", сч, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СкрытьНеизмененныеКолонкиПравилНаСервере()
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		КолонкаИзменена = ЕстьИзмененияВКолонкеПравил(сч);
		
		УстановитьВидимостьЭлементаПравил("КолонкаСвойствоПродукции", сч, КолонкаИзменена);
		УстановитьВидимостьЭлементаПравил("КолонкаЗначениеСвойства", сч, КолонкаИзменена);
		УстановитьВидимостьЭлементаПравил("КолонкаФормула", сч, КолонкаИзменена);
		УстановитьВидимостьЭлементаПравил("КолонкаАлгоритм", сч, КолонкаИзменена);
		
		УстановитьВидимостьЭлементаПравил("СпособПодбораЗначения", сч, Ложь);
		УстановитьВидимостьЭлементаПравил("Изменена", сч, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИзмененияВКолонкеПравил(НомерКолонки)
	
	Для каждого СтрокаПравила Из ПравилаНаследования Цикл
		
		Попытка
			Если СтрокаПравила["Изменена" + НомерКолонки] Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции 

&НаСервере
Процедура ОпределитьВидимостьКолонокПравилаНаследованияНаСервере()
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		УстановитьВидимостьЭлементаПравил("КолонкаСвойствоПродукции", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаЗначениеСвойства", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаФормула", сч, Истина);
		УстановитьВидимостьЭлементаПравил("КолонкаАлгоритм", сч, Истина);
		
		УстановитьВидимостьЭлементаПравил("СпособПодбораЗначения", сч, Ложь);
		УстановитьВидимостьЭлементаПравил("Изменена", сч, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
Процедура УстановитьВидимостьЭлементаПравил(ИмяРеквизита, НомерКолонки, Видимость)
	
	ИмяЭлемента = "ПравилаНаследования" + ИмяРеквизита + НомерКолонки;
	
	ЭлементФормы = Элементы.Найти(ИмяЭлемента);
	
	Если ЭлементФормы <> Неопределено Тогда
		ЭлементФормы.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьЗначениеПравилаНаследованияПоСпособу(СтрокаПравила, НомерКолонки)
	
	ИмяСпособа = "СпособПодбораЗначения" + НомерКолонки;
	
	Попытка
		СпособПодбораЗначения = СтрокаПравила[ИмяСпособа];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству Тогда
		ИмяЗначения = "КолонкаСвойствоПродукции" + НомерКолонки;
		
	ИначеЕсли СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению Тогда
		ИмяЗначения = "КолонкаЗначениеСвойства" + НомерКолонки;
		
	ИначеЕсли СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле Тогда
		ИмяЗначения = "КолонкаФормула" + НомерКолонки;
		
	ИначеЕсли СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму Тогда
		ИмяЗначения = "КолонкаАлгоритм" + НомерКолонки;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат СтрокаПравила[ИмяЗначения];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьКолонкиПравил(ИмяРеквизита, НомерКолонки, Видимость)
	
	ИмяЭлемента = "ПравилаНаследования" + ИмяРеквизита + НомерКолонки;
	
	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Элементы[ИмяЭлемента].Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры 

Процедура ЗаголовокВсеПараметры()
	
	Если РежимВсеПараметры Тогда
		ПрефиксКнопки = "Скрыть";
	Иначе
		ПрефиксКнопки = "Показать";
	КонецЕсли;
	Элементы.ПравилаНаследованияПоказатьСкрытьВсеПараметры.Заголовок = ПрефиксКнопки + " все параметры";
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда) 
	
	ПравилаНаследования.Очистить();
	СоответствиеПравилИнициализация();
	ДоступностьКнопкиСохранения(); 
	
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	ТД = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйУИД = ТД.УникальныйИдентификатор;
	НовыйУИД = Строка(Новый УникальныйИдентификатор);
	
	нов = ПравилаНаследования.Добавить();
	ЗаполнитьЗначенияСвойств(нов, ТД);
	нов.УникальныйИдентификатор = НовыйУИД;
	
	СкопироватьНастройкуПравилаНаСервере(СтарыйУИД, НовыйУИД);
	
	ПересчитатьНумерациюСтрок();
	
	Элементы.ПравилаНаследования.ТекущаяСтрока = нов.ПолучитьИдентификатор();
	ТекущийУид = НовыйУИД;
	
	ОбновитьНастройкуСоответствия();
	
	ДоступностьКнопкиСохранения();
	НастроитьВидимостьВсеПараметры();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьНастройкуПравилаНаСервере(СтарыйУИД, НовыйУИД)
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	
	Если Соответствие = Неопределено Тогда
		Соответствие = Новый Соответствие;
	КонецЕсли;
	
	ТаблицаНастройки = Соответствие.Получить(СтарыйУИД);
	
	Если ТаблицаНастройки = Неопределено Тогда
		ТаблицаНастройки = СоответствиеСвойств.Выгрузить();
	Иначе
		ТаблицаНастройки = ТаблицаНастройки.Скопировать();
	КонецЕсли;
	
	Соответствие.Вставить(НовыйУИД, ТаблицаНастройки);
	АдресСпискаПравил = ПоместитьВоВременноеХранилище(Соответствие, УИДАдреса);
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	ТекущаяСтрока = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыйУИД = ТекущаяСтрока.УникальныйИдентификатор;
	
	УдалитьИзСпискаПравил(УдаляемыйУИД);
	
	СтрокаКоллекции = ПравилаНаследования.НайтиПоИдентификатору(ТекущаяСтрока.ПолучитьИдентификатор());
	
	Если СтрокаКоллекции <> Неопределено Тогда
		ПравилаНаследования.Удалить(СтрокаКоллекции);
	КонецЕсли;
	
	ПересчитатьНумерациюСтрок();
	
	Если Элементы.ПравилаНаследования.ТекущиеДанные <> Неопределено Тогда
		
		ТекущийУид = Элементы.ПравилаНаследования.ТекущиеДанные.УникальныйИдентификатор;
		ОбновитьНастройкуСоответствия();
		
	Иначе
		
		ТекущийУид = "";
		ЗагрузитьНастройкуНаСервере();
		
	КонецЕсли;
	
	ДоступностьКнопкиСохранения();
	НастроитьВидимостьВсеПараметры();
	
	Модифицированность = Истина;
	
КонецПроцедуры                        

&НаСервере
Процедура ЗагрузитьНастройкуНаСервере() 
	
	СоответствиеСвойств.Загрузить(СоответствиеСвойствИсходныеЗначения.Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеСвойствПриИзменении(Элемент)
	
	ОпределениеИзмененияНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)              
	
	Если ЕстьОшибкиЗаполнения() Тогда
		Возврат;
	КонецЕсли;
	
	ИД = Строка(Новый УникальныйИдентификатор);
	ДобавитьВКоллекциюПравил(ИД);
	
	нов = ПравилаНаследования.Добавить();
	нов.Количество = 1;
	нов.УникальныйИдентификатор = ИД;
	
	ЗаполнитьЗначенияСтрокиПравилНаследования(нов);
	
	ПересчитатьНумерациюСтрок();
	
	Элементы.ПравилаНаследования.ТекущаяСтрока = нов.ПолучитьИдентификатор();
	
	ДоступностьКнопкиСохранения();
	НастроитьВидимостьВсеПараметры();
	
	Модифицированность = Истина;КонецПроцедуры               

&НаСервере
Процедура ДобавитьВКоллекциюПравил(ИД)
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	Соответствие.Вставить(ИД, СоответствиеСвойств.Выгрузить());
	АдресСпискаПравил = ПоместитьВоВременноеХранилище(Соответствие, УИДАдреса);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИзСпискаПравил(ИД)
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	Соответствие.Удалить(ИД);
	АдресСпискаПравил = ПоместитьВоВременноеХранилище(Соответствие, УИДАдреса);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоответствиеСпособПодбораЗначенияКолонкаСодержащаяЗначение()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству, "СвойствоПродукции");
	
	Соответствие.Вставить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению, "ЗначениеСвойства");
	Соответствие.Вставить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение, "ЗначениеСвойства");
	
	Соответствие.Вставить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле, "АлгоритмРасчетаЗначения");
	Соответствие.Вставить(Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму, "АлгоритмРасчетаЗначенияПредставление"); 
	
	Возврат Соответствие;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗначенияСтрокиПравилНаследования(нов) 

	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		СтрокаСоответствия = СоответствиеСвойств[сч];
		
		нов["СпособПодбораЗначения" + сч] = СтрокаСоответствия.СпособПодбораЗначения;
		нов["Изменена" + сч] = Ложь;
		
		нов["КолонкаСвойствоПродукции" + сч] = Неопределено;
		нов["КолонкаЗначениеСвойства" + сч] = Неопределено;
		нов["КолонкаФормула" + сч] = "";
		нов["КолонкаАлгоритм" + сч] = "";
		
		Если СтрокаСоответствия.СпособПодбораЗначения =
			ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству") Тогда
			
			нов["КолонкаСвойствоПродукции" + сч] = СтрокаСоответствия.СвойствоПродукции;
			
		ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
			ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению") Тогда
			
			нов["КолонкаЗначениеСвойства" + сч] = СтрокаСоответствия.ЗначениеСвойства;
			
		ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
			ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле") Тогда
			
			нов["КолонкаФормула" + сч] = СтрокаСоответствия.АлгоритмРасчетаЗначения;
			
		ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
			ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму") Тогда
			
			нов["КолонкаАлгоритм" + сч] = СтрокаСоответствия.АлгоритмРасчетаЗначения;
			
		КонецЕсли;
		
		нов["Изменена" + сч] = ЗначениеПараметраПравилаИзменено(СтрокаСоответствия, сч);
		
	КонецЦикла;   
	
КонецПроцедуры  

&НаКлиенте
Функция ЗначениеПараметраПравилаИзменено(СтрокаСоответствия, НомерКолонки)
	
	Если НомерКолонки >= СоответствиеСвойствИсходныеЗначения.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИсходнаяСтрока = СоответствиеСвойствИсходныеЗначения[НомерКолонки];
	
	Если СтрокаСоответствия.СпособПодбораЗначения <> ИсходнаяСтрока.СпособПодбораЗначения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству") Тогда
		
		Возврат СтрокаСоответствия.СвойствоПродукции <> ИсходнаяСтрока.СвойствоПродукции;
		
	ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению") Тогда
		
		Возврат СтрокаСоответствия.ЗначениеСвойства <> ИсходнаяСтрока.ЗначениеСвойства;
		
	ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле")
		Или СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму") Тогда
		
		Возврат СтрокаСоответствия.АлгоритмРасчетаЗначения <> ИсходнаяСтрока.АлгоритмРасчетаЗначения;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПравилаНаследованияПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Элемент.ТекущийЭлемент.Имя;
	
	НомерКолонки = ПолучитьНомерДинамическойКолонкиПравил(ИмяЭлемента);
	
	Если НомерКолонки = Неопределено Тогда
		СпособОпределенияХарактеристики =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	ТД = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		СпособОпределенияХарактеристики =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	Если ТекущийУид <> ТД.УникальныйИдентификатор Тогда
		ТекущийУид = ТД.УникальныйИдентификатор;
		ОбновитьНастройкуСоответствия();
	КонецЕсли;
	
	ИмяСпособа = "СпособПодбораЗначения" + НомерКолонки;
	СпособОпределенияХарактеристики = ТД[ИмяСпособа];
	СписокВыбора = Элементы.СпособОпределенияХарактеристики.СписокВыбора;
	СписокВыбора.Очистить();
    СписокВыбора.Добавить(СпособОпределенияХарактеристики);
	 
	Если НомерКолонки >= 0 И НомерКолонки < СоответствиеСвойств.Количество() Тогда
		Элементы.СоответствиеСвойств.ТекущаяСтрока =
		СоответствиеСвойств[НомерКолонки].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНумерациюСтрок()
	
	Для сч = 0 по ПравилаНаследования.Количество() - 1 Цикл
		ПравилаНаследования[сч].Номер = сч + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкуСоответствия()
	
	Если НЕ ЗначениеЗаполнено(ТекущийУид) Тогда
		Возврат;
	КонецЕсли;
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	
	Если Соответствие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНастройки = Соответствие.Получить(ТекущийУид);
	
	Если ТаблицаНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеСвойств.Загрузить(ТаблицаНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)  
	
	ЗаполнитьПоУмолчаниюНаСервере(); 
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()   
	
	СоответствиеСвойств.Загрузить(СоответствиеСвойствИсходныеЗначения.Выгрузить());  
	
КонецПроцедуры

