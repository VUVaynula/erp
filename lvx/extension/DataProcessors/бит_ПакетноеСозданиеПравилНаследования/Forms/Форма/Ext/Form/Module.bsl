
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УправлениеДоступом.ЕстьРоль("Пакетное создание правил наследования") Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недостаточно прав для работы с обработкой");
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("СоответствиеСвойств") = Ложь Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка открывается из формы ресурсной спецификации"); 
		Возврат; 
	КонецЕсли;
	
	Спецификация = Параметры.РесурснаяСпецификация;
	Номенклатура = Параметры.Номенклатура; 
	РежимВсеПараметры = Истина;
	ЗаголовокВсеПараметры();     
	УИДАдреса = Новый УникальныйИдентификатор;
	// --------------------------------
	// заполнение с формы настройка автовыбора номенклатуры
	РеквизитыМатериала = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ТипНоменклатуры,ВидНоменклатуры,ИспользованиеХарактеристик");
	ВидМатериала = РеквизитыМатериала.ВидНоменклатуры;
	Для каждого НастройкаСоответствия Из Параметры.СоответствиеСвойств Цикл
		ЗаполнитьЗначенияСвойств(СоответствиеСвойствПодготовка.Добавить(), НастройкаСоответствия);
	КонецЦикла; 
	
	// Определим вид изделий который содержит доступные свойства
	ВидИзделийИлиНоменклатура = Параметры.ВидИзделийИлиНоменклатура;
	Если ТипЗнч(ВидИзделийИлиНоменклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ВидИзделий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидИзделийИлиНоменклатура, "ВидНоменклатуры");
	Иначе
		ВидИзделий = ВидИзделийИлиНоменклатура;
	КонецЕсли;
	// ------------------------------------------------------------------------------
	// настройка формы
	УстановитьУсловноеОформление();
	ОписаниеФункций = УправлениеДаннымиОбИзделияхПовтИсп.ОписаниеФункцийАвтовыбораЗначенияСвойстваНоменклатуры();
	// Добавим свойства продукции, которые можно сопоставить
	СвойстваМатериала = УправлениеДаннымиОбИзделиях.ПолучитьСвойстваДляАвтовыбора(ВидМатериала, Истина);
	СвойстваПродукции = УправлениеДаннымиОбИзделиях.ПолучитьСвойстваДляАвтовыбора(ВидИзделий);
	
	Для каждого ДанныеСвойстваМатериала Из СвойстваМатериала Цикл
		
		Если ДанныеСвойстваМатериала.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СоответствиеСвойств.Добавить();
		НоваяСтрока.СвойствоМатериала = ДанныеСвойстваМатериала.Свойство;
		НоваяСтрока.СвойствоМатериалаПредставление = ДанныеСвойстваМатериала.Представление;
		
		// Свойства можно сопоставить, если
		// - свойства одинаковые
		// - свойства разные, но используется общий список значений
		// - тип свойства примитивный (число, строка, булево, дата).
		Для каждого ДанныеСвойстваПродукции Из СвойстваПродукции Цикл
			
			Если ДанныеСвойстваПродукции.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			Если (ДанныеСвойстваПродукции.Свойство = ДанныеСвойстваМатериала.Свойство
				ИЛИ ДанныеСвойстваПродукции.ВладелецДополнительныхЗначений = ДанныеСвойстваМатериала.Свойство
				ИЛИ ДанныеСвойстваПродукции.Свойство = ДанныеСвойстваМатериала.ВладелецДополнительныхЗначений
				ИЛИ ДанныеСвойстваПродукции.ВладелецДополнительныхЗначений = ДанныеСвойстваМатериала.ВладелецДополнительныхЗначений
				И ЗначениеЗаполнено(ДанныеСвойстваПродукции.ВладелецДополнительныхЗначений)
				ИЛИ ДанныеСвойстваМатериала.ТипЗначения = ДанныеСвойстваПродукции.ТипЗначения
				И НЕ ДанныеСвойстваМатериала.Свойство.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов"))
				) Тогда
				
				НоваяСтрока.СписокДоступныхСвойств.Добавить(ДанныеСвойстваПродукции.Свойство, ДанныеСвойстваПродукции.Представление);
				
			КонецЕсли;
			
		КонецЦикла;
		
		НоваяСтрока.ЕстьДоступныеСвойстваДляВыбора 	= (НоваяСтрока.СписокДоступныхСвойств.Количество() <> 0);    
		
		НоваяСтрока.ЕстьВозможностьРасчетаПоФормуле = ДанныеСвойстваМатериала.Свойство.ТипЗначения.СодержитТип(Тип("Число"))
														ИЛИ ДанныеСвойстваМатериала.Свойство.ТипЗначения.СодержитТип(Тип("Строка"))
														ИЛИ ДанныеСвойстваМатериала.Свойство.ТипЗначения.СодержитТип(Тип("Булево"));
		
		// Добавление функций подбора значения по алгоритму
		Если ОписаниеФункций.Количество() Тогда
			Для каждого Описание Из ОписаниеФункций Цикл // см. УправлениеДаннымиОбИзделиях.СоздатьОписаниеФункцииАвтовыбора
				
				Если НЕ ТипЗнч(Описание) = Тип("Структура") ИЛИ НЕ Описание.Свойство("ИмяФункции") Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяСвойства = "";
				Если Описание.Параметры.Свойство("ИмяСвойства", ИмяСвойства) И ИмяСвойства <> ДанныеСвойстваМатериала.Свойство.Имя Тогда
					Продолжить;
				КонецЕсли;
				
				Если Описание.ВозвращаемоеЗначение <> Неопределено Тогда
					
					Для каждого Тип Из Описание.ВозвращаемоеЗначение.Типы() Цикл
						ДобавитьФункцию = ДанныеСвойстваМатериала.Свойство.ТипЗначения.СодержитТип(Тип);
						Если ДобавитьФункцию Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла; 
					
					Если НЕ ДобавитьФункцию Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				НоваяСтрока.СписокДоступныхФункций.Добавить(Описание.ИмяФункции, Описание.Представление);
				
			КонецЦикла;
			НоваяСтрока.СписокДоступныхФункций.СортироватьПоПредставлению();
			НоваяСтрока.ЕстьДоступныеФункцииДляВыбора = (НоваяСтрока.СписокДоступныхФункций.Количество() <> 0);
		КонецЕсли;
		
	КонецЦикла;
	
	// Заполним соответствие свойств
	Для каждого ТекущиеДанные Из СоответствиеСвойств Цикл
		
		СтруктураПоиска = Новый Структура("СвойствоМатериала", ТекущиеДанные.СвойствоМатериала);
		СписокСтрок = СоответствиеСвойствПодготовка.НайтиСтроки(СтруктураПоиска);
		
		ТекущиеДанные.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение;
		
		Если СписокСтрок.Количество() <> 0 Тогда
			
			НастройкаСоответствия = СписокСтрок[0];
			
			ТекущиеДанные.СпособПодбораЗначения = НастройкаСоответствия.СпособПодбораЗначения;
			
			Если ТекущиеДанные.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству Тогда
				
				ЭлСвойствоПродукции = ТекущиеДанные.СписокДоступныхСвойств.НайтиПоЗначению(НастройкаСоответствия.СвойствоПродукции);
				Если ЭлСвойствоПродукции <> Неопределено Тогда
					
					ТекущиеДанные.СвойствоПродукции              = НастройкаСоответствия.СвойствоПродукции;
					ТекущиеДанные.СвойствоПродукцииПредставление = ЭлСвойствоПродукции.Представление;
					
				КонецЕсли;
				
			ИначеЕсли ТекущиеДанные.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению Тогда
				
				ТекущиеДанные.ЗначениеСвойства = НастройкаСоответствия.ЗначениеСвойства;
				
			ИначеЕсли ТекущиеДанные.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле Тогда
				
				ТекущиеДанные.АлгоритмРасчетаЗначения = НастройкаСоответствия.АлгоритмРасчетаЗначения;
				
			ИначеЕсли ТекущиеДанные.СпособПодбораЗначения = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму Тогда
				
				ЭлСпискаФункций = ТекущиеДанные.СписокДоступныхФункций.НайтиПоЗначению(НастройкаСоответствия.АлгоритмРасчетаЗначения);
				Если ЭлСпискаФункций <> Неопределено Тогда
					
					ТекущиеДанные.АлгоритмРасчетаЗначения              = НастройкаСоответствия.АлгоритмРасчетаЗначения;
					ТекущиеДанные.АлгоритмРасчетаЗначенияПредставление = ЭлСпискаФункций.Представление;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СформироватьДанныеДляПодбораПоФормуле(СвойстваПродукции);
	
	СоответствиеСвойствИсходныеЗначения.Загрузить(СоответствиеСвойств.Выгрузить());
	
	ДорисоватьФорму();
	
КонецПроцедуры

&НаСервере
Процедура ДорисоватьФорму() 
	//	Сначала реквизиты
	МассивДобавляемыхРеквизитов = Новый Массив;
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Изменена" + сч, 
											Новый ОписаниеТипов("Булево"), 
											"ПравилаНаследования", 
											"Изменена"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("СпособПодбораЗначения" + сч,
											Новый ОписаниеТипов("ПеречислениеСсылка.СпособыПодбораЗначенияСвойстваНоменклатуры"),
											"ПравилаНаследования",
											"СпособПодбораЗначения"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("КолонкаСвойствоПродукции" + сч,
											Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"),
											"ПравилаНаследования",
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("КолонкаЗначениеСвойства" + сч,
											СоответствиеСвойств[сч].СвойствоМатериала.ТипЗначения,
											"ПравилаНаследования",
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("КолонкаФормула" + сч,
											Новый ОписаниеТипов("Строка"),
											"ПравилаНаследования",
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("КолонкаАлгоритм" + сч,
											Новый ОписаниеТипов("Строка"),
											"ПравилаНаследования",
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление));
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	Полужирный = Новый Шрифт( , , Истина);
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		ДобавитьСкрытуюКолонкуПравил("СпособПодбораЗначения", сч);
		ДобавитьСкрытуюКолонкуПравил("Изменена", сч);
		
		ДобавитьРедактируемуюКолонкуПравил("КолонкаСвойствоПродукции", сч,
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление);
		
		ДобавитьРедактируемуюКолонкуПравил("КолонкаЗначениеСвойства", сч,
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление);
		
		ДобавитьРедактируемуюКолонкуПравил("КолонкаФормула", сч,
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление);
		
		ДобавитьРедактируемуюКолонкуПравил("КолонкаАлгоритм", сч,
											СоответствиеСвойств[сч].СвойствоМатериалаПредставление);
		// УО
		ДобавитьУОСкрытияКолонкиПравил("КолонкаСвойствоПродукции", сч,
										ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству"));
		
		ДобавитьУОСкрытияКолонкиПравил("КолонкаЗначениеСвойства", сч,
										ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению"));
		
		ДобавитьУОСкрытияКолонкиПравил("КолонкаФормула", сч,
										ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле"));
		
		ДобавитьУОСкрытияКолонкиПравил("КолонкаАлгоритм", сч,
										ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму"));
		
		ДобавитьУОИзмененнойКолонкиПравил("КолонкаСвойствоПродукции", сч, Полужирный);
		ДобавитьУОИзмененнойКолонкиПравил("КолонкаЗначениеСвойства" , сч, Полужирный);
		ДобавитьУОИзмененнойКолонкиПравил("КолонкаФормула" , сч, Полужирный);
		ДобавитьУОИзмененнойКолонкиПравил("КолонкаАлгоритм", сч, Полужирный);
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьРедактируемуюКолонкуПравил(ИмяРеквизита, НомерКолонки, Заголовок)
	
	ИмяЭлемента = "ПравилаНаследования" + ИмяРеквизита + НомерКолонки;
	
	НоваяКолонка = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ПравилаНаследования, Элементы.ПравилаНаследованияКоличество);
	
	НоваяКолонка.Заголовок = Заголовок;
	НоваяКолонка.ПутьКДанным = "ПравилаНаследования." + ИмяРеквизита + НомерКолонки;
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	//НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	
	НоваяКолонка.УстановитьДействие("ПриИзменении", "ПравилаНаследованияЗначениеПриИзменении");
	НоваяКолонка.УстановитьДействие("НачалоВыбора", "ПравилаНаследованияЗначениеНачалоВыбора");
	Если СтрНайти(ИмяЭлемента, "Формула") > 0 Тогда 
		НоваяКолонка.КнопкаВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры    	

&НаСервере
Процедура ДобавитьСкрытуюКолонкуПравил(ИмяРеквизита, НомерКолонки)
	
	ИмяЭлемента = "ПравилаНаследования" + ИмяРеквизита + НомерКолонки;
	
	НоваяКолонка = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ПравилаНаследования, Элементы.ПравилаНаследованияКоличество);
	
	НоваяКолонка.Заголовок = ИмяРеквизита;
	НоваяКолонка.ПутьКДанным = "ПравилаНаследования." + ИмяРеквизита + НомерКолонки;
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНаследованияЗначениеСвойстваВыборЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерКолонки = ДополнительныеПараметры.НомерКолонки;
	
	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	СтрокаСоответствия = СоответствиеСвойств[НомерКолонки];
	
	СтрокаПравила["КолонкаЗначениеСвойства" + НомерКолонки] = ВыбранныйЭлемент;
	СтрокаПравила["СпособПодбораЗначения"   + НомерКолонки] = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению");
	СтрокаПравила["Изменена" + НомерКолонки] = Истина;
	
	СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению");
	СтрокаСоответствия.ЗначениеСвойства      = ВыбранныйЭлемент;
	
	Элементы.СоответствиеСвойств.ТекущаяСтрока = СтрокаСоответствия.ПолучитьИдентификатор();
	
	ОпределениеИзмененияНастройки();
	ДобавитьВКоллекциюПравил(СтрокаПравила.УникальныйИдентификатор);
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОпределениеИзмененияНастройки()
	
	ТД = Элементы.СоответствиеСвойств.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НастройкаСоответствия = Новый Структура(УправлениеДаннымиОбИзделияхКлиентСервер.РеквизитыНастройкаСоответствияСвойств());
	ЗаполнитьЗначенияСвойств(НастройкаСоответствия, ТД);
	
	СтруктураПоиска = Новый Структура("СвойствоМатериала", ТД.СвойствоМатериала);
	СтрокиИсходныхДанных = СоответствиеСвойствИсходныеЗначения.НайтиСтроки(СтруктураПоиска);
	
	ТД.Изменена = Ложь;
	Если СтрокиИсходныхДанных.Количество() > 0 Тогда
		
		СтрокаИсходныхДанных = СтрокиИсходныхДанных[0];
		НастройкаСоответствияИсхДанных = Новый Структура(УправлениеДаннымиОбИзделияхКлиентСервер.РеквизитыНастройкаСоответствияСвойств());
		ЗаполнитьЗначенияСвойств(НастройкаСоответствияИсхДанных, СтрокаИсходныхДанных);
		Для каждого Стр Из НастройкаСоответствия Цикл
			Если Стр.Значение <> НастройкаСоответствияИсхДанных[Стр.Ключ] Тогда
				ТД.Изменена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ТД.Изменена = Истина;
		
	КонецЕсли;
	
	СинхронизироватьВерхнююСтрокуСНижнейТаблицей(ТД);
	
	Если ЗначениеЗаполнено(ТекущийУид) Тогда
		ДобавитьВКоллекциюПравил(ТекущийУид);
	КонецЕсли;
	
	НастроитьВидимостьВсеПараметры();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьВерхнююСтрокуСНижнейТаблицей(СтрокаСоответствия)

	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	
	Если СтрокаПравила = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерКолонки = СоответствиеСвойств.Индекс(СтрокаСоответствия);
	
	Если НомерКолонки < 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = СтрокаСоответствия.СпособПодбораЗначения;
		
	СтрокаПравила["Изменена" + НомерКолонки] = СтрокаСоответствия.Изменена;
	
	СтрокаПравила["КолонкаСвойствоПродукции" + НомерКолонки] = Неопределено;
	СтрокаПравила["КолонкаЗначениеСвойства"  + НомерКолонки] = Неопределено;
	СтрокаПравила["КолонкаФормула"  + НомерКолонки] = "";
	СтрокаПравила["КолонкаАлгоритм" + НомерКолонки] = "";
	
	Если СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству") Тогда
		
		СтрокаПравила["КолонкаСвойствоПродукции" + НомерКолонки] = СтрокаСоответствия.СвойствоПродукции;
			
	ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению") Тогда
		
		СтрокаПравила["КолонкаЗначениеСвойства" + НомерКолонки] = СтрокаСоответствия.ЗначениеСвойства;
			
	ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле") Тогда
		
		СтрокаПравила["КолонкаФормула" + НомерКолонки] = СтрокаСоответствия.АлгоритмРасчетаЗначения;
			
	ИначеЕсли СтрокаСоответствия.СпособПодбораЗначения =
		ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму") Тогда
		
		СтрокаПравила["КолонкаАлгоритм" + НомерКолонки] = СтрокаСоответствия.АлгоритмРасчетаЗначения;
			
	КонецЕсли;
	
		СпособОпределенияХарактеристики = СтрокаСоответствия.СпособПодбораЗначения;

	КонецПроцедуры
	
&НаКлиенте
Процедура ПравилаНаследованияЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НомерКолонки = ПолучитьНомерДинамическойКолонкиПравил(Элемент.Имя);
	Если НомерКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерКолонки < 0 Или НомерКолонки >= СоответствиеСвойств.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСоответствия = СоответствиеСвойств[НомерКолонки];
	// 1. Выбор конкретного значения свойства.
	Если Найти(Элемент.Имя, "КолонкаЗначениеСвойства") > 0 Тогда
		Если ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(СтрокаСоответствия.СвойствоМатериала, "ТипЗначения") = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("НомерКолонки", НомерКолонки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПравилаНаследованияЗначениеСвойстваВыборЗавершение", ЭтотОбъект, ДопПараметры);
			ПараметрыВыбора = Новый Структура;
			
			// Для справочника ЗначенияСвойствОбъектов отбор по владельцу.
			ПараметрыВыбора.Вставить("Отбор"				, Новый Структура("Владелец", СтрокаСоответствия.СвойствоМатериала));
			ПараметрыВыбора.Вставить("РежимВыбора"			, Истина);
			ПараметрыВыбора.Вставить("ЗакрыватьПриВыборе"	, Истина);
		
			ОткрытьФорму("Справочник.ЗначенияСвойствОбъектов.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
				
		Возврат;
		
	КонецЕсли;
	
	// 2. Выбор свойства продукции.
	Если Найти(Элемент.Имя, "КолонкаСвойствоПродукции") > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		Если СтрокаСоответствия.ЕстьДоступныеСвойстваДляВыбора Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("НомерКолонки", НомерКолонки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПравилаНаследованияСвойствоПродукцииВыборЗавершение", ЭтотОбъект, ДопПараметры);
			ПоказатьВыборИзСписка(ОписаниеОповещения, СтрокаСоответствия.СписокДоступныхСвойств, Элемент);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// 3. Выбор формулы.
	Если Найти(Элемент.Имя, "КолонкаФормула") > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("НомерКолонки", НомерКолонки);
		
		ПараметрыФормы = ПараметрыФормыРедактированияФормулы(СтрокаСоответствия.АлгоритмРасчетаЗначения);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПравилаНаследованияФормулаВыборЗавершение", ЭтотОбъект, ДопПараметры);
		
		ОткрытьФорму("ОбщаяФорма.КонструкторФормул", ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	КонецЕсли;
	
	// 4. Выбор алгоритма.
	Если Найти(Элемент.Имя, "КолонкаАлгоритм") > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если СтрокаСоответствия.ЕстьДоступныеФункцииДляВыбора Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("НомерКолонки", НомерКолонки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПравилаНаследованияФункцияРасчетаВыборЗавершение", ЭтотОбъект, ДопПараметры);
			
			ПоказатьВыборИзСписка(ОписаниеОповещения, СтрокаСоответствия.СписокДоступныхФункций, Элемент);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНаследованияСвойствоПродукцииВыборЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерКолонки = ДополнительныеПараметры.НомерКолонки;
	
	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	СтрокаСоответствия = СоответствиеСвойств[НомерКолонки];
	
	СтрокаПравила["КолонкаСвойствоПродукции" + НомерКолонки] = ВыбранныйЭлемент.Значение;
	СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству");
	СтрокаПравила["Изменена" + НомерКолонки] = Истина;
	
	СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству");
	СтрокаСоответствия.СвойствоПродукции = ВыбранныйЭлемент.Значение;
	СтрокаСоответствия.СвойствоПродукцииПредставление = ВыбранныйЭлемент.Представление;
	
	Элементы.СоответствиеСвойств.ТекущаяСтрока = СтрокаСоответствия.ПолучитьИдентификатор();
	
	ОпределениеИзмененияНастройки();
	ДобавитьВКоллекциюПравил(СтрокаПравила.УникальныйИдентификатор);
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПравилаНаследованияФункцияРасчетаВыборЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерКолонки = ДополнительныеПараметры.НомерКолонки;
	
	СтрокаПравила = Элементы.ПравилаНаследования.ТекущиеДанные;
	СтрокаСоответствия = СоответствиеСвойств[НомерКолонки];
	
	СтрокаПравила["КолонкаАлгоритм" + НомерКолонки] = ВыбранныйЭлемент.Значение;
	СтрокаПравила["СпособПодбораЗначения" + НомерКолонки] = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму");
	СтрокаПравила["Изменена" + НомерКолонки] = Истина;
	
	СтрокаСоответствия.СпособПодбораЗначения = ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму");
	СтрокаСоответствия.АлгоритмРасчетаЗначения = ВыбранныйЭлемент.Значение;
	СтрокаСоответствия.АлгоритмРасчетаЗначенияПредставление = ВыбранныйЭлемент.Представление;
	
	Элементы.СоответствиеСвойств.ТекущаяСтрока = СтрокаСоответствия.ПолучитьИдентификатор();
	
	ОпределениеИзмененияНастройки();
	ДобавитьВКоллекциюПравил(СтрокаПравила.УникальныйИдентификатор);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНаследованияФормулаВыборЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
