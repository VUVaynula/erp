&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = ТранслироватьВСпецификацию();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСоответствие(Команда)
	
	Для каждого ТекущиеДанные Из СоответствиеСвойств Цикл
		
		Если ТекущиеДанные.СписокДоступныхСвойств.Количество() = 1
			И ТекущиеДанные.СпособПодбораЗначения =
				ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ЛюбоеЗначение") Тогда
			
			ТекущиеДанные.СпособПодбораЗначения =
				ПредопределенноеЗначение("Перечисление.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству");
			ТекущиеДанные.СвойствоПродукции = ТекущиеДанные.СписокДоступныхСвойств[0].Значение;
			ТекущиеДанные.СвойствоПродукцииПредставление = ТекущиеДанные.СписокДоступныхСвойств[0].Представление;
			
			СинхронизироватьВерхнююСтрокуСНижнейТаблицей(ТекущиеДанные);
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекущийУид) Тогда
		ДобавитьВКоллекциюПравил(ТекущийУид);
	КонецЕсли;
	
	НастроитьВидимостьВсеПараметры();
	
КонецПроцедуры

&НаСервере
Функция ТранслироватьВСпецификацию()
	
	// Перед трансляцией сохраним текущую настройку правила,
	// иначе последние изменения в верхней/нижней таблице могут не попасть во временное хранилище.
	Если ЗначениеЗаполнено(ТекущийУид) Тогда
		ДобавитьВКоллекциюПравил(ТекущийУид);
	КонецЕсли;
	
	ТаблицаПараметров = ПравилаНаследования.Выгрузить();
	
	// Проверка дублей.
	// Старые КолонкаЗначениеN больше не существуют, поэтому строим служебные ключи.
	ТаблицаДляПроверки = ТаблицаПараметров.Скопировать();
	
	СписокКолонок = "";
	
	Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
		
		ИмяКлюча = "КлючПараметра" + сч;
		
		ТаблицаДляПроверки.Колонки.Добавить(ИмяКлюча, Новый ОписаниеТипов("Строка"));
		
		Для каждого СтрокаПроверки Из ТаблицаДляПроверки Цикл
			СтрокаПроверки[ИмяКлюча] = ПолучитьКлючПараметраПравилаНаследования(СтрокаПроверки, сч);
		КонецЦикла;
		
		СписокКолонок = СписокКолонок + ИмяКлюча + ",";
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СписокКолонок) Тогда
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(СписокКолонок, 1);
	КонецЕсли;
	
	ТаблицаДляПроверки.Колонки.Добавить("СчетчикСтрок", Новый ОписаниеТипов("Число"));
	ТаблицаДляПроверки.ЗаполнитьЗначения(1, "СчетчикСтрок");
	
	Если НЕ ПустаяСтрока(СписокКолонок) Тогда
		ТаблицаДляПроверки.Свернуть(СписокКолонок, "СчетчикСтрок");
	КонецЕсли;
	
	НомераСтрок = "";
	
	Для каждого СтрПроверки Из ТаблицаДляПроверки Цикл
		
		Если СтрПроверки.СчетчикСтрок > 1 Тогда
			
			СтруктураОтбора = Новый Структура;
			
			Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
				ИмяКлюча = "КлючПараметра" + сч;
				СтруктураОтбора.Вставить(ИмяКлюча, СтрПроверки[ИмяКлюча]);
			КонецЦикла;
			
			Для каждого СтрокаПараметров Из ТаблицаПараметров Цикл
				
				ЭтоДубль = Истина;
				
				Для сч = 0 По СоответствиеСвойств.Количество() - 1 Цикл
					
					ИмяКлюча = "КлючПараметра" + сч;
					
					Если ПолучитьКлючПараметраПравилаНаследования(СтрокаПараметров, сч) <> СтруктураОтбора[ИмяКлюча] Тогда
						ЭтоДубль = Ложь;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЭтоДубль Тогда
					НомераСтрок = НомераСтрок + СтрокаПараметров.Номер + ",";
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(НомераСтрок) Тогда
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(НомераСтрок, 1);
		
		ШаблонТекста = "Трансляция запрещена. Дублируются параметры наследования в строках №%1. Устраните дублирование параметров наследования и повторите попытку трансляции";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонТекста, НомераСтрок));
		
		Возврат Неопределено;
	КонецЕсли;
	
	Соответствие = ПолучитьИзВременногоХранилища(АдресСпискаПравил);
	
	СоответствиеПравил = Новый Соответствие;
	Результат = Новый Массив;
	
	Для каждого Стр Из ПравилаНаследования Цикл
		
		СоответствиеПравил.Вставить(Стр.УникальныйИдентификатор, Стр.Количество);
		
		ТаблицаНастройки = Соответствие.Получить(Стр.УникальныйИдентификатор);
		
		ИндексСтроки = ПравилаНаследования.Индекс(Стр);
			
		Если ЕстьОшибкиЗаполненияТаблицы(ТаблицаНастройки, ИндексСтроки + 1) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ТаблицаНастройки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаСоответствие Из ТаблицаНастройки Цикл
			
			НастройкаСоответствия = Новый Структура(УправлениеДаннымиОбИзделияхКлиентСервер.РеквизитыНастройкаСоответствияСвойств());
			
			ЗаполнитьЗначенияСвойств(НастройкаСоответствия, СтрокаСоответствие);
			НастройкаСоответствия.Вставить("КлючСвязи", Стр.УникальныйИдентификатор);
			
			Результат.Добавить(НастройкаСоответствия);
			
		КонецЦикла;
		
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("МатериалыИУслуги", СоответствиеПравил);
	СтруктураВозврата.Вставить("СоответствиеСвойств", Результат);
	
	УдалитьИзВременногоХранилища(АдресСпискаПравил);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ПолучитьКлючПараметраПравилаНаследования(СтрокаПравила, НомерКолонки)
	
	ИмяСпособа = "СпособПодбораЗначения" + НомерКолонки;
	
	Попытка
		Способ = СтрокаПравила[ИмяСпособа];
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если Способ = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоСвойству Тогда
		ИмяЗначения = "КолонкаСвойствоПродукции" + НомерКолонки;
		
	ИначеЕсли Способ = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоЗначению Тогда
		ИмяЗначения = "КолонкаЗначениеСвойства" + НомерКолонки;
		
	ИначеЕсли Способ = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоФормуле Тогда
		ИмяЗначения = "КолонкаФормула" + НомерКолонки;
		
	ИначеЕсли Способ = Перечисления.СпособыПодбораЗначенияСвойстваНоменклатуры.ПоАлгоритму Тогда
		ИмяЗначения = "КолонкаАлгоритм" + НомерКолонки;
		
	Иначе
		ИмяЗначения = "";
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяЗначения) Тогда
		Возврат ЗначениеВСтрокуВнутр(Способ);
	КонецЕсли;
	
	Попытка
		ЗначениеПараметра = СтрокаПравила[ИмяЗначения];
	Исключение
		ЗначениеПараметра = Неопределено;
	КонецПопытки;
	
	Возврат ЗначениеВСтрокуВнутр(Способ) + "|" + ЗначениеВСтрокуВнутр(ЗначениеПараметра);
	
КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДанныеДляКонструктораФормул

&НаСервере
Функция ПараметрыФормыРедактированияФормулы(Формула)
	
	ПФ = Новый Структура;
	
	ПФ.Вставить("Формула", Формула);
	ПФ.Вставить("ДеревоОперандов", АдресХранилищаДереваОперандов);
	ПФ.Вставить("Операторы", АдресХранилищаДереваОператоров);
	ПФ.Вставить("ИспользуетсяДеревоОперандов", Истина);
	ПФ.Вставить("ФункцииИзОбщегоМодуля", УправлениеДаннымиОбИзделияхПовтИсп.ОписаниеФункцийКонструктораФормул());
	ПФ.Вставить("ТипРезультата", Новый ОписаниеТипов("Число"));
	
	Возврат ПФ;
	
КонецФункции

&НаСервере
Процедура СформироватьДанныеДляПодбораПоФормуле(СвойстваПродукции)
	
	ДеревоОперандов = РаботаСФормулами.ПолучитьПустоеДеревоОперандов();
	ТипыЭлементовДерева = РаботаСФормулами.ТипыЭлементовДереваОперандов();
	
	ГруппаПродукция = РаботаСФормулами.НоваяСтрокаДереваОперанда(ДеревоОперандов);
	ГруппаПродукция.Идентификатор = "СвойстваПродукции";
	ГруппаПродукция.Представление = НСтр("ru = 'Свойства продукции'; |en = 'Product properties'");
	ГруппаПродукция.ТипЭлементаДерева = ТипыЭлементовДерева.ГруппаСтрокВерхнегоУровня;
	ГруппаПродукция.РазрешаетсяВыборОперанда = Ложь;
	ГруппаПродукция.ВключаетсяВИдентификатор = Ложь;
	
	Для каждого Свойство Из СвойстваПродукции Цикл
		Если Свойство.ТипЗначения.СодержитТип(Тип("Число")) 
			ИЛИ Свойство.ТипЗначения.СодержитТип(Тип("Строка")) 
			ИЛИ Свойство.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			СтрокаОперанда = РаботаСФормулами.НоваяСтрокаДереваОперанда(ГруппаПродукция);
			СтрокаОперанда.Идентификатор = Свойство.Идентификатор;
			СтрокаОперанда.Представление = Свойство.Представление;
			СтрокаОперанда.ТипЗначения = Свойство.ТипЗначения;
			СтрокаОперанда.ТипЭлементаДерева = ТипыЭлементовДерева.ДополнительныйРеквизит;
		КонецЕсли;
	КонецЦикла;
	
	АдресХранилищаДереваОперандов = ПоместитьВоВременноеХранилище(ДеревоОперандов, УникальныйИдентификатор);
	
	ДеревоОператоров = УправлениеДаннымиОбИзделиях.ПостроитьДеревоОператоров();
	АдресХранилищаДереваОператоров = ПоместитьВоВременноеХранилище(ДеревоОператоров, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

