&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Элементы.Найти("бит_ПечатьБегунков") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечати = Команды.Добавить("бит_ПечатьБегунков");
	КомандаПечати.Заголовок = "Печать бегунков";
	КомандаПечати.Действие = "бит_ПечатьБегунков";
	
	КнопкаПечати = Элементы.Добавить(
		"бит_ПечатьБегунков",
		Тип("КнопкаФормы"),
		Элементы.СписокКоманднаяПанель);
	КнопкаПечати.ИмяКоманды = "бит_ПечатьБегунков";
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ПечатьБегунков(Команда)
	
	Этапы = ВыбранныеЭтапы();
	Если Этапы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не выбран ни один этап для печати. (Лист требований ЛТ6.9)");
		Возврат;
	КонецЕсли;
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Документ.ЭтапПроизводства2_2",
		"бит_ПечатьБегункаЭтапаПроизводства",
		Этапы,
		ЭтаФорма);
	
КонецПроцедуры

