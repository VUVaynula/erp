//==================== ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ПОСТРОИТЕЛЕМ ====================

Функция ДобавитьОтбор(ПутьКДанным, Использование = Неопределено, ВидСравнения = Неопределено, Значение = Неопределено, ЗначениеС = Неопределено, ЗначениеПо = Неопределено) Экспорт
	
	ДобавляемыйЭлементОтбора = Неопределено;
	
	Для Каждого ЭлементОтбора из ПостроительОтчета.Отбор Цикл
		Если ЭлементОтбора.ПутьКДанным = ПутьКДанным Тогда
			ДобавляемыйЭлементОтбора = ЭлементОтбора;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДобавляемыйЭлементОтбора = Неопределено Тогда
		Попытка ДобавляемыйЭлементОтбора = ПостроительОтчета.Отбор.Добавить(ПутьКДанным) Исключение	Возврат Ложь КонецПопытки;
	КонецЕсли;
	
	Если Использование <> Неопределено Тогда
		ДобавляемыйЭлементОтбора.Использование = Использование;
	КонецЕсли;
	
	Если ВидСравнения <> Неопределено Тогда
		ДобавляемыйЭлементОтбора.ВидСравнения = ВидСравнения;
	КонецЕсли;
	
	Если Значение <> Неопределено Тогда
		ДобавляемыйЭлементОтбора.Значение = Значение;
	КонецЕсли;
	
	Если ЗначениеС <> Неопределено Тогда
		ДобавляемыйЭлементОтбора.ЗначениеС = ЗначениеС;
	КонецЕсли;
	
	Если ЗначениеПо <> Неопределено Тогда
		ДобавляемыйЭлементОтбора.ЗначениеПо = ЗначениеПо;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции 

Функция ПолеНачалоВыбора(Расшифровка = Неопределено, НачальноеЗначениеВыбора = Неопределено) Экспорт
	
	ФормаВыборПоля = ПолучитьОбщуюФорму("ПостроительОтчета_ФормаВыборПоля");
	
	ФормаВыборПоля.ПостроительОтчета 						= ПостроительОтчета;
	ФормаВыборПоля.мСоответствиеСвойствКатегорийИИзмерений 	= мСоответствиеСвойствКатегорийИИзмерений_ПостроительОтчета;
	
	ФормаВыборПоля.Расшифровка 								= Расшифровка;
	ФормаВыборПоля.НачальноеЗначениеВыбора 					= НачальноеЗначениеВыбора;
	
	ФормаВыборПоля.Измерение 								= Ложь;
	ФормаВыборПоля.Отбор 									= Ложь;
	ФормаВыборПоля.Поле 									= Ложь;
	ФормаВыборПоля.Порядок 									= Ложь;
	ФормаВыборПоля.ДочерниеПоля 							= Истина;
	
	Возврат ФормаВыборПоля.ОткрытьМодально();
	
КонецФункции 

Процедура ПолеОбработкаВыбора(Элемент, Выбор, ЭлементФормыТабличноеПоле, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если Выбор = Неопределено ИЛИ Выбор.Количество() = 0 Тогда
		ЭлементФормыТабличноеПоле.ЗакончитьРедактированиеСтроки(Истина);
		Возврат;
	КонецЕсли;
		
	Если Выбор.Количество() = 1 И ТипЗнч(Выбор[0].ПутьКДанным) <> Тип("Массив") Тогда
				
		Элемент.Значение = Выбор[0].ПутьКДанным; 
		
		глУстановитьПредставлениеПараметра(ЭлементФормыТабличноеПоле.ТекущиеДанные);
		// переопределим представление 		
		Элемент.Значение = ЭлементФормыТабличноеПоле.ТекущиеДанные.Представление;
		
	Иначе
		
		Для Каждого ВыбранноеЗначение из Выбор Цикл
			Если ТипЗнч(ВыбранноеЗначение.ПутьКДанным) = Тип("Массив") Тогда
				Для Каждого ПутьКДанным из ВыбранноеЗначение.ПутьКДанным Цикл
					ДобавитьОтбор(ПутьКДанным);
				КонецЦикла;
			Иначе
				ДобавитьОтбор(ВыбранноеЗначение.ПутьКДанным);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

//==================== ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ==============================

Функция СекундыВДниЧасы(ВхСекунды) Экспорт  
	
	Если ВхСекунды = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	_СтрДниЧасы = "";
	_ТекСекунды = ВхСекунды;
	
	_Час = 60*60;
	_Часов = Цел(_ТекСекунды/_Час);
	_ТекСекунды = _ТекСекунды - _Часов * _Час;
	_СтрДниЧасы = _СтрДниЧасы + Формат(_Часов, "ЧН=0") + ":";
	
	_Минута = 60;
	_Минут = Цел(_ТекСекунды/_Минута);
	_ТекСекунды = _ТекСекунды - _Минут * _Минута;
	_СтрДниЧасы = _СтрДниЧасы + Формат(_Минут, "ЧЦ=2; ЧН=00; ЧВН=") + ":";
	
	_СтрДниЧасы = _СтрДниЧасы + Формат(_ТекСекунды, "ЧЦ=2; ЧН=00; ЧВН=");
	
	Возврат _СтрДниЧасы;
	
КонецФункции

Процедура УстановитьЗначениеПометкиСтроки(ВхСтрока, ВхЗнач) Экспорт 
	
	Если ВхСтрока.ТипСоставляющей = "Период" И ВхСтрока.Строки.Количество() = 0 Тогда 
		Возврат;	
	КонецЕсли;
	
	Если ВхСтрока.ТипСоставляющей = "ДокЗаказНаПроизводство" Тогда 
		ТаблЗаказы.Найти(ВхСтрока.Составляющая, "ДокЗаказ").Пометка = ВхЗнач;	
	КонецЕсли;
	
	ВхСтрока.Пометка = ВхЗнач;
		
	ИзменитьЗначениеПометкиПодчинненыхСтрок(ВхСтрока, ВхЗнач);
	
	ИзменитьЗначениеПометкиРодительскойСтроки(ВхСтрока.Родитель);
	
КонецПроцедуры	

Процедура ИзменитьЗначениеПометкиПодчинненыхСтрок(ВхСтрока, ВхЗнач) 
		
	Для Каждого Строка Из ВхСтрока.Строки Цикл
		
		Если Строка.ТипСоставляющей = "ДокЗаказНаПроизводство" Тогда 
			ТаблЗаказы.Найти(Строка.Составляющая, "ДокЗаказ").Пометка = ВхЗнач;	
		КонецЕсли;

		Строка.Пометка = ВхЗнач;
		ИзменитьЗначениеПометкиПодчинненыхСтрок(Строка, ВхЗнач);
		
	КонецЦикла;	

КонецПроцедуры	

Процедура ИзменитьЗначениеПометкиРодительскойСтроки(ВхСтрока) 
	
	Если ВхСтрока = Неопределено Тогда
		Возврат;	
	КонецЕсли;
		
	ВхСтрока.Пометка = Истина;
	Для Каждого Строка Из ВхСтрока.Строки Цикл
		ВхСтрока.Пометка = ВхСтрока.Пометка И Строка.Пометка;	
	КонецЦикла; 	
	
	ИзменитьЗначениеПометкиРодительскойСтроки(ВхСтрока.Родитель);
	
КонецПроцедуры	


Процедура ОбработатьСвязанныеЗаказы_ОбновлениеТаблЗаказы() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗапроса.ДокЗаказОбеспечения,
	|	ТаблицаЗапроса.ДокЗаказПотребность,
	|	ТаблицаЗапроса.ДокЗаказОбеспечения.ДатаИсполнения КАК ДокЗаказОбеспеченияДатаИсполнения,
	|	ТаблицаЗапроса.ДокЗаказПотребность.ДатаИсполнения КАК ДокЗаказПотребностьДатаИсполнения,
	|	ТаблицаЗапроса.ДокЗаказОбеспечения.ДатаОбеспеченияПотребностей КАК ДокЗаказОбеспеченияДатаОбеспеченияПотребностей,
	|	ТаблицаЗапроса.ДокЗаказПотребность.ДатаОбеспеченияПотребностей КАК ДокЗаказПотребностьДатаОбеспеченияПотребностей
	|ИЗ
	|	(ВЫБРАТЬ
	|		РазмещениеЗаказовОстатки.ВЗаказе КАК ДокЗаказОбеспечения,
	|		РазмещениеЗаказовОстатки.ДокЗаказ КАК ДокЗаказПотребность
	|	ИЗ
	|		РегистрНакопления.РазмещениеЗаказов.Остатки(
	|				,
	|				ДокЗаказ В (&СпЗаказы)
	|					ИЛИ ВЗаказе В (&СпЗаказы)) КАК РазмещениеЗаказовОстатки) КАК ТаблицаЗапроса";
	
	Запрос.УстановитьПараметр("СпЗаказы", ТаблЗаказы.ВыгрузитьКолонку("ДокЗаказ"));
	ТаблРез = Запрос.Выполнить().Выгрузить();
	
	Для Каждого строка_ТаблЗаказы Из ТаблЗаказы Цикл
		
		// 1. поиск проблемных заказов по иерархии вверх ("Заказы потребность")
		стру_Отбор = Новый Структура("ДокЗаказОбеспечения", строка_ТаблЗаказы.ДокЗаказ);
		масс_ТаблЗаказыПотребность = ТаблРез.НайтиСтроки(стру_Отбор);
		
		Для Каждого строка_ТаблЗаказыПотребность Из масс_ТаблЗаказыПотребность Цикл
			
			Если глПустоеЗначение(строка_ТаблЗаказыПотребность.ДокЗаказПотребность) Тогда
				Продолжить;	
			КонецЕсли;	
			
			Если глПустоеЗначение(строка_ТаблЗаказыПотребность.ДокЗаказПотребностьДатаОбеспеченияПотребностей)
				ИЛИ строка_ТаблЗаказы.ДатаИсполнения >  строка_ТаблЗаказыПотребность.ДокЗаказПотребностьДатаОбеспеченияПотребностей Тогда
				
				строка_ТаблЗаказы.ЕстьОшибкиВЗаказахПотребность = Истина;
				Прервать;
				
			КонецЕсли;				 
			
		КонецЦикла;	
		
		// 2. поиск проблемных заказов по иерархии вниз ("Заказы обеспечения")
		стру_Отбор = Новый Структура("ДокЗаказПотребность", строка_ТаблЗаказы.ДокЗаказ);
		масс_ТаблЗаказыОбеспечения = ТаблРез.НайтиСтроки(стру_Отбор);
		
		Для Каждого строка_ТаблЗаказыОбеспечения Из масс_ТаблЗаказыОбеспечения Цикл
			
			Если глПустоеЗначение(строка_ТаблЗаказыОбеспечения.ДокЗаказОбеспечения) Тогда
				Продолжить;	
			КонецЕсли;	

			Если глПустоеЗначение(строка_ТаблЗаказыОбеспечения.ДокЗаказОбеспеченияДатаИсполнения)
				ИЛИ строка_ТаблЗаказы.ДатаОбеспеченияПотребностей < строка_ТаблЗаказыОбеспечения.ДокЗаказОбеспеченияДатаИсполнения Тогда
				
				строка_ТаблЗаказы.ЕстьОшибкиВЗаказахОбеспечения = Истина;
				Прервать;
				
			КонецЕсли;				 
			
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеПоляПоЗаказуПокупателя() Экспорт 
	
	_ТаблЗаказыВрем = Неопределено;
    _ДатаИсполнения = '00010101';
	
	_ИндСтр = 0;
	Пока _ИндСтр < ТаблЗаказы.Количество() Цикл
		
		СтрокаТаблЗаказы = ТаблЗаказы[_ИндСтр];
		
		Если глПустоеЗначение(СтрокаТаблЗаказы.ДокЗаказПокупателя) Тогда
			
			СтрокаТаблЗаказы.ДокЗаказПокупателя					= глПолучитьЗаказПокупателя(СтрокаТаблЗаказы.ДокЗаказ, _ТаблЗаказыВрем, _ДатаИсполнения);
			СтрокаТаблЗаказы.ДокЗаказПокупателяДатаИсполнения	= _ДатаИсполнения;
			
		КонецЕсли;	

		Если ПостроительОтчета.Отбор.ДокЗаказПокупателя.Использование Тогда
			
			ВидСравненияОтбора	= ПостроительОтчета.Отбор.ДокЗаказПокупателя.ВидСравнения; 
			ЗначениеОтбора		= ПостроительОтчета.Отбор.ДокЗаказПокупателя.Значение;
			
			Если (ВидСравненияОтбора = ВидСравнения.Равно И НЕ ЗначениеОтбора = СтрокаТаблЗаказы.ДокЗаказПокупателя)
					ИЛИ (ВидСравненияОтбора = ВидСравнения.НеРавно	 И ЗначениеОтбора = СтрокаТаблЗаказы.ДокЗаказПокупателя)
		 			ИЛИ (ВидСравненияОтбора = ВидСравнения.ВСписке	 И ЗначениеОтбора.НайтиПоЗначению(СтрокаТаблЗаказы.ДокЗаказПокупателя) = Неопределено)
					ИЛИ (ВидСравненияОтбора = ВидСравнения.НеВСписке И НЕ ЗначениеОтбора.НайтиПоЗначению(СтрокаТаблЗаказы.ДокЗаказПокупателя) = Неопределено) Тогда
				
				ТаблЗаказы.Удалить(СтрокаТаблЗаказы);
				
				Продолжить;
				
			КонецЕсли;	
				
		КонецЕсли;	
		
		_ИндСтр = _ИндСтр + 1;
		
	КонецЦикла;	

	// добавим индекс
	ТаблЗаказы.Индексы.Добавить("ДокЗаказПокупателя");
	
КонецПроцедуры	

Процедура РедактироватьСтатусВыполненияЗаказа(ВхЗаказ, ВхСтатус) Экспорт 
	
	запись_СтатусыВыполненияЗаказов = РегистрыСведений.СтатусыВыполненияЗаказов.СоздатьМенеджерЗаписи();
	запись_СтатусыВыполненияЗаказов.Заказ = ВхЗаказ;
	запись_СтатусыВыполненияЗаказов.Прочитать();
	
	_СтарыйСтатус = запись_СтатусыВыполненияЗаказов.Статус;
	
	запись_СтатусыВыполненияЗаказов.Статус 	= ВхСтатус;
	запись_СтатусыВыполненияЗаказов.Заказ 	= ВхЗаказ;
	
	запись_СтатусыВыполненияЗаказов.Записать();
	
	запись_СтатусыВыполненияЗаказов.Прочитать();
	Если НЕ запись_СтатусыВыполненияЗаказов.Статус = _СтарыйСтатус Тогда
		
		СтатусыЗаказов.ПроверитьСтатусыЗаказа(ВхЗаказ.Ссылка);
		
	КонецЕсли;
	
	//Если все таки изменение статуса валидно, то проверяем установку утвержденности
	запись_СтатусыВыполненияЗаказов.Прочитать();
	Если НЕ запись_СтатусыВыполненияЗаказов.Статус = _СтарыйСтатус Тогда
		
		Если НЕ ВхЗаказ.Утвержден = запись_СтатусыВыполненияЗаказов.Статус.УтверждатьЗаказ Тогда
			
			_ДокЗаказОбъект = ВхЗаказ.ПолучитьОбъект();
			
			_ДокЗаказОбъект.Утвержден = запись_СтатусыВыполненияЗаказов.Статус.УтверждатьЗаказ;
			_ДокЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначениеДеревоАльтернативныеРЦ(ВхИмяКолонки, ВхЗначение, ВхСтрокаДерева)
	
	_КолонкаДеревоАльтернативныеРЦ = ДеревоАльтернативныеРЦ.Колонки.Найти(ВхИмяКолонки);		
	Если _КолонкаДеревоАльтернативныеРЦ = Неопределено Тогда 
		_КолонкаДеревоАльтернативныеРЦ = ДеревоАльтернативныеРЦ.Колонки.Добавить(ВхИмяКолонки);
	КонецЕсли;
	
	ВхСтрокаДерева[ВхИмяКолонки] = ВхЗначение;

КонецПроцедуры

Процедура ДобавитьИнтервалыВЗначениеДГОтносительные(ВхЗначение, ВхЗначениеПоказателя, ВхПериодНачалаПостроения, ВхПоказательЦветовыхСхем)
	
	// Левая часть
	Если ВхЗначениеПоказателя < 0 Тогда
		
		_ИнтервалЗаливки = ВхПериодНачалаПостроения + 100 + Макс(ВхЗначениеПоказателя, -100);
		
		_Интервал = ВхЗначение.Добавить();	
		_Интервал.Начало 		= ВхПериодНачалаПостроения;	
		_Интервал.Конец 		= _ИнтервалЗаливки;
		_Интервал.Цвет 			= ЦветаСтиля.ЦветФонаКнопки; 
		
		_Интервал = ВхЗначение.Добавить();	
		_Интервал.Начало 		= _ИнтервалЗаливки;	
		_Интервал.Конец 		= ВхПериодНачалаПостроения + 100;
		
		стру_ЦветоваяСхема 	= РегистрыСведений.ЦветовыеСхемы.ПолучитьЦветовуюСхему(ВхПоказательЦветовыхСхем, ВхЗначениеПоказателя);
		_Интервал.Цвет 		= стру_ЦветоваяСхема.ЦветФона;
		
	Иначе //Если ВхЗначениеПоказателя >= 0 Тогда
		
		_Интервал = ВхЗначение.Добавить();	
		_Интервал.Начало 		= ВхПериодНачалаПостроения;	
		_Интервал.Конец 		= ВхПериодНачалаПостроения + 100;
		_Интервал.Цвет 			= ЦветаСтиля.ЦветФонаКнопки;
		
	КонецЕсли;
	
	// Разделитель	
	_Интервал = ВхЗначение.Добавить();	
	_Интервал.Начало 		= ВхПериодНачалаПостроения + 100;	
	_Интервал.Конец 		= ВхПериодНачалаПостроения + 101;
	_Интервал.Цвет 			= ЦветаСтиля.ЦветОтрицательногоЧисла;
		
	// Правая часть
	Если ВхЗначениеПоказателя >= 0 Тогда
		
		_ИнтервалЗаливки = ВхПериодНачалаПостроения + 101 + Мин(ВхЗначениеПоказателя, 100);
		
		Если ВхЗначениеПоказателя > 0 Тогда 
			
			_Интервал = ВхЗначение.Добавить();	
			_Интервал.Начало 		= ВхПериодНачалаПостроения + 101;	
			_Интервал.Конец 		= _ИнтервалЗаливки;
			
			стру_ЦветоваяСхема 	= РегистрыСведений.ЦветовыеСхемы.ПолучитьЦветовуюСхему(ВхПоказательЦветовыхСхем, ВхЗначениеПоказателя);
			_Интервал.Цвет 		= стру_ЦветоваяСхема.ЦветФона;
		
		КонецЕсли;
		
		_Интервал = ВхЗначение.Добавить();	
		_Интервал.Начало 		= _ИнтервалЗаливки;	
		_Интервал.Конец 		= _ИнтервалЗаливки + 100 - Макс(ВхЗначениеПоказателя, 0);
		_Интервал.Цвет 			= ЦветаСтиля.ЦветФонаКнопки;
		
		
	Иначе //Если ВхЗначениеПоказателя < 0 Тогда
		
		_Интервал = ВхЗначение.Добавить();	
		_Интервал.Начало 		= ВхПериодНачалаПостроения + 101;	
		_Интервал.Конец 		= ВхПериодНачалаПостроения + 201;
		_Интервал.Цвет 			= ЦветаСтиля.ЦветФонаКнопки;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьИспользованиеПоказателя(ВхПоказатель)
	
	_Результат = Ложь;
	
	эл_Показатель = СписокПоказателей.НайтиПоЗначению(ВхПоказатель);
	
	Если НЕ эл_Показатель = Неопределено Тогда 
		_Результат = эл_Показатель.Пометка;	
	КонецЕсли;
	
	Возврат _Результат;
	
КонецФункции

Функция ПолучитьСтрокуПакетногоЗаказа(ВхСтрокаДерева, ВхСтрокаДанных)
	
	Если глПустоеЗначение(ВхСтрокаДанных.ПакетныйЗаказНаПроизводство) Тогда
		Возврат ВхСтрокаДерева; //Возвращаем саму строку получателя
	КонецЕсли;	
		
	масс_ДеревоПакетныйЗаказ = ВхСтрокаДерева.Строки.НайтиСтроки(Новый Структура("ТипСоставляющей, ПакетныйЗаказНаПроизводство", 
																					"ПакетныйЗаказНаПроизводство",
																					ВхСтрокаДанных.ПакетныйЗаказНаПроизводство));
																					
	Если масс_ДеревоПакетныйЗаказ.Количество() = 1 Тогда 		
		строка_ДеревоПакетныйЗаказ = масс_ДеревоПакетныйЗаказ[0];	
	Иначе
		
		строка_ДеревоПакетныйЗаказ = ВхСтрокаДерева.Строки.Добавить();
		строка_ДеревоПакетныйЗаказ.ТипСоставляющей				= "ПакетныйЗаказНаПроизводство";
		строка_ДеревоПакетныйЗаказ.Составляющая					= ВхСтрокаДанных.ПакетныйЗаказНаПроизводство;
		строка_ДеревоПакетныйЗаказ.ПакетныйЗаказНаПроизводство	= ВхСтрокаДанных.ПакетныйЗаказНаПроизводство;
		строка_ДеревоПакетныйЗаказ.РабочийЦентр					= ВхСтрокаДанных.ПакетныйЗаказНаПроизводствоРабочийЦентр;
		строка_ДеревоПакетныйЗаказ.ТехнологическаяОперация		= ВхСтрокаДанных.ПакетныйЗаказНаПроизводствоТехнологическаяОперация;
		строка_ДеревоПакетныйЗаказ.Пометка						= ВхСтрокаДанных.Пометка;
		строка_ДеревоПакетныйЗаказ.Период		    			= ВхСтрокаДанных.ДатаДняИсполнения;
		строка_ДеревоПакетныйЗаказ.Начало						= ВхСтрокаДерева.Начало;
		строка_ДеревоПакетныйЗаказ.Окончание					= ВхСтрокаДерева.Окончание;
		строка_ДеревоПакетныйЗаказ.Приоритет					= ВхСтрокаДанных.ПакетныйЗаказНаПроизводствоПриоритет;
		
	КонецЕсли;	
	
	Возврат строка_ДеревоПакетныйЗаказ;
	
КонецФункции

