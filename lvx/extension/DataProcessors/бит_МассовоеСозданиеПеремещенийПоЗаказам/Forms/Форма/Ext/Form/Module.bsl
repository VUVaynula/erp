&НаКлиенте
Процедура дсУправлениеЗаказамиНаПеремещениеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТД = Элемент.ТекущиеДанные;                  
	ТекПоле = СтрЗаменить(Поле.Имя, Элемент.Имя, "");   
	Если ТекПоле = "ЗаказКлиента" 
		Или ТекПоле = "Назначение"
		или ТекПоле = "Номенклатура"
		Или ТекПоле = "Характеристика" 
		Или ТекПоле = "Ссылка" Тогда
		
		ОткрытьЗначение(ТД[ТекПоле]);
		
	КонецЕсли;

КонецПроцедуры

