	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(дсУправлениеЗаказамиНаПеремещение, 
																			"СкладПолучательОтбор", 
																			СкладПолучатель,
																			ЗначениеЗаполнено(СкладПолучатель));																
	Элементы.дсУправлениеЗаказамиНаПеремещение.Обновить();
	РассчитатьИтоги();
	
	ЗаголовокКолонкиПроизведено(); 
	
КонецПроцедуры

