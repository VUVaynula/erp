&НаКлиенте
Процедура Отгрузить(Команда)

	мВыделенных = Элементы.дсУправлениеЗаказамиНаПеремещение.ВыделенныеСтроки;
	мДанныхЗаказа = Новый Массив;
	Для каждого стр из мВыделенных Цикл
		ТД = Элементы.дсУправлениеЗаказамиНаПеремещение.ДанныеСтроки(стр);
		Если ТД.Произведено = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строка не обеспечена. Невозможно произвести отгрузку");
			Продолжить;   
		ИначеЕсли ТД.СостояниеОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строка уже в статусе Отгрузить. Действий не требуется");
			Продолжить;
		Иначе    
			мДанныхЗаказа.Добавить(Новый Структура("Заказ, НомерСтроки, Номенклатура, Характеристика, СкладОтправитель", ТД.Ссылка, ТД.НомерСтроки, ТД.Номенклатура, ТД.Характеристика, ТД.СкладОтправитель));
		КонецЕсли;
		
	КонецЦикла;  
	
	Если мДанныхЗаказа.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("нет строк для отгрузки");	
		Возврат;
	КонецЕсли;
	
	ОтгрузитьНаСервере(мДанныхЗаказа);
	Элементы.дсУправлениеЗаказамиНаПеремещение.Обновить();
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отгрузка выделенных строк завершена");
	
КонецПроцедуры 

&НаСервере
Процедура ОтгрузитьНаСервере(мДанныхЗаказа)

	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПеремещение"));
	тз.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	тз.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	тз.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры")); 
	тз.Колонки.Добавить("СкладОтправитель", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	Для каждого стр из мДанныхЗаказа Цикл
		нов = тз.Добавить();
		ЗаполнитьЗначенияСвойств(нов, стр);
	КонецЦикла;                            
	// получим таблицу остатка чтобы не гонять запрос в цикле
	Запрос = Новый Запрос("ВЫБРАТЬ Различные
	                      |	вт.Заказ КАК Заказ,
	                      |	вт.Номенклатура КАК Номенклатура,
	                      |	вт.Характеристика КАК Характеристика,
	                      |	вт.СкладОтправитель КАК СкладОтправитель
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&вт КАК вт
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                      |	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	                      |	ТоварыНаСкладахОстатки.Назначение.Заказ КАК Заказ,
	                      |	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток,
	                      |	ТоварыНаСкладахОстатки.Серия КАК Серия
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт КАК вт
	                      |		ПО ТоварыНаСкладахОстатки.Номенклатура = вт.Номенклатура
	                      |			И ТоварыНаСкладахОстатки.Характеристика = вт.Характеристика
	                      |			И ТоварыНаСкладахОстатки.Назначение.Заказ = вт.Заказ
	                      |			И ТоварыНаСкладахОстатки.Склад = вт.СкладОтправитель");
	Запрос.УстановитьПараметр("вт", тз);
	ТаблицаОстатковПоСериям = Запрос.Выполнить().Выгрузить();
	
	ОбъектыЗаказов = Новый Соответствие;
	Для каждого стр из тз Цикл
		ДокОбъект = ОбъектыЗаказов.Получить(стр.Заказ);
		Если ДокОбъект = Неопределено Тогда
			ДокОбъект = стр.Заказ.ПолучитьОбъект();
			ОбъектыЗаказов.Вставить(стр.Заказ, ДокОбъект);
		КонецЕсли;
		
		СтрокаЗаказа = ДокОбъект.Товары.Найти(стр.НомерСтроки, "НомерСтроки");
		СтрокиОстатков = ТаблицаОстатковПоСериям.НайтиСтроки(Новый Структура("Заказ, Номенклатура, Характеристика", стр.Заказ, стр.Номенклатура, стр.Характеристика));
        Если СтрокиОстатков.Количество() Тогда
			ОбработатьСтрокуТоваров_Отгрузить(ДокОбъект, СтрокаЗаказа, СтрокиОстатков);     
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + стр.Заказ + " для " + стр.Номенклатура + " " + стр.Характеристика + " нет остатков для перевода строки в состояние `Отгрузить`.");
		КонецЕсли;
		
	КонецЦикла;
	// запишем документы
	Для Каждого ПараЗаказа Из ОбъектыЗаказов Цикл
		Попытка
			ПараЗаказа.Значение.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать " + Строка(ПараЗаказа.Ключ) + " по причине " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), ПараЗаказа.Ключ);
		КонецПопытки;
	КонецЦикла; 

КонецПроцедуры    

&НаСервере
Процедура ОбработатьСтрокуТоваров_Отгрузить(ДокОбъект, СтрокаЗаказа, СтрокиОстатков)
	
	ОсталосьОбеспечить = СтрокаЗаказа.Количество;
	
	НачалоОтгрузки = ТекущаяДатаСеанса();
	
	Для Каждого СтрокаОстатка Из СтрокиОстатков Цикл
		
		Если ОсталосьОбеспечить <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если СтрокаОстатка.Остаток <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОсталосьОбеспечить <= СтрокаОстатка.Остаток Тогда
			СтрокаЗаказа.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить; 
			СтрокаЗаказа.НачалоОтгрузки = НачалоОтгрузки;   
			Если ДокОбъект.ИспользоватьДлительностьПеремещения 
				И ЗначениеЗаполнено(ДокОбъект.ДлительностьПеремещения) Тогда 
				СтрокаЗаказа.ОкончаниеПоступления = НачалоОтгрузки + (ДокОбъект.ДлительностьПеремещения * 86400);
			КонецЕсли;
			
			Если СтрокаЗаказа.Номенклатура.ВидНоменклатуры.ИспользоватьСерии Тогда
				СтрокаЗаказа.Серия = СтрокаОстатка.Серия;
				СтрокаЗаказа.СтатусУказанияСерий = 14; 
			КонецЕсли;
			СтрокаОстатка.Остаток = СтрокаОстатка.Остаток - ОсталосьОбеспечить;
			ОсталосьОбеспечить = 0;  
			
			Прервать;
		Иначе
			
			нов = ДокОбъект.товары.Добавить();
			ЗаполнитьЗначенияСвойств(нов, СтрокаЗаказа); 
			
			нов.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;  
			нов.НачалоОтгрузки = НачалоОтгрузки;
			Если ДокОбъект.ИспользоватьДлительностьПеремещения 
				И ЗначениеЗаполнено(ДокОбъект.ДлительностьПеремещения) Тогда 
				СтрокаЗаказа.ОкончаниеПоступления = НачалоОтгрузки + (ДокОбъект.ДлительностьПеремещения * 86400);
			КонецЕсли;
			
			нов.КодСтроки = ДокОбъект.товары.Количество();
			
			Если нов.Номенклатура.ВидНоменклатуры.ИспользоватьСерии Тогда
				нов.Серия = СтрокаОстатка.Серия;
				нов.СтатусУказанияСерий = 14; 
			КонецЕсли;
			// уменьшим исходную строку
			СтрокаЗаказа.Количество = СтрокаЗаказа.Количество - СтрокаОстатка.Остаток;
			
			// установим количество в новой строке
			нов.Количество = СтрокаОстатка.Остаток;
			ОсталосьОбеспечить = ОсталосьОбеспечить - СтрокаОстатка.Остаток;
			СтрокаОстатка.Остаток = 0;
			
			// упаковки 
			Если ЗначениеЗаполнено(СтрокаЗаказа.Упаковка) Тогда  
				коэффициент = СтрокаЗаказа.Упаковка.Числитель / СтрокаЗаказа.Упаковка.Знаменатель;
			Иначе                                              
				коэффициент = 1;
			КонецЕсли;                                                 
			
			Если коэффициент = 0 Тогда
				коэффициент = 1;
			КонецЕсли;
			СтрокаЗаказа.КоличествоУпаковок = СтрокаЗаказа.Количество / коэффициент;
			нов.КоличествоУпаковок = нов.Количество / коэффициент;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Процедура СформироватьПеремещение(Команда)

	СозданныеДокументы.Очистить();
    мДанныхЗаказа = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.дсУправлениеЗаказамиНаПеремещение.ВыделенныеСтроки Цикл

		ТекущиеДанные = Элементы.дсУправлениеЗаказамиНаПеремещение.ДанныеСтроки(ИдентификаторСтроки);
		Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Произведено <= 0 Тогда
			Продолжить;
		КонецЕсли;

		мДанныхЗаказа.Добавить(Новый Структура("Заказ,НомерСтроки", ТекущиеДанные.Ссылка, ТекущиеДанные.НомерСтроки));

	КонецЦикла;

	Если мДанныхЗаказа.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет строк для формирования перемещений");
		Возврат;
	КонецЕсли;

	СформироватьПеремещенияНаСервере(мДанныхЗаказа);

	Элементы.дсУправлениеЗаказамиНаПеремещение.Обновить();
	
	Элементы.грСозданныеДокументы.Заголовок = СтрШаблон("Созданные документы (%1)", СозданныеДокументы.Количество());
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование перемещений завершено");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПеремещенияНаСервере(мДанныхЗаказа)

	ТаблицаОтбора = Новый ТаблицаЗначений;
	ТаблицаОтбора.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПеремещение"));
	ТаблицаОтбора.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));

	Для Каждого ДанныеЗаказа Из мДанныхЗаказа Цикл

		Если Не ЗначениеЗаполнено(ДанныеЗаказа.Заказ) Или Не ЗначениеЗаполнено(ДанныеЗаказа.НомерСтроки) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаОтбора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаказа);

	КонецЦикла;

	Если ТаблицаОтбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Отбор.Заказ КАК Заказ,
	                      |	Отбор.НомерСтроки КАК НомерСтроки
	                      |ПОМЕСТИТЬ ВТОтбор
	                      |ИЗ
	                      |	&ТаблицаОтбора КАК Отбор
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	докЗаказы.Ссылка КАК Заказ,
	                      |	ДокЗаказыТовары.НомерСтроки КАК НомерСтроки,
	                      |	ДокЗаказыТовары.КодСтроки КАК КодСтроки,
	                      |	докЗаказы.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	                      |	докЗаказы.Организация КАК Организация,
	                      |	докЗаказы.ОрганизацияПолучатель КАК ОрганизацияПолучатель,
	                      |	докЗаказы.СкладОтправитель КАК СкладОтправитель,
	                      |	докЗаказы.СкладПолучатель КАК СкладПолучатель,
	                      |	докЗаказы.Подразделение КАК Подразделение,
	                      |	докЗаказы.ВариантПриемкиТоваров КАК ВариантПриемкиТоваров
	                      |ИЗ
	                      |	ВТОтбор КАК Отбор
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК докЗаказы
	                      |		ПО (докЗаказы.Ссылка = Отбор.Заказ)
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение.Товары КАК ДокЗаказыТовары
	                      |		ПО (ДокЗаказыТовары.Ссылка = Отбор.Заказ)
	                      |			И (ДокЗаказыТовары.НомерСтроки = Отбор.НомерСтроки)
	                      |ГДЕ
	                      |	докЗаказы.Проведен
	                      |	И НЕ ДокЗаказыТовары.Отменено
	                      |	И ДокЗаказыТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Организация,
	                      |	СкладОтправитель,
	                      |	СкладПолучатель,
	                      |	Подразделение,
	                      |	Заказ,
	                      |	НомерСтроки");

	Запрос.УстановитьПараметр("ТаблицаОтбора", ТаблицаОтбора);

	//ВыборкаГрупп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Организация,СкладОтправитель,СкладПолучатель,Подразделение");
    ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаГрупп = ТаблицаДанных.Скопировать( , "Организация,СкладОтправитель,СкладПолучатель,Подразделение");
	ТаблицаГрупп.Свернуть("Организация,СкладОтправитель,СкладПолучатель,Подразделение");
	Для Каждого СтрокаГруппы Из ТаблицаГрупп Цикл

		СтрокиГруппы = ТаблицаДанных.НайтиСтроки(Новый Структура("Организация,СкладОтправитель,СкладПолучатель,Подразделение",
																СтрокаГруппы.Организация,
																СтрокаГруппы.СкладОтправитель,
																СтрокаГруппы.СкладПолучатель,
																СтрокаГруппы.Подразделение));
		Если СтрокиГруппы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ПерваяСтрока = СтрокиГруппы[0];

		МассивЗаказов = Новый Массив;
		РазрешенныеСтроки = Новый Соответствие;

		Для Каждого СтрокаДанных Из СтрокиГруппы Цикл

			Если МассивЗаказов.Найти(СтрокаДанных.Заказ) = Неопределено Тогда
				МассивЗаказов.Добавить(СтрокаДанных.Заказ);
			КонецЕсли;

			РазрешенныеСтроки.Вставить(Строка(СтрокаДанных.Заказ.УникальныйИдентификатор())
										+ "|"
										+ Строка(СтрокаДанных.КодСтроки),
										Истина);

		КонецЦикла;

		РеквизитыШапки = Новый Структура("ХозяйственнаяОперация, Организация, ОрганизацияПолучатель, СкладОтправитель, 
										|СкладПолучатель, Подразделение, ВариантПриемкиТоваров",
										ПерваяСтрока.ХозяйственнаяОперация,
										ПерваяСтрока.Организация,
										ПерваяСтрока.ОрганизацияПолучатель,
										ПерваяСтрока.СкладОтправитель,
										ПерваяСтрока.СкладПолучатель,
										ПерваяСтрока.Подразделение,
										ПерваяСтрока.ВариантПриемкиТоваров
									);

		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("МассивЗаказов", МассивЗаказов);
		СтруктураЗаполнения.Вставить("РеквизитыШапки", РеквизитыШапки);
		СтруктураЗаполнения.Вставить("ФормаОткрыта", Ложь);

		ДокументПеремещения = Документы.ПеремещениеТоваров.СоздатьДокумент();    
		
		ДокументПеремещения.Заполнить(СтруктураЗаполнения);
		
		ДокументПеремещения.Дата = ТекущаяДатаСеанса();

		ДокументПеремещения.Статус = Перечисления.СтатусыПеремещенийТоваров.Отгружено;

		Для ИндексСтроки = ДокументПеремещения.Товары.Количество() - 1 По 0 Цикл
			
			СтрокаТоваров = ДокументПеремещения.Товары[ИндексСтроки];
            Если Не ЗначениеЗаполнено(СтрокаТоваров.ЗаказНаПеремещение) Тогда
				ДокументПеремещения.Товары.Удалить(ИндексСтроки);
				Продолжить;
			КонецЕсли;

			КлючСтроки = Строка(СтрокаТоваров.ЗаказНаПеремещение.УникальныйИдентификатор()) + "|" + Строка(СтрокаТоваров.КодСтроки);

			Если РазрешенныеСтроки.Получить(КлючСтроки) = Неопределено Тогда
				ДокументПеремещения.Товары.Удалить(ИндексСтроки);
			КонецЕсли;

		КонецЦикла;

		Если ДокументПеремещения.Товары.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если МассивЗаказов.Количество() = 1 Тогда
			ДокументПеремещения.ЗаказНаПеремещение = МассивЗаказов[0];
		Иначе
			ДокументПеремещения.ЗаказНаПеремещение = Документы.ЗаказНаПеремещение.ПустаяСсылка();
		КонецЕсли;
		СтрокаСозданногоДокумента = СозданныеДокументы.Добавить();

		Попытка
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаСозданногоДокумента.Проведен = Истина;
		Исключение
			Причина = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СтрокаСозданногоДокумента.Комментарий = Причина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести перемещение товаров по причине: " + Причина, ДокументПеремещения.Ссылка);
		КонецПопытки;

		СтрокаСозданногоДокумента.Документ = ДокументПеремещения.Ссылка;

	КонецЦикла;
