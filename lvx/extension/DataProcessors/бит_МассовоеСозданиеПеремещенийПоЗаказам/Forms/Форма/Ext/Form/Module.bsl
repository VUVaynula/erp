&НаСервере
Процедура РассчитатьИтоги()
    Схема = Элементы.дсУправлениеЗаказамиНаПеремещение.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
    Настройки = Элементы.дсУправлениеЗаказамиНаПеремещение.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Элементы.дсУправлениеЗаказамиНаПеремещениеКоличество.ТекстПодвала = Результат.Итог("Количество");
	Элементы.дсУправлениеЗаказамиНаПеремещениеМасса.ТекстПодвала = Результат.Итог("Масса");
	Элементы.дсУправлениеЗаказамиНаПеремещениеОбъем.ТекстПодвала = Результат.Итог("Объем");
	Элементы.дсУправлениеЗаказамиНаПеремещениеПроизведено.ТекстПодвала = Результат.Итог("Произведено");
	Элементы.дсУправлениеЗаказамиНаПеремещениеЕдИзмМассы.ТекстПодвала = "кг";
	Элементы.дсУправлениеЗаказамиНаПеремещениеЕдИзмОбъема.ТекстПодвала = "м3";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокКолонкиПроизведено()
	
	Если ЗначениеЗаполнено(СкладОтправитель) И ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(СкладОтправитель, "ЦеховаяКладовая") Тогда
		Элементы.дсУправлениеЗаказамиНаПеремещениеПроизведено.Заголовок = "Сколько произведено(готово к отгрузке)";
	Иначе
		Элементы.дсУправлениеЗаказамиНаПеремещениеПроизведено.Заголовок = "Остаток на складе";
	КонецЕсли;
	
