Функция ПолучитьНастройкуПоУмолчанию(Знач ИмяНастройки, Знач ТолькоПервое = Ложь)
	
	Возврат Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию[ИмяНастройки], , ТолькоПервое);

КонецФункции

Функция БазисРаскрой_ВыгрузитьЗаказ(ДокПакет) Экспорт
	
	Разделитель = Символы.Таб;
	СвойствоТолщина 	= ПолучитьНастройкуПоУмолчанию("РеквизитХарактеристикиТолщинаМатериала");
	СвойствоВысота		= ПолучитьНастройкуПоУмолчанию("РеквизитХарактеристикиВысота");
	СвойствоШирина		= ПолучитьНастройкуПоУмолчанию("РеквизитХарактеристикиШирина");
	СвойствоОриентация	= ПолучитьНастройкуПоУмолчанию("РеквизитХарактеристикиОриентацияСтруктуры");
	
	мСвойствХарактеристик = Новый Массив;
	мСвойствХарактеристик.Добавить(СвойствоТолщина);
	мСвойствХарактеристик.Добавить(СвойствоВысота);
	мСвойствХарактеристик.Добавить(СвойствоШирина);
	мСвойствХарактеристик.Добавить(СвойствоОриентация);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокПакет", ДокПакет);
	Запрос.УстановитьПараметр("мСвойствХарактеристик", мСвойствХарактеристик);
	Запрос.УстановитьПараметр("СвойствоТолщина" , СвойствоТолщина);
	Запрос.УстановитьПараметр("СвойствоВысота"  , СвойствоВысота);
	Запрос.УстановитьПараметр("СвойствоШирина"  , СвойствоШирина);
	Запрос.УстановитьПараметр("СвойствоОриентация", СвойствоОриентация);

	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ПакетЭтаповНаРаскройМатериалыРаскроя.Номенклатура КАК Номенклатура,
	               |	бит_ПакетЭтаповНаРаскройМатериалыРаскроя.Характеристика КАК Характеристика,
	               |	бит_ПакетЭтаповНаРаскройМатериалыРаскроя.Количество КАК Количество,
	               |	бит_ПакетЭтаповНаРаскройМатериалыРаскроя.Упаковка КАК Упаковка
	               |ПОМЕСТИТЬ База
	               |ИЗ
	               |	Документ.бит_ПакетЭтаповНаРаскрой.МатериалыРаскроя КАК бит_ПакетЭтаповНаРаскройМатериалыРаскроя
	               |ГДЕ
	               |	бит_ПакетЭтаповНаРаскройМатериалыРаскроя.Ссылка = &ДокПакет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка КАК Характеристика,
	               |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство КАК Свойство,
	               |	МАКСИМУМ(ХарактеристикиНоменклатурыДополнительныеРеквизиты.Значение) КАК Значение
	               |ПОМЕСТИТЬ втСвойстваХарактеристики
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизиты
	               |ГДЕ
	               |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка В
	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |				База.Характеристика
	               |			ИЗ
	               |				База КАК База)
	               |	И ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство В(&мСвойствХарактеристик)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Ссылка,
	               |	ХарактеристикиНоменклатурыДополнительныеРеквизиты.Свойство
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Характеристика,
	               |	Свойство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втСвойстваХарактеристикиТолщина.Значение КАК Толщина,
	               |	втСвойстваХарактеристикиВысота.Значение КАК Высота,
	               |	втСвойстваХарактеристикиШирина.Значение КАК Ширина,
	               |	ВЫБОР
	               |		КОГДА втСвойстваХарактеристикиОриентация.Значение ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ НЕ ВЫРАЗИТЬ(втСвойстваХарактеристикиОриентация.Значение КАК БУЛЕВО)
	               |	КОНЕЦ КАК Текстура,
	               |	База.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	База КАК База
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСвойстваХарактеристики КАК втСвойстваХарактеристикиТолщина
	               |		ПО База.Характеристика = втСвойстваХарактеристикиТолщина.Характеристика
	               |			И (втСвойстваХарактеристикиТолщина.Свойство = &СвойствоТолщина)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСвойстваХарактеристики КАК втСвойстваХарактеристикиВысота
	               |		ПО (База.Характеристика = втСвойстваХарактеристикиТолщина.Характеристика)
	               |			И (втСвойстваХарактеристикиТолщина.Свойство = &СвойствоВысота)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСвойстваХарактеристики КАК втСвойстваХарактеристикиШирина
	               |		ПО База.Характеристика = втСвойстваХарактеристикиШирина.Характеристика
	               |			И (втСвойстваХарактеристикиТолщина.Свойство = &СвойствоШирина)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСвойстваХарактеристики КАК втСвойстваХарактеристикиОриентация
	               |		ПО База.Характеристика = втСвойстваХарактеристикиОриентация.Характеристика
