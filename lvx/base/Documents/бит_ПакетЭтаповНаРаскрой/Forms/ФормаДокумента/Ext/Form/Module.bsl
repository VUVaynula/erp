&НаСервере
Процедура ЗаполнитьТЧЗаготовки() Экспорт 
	
	Объект.Заготовки.Очистить();	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЧЗаказыНаПроизводство", Объект.ПроизводственныеЭтапы.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧЗаказыНаПроизводство.ЗаказНаПроизводство КАК ДокЗаказНаПроизводство
	|ПОМЕСТИТЬ ВТ_ТЧЗаказыНаПроизводство
	|ИЗ
	|	&ТЧЗаказыНаПроизводство КАК ТЧЗаказыНаПроизводство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокЗаказНаПроизводство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаПроизводствоТЧПродукция.Номенклатура КАК Номенклатура,
	|	ЗаказНаПроизводствоТЧПродукция.Характеристика КАК ВариантИсполнения,
	//ПС__ 24.09.2024 Положий Виталий Вадимович
	|	ЗаказНаПроизводствоТЧПродукция.НоменклатураГП КАК НоменклатураГП,
	|	ЗаказНаПроизводствоТЧПродукция.ВариантИсполненияГП КАК ВариантИсполненияГП,
	//__ПС 24.09.2024 Положий Виталий Вадимович
	|	СУММА(ЗаказНаПроизводствоТЧПродукция.Кол) КАК Кол,
	|	ЗаказНаПроизводствоТЧПродукция.ВариантИсполнения.Раскрой_Материал.НоменклатурнаяГруппа.СвойстваМатериалаРаскроя.ВидРаскроя КАК ВидРаскроя
	|ИЗ
	|	ВТ_ТЧЗаказыНаПроизводство КАК ВТ_ТЧЗаказыНаПроизводство
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство.ТЧПродукция КАК ЗаказНаПроизводствоТЧПродукция
	|		ПО ВТ_ТЧЗаказыНаПроизводство.ДокЗаказНаПроизводство = ЗаказНаПроизводствоТЧПродукция.Ссылка
	|ГДЕ
	|	ЗаказНаПроизводствоТЧПродукция.Ссылка.ТехнологическаяОперация.ЭтоРезка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаПроизводствоТЧПродукция.Номенклатура,
	|	ЗаказНаПроизводствоТЧПродукция.ВариантИсполнения,
	//ПС__ 24.09.2024 Положий Виталий Вадимович
	|	ЗаказНаПроизводствоТЧПродукция.НоменклатураГП,
	|	ЗаказНаПроизводствоТЧПродукция.ВариантИсполненияГП,
	//__ПС 24.09.2024 Положий Виталий Вадимович
	|	ЗаказНаПроизводствоТЧПродукция.ВариантИсполнения.Раскрой_Материал.НоменклатурнаяГруппа.СвойстваМатериалаРаскроя.ВидРаскроя";
	
	Объект.Заготовки.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры // КПДеревоСоставляющиеПередатьВРаскрой()

&НаСервере
Процедура ЗаполнитьДеревоЗаготовок(ВхДерево)
		
	ВхДерево.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЧЗаготовки", Объект.Заготовки.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧЗаготовки.Номенклатура КАК Номенклатура,
	|	ТЧЗаготовки.Характеристика КАК Характеристика,
	//ПС__ 24.09.2024 Положий Виталий Вадимович
	|	ТЧЗаготовки.НоменклатураГП КАК НоменклатураГП,
	|	ТЧЗаготовки.ХарактеристикаГП КАК ХарактеристикаГП,
	//__ПС 24.09.2024 Положий Виталий Вадимович
	|	ТЧЗаготовки.Количество КАК Количество,
	//|	ТЧЗаготовки.ВидРаскроя КАК ВидРаскроя,
	//Vardanyan 08.11.2024 >>
	|	ТЧЗаготовки.БукваРаскроя КАК БукваРаскроя
	//Vardanyan 08.11.2024 <<
	|ПОМЕСТИТЬ ВТ_ТЧЗаготовки
	|ИЗ
	|	&ТЧЗаготовки КАК ТЧЗаготовки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧЗаготовки.Номенклатура КАК Номенклатура,
	|	ВТ_ТЧЗаготовки.Характеристика КАК Характеристика,
	|	ВТ_ТЧЗаготовки.НоменклатураГП КАК НоменклатураГП,
	|	ВТ_ТЧЗаготовки.ХарактеристикаГП КАК ХарактеристикаГП,
	//|	ВТ_ТЧЗаготовки.ВидРаскроя КАК ВидРаскроя,  // Спросить
	//|	ЕСТЬNULL(СпрВариантыИсполнения.Раскрой_Материал, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Раскрой_Материал,
	|	ЕСТЬNULL(ХарактеристикиНоменклатурыДополнительныеРеквизитыВысота.Значение, 0) КАК Высота,
	|	ЕСТЬNULL(ХарактеристикиНоменклатурыДополнительныеРеквизитыШирина.Значение, 0) КАК Ширина,
	//|	ЕСТЬNULL(СпрВариантыИсполнения.Метраж, 0) * ВТ_ТЧЗаготовки.Количество КАК Метраж, // Спросить
	|0 КАК Метраж,
	|	ВТ_ТЧЗаготовки.Количество КАК Количество,
	|	ВТ_ТЧЗаготовки.БукваРаскроя КАК БукваРаскроя
	|ИЗ
	|	ВТ_ТЧЗаготовки КАК ВТ_ТЧЗаготовки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизитыВысота
	|		ПО ВТ_ТЧЗаготовки.Характеристика = ХарактеристикиНоменклатурыДополнительныеРеквизитыВысота.Ссылка
	|		И ХарактеристикиНоменклатурыДополнительныеРеквизитыВысота.Свойство = &РеквизитХарактеристикиВысота
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ХарактеристикиНоменклатурыДополнительныеРеквизитыШирина
	|		ПО ВТ_ТЧЗаготовки.Характеристика = ХарактеристикиНоменклатурыДополнительныеРеквизитыШирина.Ссылка
	|		И ХарактеристикиНоменклатурыДополнительныеРеквизитыШирина.Свойство = &РеквизитХарактеристикиШирина
	|ИТОГИ
	|	МАКСИМУМ(НоменклатураГП),
	//|	МАКСИМУМ(ВидРаскроя)
	|ПО
	|	ХарактеристикаГП,
	//|	Раскрой_Материал
	|";
	
	Результат = Запрос.Выполнить();
	ВыборкаНоменклатураГП  = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ТаблНоменклатураГП = Объект.Заготовки.Выгрузить(,"НоменклатураГП,ХарактеристикаГП,БукваРаскроя");
	ТаблНоменклатураГП.Свернуть("НоменклатураГП,ХарактеристикаГП,БукваРаскроя");
	ТаблНоменклатураГП.Колонки.Добавить("Поз");
	Для Каждого СтрокаТаблНоменклатураГП Из ТаблНоменклатураГП Цикл
		Если глПустоеЗначение(СтрокаТаблНоменклатураГП.БукваРаскроя) Тогда
			СтрокаТаблНоменклатураГП.Поз = ПС_ПолучитьПозСтрока(ТаблНоменклатураГП.Индекс(СтрокаТаблНоменклатураГП)+1);
			СтрокаТаблНоменклатураГП.БукваРаскроя = СтрокаТаблНоменклатураГП.Поз;
			_Отбор = Новый Структура;
			_Отбор.Вставить("НоменклатураГП", СтрокаТаблНоменклатураГП.НоменклатураГП);
			_Отбор.Вставить("ХарактеристикаГП",СтрокаТаблНоменклатураГП.ХарактеристикаГП);
			ТЧ_Загатовки = Объект.Заготовки.НайтиСтроки(_Отбор);
			
			Для каждого Эл_Масс из ТЧ_Загатовки Цикл
				Эл_Масс.БукваРаскроя = СтрокаТаблНоменклатураГП.БукваРаскроя;	
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(ТЧЗаготовки, ТЧ_Загатовки);
		Иначе
			СтрокаТаблНоменклатураГП.Поз = СтрокаТаблНоменклатураГП._Буква_Раскроя;
		КонецЕсли;
	КонецЦикла;
	
	Пока ВыборкаНоменклатураГП.Следующий() Цикл
		
		строка_ДеревоЗаготовокГП = ВхДерево.Строки.Добавить();
		строка_ДеревоЗаготовокГП.Номенклатура		= ВыборкаНоменклатураГП.НоменклатураГП;
		строка_ДеревоЗаготовокГП.Характеристика	= ВыборкаНоменклатураГП.ХарактеристикаГП;
		
		СтрокаТаблНоменклатураГП =  ТаблНоменклатураГП.Найти(ВыборкаНоменклатураГП.ХарактеристикаГП, "ХарактеристикаГП");
		Если Не СтрокаТаблНоменклатураГП = Неопределено Тогда
			строка_ДеревоЗаготовокГП.БукваРаскроя =  СтрокаТаблНоменклатураГП.Поз;
		КонецЕсли;
		
		ВыборкаМатериалРаскроя = ВыборкаНоменклатураГП.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		Пока ВыборкаМатериалРаскроя.Следующий() Цикл
			
			строка_ДеревоЗаготовок = строка_ДеревоЗаготовокГП.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(строка_ДеревоЗаготовок, ВыборкаМатериалРаскроя);
			строка_ДеревоЗаготовок.Номенклатура = ВыборкаМатериалРаскроя.Раскрой_Материал;
			
			ВыборкаЗаготовки = ВыборкаМатериалРаскроя.Выбрать();
			
			Пока ВыборкаЗаготовки.Следующий() Цикл
				
				строка_ДеревоЗаготовок_Заготовка = строка_ДеревоЗаготовок.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(строка_ДеревоЗаготовок_Заготовка, ВыборкаЗаготовки);	
				строка_ДеревоЗаготовок_Заготовка._Буква_Раскроя = "";

			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры // КПДеревоСоставляющиеПередатьВРаскрой()

Функция глПустоеЗначение(ВхЗначение) Экспорт

	// Сначала примитивные типы
	Если ВхЗначение = NULL 
		Тогда
		
		Возврат Истина;
		
	КонецЕсли;	

	ТипЗначения = ТипЗнч(ВхЗначение);

	Если ТипЗначения = Тип("Неопределено") Тогда
		
		Возврат ВхЗначение = Неопределено;
		
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		
		Возврат ПустаяСтрока(ВхЗначение);
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		
		Возврат ВхЗначение = 0;
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		
		Возврат Ложь; // Булево будем считать не пустым
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		
		Возврат ВхЗначение = '00010101'
			ИЛИ ВхЗначение = '00010101000000'; 
		
	ИначеЕсли ТипЗначения = Тип("СписокЗначений")
		ИЛИ ТипЗначения = Тип("Массив")
		ИЛИ ТипЗначения = Тип("ТаблицаЗначений")
		ИЛИ ТипЗначения = Тип("Структура")
		Тогда
		
		Возврат ВхЗначение.Количество() = 0;
		
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("РежимПроведенияДокумента") Тогда
	
		Возврат НЕ ВхЗначение = РежимПроведенияДокумента.Неоперативный
				И НЕ ВхЗначение = РежимПроведенияДокумента.Оперативный;
		
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("СтрокаДереваЗначений")
			ИЛИ ТипЗначения = Тип("СтрокаТаблицыЗначений")
			Тогда
			
			Возврат Ложь;
			
	//Отдельное определение, так как конструкторов данного типа не существует	
	ИначеЕсли ТипЗначения = Тип("МоментВремени")
			Тогда
			
			
			Возврат глПустоеЗначение(ВхЗначение.Дата) И глПустоеЗначение(ВхЗначение.Ссылка);
			
	// Для остальных будем считать значение пустым, если оно равно
	// дефолтному значению своего типа
	Иначе
		
		Попытка
			
			Возврат ВхЗначение = Новый(ТипЗначения);
			
		Исключение
			
			Возврат Ложь;
			
		КонецПопытки;
		
	КонецЕсли; 

КонецФункции // глПустоеЗначение()

Функция ПС_ПолучитьПозСтрока(ВхНомер) Экспорт
	
	//ПС__ 27.09.2024 Положий Виталий Вадимович
	Если ВхНомер = 0 Тогда
		Возврат ""
	КонецЕсли;
	
	//Алфавит2 = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЬЫЪЭЮЯ";
	Алфавит2 = "АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЩЭЮЯ";
    КолСимволов = СтрДлина(Алфавит2);
	
	РезСтрока = "";
	
	_Число = ВхНомер;
	
	Пока Истина Цикл

		_Кратность = Цел(_Число/КолСимволов);
		ОстатокОтДеления = _Число%КолСимволов;
		
		Если Не _Кратность = 0 И ОстатокОтДеления = 0 Тогда
			РезСтрока = "" + Сред(Алфавит2,КолСимволов, 1) + РезСтрока;
			Если _Кратность = 1 Тогда
				Возврат РезСтрока;
			Иначе
				_Кратность = _Кратность - 1;	
			КонецЕсли;
		ИначеЕсли _Кратность = 0 И Не ОстатокОтДеления = 0 Тогда
			РезСтрока = "" + Сред(Алфавит2, _Число, 1) + РезСтрока;
			Возврат РезСтрока;
		Иначе
			РезСтрока = "" + Сред(Алфавит2, ОстатокОтДеления, 1) + РезСтрока;
		КонецЕсли;
				
		_Число = _Кратность;
		
	КонецЦикла;
	
	Возврат РезСтрока;
	//__ПС 27.09.2024 Положий Виталий Вадимович
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТЧМатериалы() Экспорт 
	
	//Оставим материалы НЕ являющиеся материалами раскроя
	н = 0;
	Пока н < Объект.МатериалыРаскроя.Количество() Цикл
	   СтрТЧМатериалы = Объект.МатериалыРаскроя.Получить(н);
	   
	   Если СтрТЧМатериалы.Номенклатура.НоменклатурнаяГруппа.ИспользоватьВРаскрое Тогда
		   
		   Объект.МатериалыРаскроя.Удалить(н);
		   
	   Иначе
		   
		   н = н + 1;  
	   
	   КонецЕсли; 
	
	КонецЦикла; 
	
	Если ТЧРезультатРаскроя.Количество() = 0 Тогда
		
		Объект.МатериалыРаскроя.Очистить();
		
		стру_ОтборОстатков = Новый Соответствие;
		стру_ОтборОстатков.Вставить("ДокЗаказ", 				ТЧЗаказыНаПроизводство.ВыгрузитьКолонку("ДокЗаказНаПроизводство"));
		стру_ОтборОстатков.Вставить("ТехнологическаяОперация", 	ТехнологическаяОперация);
		стру_ОтборОстатков.Вставить("КолПотребность > 0");
		
		табл_ПотребностиВСырье = глПолучитьОстатки_ПотребностиВСырье(	глПолучитьМоментВремениОстатков(ЭтотОбъект), 
																		Ссылка, 
																		стру_ОтборОстатков);
		
	ИначеЕсли Есть.Раскрой() Тогда 
		
		табл_ПотребностиВСырье = ТЧРезультатРаскроя.Выгрузить();
		табл_ПотребностиВСырье.Колонки.Добавить("КолПотребность");
		табл_ПотребностиВСырье.ЗаполнитьЗначения(1, "КолПотребность");
		табл_ПотребностиВСырье.Свернуть("НоменклатураМатериалаРаскроя, ХарактеристикаМатериалаРаскроя, КодКарты, КолПотребность");
		
		табл_ПотребностиВСырье.Колонки.НоменклатураМатериалаРаскроя.Имя 		= "Номенклатура";
		табл_ПотребностиВСырье.Колонки.ВариантИсполненияМатериалаРаскроя.Имя 	= "Характеристика";
		
		
		_Параметр_ДлинаРаскроя = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиВысота, , Истина);
		_Параметр_ШиринаРаскроя = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиШирина, , Истина);
		Для Каждого Строка_ПотребностиВСырье Из табл_ПотребностиВСырье Цикл
			
			_СвойстваМатериалаРаскроя = Строка_ПотребностиВСырье.Номенклатура.НоменклатурнаяГруппа.СвойстваМатериалаРаскроя;
			Если НЕ _СвойстваМатериалаРаскроя.УчитыватьМатериалыПоРазмерам Тогда
				Раскрой_Длина 		= глПолучитьЗначениеПараметраВИ(Строка_ПотребностиВСырье.Характеристика, _Параметр_ДлинаРаскроя);
				Раскрой_Ширина 		= глПолучитьЗначениеПараметраВИ(Строка_ПотребностиВСырье.Характеристика, _Параметр_ШиринаРаскроя);
				_МетражРаскроя = глВычислитьМетражРаскрояПоРазмерам(Раскрой_Длина, Раскрой_Ширина, _СвойстваМатериалаРаскроя.ВидРаскроя);
				
				Строка_ПотребностиВСырье.КолПотребность = Строка_ПотребностиВСырье.КолПотребность * _МетражРаскроя;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого строка_ПотребностиВСырье Из табл_ПотребностиВСырье Цикл
		
		строка_ТЧМатериалы = Объект.МатериалыРаскроя.Добавить();
		строка_ТЧМатериалы.Номенклатура 	= строка_ПотребностиВСырье.Номенклатура;
		строка_ТЧМатериалы.Характеристика 	= строка_ПотребностиВСырье.ВариантИсполнения;
		строка_ТЧМатериалы.Количество 		= строка_ПотребностиВСырье.КолПотребность;
		
	КонецЦикла;
	
	Объект.МатериалыРаскроя.Свернуть("Номенклатура, Характеристика", "Количество");

КонецПроцедуры // КПДеревоСоставляющиеПередатьВРаскрой()

&НаСервереБезКонтекста
Функция глПолучитьЗначениеПараметраВИ(Характеристика, Свойство)
	
	Запрос = новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
