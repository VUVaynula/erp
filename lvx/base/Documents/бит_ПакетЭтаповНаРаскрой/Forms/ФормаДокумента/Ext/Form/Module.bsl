#Область ШапкаДокумента

&НаКлиенте
асинх Процедура АдресВыгрузкиФайлаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    
    ДиалогВыбораФайла.Каталог = Объект.АдресВыгрузкиФайла;
    ДиалогВыбораФайла.Заголовок = "Выберите каталог";
    Результат = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	Если Результат <> Неопределено Тогда                 
		Объект.АдресВыгрузкиФайла = Результат[0];
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПоследнееЗначениеАдресВыгрузкиФайла()
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ПакетЭтаповНаРаскрой.Дата КАК Дата,
	                      |	бит_ПакетЭтаповНаРаскрой.АдресВыгрузкиФайла КАК АдресВыгрузкиФайла
	                      |ИЗ
	                      |	Документ.бит_ПакетЭтаповНаРаскрой КАК бит_ПакетЭтаповНаРаскрой
	                      |ГДЕ
	                      |	(ВЫРАЗИТЬ(бит_ПакетЭтаповНаРаскрой.АдресВыгрузкиФайла КАК СТРОКА(10))) <> """"
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Объект.АдресВыгрузкиФайла = Выборка.АдресВыгрузкиФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовШапки()
	
	ДоступностьШапки = Объект.ПроизводственныеЭтапы.Количество() = 0 Или ПользователиКлиент.ЭтоПолноправныйПользователь();
	
	Элементы.Организация.Доступность 	= ДоступностьШапки;
	Элементы.Подразделение.Доступность 	= ДоступностьШапки;
	Элементы.ВРЦ.Доступность 			= ДоступностьШапки;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаПроизводственныеЭтапы

&НаКлиенте
Процедура РассчитатьДокумент(Команда)
	
	ЗаполнитьЗаготовкиИМатериалы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводственныеЭтапыЭтапПроизводстваПриИзменении(Элемент)
	
	ПриИзмененииЭтапа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЭтапа(ТД = Неопределено)
	
	Если ТД = Неопределено Тогда
		ТД = Элементы.ПроизводственныеЭтапы.ТекущиеДанные;
	КонецЕсли;
	
	Если ТД <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТД.ЭтапПроизводства) Тогда
			СтруктураЗаполнения = ПроизводственныеЭтапыСобратьДанныеПоЭтапуНаСервере(ТД.ЭтапПроизводства); 
			ЗаполнитьЗначенияСвойств(ТД, СтруктураЗаполнения);
		Иначе
			ОчиститьДанныеСтроки(ТД);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанныеСтроки(ТД)
	
	ТД.ЗаказНаПроизводство 				= ПредопределенноеЗначение("Документ.ЗаказНаПроизводство2_2.ПустаяСсылка");
	ТД.ЭтапПроизводства 				= ПредопределенноеЗначение("Документ.ЭтапПроизводства2_2.ПустаяСсылка");
	ТД.НоменклатураВыходногоИзделия 	= ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	ТД.ХарактеристикаВыходногоИзделия 	= ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроизводственныеЭтапыСобратьДанныеПоЭтапуНаСервере(Знач ЭтапПроизводства)
	
	Структура = Новый Структура;
	Структура.Вставить("ЗаказНаПроизводство"			, ЭтапПроизводства.Распоряжение);
	Структура.Вставить("ЭтапПроизводства"				, ЭтапПроизводства);
	Структура.Вставить("НоменклатураВыходногоИзделия"	, ЭтапПроизводства.Спецификация.ОсновноеИзделиеНоменклатура);
	Структура.Вставить("ХарактеристикаВыходногоИзделия"	, ЭтапПроизводства.Спецификация.ОсновноеИзделиеХарактеристика);
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура ПроизводственныеЭтапыУдалить(Команда)
	
	ТекущаяСтрока = Элементы.ПроизводственныеЭтапы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
    СтрокаКоллекции = Объект.ПроизводственныеЭтапы.НайтиПоИдентификатору(ТекущаяСтрока.ПолучитьИдентификатор());
	Если СтрокаКоллекции <> Неопределено Тогда
		Объект.ПроизводственныеЭтапы.Удалить(СтрокаКоллекции);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводственныеЭтапыДобавить(Команда)
	
	ПФ = Новый Структура;
	ПФ.Вставить("РежимВыбора", Истина);
	ПФ.Вставить("МножественныйВыбор", Ложь);
	ПФ.Вставить("ЗакрыватьПриВыборе", Истина);
	
	Если ЗначениеЗаполнено(Объект.ВРЦ) Тогда
		// если заполнен отбор ВРЦ, то нужен отбор запросом
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;

		ЭлементОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ПравоеЗначение = ПолучитьСписокЭтаповДляОтбора(Объект.Организация, Объект.Подразделение, Объект.ВРЦ);
		
		ПФ.Вставить("ФиксированныеНастройки", НастройкиКомпоновки);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Организация) и ЗначениеЗаполнено(Объект.Подразделение) Тогда
		// если отбор по двум критериям, то надо объединить их
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
		
		ГруппаОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
    	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
		ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Организация");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ПравоеЗначение = Объект.Организация;

		ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Подразделение");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ПравоеЗначение = Объект.Подразделение;
		
		ПФ.Вставить("ФиксированныеНастройки", НастройкиКомпоновки);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Организация) Тогда
		// обычный отбор по реквизиту
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Организация", Объект.Организация);
 		
		ПФ.Вставить("Отбор", ПараметрыОтбора);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Подразделение) Тогда
		// обычный отбор по реквизиту
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Подразделение", Объект.Подразделение);
 		
		ПФ.Вставить("Отбор", ПараметрыОтбора); 
	КонецЕсли;
	
	ОповещениеОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораЭтапов", ЭтотОбъект);
	ОткрытьФорму("Документ.ЭтапПроизводства2_2.Форма.ФормаВыбора", ПФ, ЭтаФорма, УникальныйИдентификатор, , , ОповещениеОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПолучитьСписокЭтаповДляОтбора(Знач Организация, Знач Подразделение, Знач ВРЦ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭтапПроизводства2_2.Ссылка КАК ЭтапПроизводства
	               |ПОМЕСТИТЬ втЭтапПроизводства
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	               |ГДЕ
	               |	ЭтапПроизводства2_2.Проведен
	               |	И ВЫБОР
	               |			КОГДА &ЕстьОтборПодразделение
	               |				ТОГДА ЭтапПроизводства2_2.Подразделение = &Подразделение
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ЕстьОтборОрганизация
	               |				ТОГДА ЭтапПроизводства2_2.Организация = &Организация
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);  
	Запрос.УстановитьПараметр("ЕстьОтборОрганизация", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ЕстьОтборПодразделение", ЗначениеЗаполнено(Подразделение));

	Если ЗначениеЗаполнено(ВРЦ) Тогда
		Запрос.Текст = Запрос.Текст + "
				   |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЭтапПроизводства2_2ВидыРабочихЦентров.Ссылка КАК ЭтапПроизводства
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВидыРабочихЦентров КАК ЭтапПроизводства2_2ВидыРабочихЦентров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЭтапПроизводства КАК втЭтапПроизводства
	               |		ПО ЭтапПроизводства2_2ВидыРабочихЦентров.Ссылка = втЭтапПроизводства.ЭтапПроизводства
	               |			И (ЭтапПроизводства2_2ВидыРабочихЦентров.Использовать)
	               |ГДЕ
	               |	ЭтапПроизводства2_2ВидыРабочихЦентров.ВидРабочегоЦентра = &ВидРабочегоЦентра
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЭтапПроизводства2_2АльтернативныеВидыРабочихЦентров.Ссылка
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.АльтернативныеВидыРабочихЦентров КАК ЭтапПроизводства2_2АльтернативныеВидыРабочихЦентров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЭтапПроизводства КАК втЭтапПроизводства
	               |		ПО ЭтапПроизводства2_2АльтернативныеВидыРабочихЦентров.Ссылка = втЭтапПроизводства.ЭтапПроизводства
	               |			И (ЭтапПроизводства2_2АльтернативныеВидыРабочихЦентров.Использовать)
	               |ГДЕ
	               |	ЭтапПроизводства2_2АльтернативныеВидыРабочихЦентров.ВидРабочегоЦентра = &ВидРабочегоЦентра
	               |";
		Запрос.УстановитьПараметр("ВидРабочегоЦентра", ВРЦ);
	Иначе
		Запрос.Текст = Запрос.Текст + "
				   |ВЫБРАТЬ
	               |	втЭтапПроизводства.ЭтапПроизводства КАК ЭтапПроизводства
	               |ИЗ
	               |	втЭтапПроизводства КАК втЭтапПроизводства";	
	КонецЕсли;
	Результат = Запрос.Выполнить().Выгрузить();
	Список = новый СписокЗначений;
	Если Результат.Количество() Тогда
		Список.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("ЭтапПроизводства"));
	КонецЕсли;

	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораЭтапов(Результат, ДопПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		Если Объект.ПроизводственныеЭтапы.НайтиСтроки(Новый Структура("ЭтапПроизводства", Результат)).Количество() = 0 Тогда
			новаяСтрока = Объект.ПроизводственныеЭтапы.Добавить();
			новаяСтрока.ЭтапПроизводства = Результат;
			ПриИзмененииЭтапа(новаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводственныеЭтапыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТД = Элементы.ПроизводственныеЭтапы.ТекущиеДанные;
	ИмяПоля = СтрЗаменить(Поле.Имя, "ПроизводственныеЭтапы", "");
	ОткрытьЗначение(ТД[ИмяПоля]);
		
КонецПроцедуры

