#Область СозданиеПакетов
 
&НаСервере
Функция ПодготовитьДанныеПакетовНаСервере()

	ПакетыПоКлючу = Новый Соответствие;

	Для Каждого РеквизитФормы Из ПолучитьРеквизиты() Цикл

		Если Не СтрНачинаетсяС(РеквизитФормы.Имя, "АвтоВРЦ_Дерево_АвтоВРЦ_СтраницаВРЦ") Тогда
			Продолжить;
		КонецЕсли;

		Дерево = ЭтаФорма[РеквизитФормы.Имя];

		СобратьВыбранныеЭтапыВДереве(Дерево.Строки, ПакетыПоКлючу);

	КонецЦикла;

	Результат = Новый Массив;

	Для Каждого ЭлементПакета Из ПакетыПоКлючу Цикл
		Результат.Добавить(ЭлементПакета.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура СобратьВыбранныеЭтапыВДереве(СтрокиДерева, ПакетыПоКлючу)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл

		Если СтрокаДерева.ТипСтроки = "Этап"
			И СтрокаДерева.Выбор Тогда

			ДобавитьЭтапВПакет(СтрокаДерева, ПакетыПоКлючу);

		КонецЕсли;

		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СобратьВыбранныеЭтапыВДереве(СтрокаДерева.Строки, ПакетыПоКлючу);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭтапВПакет(СтрокаДерева, ПакетыПоКлючу)

	Ключ = ПолучитьКлючПакета(СтрокаДерева.Организация, СтрокаДерева.Подразделение, СтрокаДерева.ВидРабочегоЦентра);

	Если Не ПакетыПоКлючу.Получить(Ключ) = Неопределено Тогда
		Пакет = ПакетыПоКлючу.Получить(Ключ);
	Иначе
		Пакет = Новый Структура;

		Пакет.Вставить("Организация", СтрокаДерева.Организация);
		Пакет.Вставить("Подразделение", СтрокаДерева.Подразделение);
		Пакет.Вставить("ВидРабочегоЦентра", СтрокаДерева.ВидРабочегоЦентра);
		Пакет.Вставить("Этапы", Новый Массив);

		ПакетыПоКлючу.Вставить(Ключ, Пакет);
	КонецЕсли;

	ДанныеЭтапа = Новый Структура;

	ДанныеЭтапа.Вставить("ЭтапПроизводства", СтрокаДерева.Этап);
	ДанныеЭтапа.Вставить("Дата", СтрокаДерева.Дата);
	ДанныеЭтапа.Вставить("ЗаказКлиента", СтрокаДерева.ЗаказКлиента);
	ДанныеЭтапа.Вставить("ЗаказНаПроизводство", СтрокаДерева.ЗаказНаПроизводство);
	ДанныеЭтапа.Вставить("Статус", СтрокаДерева.Статус);
	ДанныеЭтапа.Вставить("ВидРабот", СтрокаДерева.ВидРабот);
	ДанныеЭтапа.Вставить("КоличествоИзделий", СтрокаДерева.КоличествоИзделий);

	Пакет.Этапы.Добавить(ДанныеЭтапа);

КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПолучитьКлючПакета(Организация, Подразделение, ВидРабочегоЦентра)

	Возврат Строка(Организация) 
		+ "|" + Строка(Подразделение)
		+ "|" + Строка(ВидРабочегоЦентра);

КонецФункции

#КонецОбласти


