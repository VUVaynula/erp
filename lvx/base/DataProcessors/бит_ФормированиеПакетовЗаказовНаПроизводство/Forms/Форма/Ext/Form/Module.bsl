	//--------------------------------------------------------------
	Для Каждого СтрокаДерева Из Строки Цикл
		Если СтрокаДерева.ТипСтроки <> "Этап" Тогда
			Продолжить;
		КонецЕсли;
			
		Если ДополнятьЭтапамиВыбранногоЗаказа Тогда
			Если СтрокаДерева.ЗаказНаПроизводство = ЗаказНаПроизводство И Не ЗначениеЗаполнено(СтрокаДерева.ПакетРаскроя) Тогда
            	СтрокаДерева.Пометка = ЗначениеПометки;
				СтрокаДерева.ПометкаКартинка = ?(ЗначениеПометки, БиблиотекаКартинок.ФлагУстановлен, БиблиотекаКартинок.ФлагНеУстановлен);
				
				УстановитьПометкуПоЗаказуНаПроизводство(СтрокаДерева.ПолучитьЭлементы(), 
														ЗаказНаПроизводство, 
														ЗначениеПометки, 
														ДополнятьЭтапамиВыбранногоЗаказа
														//, 
														//НоменклатураОИ, 
														//ХарактеристикаОИ,
														//ВходитВСегмент,
														//мСегментыНоменклатурыДляОтбораВРезку
														);
				
			КонецЕсли;
		//Иначе  
		//	Если ВходитВСегмент Тогда
		//		НоменклатурыПоЗаказуНаПроизводство();		
		//	КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыКолонокДерева(ДобавляемыеРеквизиты, ИмяДерева)
	
	ТипСтрока250 = Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(250));
	ТипБулево = Новый ОписаниеТипов("Булево");
	СоответствиеТипов = Новый Структура;
	СоответствиеТипов.Вставить("ТипСтроки"			, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(20)));
	СоответствиеТипов.Вставить("ПредставлениеЗначения"	, ТипСтрока250);
	СоответствиеТипов.Вставить("ДатаЭтапа"			, Новый ОписаниеТипов("Дата"));
	СоответствиеТипов.Вставить("Документ"			, ТипСтрока250);
	СоответствиеТипов.Вставить("Этап"				, Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2"));
	СоответствиеТипов.Вставить("СостояниеЭтапа"		, Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыЭтаповПроизводства2_2"));
	СоответствиеТипов.Вставить("ВидРабот"			, Новый ОписаниеТипов("СправочникСсылка.ВидыРаботСотрудников"));
	СоответствиеТипов.Вставить("Обеспечено"			, ТипБулево);
	СоответствиеТипов.Вставить("Пометка"			, ТипБулево);
	СоответствиеТипов.Вставить("ПометкаКартинка"	, Новый ОписаниеТипов("Картинка"));
	СоответствиеТипов.Вставить("ЗаказНаПроизводство", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство2_2"));
	СоответствиеТипов.Вставить("ВидРабочегоЦентра"	, Новый ОписаниеТипов("СправочникСсылка.ВидыРабочихЦентров"));
	СоответствиеТипов.Вставить("Состав"				, ТипСтрока250);
	СоответствиеТипов.Вставить("ОбеспеченоКартинка" , Новый ОписаниеТипов("Картинка"));
	СоответствиеТипов.Вставить("КоличествоИзделий"  , Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,3))); 
	СоответствиеТипов.Вставить("ПакетРаскроя"  		, Новый ОписаниеТипов("ДокументСсылка.бит_ПакетЭтаповНаРаскрой"));
    СоответствиеТипов.Вставить("НоменклатураОИ"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СоответствиеТипов.Вставить("ХарактеристикаОИ"	, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));  
	СоответствиеТипов.Вставить("Назначение"			, Новый ОписаниеТипов("СправочникСсылка.Назначения"));

	Для каждого стр из СоответствиеТипов Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(стр.Ключ, стр.Значение, ИмяДерева));		
	КонецЦикла;                      
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтраницыДанными(ТаблицаРезультата)

	Для Каждого Страница Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
		
		Если Не СтрНачинаетсяС(Страница.Имя, "АвтоВРЦ_СтраницаВРЦ") Тогда
			Продолжить;
		КонецЕсли;

		ИмяДерева = "АвтоВРЦ_Дерево_" + Страница.Имя;
		Дерево = ЭтаФорма[ИмяДерева];

		ВРЦ = Неопределено;

		Если ВыводитьВРазрезеВРЦ Тогда
			ВРЦ = ПолучитьВРЦПоИмениСтраницы(Страница.Имя);
		КонецЕсли;

		ЗаполнитьДеревоЭтаповСтраницы(Дерево, ТаблицаРезультата, ВРЦ);
		ПересчитатьИтогиСтраницыНаСервере("АвтоВРЦ_Таблица_" + Страница.Имя);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьВРЦПоИмениСтраницы(ИмяСтраницы)

	Если Не СтрНачинаетсяС(ИмяСтраницы, "АвтоВРЦ_СтраницаВРЦ_") Тогда
		Возврат Неопределено;
	КонецЕсли;

	UIDСтрокой = СтрЗаменить(ИмяСтраницы, "АвтоВРЦ_СтраницаВРЦ_", "");

	Если UIDСтрокой = "000000" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ЭлементСписка Из ВРЦОтбор Цикл
		
		Если Не ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Продолжить;
		КонецЕсли;

		Если Строка(ЭлементСписка.Значение.УникальныйИдентификатор()) = UIDСтрокой Тогда
			Возврат ЭлементСписка.Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ДобавитьКолонкуДерева(Таблица, ИмяДерева, ИмяКолонки, Заголовок, ТолькоПросмотр, Видимость = Истина)

	Колонка = Элементы.Добавить(Таблица.Имя + "_" + ИмяКолонки, Тип("ПолеФормы"), Таблица);

	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = ИмяДерева + "." + ИмяКолонки;
	Колонка.Заголовок = Заголовок;
	Колонка.ТолькоПросмотр = ТолькоПросмотр;
    Колонка.Видимость = Видимость;
	
	Возврат Колонка;

КонецФункции

&НаСервере
Процедура ДобавитьПолеИтога(Родитель, ИмяРеквизита, Заголовок)

	Поле = Элементы.Добавить("АвтоВРЦ_Поле_" + ИмяРеквизита, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ИмяРеквизита;
	Поле.Заголовок = Заголовок;
	Поле.ТолькоПросмотр = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЭтаповСтраницы(Дерево, ТаблицаРезультата, ВРЦ)

	Таблица = ТаблицаРезультата.Скопировать();
    Таблица.Сортировать("ВидРабочегоЦентра, ДатаЭтапа, ЗаказНаПроизводство, ПакетРаскроя, Этап");

	Если ВыводитьВРазрезеВРЦ И ЗначениеЗаполнено(ВРЦ) Тогда
		мСтрок = Таблица.НайтиСтроки(Новый Структура("ВидРабочегоЦентра", ВРЦ));
		ЗаполнитьДеревоЭтаповСтраницыФрагмент(Дерево, мСтрок);
	Иначе
		ЗаполнитьДеревоЭтаповСтраницыФрагмент(Дерево, Таблица);	
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЭтаповСтраницыФрагмент(Дерево, КоллекцияСтрок)
	
	Для Каждого СтрокаДанных Из КоллекцияСтрок Цикл
		
		УзелДата = НайтиИлиСоздатьУзелДаты(Дерево, СтрокаДанных.ДатаЭтапа);
		Если ЗначениеЗаполнено(СтрокаДанных.ПакетРаскроя) Тогда
			УзелДокумент = НайтиИлиСоздатьУзелДокумента(УзелДата, СтрокаДанных.ПакетРаскроя, "Пакет");
			
			УзелЭтап = УзелДокумент.ПолучитьЭлементы().Добавить();
			ЗаполнитьСтрокуЭтапа(УзелЭтап, СтрокаДанных);
		Иначе
			УзелЭтап = УзелДата.ПолучитьЭлементы().Добавить();
			ЗаполнитьСтрокуЭтапа(УзелЭтап, СтрокаДанных);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Функция НайтиИлиСоздатьУзелДаты(Дерево, ДатаЭтапа)

	ДатаДня = НачалоДня(ДатаЭтапа);  
	СтрокиДерева = Дерево.ПолучитьЭлементы();

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ТипСтроки = "Дата" И СтрокаДерева.ДатаЭтапа = ДатаДня Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
	КонецЦикла;

	СтрокаДерева = Дерево.ПолучитьЭлементы().Добавить();
	СтрокаДерева.ТипСтроки = "Дата";
	СтрокаДерева.ДатаЭтапа = ДатаДня;
	СтрокаДерева.Документ = ДатаДня;  
	СтрокаДерева.ПредставлениеЗначения = Формат(ДатаДня, "ДФ=dd.MM.yyyy");

	Возврат СтрокаДерева;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиИлиСоздатьУзелДокумента(УзелРодитель, Документ, ТипСтроки)
	
	СтрокиДерева = УзелРодитель.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ТипСтроки = ТипСтроки И СтрокаДерева.Документ = Документ Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
	КонецЦикла;

	СтрокаДерева = УзелРодитель.ПолучитьЭлементы().Добавить();
	СтрокаДерева.ТипСтроки = ТипСтроки;
	СтрокаДерева.Документ = Документ;
    СтрокаДерева.ПредставлениеЗначения = Строка(Документ);
	
	Возврат СтрокаДерева;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьСтрокуЭтапа(СтрокаДерева, СтрокаДанных)

	СтрокаДерева.ТипСтроки = "Этап";  
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаДанных);                            
	
	ПредставлениеКоличества = Формат(СтрокаДанных.Количество, "ЧДЦ=3; ЧРД=,; ЧГ=0");

	Если СтрНайти(ПредставлениеКоличества, ",") > 0 Тогда

		Пока Прав(ПредставлениеКоличества, 1) = "0" Цикл
			ПредставлениеКоличества = Лев(ПредставлениеКоличества, СтрДлина(ПредставлениеКоличества) - 1);
		КонецЦикла;

		Если Прав(ПредставлениеКоличества, 1) = "," Тогда
			ПредставлениеКоличества = Лев(ПредставлениеКоличества, СтрДлина(ПредставлениеКоличества) - 1);
		КонецЕсли;

	КонецЕсли;                   
	
	СтрокаДерева.Состав = ПредставлениеКоличества + " поз: " + СтрокаДерева.Состав;
	
	СтрокаДерева.ПакетРаскроя = СтрокаДанных.ПакетРаскроя;
	
	СтрокаДерева.НоменклатураОИ = СтрокаДанных.НоменклатураОИ;
	СтрокаДерева.ХарактеристикаОИ = СтрокаДанных.ХарактеристикаОИ;
	СтрокаДерева.Назначение = 
	СтрокаДерева.КоличествоИзделий = СтрокаДанных.Количество;
	СтрокаДерева.Документ = СтрокаДанных.Этап; 
	
	СтрокаДерева.ПредставлениеЗначения = Строка(СтрокаДанных.Этап);
	
	Если СтрокаДерева.Обеспечено Тогда
        СтрокаДерева.ОбеспеченоКартинка = БиблиотекаКартинок.ПустаяКартинка;
	Иначе
		СтрокаДерева.ОбеспеченоКартинка = БиблиотекаКартинок.КрасныйШар;
    КонецЕсли;

    Если СтрокаДерева.Пометка Тогда
        СтрокаДерева.ПометкаКартинка = БиблиотекаКартинок.ФлагУстановлен;
	Иначе
		СтрокаДерева.ПометкаКартинка = БиблиотекаКартинок.ФлагНеУстановлен;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогиСтраницыНаСервере(ИмяТаблицы)

	ИмяСтраницы = СтрЗаменить(ИмяТаблицы, "АвтоВРЦ_Таблица_", "");

	ИмяДерева = "АвтоВРЦ_Дерево_" + ИмяСтраницы;

	ИмяВыбраноЭтапов = "АвтоВРЦ_ВыбраноЭтапов_" + ИмяСтраницы;
	ИмяВыбраноИзделий = "АвтоВРЦ_ВыбраноИзделий_" + ИмяСтраницы;
	ИмяТребуетсяЛистов = "АвтоВРЦ_ТребуетсяЛистов_" + ИмяСтраницы;

	ВыбраноЭтапов = 0;
	ВыбраноИзделий = 0;
	ТребуетсяЛистов = 0;

	Дерево = ЭтаФорма[ИмяДерева];

	ПересчитатьИтогиПоСтрокамДерева(Дерево.ПолучитьЭлементы(), ВыбраноЭтапов, ВыбраноИзделий, ТребуетсяЛистов);

	ЭтаФорма[ИмяВыбраноЭтапов] = ВыбраноЭтапов;
	ЭтаФорма[ИмяВыбраноИзделий] = ВыбраноИзделий;
	ЭтаФорма[ИмяТребуетсяЛистов] = ТребуетсяЛистов;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьИтогиПоСтрокамДерева(Строки, ВыбраноЭтапов, ВыбраноИзделий, ТребуетсяЛистов)
	
	СтандартныйРазмерМатериалаВысота = Справочники.бит_ЗначенияПоУмолчанию.СтандартныйРазмерМатериалаВысота;
	СтандартныйРазмерМатериалаШирина = Справочники.бит_ЗначенияПоУмолчанию.СтандартныйРазмерМатериалаШирина;
	
	РазмерМатериалаВысота = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(СтандартныйРазмерМатериалаВысота, , Истина);
	РазмерМатериалаШирина = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(СтандартныйРазмерМатериалаШирина, , Истина);
	Если ЗначениеЗаполнено(РазмерМатериалаВысота) и ЗначениеЗаполнено(РазмерМатериалаШирина) Тогда
		ПлощадьЛиста = РазмерМатериалаВысота * РазмерМатериалаШирина;
	Иначе
		ПлощадьЛиста = 0;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из Строки Цикл

		Если СтрокаДерева.ТипСтроки = "Этап" И СтрокаДерева.Пометка Тогда

			ВыбраноЭтапов = ВыбраноЭтапов + 1;
			ВыбраноИзделий = ВыбраноИзделий + СтрокаДерева.КоличествоИзделий;
			
			Если ПлощадьЛиста > 0 Тогда
				Потребность = РассчитатьПотребность(СтрокаДерева.Этап);
			    ТребуетсяЛистов = ТребуетсяЛистов + Потребность / ПлощадьЛиста;
			КонецЕсли;

		КонецЕсли;

		ПересчитатьИтогиПоСтрокамДерева(СтрокаДерева.ПолучитьЭлементы(), ВыбраноЭтапов, ВыбраноИзделий, ТребуетсяЛистов);

	КонецЦикла;

КонецПроцедуры                                  

&НаСервереБезКонтекста
Функция РассчитатьПотребность(Этап)

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	СУММА(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Количество) КАК ПотребностьВМатериале
	                      |ИЗ
	                      |	Справочник.бит_ЗначенияПоУмолчанию.Значения КАК бит_ЗначенияПоУмолчаниюЗначения
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
	                      |		ПО бит_ЗначенияПоУмолчаниюЗначения.Значение = ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура.ВидНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПоУмолчаниюЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыМатериаловРаскроя)
	                      |	И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка = &Этап");
	Запрос.УстановитьПараметр("Этап", Этап);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПотребностьВМатериале;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

