#КонецОбласти

#Область ИнициализацияСКД	 

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек()
	
	СписокСвойств = ПолучитьСписокСвойствДляОтбора(); 
	ПолучитьТаблицуДинамическихПолей(СписокСвойств);
	
	СхемаКомпоновкиДанных = Обработки.бит_ФормированиеПакетовЗаказовНаПроизводство.ПолучитьМакет("МакетОтбор");
	
	ТекстЗапроса = ПостроитьДинамическийЗапросСКД(СхемаКомпоновкиДанных, СписокСвойств);
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("НаборДанных1");
	НаборДанных.Запрос = ТекстЗапроса;
	
	ДополнитьСхемуПолямиСвойств(СхемаКомпоновкиДанных, СписокСвойств);
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	КомпоновщикНастроекОтбор.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроекОтбор.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	НастроитьВидимостьПараметровСКД(СхемаКомпоновкиДанных);
	
	КомпоновщикНастроекОтбор.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	ДобавитьДинамическиеПоляВОтборыСКД();
	
КонецПроцедуры 

&НаСервере
Процедура НастроитьВидимостьПараметровСКД(СхемаКомпоновкиДанных)

    Для Каждого Параметр Из СхемаКомпоновкиДанных.Параметры Цикл
		Параметр.ВключатьВДоступныеПоля = Ложь;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти 

#Область ДинамическаяСхемаСКД

&НаСервереБезКонтекста
Функция ПолучитьСписокСвойствДляОтбора()
	
	Возврат Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.РеквизитыХарактеристикДляОтборов);

КонецФункции

&НаСервере
Процедура ПолучитьТаблицуДинамическихПолей(СписокСвойств)

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Свойство");
    Таблица.Колонки.Добавить("ТипЗначения");
    Таблица.Колонки.Добавить("ЭтоДополнительноеЗначение", Новый ОписаниеТипов("Булево"));

    Номер = 0;
    Для Каждого Свойство Из СписокСвойств Цикл
        Номер = Номер + 1;

        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.ИмяПоля = "ЗначениеДопСвойства" + Формат(Номер, "ЧГ=0");
        СтрокаТаблицы.Свойство = Свойство;
        СтрокаТаблицы.ТипЗначения = Свойство.ТипЗначения;
        СтрокаТаблицы.ЭтоДополнительноеЗначение = Свойство.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов"));
    КонецЦикла;
	
	АдресТаблицыДинамическихПолей = ПоместитьВоВременноеХранилище(Таблица, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПостроитьДинамическийЗапросСКД(СхемаКомпоновкиДанных, СписокСвойств) 

	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("НаборДанных1");
	Если НаборДанных = Неопределено Тогда
		ВызватьИсключение "Не найден набор данных НаборДанных1";
	КонецЕсли;

	ТекстЗапроса = НаборДанных.Запрос;

	ТекстПолейБаза = "";
	ТекстСоединенийБаза = "";
	ТекстПолейИтог = "";
	ТекстПолейГде = "";

	Номер = 0;
	Для Каждого Свойство Из СписокСвойств Цикл

		Номер = Номер + 1;

		ИмяСоединения = "ДопСвойствоВыходногоИзделия" + Формат(Номер, "ЧГ=0");
		ИмяПоля = "ЗначениеДопСвойства" + Формат(Номер, "ЧГ=0");
		ИмяПараметра = "СвойствоДопОтбора" + Формат(Номер, "ЧГ=0");

		ТекстПолейБаза = ТекстПолейБаза + "," + Символы.ПС + "	" + ИмяСоединения + ".Значение КАК " + ИмяПоля;

		ТекстСоединенийБаза = ТекстСоединенийБаза + Символы.ПС
			+ "		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК " + ИмяСоединения + Символы.ПС
			+ "		ПО " + ИмяСоединения + ".Ссылка = ЭтапПроизводства2_2ВыходныеИзделия.Характеристика" + Символы.ПС
			+ "			И " + ИмяСоединения + ".Свойство = &" + ИмяПараметра;

		ТекстПолейИтог = ТекстПолейИтог + "," + Символы.ПС + "	База." + ИмяПоля + " КАК " + ИмяПоля;

		ТекстПолейГде = ТекстПолейГде + "," + Символы.ПС + "	База." + ИмяПоля;
		
		//-------------------------------
		// добавим параметры вручную
		ПараметрСКД = СхемаКомпоновкиДанных.Параметры.Добавить();
		ПараметрСКД.Имя = ИмяПараметра;
		ПараметрСКД.ВключатьВДоступныеПоля = Ложь;
		ПараметрСКД.ОграничениеИспользования = Истина;
	КонецЦикла;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "	//{ДОПОЛНИТЕЛЬНЫЕ_ПОЛЯ_БАЗА}", ТекстПолейБаза);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "	//{ДОПОЛНИТЕЛЬНЫЕ_СОЕДИНЕНИЯ_БАЗА}", ТекстСоединенийБаза);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "	//{ДОПОЛНИТЕЛЬНЫЕ_ПОЛЯ_ИТОГ}", ТекстПолейИтог);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "	//{ДОПОЛНИТЕЛЬНЫЕ_ПОЛЯ_ГДЕ}", ТекстПолейГде);

	Возврат ТекстЗапроса;

КонецФункции

&НаСервере
Процедура ДополнитьСхемуПолямиСвойств(СхемаКомпоновкиДанных, СписокСвойств) Экспорт

    НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("НаборДанных1");

    Если НаборДанных = Неопределено Тогда
        ВызватьИсключение "Не найден набор данных НаборДанных1";
    КонецЕсли;

    ТаблицаПолей = ПолучитьИзВременногоХранилища(АдресТаблицыДинамическихПолей);
    Для Каждого ОписаниеПоля Из ТаблицаПолей Цикл

        ИмяПоля = ОписаниеПоля.ИмяПоля;
        Если НаборДанных.Поля.Найти(ИмяПоля) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
        ПолеНабора.Поле = ИмяПоля;
        ПолеНабора.ПутьКДанным = ИмяПоля;
        ПолеНабора.Заголовок = ПолучитьЗаголовокПоляСвойства(ОписаниеПоля.Свойство);
        ПолеНабора.ТипЗначения = ОписаниеПоля.ТипЗначения;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьДинамическиеПоляВОтборыСКД()

    ТаблицаПолей = ПолучитьИзВременногоХранилища(АдресТаблицыДинамическихПолей);
    Для Каждого ОписаниеПоля Из ТаблицаПолей Цикл
        ДобавитьПолеВОтборСКД(ОписаниеПоля.ИмяПоля, СтрЗаменить(ОписаниеПоля.Свойство, " (Для характеристик)",  ""));
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеВОтборСКД(ИмяПоля, ПредставлениеПоля)

    Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого ЭлементОтбора Из КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы Цикл
        Если ЭлементОтбора.ЛевоеЗначение = Поле Тогда
            Возврат;
        КонецЕсли;
    КонецЦикла;

    ЭлементОтбора = КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.Использование = Ложь;
    ЭлементОтбора.ЛевоеЗначение = Поле;
    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗаголовокПоляСвойства(Свойство)

    Возврат "Характеристика - " + СтрЗаменить(Строка(Свойство), " (Для характеристик)", "");

КонецФункции
	
&НаСервере
Функция ЗаполнитьПараметрыСвойствСКД(СписокСвойств)
	
	Номер = 0;
    Для Каждого Свойство Из СписокСвойств Цикл

        Номер = Номер + 1;
        ИмяПараметра = "СвойствоДопОтбора" + Формат(Номер, "ЧГ=0");
        КомпоновщикНастроекОтбор.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ИмяПараметра, Свойство);

	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область ПередачаОтборовФормыВСКД

&НаСервере
Процедура ПередатьОтборыФормыВСКДНаСервере()
	
	УстановитьПериодСКД();
	
	ОтразитьСписокЗначенийВОтборахКомпоновки(КомпоновщикНастроекОтбор, "Подразделение", ПодразделениеОтбор);
	ОтразитьСписокЗначенийВОтборахКомпоновки(КомпоновщикНастроекОтбор, "Статус", СтатусОтбор);
	ОтразитьСписокЗначенийВОтборахКомпоновки(КомпоновщикНастроекОтбор, "ВидРабочегоЦентра", ВРЦОтбор);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПериодСКД()
	
	КомпоновщикНастроекОтбор.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ПериодОтбор);
	ОтобразитьПериодВЗаголовке();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтразитьСписокЗначенийВОтборахКомпоновки(КомпоновщикНастроек, ИмяПоля, СписокЗначений)
	
	сЗначений = Новый СписокЗначений;
	Для Каждого СтрокаСписка Из СписокЗначений Цикл
		Если ЗначениеЗаполнено(СтрокаСписка.Значение) Тогда
			сЗначений.Добавить(СтрокаСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ПолеПоиска = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Отбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если Отбор.ЛевоеЗначение 	= ПолеПоиска Тогда
			Отбор.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
			Отбор.Использование 	= сЗначений.Количество() > 0;
			Отбор.ПравоеЗначение 	= сЗначений;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтразитьПростойОтборВОтборахКомпоновки(КомпоновщикНастроекОтбор, ИмяПоля, Значение)
	
	ЗначениеПоиска = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Отбор Из КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы Цикл
		Если Отбор.ЛевоеЗначение = ЗначениеПоиска Тогда
			Настройка = КомпоновщикНастроекОтбор.ПользовательскиеНастройки.Элементы.Найти(Отбор.ИдентификаторПользовательскойНастройки);
			Если Настройка <> Неопределено Тогда
				Настройка.Использование = ЗначениеЗаполнено(Значение);
				Если Настройка.Использование Тогда
					Настройка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					Настройка.ПравоеЗначение = Значение;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПолучениеОтборовСКДВФорму

&НаСервере
Процедура ПолучитьОтборыСКДВФормуНаСервере()
	
	ЗаполнитьСписокИзОтбораСКД(ПодразделениеОтбор, КомпоновщикНастроекОтбор, "Подразделение");
	ЗаполнитьСписокИзОтбораСКД(СтатусОтбор, КомпоновщикНастроекОтбор, "Статус");
	ЗаполнитьСписокИзОтбораСКД(ВРЦОтбор, КомпоновщикНастроекОтбор, "ВидРабочегоЦентра");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСписокИзОтбораСКД(СписокЗначений, КомпоновщикНастроек, ИмяПоля)
	
	ПравоеЗначение = ПолучитьЗначениеПростогоОтбораСКД(КомпоновщикНастроек, ИмяПоля);

	СписокЗначений.Очистить();
	
	Если ПравоеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
		Для Каждого ЗначениеОтбора Из ПравоеЗначение Цикл
			НоваяСтрока = СписокЗначений.Добавить();
			НоваяСтрока.Пометка = Истина;
			НоваяСтрока.Значение = ЗначениеОтбора;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда 
		Для Каждого ЗначениеОтбора Из ПравоеЗначение Цикл
			НоваяСтрока = СписокЗначений.Добавить();
			НоваяСтрока.Пометка = Истина;
			НоваяСтрока.Значение = ЗначениеОтбора.Значение;
		КонецЦикла;
		
	Иначе
		
		НоваяСтрока = СписокЗначений.Добавить();
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Значение = ПравоеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеПростогоОтбораСКД(КомпоновщикНастроек, ИмяПоля)
	
	ПолеПоиска = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Отбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если Отбор.ЛевоеЗначение = ПолеПоиска Тогда
			Если Отбор.Использование Тогда
				Возврат Отбор.ПравоеЗначение;
			КонецЕсли;
			
		ИначеЕсли Отбор.ЛевоеЗначение = ИмяПоля Тогда
			Возврат Отбор.Использование;

		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеОтбора

&НаСервере
Процедура ОтобратьНаСервере()
	
	ТаблЭтапы.Очистить();
	
	ПередатьОтборыФормыВСКДНаСервере();
	
	СписокСвойств = ПолучитьСписокСвойствДляОтбора();
	ЗаполнитьПараметрыСвойствСКД(СписокСвойств);
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроекОтбор.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	ТаблицаРезультата = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	

	ТаблицаРезультата = ПолучитьЭтапыСДополнением(ТаблицаРезультата.ВыгрузитьКолонку("Этап"), ДополнятьЭтапамиВыбранногоЗаказа);
	
	УникальныеВРЦ = ТаблицаРезультата.Скопировать(, "ВидРабочегоЦентра");
	УникальныеВРЦ.Свернуть("ВидРабочегоЦентра");
	
	Если ТаблицаРезультата.количество() Тогда
		мСтраниц = УникальныеВРЦ.ВыгрузитьКолонку("ВидРабочегоЦентра");
		ВывестиСтраницы(мСтраниц);
		ЗаполнитьСтраницыДанными(ТаблицаРезультата); 
	Иначе
		УдалитьСтарыеСтраницыИДанные();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для заполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЭтапыСДополнением(МассивЭтапов, ДополнятьЭтапами)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивЭтапов", МассивЭтапов);
	Запрос.УстановитьПараметр("ДополнятьЭтапами", ДополнятьЭтапами);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Этапы.Ссылка КАК Этап,
	               |	Этапы.Распоряжение КАК ЗаказНаПроизводство,
	               |	докВыходныеИзделия.Назначение КАК Назначение
	               |ПОМЕСТИТЬ ИсходныеНазначения
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2 КАК Этапы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК докВыходныеИзделия
	               |		ПО (докВыходныеИзделия.Ссылка = Этапы.Ссылка)
	               |ГДЕ
	               |	Этапы.Ссылка В(&МассивЭтапов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИсходныеНазначения.Этап КАК Этап,
	               |	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК НоменклатураОИ,
	               |	ЗаказНаПроизводство2_2Продукция.Характеристика КАК ХарактеристикаОИ
	               |ПОМЕСТИТЬ втОИпоЭтапу
	               |ИЗ
	               |	ИсходныеНазначения КАК ИсходныеНазначения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	               |			ПО (ЗаказНаПроизводство2_2Продукция.Ссылка = ЗаказНаПроизводство2_2.Ссылка)
	               |		ПО ИсходныеНазначения.ЗаказНаПроизводство = ЗаказНаПроизводство2_2.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИсходныеНазначения.Этап КАК ИсходныйЭтап,
	               |	ИсходныеНазначения.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	               |	ИсходныеНазначения.Назначение КАК ИсходноеНазначение,
	               |	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	               |	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика
	               |ПОМЕСТИТЬ ПродукцияПоИсходнымНазначениям
	               |ИЗ
	               |	ИсходныеНазначения КАК ИсходныеНазначения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	               |		ПО (ЗаказНаПроизводство2_2Продукция.Ссылка = ИсходныеНазначения.ЗаказНаПроизводство)
	               |			И (ЗаказНаПроизводство2_2Продукция.Назначение = ИсходныеНазначения.Назначение)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПродукцияПоИсходнымНазначениям.ИсходныйЭтап КАК ИсходныйЭтап,
	               |	ПродукцияПоИсходнымНазначениям.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	               |	ПродукцияПоИсходнымНазначениям.ИсходноеНазначение КАК ИсходноеНазначение,
	               |	ПродукцияДругихНазначений.Назначение КАК ДругоеНазначение
	               |ПОМЕСТИТЬ ДругиеНазначенияПоПродукции
	               |ИЗ
	               |	ПродукцияПоИсходнымНазначениям КАК ПродукцияПоИсходнымНазначениям
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ПродукцияДругихНазначений
	               |		ПО (ПродукцияДругихНазначений.Ссылка = ПродукцияПоИсходнымНазначениям.ЗаказНаПроизводство)
	               |			И (ПродукцияДругихНазначений.Номенклатура = ПродукцияПоИсходнымНазначениям.Номенклатура)
	               |			И (ПродукцияДругихНазначений.Характеристика = ПродукцияПоИсходнымНазначениям.Характеристика)
	               |			И (ПродукцияДругихНазначений.Назначение <> ПродукцияПоИсходнымНазначениям.ИсходноеНазначение)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИсходныеНазначения.Этап КАК Этап,
	               |	ИсходныеНазначения.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	               |	ИсходныеНазначения.Назначение КАК Назначение
	               |ПОМЕСТИТЬ База
	               |ИЗ
	               |	ИсходныеНазначения КАК ИсходныеНазначения
	               |
				   // не будем выводить другие этапы. это будет при формировании пакета
				   //|ОБЪЕДИНИТЬ
				   //|
				   //|ВЫБРАТЬ РАЗЛИЧНЫЕ
				   //|	ЭтапыРаскроя.Ссылка,
				   //|	ДругиеНазначенияПоПродукции.ЗаказНаПроизводство,
				   //|	ДругиеНазначенияПоПродукции.ДругоеНазначение
				   //|ИЗ
				   //|	ДругиеНазначенияПоПродукции КАК ДругиеНазначенияПоПродукции
				   //|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапыРаскроя
				   //|		ПО (ЭтапыРаскроя.Распоряжение = ДругиеНазначенияПоПродукции.ЗаказНаПроизводство)
				   //|			И (ЭтапыРаскроя.Этап.бит_ЭтоЭтапРаскроя = ИСТИНА)
				   //|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ВыходныеИзделияРаскроя
				   //|		ПО (ВыходныеИзделияРаскроя.Ссылка = ЭтапыРаскроя.Ссылка)
				   //|			И (ВыходныеИзделияРаскроя.Назначение = ДругиеНазначенияПоПродукции.ДругоеНазначение) 
				   //|
				   |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Трудозатраты.Ссылка КАК Этап,
	               |	МАКСИМУМ(Трудозатраты.ВидРабот) КАК ВидРабот
	               |ПОМЕСТИТЬ втВидыРабот
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.Трудозатраты КАК Трудозатраты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ База КАК База
	               |		ПО (База.Этап = Трудозатраты.Ссылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Трудозатраты.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВидыРабочихЦентров.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	               |	База.Этап КАК Этап
	               |ПОМЕСТИТЬ втВРЦ
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.ВидыРабочихЦентров КАК ВидыРабочихЦентров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ База КАК База
	               |		ПО (ВидыРабочихЦентров.Использовать)
	               |			И ВидыРабочихЦентров.Ссылка = База.Этап
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	АльтернативныеВРЦ.ВидРабочегоЦентра,
	               |	База.Этап
	               |ИЗ
	               |	Документ.ЭтапПроизводства2_2.АльтернативныеВидыРабочихЦентров КАК АльтернативныеВРЦ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ База КАК База
	               |		ПО (АльтернативныеВРЦ.Использовать)
	               |			И АльтернативныеВРЦ.Ссылка = База.Этап
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	База.Этап КАК Этап,
	               |	ЕСТЬNULL(ПроизводственныеЭтапы.Ссылка, ЗНАЧЕНИЕ(Документ.бит_ПакетЭтаповНаРаскрой.ПустаяСсылка)) КАК ПакетРаскроя
	               |ПОМЕСТИТЬ втПакетыРаскроя
	               |ИЗ
	               |	База КАК База
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ПакетЭтаповНаРаскрой.ПроизводственныеЭтапы КАК ПроизводственныеЭтапы
	               |		ПО База.Этап = ПроизводственныеЭтапы.ЭтапПроизводства
	               |			И (ПроизводственныеЭтапы.Ссылка.Проведен)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	База.Этап КАК Этап, 
				   |	База.Назначение КАК Назначение, 
	               |	ЭтапПроизводства2_2.Статус КАК СостояниеЭтапа,
	               |	НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2.Дата, ДЕНЬ) КАК ДатаЭтапа,
	               |	ЭтапПроизводства2_2.Распоряжение КАК ЗаказНаПроизводство,
	               |	втВРЦ.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	               |	втВидыРабот.ВидРабот КАК ВидРабот,
	               |	ЛОЖЬ КАК Пометка,
	               |	ЭтапПроизводства2_2.КоличествоУпаковокПлан КАК Количество,
	               |	ЭтапПроизводства2_2.Спецификация.ОсновноеИзделиеНоменклатура.Наименование КАК Состав,
	               |	втПакетыРаскроя.ПакетРаскроя КАК ПакетРаскроя,
	               |	ЕСТЬNULL(СостоянияЭтаповПроизводства.СостояниеОбеспечения, ЗНАЧЕНИЕ(Перечисление.СостоянияОбеспеченияЭтапаПроизводства.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СостоянияОбеспеченияЭтапаПроизводства.ОжидаетсяОбеспечение) КАК Обеспечено,
	               |	втОИпоЭтапу.НоменклатураОИ КАК НоменклатураОИ,
	               |	втОИпоЭтапу.ХарактеристикаОИ КАК ХарактеристикаОИ
	               |ИЗ
	               |	База КАК База
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	               |			ПРАВОЕ СОЕДИНЕНИЕ втОИпоЭтапу КАК втОИпоЭтапу
	               |			ПО втОИпоЭтапу.Этап = ЭтапПроизводства2_2.Ссылка
	               |		ПО (ЭтапПроизводства2_2.Ссылка = База.Этап)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втВРЦ КАК втВРЦ
	               |		ПО (втВРЦ.Этап = База.Этап)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втВидыРабот КАК втВидыРабот
	               |		ПО (втВидыРабот.Этап = База.Этап)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПакетыРаскроя КАК втПакетыРаскроя
	               |		ПО (втПакетыРаскроя.Этап = База.Этап)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЭтаповПроизводства КАК СостоянияЭтаповПроизводства
	               |		ПО База.ЗаказНаПроизводство = СостоянияЭтаповПроизводства.Распоряжение
	               |			И База.Этап = СостоянияЭтаповПроизводства.Этап";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область Интерфейс_СтраницыВРЦ

&НаСервере
Процедура УдалитьСтарыеСтраницыИДанные()

	// 1. Удаляем элементы формы, созданные программно
	Для Каждого Элемент Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
	
	// 2. Удаляем реквизиты формы, созданные программно
	УдаляемыеРеквизиты = Новый Массив;
    мРеквизиты = ПолучитьРеквизиты();
	Для Каждого Реквизит Из мРеквизиты Цикл
		Если СтрНачинаетсяС(Реквизит.Имя, "АвтоВРЦ_") Тогда
			УдаляемыеРеквизиты.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСтраницы(мСтраниц = Неопределено)
	// Добавляем страницы по выбранным ВРЦ 
	Если мСтраниц = Неопределено Тогда
		мСтраниц = ВРЦОтбор.ВыгрузитьЗначения();
	КонецЕсли;
		
	Если ВыводитьВРазрезеВРЦ Тогда
		Для каждого текВРЦ из мСтраниц Цикл 
			Если ЗначениеЗаполнено(текВРЦ) Тогда 
				ИмяСтраницы = "АвтоВРЦ_СтраницаВРЦ_" + Строка(текВРЦ.УникальныйИдентификатор());
				ЗаголовокСтраницы = Строка(текВРЦ);
			Иначе                                                                    
				ИмяСтраницы = "АвтоВРЦ_СтраницаВРЦ_000000";
				ЗаголовокСтраницы = "<ВРЦ не задан>";
			КонецЕсли;
			ВывестиСтраницуВРЦ(ИмяСтраницы, ЗаголовокСтраницы);
		КонецЦикла;    
	Иначе                                                
		ИмяСтраницы = "АвтоВРЦ_СтраницаВРЦ";    
		ЗаголовокСтраницы = "";
		ВывестиСтраницуВРЦ(ИмяСтраницы, ЗаголовокСтраницы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтраницуВРЦ(ИмяСтраницы, ЗаголовокСтраницы)
	
	ИмяДерева = "АвтоВРЦ_Дерево_" + ИмяСтраницы;

	ИмяВыбраноЭтапов = "АвтоВРЦ_ВыбраноЭтапов_" + ИмяСтраницы;
	ИмяВыбраноИзделий = "АвтоВРЦ_ВыбраноИзделий_" + ИмяСтраницы;
	ИмяТребуетсяЛистов = "АвтоВРЦ_ТребуетсяЛистов_" + ИмяСтраницы;

	// 1. Создаем реквизиты формы
	ДобавляемыеРеквизиты = Новый Массив;   
	КЧ15_3 = Новый КвалификаторыЧисла(15, 3);
	КЧ15_0 = Новый КвалификаторыЧисла(15, 0);
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяДерева, Новый ОписаниеТипов("ДеревоЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяВыбраноЭтапов, Новый ОписаниеТипов("Число", КЧ15_0)));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяВыбраноИзделий, Новый ОписаниеТипов("Число", КЧ15_3)));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяТребуетсяЛистов, Новый ОписаниеТипов("Число", КЧ15_3)));

	ДобавитьРеквизитыКолонокДерева(ДобавляемыеРеквизиты, ИмяДерева); 
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	// 2. Создаем страницу
	Страница = Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), Элементы.Страницы);
	Страница.Вид = ВидГруппыФормы.Страница;
	Страница.Заголовок = ЗаголовокСтраницы;

	// 3. Создаем таблицу дерева
	Таблица = Элементы.Добавить("АвтоВРЦ_Таблица_" + ИмяСтраницы, Тип("ТаблицаФормы"), Страница);

	Таблица.ПутьКДанным = ИмяДерева;
	Таблица.Отображение = ОтображениеТаблицы.Дерево;
	Таблица.ТолькоПросмотр = Ложь;
    Таблица.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
    Таблица.УстановитьДействие("ПередНачаломДобавления", "ДеревоЭтапыПередНачаломДобавления");
	Таблица.УстановитьДействие("ПередУдалением", "ДеревоЭтапыПередУдалением");
	Таблица.ИзменятьПорядокСтрок = Ложь;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Таблица.РазрешитьНачалоПеретаскивания = Ложь;
	Таблица.РазрешитьПеретаскивание = Ложь;
	Таблица.УстановитьДействие("Выбор", "ТаблицаВыбор");
	
	// 4. Колонки дерева
	//ДобавитьКолонкуДерева(Таблица, ИмяДерева, "Документ", "Этап / пакет", Истина);  
	ДобавитьКолонкуДерева(Таблица, ИмяДерева, "ПредставлениеЗначения", "Дата исполнения / Пакет / Этап", Истина);
	ДобавитьКолонкуДерева(Таблица, ИмяДерева, "ВидРабот", "Вид работ", Истина);
	ДобавитьКолонкуДерева(Таблица, ИмяДерева, "Состав", "Состав", Истина);
	ДобавитьКолонкуДерева(Таблица, ИмяДерева, "СостояниеЭтапа", "Состояние", Истина);
	//ДобавитьКолонкуДерева(Таблица, ИмяДерева, "Обеспечено", "Обесп", Истина, Ложь);                
	
	//ДобавитьКолонкуДерева(Таблица, ИмяДерева, "КоличествоИзделий", "Количество изделий", Истина, Ложь);
	ДобавитьКолонкуДерева(Таблица, ИмяДерева, "ОбеспеченоКартинка", "Обесп", Истина);
	
	КолонкаВыбор = ДобавитьКолонкуДерева(Таблица, ИмяДерева, "ПометкаКартинка", "Пометка", Ложь);
	
	// 5. Группа итогов
	ГруппаИтоги = Элементы.Добавить("АвтоВРЦ_ГруппаИтоги_" + ИмяСтраницы, Тип("ГруппаФормы"), Страница);

	ГруппаИтоги.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаИтоги.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаИтоги.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;

	ДобавитьПолеИтога(ГруппаИтоги, ИмяВыбраноИзделий, "Выбрано изделий");
	ДобавитьПолеИтога(ГруппаИтоги, ИмяВыбраноЭтапов, "Выбрано этапов");
	ДобавитьПолеИтога(ГруппаИтоги, ИмяТребуетсяЛистов, "Для раскроя требуется листов");	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	мИменПоля = СтрРазделить(Поле.Имя, "_");
	ИмяПоля = мИменПоля[мИменПоля.ВГраница()];
	Если ИмяПоля = "ПредставлениеЗначения" и Элемент.ТекущиеДанные.ТипСтроки = "Этап" Тогда
		ОткрытьЗначение(Элемент.ТекущиеДанные.Этап);
	ИначеЕсли ИмяПоля = "ПометкаКартинка" и Элемент.ТекущиеДанные.ТипСтроки = "Этап" Тогда
		ТекущиеДанные.Пометка = Не ТекущиеДанные.Пометка;
	    ТекущиеДанные.ПометкаКартинка = ?(ТекущиеДанные.Пометка, БиблиотекаКартинок.ФлагУстановлен, БиблиотекаКартинок.ФлагНеУстановлен);
		
		ИмяТаблицы = СтрЗаменить(Элемент.Имя, "_Пометка", "");
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ПакетРаскроя) Тогда    
	        ЗаказНаПроизводство = ТекущиеДанные.ЗаказНаПроизводство;
			ДополнитьЭтапамиВыбранногоЗаказаНаСервере(ИмяТаблицы, 
													ЗаказНаПроизводство, 
													ТекущиеДанные.Пометка
													//, 
													//ТекущиеДанные.НоменклатураОИ, 
													//ТекущиеДанные.ХарактеристикаОИ
													);
		КонецЕсли;
	
		ПересчитатьИтогиСтраницыНаСервере(ИмяТаблицы);
	Иначе 
		СтандартнаяОбработка = Истина;		
	КонецЕсли;
	
КонецПроцедуры

