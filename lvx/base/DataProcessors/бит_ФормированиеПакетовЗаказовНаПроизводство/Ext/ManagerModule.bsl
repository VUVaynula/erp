
Функция ПолучитьИдентификатор_БазисРаскрой(ВхДокПакетныйЗаказНаПроизводство) Экспорт 
	
	_Идентификатор = "Базис"
					+ "_" 
					+ глНомер(ВхДокПакетныйЗаказНаПроизводство.Номер) 
					+ "_" 
					+ Формат(ВхДокПакетныйЗаказНаПроизводство.Дата, "ДФ=ddMMyyyy");
					
	Возврат _Идентификатор;
	
КонецФункции

Функция ПолучитьИмяФайлаCutRite(ВхДокПакетныйЗаказНаПроизводство, ВхСуффикс = "") Экспорт 
	
	_ИмяФайлаВыгрузкиCutRite = "CutRite"
								+ "_"
								+ глНомер(ВхДокПакетныйЗаказНаПроизводство.Номер) 
								+ "_" 
								+ Формат(ВхДокПакетныйЗаказНаПроизводство.Дата, "ДФ=ddMMyyyy") 
								+ ?(ВхСуффикс = "", "", "_" + ВхСуффикс);
	Возврат _ИмяФайлаВыгрузкиCutRite;

КонецФункции 

