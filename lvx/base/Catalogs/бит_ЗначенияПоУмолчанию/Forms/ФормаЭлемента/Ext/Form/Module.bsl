
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОписаниеТипов = Неопределено;
	Массив = Новый Массив;
		
	Если Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ГФУНоменклатурыГП Тогда
			
		Массив.Добавить(Тип("СправочникСсылка.ГруппыФинансовогоУчетаНоменклатуры"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ПриоритетЗаказаНаПеремещение Тогда
			
		Массив.Добавить(Тип("СправочникСсылка.Приоритеты"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ПриоритетЗаказаНаПеремещение 
		// {{ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [14.05.2026 16:51:36] +        
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВидЦеныЗакупочная
		// }}ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [14.05.2026 16:51:36] -
		Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.ВидыЦен"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыДляРасчетаПлановыхКалькуляций
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыДляСозданияПодчиненныхХарактеристик
		// {{ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [27.05.2026 20:31:14] +        
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыМатериаловРаскроя 
		// }}ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [27.05.2026 20:31:14] -      
		Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.ВидыНоменклатуры"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.Организация Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.Организации"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ПодразделениеДиспетчер Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.СтруктураПредприятия"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ПериодичностьРасчетаДни Тогда
		
		Массив.Добавить(Тип("Число"));              
		ОписаниеТипов = Новый ОписаниеТипов(Массив, , , Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СтандартныйРазмерМатериалаШирина 
		или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СтандартныйРазмерМатериалаВысота Тогда
		
		Массив.Добавить(Тип("Число"));              
		ОписаниеТипов = Новый ОписаниеТипов(Массив, , , Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиПризнакЗаказногоИзделия
		// {{ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [18.05.2026 20:30:56] +        
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиКатегория
		// }}ПервыйБИТ ЛистТребований [ЛТ2.2]  [VUVaynula@1cbit.ru] [18.05.2026 20:30:56] -
		// {{ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [14.06.2026 13:56:47] +        
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитыХарактеристикДляОтборов
		// }}ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [14.06.2026 13:56:47] -
		Тогда
				
		Массив.Добавить(Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ЗначениеСтандартногоПризнакаИзделия Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.ЗначенияСвойствОбъектов"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СтатьяКалькуляцииСверхнормативныхМатериаловВЗаказеНаПроизводство Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.СтатьиКалькуляции"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.Счет60
		ИЛИ Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.Счет62 
		ИЛИ Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.Счет9001
		ИЛИ Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.Счет9002 Тогда
		
		Массив.Добавить(Тип("ПланСчетовСсылка.бит_Бюджетирование"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СебестоимостьПродаж
		ИЛИ Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВыручкаОтРеализации Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.бит_СтатьиОборотов"));	
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СоответствиеАналитикЦФОКонтрагент
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СоответствиеАналитикСчетаУчета 
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СоответствиеАналитикСтатьиРасходовСтатьиОборотов
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.ВидСоответствияЦФО_Касса Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.бит_ВидыСоответствийАналитик"));
		
	// {{ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [27.05.2026 20:34:06] +        
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.СегментыНоменклатурыДляОтбораВРезку Тогда
		
		Массив.Добавить(Тип("СправочникСсылка.СегментыНоменклатуры"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиВысота
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиТолщинаМатериала
		Или Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиШирина
	Тогда 
		
		Массив.Добавить(Тип("СправочникСсылка.ЗначенияСвойствОбъектов"));
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ЗначенияПоУмолчанию.РеквизитХарактеристикиОриентацияСтруктуры Тогда
		
		Массив.Добавить(Тип("Булево"));
		
	// }}ПервыйБИТ ЛистТребований [ЛТ6.15]  [VUVaynula@1cbit.ru] [27.05.2026 20:34:06] -
	КонецЕсли;
	
	Если ОписаниеТипов = Неопределено Тогда
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
	КонецЕсли;
	
	Элементы.ЗначенияЗначение.ОграничениеТипа = ОписаниеТипов;
	Элементы.ЗначенияЗначение.Доступность = Истина;
	
КонецПроцедуры
