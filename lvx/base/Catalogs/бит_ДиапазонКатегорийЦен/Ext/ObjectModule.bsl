
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ЦенаОт) Тогда
		ЦенаОт = ПолучитьСледующуюЦенуОт();
	КонецЕсли;

КонецПроцедуры 

Функция ПолучитьСледующуюЦенуОт()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Спр.ЦенаДо) КАК МаксЦенаДо
	|ИЗ
	|	Справочник.бит_ДиапазонКатегорийЦен КАК Спр
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления";

	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Следующий() И ЗначениеЗаполнено(Результат.МаксЦенаДо) Тогда
		Возврат Результат.МаксЦенаДо;
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура ПередЗаписью(Отказ)

	Если ЦенаДо < ЦенаОт Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ЦенаДо не может быть меньше ЦенаОт", , , , Отказ);
	ИначеЕсли (ЦенаДо - ЦенаОт) < 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Минимальная разница между порогами значений 1 рубль", , , , Отказ);
	ИначеЕсли ЕстьПересечениеДиапазонов() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Диапазон цен пересекается с уже существующим диапазоном", , , , Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьПересечениеДиапазонов()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
						|	Спр.Ссылка
						|ИЗ
						|	Справочник.бит_ДиапазонКатегорийЦен КАК Спр
						|ГДЕ
						|	НЕ Спр.ПометкаУдаления
						|	И Спр.Ссылка <> &ТекущаяСсылка
						|	И Спр.ЦенаОт < &ЦенаДо
						|	И Спр.ЦенаДо > &ЦенаОт");

	Запрос.УстановитьПараметр("ТекущаяСсылка", Ссылка);
	Запрос.УстановитьПараметр("ЦенаОт", ЦенаОт);
	Запрос.УстановитьПараметр("ЦенаДо", ЦенаДо);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
