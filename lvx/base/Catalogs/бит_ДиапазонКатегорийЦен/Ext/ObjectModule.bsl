КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ЗначениеЗаполнено(СегментНоменклатуры) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	НоменклатураСегмента.Номенклатура КАК Номенклатура
		                      |ИЗ
		                      |	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
		                      |ГДЕ
		                      |	НоменклатураСегмента.Сегмент = &Сегмент");	
		Запрос.УстановитьПараметр("Сегмент", СегментНоменклатуры);
		Если Не Запрос.Выполнить().Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Диапазон привязан к сегменту в котором уже есть номенклатура. Удаление запрещено", , , , Отказ);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
