
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СменноеЗадание = Параметры.СменноеЗадание;
	Подразделение  = Параметры.Подразделение;
	АдресОпераций = Параметры.АдресОпераций;
	
	Если Не ЗначениеЗаполнено(СменноеЗадание) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан обязательный параметр СменноеЗадание");
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Заголовок = "Очередность операций по сменному заданию №" + СменноеЗадание.Номер + " от " + Формат(СменноеЗадание.Дата, "ДФ=dd.MM.yyyy");
	ДанныеПоОперациям = ПолучитьИзВременногоХранилища(АдресОпераций);
	Если ТипЗнч(ДанныеПоОперациям) = Тип("ТаблицаЗначений") Тогда
		Таблица.Загрузить(ДанныеПоОперациям);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
    СохранитьДанныеВРегистр();
	Закрыть(Истина);
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеВРегистр()
	
	НЗ = РегистрыСведений.бит_ОчередностьОперацийВСменномЗадании.СоздатьНаборЗаписей();
	НЗ.Отбор.СменноеЗадание.Установить(СменноеЗадание);
	ТЧ = Таблица.Выгрузить();
	ТЧ.Колонки.Добавить("СменноеЗадание");
	ТЧ.ЗаполнитьЗначения(СменноеЗадание, "СменноеЗадание");
	НЗ.Загрузить(ТЧ);
	НЗ.Записать();
	
КонецПроцедуры   

&НаКлиенте
Процедура ОтменитьИЗакрыть(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда) 
	
	Для каждого стр из Таблица Цикл
		стр.бит_Очередность = 0;
	КонецЦикла;  
	
КонецПроцедуры

&НаКлиенте
Процедура Пронумеровать(Команда) 
	
	сч = 1;
	Для каждого стр из Таблица Цикл
		стр.бит_Очередность = сч;
		сч = сч + 1;
	КонецЦикла;  
	
КонецПроцедуры

