&НаКлиенте
Процедура Выше(Команда)
	
	Идентификатор = Элементы.Таблица.ТекущаяСтрока;
	СтрокаДанных = Таблица.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаДанных <> Неопределено Тогда
    	ИндексВКоллекции = Таблица.Индекс(СтрокаДанных);
		Если ИндексВКоллекции <> 0 Тогда
			Таблица.Сдвинуть(ИндексВКоллекции, -1);
		КонецЕсли;
	КонецЕсли;   
	
