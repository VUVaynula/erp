&НаСервере
Процедура бит_ПересчитатьНормыВремениВыработки()  
	
	//ПервыйБИТ ЛТ 1.6 KAKravchenko@1cbit.ru 06.02.2025 +
	
	Если Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Час Тогда 					
		Объект.бит_НормаВремени = Объект.ВремяШтучное; //Час	
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута Тогда		
		Объект.бит_НормаВремени = Объект.ВремяШтучное / 60; //Минута
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Секунда Тогда	
		Объект.бит_НормаВремени = Объект.ВремяШтучное / 3600; //Секунда
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.День Тогда 		
		Объект.бит_НормаВремени = Объект.ВремяШтучное * 12; //День
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Сутки Тогда 		
		Объект.бит_НормаВремени = Объект.ВремяШтучное * 24; //Сутки 
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Месяц Тогда 		
		Объект.бит_НормаВремени = Объект.ВремяШтучное * 24 * 30; //Месяц
	ИначеЕсли Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Год Тогда		
		Объект.бит_НормаВремени = Объект.ВремяШтучное * 24 * 30.4375 * 12; //Год
	КонецЕсли;
	                                                                   
	Если Объект.бит_НормаВремени = 0 Тогда
		Объект.бит_НормаВыработки = 0;
	Иначе		
		Объект.бит_НормаВыработки = 1 / Объект.бит_НормаВремени;
	КонецЕсли;
	
	//ПервыйБИТ ЛТ 1.6 KAKravchenko@1cbit.ru 06.02.2025 -
	
КонецПроцедуры

