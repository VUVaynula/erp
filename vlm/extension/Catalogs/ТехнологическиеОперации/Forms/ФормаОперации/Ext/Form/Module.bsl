&НаСервере
Процедура бит_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.31]  [VUVaynula@1cbit.ru] [04.12.2025 20:34:04] +        
	//(бит) Норма времени, ч перевести в минуты и транслировать
	НормаВремениВМинутах = ТекущийОбъект.бит_НормаВремени * 60;
	// В поле "Длительность этапа" в вышестоящий этап операции в часах с округлением в большую сторону:              
	ВремяВЧасах = НормаВремениВМинутах/60; 
	// найти РесСпецификация, этап   по этой тех операции
	РесСпецификация = ТекущийОбъект.Спецификация.ПолучитьОбъект();   
	// В виды работ на вкладке "Трудозатраты", связанные с корректируемой операцией в единицах измерения вида работ "Часы":
	Для каждого стр из РесСпецификация.Трудозатраты Цикл
		Если стр.операция = Объект.ссылка 
			Или стр.ОперацияРедактирование = Объект.ссылка Тогда
			
			стр.Количество = ВремяВЧасах;
		КонецЕсли;
	КонецЦикла;                       
	РесСпецификация.Записать();
	
	// найдем этап запросом . первый этап у которого указана спецификация. по договоренности одна спецификация - один этап
	//Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	//                      |	ЭтапПроизводства2_2.Ссылка КАК Ссылка
	//                      |ИЗ
	//                      |	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	//                      |ГДЕ
