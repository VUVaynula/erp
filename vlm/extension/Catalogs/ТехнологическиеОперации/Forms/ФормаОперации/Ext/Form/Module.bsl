&НаСервере
Процедура ПриИзмененииВыработкиВсейМашиныНаСервере()
	// {{ПервыйБИТ ЛистТребований [ЛТ.31]  [VUVaynula@1cbit.ru] [30.11.2025 20:30:18] +        
	//(бит) Норма выработки, тн = (бит) Выработка со всей машины, тн 
	Если Объект.бит_РучнойВводНормыВыработки Тогда
		Если Объект.бит_НормаВыработки = Объект.бит_ВыработкаПроводаСоВсейМашины Тогда
			Объект.бит_РучнойВводНормыВыработки = Ложь;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Объект.бит_НормаВыработки = Объект.бит_ВыработкаПроводаСоВсейМашины;  
	//(бит) Норма времени, ч" = 1/(бит) Выработка со всей машины, тн
	Если Объект.бит_ВыработкаПроводаСоВсейМашины <> 0 Тогда 
    	Объект.бит_НормаВремени = 1 / Объект.бит_ВыработкаПроводаСоВсейМашины;  
	Иначе
		Объект.бит_НормаВремени = 0;
	КонецЕсли;     
	Объект.ВремяШтучное = Объект.бит_НормаВремени * 60;
	Объект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута;
	//Остальное рассчитается при записи
	// }}ПервыйБИТ ЛистТребований [ЛТ.31]  [VUVaynula@1cbit.ru] [30.11.2025 20:30:18] -
КонецПроцедуры

