Функция СгенерироватьСтрокуШК(Знач Серия) Экспорт
	// {{ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [29.11.2025 16:11:00] +        
	Структура = новый Структура;
	Структура.Вставить("vidNomKod", Серия.ВидНоменклатуры.бит_Код);
	ПараметрыУчетаСерий = Справочники.ВидыНоменклатуры.НастройкиИспользованияСерий(Серия.ВидНоменклатуры);
	Если ПараметрыУчетаСерий.ИспользоватьНомерСерии Тогда
		Структура.Вставить("number", Серия.Номер);
	КонецЕсли;
	
	Если ПараметрыУчетаСерий.ИспользоватьДатуПроизводстваСерии Тогда
		Структура.Вставить("dateFrom", Серия.ДатаПроизводства);
	КонецЕсли;
	
	Если ПараметрыУчетаСерий.ИспользоватьСрокГодностиСерии Тогда
		Структура.Вставить("dateTo", Серия.ГоденДо);
	КонецЕсли;
	
	Возврат бит_ОбщегоНазначенияСервер.СериализоватьДанныеВJSON(Структура);
