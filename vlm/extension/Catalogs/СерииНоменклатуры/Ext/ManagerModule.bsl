Функция НайтиСериюПоСтрокеШК(Знач ДанныеШК) Экспорт
	// }}ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [29.11.2025 16:11:00] -
	Результат = бит_ОбщегоНазначенияСервер.СериализоватьДанныеИзJSON(ДанныеШК);
	Список = Новый СписокЗначений;
	
	Если ТипЗнч(Результат) <> Тип("Структура") 
		Или Результат.Свойство("vidNomKod") = Ложь Тогда
		
		Возврат Список;
	КонецЕсли;
	
	Запрос = новый Запрос("ВЫБРАТЬ
	                      |	СерииНоменклатуры.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	                      |ГДЕ
	                      |	СерииНоменклатуры.ВидНоменклатуры.бит_Код = &бит_Код
	                      |	И Выбор когда &ЕстьОтборГоденДо Тогда СерииНоменклатуры.ГоденДо = &ГоденДо Иначе Истина Конец
	                      |	И Выбор когда &ЕстьОтборНомер   Тогда СерииНоменклатуры.Номер = &Номер Иначе Истина Конец
	                      |	И Выбор когда &ЕстьОтборДатаПроизводства Тогда СерииНоменклатуры.ДатаПроизводства = &ДатаПроизводства Иначе Истина Конец");
	Запрос.УстановитьПараметр("бит_Код", );
	Запрос.УстановитьПараметр("", Результат.vidNomKod);
	
	Номер = Неопределено;
	ГоденДо = Неопределено;
	ДатаПроизводства = Неопределено;
	Результат.Свойство("number", Номер);
	Результат.Свойство("dateTo", ГоденДо);
	Результат.Свойство("dateFrom", ДатаПроизводства);
	
	Запрос.УстановитьПараметр("ЕстьОтборГоденДо", ГоденДо <> Неопределено);
	Запрос.УстановитьПараметр("ГоденДо", ГоденДо);
	Запрос.УстановитьПараметр("ЕстьОтборНомер", Номер <> Неопределено);
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("ЕстьОтборДатаПроизводства", ДатаПроизводства <> Неопределено);
	Запрос.УстановитьПараметр("ДатаПроизводства", ДатаПроизводства);          
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Список;
	// }}ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [29.11.2025 16:11:00] -
КонецФункции
		
		