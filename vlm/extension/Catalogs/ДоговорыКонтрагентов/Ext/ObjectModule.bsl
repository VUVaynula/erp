Функция бит_НомерДоговораУникален(НомерДоговора, Ссылка)
	
//1БИТ ЛТ1.2 KAKravchenko@1cbit.ru 03.03.2025 +	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.Ссылка = &Ссылка
		|	И ДоговорыКонтрагентов.бит_НомерДоговора = &Номер");

	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	Запрос.УстановитьПараметр("Ссылка", Ссылка); 

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
