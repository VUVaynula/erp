Функция бит_ПолучитьНовыйНомерДоговора()
	
//1БИТ ЛТ1.2 KAKravchenko@1cbit.ru 03.03.2025 +	
	МаксимальныйНомер = 0;
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.бит_НомерДоговора КАК бит_НомерДоговора
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_НомерДоговора УБЫВ");

		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		МаксимальныйНомер = Выборка.бит_НомерДоговора;
	КонецЦикла;
	
	Возврат МаксимальныйНомер + 1; 
