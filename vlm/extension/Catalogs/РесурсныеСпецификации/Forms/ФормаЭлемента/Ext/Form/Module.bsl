&НаКлиенте
Асинх Процедура ПриИзменениибит_АгрегирующийКоэффициент(Элемент)
	// {{ПервыйБИТ ЛистТребований [ЛТ33]  [VUVaynula@1cbit.ru] [12.02.2025 20:29:50] +                        
	ЗначениеВСсылке = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ПроизводственныйПроцессОперация.Ссылка, "бит_АгрегирующийКоэффициент");
	Если ПроизводственныйПроцессОперация.бит_АгрегирующийКоэффициент <> ЗначениеВСсылке Тогда
		ТекстВопроса = СтрШаблон("Текущее значение в операции %1 будет заменено на новое %2. Продолжить?", ЗначениеВСсылке, ПроизводственныйПроцессОперация.бит_АгрегирующийКоэффициент);
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Если Ответ = КодВозвратаДиалога.ОК Тогда
			Для каждого стр из Объект.МатериалыИУслуги Цикл 
				Если НЕ ЕстьМеталлосодержащаяТокопроводящаяЖила(стр.Номенклатура) Тогда 
					стр.бит_АгрегирующийКоэффициент = 0;
				ИначеЕсли (
						стр.Операция = ПроизводственныйПроцессОперация.Ссылка
					 ) 
					Или                                                     
					(
						Не ЗначениеЗаполнено(стр.Операция) И ПроизводственныйПроцессОперация.НомерОперации = 1 
						И ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ПроизводственныйПроцессОперация.Владелец, "НомерЭтапа") = 1 
					) 
					Тогда
					
					стр.бит_АгрегирующийКоэффициент = ПроизводственныйПроцессОперация.бит_АгрегирующийКоэффициент;
				
				КонецЕсли; 
				бит_МатериалыИУслугиПересчитатьКоличествоУпаковок(стр);
			КонецЦикла;
			Подключаемый_ПроизводственныйПроцессПриАктивизацииЭлемента();
		Иначе
			ПроизводственныйПроцессОперация.бит_АгрегирующийКоэффициент = ЗначениеВСсылке;
			ОбщегоНазначенияКлиент.СообщитьПользователю("Значение восстановлено значением реквизита в операции");
		КонецЕсли;
		
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ33]  [VUVaynula@1cbit.ru] [12.02.2025 20:29:50] -
КонецПроцедуры

