&НаКлиентеНаСервереБезКонтекста
Процедура бит_МатериалыИУслугиПересчитатьКоличествоУпаковок(стрДанных)
	// {{ПервыйБИТ ЛистТребований [ЛТ33]  [VUVaynula@1cbit.ru] [03.02.2025 14:35:47] +        
	Если ЕстьМеталлосодержащаяТокопроводящаяЖила(стрДанных.Номенклатура) Тогда                                                             
		//  "Кол-во позиции" × (1+"Техн.Отход"/100) × "Коэф-т укрутки"
		//Первыйбит ЛТ3 Доп. Требования ЛапшовГ "GVLapshov@1cbit.ru" 18.04.2025 +
		//стрДанных.КоличествоУпаковок = стрДанных.бит_КоличествоПозиции * ?(стрДанных.бит_АгрегирующийКоэффициент = 0, 1, стрДанных.бит_АгрегирующийКоэффициент) * ?(стрДанных.бит_КоэффициентУкрутки = 0, 1, стрДанных.бит_КоэффициентУкрутки);
		Если стрДанных.бит_ТехнологическийОтход = 0 Тогда 
			стрДанных.КоличествоУпаковок = стрДанных.бит_КоличествоПозиции *
				?(стрДанных.бит_АгрегирующийКоэффициент = 0, 1, стрДанных.бит_АгрегирующийКоэффициент) * 
				?(стрДанных.бит_КоэффициентУкрутки = 0, 1, стрДанных.бит_КоэффициентУкрутки);
		Иначе
			стрДанных.КоличествоУпаковок = стрДанных.бит_КоличествоПозиции * 
				(1 + стрДанных.бит_ТехнологическийОтход/100) * 
				?(стрДанных.бит_КоэффициентУкрутки = 0, 1, стрДанных.бит_КоэффициентУкрутки);
        КонецЕсли;
		//Первыйбит ЛТ3 Доп. Требования ЛапшовГ "GVLapshov@1cbit.ru" 18.04.2025 -
	Иначе     
		// "Кол-во позиции" × (1+"Техн.Отход"/100) × "Коэф-т укрутки"
		стрДанных.КоличествоУпаковок = стрДанных.бит_КоличествоПозиции * (1 + стрДанных.бит_ТехнологическийОтход/100) * ?(стрДанных.бит_КоэффициентУкрутки = 0, 1, стрДанных.бит_КоэффициентУкрутки);
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ33]  [VUVaynula@1cbit.ru] [03.02.2025 14:35:47] -
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьМеталлосодержащаяТокопроводящаяЖила(Номенклатура) 
	// {{ПервыйБИТ ЛистТребований [ЛТ33]  [VUVaynula@1cbit.ru] [03.02.2025 13:55:08] +        
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации В(&мПризнаков)
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
