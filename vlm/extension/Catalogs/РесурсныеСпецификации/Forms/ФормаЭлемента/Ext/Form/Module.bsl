		СтруктураЭтапа.Объект.ДлительностьЭтапа = ВремяВЧасах;
		СтруктураЭтапа.Объект.ЕдиницаИзмеренияДлительностиЭтапа = Перечисления.ЕдиницыИзмеренияВремени.Час;
	
	// В поле "Время работы" для видов рабочих центров, указанных в этапе в минутах:
	// Если указаны альтернативные рабочие центры, то время транслируется в них аналогично.
		Для каждого стр из СтруктураЭтапа.Объект.ВидыРабочихЦентров Цикл
			стр.ВремяРаботы = НормаВремениВМинутах;
			стр.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Минута;
