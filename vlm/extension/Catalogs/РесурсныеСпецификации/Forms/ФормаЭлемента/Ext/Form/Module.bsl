	//(бит) Норма времени, ч" = 1/(бит) Выработка со всей машины, тн
	Если ПроизводственныйПроцессОперация.бит_ВыработкаПроводаСоВсейМашины <> 0 Тогда 
    	ПроизводственныйПроцессОперация.бит_НормаВремени = 1 / ПроизводственныйПроцессОперация.бит_ВыработкаПроводаСоВсейМашины;  
	Иначе
		ПроизводственныйПроцессОперация.бит_НормаВремени = 0;
	КонецЕсли;  
