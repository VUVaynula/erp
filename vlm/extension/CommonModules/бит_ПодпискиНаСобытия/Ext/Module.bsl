Процедура ПроверитьУникальностьШтампаКонтроллера(Источник, Отказ)
	
	Значение = Неопределено;
	ШтампКонтроллера = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШтампКонтроллера, , Истина); 
	Для каждого стр из Источник.ДополнительныеРеквизиты Цикл
		Если стр.Свойство = ШтампКонтроллера И ЗначениеЗаполнено(стр.Значение) Тогда
			Значение = стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Сотрудники.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Сотрудники.ДополнительныеРеквизиты КАК Сотрудники
	                      |ГДЕ
	                      |	Сотрудники.Свойство = &Свойство
	                      |	И Сотрудники.Значение = &Значение
	                      |"); 
	
	Запрос.УстановитьПараметр("Свойство", ШтампКонтроллера);
	Запрос.УстановитьПараметр("Значение", Значение);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если Источник.ЭтоНовый() И ТЗ.Количество() <> 0 Тогда
		Ошибка = Истина;
	ИначеЕсли Источник.ЭтоНовый() = Ложь и ТЗ.Количество() > 1 Тогда
		Ошибка = Истина;
	Иначе
		Ошибка = Ложь;
	КонецЕсли;
	
	Если Ошибка Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранное значение `Штамп контролера` не уникально");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры 

Процедура ПроверитьУникальностьШтампаЭмалировщика(Источник, Отказ)
	
	Значение = Неопределено;
	ШтампЭмалировщика = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШтампЭмалировщика, , Истина); 
	Для каждого стр из Источник.ДополнительныеРеквизиты Цикл
		Если стр.Свойство = ШтампЭмалировщика И ЗначениеЗаполнено(стр.Значение) Тогда
			Значение = стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Сотрудники.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Сотрудники.ДополнительныеРеквизиты КАК Сотрудники
	                      |ГДЕ
	                      |	Сотрудники.Свойство = &Свойство
	                      |	И Сотрудники.Значение = &Значение
	                      |"); 
	
	Запрос.УстановитьПараметр("Свойство", ШтампЭмалировщика);
	Запрос.УстановитьПараметр("Значение", Значение);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если Источник.ЭтоНовый() И ТЗ.Количество() <> 0 Тогда
		Сотрудник = ТЗ[0].Ссылка;
		Ошибка = Истина;
	ИначеЕсли Источник.ЭтоНовый() = Ложь и ТЗ.Количество() > 1 Тогда
		Для каждого стр из ТЗ Цикл
			Если стр.Ссылка = Источник.Ссылка Тогда
				Продолжить;
			КонецЕсли;
			Сотрудник = стр.Ссылка;
			Прервать;
		КонецЦикла;
		
		Ошибка = Истина;
	Иначе
		Ошибка = Ложь;
	КонецЕсли;
	
	Если Ошибка Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранное значение `Штамп контролера` уже указано у сотрудника " + Сотрудник, Сотрудник);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

