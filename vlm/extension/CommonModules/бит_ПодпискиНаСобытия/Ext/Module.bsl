Процедура бит_ДокументыПередЗаписьюПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") Тогда 
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ПроверитьНаличиеПлановойКалькуляции(Источник, Отказ);  
			ПроверитьРазнуюТаруДляОдинаковойНоменклатуры(Источник, Отказ);
		КонецЕсли;
		ЗаполнитьРеквизитыВП(Источник, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.СменноеЗадание") Тогда
		
		ПроверкаВозможностиЗакрытияСменногоЗадания(Источник, Отказ);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЭтапПроизводства2_2") Тогда
		
		ПроверкаВозможностиЗакрытияЭтапПроизводства2_2(Источник, Отказ);	
		
	КонецЕсли; 

КонецПроцедуры 

Процедура ПроверитьРазнуюТаруДляОдинаковойНоменклатуры(Источник, Отказ)
	// {{ПервыйБИТ ЛистТребований [УПО12427]  [VUVaynula@1cbit.ru] [04.08.2026 19:56:14] +        
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	тз.Номенклатура КАК Номенклатура,
	                      |	тз.бит_Тара КАК Тара
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&тз КАК тз
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт.Номенклатура КАК Номенклатура,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт.Тара) КАК Тара
	                      |ИЗ
	                      |	вт КАК вт
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	вт.Номенклатура
	                      |
	                      |ИМЕЮЩИЕ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ вт.Тара) > 1");
	Запрос.УстановитьПараметр("тз", Источник.Товары.Выгрузить(, "Номенклатура, бит_Тара"));
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение запрещено. Для следующей номенклатуры указано несколько разных значений `(бит) Тара`. Укажите одинаковое значение тары");
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Выборка.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [УПО12427]  [VUVaynula@1cbit.ru] [04.08.2026 19:56:14] -
КонецПроцедуры

Процедура ПроверитьНаличиеПлановойКалькуляции(Знач Источник, Отказ)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВЫРАЗИТЬ(ВТ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика
	                      |ПОМЕСТИТЬ ВТ
	                      |ИЗ
	                      |	&ВТ КАК ВТ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ПлановыеМатериальныеЗатратыОбороты.Регистратор КАК Регистратор,
	                      |	ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация.ОсновноеИзделиеНоменклатура КАК Номенклатура,
	                      |	ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация.ОсновноеИзделиеХарактеристика КАК Характеристика
	                      |ПОМЕСТИТЬ ПлановаяКальк
	                      |ИЗ
	                      |	РегистрНакопления.ПлановыеМатериальныеЗатраты.Обороты(
	                      |			,
	                      |			,
	                      |			Запись,
	                      |			(ПартияСпецификация.ОсновноеИзделиеНоменклатура, ПартияСпецификация.ОсновноеИзделиеХарактеристика) В
	                      |				(ВЫБРАТЬ
	                      |					вт.Номенклатура,
	                      |					вт.Характеристика
	                      |				ИЗ
	                      |					вт КАК вт)) КАК ПлановыеМатериальныеЗатратыОбороты
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ПлановыеМатериальныеЗатратыОбороты.Регистратор,
	                      |	ПроизводствоБезЗаказаВыходныеИзделия.Номенклатура,
	                      |	ПроизводствоБезЗаказаВыходныеИзделия.Характеристика
	                      |ИЗ
	                      |	РегистрНакопления.ПлановыеМатериальныеЗатраты.Обороты(, , Запись, ) КАК ПлановыеМатериальныеЗатратыОбороты
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК ПроизводствоБезЗаказаВыходныеИзделия
	                      |		ПО ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация = ПроизводствоБезЗаказаВыходныеИзделия.Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ПлановыеМатериальныеЗатратыОбороты.Регистратор,
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура,
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Характеристика
	                      |ИЗ
	                      |	РегистрНакопления.ПлановыеМатериальныеЗатраты.Обороты(, , Запись, ) КАК ПлановыеМатериальныеЗатратыОбороты
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	                      |		ПО ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация = ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВТ.Номенклатура КАК Номенклатура,
	                      |	ВТ.Характеристика КАК Характеристика
	                      |ИЗ
	                      |	ВТ КАК ВТ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ПлановаяКальк КАК ПлановаяКальк
	                      |		ПО ВТ.Номенклатура = ПлановаяКальк.Номенклатура
	                      |			И ВТ.Характеристика = ПлановаяКальк.Характеристика
	                      |ГДЕ
	                      |	ПлановаяКальк.Регистратор ЕСТЬ NULL
	                      |	И ВТ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)");
	Запрос.УстановитьПараметр("ВТ", Источник.Товары.Выгрузить(, "Номенклатура, Характеристика"));	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + Выборка.Номенклатура 
															 + ?(ЗначениеЗаполнено(Выборка.Характеристика), " " + Выборка.Характеристика, "")
															 + " не найдена плановая калькуляция");
		КонецЦикла; 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение запрещено", , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыВП(Источник, Отказ)
	// {{ПервыйБИТ ЛистТребований [ЛТ 3.17]  [VUVaynula@1cbit.ru] [20.03.2025 17:32:51] +
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИтогИзготовлено = "";
	ИтогПроверено = "";                    
	Изготовлено = 0;
	Проверено = 0;
	
	Источник.бит_ПроцентВыполненияЗаказа = 0;
	Источник.бит_ПроцентПроверкиЗаказа = 0;
	ЗаказВыполнен = Истина;
	ЗаказПроверен = Истина;
	ДатаОкончанияЗаказа = Дата("00010101"); 
	ДатаОкончанияПроверки = Дата("00010101"); 
	
	Источник.бит_ДатаОкончанияЗаказа = ДатаОкончанияЗаказа; 
	Источник.бит_ДатаОкончанияПроверки = ДатаОкончанияПроверки;
	Если Источник.бит_ВоеннаяПриемка Тогда
		
		Для Каждого стр Из Источник.Товары Цикл
			Если стр.бит_Изготовлено Тогда 
				Изготовлено = Изготовлено + 1;
				ДатаОкончанияЗаказа = Макс(ДатаОкончанияЗаказа, стр.бит_ДатаИзготовления); 
			Иначе
				ЗаказВыполнен = Ложь;
			КонецЕсли;
			Если стр.бит_Проверено Тогда
				Проверено = Проверено + 1;
				ДатаОкончанияПроверки = Макс(ДатаОкончанияПроверки, стр.бит_ДатаПроверки);
			Иначе
				ЗаказПроверен = Ложь;
			КонецЕсли;
		КонецЦикла;	
		
		ВсегоСтрок = Источник.Товары.Количество(); 
		
		// Рассчитывается как отношение количества номенклатурных позиций с установленным признаком «Изготовлено» 
		// к общему количеству строк в табличной части.
		//  Формула: (Количество строк с признаком "Изготовлено" / Общее количество строк) * 100.
		Источник.бит_ПроцентВыполненияЗаказа = Окр((Изготовлено / ВсегоСтрок) * 100, 2);
		Источник.бит_ПроцентПроверкиЗаказа 	= Окр((Проверено   / ВсегоСтрок) * 100, 2);     
		Если ЗаказВыполнен Тогда
			Источник.бит_ДатаОкончанияЗаказа = ДатаОкончанияЗаказа;
		КонецЕсли; 
		Если ЗаказПроверен Тогда
			Источник.бит_ДатаОкончанияПроверки = ДатаОкончанияПроверки;	
		КонецЕсли;
		
	КонецЕсли; 

КонецПроцедуры

Процедура УдалитьЗаписьИзРСПереносЗаказовНаПроизводство(Документ)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.27]  [VUVaynula@1cbit.ru] [04.11.2025 16:25:20] +
	// При пометке на удаление "Заказа на производство" удаляется запись из регистра
