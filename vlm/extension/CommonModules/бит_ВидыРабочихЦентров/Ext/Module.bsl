	Для каждого СтрокаВидРЦ Из СписокВидовРЦ Цикл
		
		ТекущийПериод = ПланированиеПроизводстваКлиентСервер.НачалоИнтервалаПланирования(
										НачалоПериода, 
										СтрокаВидРЦ.ИнтервалПланирования);
										
		Пока ТекущийПериод <= ОкончаниеПериода Цикл
			
			СтруктураПоиска = Новый Структура("ВидРабочегоЦентра,ПериодГрафика", СтрокаВидРЦ.ВидРабочегоЦентра, ТекущийПериод);
		 	НайденнаяЗанятостьВРЦ = ЗанятостьВРЦ.НайтиСтроки(СтруктураПоиска);
		 	НайденнаяДоступностьВРЦ = ДоступностьВРЦ.НайтиСтроки(СтруктураПоиска);
			
			Если НайденнаяЗанятостьВРЦ.Количество() <> 0 Тогда
				Для каждого ВыборкаЗанятостьВРЦ Из НайденнаяЗанятостьВРЦ Цикл
					СтрокаДанные = ДанныеОЗагрузке.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДанные, ВыборкаЗанятостьВРЦ);
					СтрокаДанные.ПериодГрафика = ТекущийПериод;
					СтрокаДанные.ПериодГрафикаПредставление = ОперативныйУчетПроизводства.ИнтервалПланированияСтрокой(
																					СтрокаДанные.ПериодГрафика, 
																					СтрокаВидРЦ.ИнтервалПланирования);
																					
					Если НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
						СтрокаДанные.Доступно = НайденнаяДоступностьВРЦ[0].Доступно;
					КонецЕсли; 
				КонецЦикла;
			КонецЕсли;
			
			СкрыватьИнтервалыБезЗагрузки = Ложь;
			
			Если НЕ СкрыватьИнтервалыБезЗагрузки ИЛИ НайденнаяЗанятостьВРЦ.Количество() <> 0 И НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
				
				СтрокаДанные = ДанныеОЗагрузке.Добавить();
				СтрокаДанные.ВидРабочегоЦентра = СтрокаВидРЦ.ВидРабочегоЦентра;
				СтрокаДанные.Подразделение = СтрокаВидРЦ.Подразделение;
				СтрокаДанные.ПериодГрафика = ТекущийПериод;
				СтрокаДанные.ПараллельнаяЗагрузка = СтрокаВидРЦ.ПараллельнаяЗагрузка;
				СтрокаДанные.УчитыватьДоступность = СтрокаВидРЦ.УчитыватьДоступность;
				
				СтрокаДанные.ПериодГрафикаПредставление = ОперативныйУчетПроизводства.ИнтервалПланированияСтрокой(
																				СтрокаДанные.ПериодГрафика, 
																				СтрокаВидРЦ.ИнтервалПланирования);
																				
				Если НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
					СтрокаДанные.Доступно = НайденнаяДоступностьВРЦ[0].Доступно;
				КонецЕсли; 
				
			КонецЕсли;
			ТекущийПериод = ПланированиеПроизводстваКлиентСервер.ОкончаниеИнтервалаПланирования(ТекущийПериод, СтрокаВидРЦ.ИнтервалПланирования) + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	втЗанято.ВидРабочегоЦентра КАК ВидРабочегоЦентра
	                      |ПОМЕСТИТЬ втЗанято
	                      |ИЗ
	                      |	&втЗанято КАК втЗанято
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	                      |	вт.Доступно КАК Доступно,
	                      |	вт.ПараллельнаяЗагрузка КАК ПараллельнаяЗагрузка,
	                      |	вт.УчитыватьДоступность КАК УчитыватьДоступность
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&втДоступно КАК вт
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	вт.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	                      |	вт.УчитыватьДоступность КАК УчитыватьДоступность,
	                      |	вт.ПараллельнаяЗагрузка КАК ПараллельнаяЗагрузка,
	                      |	МАКСИМУМ(вт.Доступно) КАК Доступно,
	                      |	0 КАК Занято,
	                      |	&ПериодГрафика КАК ПериодГрафика
	                      |ИЗ
	                      |	вт КАК вт
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втЗанято КАК втЗанято
	                      |		ПО вт.ВидРабочегоЦентра = втЗанято.ВидРабочегоЦентра
	                      |ГДЕ
	                      |	вт.ВидРабочегоЦентра ССЫЛКА Справочник.ВидыРабочихЦентров
	                      |	И вт.ВидРабочегоЦентра <> ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.ПустаяСсылка)
	                      |	И втЗанято.ВидРабочегоЦентра ЕСТЬ NULL
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	вт.ВидРабочегоЦентра,
	                      |	вт.УчитыватьДоступность,
	                      |	вт.ПараллельнаяЗагрузка");
	Запрос.УстановитьПараметр("втДоступно", ДоступностьВРЦ);
	Запрос.УстановитьПараметр("втЗанято", ДанныеОЗагрузке); 
	Запрос.УстановитьПараметр("ПериодГрафика", НачалоДня(ТекущаяДатаСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		нов = ДанныеОЗагрузке.Добавить();
		ЗаполнитьЗначенияСвойств(нов, Выборка);
	КонецЦикла;
	
	Возврат ДанныеОЗагрузке;

КонецФункции
 
