&НаСервере
Процедура ПолучитьКоличествоЗагруженных() 
	
	КоличествоЗагружено = _01_ТаблицаДанных.Количество();
	Элементы.EXCEL.Заголовок = "EXCEL (" + Строка(КоличествоЗагружено) + ")";
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьНаСервере()
	
	
	// 01 Тип				Игнорировать столбец при переносе	система сигналов исторической системы
	// 02 ПЗ				Игнорировать столбец при переносе	система сигналов исторической системы
    // 03 Тип. план.		Игнорировать столбец при переносе	система сигналов исторической системы

	// 04 Приоритет			бит_ВидЗаказа	При загрузке данных если не подобран элемент справочника "Типизация заказов на производство", создавать новый элемент
	
	// 05 ТМ				Игнорировать столбец при переносе	система сигналов исторической системы
    // 06 Наименование		Игнорировать столбец при переносе	Старое название документа
	
	// 07 Дата открытия/запуска		Дата (Дата документа)	
    // 08 Дата закрытия				ДатаПотребности (Желаемая дата выпуска)

	// 09 ТМЦ				Номенклатура строки ТЧ "Продукция"	
	
	// 10 Характеристика	Игнорировать столбец при переносе	Рудимент использования исторической системы
	
	// 11 Подразделение		Подразделение-Диспетчер	
	
	// 12 Ед. изм.			не транслировать из файла. Брать базовую единицу измерения из "Номенклатуры"	
	
	// 13  ("Треб. кол-во"-"Сдано на склад"), если результат больше "0"	Количество строка ТЧ Продукция.	При трансляции необходимо переводить количество в базовые единицы измерения номенклатуры из Тонн. Например, результат (Треб. кол-во-Сдано на склад)= 0,1 вписывать как 100кг.
	
	// 14 Сдано на склад	Игнорировать столбец при переносе	В ERP иные механизмы контроля.

	// 15 Номер				Назначение строка ТЧ Продукция	
	//						Производится поиск назначения с типом "Заказ клиента" с реквизитом "(бит) № сделки из ККСС". 
	//						Если назначения нет - необходимо создать.

	// 16 Примечание		Комментарий	
	//						Транслировать значение из файла между фразой "Информация по заказу:" и знаком переноса на новую строку.
	//						Если между фразой "Информация по заказу:" и знаком переноса на новую строку отсутствует информация, 
	//						то комментарий остается незаполненным.


 	//Номер	Типовой механизм нумерации по порядку
    //Операция	Устанавливать значение "Собственное производство"
    //Статус	Устанавливать "К производству"
    //Приоритет	Устанавливать "Средний"
    //Спецификация	Использовать типовой подбор актуальной спецификации в "Заказ на производство"

	//Получатель Производится проверка реквизита Склад по сопоставленному заказу клиента из назначения.
	//Если значение склад пустое, то производить заполнение из настройки (бит) Значения по умолчанию - Склад готовой продукции

    //Ответственный	Пользователь запустивший обработку
	//--------------------------------------------------------------------------------------------------------------------
	// 04 Приоритет			бит_ВидЗаказа	При загрузке данных если не подобран элемент справочника "Типизация заказов на производство", создавать новый элемент
	// 07 Дата открытия/запуска		Дата (Дата документа)	
    // 08 Дата закрытия				ДатаПотребности (Желаемая дата выпуска)
    // 09 ТМЦ				Номенклатура строки ТЧ "Продукция"	
    // 11 Подразделение		Подразделение-Диспетчер
	// 13 Количество (переводить в базу из тонн)  
	// 15 Номер				Назначение строка ТЧ Продукция 
	// 16 Примечание
	//--------------------------------------------------------------------------------------------------------------------
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТЗ", _01_ТаблицаДанных.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.бит_КлючЗагрузки КАК бит_КлючЗагрузки,
	               |	ТЗ._05 КАК ТМ,
	               |	ТЗ._04 КАК ВидЗаказа,
				   //|	ТЗ._07 КАК бит_ПереданВПроизводство,
	               |	ТЗ._09 КАК Номенклатура,
	               |	ТЗ._11 КАК Подразделение,
				   //|	ТЗ._12 КАК Единица,
	               |	ТЗ._13 КАК Количество,
				   |	ТЗ._14 КАК КоличествоСдано,
	               |	ТЗ._15 КАК Назначение,
	               |	ТЗ._08 КАК ЖелаемаяДатаВыпуска,
				   //|	ТЗ._23 КАК бит_ДатаПослупленияОригДок,
				   //|	ТЗ._27 КАК НомерРаспоряжения,
				   //|	ТЗ._32 КАК ТипТары,
				   |	ТЗ._16 КАК Примечание,
	               |	ТЗ._07 КАК ДатаДокумента
	               |ПОМЕСТИТЬ вт_ТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |";
	Запрос.Выполнить();                   
	
	// Проверим наличие видов заказов и если нет то создадим
	Запрос.Текст = "ВЫБРАТЬ Различные
	               |	вт_ТЗ.ВидЗаказа КАК ВидЗаказа,
	               |	бит_ТипизацияЗаказовНаПроизводство.Ссылка КАК Ссылка
	               |ИЗ
	               |	вт_ТЗ КАК вт_ТЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ТипизацияЗаказовНаПроизводство КАК бит_ТипизацияЗаказовНаПроизводство
	               |		ПО вт_ТЗ.ВидЗаказа = бит_ТипизацияЗаказовНаПроизводство.Наименование
	               |ГДЕ
	               |	бит_ТипизацияЗаказовНаПроизводство.Ссылка ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		спр = Справочники.бит_ТипизацияЗаказовНаПроизводство.СоздатьЭлемент();
		спр.Наименование = Выборка.ВидЗаказа;
		спр.Записать();
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	вт_ТЗ.ВидЗаказа КАК ВидЗаказа,
				   //|	вт_ТЗ.бит_ПереданВПроизводство КАК бит_ПереданВПроизводство,
	               |	вт_ТЗ.Номенклатура КАК Номенклатура,
	               |	вт_ТЗ.Подразделение КАК Подразделение,
				   //|	вт_ТЗ.Единица КАК Единица,
	               |	вт_ТЗ.Количество - вт_ТЗ.КоличествоСдано  КАК Количество,
	               |	вт_ТЗ.Назначение КАК Назначение,
	               |	вт_ТЗ.ЖелаемаяДатаВыпуска КАК ЖелаемаяДатаВыпуска,
				   //|	вт_ТЗ.бит_ДатаПослупленияОригДок КАК бит_ДатаПослупленияОригДок,
				   //|	вт_ТЗ.НомерРаспоряжения КАК НомерРаспоряжения,
				   //|	вт_ТЗ.ТипТары КАК ТипТары,
				   |	вт_ТЗ.Примечание КАК Примечание,
	               |	вт_ТЗ.ДатаДокумента КАК ДатаДокумента,
	               |	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	               |	НоменклатураСпр.Ссылка КАК НоменклатураСсылка,
	               |	бит_ТипизацияЗаказовНаПроизводство.Ссылка КАК ВидЗаказаСсылка,
	               |	СтруктураПредприятия.Ссылка КАК ПодразделениеСсылка,
	               |	вт_ТЗ.бит_КлючЗагрузки КАК бит_КлючЗагрузки
	               |ПОМЕСТИТЬ вт_ЗаказыКлиентов
	               |ИЗ
	               |	вт_ТЗ КАК вт_ТЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ТипизацияЗаказовНаПроизводство КАК бит_ТипизацияЗаказовНаПроизводство
	               |		ПО вт_ТЗ.ВидЗаказа = бит_ТипизацияЗаказовНаПроизводство.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	               |		ПО вт_ТЗ.Номенклатура = НоменклатураСпр.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	               |		ПО вт_ТЗ.Подразделение = СтруктураПредприятия.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ПО вт_ТЗ.бит_КлючЗагрузки = ЗаказКлиентаТовары.Ссылка.бит_ЗаказКапитал
	               |			И вт_ТЗ.Номенклатура = ЗаказКлиентаТовары.Номенклатура.Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказНаПроизводство2_2Продукция.Ссылка КАК ЗаказНаПроизводство,
	               |	вт_ЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
	               |	вт_ЗаказыКлиентов.ВидЗаказа КАК ВидЗаказа,
				   //|	вт_ЗаказыКлиентов.бит_ПереданВПроизводство КАК бит_ПереданВПроизводство,
	               |	вт_ЗаказыКлиентов.Номенклатура КАК Номенклатура,
	               |	вт_ЗаказыКлиентов.Подразделение КАК Подразделение,
				   //|	вт_ЗаказыКлиентов.Единица КАК Единица,
	               |	вт_ЗаказыКлиентов.Количество КАК Количество,
	               |	вт_ЗаказыКлиентов.Назначение КАК Назначение,
	               |	вт_ЗаказыКлиентов.ЖелаемаяДатаВыпуска КАК ЖелаемаяДатаВыпуска,
				   //|	вт_ЗаказыКлиентов.бит_ДатаПослупленияОригДок КАК бит_ДатаПослупленияОригДок,
				   //|	вт_ЗаказыКлиентов.НомерРаспоряжения КАК НомерРаспоряжения,
				   //|	вт_ЗаказыКлиентов.ТипТары КАК ТипТары,
				   |	вт_ЗаказыКлиентов.Примечание КАК Примечание,
	               |	вт_ЗаказыКлиентов.ДатаДокумента КАК ДатаДокумента,
	               |	МАКСИМУМ(вт_ЗаказыКлиентов.НоменклатураСсылка) КАК НоменклатураСсылка,
	               |	вт_ЗаказыКлиентов.ВидЗаказаСсылка КАК ВидЗаказаСсылка,
	               |	вт_ЗаказыКлиентов.ПодразделениеСсылка КАК ПодразделениеСсылка,
	               |	вт_ЗаказыКлиентов.бит_КлючЗагрузки КАК бит_КлючЗагрузки,
	               |	1 КАК Поле1
	               |ПОМЕСТИТЬ вт_Итоговая
	               |ИЗ
	               |	вт_ЗаказыКлиентов КАК вт_ЗаказыКлиентов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	               |		ПО вт_ЗаказыКлиентов.НоменклатураСсылка = ЗаказНаПроизводство2_2Продукция.Номенклатура
	               |			И вт_ЗаказыКлиентов.ЗаказКлиента = ЗаказНаПроизводство2_2Продукция.Назначение.Заказ
	               |			И (НЕ ЗаказНаПроизводство2_2Продукция.Ссылка.ПометкаУдаления)
	               |ГДЕ
	               |	НЕ вт_ЗаказыКлиентов.ЗаказКлиента ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
				   //|	вт_ЗаказыКлиентов.бит_ПереданВПроизводство,
	               |	вт_ЗаказыКлиентов.бит_КлючЗагрузки,
				   //|	вт_ЗаказыКлиентов.Единица,
	               |	вт_ЗаказыКлиентов.ВидЗаказаСсылка,
	               |	вт_ЗаказыКлиентов.Номенклатура,
	               |	вт_ЗаказыКлиентов.ПодразделениеСсылка,
	               |	вт_ЗаказыКлиентов.ВидЗаказа,
				   |	вт_ЗаказыКлиентов.Примечание,
	               |	ЗаказНаПроизводство2_2Продукция.Ссылка,
	               |	вт_ЗаказыКлиентов.Подразделение,
	               |	вт_ЗаказыКлиентов.ЖелаемаяДатаВыпуска,
	               |	вт_ЗаказыКлиентов.ДатаДокумента,
				   //|	вт_ЗаказыКлиентов.бит_ДатаПослупленияОригДок,
				   //|	вт_ЗаказыКлиентов.ТипТары,
	               |	вт_ЗаказыКлиентов.Назначение,
	               |	вт_ЗаказыКлиентов.Количество,
	               |	вт_ЗаказыКлиентов.ЗаказКлиента
				   //|	вт_ЗаказыКлиентов.НомерРаспоряжения
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаказНаПроизводство2_2Продукция.Ссылка,
	               |	вт_ЗаказыКлиентов.ЗаказКлиента,
	               |	вт_ЗаказыКлиентов.ВидЗаказа,
				   //|	вт_ЗаказыКлиентов.бит_ПереданВПроизводство,
	               |	вт_ЗаказыКлиентов.Номенклатура,
	               |	вт_ЗаказыКлиентов.Подразделение,
				   //|	вт_ЗаказыКлиентов.Единица,
	               |	вт_ЗаказыКлиентов.Количество,
	               |	вт_ЗаказыКлиентов.Назначение,
	               |	вт_ЗаказыКлиентов.ЖелаемаяДатаВыпуска,
				   //|	вт_ЗаказыКлиентов.бит_ДатаПослупленияОригДок,
				   //|	вт_ЗаказыКлиентов.НомерРаспоряжения,
