
&НаКлиенте
Процедура ВыбратьФайлExcel(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресТЗ", "");
	СтруктураПараметров.Вставить("АдресТЗОписанияТиповКолонок", ПолучитьАдресТЗОписанияТиповКолонок());
	СтруктураПараметров.Вставить("НомерКолонкиСДанными", НомерПервойКолонкиСДанными);
	СтруктураПараметров.Вставить("НомерСтрокиСДанными", НомерПервойСтрокиСДанными);
	СтруктураПараметров.Вставить("ОбработкаОповещения", Новый ОписаниеОповещения("ПолучитьТЗИзВременногоХранилища", ЭтотОбъект, СтруктураПараметров));
		
	бит_ОбщегоНазначенияКлиент.ВыбратьФайлExcel(СтруктураПараметров);
	
КонецПроцедуры                               

&НаСервере
Функция ПолучитьАдресТЗОписанияТиповКолонок()
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("НомерКолонки");
	ТаблицаЗначений.Колонки.Добавить("ОписаниеТипа");

	НоваяСтрокаТЗ = ТаблицаЗначений.Добавить();
	НоваяСтрокаТЗ.НомерКолонки = 5; // ТМ
	НоваяСтрокаТЗ.ОписаниеТипа = Новый ОписаниеТипов("Число", , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));
	
	НоваяСтрокаТЗ = ТаблицаЗначений.Добавить();
	НоваяСтрокаТЗ.НомерКолонки = 15; // Номер
	НоваяСтрокаТЗ.ОписаниеТипа = Новый ОписаниеТипов("Число", , Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаЗначений, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ПолучитьТЗИзВременногоХранилища(Результат, ДополнительныеПараметры) Экспорт 

	ОбработатьТаблицуЗначений(ДополнительныеПараметры.АдресТЗ);	

КонецПроцедуры

