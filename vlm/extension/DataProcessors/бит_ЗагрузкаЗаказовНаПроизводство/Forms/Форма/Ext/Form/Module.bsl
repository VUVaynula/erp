Процедура Сопоставить(Команда)   
	
	СопоставитьНаСервере();
	
	Если КоличествоРазница <> 0 тогда
		Элементы._02_ТаблицаДанных_СоздаваемыеСоздатьЭлементы.Доступность = Ложь;
		Элементы._03_ТаблицаДанных_ПроверяемыеПерезаписатьЭлементы.Доступность = Ложь;
		Сообщить("Необходимо устранить разницу между загруженными и создаваемыми/записываемыми элементами!");
	Иначе
		Элементы._02_ТаблицаДанных_СоздаваемыеСоздатьЭлементы.Доступность = Истина;
		Элементы._03_ТаблицаДанных_ПроверяемыеПерезаписатьЭлементы.Доступность = Истина;
	КонецЕсли;                         
	
	тзЗаказыБезСпецификаций.Очистить();
