&НаСервере
Функция ПолучитьОсновнуюСпецификацию(Номенклатура, НачалоПроизводства)
	
	ПараметрыВыбораСпецификаций = УправлениеДаннымиОбИзделияхКлиентСервер.ПараметрыВыбораСпецификаций();
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоНоменклатуре", Истина);
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоСпискуНоменклатуры", Ложь);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеПараметрыНазначения", Новый Массив);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеУточненияПрименения", Новый Массив);
	
	ДанныеОбИзделии = УправлениеДаннымиОбИзделияхКлиентСервер.СтруктураДанныхОбИзделииДляВыбораСпецификации();
	ДанныеОбИзделии.Номенклатура = Номенклатура;	
	ДанныеОбИзделии.НачалоПроизводства = НачалоПроизводства;
	
	Результат = УправлениеДаннымиОбИзделиях.СпецификацииИзделия(ДанныеОбИзделии, ПараметрыВыбораСпецификаций);
	
	ИсключитьСпецификацию = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Спецификации             = Новый Массив;
	ПриоритетнаяСпецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Для Индекс = 0 По Результат.ВГраница() Цикл
		ТекущаяСпецификация = Результат[Индекс].Спецификация;
		Если ПриоритетнаяСпецификация.Пустая()
				И Результат[Индекс].ПодбираетсяАвтоматически = Истина Тогда
			ПриоритетнаяСпецификация = ТекущаяСпецификация;
		КонецЕсли;
		Если ТекущаяСпецификация <> ИсключитьСпецификацию Тогда
			Спецификации.Добавить(ТекущаяСпецификация);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ПриоритетнаяСпецификация;
	
КонецФункции

&НаСервере
Процедура ПерезаписатьЭлементыНаСервере()
	
	Тонны = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("168");

	Для Каждого СтрокаТЗ Из _03_ТаблицаДанных_Проверяемые Цикл
		//
		//Если ЗначениеЗаполнено(СтрокаТЗ._23) и ЗначениеЗаполнено(СтрокаТЗ.ЗаказКлиента) Тогда
		//	ЗаказКлиентаОбъект = СтрокаТЗ.ЗаказКлиента.ПолучитьОбъект();
		//	ЗаказКлиентаОбъект.бит_ДатаПоступленияОригиналовДокументов = Дата(СтрокаТЗ._23 + " 00:00:00");
		//	ЗаказКлиентаОбъект.Записать();
		//КонецЕсли;
		Если СтрокаТЗ._13 <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйДокумент = СтрокаТЗ.ЗаказНаПроизводство.ПолучитьОбъект();
		
		НовыйДокумент.Продукция.Очистить();
		
		НовыйДокумент.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.КПроизводству;
		НовыйДокумент.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
		НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СобственноеПроизводство;
		
		НовыйДокумент.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
		
		НовыйДокумент.НачатьНеРанее = Дата(СтрокаТЗ._07 + " 00:00:00");
		НовыйДокумент.РазмещениеВыпуска = Перечисления.СпособыПривязкиОперацийПроизводства.КНачалу;
		
		НовыйДокумент.Дата = Дата(СтрокаТЗ._07 + " 00:00:00");
		НовыйДокумент.Подразделение = СтрокаТЗ.ПодразделениеСсылка;
		НовыйДокумент.бит_ВидЗаказа = СтрокаТЗ.ВидЗаказаСсылка;
		//НовыйДокумент.получатель
		
		//НовыйДокумент.бит_ПереданВПроизводство = Дата(СтрокаТЗ._07 + " 00:00:00");
		НовыйДокумент.ДатаПотребности = Дата(СтрокаТЗ._08 + " 00:00:00");
		
		СтрокаПродукция = НовыйДокумент.Продукция.Добавить();
		СтрокаПродукция.Номенклатура = СтрокаТЗ.НоменклатураСсылка; 
		СтрокаПродукция.Назначение = ПолучитьНазначение(СтрокаТЗ.ЗаказКлиента); 
		Коэф = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(Тонны, СтрокаПродукция.Номенклатура); 
		СтрокаПродукция.КоличествоУпаковок = Коэф * СтрокаТЗ._13;
		СтрокаПродукция.Количество = СтрокаПродукция.КоличествоУпаковок;
		СтрокаПродукция.Склад = СтрокаТЗ.ЗаказКлиента.Склад;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.ЗаказКлиента.Склад) Тогда
			СтрокаПродукция.Склад =	СтрокаТЗ.ЗаказКлиента.Склад;
		Иначе	
			СтрокаПродукция.Склад = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.СкладГотовойПродукции, ЭтотОбъект, Истина);
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(СтрокаТЗ.ЗаказКлиента) Тогда
		//	СтрокаПродукция.бит_ТипТары = СтрокаТЗ.ЗаказКлиента.Товары[0].бит_ТипТары;
		//	СтрокаПродукция.бит_КоличествоТары = СтрокаТЗ.ЗаказКлиента.Товары[0].бит_КоличествоТары;
		//КонецЕсли;
	
		СтрокаПродукция.Спецификация = ПолучитьОсновнуюСпецификацию(СтрокаПродукция.Номенклатура, НовыйДокумент.Дата);
		
		НовыйДокумент.Комментарий = ПолучитьПримечание(СтрокаТЗ._16);
		НовыйДокумент.Ответственный = Пользователи.АвторизованныйПользователь();
		
		Попытка
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			
			Запись = РегистрыСведений.бит_ПереносЗаказовНаПроизводство.СоздатьМенеджерЗаписи();
			Запись.ЗаказНаПроизводство = НовыйДокумент.Ссылка;
			Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
			Запись.Пользователь = Пользователи.АвторизованныйПользователь();
			Запись.НомерЗаказа = НовыйДокумент.Номер;
			
			Запись.Записать(Истина);
			
		Исключение
			НовыйДокумент.Записать();
			Сообщить(ОписаниеОшибки());
		КонецПопытки;                
		
	КонецЦикла;
	
	_03_ТаблицаДанных_Проверяемые.Очистить();
	
КонецПроцедуры

