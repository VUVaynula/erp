&НаСервере
Функция ПолучитьНаименованиеГруза(СсылкаНаОбъект)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозкуДополнительныеРеквизиты.Значение КАК Значение
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку.ДополнительныеРеквизиты КАК ЗаданиеНаПеревозкуДополнительныеРеквизиты
		|ГДЕ
		|	ЗаданиеНаПеревозкуДополнительныеРеквизиты.Ссылка = &Ссылка
		|	И ЗаданиеНаПеревозкуДополнительныеРеквизиты.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Наименование груза"));
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НаименованиеГруза = "";
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НаименованиеГруза = ВыборкаДетальныеЗаписи.Значение;
	КонецЦикла;
	
	Возврат НаименованиеГруза; 
	
КонецФункции


