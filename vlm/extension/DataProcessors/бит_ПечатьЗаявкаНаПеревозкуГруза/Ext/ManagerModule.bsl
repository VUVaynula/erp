		КонецЕсли;
		ОбластьДокумент.Параметры.ДополнительнаяИнформация1 = ДополнительнаяИнформация1;
		// }}ПервыйБИТ ЛистТребований [ЛТ2.6]  [VUVaynula@1cbit.ru] [12.08.2025 19:24:04] -
				
		ОбластьДокумент.Параметры.Заполнить(СтруктураДанных);
		
