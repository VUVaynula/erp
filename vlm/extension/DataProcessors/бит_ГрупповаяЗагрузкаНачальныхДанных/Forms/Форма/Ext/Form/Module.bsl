&НаСервере 
Функция ПреобразоватьКТИпуБулевоВН(Реквезит)
	
	Если  Реквезит = "Нет" ИЛИ Реквезит = "нет" Тогда 
		Определитель = Ложь;
	ИначеЕсли Реквезит = "Да" ИЛИ Реквезит = "да" Тогда 
		Определитель = Истина; 
	Иначе
		Определитель = Неопределено;
	КонецЕсли;
	
	Возврат Определитель;
	
