&НаСервере
Функция УстановитьСоответствиеРеквизитовБанка()
	
	СоответствиеРеквизитовБанка = Новый Соответствие;
	СоответствиеРеквизитовБанка.Вставить("БИКБанка", "БИК");
	СоответствиеРеквизитовБанка.Вставить("СВИФТБанка", "СВИФТ");
	СоответствиеРеквизитовБанка.Вставить("КоррСчетБанка", "КоррСчет");
	СоответствиеРеквизитовБанка.Вставить("НаименованиеБанка", "Наименование");
	СоответствиеРеквизитовБанка.Вставить("НаименованиеБанкаМеждународное", "НаименованиеМеждународное");
	СоответствиеРеквизитовБанка.Вставить("СтранаБанка", "Страна");
	СоответствиеРеквизитовБанка.Вставить("ГородБанка", "Город");
	СоответствиеРеквизитовБанка.Вставить("ГородБанкаМеждународный", "ГородМеждународный");
	СоответствиеРеквизитовБанка.Вставить("АдресБанка", "Адрес");
	СоответствиеРеквизитовБанка.Вставить("АдресБанкаМеждународный", "АдресМеждународный");
	СоответствиеРеквизитовБанка.Вставить("ТелефоныБанка", "Телефоны");
	СоответствиеРеквизитовБанка.Вставить("БИКБанкаДляРасчетов", "БИК");
	СоответствиеРеквизитовБанка.Вставить("СВИФТБанкаДляРасчетов", "СВИФТ");
	СоответствиеРеквизитовБанка.Вставить("НаименованиеБанкаДляРасчетов", "Наименование");
	СоответствиеРеквизитовБанка.Вставить("НаименованиеБанкаДляРасчетовМеждународное", "НаименованиеМеждународное");
	СоответствиеРеквизитовБанка.Вставить("КоррСчетБанкаДляРасчетов", "КоррСчет");
	СоответствиеРеквизитовБанка.Вставить("СтранаБанкаДляРасчетов", "Страна");
	СоответствиеРеквизитовБанка.Вставить("ГородБанкаДляРасчетов", "Город");
	СоответствиеРеквизитовБанка.Вставить("ГородБанкаДляРасчетовМеждународный", "ГородМеждународный");
	СоответствиеРеквизитовБанка.Вставить("АдресБанкаДляРасчетов", "Адрес");
	СоответствиеРеквизитовБанка.Вставить("АдресБанкаДляРасчетовМеждународный", "АдресМеждународный");
	СоответствиеРеквизитовБанка.Вставить("ТелефоныБанкаДляРасчетов", "Телефоны");
	
	Возврат СоответствиеРеквизитовБанка;
	
КонецФункции

&НаСервере
Функция Банк(Страна, Код)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлассификаторБанков.Ссылка 
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.Код = &Код
	|	И КлассификаторБанков.Страна = &Страна";
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Страна", Страна);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РеквизитыБанка()
	
	Возврат "БИКБанка, СВИФТБанка, НаименованиеБанка, НаименованиеБанкаМеждународное, КоррСчетБанка, СтранаБанка,
		|ГородБанка, ГородБанкаМеждународный, АдресБанка, АдресБанкаМеждународный, ТелефоныБанка";
	
КонецФункции  

&НаСервере
Функция  ПроверкаИсправленияБанка(ТекущийЭлементСправочника)
	
	ИдентификаторБик = Ложь;
	ИдентификаторНаименованиеБанка = Ложь;
	ИдентификаторКоррСчетБанка = Ложь;
	
	Если ТекущийЭлементСправочника.БИКБанка = Неопределено 
		ИЛИ ТекущийЭлементСправочника.БИКБанка = "" Тогда 
		ИдентификаторБик = Истина;
	ИначеЕсли ТекущийЭлементСправочника.НаименованиеБанка = Неопределено 
		ИЛИ ТекущийЭлементСправочника.НаименованиеБанка = "" Тогда
		ИдентификаторНаименованиеБанка = Истина;
	ИначеЕсли ТекущийЭлементСправочника.КоррСчетБанка = Неопределено 
		ИЛИ ТекущийЭлементСправочника.КоррСчетБанка = "" Тогда
		ИдентификаторКоррСчетБанка = Истина;
	ИначеЕсли ТекущийЭлементСправочника.Банк = Неопределено 
		ИЛИ ТекущийЭлементСправочника.Банк.Пустая() Тогда
		ИдентификаторБ = Истина;  
	Иначе ИдентификаторБ = Ложь;
	КонецЕсли;   
	
	Если ИдентификаторБик ИЛИ ИдентификаторНаименованиеБанка ИЛИ ИдентификаторКоррСчетБанка Тогда
		ИдентификаторБ = Истина;
	Иначе ИдентификаторБ = Ложь;
	КонецЕсли;
		
	Возврат ИдентификаторБ; 	

КонецФункции

&НаСервере
Процедура ОбработкаДанныхБанка(ТекущийЭлементСправочника, СтрокаТек)
	
	Если ПроверкаИсправленияБанка(ТекущийЭлементСправочника) Тогда
		
		Банк = Справочники.КлассификаторБанков.НайтиПоКоду(СтрокаТек.БИКБанка);
		
		Если Банк = Неопределено Тогда
			Банк = Справочники.КлассификаторБанков.НайтиПоРеквизиту("СВИФТБИК" , СтрокаТек.БИКБанка);
		КонецЕсли;
		
		СоответствиеРеквизитовБанка = УстановитьСоответствиеРеквизитовБанка();
		СтруктураРеквизитов = Новый Структура;
		ИменаРеквизитов = СтрРазделить(РеквизитыБанка(), ",", Ложь);
		
		Для каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			СтруктураРеквизитов.Вставить(ИмяРеквизита, СоответствиеРеквизитовБанка[СокрЛП(ИмяРеквизита)]);
		КонецЦикла;
		
		СтруктураРеквизитов.Вставить("БИКБанка", "Код");
		СтруктураРеквизитов.Вставить("СВИФТБанка", "СВИФТБИК");
		СтруктураРеквизитов.Вставить("НаименованиеБанкаМеждународное", "МеждународноеНаименование");
		РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, СтруктураРеквизитов);
		ЗаполнитьЗначенияСвойств(ТекущийЭлементСправочника, РеквизитыБанка);
		ТекущийЭлементСправочника.Банк = Банк; 
		СтрокаТек.Изменено = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьБуквыВСтроке(Строка)
	
	ЕстьКириллица = Ложь;
	ЕстьЛатиница = Ложь;
	
	КириллическиеСимволы = "АаБбВвГгДдЕеЁёЖжЗзИиЙйКкЛлМмНнОоПпРрСсТтУуФфХхЦцЧчШшЩщЬьЫыЪъЭэЮюЯя";
	ЛатинскиеСимволы         = "AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz";
	
	ИсходнаяСтрока = СокрЛП(Строка);
	Если СтрДлина(ИсходнаяСтрока) > 0 Тогда
		Для Сч = 1 По СтрДлина(ИсходнаяСтрока) Цикл
			Символ = НРег(Сред(ИсходнаяСтрока, Сч, 1)); 
			
			Если СтрНайти(КириллическиеСимволы , Символ) <> 0 Тогда
				ЕстьКириллица = Истина;
			ИначеЕсли СтрНайти(ЛатинскиеСимволы, Символ) <> 0 Тогда
				ЕстьЛатиница = Истина;  
			Иначе
				Кириллица = Ложь;
				Латиница = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьКириллица ИЛИ ЕстьЛатиница Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОпределитьСтрануИБанкПоIBAN(БанковскийСчета)
	
	КодСтраны = ДенежныеСредстваКлиентСервер.КодСтраныIBAN(БанковскийСчета.НомерСчета);
	Страна =  Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", КодСтраны);
	Если ЗначениеЗаполнено(Страна) Тогда
		СтранаБанка = Страна;
		БанковскийСчета.СтранаБанка = Страна;
		НациональныйКодБанка = ДенежныеСредстваСервер.НациональныйКодБанка(БанковскийСчета.НомерСчета);
		НайденныйБанк = Банк(Страна, НациональныйКодБанка);
		Если ЗначениеЗаполнено(НайденныйБанк) Тогда
			БанковскийСчета.Банк = НайденныйБанк;
			БанковскийСчета.РучноеИзменениеРеквизитовБанка = Ложь;
			СоответствиеРеквизитовБанка = УстановитьСоответствиеРеквизитовБанка();
			СтруктураРеквизитов = Новый Структура;
			ИменаРеквизитов = СтрРазделить(РеквизитыБанка(), ",", Ложь);
			
			Для каждого ИмяРеквизита Из ИменаРеквизитов Цикл
				СтруктураРеквизитов.Вставить(ИмяРеквизита, СоответствиеРеквизитовБанка[СокрЛП(ИмяРеквизита)]);
			КонецЦикла;
			
			СтруктураРеквизитов.Вставить("БИКБанка", "Код");
			СтруктураРеквизитов.Вставить("СВИФТБанка", "СВИФТБИК");
			СтруктураРеквизитов.Вставить("НаименованиеБанкаМеждународное", "МеждународноеНаименование");
			РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденныйБанк, СтруктураРеквизитов);
			ЗаполнитьЗначенияСвойств(БанковскийСчета, РеквизитыБанка);
			
			БанковскийСчета.Банк = НайденныйБанк; 
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработкиСтраниц
// Первая страница

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		
	ДиалогВыбораФайла.Фильтр                  =     НСтр("ru='Файл данных (*.xlsx, *.xls)|*.xlsx; *.xls");
   	ДиалогВыбораФайла.Заголовок                   = Заголовок;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.Расширение              =    "xlsx,xls";
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	ДиалогВыбораФайла.ПолноеИмяФайла              = Элемент.ТекстРедактирования;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриветствиеДалее(Команда)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ТекстСообщения = НСтр("ru='Вначале укажите путь к файлу загрузки!'");
		Предупреждение(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если  Объект.ИдентификаторСправочника = "" ИЛИ
		  Объект.ИдентификаторСправочника = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Требуется указать справочник!'");
		Предупреждение(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ИдентификаторСостояния = "Состояние1";
	Элементы.ГруппаСопоставления.Заголовок 					= ПутьКФайлу;
	
	ПоместитьТекущийФайлНаСерверАсинхронно();
	    
	Элементы.ЭтапыЗагрузки.ТекущаяСтраница = Элементы.ЭтапыЗагрузки.ПодчиненныеЭлементы.Сопоставление; 
	
	Если Объект.ИдентификаторСправочника = "ПризнакиНоменклатуры" 
		Или Объект.ИдентификаторСправочника = "ПризнакиТара"
		Или Объект.ИдентификаторСправочника = "ПризнакиОтходов"Тогда
		Элементы.ЗаполнитьПризнакиНоменклатуры.Видимость = Истина;
		Элементы.ЗаполнитьПризнакиНоменклатуры.Доступность = Истина;
	Иначе
		Элементы.ЗаполнитьПризнакиНоменклатуры.Видимость = Ложь;
		Элементы.ЗаполнитьПризнакиНоменклатуры.Доступность = Ложь;
	КонецЕсли;	
	
	Если Объект.ИдентификаторСправочника = "АтрибутыКонтрагентов" Тогда
		Элементы.ЗаполнитьАтрибутыКонтрагентов.Видимость = Истина;
		Элементы.ЗаполнитьАтрибутыКонтрагентов.Доступность = Истина;
	Иначе
		Элементы.ЗаполнитьАтрибутыКонтрагентов.Видимость = Ложь;
		Элементы.ЗаполнитьАтрибутыКонтрагентов.Доступность = Ложь;
	КонецЕсли;
	
	Если Объект.ИдентификаторСправочника = "Спецификации" Тогда
		Элементы.Дата1.Видимость = Истина;
	Иначе
		Элементы.Дата1.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

 &НаКлиенте
Асинх Процедура ПоместитьТекущийФайлНаСерверАсинхронно()
	
	ОписаниеФайла =
	Ждать 
	ПоместитьФайлНаСерверАсинх( , , , ПутьКФайлу);
	Если ОписаниеФайла <> Неопределено Тогда  
		ПутьСНовымИменем = ОписаниеФайла.СсылкаНаФайл.Файл.Путь + ОписаниеФайла.СсылкаНаФайл.Файл.ИмяБезРасширения; 
		ПредставлениеИсточника = ЗагрузитьРеквизитыНаСервере(ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Расширение, 
		                                                     ПутьСНовымИменем);
		ЗаполнитьТаблицу(ПредставлениеИсточника);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьРеквизитыНаСервере(АдресДанных, РасширениеФайла, ПутьСНовымИменем)
	
	ПутьКФайлуЗагрузки = ПолучитьИмяВременногоФайла(РасширениеФайла);         
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Данные.Записать(ПутьКФайлуЗагрузки);
	ТабДок = ПрочитатьExcel(ПутьКФайлуЗагрузки, ПутьСНовымИменем);
	УдалитьФайлы(ПутьКФайлуЗагрузки);
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция ПрочитатьExcel(ПутьКФайлуЗагрузки, ПутьСНовымИменем)
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлуЗагрузки);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось прочитать файл по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();                                                        
		Возврат Неопределено;
	КонецПопытки;  	
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область()); 	
	Построитель.ЗаполнитьНастройки(); 
	Построитель.Выполнить();	
	
	ИменаКолонок = Построитель.ВыбранныеПоля;	
	ВыборкаДетальныеЗаписи = Построитель.Результат.Выбрать();
	
	Возврат ТабДок; 
	
КонецФункции

