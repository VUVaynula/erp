 &НаСервере 
Процедура ОбработатьОшибкиЭлементыТаблицыДоговорыКонтрагентов()
	
	 МассивМенеджеров = СозданиеДоговорыКонтрагентов.Выгрузить( , "Менеджер");
     МассивКонтактныхЛиц = СозданиеДоговорыКонтрагентов.Выгрузить( , "КонтактноеЛицо");
	 МассивИДКонтрагентов = ИсточникДоговорыКонтрагентов.Выгрузить( , "ИДКлиента");
		 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.бит_ИДКлиента КАК бит_ИДКлиента
		|ПОМЕСТИТЬ ВТКонтрагентов
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.бит_ИДКлиента В(&МассивИДКонтрагентов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование В(&МассивМенеджеров)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.бит_ИДКлиента КАК бит_ИДКлиента
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.бит_ИДКлиента В(&МассивИДКонтрагентов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка,
		|	КонтактныеЛицаПартнеров.Наименование КАК Наименование,
		|	КонтактныеЛицаПартнеров.Владелец КАК Владелец
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	КонтактныеЛицаПартнеров.Наименование В(&МассивКонтактныхЛиц)
		|	И КонтактныеЛицаПартнеров.Владелец В
		|			(ВЫБРАТЬ
		|				ВТКонтрагентов.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТКонтрагентов КАК ВТКонтрагентов)";
	
	Запрос.УстановитьПараметр("МассивМенеджеров", МассивМенеджеров);
	Запрос.УстановитьПараметр("МассивКонтактныхЛиц", МассивКонтактныхЛиц);
	Запрос.УстановитьПараметр("МассивИДКонтрагентов", МассивИДКонтрагентов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаМенеджеры = РезультатЗапроса[1].Выгрузить();  
	ВыборкаКонтрагенты = РезультатЗапроса[2].Выгрузить();
	ВыборкаКонтактныеЛицаПартнеров = РезультатЗапроса[3].Выгрузить();

	Для каждого СтрокаДоговорыКонтрагентов Из  ОшибокДоговорыКонтрагентов Цикл    
		ОшибкаВалют = СтрНайти(СтрокаДоговорыКонтрагентов.Ошибка, "Валюта не найдена!");
		ОшибкаКонтрагент = СтрНайти(СтрокаДоговорыКонтрагентов.Ошибка, "Контрагент по ID не найден!");
		ОшибкаСчетКонтрагента = СтрНайти(СтрокаДоговорыКонтрагентов.Ошибка,"Банковский счет контрагента не найден!");
		ОшибкаСчетОрганизации = СтрНайти(СтрокаДоговорыКонтрагентов.Ошибка,"Банковский счет организации не найден!"); 
		Если ОшибкаКонтрагент <> 0 
			ИЛИ  ОшибкаВалют <> 0 Тогда
			Продолжить;
		КонецЕсли;  
		СоздатьЭлементОшибокДК(СтрокаДоговорыКонтрагентов, ВыборкаМенеджеры, ВыборкаКонтактныеЛицаПартнеров, ОшибкаСчетКонтрагента, ОшибкаСчетОрганизации);

	КонецЦикла;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОшибокДоговорыКонтрагентов.Обработано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОшибокДоговорыКонтрагентов.Обработано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.ОшибокДоговорыКонтрагентов.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры  

&НаСервере                                                                         
Процедура СоздатьЭлементОшибокДК(СтрокаДоговорыКонтрагентов, ВыборкаМенеджеры, ВыборкаКонтактныеЛицаПартнеров, ОшибкаСчетКонтрагента, ОшибкаСчетОрганизации)
	
	ИдентификаторМенеджера = ВыборкаМенеджеры.Найти(СтрокаДоговорыКонтрагентов.Менеджер);
		Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("бит_ИДКлиента",
		                                                   	   СтрокаДоговорыКонтрагентов.ИДКлиента); 
		
		Отбор = Новый Структура();
        Отбор.Вставить("Наименование", СтрокаДоговорыКонтрагентов.КонтактноеЛицо); 
		Отбор.Вставить("Владелец", Контрагент); 
		СтрокаДоговоры = ВыборкаКонтактныеЛицаПартнеров.НайтиСтроки(Отбор);
        Если СтрокаДоговоры.Количество() = 0 И СтрокаДоговорыКонтрагентов.КонтактноеЛицо <> "" Тогда
			СозданиеКонтактногоЛица(СтрокаДоговорыКонтрагентов.КонтактноеЛицо, Контрагент);
		КонецЕсли;
			
		ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		ДоговорКонтрагента.Наименование = СтрокаДоговорыКонтрагентов.Наименование; 
		Если ОшибкаСчетОрганизации = 0 Тогда 
			БСО = СтрЗаменить(СокрЛП(СтрокаДоговорыКонтрагентов.БанковскийСчет), " ", "");
			НомерСчетаБСО = ВРег(СтрЗаменить(БСО, ".", ""));
			ТекущийЭлементСправочникаБСО = Справочники.БанковскиеСчетаОрганизаций.НайтиПоРеквизиту("НомерСчета", НомерСчетаБСО);
			ДоговорКонтрагента.БанковскийСчет = ТекущийЭлементСправочникаБСО;   
		КонецЕсли;
		Если ОшибкаСчетКонтрагента = 0 Тогда
			БСК = СтрЗаменить(СокрЛП(СтрокаДоговорыКонтрагентов.БанковскийСчетКонтрагента), " ", "");
			НомерСчетаБСК = ВРег(СтрЗаменить(БСК, ".", ""));
			ТекущийЭлементСправочникаБСК = Справочники.БанковскиеСчетаКонтрагентов.НайтиПоРеквизиту("НомерСчета", НомерСчетаБСК);
			ДоговорКонтрагента.БанковскийСчетКонтрагента = ТекущийЭлементСправочникаБСК;
		КонецЕсли;
		ДоговорКонтрагента.ВалютаВзаиморасчетов = 
		                             Справочники.Валюты.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.ВалютаВзаиморасчетов);
		ДоговорКонтрагента.Комментарий = СтрокаДоговорыКонтрагентов.Комментарий; 
		ДоговорКонтрагента.ДатаНачалаДействия = СтрокаДоговорыКонтрагентов.ДатаНачалаДействия;
		ДоговорКонтрагента.ДатаОкончанияДействия = СтрокаДоговорыКонтрагентов.ДатаОкончанияДействия;
		ДоговорКонтрагента.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		ДоговорКонтрагента.Контрагент = Контрагент; 
		ДоговорКонтрагента.Менеджер = Справочники.Пользователи.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.Менеджер);
		ДоговорКонтрагента.НаименованиеДляПечати = СтрокаДоговорыКонтрагентов.НаименованиеДляПечати;
		ДоговорКонтрагента.Дата = СтрокаДоговорыКонтрагентов.ДатаНачалаДействия;
		ДоговорКонтрагента.Номер = СтрокаДоговорыКонтрагентов.Номер;
		ДоговорКонтрагента.Партнер = Контрагент.Партнер;
		
		ДоговорКонтрагентаЗаполнениеТипНазначения(СтрокаДоговорыКонтрагентов, ДоговорКонтрагента);
		ДоговорКонтрагента.ЗакупкаПодДеятельностьОпределяетсяВДокументе = Истина;
		ДоговорКонтрагента.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;
        ДоговорКонтрагента.Согласован = Истина;  
		ДоговорКонтрагента.НалогообложениеНДСОпределяетсяВДокументе = Истина; 
		ДоговорКонтрагента.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", 
		Перечисления.СтавкиНДС.НДС20); 
		ДоговорКонтрагента.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		ДоговорКонтрагента.КонтактноеЛицо =
		                Справочники.КонтактныеЛицаПартнеров.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.КонтактноеЛицо);
		ДоговорКонтрагента.Сумма = СтрокаДоговорыКонтрагентов.Сумма;
		
		Попытка	
			ДоговорКонтрагента.Записать();
			СтрокаДоговорыКонтрагентов.Обработано = Истина;
		Исключение
			СтрокаДоговорыКонтрагентов.Обработано = Ложь;
		КонецПопытки;
		
КонецПроцедуры

 &НаСервере 
Процедура ИзменениеУсловногоОформленияПроверкиДоговорыКонтрагентов()
	
    ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиДоговорыКонтрагентов.Изменено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин); 
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиДоговорыКонтрагентов.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиДоговорыКонтрагентов.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СозданияБанки
   
&НаКлиенте 
Процедура ДействияСТаблицамиБанки(ПредставлениеИсточника)
	
	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникБанки.Видимость 				= Истина;
		ЗаполнитьТаблицуИсточникБанки(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеБанки.Видимость 					= Истина;
		Элементы.ПроверкиБанки.Видимость 					= Истина;
		Элементы.ОшибокБанки.Видимость 						= Истина;
        ЗаполнитьТаблицыПроверкиБанки(); 
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыБанки();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыБанки();
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.КлассификаторБанков.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры 
  
&НаСервере 
Процедура ЗаполнитьТаблицуИсточникБанки(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникБанки = ИсточникБанки.Добавить();	 
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;	   
		СтрИсточникБанки.НаименованиеБанка = ТекстКолонки;
		СтрИсточникБанки.КоррСчетБанка = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;
        СтрИсточникБанки.БИКБанка = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;
        СтрИсточникБанки.ВалютаДенежныхСредств = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
        	 		
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникБанки.Удалить(СтрИсточникБанки);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиБанки() 
	
	УсловноеОформление.Элементы.Очистить();
	
	Для каждого СтрокаИсточникБанки Из ИсточникБанки Цикл     
		Если СтрокаИсточникБанки.ВалютаДенежныхСредств = "RUB" Тогда 
			СтрокаИсточникБанки.ВалютаДенежныхСредств = "руб.";   
		КонецЕсли;		
	КонецЦикла;  
	МассивВалют = ИсточникБанки.Выгрузить( , "ВалютаДенежныхСредств");
	МассивБик = ИсточникБанки.Выгрузить( , "БИКБанка"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлассификаторБанков.Ссылка КАК Ссылка,
	|	КлассификаторБанков.Код КАК Код,
	|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
	|ПОМЕСТИТЬ КлассификаторБаковБик
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.Код В(&МассивБик)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлассификаторБанков.Ссылка КАК Ссылка,
	|	КлассификаторБанков.Код КАК Код,
	|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
	|ПОМЕСТИТЬ КлассификаторБаковСВИФТ
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.СВИФТБИК В(&МассивБик)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КлассификаторБаковБик.Ссылка КАК Ссылка,
	|	КлассификаторБаковБик.Код КАК Код,
	|	КлассификаторБаковБик.СВИФТБИК КАК СВИФТБИК
	|ИЗ
	|	КлассификаторБаковБик КАК КлассификаторБаковБик
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КлассификаторБаковСВИФТ.Ссылка,
	|	КлассификаторБаковСВИФТ.Код,
	|	КлассификаторБаковСВИФТ.СВИФТБИК
	|ИЗ
	|	КлассификаторБаковСВИФТ КАК КлассификаторБаковСВИФТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка,
	|	Валюты.Код КАК Код,
	|	Валюты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Наименование В(&МассивВалют)";
		
	Запрос.УстановитьПараметр("МассивБик", МассивБик);
	Запрос.УстановитьПараметр("МассивВалют", МассивВалют);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаБик = РезультатЗапроса[2].Выгрузить();
	ВыборкаВалют = РезультатЗапроса[3].Выгрузить();
		
	ЗаполнениеТаблицБанки(ВыборкаБик, ВыборкаВалют);

КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТаблицБанки(ВыборкаБик, ВыборкаВалют)
    
	Для каждого СтрокаИсточникБанки Из ИсточникБанки Цикл 
		
		ТекстСообщения = ""; 
		
		ИдентификаторВалюта = ВыборкаВалют.Найти(СтрокаИсточникБанки.ВалютаДенежныхСредств);
		Если ИдентификаторВалюта = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Валюта не найдена! ";
		КонецЕсли;
		
		ИдентификаторБик = ВыборкаБик.Найти(СтрокаИсточникБанки.БИКБанка);
		Если ИдентификаторБик = Неопределено И Не (ЕстьБуквыВСтроке(СтрокаИсточникБанки.БИКБанка)) Тогда
			ТекстСообщения = ТекстСообщения + "Банк не найден! ";
		КонецЕсли;
		
		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокБанки = ОшибокБанки.Добавить();
			ЗаполнитьСтрокуТаблицыПроверкиБанки(СтрокаОшибокБанки, 
			СтрокаИсточникБанки);
			СтрокаОшибокБанки.Ошибка = ТекстСообщения;
		ИначеЕсли ИдентификаторБик <> Неопределено Тогда 
			СтрокаПроверкиБанки = ПроверкиБанки.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанки(СтрокаПроверкиБанки, 
			СтрокаИсточникБанки);
		Иначе 
			СтрокаСозданиеБанки = СозданиеБанки.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанки(СтрокаСозданиеБанки,
			СтрокаИсточникБанки);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиБанки(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.НаименованиеБанка = СтрокаИсточник.НаименованиеБанка; 
	СтрокаПриемник.КоррСчетБанка = СтрокаИсточник.КоррСчетБанка;
	СтрокаПриемник.БИКБанка = СтрокаИсточник.БИКБанка;
	СтрокаПриемник.ВалютаДенежныхСредств = СтрокаИсточник.ВалютаДенежныхСредств;
	
