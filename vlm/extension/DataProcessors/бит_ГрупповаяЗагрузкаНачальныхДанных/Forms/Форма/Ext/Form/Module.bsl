&НаСервере 
Процедура ПолучитьВремяРаботыИЕдИзмВремени(ВидРабочегоЦента, ВидРЦ)
	
	Если Число(ВидРЦ.НормаВыработки) = 0 Тогда
		ВидРабочегоЦента.ВремяРаботы = 0;
		ВидРабочегоЦента.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час;
	Иначе
		КоличествоИзделийВЧас = 1 / ВидРЦ.НормаВыработки; 
		КоличествоИзделийВМинуту = КоличествоИзделийВЧас * 60;
		Если КоличествоИзделийВМинуту < 0.1 Тогда
			КоличествоИзделийВСекунду = КоличествоИзделийВМинуту * 60; 
			ВидРабочегоЦента.ВремяРаботы = КоличествоИзделийВСекунду;
			ВидРабочегоЦента.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Секунда;
		Иначе
			ВидРабочегоЦента.ВремяРаботы = КоличествоИзделийВМинуту;  
			ВидРабочегоЦента.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Минута; 
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

