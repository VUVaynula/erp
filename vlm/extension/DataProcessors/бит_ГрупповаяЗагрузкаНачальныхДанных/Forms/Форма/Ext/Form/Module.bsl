&НаСервере 
Процедура ПроверитьДопРеквизитыЭлемента(ЭлементКонтрагенты, СтрокаПартнеры)
	
		Если ЭлементКонтрагенты.бит_НаименованиеСФормойСобственности = "" 
			Или ЭлементКонтрагенты.бит_НаименованиеСФормойСобственности = Неопределено Тогда 
			Если СтрокаПартнеры.НаименованиеСФормойСобственности <> "" Тогда 
				ЭлементКонтрагенты.бит_НаименованиеСФормойСобственности = СтрокаПартнеры.НаименованиеСФормойСобственности; 
				СтрокаПартнеры.Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭлементКонтрагенты.бит_ФормаСобственности = "" 
			Или ЭлементКонтрагенты.бит_ФормаСобственности = Неопределено Тогда
			Если СтрокаПартнеры.ФормаСобственности <> "" Тогда
				ЭлементКонтрагенты.бит_ФормаСобственности = СтрокаПартнеры.ФормаСобственности; 
				СтрокаПартнеры.Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭлементКонтрагенты.бит_Зона = "" 
			Или ЭлементКонтрагенты.бит_Зона = Неопределено Тогда
			Если СтрокаПартнеры.Зона <> "" Тогда
				ЭлементКонтрагенты.бит_Зона = СтрокаПартнеры.Зона; 
				СтрокаПартнеры.Изменено = Истина;
			КонецЕсли; 
		КонецЕсли;

