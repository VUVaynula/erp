&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПартнеры(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование;                          
	СтрокаПриемник.НаименованиеПолное = СтрокаИсточник.НаименованиеПолное;
	СтрокаПриемник.ЮридическоеФизическоеЛицо = СтрокаИсточник.ЮридическоеФизическоеЛицо ;
	СтрокаПриемник.СтранаРегистрации = СтрокаИсточник.СтранаРегистрации;
	СтрокаПриемник.ИНН = СтрокаИсточник.ИНН;
	СтрокаПриемник.КПП = СтрокаИсточник.КПП; 
	СтрокаПриемник.КодПоОКПО = СтрокаИсточник.КодПоОКПО;
	СтрокаПриемник.Партнер = СтрокаИсточник.Партнер;
	СтрокаПриемник.ЮрФизЛицо = СтрокаИсточник.ЮрФизЛицо;
	СтрокаПриемник.КонтактнаяИнформацияТип = СтрокаИсточник.КонтактнаяИнформацияТип;
	СтрокаПриемник.КонтактнаяИнформацияСтрана = СтрокаИсточник.КонтактнаяИнформацияСтрана;
	СтрокаПриемник.КонтактнаяИнформацияРегион = СтрокаИсточник.КонтактнаяИнформацияРегион;
	СтрокаПриемник.КонтактнаяИнформацияГород = СтрокаИсточник.КонтактнаяИнформацияГород;
	СтрокаПриемник.КонтактнаяИнформацияНомерТелефона = СтрокаИсточник.КонтактнаяИнформацияНомерТелефона;
	СтрокаПриемник.Факс = СтрокаИсточник.Факс;
	СтрокаПриемник.РуководительОрганизацииДолжность = СтрокаИсточник.РуководительОрганизацииДолжность;
	СтрокаПриемник.РуководительОрганизацииФИО = СтрокаИсточник.РуководительОрганизацииФИО;
	СтрокаПриемник.НаименованиеСФормойСобственности = СтрокаИсточник.НаименованиеСФормойСобственности;
	СтрокаПриемник.Счет = СтрокаИсточник.Счет;
	СтрокаПриемник.ФормаСобственности = СтрокаИсточник.ФормаСобственности;
	СтрокаПриемник.Зона = СтрокаИсточник.Зона;
	СтрокаПриемник.ИДКлиента = СтрокаИсточник.ИДКлиента;

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыТаблицыПартнеры() 
     				
	Для каждого СтрокаПартнеры Из СозданиеПартнеры Цикл 
		
		ИдентификаторП = Неопределено;
		ИдентификаторК = Неопределено;
		ИдентификаторЛ = Неопределено;
		ЭлементКонтрагенты = Неопределено;
		ЭлементПартнеры = Неопределено;
		СоздатьЭлементПартнер (СтрокаПартнеры, ИдентификаторП, ЭлементПартнеры);
		СоздатьЭлементКонтрагенты (СтрокаПартнеры, ИдентификаторК, ЭлементКонтрагенты, ЭлементПартнеры);
        СоздатьЭлементКонтактныеЛица (СтрокаПартнеры, ИдентификаторЛ, ЭлементКонтрагенты);
		Если Не (СтрокаПартнеры.Счет = "") Тогда
			СоздатьЭлементСчет (СтрокаПартнеры.Счет, ЭлементКонтрагенты); 
		КонецЕсли;
		Если ИдентификаторК И ИдентификаторП И ИдентификаторЛ Тогда
			СтрокаПартнеры.Создано = Истина;
		Иначе
			СтрокаПартнеры.Создано = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
	ИзменениеУсловногоОформленияСозданияПартнеров();
		
КонецПроцедуры  

&НаСервере 
Процедура СоздатьЭлементПартнер (СтрокаПартнеры, ИдентификаторП, ЭлементПартнеры)
	
	ЭлементПартнеры = Справочники.Партнеры.СоздатьЭлемент();
	ЭлементПартнеры.Наименование =  СтрокаПартнеры.Наименование;
	ЭлементПартнеры.НаименованиеПолное = СтрокаПартнеры.НаименованиеПолное; 
	СозданиеЮрФизЛицоПартнеры(СтрокаПартнеры, ЭлементПартнеры);
	ЭлементПартнеры.ДатаРегистрации = Дата; 
	ЭлементПартнеры.Поставщик = Истина;
	Если СтрокаПартнеры.Партнер = "" ИЛИ СтрокаПартнеры.Партнер = "Нет" ИЛИ СтрокаПартнеры.Партнер = "нет" Тогда 
		ЭлементПартнеры.ПрочиеОтношения = Истина;
	Иначе 
		ЭлементПартнеры.ПрочиеОтношения = Ложь;
	КонецЕсли;
	
	Если СтрокаПартнеры.КонтактнаяИнформацияТип <> "" Тогда
		ЗаполнитьКонтактнуюИнформациюКонтрагентПартнер(ЭлементПартнеры, СтрокаПартнеры); 
	КонецЕсли;	
	
	Попытка	
		ЭлементПартнеры.Записать();
		ИдентификаторП = Истина;
		ЭлементПартнеры = ЭлементПартнеры.Ссылка;
	Исключение
		ИдентификаторП = Ложь;
	КонецПопытки;

КонецПроцедуры 

&НаСервере 
Процедура СоздатьЭлементКонтрагенты (СтрокаПартнеры, ИдентификаторК, ЭлементКонтрагенты, ЭлементПартнеры)
	
	ЭлементКонтрагенты = Справочники.Контрагенты.СоздатьЭлемент(); 
	ЭлементКонтрагенты.Наименование = СтрокаПартнеры.Наименование;
	ЭлементКонтрагенты.НаименованиеПолное = СтрокаПартнеры.НаименованиеПолное; 
	СозданиеЮрФизЛицоКонтрагенты(СтрокаПартнеры, ЭлементКонтрагенты);
	ЭлементКонтрагенты.СтранаРегистрации = ПроверитСтранаРегистрации(СтрокаПартнеры.СтранаРегистрации);
	Если СтрДлина(СтрокаПартнеры.ИНН) < 7 Тогда
		ЭлементКонтрагенты.ИНН = "";
	Иначе	 
		ЭлементКонтрагенты.ИНН = СтрокаПартнеры.ИНН;
		ЭлементКонтрагенты.КПП = СтрокаПартнеры.КПП; 
	КонецЕсли;
	ЭлементКонтрагенты.Партнер = ЭлементПартнеры;
	ЭлементКонтрагенты.КодПоОКПО = СтрокаПартнеры.КодПоОКПО;
	ЗаполнитьДопРеквизитыЭлемента(ЭлементКонтрагенты, СтрокаПартнеры);
	
	Если СтрокаПартнеры.КонтактнаяИнформацияТип <> "" Тогда
		ЗаполнитьКонтактнуюИнформациюКонтрагентПартнер(ЭлементКонтрагенты, СтрокаПартнеры);
	КонецЕсли;
	
	Попытка	
		ЭлементКонтрагенты.Записать();
		ИдентификаторК = Истина; 
		ЭлементКонтрагенты = ЭлементКонтрагенты.Ссылка;
	Исключение
		ИдентификаторК = Ложь;
	КонецПопытки;
	
КонецПроцедуры 

&НаСервере 
Процедура СоздатьЭлементКонтактныеЛица (СтрокаПартнеры, ИдентификаторЛ, ЭлементКонтрагенты)  
	
	ЭлементКонтактныеЛица = Справочники.КонтактныеЛицаПартнеров.СоздатьЭлемент(); 
	ЭлементКонтактныеЛица.Наименование = СтрокаПартнеры.РуководительОрганизацииФИО;  
	ЭлементКонтактныеЛица.ДолжностьПоВизитке = СтрокаПартнеры.РуководительОрганизацииДолжность; 
	ЭлементКонтактныеЛица.Владелец = ЭлементКонтрагенты.Партнер;
	ЭлементКонтактныеЛица.ДатаРегистрацииСвязи = Дата;
	ЭлементКонтактныеЛица.Автор = Пользователи.ТекущийПользователь(); 
	
	Попытка	
		ЭлементКонтактныеЛица.Записать();
		ИдентификаторЛ = Истина;
	Исключение
		ИдентификаторЛ = Ложь;
	КонецПопытки;

КонецПроцедуры 

&НаСервере 
Процедура СозданиеЮрФизЛицоПартнеры(СтрокаПартнеры, ЭлементПартнеры)
	
	Если СтрокаПартнеры.ЮрФизЛицо = "Юридическое лицо"  Тогда 
		ЭлементПартнеры.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	ИначеЕсли СтрокаПартнеры.ЮрФизЛицо = "Физическое лицо" Тогда
		ЭлементПартнеры.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	Иначе
		ЭлементПартнеры.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
		ЮрФизЛицо = Неопределено;
	КонецЕсли;
	Если СтрокаПартнеры.Партнер = "да" ИЛИ СтрокаПартнеры.Партнер = "Да" ИЛИ СтрокаПартнеры.Партнер = "ДА" Тогда 
		ЭлементПартнеры.Клиент = Истина;
	Иначе 
		ЭлементПартнеры.Клиент = Ложь;
	КонецЕсли;
	//Если ЭлементПартнеры.Клиент Тогда	
	//	ЭлементПартнеры.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.НайтиПоНаименованию("Продажи"); 
	//Иначе 	
	//	ЭлементПартнеры.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.НайтиПоНаименованию("Прочие отношения");
	//КонецЕсли;	

КонецПроцедуры

&НаСервере 
Процедура СозданиеЮрФизЛицоКонтрагенты(СтрокаПартнеры, ЭлементКонтрагенты)
	
	Если СтрокаПартнеры.ФормаСобственности = "ЧЛ" Тогда
		ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
		ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо; 
	ИначеЕсли СтрокаПартнеры.ФормаСобственности = "ИП" Тогда 
		ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
		ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Иначе	  
		Если СтрокаПартнеры.ЮрФизЛицо = "Юридическое лицо"
			И (СтрокаПартнеры.СтранаРегистрации = "Россия" 
			ИЛИ СтрокаПартнеры.СтранаРегистрации = "РОССИЯ") Тогда 
			ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		ИначеЕсли СтрокаПартнеры.ЮрФизЛицо = "Юридическое лицо" И СтрокаПартнеры.СтранаРегистрации <> "Россия" Тогда        
			ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
			ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		ИначеЕсли СтрокаПартнеры.ЮрФизЛицо = "Физическое лицо" Тогда
			ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
			ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		ИначеЕсли СтрокаПартнеры.ЮрФизЛицо = "Индивидуальный предприниматель" Тогда
			ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
			ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо; 
		Иначе
			ЭлементКонтрагенты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			ЭлементКонтрагенты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			ЮрФизЛицо = Неопределено;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементСчет (Счет, ЭлементКонтрагенты) 
	
		БанковскийСчетаКонтрагентов = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
		БанковскийСчетаКонтрагентов.Владелец = ЭлементКонтрагенты; 
		НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(Счет), " ", ""), ".", ""));
		БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
		
		Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			БанковскийСчетаКонтрагентов.ИностранныйБанк = Истина;
			Если Сред(НомерСчета, 1, 4) = "IBAN" Тогда
				НомерСчета = Сред(НомерСчета, 5);
				БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
			КонецЕсли;
			Если ДенежныеСредстваКлиентСервер.ПравильнаяДлинаIBAN(НомерСчета) Тогда
				БанковскийСчетаКонтрагентов.ЭтоIBAN = Истина;
				ОпределитьСтрануИБанкПоIBAN(БанковскийСчетаКонтрагентов);
				БанковскийСчетаКонтрагентов.РучноеИзменениеРеквизитовБанка = Истина;
			КонецЕсли;
		КонецЕсли;  
		Если БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств.Пустая() Тогда
			БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств = Справочники.Валюты.ПолучитьВалютуПоУмолчанию();
		КонецЕсли;
		ШаблонНаименования = НСтр("ru = '%1, %2'; |en = '%1, %2'"); 
		ВалютаДС = СокрЛП(БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), ВалютаДС);
		БанковскийСчетаКонтрагентов.Наименование = СтрокаНаименования;
		
		Попытка	
			БанковскийСчетаКонтрагентов.Записать();
		Исключение
			СозданиеСчета = Ложь;
		КонецПопытки;	
 
КонецПроцедуры

&НаСервере 
Процедура ИзменениеУсловногоОформленияСозданияПартнеров() 
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеПартнеры.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеПартнеры.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.СозданиеПартнеры.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;

КонецПроцедуры	

