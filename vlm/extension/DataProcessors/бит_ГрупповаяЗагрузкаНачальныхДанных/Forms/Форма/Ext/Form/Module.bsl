&НаСервере 
Функция ПроверкаАгрКоэф(Строка)  
	
	ЕстьАгрКоэфПредшественника = Ложь;
	Отбор = Новый Структура();
    Отбор.Вставить("Изделие", Строка.Материал);
	ВыдоркаСтрок = СозданиеСпецификации.НайтиСтроки(Отбор);
	Если ВыдоркаСтрок.Количество() > 0 Тогда
		Для Каждого Элемент из ВыдоркаСтрок Цикл
			Если ЗначениеЗаполнено(Элемент.АгрегКоэфт) Тогда
				ТекАгрК =  Число(Элемент.АгрегКоэфт);
				Если ТекАгрК > 1 Тогда
					ЕстьАгрКоэфПредшественника = Истина;
				ИначеЕсли (ТекАгрК < 1) и (ТекАгрК > 0) Тогда
					ЕстьАгрКоэфПредшественника = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Возврат ЕстьАгрКоэфПредшественника;
	
КонецФункции

&НаСервере 
Процедура СоздатьПризнак(Строка);
	
	бит_Признак = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.НайтиПоКоду("COND_CORE");
	Отбор = Новый Структура;
	Отбор.Вставить("бит_Номенклатура", Строка.Материал);
	ПризнакиНоменклатуры = РегистрыСведений.бит_ЗначенияПризнаковНоменклатуры.Выбрать(Отбор);
	Итератор = 0;
	Пока ПризнакиНоменклатуры.Следующий() Цикл
		Если ПризнакиНоменклатуры.бит_Признак = бит_Признак и ПризнакиНоменклатуры.бит_Значение = Истина Тогда
			Итератор = Итератор +1;
		КонецЕсли;
	КонецЦикла;
	
	Если Итератор = 0  Тогда
		МенеджерЗаписи = РегистрыСведений.бит_ЗначенияПризнаковНоменклатуры.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.бит_Номенклатура = Строка.Материал;
		МенеджерЗаписи.бит_Признак = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.НайтиПоКоду("COND_CORE");
		МенеджерЗаписи.бит_ПризнакСертификации = МенеджерЗаписи.бит_Признак.бит_ПризнакСертификации;
		МенеджерЗаписи.бит_Значение = Истина;
		
		МенеджерЗаписи.Записать();	
	КонецЕсли;	
			
КонецПроцедуры

&НаСервере 
Процедура ПопыткаЗаполнитьСпецификациюМатериала(СтрокаТЗМатериалыИУслуги)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РесурсныеСпецификации.Ссылка КАК Ссылка,
		|	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура КАК ОсновноеИзделиеНоменклатура
		|ИЗ
		|	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
		|ГДЕ
		|	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура = &Номенклатура
		|	И РесурсныеСпецификации.ЭтоГруппа = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Номенклатура", СтрокаТЗМатериалыИУслуги.Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();;
	Если РезультатЗапроса.Количество() = 1 Тогда; 
		//СтрокаТЗМатериалыИУслуги.ИсточникПолученияПолуфабриката = РезультатЗапроса[0].Ссылка;
		СтрокаТЗМатериалыИУслуги.Обособленно = Истина;
	Иначе 
		СтрокаТЗМатериалыИУслуги.Обособленно = Ложь;  
	КонецЕсли;	 
	    
КонецПроцедуры

