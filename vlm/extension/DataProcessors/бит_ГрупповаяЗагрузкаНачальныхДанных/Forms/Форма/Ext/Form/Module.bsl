	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиРабочиеЦентры.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиРабочиеЦентры.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
  	
КонецПроцедуры
#КонецОбласти 

#Область СозданияСпецификации
&НаСервере 
Процедура ЗаполнитьТаблицуИсточникСпецификации(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточник = ИсточникСпецификации.Добавить();	                                    		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточник.ИдПозВарианта = ТекстКолонки;                                                       
		СтрИсточник.ИдРодителя = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;             
		СтрИсточник.КодРодителя = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;        
	    СтрИсточник.Родитель = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;  	
		СтрИсточник.ЕдИзмРодителя = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;               
		СтрИсточник.КодПФИлиМатериала = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст;     
		СтрИсточник.НаименованиеПФИлиМатериала = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;         
		СтрИсточник.Обособленно = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст; // исправление после сквозного задача 5                                                                                           
		СтрИсточник.ЕдИзм = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;                                                                                           
		СтрИсточник.Тип = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;                                                                                           
		СтрИсточник.КолвоПозицииВарианта = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;                                                                                           
		СтрИсточник.Процент = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;                                                                                           
		СтрИсточник.КоррКоэффициент = ПредставлениеИсточника.Область(НомерСтроки, 13).Текст;                                                                                           
		СтрИсточник.ИДТехмаршрутаРодителя = ПредставлениеИсточника.Область(НомерСтроки, 14).Текст;                                                                                           
		СтрИсточник.НомерОперации = ПредставлениеИсточника.Область(НомерСтроки, 15).Текст;                                                                                           
		СтрИсточник.КодОперации = ПредставлениеИсточника.Область(НомерСтроки, 16).Текст;                                                                                           
		СтрИсточник.НаименованиеОперации = ПредставлениеИсточника.Область(НомерСтроки, 17).Текст;                                                                                           
		СтрИсточник.КодЦеха = ПредставлениеИсточника.Область(НомерСтроки, 18).Текст;                                                                                           
		СтрИсточник.НаименованиеЦеха = ПредставлениеИсточника.Область(НомерСтроки, 19).Текст;                                                                                           
		СтрИсточник.КодОборудования = ПредставлениеИсточника.Область(НомерСтроки, 20).Текст;																						   
		СтрИсточник.НаименованиеОборудования = ПредставлениеИсточника.Область(НомерСтроки, 21).Текст;																						   
		СтрИсточник.НормаВыработки = ПредставлениеИсточника.Область(НомерСтроки, 22).Текст;
		СтрИсточник.ЕдИзмЧ = ПредставлениеИсточника.Область(НомерСтроки, 23).Текст;																						   
		СтрИсточник.ПризнакОснМаршрута = ПредставлениеИсточника.Область(НомерСтроки, 24).Текст;																						   
		СтрИсточник.КоэфтУкрутки = ПредставлениеИсточника.Область(НомерСтроки, 25).Текст;																						    
		СтрИсточник.ТехнОтход = ПредставлениеИсточника.Область(НомерСтроки, 26).Текст;																						   
		СтрИсточник.АгрегКоэфт = ПредставлениеИсточника.Область(НомерСтроки, 27).Текст;																						   
		СтрИсточник.ИДТехмаршрутаПФ = ПредставлениеИсточника.Область(НомерСтроки, 28).Текст;	
		СтрИсточник.АгрегКоэф_Материалов = ПредставлениеИсточника.Область(НомерСтроки, 29).Текст;	
		
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникСпецификации.Удалить(СтрИсточник);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ДействияСТаблицамиСпецификации(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникСпецификации.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникСпецификации(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеСпецификации.Видимость 	= Истина;
		Элементы.ПроверкиСпецификации.Видимость 	= Истина;
		Элементы.ОшибокСпецификации.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиСпецификации();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыСпецификации();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыСпецификации();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.РесурсныеСпецификации.ФормаСписка"); 
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиСпецификации()
	
	УсловноеОформление.Элементы.Очистить();
	//ПроверкаКод оборудования это код ВРЦ  или РЦ
	МассивКодовОборудования = ИсточникСпецификации.Выгрузить( , "КодОборудования");
	МассивИзделий = ИсточникСпецификации.Выгрузить( , "КодРодителя");
	МассивМатериалов = ИсточникСпецификации.Выгрузить( , "КодПФИлиМатериала");
	МассивОпераций = ИсточникСпецификации.Выгрузить( , "КодОперации");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В(&МассивИзделий)
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В(&МассивМатериалов)
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РесурсныеСпецификацииВыходныеИзделия.Ссылка КАК Ссылка,
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК Номенклатура,
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура.Артикул КАК НоменклатураАртикул
		|ИЗ
		|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
		|ГДЕ
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура.Артикул В(&МассивИзделий)
		|	И РесурсныеСпецификацииВыходныеИзделия.Ссылка.ПометкаУдаления = Ложь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеЦентры.Ссылка КАК Ссылка,
		|	РабочиеЦентры.Наименование КАК Наименование,
		|	РабочиеЦентры.бит_КодРабЦентра КАК бит_КодРабЦентра
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	РабочиеЦентры.ЭтоГруппа = ЛОЖЬ
		|	И РабочиеЦентры.бит_КодРабЦентра В(&МассивКодовОборудования)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыРабочихЦентров.Ссылка КАК Ссылка,
		|	ВидыРабочихЦентров.Наименование КАК Наименование,
		|	ВидыРабочихЦентров.Описание КАК Описание
		|ИЗ
		|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
		|ГДЕ
		|	(ВидыРабочихЦентров.ЭтоГруппа = ЛОЖЬ
		|				И ВЫРАЗИТЬ(ВидыРабочихЦентров.Описание КАК СТРОКА(100)) В (&МассивКодовОборудования)
		|			ИЛИ ВидыРабочихЦентров.бит_КодВРЦ В (&МассивКодовОборудования))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеЦентры.Ссылка КАК Ссылка,
		|	РабочиеЦентры.Наименование КАК Наименование,
		|	РабочиеЦентры.ВидРабочегоЦентра КАК ВидРабочегоЦентра
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	РабочиеЦентры.ЭтоГруппа = ЛОЖЬ
		|	И РабочиеЦентры.ВидРабочегоЦентра В
		|			(ВЫБРАТЬ
		|				ВидыРабочихЦентров.Ссылка КАК Ссылка
		|			ИЗ
		|				Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
		|			ГДЕ
		|				(ВидыРабочихЦентров.ЭтоГруппа = ЛОЖЬ
		|						И ВЫРАЗИТЬ(ВидыРабочихЦентров.Описание КАК СТРОКА(100)) В (&МассивКодовОборудования)
		|					ИЛИ ВидыРабочихЦентров.бит_КодВРЦ В (&МассивКодовОборудования)))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_КодыОпераций.Наименование КАК Наименование,
		|	бит_КодыОпераций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_КодыОпераций КАК бит_КодыОпераций
		|ГДЕ
		|	бит_КодыОпераций.Наименование В(&МассивОпераций)";		
	
	
	Запрос.УстановитьПараметр("МассивИзделий", МассивИзделий);
	Запрос.УстановитьПараметр("МассивМатериалов", МассивМатериалов);
	Запрос.УстановитьПараметр("МассивКодовОборудования", МассивКодовОборудования);
    Запрос.УстановитьПараметр("МассивОпераций", МассивОпераций);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаИзделия = РезультатЗапроса[0].Выгрузить();
	ВыборкаМатериалы = РезультатЗапроса[1].Выгрузить();
	ВыборкаСпецификации = РезультатЗапроса[2].Выгрузить();
	ВыборкаРЦ = РезультатЗапроса[3].Выгрузить();
	ВыборкаВРЦ = РезультатЗапроса[4].Выгрузить();
	ВыборкаРЦВладельца = РезультатЗапроса[5].Выгрузить();
    ВыборкаКодовОпераций = РезультатЗапроса[6].Выгрузить();
	
	Для каждого СтрокаСпецификации Из ИсточникСпецификации Цикл
	
		ТекстСообщения = ""; 

		Изделие = ВыборкаИзделия.Найти(СтрокаСпецификации.КодРодителя);
		Если Изделие = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Выпускаемая номенклатура не найдена! ";
		//ИначеЕсли Изделие.Количество() = 1 Тогда
		//	Изделие = Изделие[0].Ссылка;
		Иначе 
			//ТекстСообщения = ТекстСообщения + "Выпускаемая номенклатура не сопоставлена! "; 
			Изделие = Изделие.Ссылка;
		КонецЕсли;
		
		Материал = ВыборкаМатериалы.Найти(СтрокаСпецификации.КодПФИлиМатериала);
		Если Материал = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Материал не найден! ";
		//ИначеЕсли Материал.Количество() = 1 Тогда
		//	Материал = Материал[0].Ссылка;
		Иначе 
			//ТекстСообщения = ТекстСообщения + "Материал не сопоставлен! ";  
			Материал = Материал.Ссылка;
		КонецЕсли;
		
		
		Если СтрНайти(СтрокаСпецификации.НаименованиеОборудования, "ОСНОВНОЕ ПРОИЗВОДСТВО")  <> 0 
			Или СтрНайти(СтрокаСпецификации.НаименованиеОборудования, "Нет оборудования")  <> 0 Тогда  
			ЦехБезОборудования = Истина;
		Иначе
			ЦехБезОборудования = Ложь;
		КонецЕсли;
		//Если СтрНайти(СтрокаСпецификации.НаименованиеОборудования, "Цех42")  = 0 Тогда 
		Если Не ЦехБезОборудования Тогда	
			РЦ = ВыборкаРЦ.Найти(СтрокаСпецификации.КодОборудования);
			ВРЦ = ВыборкаВРЦ.Найти(СтрокаСпецификации.КодОборудования);
			Если РЦ = Неопределено и ВРЦ = Неопределено Тогда
				ТекстСообщения = ТекстСообщения + "Рабочий центр не найден! ";
			ИначеЕсли РЦ <> Неопределено Тогда
				РЦ = РЦ.Ссылка;
				ВРЦ = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
			ИначеЕсли ВРЦ <> Неопределено Тогда
				РЦ  = Справочники.РабочиеЦентры.ПустаяСсылка();
				ВРЦ = ВРЦ.Ссылка;	
			КонецЕсли;
		Иначе	
			ВРЦ = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
			РЦ  = Справочники.РабочиеЦентры.ПустаяСсылка();
		КонецЕсли;
	
		Если ЗначениеЗаполнено(ВРЦ) Тогда 
			Отбор = Новый Структура();
			Отбор.Вставить("ВидРабочегоЦентра", ВРЦ);
			РЦВладельца = ВыборкаРЦВладельца.НайтиСтроки(Отбор);
			Если РЦВладельца.Количество() = 1 Тогда
				РЦВладельца = РЦВладельца[0].Ссылка;
			Иначе 
				РЦВладельца = Справочники.РабочиеЦентры.ПустаяСсылка();
			КонецЕсли;
		Иначе 
			РЦВладельца = Справочники.РабочиеЦентры.ПустаяСсылка();
		КонецЕсли;
		
		КодОперацииСсылка = ВыборкаКодовОпераций.Найти(СтрокаСпецификации.КодОперации, "Наименование"); 
		Спецификация = ВыборкаСпецификации.Найти(СтрокаСпецификации.КодРодителя); 
		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокСпецификации = ОшибокСпецификации.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаОшибокСпецификации, 
			                                                         СтрокаСпецификации);
			СтрокаОшибокСпецификации.Ошибка = ТекстСообщения;
		ИначеЕсли Спецификация = Неопределено Тогда
			СтрокаСозданиеСпецификации = СозданиеСпецификации.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаСозданиеСпецификации,
			                                                         СтрокаСпецификации);
			СтрокаСозданиеСпецификации.Изделие = Изделие;
			СтрокаСозданиеСпецификации.Материал = Материал;
			//СтрокаСозданиеСпецификации.РЦ = РЦ;
			СтрокаСозданиеСпецификации.РЦ = РЦВладельца;
			СтрокаСозданиеСпецификации.ВРЦ = ВРЦ;
			Если ЗначениеЗаполнено(КодОперацииСсылка) Тогда
				СтрокаСозданиеСпецификации.КодОперацииСсылка = КодОперацииСсылка.Ссылка;
			КонецЕсли;	
		Иначе 
			СтрокаПроверкиСпецификации = ПроверкиСпецификации.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаПроверкиСпецификации, 
			                                                         СтрокаСпецификации);
			СтрокаПроверкиСпецификации.Изделие = Изделие;
			СтрокаПроверкиСпецификации.Материал = Материал;
			//СтрокаПроверкиСпецификации.РЦ = РЦ; 
			//СтрокаСозданиеСпецификации.РЦ = РЦВладельца;
			СтрокаПроверкиСпецификации.ВРЦ = ВРЦ;
			СтрокаПроверкиСпецификации.СсылкаСпецификация = Спецификация[0].Ссылка;
			Если ЗначениеЗаполнено(КодОперацииСсылка) Тогда
				СтрокаПроверкиСпецификации.КодОперацииСсылка = КодОперацииСсылка.Ссылка;
			КонецЕсли;
	    КонецЕсли;
		
	КонецЦикла;
	
	//СозданиеСпецификации.Сортировать("ИдРодителя"); 
	СозданиеСпецификации.Сортировать("КодРодителя Возр");
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.ИдПозВарианта = СтрокаИсточник.ИдПозВарианта;
	СтрокаПриемник.ИдРодителя = СтрокаИсточник.ИдРодителя;
	СтрокаПриемник.КодРодителя = СтрокаИсточник.КодРодителя;
	СтрокаПриемник.Родитель = СтрокаИсточник.Родитель;
	СтрокаПриемник.ЕдИзмРодителя = СтрокаИсточник.ЕдИзмРодителя;
	СтрокаПриемник.КодПФИлиМатериала = СтрокаИсточник.КодПФИлиМатериала;
	СтрокаПриемник.НаименованиеПФИлиМатериала = СтрокаИсточник.НаименованиеПФИлиМатериала;
	СтрокаПриемник.ЕдИзм = СтрокаИсточник.ЕдИзм;
	СтрокаПриемник.Тип = СтрокаИсточник.Тип;
