Процедура ПодобратьИнтервалПланирования(НовыйЭтап)
	
	ТаблицаДокумента = НовыйЭтап.ВидыРабочихЦентров;
	ТаблицаПодбора = ТаблицаДокумента.Выгрузить(, "ВидРабочегоЦентра, ВремяРаботы, ЕдиницаИзмерения");
	Для Каждого Запись из ТаблицаПодбора Цикл
		Если Запись.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Минута Тогда
			Запись.ВремяРаботы =  Запись.ВремяРаботы * 60;
			Запись.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час; 
		ИначеЕсли Запись.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час Тогда 	
			Запись.ВремяРаботы =  Запись.ВремяРаботы * 60 * 60;
			Запись.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час;
		КонецЕсли;
	КонецЦикла;
	//ТаблицаПодбора.Свернуть("ВидРабочегоЦентра, ЕдиницаИзмерения","ВремяРаботы");
	//ТаблицаПодбора.Сортировать("ВремяРаботы Убыв");
	СуммарноеВремяРаботы = 0; 
	Для Каждого Запись из ТаблицаПодбора Цикл
	СуммарноеВремяРаботы = Запись.ВремяРаботы + СуммарноеВремяРаботы;	
	КонецЦикла;
	МаксимальноеВремя = СуммарноеВремяРаботы /60 /60;
	Если МаксимальноеВремя = Окр(МаксимальноеВремя, 0) Тогда
		НовыйЭтап.ДлительностьЭтапа = МаксимальноеВремя;
	ИначеЕсли МаксимальноеВремя < Окр(МаксимальноеВремя, 0) Тогда
		НовыйЭтап.ДлительностьЭтапа = Окр(МаксимальноеВремя, 0);
	Иначе
		НовыйЭтап.ДлительностьЭтапа = Окр(МаксимальноеВремя, 0) + 1;
	КонецЕсли;
	НовыйЭтап.ЕдиницаИзмеренияДлительностиЭтапа = Перечисления.ЕдиницыИзмеренияВремени.Час; 	
КонецПроцедуры

