	ЗаполняемаяСпецификация.ВариантПромежуточногоВыпуска = Перечисления.ВариантыПромежуточногоВыпуска.НеИспользуется;
	ЗаполняемаяСпецификация.ВыпускПроизвольнымиПорциями = Истина;
	ЗаполняемаяСпецификация.ДопустимоеПревышениеОптимальнойПартииВыпуска = 0;
	ЗаполняемаяСпецификация.МногоэтапныйПроизводственныйПроцесс = Ложь; 
	ВидНоменклатуры = ТекущаяСпецификация[0].Изделие.ВидНоменклатуры;
	ЗаполняемаяСпецификация.ОсновноеИзделиеВидНоменклатуры = ВидНоменклатуры; 
	Номенклатура = ТекущаяСпецификация[0].Изделие;
	ЗаполняемаяСпецификация.ОсновноеИзделиеНоменклатура = Номенклатура;
	Если ТекущаяСпецификация[0].ЕдИзмРодителя = "ТН" Тогда 
		ЗаполняемаяСпецификация.ОсновноеИзделиеКоличествоУпаковок = 1000;	
	Иначе 	
		ЗаполняемаяСпецификация.ОсновноеИзделиеКоличествоУпаковок = 1; 
	КонецЕсли; 
	//ЗаполняемаяСпецификация.ОсновноеИзделиеКоличествоУпаковок = 1;
	Если ТекущаяСпецификация[0].ЕдИзмРодителя = "ТН" Тогда 
		//ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("168");
		//Ключ = "168";
		ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("166");
		Ключ = "166";
		ИзделиеЕдИзм = ЕдИзмИзделие.Получить(Ключ); 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ИзделиеЕдИзм;
	ИначеЕсли ТекущаяСпецификация[0].ЕдИзмРодителя = "КМ" Тогда
		ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("008");
		Ключ = "008";
		ИзделиеЕдИзм = ЕдИзмИзделие.Получить(Ключ); 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ИзделиеЕдИзм;
	ИначеЕсли ТекущаяСпецификация[0].ЕдИзмРодителя = "КВМ" Тогда
		ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("055");
		Ключ = "055";
		ИзделиеЕдИзм = ЕдИзмИзделие.Получить(Ключ); 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ИзделиеЕдИзм;
	ИначеЕсли ТекущаяСпецификация[0].ЕдИзмРодителя = "КУБМ" Тогда
		ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("113");
		Ключ = "113";
		ИзделиеЕдИзм = ЕдИзмИзделие.Получить(Ключ); 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ИзделиеЕдИзм;	
	ИначеЕсли ТекущаяСпецификация[0].ЕдИзмРодителя = "ТШТ" Тогда
		ЕдИзмИзделие = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("798");
		Ключ = "798";
		ИзделиеЕдИзм = ЕдИзмИзделие.Получить(Ключ); 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ИзделиеЕдИзм;		
	Иначе 
		ЗаполняемаяСпецификация.ОсновноеИзделиеУпаковка = ТекущаяСпецификация[0].Изделие.ЕдиницаДляОтчетов;
	КонецЕсли;
	ЗаполняемаяСпецификация.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости; 
	ЗаполняемаяСпецификация.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
		
