&НаСервере 
Функция ПодборВладельцаВН(Наименование, Владелец)
	
	Если Наименование <> Владелец И Владелец <> "" Тогда 
		ЭлементВладелец = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Владелец);
	Иначе
		ЭлементВладелец = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ЭлементВладелец;
	
КонецФункции

&НаСервере 
Процедура  ПроверитьЭлементыВидыНоменклатуры()
	
	Для каждого СтрокаВидыНоменклатуры Из ПроверкиВидыНоменклатуры Цикл
		//ТекущийЭлементСправочника = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту(("Наименование", 
		//                                                                              СтрокаВидыНоменклатуры.Наименование);  
		ТекущийЭлементСправочника = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаВидыНоменклатуры.Наименование);
		ТекущийЭлементСправочника = ТекущийЭлементСправочника.ПолучитьОбъект();
			
		Если ТекущийЭлементСправочника.КоэффициентЕдиницыДляОтчетов = ""
			ИЛИ ТекущийЭлементСправочника.КоэффициентЕдиницыДляОтчетов = Неопределено Тогда  
			Если СтрокаВидыНоменклатуры.КоэффициентЕдиницыДляОтчетов <> "" Тогда
				ТекущийЭлементСправочника.КоэффициентЕдиницыДляОтчетов = СтрокаВидыНоменклатуры.КоэффициентЕдиницыДляОтчетов;
				СтрокаВидыНоменклатуры.Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
       		
		Если ТекущийЭлементСправочника.НаименованиеДляПечати = ""
			ИЛИ ТекущийЭлементСправочника.НаименованиеДляПечати = Неопределено Тогда  
			Если СтрокаВидыНоменклатуры.НаименованиеДляПечати <> "" Тогда
				ТекущийЭлементСправочника.НаименованиеДляПечати = СтрокаВидыНоменклатуры.НаименованиеДляПечати;
				СтрокаВидыНоменклатуры.Изменено = Истина;
			КонецЕсли;
		КонецЕсли;
			
		Если ТекущийЭлементСправочника.СтавкаНДС.Пустая() Тогда 
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СтрокаПоиска", СтрокаВидыНоменклатуры.СтавкаНДС);
		СтавкаНДС = Справочники.СтавкиНДС.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если СтавкаНДС.Количество() = 0 Тогда
			СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", Перечисления.СтавкиНДС.НДС20);
		Иначе                                                                        
			СтавкаНДС = СтавкаНДС[0].Значение;
		КонецЕсли;
       	ТекущийЭлементСправочника.СтавкаНДС = СтавкаНДС;
         СтрокаВидыНоменклатуры.Изменено = Истина;
        КонецЕсли;
		
		Если ТекущийЭлементСправочника.ОсобенностьУчета.Пустая() Тогда 
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СтрокаПоиска", СтрокаВидыНоменклатуры.ОсобенностьУчета);
		ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если ОсобенностьУчета.Количество() = 0 Тогда
			ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета;
		Иначе                                                                        
			ОсобенностьУчета = ОсобенностьУчета[0].Значение;
		КонецЕсли;
        ТекущийЭлементСправочника.ОсобенностьУчета = ОсобенностьУчета;
        СтрокаВидыНоменклатуры.Изменено = Истина;
		КонецЕсли;
				
		Если СтрокаВидыНоменклатуры.Изменено Тогда
			
			Попытка
				ТекущийЭлементСправочника.Записать();
			Исключение 
				СтрокаВидыНоменклатуры.Изменено = Ложь;
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменениеУсловногоОформленияВидыНоменклатуры();
			
КонецПроцедуры 

 &НаСервере 
Процедура ИзменениеУсловногоОформленияВидыНоменклатуры()

 	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиВидыНоменклатуры.Изменено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин); 
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиВидыНоменклатуры.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиВидыНоменклатуры.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры	

