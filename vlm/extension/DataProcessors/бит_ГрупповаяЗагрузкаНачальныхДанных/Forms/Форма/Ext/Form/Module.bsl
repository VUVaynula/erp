#Область СозданияБанковскихСчетовКонтрагентов

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникБанковскиеСчетаКонтрагентов(ПредставлениеИсточника) 
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникБанкК = ИсточникБанковскиеСчетаКонтрагентов.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточникБанкК.Владелец = ТекстКолонки;           
		СтрИсточникБанкК.НомерСчета = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточникБанкК.ТекстНазначения = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
	    СтрИсточникБанкК.ВалютаДенежныхСредств = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;	
		СтрИсточникБанкК.БИКБанка = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;
		СтрИсточникБанкК.НаименованиеБанка = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;
		СтрИсточникБанкК.КоррСчетБанка = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;
		СтрИсточникБанкК.ИДКлиента = ПредставлениеИсточника.Область(НомерСтроки, 41).Текст;
		
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникБанковскиеСчетаКонтрагентов.Удалить(СтрИсточникБанкК);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ДействияСТаблицамиБанковскиеСчетаКонтрагентов(ПредставлениеИсточника)

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникБанковскиеСчетаКонтрагентов.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникБанковскиеСчетаКонтрагентов(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда
		Элементы.СозданиеБанковскиеСчетаКонтрагентов.Видимость 	= Истина;
        Элементы.ПроверкиБанковскиеСчетаКонтрагентов.Видимость 	= Истина;
		Элементы.ОшибокБанковскиеСчетаКонтрагентов.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиБанковскиеСчетаКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыБанковскиеСчетаКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыБанковскиеСчетаКонтрагентов();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.БанковскиеСчетаКонтрагентов.ФормаСписка"); 
	ИначеЕсли ИдентификаторСостояния = "Состояние6" Тогда
		 ОбработатьОшибкиЭлементыТаблицыБанковскиеСчетаКонтрагентов();		
	Иначе
		Возврат;
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиБанковскиеСчетаКонтрагентов()
	
	УсловноеОформление.Элементы.Очистить();
	
	Для каждого СтрокаИсточникБанковскиеСчетаКонтрагентов Из ИсточникБанковскиеСчетаКонтрагентов Цикл     
		Если СтрокаИсточникБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств = "RUB" Тогда 
			СтрокаИсточникБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств = "руб.";   
		КонецЕсли;		
	КонецЦикла;  
	МассивВалют = ИсточникБанковскиеСчетаКонтрагентов.Выгрузить( , "ВалютаДенежныхСредств");
	МассивНомерСчета = ИсточникБанковскиеСчетаКонтрагентов.Выгрузить( , "НомерСчета");
	МассивБик = ИсточникБанковскиеСчетаКонтрагентов.Выгрузить( , "БИКБанка"); 
	МассивКонтрагентов = ИсточникБанковскиеСчетаКонтрагентов.Выгрузить( , "ИДКлиента");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлассификаторБанков.Ссылка КАК Ссылка,
	|	КлассификаторБанков.Код КАК Код,
	|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
	|ПОМЕСТИТЬ КлассификаторБаковБик
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.Код В(&МассивБик)
	|	И КлассификаторБанков.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлассификаторБанков.Ссылка КАК Ссылка,
	|	КлассификаторБанков.Код КАК Код,
	|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
	|ПОМЕСТИТЬ КлассификаторБаковСВИФТ
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.СВИФТБИК В(&МассивБик)
	|	И КлассификаторБанков.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КлассификаторБаковБик.Ссылка КАК Ссылка,
	|	КлассификаторБаковБик.Код КАК Код,
	|	КлассификаторБаковБик.СВИФТБИК КАК СВИФТБИК
	|ИЗ
	|	КлассификаторБаковБик КАК КлассификаторБаковБик
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КлассификаторБаковСВИФТ.Ссылка,
	|	КлассификаторБаковСВИФТ.Код,
	|	КлассификаторБаковСВИФТ.СВИФТБИК
	|ИЗ
	|	КлассификаторБаковСВИФТ КАК КлассификаторБаковСВИФТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка,
	|	Валюты.Код КАК Код,
	|	Валюты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Наименование В(&МассивВалют)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БанковскиеСчетаКонтрагентов.Ссылка КАК Ссылка1,
	|	БанковскиеСчетаКонтрагентов.НомерСчета КАК НомерСчета1
	|ИЗ
	|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|ГДЕ
	|	БанковскиеСчетаКонтрагентов.НомерСчета В(&МассивНомерСчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.бит_ИДКлиента КАК бит_ИДКлиента
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.бит_ИДКлиента В(&МассивКонтрагентов)";
	
	Запрос.УстановитьПараметр("МассивБик", МассивБик);
	Запрос.УстановитьПараметр("МассивВалют", МассивВалют);
	Запрос.УстановитьПараметр("МассивНомерСчета", МассивНомерСчета);
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаБик = РезультатЗапроса[2].Выгрузить();
	ВыборкаВалют = РезультатЗапроса[3].Выгрузить();
	ВыборкаНомерСчета = РезультатЗапроса[4].Выгрузить(); 
	ВыборкаКонтрагентов = РезультатЗапроса[5].Выгрузить(); 
	
	ЗаполнениеТаблицБанковскиеСчетаКонтрагентов(ВыборкаБик, ВыборкаВалют, ВыборкаНомерСчета, ВыборкаКонтрагентов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТаблицБанковскиеСчетаКонтрагентов(ВыборкаБик, ВыборкаВалют, ВыборкаНомерСчета, ВыборкаКонтрагентов)
    
	Для каждого СтрокаИсточникБанковскиеСчетаКонтрагентов Из ИсточникБанковскиеСчетаКонтрагентов Цикл 
		
		ТекстСообщения = ""; 
		
		ИдентификаторIBAN = ЕстьБуквыВСтроке(СтрокаИсточникБанковскиеСчетаКонтрагентов.НомерСчета);
		Если НЕ ИдентификаторIBAN Тогда
		ИдентификаторБик = ВыборкаБик.Найти(СтрокаИсточникБанковскиеСчетаКонтрагентов.БИКБанка);
		Если ИдентификаторБик = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Банк не найден! ";
		КонецЕсли;
		КонецЕсли;
		
		ИдентификаторВалюта = ВыборкаВалют.Найти(СтрокаИсточникБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		Если ИдентификаторВалюта = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Валюта не найдена! ";
		КонецЕсли;
		
		ИдентификаторКонтрагента = ВыборкаКонтрагентов.Найти(СтрокаИсточникБанковскиеСчетаКонтрагентов.ИДКлиента);
		Если ИдентификаторКонтрагента = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Контрагент по ID не найден! ";
		КонецЕсли;
		
		Если СтрокаИсточникБанковскиеСчетаКонтрагентов.НомерСчета = "" ИЛИ 
			СтрокаИсточникБанковскиеСчетаКонтрагентов.НомерСчета = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Номер счета не указан! ";
		КонецЕсли;
			
		СтрокаНомерСчета = ВыборкаНомерСчета.Найти(СтрокаИсточникБанковскиеСчетаКонтрагентов.НомерСчета);
		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокБанковскиеСчетаКонтрагентов = ОшибокБанковскиеСчетаКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаКонтрагентов(СтрокаОшибокБанковскиеСчетаКонтрагентов, 
			СтрокаИсточникБанковскиеСчетаКонтрагентов);
			СтрокаОшибокБанковскиеСчетаКонтрагентов.Ошибка = ТекстСообщения;
		ИначеЕсли СтрокаНомерСчета = Неопределено Тогда
			СтрокаСозданиеБанковскиеСчетаКонтрагентов = СозданиеБанковскиеСчетаКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаКонтрагентов(СтрокаСозданиеБанковскиеСчетаКонтрагентов,
			СтрокаИсточникБанковскиеСчетаКонтрагентов);
		Иначе 
			СтрокаПроверкиБанковскиеСчетаКонтрагентов = ПроверкиБанковскиеСчетаКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаКонтрагентов(СтрокаПроверкиБанковскиеСчетаКонтрагентов, 
			СтрокаИсточникБанковскиеСчетаКонтрагентов);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры	

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаКонтрагентов(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.Владелец = СтрокаИсточник.Владелец; 
	СтрокаПриемник.НомерСчета = СтрокаИсточник.НомерСчета;
	СтрокаПриемник.ТекстНазначения = СтрокаИсточник.ТекстНазначения;
	СтрокаПриемник.ВалютаДенежныхСредств = СтрокаИсточник.ВалютаДенежныхСредств;
	СтрокаПриемник.БИКБанка = СтрокаИсточник.БИКБанка;
	СтрокаПриемник.НаименованиеБанка = СтрокаИсточник.НаименованиеБанка;   
	СтрокаПриемник.КоррСчетБанка = СтрокаИсточник.КоррСчетБанка; 
	СтрокаПриемник.ИДКлиента = СтрокаИсточник.ИДКлиента;
	
КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементыТаблицыБанковскиеСчетаКонтрагентов()
	
	Для каждого СтрокаБанковскиеСчетаКонтрагентов Из  СозданиеБанковскиеСчетаКонтрагентов Цикл
		
		БанковскийСчетаКонтрагентов = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
		БанковскийСчетаКонтрагентов.Владелец = Справочники.Контрагенты.НайтиПоРеквизиту("бит_ИДКлиента",
		                                                   СтрокаБанковскиеСчетаКонтрагентов.ИДКлиента); 
		НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.НомерСчета), " ", ""), ".", ""));
		БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
        БанковскийСчетаКонтрагентов.ТекстНазначения = СтрокаБанковскиеСчетаКонтрагентов.ТекстНазначения; 
		БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств = 
		Справочники.Валюты.НайтиПоНаименованию(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		
		Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			БанковскийСчетаКонтрагентов.ИностранныйБанк = Истина;
			Если Сред(НомерСчета, 1, 4) = "IBAN" Тогда
				НомерСчета = Сред(НомерСчета, 5);
				БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
			КонецЕсли;
			Если ДенежныеСредстваКлиентСервер.ПравильнаяДлинаIBAN(НомерСчета) Тогда
				БанковскийСчетаКонтрагентов.ЭтоIBAN = Истина;
				ОпределитьСтрануИБанкПоIBAN(БанковскийСчетаКонтрагентов);  
				БанковскийСчетаКонтрагентов.РучноеИзменениеРеквизитовБанка = Истина;
			КонецЕсли;
		Иначе
			
			Банк = Справочники.КлассификаторБанков.НайтиПоКоду(СтрокаБанковскиеСчетаКонтрагентов.БИКБанка);
			
			Если Банк = Неопределено Тогда
				Банк = Справочники.КлассификаторБанков.НайтиПоРеквизиту("СВИФТБИК", СтрокаБанковскиеСчетаКонтрагентов.БИКБанка);
			КонецЕсли;
			
			СоответствиеРеквизитовБанка = УстановитьСоответствиеРеквизитовБанка();
			СтруктураРеквизитов = Новый Структура;
			ИменаРеквизитов = СтрРазделить(РеквизитыБанка(), ",", Ложь);
			
			Для каждого ИмяРеквизита Из ИменаРеквизитов Цикл
				СтруктураРеквизитов.Вставить(ИмяРеквизита, СоответствиеРеквизитовБанка[СокрЛП(ИмяРеквизита)]);
			КонецЦикла;
			
			СтруктураРеквизитов.Вставить("БИКБанка", "Код");
			СтруктураРеквизитов.Вставить("СВИФТБанка", "СВИФТБИК");
			СтруктураРеквизитов.Вставить("НаименованиеБанкаМеждународное", "МеждународноеНаименование");
			РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, СтруктураРеквизитов);
			ЗаполнитьЗначенияСвойств(БанковскийСчетаКонтрагентов, РеквизитыБанка);
			
			БанковскийСчетаКонтрагентов.Банк = Банк; 
		КонецЕсли;  
		Если БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств.Пустая() Тогда
			БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств = Справочники.Валюты.ПолучитьВалютуПоУмолчанию();
		КонецЕсли;
		ШаблонНаименования = НСтр("ru = '%1, (%2)'; |en = '%1, %2'");  
		ВалютаДС = СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), ВалютаДС); 
		БанковскийСчетаКонтрагентов.Наименование = СтрокаНаименования;
		
		Попытка	
			БанковскийСчетаКонтрагентов.Записать();
			СтрокаБанковскиеСчетаКонтрагентов.Создано = Истина;
		Исключение
			СтрокаБанковскиеСчетаКонтрагентов.Создано = Ложь;
		КонецПопытки;	
		
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеБанковскиеСчетаКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеБанковскиеСчетаКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.СозданиеБанковскиеСчетаКонтрагентов.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ПроверитьЭлементыТаблицыБанковскиеСчетаКонтрагентов()
	
	Для каждого СтрокаБанковскиеСчетаКонтрагентов Из ПроверкиБанковскиеСчетаКонтрагентов Цикл 
		
		НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.НомерСчета), " ", ""), ".", "")); 
		Владелец = Справочники.Контрагенты.НайтиПоРеквизиту("бит_ИДКлиента",
		                                                   СтрокаБанковскиеСчетаКонтрагентов.ИДКлиента);
		ТекущийЭлементСправочника = Справочники.БанковскиеСчетаКонтрагентов.НайтиПоРеквизиту("НомерСчета", НомерСчета,,Владелец);
		Попытка
		ТекущийЭлементСправочника = ТекущийЭлементСправочника.ПолучитьОбъект();
						
		Если (ТекущийЭлементСправочника.ТекстНазначения = Неопределено ИЛИ ТекущийЭлементСправочника.ТекстНазначения = "") И 
			СтрокаБанковскиеСчетаКонтрагентов.ТекстНазначения <> "" Тогда
			ТекущийЭлементСправочника.ТекстНазначения = СтрокаБанковскиеСчетаКонтрагентов.ТекстНазначения;
			СтрокаБанковскиеСчетаКонтрагентов.Изменено = Истина;
		КонецЕсли;

		Если ТекущийЭлементСправочника.ВалютаДенежныхСредств = Неопределено 
		 ИЛИ ТекущийЭлементСправочника.ВалютаДенежныхСредств.Пустая() Тогда
			ТекущийЭлементСправочника.ВалютаДенежныхСредств = 
			                     Справочники.Валюты.НайтиПоНаименованию(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
			СтрокаБанковскиеСчетаКонтрагентов.Изменено = Истина;
		КонецЕсли; 
		
		Если ТекущийЭлементСправочника.ПометкаУдаления = Истина Тогда
			 ТекущийЭлементСправочника.ПометкаУдаления = Ложь;
			 СтрокаБанковскиеСчетаКонтрагентов.Изменено = Истина;
		КонецЕсли;	 
		
		Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			ТекущийЭлементСправочника.ИностранныйБанк = Истина;
			Если Сред(НомерСчета, 1, 4) = "IBAN" Тогда
				НомерСчета = Сред(НомерСчета, 5);
				ТекущийЭлементСправочника.НомерСчета = НомерСчета;
			КонецЕсли;
			Если ДенежныеСредстваКлиентСервер.ПравильнаяДлинаIBAN(НомерСчета) Тогда
				ТекущийЭлементСправочника.ЭтоIBAN = Истина;
				ОпределитьСтрануИБанкПоIBAN(ТекущийЭлементСправочника);  
				ТекущийЭлементСправочника.РучноеИзменениеРеквизитовБанка = Истина;
			КонецЕсли;
			СтрокаБанковскиеСчетаКонтрагентов.Изменено = Истина;
		Иначе	
		ОбработкаДанныхБанка(ТекущийЭлементСправочника, СтрокаБанковскиеСчетаКонтрагентов);
		КонецЕсли;
		ШаблонНаименования = НСтр("ru = '%1, (%2)'; |en = '%1, %2'");  
		ВалютаДС = СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), ВалютаДС); 
		Если ТекущийЭлементСправочника.Наименование <>  СтрокаНаименования Тогда
			 ТекущийЭлементСправочника.Наименование = СтрокаНаименования;
			 СтрокаБанковскиеСчетаКонтрагентов.Изменено = Истина;
		КонецЕсли;
						
		Если СтрокаБанковскиеСчетаКонтрагентов.Изменено Тогда
			
			Попытка
				ТекущийЭлементСправочника.Записать();
			Исключение 
				СтрокаБанковскиеСчетаКонтрагентов.Изменено = Ложь;
			КонецПопытки;
		КонецЕсли;
		Исключение
		КонецПопытки
	КонецЦикла;
	
    ИзменениеУсловногоОформленияПроверкиБанковскиеСчетаКонтрагентов();
	
КонецПроцедуры 

&НаСервере 
Процедура ОбработатьОшибкиЭлементыТаблицыБанковскиеСчетаКонтрагентов();
	
	  Для каждого СтрокаБанковскиеСчетаКонтрагентов Из  ОшибокБанковскиеСчетаКонтрагентов Цикл
		  ОшибкаВалют = СтрНайти(СтрокаБанковскиеСчетаКонтрагентов.Ошибка, "Валюта не найдена!");
		  ОшибкаКонтрагент = СтрНайти(СтрокаБанковскиеСчетаКонтрагентов.Ошибка, "Контрагент по ID не найден!");
		  ОшибкаНомер = СтрНайти(СтрокаБанковскиеСчетаКонтрагентов.Ошибка,"Номер счета не указан!");
		  Если ОшибкаКонтрагент <> 0 
			  ИЛИ  ОшибкаВалют <> 0 
	          ИЛИ  ОшибкаНомер <> 0 Тогда
			  Продолжить;
		  КонецЕсли;
		  
		  БанковскийСчетаКонтрагентов = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
		  БанковскийСчетаКонтрагентов.Владелец = Справочники.Контрагенты.НайтиПоРеквизиту("бит_ИДКлиента",
		  СтрокаБанковскиеСчетаКонтрагентов.ИДКлиента); 
		  НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.НомерСчета), " ", ""), ".", ""));
		  БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
		  БанковскийСчетаКонтрагентов.ТекстНазначения = СтрокаБанковскиеСчетаКонтрагентов.ТекстНазначения; 
		  БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств = 
		  Справочники.Валюты.НайтиПоНаименованию(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		  
		  Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			  БанковскийСчетаКонтрагентов.ИностранныйБанк = Истина;
			  Если Сред(НомерСчета, 1, 4) = "IBAN" Тогда
				  НомерСчета = Сред(НомерСчета, 5);
				  БанковскийСчетаКонтрагентов.НомерСчета = НомерСчета;
			  КонецЕсли;
			  Если ДенежныеСредстваКлиентСервер.ПравильнаяДлинаIBAN(НомерСчета) Тогда
				  БанковскийСчетаКонтрагентов.ЭтоIBAN = Истина;
				  ОпределитьСтрануИБанкПоIBAN(БанковскийСчетаКонтрагентов);  
				  БанковскийСчетаКонтрагентов.РучноеИзменениеРеквизитовБанка = Истина;
			  КонецЕсли;
			  БанковскийСчетаКонтрагентов.Банк = Справочники.КлассификаторБанков.ПустаяСсылка();
		  КонецЕсли;
		  
		  Если БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств.Пустая() Тогда
			БанковскийСчетаКонтрагентов.ВалютаДенежныхСредств = Справочники.Валюты.ПолучитьВалютуПоУмолчанию();
		КонецЕсли;
		ШаблонНаименования = НСтр("ru = '%1, (%2)'; |en = '%1, %2'");  
		ВалютаДС = СокрЛП(СтрокаБанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), ВалютаДС); 
		БанковскийСчетаКонтрагентов.Наименование = СтрокаНаименования;
		
		Попытка	
			БанковскийСчетаКонтрагентов.Записать();
			СтрокаБанковскиеСчетаКонтрагентов.Обработано = Истина;
		Исключение
			СтрокаБанковскиеСчетаКонтрагентов.Обработано = Ложь;
		КонецПопытки;	
		
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОшибокБанковскиеСчетаКонтрагентов.Обработано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОшибокБанковскиеСчетаКонтрагентов.Обработано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.ОшибокБанковскиеСчетаКонтрагентов.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры

 &НаСервере 
Процедура ИзменениеУсловногоОформленияПроверкиБанковскиеСчетаКонтрагентов()

   	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиБанковскиеСчетаКонтрагентов.Изменено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин); 
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиБанковскиеСчетаКонтрагентов.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиБанковскиеСчетаКонтрагентов.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры	
#КонецОбласти

#Область СозданияДоговоровКонтрагентов

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникДоговорыКонтрагентов(ПредставлениеИсточника) 
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникДоговорыК = ИсточникДоговорыКонтрагентов.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточникДоговорыК.Наименование = ТекстКолонки;                           
		СтрИсточникДоговорыК.БанковскийСчет = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;
		СтрИсточникДоговорыК.БанковскийСчетКонтрагента = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточникДоговорыК.ВалютаВзаиморасчетов = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточникДоговорыК.Комментарий = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		ДатаНачалаДействия = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст; 
		ДатаНачалаДействия = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДатаНачалаДействия);
		СтрИсточникДоговорыК.ДатаНачалаДействия = ДатаНачалаДействия; 
		ДатаОкончанияДействия = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;  
		ДатаОкончанияДействия = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДатаОкончанияДействия);
		СтрИсточникДоговорыК.ДатаОкончанияДействия = ДатаОкончанияДействия;
		СтрИсточникДоговорыК.Организация = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
		СтрИсточникДоговорыК.ИННОрганизации = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;
		СтрИсточникДоговорыК.Контрагент = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;
		СтрИсточникДоговорыК.ИННКонтрагента = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;
		СтрИсточникДоговорыК.КППКонтрагента = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;
		СтрИсточникДоговорыК.Менеджер = ПредставлениеИсточника.Область(НомерСтроки, 13).Текст;
		СтрИсточникДоговорыК.НаименованиеДляПечати = ПредставлениеИсточника.Область(НомерСтроки, 14).Текст;
		СтрИсточникДоговорыК.Номер = ПредставлениеИсточника.Область(НомерСтроки, 18).Текст;
		СтрИсточникДоговорыК.ТипДоговора = ПредставлениеИсточника.Область(НомерСтроки, 24).Текст;
		СтрИсточникДоговорыК.КонтактноеЛицо = ПредставлениеИсточника.Область(НомерСтроки, 30).Текст;
		СтрИсточникДоговорыК.Сумма = ПредставлениеИсточника.Область(НомерСтроки, 35).Текст;
		СтрИсточникДоговорыК.Назначение = ПредставлениеИсточника.Область(НомерСтроки, 57).Текст;
		СтрИсточникДоговорыК.ИДКлиента = ПредставлениеИсточника.Область(НомерСтроки, 104).Текст;
			
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникДоговорыКонтрагентов.Удалить(СтрИсточникДоговорыК);
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте 
Процедура ДействияСТаблицамиДоговорыКонтрагентов(ПредставлениеИсточника)  
	
	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникДоговорыКонтрагентов.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникДоговорыКонтрагентов(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда
		Элементы.СозданиеДоговорыКонтрагентов.Видимость 		= Истина;
		Элементы.ПроверкиДоговорыКонтрагентов.Видимость 		= Истина;
        Элементы.ОшибокДоговорыКонтрагентов.Видимость 			= Истина;
        ЗаполнитьТаблицыПроверкиДоговорыКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыДоговорыКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыДоговорыКонтрагентов();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаСписка");
	ИначеЕсли ИдентификаторСостояния = "Состояние6" Тогда
		 ОбработатьОшибкиЭлементыТаблицыДоговорыКонтрагентов();	
	Иначе	
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиДоговорыКонтрагентов()
	
	УсловноеОформление.Элементы.Очистить();
	
	Для каждого СтрокаИсточникДоговорыКонтрагентов Из ИсточникДоговорыКонтрагентов Цикл     
		Если СтрокаИсточникДоговорыКонтрагентов.ВалютаВзаиморасчетов = "RUB" Тогда 
			 СтрокаИсточникДоговорыКонтрагентов.ВалютаВзаиморасчетов = "руб.";   
		КонецЕсли;		
	КонецЦикла; 
	
	МассивНомеровДоговоров = ИсточникДоговорыКонтрагентов.Выгрузить( , "Номер");
	МассивДатаНачалаДействия = ИсточникДоговорыКонтрагентов.Выгрузить( , "ДатаНачалаДействия");
	//МассивИННКонтрагентов = ИсточникДоговорыКонтрагентов.Выгрузить( , "ИННКонтрагента");
	//МассивКППКонтрагентов = ИсточникДоговорыКонтрагентов.Выгрузить( , "КППКонтрагента");
	МассивИДКонтрагентов = ИсточникДоговорыКонтрагентов.Выгрузить( , "ИДКлиента");
	МассивВалют = ИсточникДоговорыКонтрагентов.Выгрузить( , "ВалютаВзаиморасчетов");
	МассивБанковскийСчет = ИсточникДоговорыКонтрагентов.Выгрузить( , "БанковскийСчет"); 
	МассивБанковскийКонтрагента = ИсточникДоговорыКонтрагентов.Выгрузить( , "БанковскийСчетКонтрагента"); 
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка,
	|	Валюты.Код КАК Код,
	|	Валюты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Наименование В(&МассивВалют)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БанковскиеСчетаОрганизаций.Ссылка КАК Ссылка,
	|	БанковскиеСчетаОрганизаций.НомерСчета КАК НомерСчета
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|ГДЕ
	|	БанковскиеСчетаОрганизаций.НомерСчета В(&МассивБанковскийСчет)
	|	И БанковскиеСчетаОрганизаций.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БанковскиеСчетаКонтрагентов.Ссылка КАК Ссылка,
	|	БанковскиеСчетаКонтрагентов.НомерСчета КАК НомерСчета
	|ИЗ
	|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|ГДЕ
	|	БанковскиеСчетаКонтрагентов.НомерСчета В(&МассивБанковскийКонтрагента)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.Наименование КАК Наименование,
	|	ДоговорыКонтрагентов.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДоговорыКонтрагентов.Номер КАК Номер
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ДатаНачалаДействия В(&МассивДатаНачалаДействия)
	|	И ДоговорыКонтрагентов.Номер В(&МассивНомеровДоговоров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	Контрагенты.бит_ИДКлиента КАК бит_ИДКлиента
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.бит_ИДКлиента В(&МассивИДКонтрагентов)";
	
	Запрос.УстановитьПараметр("МассивВалют", МассивВалют);
	Запрос.УстановитьПараметр("МассивБанковскийСчет", МассивБанковскийСчет);
    Запрос.УстановитьПараметр("МассивБанковскийКонтрагента", МассивБанковскийКонтрагента);
	Запрос.УстановитьПараметр("МассивДатаНачалаДействия", МассивДатаНачалаДействия);
	Запрос.УстановитьПараметр("МассивНомеровДоговоров", МассивНомеровДоговоров); 
	//Запрос.УстановитьПараметр("МассивИННКонтрагентов", МассивИННКонтрагентов);
	//Запрос.УстановитьПараметр("МассивКППКонтрагентов", МассивКППКонтрагентов);
    Запрос.УстановитьПараметр("МассивИДКонтрагентов", МассивИДКонтрагентов);
    РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаВалют = РезультатЗапроса[0].Выгрузить();
	ВыборкаБанковскиеСчетаОрганизаций = РезультатЗапроса[1].Выгрузить();
	ВыборкаБанковскиеСчетаКонтрагентов = РезультатЗапроса[2].Выгрузить(); 
	ВыборкаДоговоры = РезультатЗапроса[3].Выгрузить();
	ВыборкаКонтрагентов = РезультатЗапроса[4].Выгрузить();
	
	Для каждого СтрокаИсточникДоговорыКонтрагентов Из ИсточникДоговорыКонтрагентов Цикл  
		
		ТекстСообщения = ""; 
		
		ВыборкаСтруктура = Новый Структура;
		ВыборкаСтруктура.Вставить("ВыборкаВалют", ВыборкаВалют);
		ВыборкаСтруктура.Вставить("ВыборкаБанковскиеСчетаОрганизаций", ВыборкаБанковскиеСчетаОрганизаций);
		ВыборкаСтруктура.Вставить("ВыборкаКонтрагентов", ВыборкаКонтрагентов);
		ВыборкаСтруктура.Вставить("ВыборкаБанковскиеСчетаКонтрагентов", ВыборкаБанковскиеСчетаКонтрагентов);
		
		ИнициализацияОшибокДК(ТекстСообщения, СтрокаИсточникДоговорыКонтрагентов, ВыборкаСтруктура);
				
		Отбор = Новый Структура();
        Отбор.Вставить("Номер", СтрокаИсточникДоговорыКонтрагентов.Номер); 
		Отбор.Вставить("ДатаНачалаДействия", СтрокаИсточникДоговорыКонтрагентов.ДатаНачалаДействия); 
		СтрокаДоговоры = ВыборкаДоговоры.НайтиСтроки(Отбор);
		Если ТекстСообщения <> "" Тогда       
			СтрокаОшибокДоговорыКонтрагентов = ОшибокДоговорыКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыДоговорыКонтрагентов(СтрокаОшибокДоговорыКонтрагентов, 
													    СтрокаИсточникДоговорыКонтрагентов);
			СтрокаОшибокДоговорыКонтрагентов.Ошибка = ТекстСообщения;
		ИначеЕсли СтрокаДоговоры.Количество() > 0 Тогда
			СтрокаПроверкиДоговорыКонтрагентов = ПроверкиДоговорыКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыДоговорыКонтрагентов(СтрокаПроверкиДоговорыКонтрагентов, 
														СтрокаИсточникДоговорыКонтрагентов);
		Иначе
			СтрокаСозданиеДоговорыКонтрагентов = СозданиеДоговорыКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыДоговорыКонтрагентов(СтрокаСозданиеДоговорыКонтрагентов,
														СтрокаИсточникДоговорыКонтрагентов);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры 

&НаСервере 
