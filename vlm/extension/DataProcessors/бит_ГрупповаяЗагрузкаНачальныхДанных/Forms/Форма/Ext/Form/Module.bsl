	МассивИНН = ИсточникПартнеры.Выгрузить( , "ИНН");
	МассивКПП = ИсточникПартнеры.Выгрузить( , "КПП");
	МассивНаименований = ИсточникПартнеры.Выгрузить( , "Наименование");
	МассивИД = ИсточникПартнеры.Выгрузить( , "ИДКлиента");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	Запрос = Новый Запрос;
