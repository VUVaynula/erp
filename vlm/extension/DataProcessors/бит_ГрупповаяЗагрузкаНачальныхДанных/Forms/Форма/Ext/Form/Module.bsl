		ЗаполняемаяСпецификация.Записать(); 
		ЗаполнениеСпецификацийВВерхгнуровневыхСпецификациях(ЗаполняемаяСпецификация);
		ЗаполниитьРезультатЗаписи(ТекущаяСпецификация.Значение, ЗаполняемаяСпецификация);
		//Исключение
		//	СтрокаСпецификации.Создано = Ложь;
		//КонецПопытки; 
	КонецЦикла;  
	
	СозданиеСпецификации.Очистить();
	
	Для Каждого ТекущаяСпецификация из ПерегруппированныеСпецификации Цикл
		ТекущаяСпецификация = ТекущаяСпецификация.Значение;
		Если ТекущаяСпецификация[0].ИдРодителя = "-1" Тогда
			 СсылкаНаСпецификацию = ТекущаяСпецификация[0].СсылкаСпецификация;
		     ПрисвоениеПризнаковАгрКоэффициент(СсылкаНаСпецификацию); 
			 Прервать;
		 КонецЕсли;
	КонецЦикла;	 
		
	Для каждого ТекущаяСпецификация Из ПерегруппированныеСпецификации Цикл
		ВыводРезультатаСоздания(ТекущаяСпецификация); 
	КонецЦикла;
	
	ИзменениеУсловногоОформленияСозданияСпецификации();

