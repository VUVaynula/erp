&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВызовИзФормы = Параметры.Свойство("ОбъектыНазначения");
	Если ВызовИзФормы Тогда
		Если ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.БанковскиеСчетаКонтрагентов") Тогда
			Объект.ИдентификаторСправочника = "БанковскиеСчетаКонтрагентов";  
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.БанковскиеСчетаОрганизаций") Тогда 
			Объект.ИдентификаторСправочника = "БанковскиеСчетаОрганизаций";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.Контрагенты") Тогда 
			Объект.ИдентификаторСправочника = "Контрагенты";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.Партнеры") Тогда   
			Объект.ИдентификаторСправочника = "Партнеры";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда 
			Объект.ИдентификаторСправочника = "ДоговорыКонтрагентов"; 
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда 
			Объект.ИдентификаторСправочника = "ВидыНоменклатуры"; 	
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.Номенклатура") Тогда 
			Объект.ИдентификаторСправочника = "Номенклатура";	
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.КлассификаторБанков") Тогда 
			Объект.ИдентификаторСправочника = "Банки";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("ПланВидовХарактеристикСсылка.бит_ПризнакиНоменклатуры") Тогда 
			Объект.ИдентификаторСправочника = "ПризнакиНоменклатуры";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("ПланВидовХарактеристикСсылка.бит_ПризнакиКонтрагентов") Тогда 
			Объект.ИдентификаторСправочника = "АтрибутыКонтрагентов";	
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.ВидыРабочихЦентров") Тогда 
			Объект.ИдентификаторСправочника = "ВидыРабочихЦентров";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.РабочиеЦентры") Тогда 
			Объект.ИдентификаторСправочника = "РабочиеЦентры";
		ИначеЕсли ТипЗнч(Параметры.ОбъектыНазначения[0]) = Тип("СправочникСсылка.РесурсныеСпецификации") Тогда                    
			Объект.ИдентификаторСправочника = "Спецификации";
		Иначе    
			Объект.ИдентификаторСправочника = ""; 
		КонецЕсли;
	Иначе 
		Объект.ИдентификаторСправочника = ""; 
	КонецЕсли;
	
	Дата = ТекущаяДатаСеанса();
	
КонецПроцедуры

