	Элементы.ЭтапыЗагрузки.ТекущаяСтраница = Элементы.ЭтапыЗагрузки.ПодчиненныеЭлементы.Завершение;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.Создаваемые Тогда 
		Элементы.СозданиеЗагрузить.Видимость 		 = Истина;
		Элементы.СозданиеПроверить.Видимость 		 = Ложь; 
		Элементы.СозданиеВсеРавноЗагрузить.Видимость = Ложь;

		Если ПроверкаНаличияЗаписейСоздания() Тогда
			Элементы.СозданиеЗагрузить.Доступность = Истина;
		Иначе 
			Элементы.СозданиеЗагрузить.Доступность = Ложь;
		КонецЕсли;	
		
		Элементы.СозданиеПроверить.Доступность = Ложь;		
		
	ИначеЕсли ТекущаяСтраница = Элементы.Провяемые Тогда 
		Элементы.СозданиеЗагрузить.Видимость 		 = Ложь;
		Элементы.СозданиеПроверить.Видимость 		 = Истина;
		Элементы.СозданиеЗагрузить.Доступность		 = Ложь;
		Элементы.СозданиеВсеРавноЗагрузить.Видимость = Ложь;
		
		Если ПроверкаНаличияЗаписейПроверки() Тогда 
			Элементы.СозданиеПроверить.Доступность = Истина;
		Иначе 
			Элементы.СозданиеПроверить.Доступность = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраница = Элементы.Ошибки Тогда
		
		Если ОшибокБанковскиеСчетаКонтрагентов.Количество() > 0 
			Или ОшибокДоговорыКонтрагентов.Количество() > 0 Тогда
			    Элементы.СозданиеЗагрузить.Видимость 		 	= Ложь;
		        Элементы.СозданиеПроверить.Видимость 			= Ложь;
			    Элементы.СозданиеВсеРавноЗагрузить.Видимость 	= Истина;
				Элементы.СозданиеВсеРавноЗагрузить.Доступность	= Истина; 
			Иначе
				
				Элементы.СозданиеВсеРавноЗагрузить.Видимость = Ложь;
				Элементы.СозданиеВсеРавноЗагрузить.Доступность = Ложь; 
		КонецЕсли;	
		
		 Элементы.СозданиеЗагрузить.Видимость 		 	= Ложь;
		 Элементы.СозданиеПроверить.Видимость 			= Ложь;

	Иначе
		
		Элементы.СозданиеЗагрузить.Видимость = Ложь;
		Элементы.СозданиеПроверить.Видимость = Ложь;
		Элементы.СозданиеЗагрузить.Доступность = Ложь;
		Элементы.СозданиеПроверить.Доступность = Ложь;		
		Элементы.СозданиеВсеРавноЗагрузить.Видимость = Ложь;
		Элементы.СозданиеВсеРавноЗагрузить.Доступность = Ложь;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаНаличияЗаписейСоздания()
	
	ДоступностьСоздания1 = Ложь;
	ДоступностьСоздания2 = Ложь;
	ДоступностьСоздания3 = Ложь; 
	ДоступностьСоздания4 = Ложь;
	ДоступностьСоздания5 = Ложь;  
	
	Если СозданиеБанковскиеСчетаКонтрагентов.Количество() > 0 
		ИЛИ СозданиеБанковскиеСчетаОрганизаций.Количество() > 0 Тогда
		ДоступностьСоздания1 = Истина;
	ИначеЕсли СозданиеДоговорыКонтрагентов.Количество() > 0 
		ИЛИ  СозданиеПартнеры.Количество() > 0 
		ИЛИ СозданиеАтрибутыКонтрагентов.Количество() > 0 Тогда
		ДоступностьСоздания2 = Истина; 
	ИначеЕсли СозданиеВидыНоменклатуры.Количество() > 0 
		ИЛИ СозданиеНоменклатура.Количество() > 0
		ИЛИ СозданиеПризнакиНоменклатуры.Количество() > 0 Тогда
		ДоступностьСоздания3 = Истина; 
	ИначеЕсли СозданиеБанки.Количество() > 0 Тогда
		ДоступностьСоздания4 = Истина;
	ИначеЕсли СозданиеВидыРабочихЦентров.Количество() > 0 
		ИЛИ СозданиеРабочиеЦентры.Количество() > 0
		ИЛИ СозданиеСпецификации.Количество() > 0 
		ИЛИ СозданиеОходыСпецификаций.Количество() > 0 Тогда
		ДоступностьСоздания5 = Истина;	
	Иначе ДоступностьСоздания = Ложь;
		  ДоступностьСоздания1 = Ложь;
		  ДоступностьСоздания2 = Ложь;
		  ДоступностьСоздания3 = Ложь;
		  ДоступностьСоздания4 = Ложь;
		  ДоступностьСоздания5 = Ложь;
	КонецЕсли;
	
	Если ДоступностьСоздания1 
		ИЛИ ДоступностьСоздания2 
		ИЛИ ДоступностьСоздания3 
		ИЛИ ДоступностьСоздания4  
		ИЛИ ДоступностьСоздания5 Тогда
		 ДоступностьСоздания = Истина;
	 Иначе
		 ДоступностьСоздания = Ложь;
	  КонецЕсли;
	 
	Возврат ДоступностьСоздания;
	
КонецФункции    

&НаКлиенте
Функция ПроверкаНаличияЗаписейПроверки()
	
	ДоступностьПроверки1 = Ложь;
	ДоступностьПроверки2 = Ложь;
	ДоступностьПроверки3 = Ложь;
	ДоступностьПроверки4 = Ложь;
	
	Если ПроверкиБанковскиеСчетаКонтрагентов.Количество() > 0 
		ИЛИ ПроверкиБанковскиеСчетаОрганизаций.Количество() > 0 Тогда
		ДоступностьПроверки1 = Истина;
	ИначеЕсли ПроверкиДоговорыКонтрагентов.Количество() > 0 
		ИЛИ  ПроверкиПартнеры.Количество() > 0 
		ИЛИ  ПроверкиАтрибутыКонтрагентов.Количество() > 0 Тогда
		ДоступностьПроверки2 = Истина;
	ИначеЕсли ПроверкиВидыНоменклатуры.Количество() > 0 
		ИЛИ ПроверкиНоменклатура.Количество() > 0 
		ИЛИ ПроверкиПризнакиНоменклатуры.Количество() > 0 Тогда
		ДоступностьПроверки3 = Истина;	
	ИначеЕсли ПроверкиВидыРабочихЦентров.Количество() > 0 
		//ИЛИ ПроверкиСпецификации.Количество() > 0
		//ИЛИ ПроверкиОходыСпецификаций.Количество() > 0
		ИЛИ ПроверкиРабочиеЦентры.Количество() > 0 Тогда
		ДоступностьПроверки4 = Истина;	
	Иначе ДоступностьПроверки = Ложь;
		  ДоступностьПроверки1 = Ложь;
		  ДоступностьПроверки2 = Ложь;
		  ДоступностьПроверки3 = Ложь;
		  ДоступностьПроверки4 = Ложь;
	КонецЕсли;
	
	Если ДоступностьПроверки1 
		ИЛИ ДоступностьПроверки2
		ИЛИ ДоступностьПроверки3
		ИЛИ ДоступностьПроверки4 Тогда
		 ДоступностьПроверки = Истина;
	 Иначе
		 ДоступностьПроверки = Ложь;
	 КонецЕсли;
	
	Возврат ДоступностьПроверки;
    
КонецФункции 

