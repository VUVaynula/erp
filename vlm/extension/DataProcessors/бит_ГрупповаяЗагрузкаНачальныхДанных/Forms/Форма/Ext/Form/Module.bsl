	СтрокаПриемник.ОсобенностьУчета = СтрокаИсточник.ОсобенностьУчета;
	СтрокаПриемник.ШаблонЭтикетки = СтрокаИсточник.ШаблонЭтикетки;
	
КонецПроцедуры	

&НаСервере 
Процедура СоздатьЭлементыНоменклатура()
	 
	Для каждого СтрокаНоменклатуры Из СозданиеНоменклатура Цикл
		
		ЭлементНоменклатуры = Справочники.Номенклатура.СоздатьЭлемент();  
		
		ПараметрыОтбора = Новый Структура("Отбор,ВыборГруппИЭлементов");
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", СтрокаНоменклатуры.Родитель);
		ПараметрыОтбора.Отбор = Отбор;
		ПараметрыОтбора.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы;
		РодительНомменклатуры = Справочники.Номенклатура.ПолучитьДанныеВыбора(ПараметрыОтбора);  
		Если РодительНомменклатуры.Количество() > 0 Тогда	
			//РодительНомменклатуры = РодительНомменклатуры[0].Значение; 
			ЭлементНоменклатуры.Родитель  = РодительНомменклатуры[0].Значение.Значение;
		Иначе 
			РодительНомменклатуры = Справочники.Номенклатура.СоздатьГруппу();
			РодительНомменклатуры.Наименование = СтрокаНоменклатуры.Родитель;
			РодительНомменклатуры.Записать();
			ЭлементНоменклатуры.Родитель = РодительНомменклатуры.Ссылка;
		КонецЕсли;
		ЭлементНоменклатуры.Наименование = СтрокаНоменклатуры.Наименование;	
		ЭлементНоменклатуры.НаименованиеПолное = СтрокаНоменклатуры.Наименование;
		Если СтрокаНоменклатуры.ЕдиницаИзмерения = "КМ" Тогда
			ЭлементНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("006"); 
			ЭлементНоменклатуры.ЕдиницаДляОтчетов = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("008");
			ЭлементНоменклатуры.КоэффициентЕдиницыДляОтчетов =  1000;
		ИначеЕсли СтрокаНоменклатуры.ЕдиницаИзмерения = "ТН" Тогда
			ЭлементНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("166");
			ЭлементНоменклатуры.ЕдиницаДляОтчетов = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("168");
			ЭлементНоменклатуры.КоэффициентЕдиницыДляОтчетов =  1000;
		ИначеЕсли СтрокаНоменклатуры.ЕдиницаИзмерения = "КУБМ" Тогда
			ЭлементНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("113");
			ЭлементНоменклатуры.ЕдиницаДляОтчетов = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("113");      
        Иначе ЭлементНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаНоменклатуры.ЕдиницаИзмерения); 
			Если ЭлементНоменклатуры.ЕдиницаИзмерения.Пустая() Тогда
				НоваяЕденицаИзмерения = СоздатьЕдиницуИзмерения(СтрокаНоменклатуры.ЕдиницаИзмерения);
				Если НоваяЕденицаИзмерения.Количество() > 0 Тогда
				    ЭлементНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаНоменклатуры.ЕдиницаИзмерения);
				Иначе      
					СтрокаНоменклатуры.Ошибка = "Не удалось подобрать единицу измерения!";
					СтрокаОшибокНоменклатура = ОшибокНоменклатура.Добавить();
					ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаОшибокНоменклатура, СтрокаНоменклатуры); 
					//Продолжить;
				КонецЕсли; 
				
			КонецЕсли;	
		КонецЕсли;
		ЭлементНоменклатуры.Артикул = СтрокаНоменклатуры.Артикул;
		ЭлементНоменклатуры.ВесЗнаменатель = СтрокаНоменклатуры.ВесЗнаменатель;
		ЭлементНоменклатуры.ВесЧислитель = СтрокаНоменклатуры.ВесЧислитель;
		ПараметрыОтбора = Новый Структура("Отбор,ВыборГруппИЭлементов");
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", СтрокаНоменклатуры.ВидНоменклатуры);
		ПараметрыОтбора.Отбор = Отбор;
		ПараметрыОтбора.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы;
		ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);  
		Если ВидНоменклатуры.Количество() > 0 Тогда	
			ЭлементНоменклатуры.ВидНоменклатуры = ВидНоменклатуры[0].Значение;
		Иначе      
			СтрокаНоменклатуры.Ошибка = "Не удалось подобрать вид номенклатуры!";
			СтрокаОшибокНоменклатура = ОшибокНоменклатура.Добавить();
			ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаОшибокНоменклатура, СтрокаНоменклатуры); 
		КонецЕсли; 
		Если СтрокаНоменклатуры.ИспользоватьИндивидуальныйШаблонЭтикетки = "" Тогда 
			ЭлементНоменклатуры.ИспользоватьИндивидуальныйШаблонЭтикетки = Ложь;
		Иначе
			ЭлементНоменклатуры.ИспользоватьИндивидуальныйШаблонЭтикетки = ПреобразоватьКТИпуБулевоВН(СтрокаНоменклатуры.ИспользоватьИндивидуальныйШаблонЭтикетки);
		КонецЕсли;
		Если СтрокаНоменклатуры.ШаблонЭтикетки = "" Тогда 
			ЭлементНоменклатуры.ИспользоватьИндивидуальныйШаблонЭтикетки = Ложь;
			ЭлементНоменклатуры.ШаблонЭтикетки = Справочники.ШаблоныЭтикетокИЦенников.ПустаяСсылка();
		Иначе
			ЭлементНоменклатуры.ШаблонЭтикетки = Справочники.ШаблоныЭтикетокИЦенников.НайтиПоРеквизиту("Наименование", СтрокаНоменклатуры.ШаблонЭтикетки);
		КонецЕсли;
		Если СтрокаНоменклатуры.ИспользоватьУпаковки = "" Тогда 
			ИспользоватьУпаковки = ЭлементНоменклатуры.ВидНоменклатуры.ИспользоватьУпаковки;
