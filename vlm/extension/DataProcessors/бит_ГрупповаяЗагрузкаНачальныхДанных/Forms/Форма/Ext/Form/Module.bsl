	КвалификаторЧисла4_2 = Новый КвалификаторыЧисла(6,2);
	ОписаниеЧисло4_2 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла4_2);
	КвалификаторЧисла3_0 = Новый КвалификаторыЧисла(3,0);
	ОписаниеЧисло3_0 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла3_0);
	КвалификаторЧисла3_3 = Новый КвалификаторыЧисла(6,3);
	ОписаниеЧисло3_3 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла3_3);
	КвалификаторЧисла3_5 = Новый КвалификаторыЧисла(8,5);
	ОписаниеЧисло3_5 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла3_5);
	КвалификаторЧисла3_10 = Новый КвалификаторыЧисла(13,10);
	ОписаниеЧисло3_10 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла3_10);
	КвалификаторЧисла3_20 = Новый КвалификаторыЧисла(23,20);
