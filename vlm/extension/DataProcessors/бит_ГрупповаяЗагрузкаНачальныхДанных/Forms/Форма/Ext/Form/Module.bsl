		Если Этап.ПланироватьРаботуВидовРабочихЦентров = Истина и Этап.ВидыРабочихЦентров.Количество() > 0 Тогда
			СозданиеОпераций(ТекущаяСпецификация.Значение, ЗаполняемаяСпецификация, Этап); 
		КонецЕсли;
		//ПроверкаЦех42 = ТекущаяСпецификация.Значение;
