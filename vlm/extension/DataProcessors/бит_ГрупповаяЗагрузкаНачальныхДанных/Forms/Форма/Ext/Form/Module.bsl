	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиНоменклатура.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СозданияПризнаковНоменклатуры   
&НаКлиенте 
Процедура ДействияСТаблицамиПризнакиНоменклатуры(ПредставлениеИсточника)
	
	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникПризнакиНоменклатуры.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникПризнакиНоменклатуры(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеПризнакиНоменклатуры.Видимость 	= Истина;
		Элементы.ПроверкиПризнакиНоменклатуры.Видимость 	= Истина;
		Элементы.ОшибокПризнакиНоменклатуры.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиПризнакиНоменклатуры();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыПризнакиНоменклатуры();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыПризнакиНоменклатуры();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.Номенклатура.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникПризнакиНоменклатуры(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникНоменклатура = ИсточникПризнакиНоменклатуры.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(Формат(НомерСтроки, "ЧГ=0"), 3).Текст;
		СтрИсточникНоменклатура.Наименование = ТекстКолонки;  
		СтрИсточникНоменклатура.ГруппаКабеля = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
	    СтрИсточникНоменклатура.Код = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;
		СтрИсточникНоменклатура.ЕдИзм = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		//СтрИсточникНоменклатура.НормативнаяТара = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		//СтрИсточникНоменклатура.Ед_Изм = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст;
		//СтрИсточникНоменклатура.Емкость = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;
		//СтрИсточникНоменклатура.НормаРасхода = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
		СтрИсточникНоменклатура.КодПризнака =  ПредставлениеИсточника.Область(НомерСтроки, 5).Текст; 
		СтрИсточникНоменклатура.НаименованиеПризнака = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст; 
        СтрИсточникНоменклатура.ЗначениеПризнака = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;
					
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникПризнакиНоменклатуры.Удалить(СтрИсточникНоменклатура);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиПризнакиНоменклатуры()
	
	УсловноеОформление.Элементы.Очистить();
	
	МассивНоменклатуры = ИсточникПризнакиНоменклатуры.Выгрузить( , "Наименование");
	МассивАртикулов = ИсточникПризнакиНоменклатуры.Выгрузить( , "Код");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК СсылкаНоменклатура,
	|	Номенклатура.Наименование КАК НаименованиеНоменклатура,
	|	Номенклатура.Код КАК КодНоменклатура,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование В(&МассивНоменклатуры)
	|	И Номенклатура.Артикул В(&МассивАртикулов)
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура,
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак КАК бит_Признак,
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак.Код КАК бит_ПризнакКод, 
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура.Наименование КАК бит_НоменклатураНаименование,
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак.Наименование КАК бит_ПризнакНаименование,
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура.Артикул КАК бит_НоменклатураАртикул
	|ИЗ
	|	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	|ГДЕ
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура.Наименование В(&МассивНоменклатуры)";
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаНоменклатура = РезультатЗапроса[0].Выгрузить();
	ВыборкаПризнак = РезультатЗапроса[1].Выгрузить();		
	ЗаполнениеТаблицПризнакиНоменклатуры(ВыборкаНоменклатура, ВыборкаПризнак);
   
КонецПроцедуры  

&НаСервере 
Процедура ЗаполнениеТаблицПризнакиНоменклатуры(ВыборкаНоменклатура, ВыборкаПризнак)
	
	ВсеПодразделенияБезПрификса = ПолучитьВсеПодразделенияБезПрификса();
	
	Для каждого СтрокаПризнакиНоменклатуры Из ИсточникПризнакиНоменклатуры Цикл
		
		ТекстСообщения = ""; 
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НаименованиеНоменклатура", СтрокаПризнакиНоменклатуры.Наименование);
		ПараметрыОтбора.Вставить("Артикул", СтрокаПризнакиНоменклатуры.Код);
        ИдентификаторНоменклатуры = ВыборкаНоменклатура.НайтиСтроки(ПараметрыОтбора);
		Если ИдентификаторНоменклатуры.Количество() = 0 Тогда
			ТекстСообщения = ТекстСообщения + "Номенклатура не найдена! ";
		КонецЕсли; 
		
		//Если ИдентификаторНоменклатуры = Неопределено Тогда
		//	ТекстСообщения = ТекстСообщения + "Номенклатура не найдена! "; 
		//ИначеЕсли Не ИдентификаторНоменклатуры[0].Артикул = СтрокаПризнакиНоменклатуры.Код Тогда
		//	ТекстСообщения = ТекстСообщения + "Номенклатура не найдена! "
		//КонецЕсли;
		
		
		НоменклатураТ = Справочники.Номенклатура.ПустаяСсылка();

		ПараметрыОтбора = Новый Структура;
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", СтрокаПризнакиНоменклатуры.Наименование); 
		Отбор.Вставить("Артикул", СтрокаПризнакиНоменклатуры.Код);   
		ПараметрыОтбора.Вставить("Отбор", Отбор);
		бит_Номенклатура = Справочники.Номенклатура.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если Не (бит_Номенклатура = Неопределено Или бит_Номенклатура.Количество() = 0) Тогда 
			НоменклатураТ = бит_Номенклатура[0].Значение;
			НоменклатураТ = НоменклатураТ.Значение;
			Если  НоменклатураТ.Артикул <> СтрокаПризнакиНоменклатуры.Код Тогда
				НоменклатураТ = бит_Номенклатура[1].Значение;
				НоменклатураТ = НоменклатураТ.Значение;
				Если  НоменклатураТ.Артикул <> СтрокаПризнакиНоменклатуры.Код Тогда
					НоменклатураТ = бит_Номенклатура[2].Значение;
					НоменклатураТ = НоменклатураТ.Значение;
					Если  НоменклатураТ.Артикул <> СтрокаПризнакиНоменклатуры.Код Тогда 
						ТекстСообщения = ТекстСообщения + СтрШаблон("Артикул номенклатуры %1 <> Код в строке таблицы %2", НоменклатураТ.Артикул, СтрокаПризнакиНоменклатуры.Код);
						бит_Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
					КонецЕсли;	
					бит_Номенклатура = НоменклатураТ;
				КонецЕсли;	
				бит_Номенклатура = НоменклатураТ;
			КонецЕсли;
			бит_Номенклатура = НоменклатураТ;
		Иначе
			бит_Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;                 
		
		Если Не бит_Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			ПараметрыОтбора = Новый Структура;
			Отбор = Новый Структура;
			Отбор.Вставить("Код", СтрокаПризнакиНоменклатуры.КодПризнака);   
			ПараметрыОтбора.Вставить("Отбор", Отбор);
			бит_Признак = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);
			Если бит_Признак = Неопределено Или бит_Признак.Количество() = 0 Тогда 
				ТекстСообщения = ТекстСообщения + "Признак " + СтрокаПризнакиНоменклатуры.КодПризнака + " не найден в ПВХ. "; 
				бит_Признак = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.ПустаяСсылка();
			Иначе
				бит_Признак = бит_Признак[0].Значение;
			КонецЕсли;
			
			Если Не бит_Признак = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.ПустаяСсылка() Тогда
				бит_Значение = ПолучитьЗначениеПризнака(СтрокаПризнакиНоменклатуры, бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса); 
			Иначе              
				бит_Значение = Неопределено;
			КонецЕсли;

			Если ТипЗнч(бит_Значение) = Тип("СправочникСсылка.бит_ДополнительныеПризнакиНоменклатуры") Тогда
				бит_Значение = бит_Значение[0].Значение;
			КонецЕсли;

			Если бит_Значение <> Неопределено Тогда 
				Если ТипЗнч(бит_Значение) = Тип("СправочникСсылка.бит_ДополнительныеПризнакиНоменклатуры") 
					Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.Номенклатура")
					Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.СтруктураПредприятия")
					Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.Марки") Тогда
					Если бит_Значение.Пустая() Тогда 
						ТекстСообщения = ТекстСообщения + "не удалось получить значение признака " + СтрокаПризнакиНоменклатуры.КодПризнака;
						бит_Значение = "";
					КонецЕсли;
				Иначе
					Если бит_Значение = "" Тогда
						ТекстСообщения = ТекстСообщения + "тип значения для значения признака не является корректным";
						бит_Значение = "";
					КонецЕсли;
				КонецЕсли;
			Иначе 		
				бит_Значение = "";                                                                                                          
				ТекстСообщения = ТекстСообщения + "не удалось получить значение признака " + СтрокаПризнакиНоменклатуры.КодПризнака;
			КонецЕсли;   
		КонецЕсли;
		
		//Если ТекстСообщения = "" И ЗначениеЗаполнено(бит_Признак) и ЗначениеЗаполнено(бит_Номенклатура) и ЗначениеЗаполнено(бит_Значение) Тогда
		Если ТекстСообщения = "" И ЗначениеЗаполнено(бит_Признак) и ЗначениеЗаполнено(бит_Номенклатура) Тогда
			
			ПараметрыОтбора = Новый Структура;
		    ПараметрыОтбора.Вставить("бит_НоменклатураНаименование", СтрокаПризнакиНоменклатуры.Наименование);
		    ПараметрыОтбора.Вставить("бит_ПризнакНаименование", СтрокаПризнакиНоменклатуры.НаименованиеПризнака); 
			ПараметрыОтбора.Вставить("бит_НоменклатураАртикул", СтрокаПризнакиНоменклатуры.Код);
			Признак = ВыборкаПризнак.НайтиСтроки(ПараметрыОтбора);
			
			СтрокаПризнакиНоменклатуры.бит_Номенклатура = бит_Номенклатура;
			СтрокаПризнакиНоменклатуры.бит_Признак = бит_Признак;
			СтрокаПризнакиНоменклатуры.бит_Значение = бит_Значение;
			
			Если Признак.Количество() > 0 Тогда 
				СтрокаПроверкиПризнакиНоменклатуры = ПроверкиПризнакиНоменклатуры.Добавить(); 
				ЗаполнитьСтрокуТаблицыПризнакиНоменклатуры(СтрокаПроверкиПризнакиНоменклатуры, СтрокаПризнакиНоменклатуры);
			Иначе 
				СтрокаСозданиеПризнакиНоменклатуры = СозданиеПризнакиНоменклатуры.Добавить(); 
				ЗаполнитьСтрокуТаблицыПризнакиНоменклатуры(СтрокаСозданиеПризнакиНоменклатуры, СтрокаПризнакиНоменклатуры);
			КонецЕсли;	
			
		Иначе
			СтрокаОшибокПризнакиНоменклатуры = ОшибокПризнакиНоменклатуры.Добавить();
			ЗаполнитьСтрокуТаблицыПризнакиНоменклатуры(СтрокаОшибокПризнакиНоменклатуры, СтрокаПризнакиНоменклатуры);
			СтрокаОшибокПризнакиНоменклатуры.Ошибка = ТекстСообщения;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПризнакиНоменклатуры(СтрокаПриемник, СтрокаИсточник)  
		                 
	СтрокаПриемник.ГруппаКабеля = СтрокаИсточник.ГруппаКабеля; 
	СтрокаПриемник.Код = СтрокаИсточник.Код;
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование;
	СтрокаПриемник.ЕдИзм = СтрокаИсточник.ЕдИзм;
	СтрокаПриемник.НормативнаяТара = СтрокаИсточник.НормативнаяТара;
	СтрокаПриемник.Ед_Изм = СтрокаИсточник.Ед_Изм;
	СтрокаПриемник.Емкость = СтрокаИсточник.Емкость;
	СтрокаПриемник.НормаРасхода = СтрокаИсточник.НормаРасхода; 
	Если СтрокаИсточник.КодПризнака = "GR1 (KKSS)" Тогда
		СтрокаПриемник.КодПризнака = "GR1 (KKSS)";	
	Иначе
		СтрокаПриемник.КодПризнака = СтрокаИсточник.КодПризнака;
	КонецЕсли;
	СтрокаПриемник.НаименованиеПризнака = СтрокаИсточник.НаименованиеПризнака;   
	СтрокаПриемник.ЗначениеПризнака = СтрокаИсточник.ЗначениеПризнака; 
	
	СтрокаПриемник.бит_Номенклатура = СтрокаИсточник.бит_Номенклатура;
	СтрокаПриемник.бит_Признак 		= СтрокаИсточник.бит_Признак;
	СтрокаПриемник.бит_Значение 	= СтрокаИсточник.бит_Значение;

КонецПроцедуры

&НаСервере
Функция НайтиНоменклатуруПоСтрокеПризнакаИзКеша(СтрокаПризнакиНоменклатуры, КешДанных)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("НаименованиеНоменклатура", СтрокаПризнакиНоменклатуры.Наименование);
	ПараметрыОтбора.Вставить("Артикул", СтрокаПризнакиНоменклатуры.Код);
	СтрокиНоменклатуры = КешДанных.Номенклатура.НайтиСтроки(ПараметрыОтбора);
	
	Если СтрокиНоменклатуры.Количество() = 0 Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтрокиНоменклатуры[0].СсылкаНоменклатура;
	
КонецФункции

&НаСервере
Функция НайтиПризнакПоКодуИзКеша(КодПризнака, КешДанных)
	
	ПараметрыОтбора = Новый Структура("Код", КодПризнака);
	СтрокиПризнаков = КешДанных.Признаки.НайтиСтроки(ПараметрыОтбора);
	Если СтрокиПризнаков.Количество() = 0 Тогда
		Возврат ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтрокиПризнаков[0].Ссылка;
	
КонецФункции

&НаСервере
Функция ПодготовитьДанныеСтрокиПризнакаДляЗаписи(СтрокаПризнакиНоменклатуры, КешДанных, ВсеПодразделенияБезПрификса)
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстПредупреждения", "");
	Результат.Вставить("КодПризнака", "");
	Результат.Вставить("СсылкаНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	Результат.Вставить("СсылкаПризнак", ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.ПустаяСсылка());
	Результат.Вставить("ЗначениеДляЗаписи", "");
	Результат.Вставить("ЗаписьСуществует", Ложь);
	
	СсылкаНоменклатуры = НайтиНоменклатуруПоСтрокеПризнакаИзКеша(СтрокаПризнакиНоменклатуры, КешДанных);
	Если СсылкаНоменклатуры.Пустая() Тогда
		Результат.ТекстОшибки = Результат.ТекстОшибки + "Номенклатура не найдена: " + СтрокаПризнакиНоменклатуры.Наименование + "(" + СтрокаПризнакиНоменклатуры.Код + ")";
		Возврат Результат;
	КонецЕсли;
	
	СсылкаПризнака = НайтиПризнакПоКодуИзКеша(СтрокаПризнакиНоменклатуры.КодПризнака, КешДанных);
	Если СсылкаПризнака.Пустая() Тогда
		Результат.ТекстОшибки = Результат.ТекстОшибки + "Признак " + СтрокаПризнакиНоменклатуры.КодПризнака + " не найден в ПВХ. ";
		Результат.СсылкаНоменклатура = СсылкаНоменклатуры;
		Возврат Результат;
	КонецЕсли;
	
	ЗначениеДляЗаписи = ПолучитьЗначениеПризнака(СтрокаПризнакиНоменклатуры, СсылкаПризнака, СсылкаНоменклатуры, ВсеПодразделенияБезПрификса);
	Если ЗначениеДляЗаписи = Неопределено Или ЗначениеДляЗаписи = "" Тогда
		Результат.ТекстОшибки = Результат.ТекстОшибки + "не удалось получить значение признака " + СтрокаПризнакиНоменклатуры.КодПризнака;
		Результат.СсылкаНоменклатура = СсылкаНоменклатуры;
		Результат.СсылкаПризнак = СсылкаПризнака;
		Результат.КодПризнака = СсылкаПризнака.Код;
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.ПодразделенияОрганизаций") 
		Или ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.бит_ДополнительныеПризнакиНоменклатуры") 
		Или ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.Марки")
		Или ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.Номенклатура") 
		ИЛИ ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.СтруктураПредприятия") 
		ИЛИ ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.ШтрихкодыУпаковокТоваров") Тогда
		
		Если ЗначениеДляЗаписи.Пустая() Тогда 
			Результат.ТекстОшибки = Результат.ТекстОшибки + "Признак " + СтрокаПризнакиНоменклатуры.КодПризнака + " не найдено значение признака ";
			ЗначениеДляЗаписи = "";	
		ИначеЕсли СтрокаПризнакиНоменклатуры.ЗначениеПризнака <> ЗначениеДляЗаписи.Наименование 
			И Не (ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.СтруктураПредприятия")) 
			И Не (ТипЗнч(ЗначениеДляЗаписи) = Тип("СправочникСсылка.Марки")) Тогда
			Результат.ТекстПредупреждения = СтрШаблон("Наименование в таблице не совпадает с найденным значением. Артикул %1 Признак %2", СтрокаПризнакиНоменклатуры.Код, СтрокаПризнакиНоменклатуры.КодПризнака);
		КонецЕсли;
	ИначеЕсли ЭтоЧисловойТипПризнака(СсылкаПризнака.ТипЗначения) Тогда
		ЗначениеДляЗаписи = НормализацияЗначенияПризнакаЧисло(ЗначениеДляЗаписи);
		Если ТипЗнч(ЗначениеДляЗаписи) = Тип("Строка") Тогда
			Попытка
				ЗначениеДляЗаписи = Число(ЗначениеДляЗаписи);
			Исключение
				Результат.ТекстОшибки = Результат.ТекстОшибки + "ожидается другой тип значения признака ";
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат.ТекстОшибки = "" Тогда
		Результат.ЗаписьСуществует = ЕстьСуществующаяЗаписьПризнакаВКеше(СсылкаНоменклатуры, СсылкаПризнака, КешДанных);
	КонецЕсли;
	
	Результат.СсылкаНоменклатура = СсылкаНоменклатуры;
	Результат.СсылкаПризнак = СсылкаПризнака;
	Результат.ЗначениеДляЗаписи = ЗначениеДляЗаписи;
	Результат.КодПризнака = СсылкаПризнака.Код;
	
	Возврат Результат;
	
КонецФункции

&НаСервере 
Функция НормализацияЗначенияПризнакаЧисло(бит_Значение)
	
	Если ТипЗнч(бит_Значение) = Тип("Число") Тогда
		Возврат бит_Значение;
	КонецЕсли;
	
	ЗначениеСтрокой = СокрЛП(Строка(бит_Значение));
	Если ЗначениеСтрокой = "" Тогда
		Возврат бит_Значение;
	КонецЕсли;
	
	Если Лев(ЗначениеСтрокой, 1) = "." Тогда
		ЗначениеСтрокой = "0" + ЗначениеСтрокой;
	ИначеЕсли Лев(ЗначениеСтрокой, 1) = "," Тогда
		ЗначениеСтрокой = "0" + ЗначениеСтрокой;
	КонецЕсли;
	
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, ",", ".");
	
	Попытка
		Возврат Число(ЗначениеСтрокой);
	Исключение
		Возврат бит_Значение;
	КонецПопытки;
	
КонецФункции

&НаСервере
