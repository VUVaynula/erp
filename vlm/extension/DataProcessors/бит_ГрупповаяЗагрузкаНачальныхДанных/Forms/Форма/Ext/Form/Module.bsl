&НаСервере                                                                         
Функция СозданиеКонтактногоЛица(КонтактноеЛицо, Контрагент)                          
	
	КонтактныеЛицаПартнеров = Справочники.КонтактныеЛицаПартнеров.СоздатьЭлемент();
	КонтактныеЛицаПартнеров.Наименование = КонтактноеЛицо;
	КонтактныеЛицаПартнеров.Владелец = Контрагент.Партнер;
	КонтактныеЛицаПартнеров.ДатаРегистрацииСвязи = Дата;
    КонтактныеЛицаПартнеров.Автор = Пользователи.ТекущийПользователь(); 
	КонтактныеЛицаПартнеров.Записать();
	
	Возврат КонтактныеЛицаПартнеров;
	
КонецФункции
                                                                                   
&НаСервере                                                                         
Процедура ПроверитьЭлементыТаблицыДоговорыКонтрагентов()   
	
	МассивМенеджеров = СозданиеДоговорыКонтрагентов.Выгрузить( , "Менеджер");
    МассивКонтактныхЛиц = СозданиеДоговорыКонтрагентов.Выгрузить( , "КонтактноеЛицо"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование В(&МассивМенеджеров)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка,
		|	КонтактныеЛицаПартнеров.Наименование КАК Наименование,
		|	КонтактныеЛицаПартнеров.Владелец КАК Владелец
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	КонтактныеЛицаПартнеров.Наименование В(&МассивКонтактныхЛиц)";
	
	Запрос.УстановитьПараметр("МассивМенеджеров", МассивМенеджеров);
	Запрос.УстановитьПараметр("МассивКонтактныхЛиц", МассивКонтактныхЛиц);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаМенеджеры = РезультатЗапроса[0].Выгрузить();
	ВыборкаКонтактныеЛицаПартнеров = РезультатЗапроса[1].Выгрузить();
   	
	Для каждого СтрокаДоговорыКонтрагентов Из ПроверкиДоговорыКонтрагентов Цикл 
		
		ТекущийЭлементСправочника = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Номер", 
		                                                                               СтрокаДоговорыКонтрагентов.Номер);
		Если ТекущийЭлементСправочника.ДатаНачалаДействия <> СтрокаДоговорыКонтрагентов.ДатаНачалаДействия Тогда  
			СтрокаДоговорыКонтрагентов.Изменено = Ложь;
			Продолжить;
		КонецЕсли;

		ПроверкаДоговорыКв(ТекущийЭлементСправочника, СтрокаДоговорыКонтрагентов, 
		                             ВыборкаМенеджеры, ВыборкаКонтактныеЛицаПартнеров);
			
	КонецЦикла;
	
	ИзменениеУсловногоОформленияПроверкиДоговорыКонтрагентов();
		
КонецПроцедуры 

 &НаСервере 
 Процедура ПроверкаДоговорыКв(ТекЭлемент, СтрокаДоговорыКонтрагентов, ВыборкаМенеджеры, ВыборкаКонтактныеЛицаПартнеров)

	 ТекЭлемент = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Номер", 
	 СтрокаДоговорыКонтрагентов.Номер);
	 ТекЭлемент = ТекЭлемент.ПолучитьОбъект();   
	 
	 ПроверкаДоговорыКвБСОиБСК(ТекЭлемент, СтрокаДоговорыКонтрагентов); 
	 ПроверкаДоговорыКвПустыеПоля(ТекЭлемент, СтрокаДоговорыКонтрагентов);
	 ПроверкаМенеджерКонтакт(ТекЭлемент, СтрокаДоговорыКонтрагентов, ВыборкаМенеджеры, ВыборкаКонтактныеЛицаПартнеров);
     
	 Если ТекЭлемент.ВалютаВзаиморасчетов = Неопределено 
		 ИЛИ ТекЭлемент.ВалютаВзаиморасчетов.Пустая() Тогда
		 ТекЭлемент.ВалютаВзаиморасчетов = 
		 Справочники.Валюты.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.ВалютаВзаиморасчетов);
		 СтрокаДоговорыКонтрагентов.Изменено = Истина;
	 Иначе 
		 Изменено = Ложь;
	 КонецЕсли;  
				 
	 Если ТекЭлемент.ПометкаУдаления = Истина Тогда
		 ТекЭлемент.ПометкаУдаления = Ложь;
		 СтрокаДоговорыКонтрагентов.Изменено = Истина;
	 КонецЕсли;	 
	 
	 Если СтрокаДоговорыКонтрагентов.Изменено Тогда
		 Попытка
			 ТекЭлемент.Записать();
		 Исключение 
			 СтрокаДоговорыКонтрагентов.Изменено = Ложь;
		 КонецПопытки;
	 КонецЕсли;  
	 
 КонецПроцедуры 
 
 &НаСервере 
 Процедура ПроверкаДоговорыКвБСОиБСК(ТекЭлемент, СтрокаДоговорыКонтрагентов)
	 
	 Если СтрокаДоговорыКонтрагентов.БанковскийСчет <> "" Тогда
		 Если ТекЭлемент.БанковскийСчет.Пустая() 
			 ИЛИ	ТекЭлемент.БанковскийСчет = Неопределено Тогда 
			 НомерСчетаБСО = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаДоговорыКонтрагентов.БанковскийСчет), " ", ""), ".", ""));
			 ТекущийЭлементСправочникаБСО = Справочники.БанковскиеСчетаОрганизаций.НайтиПоРеквизиту("НомерСчета", НомерСчетаБСО);
			 ТекЭлемент.БанковскийСчет = ТекущийЭлементСправочникаБСО;
			 СтрокаДоговорыКонтрагентов.Изменено = Истина;
		 Иначе
			 СтрокаДоговорыКонтрагентов.Изменено = Ложь;
		 КонецЕсли;
	 Иначе
		 Изменено = Ложь;
	 КонецЕсли;
	 
	 Если СтрокаДоговорыКонтрагентов.БанковскийСчетКонтрагента <> "" Тогда
		 Если ТекЭлемент.БанковскийСчетКонтрагента.Пустая() 
			 ИЛИ ТекЭлемент.БанковскийСчетКонтрагента = Неопределено Тогда 
			 БСК = СтрЗаменить(СокрЛП(СтрокаДоговорыКонтрагентов.БанковскийСчетКонтрагента), " ", "");
			 НомерСчетаБСК = ВРег(СтрЗаменить(БСК, ".", ""));
			 ТекЭлементСправочникаБСК = Справочники.БанковскиеСчетаКонтрагентов.НайтиПоРеквизиту("НомерСчета", НомерСчетаБСК);
			 ТекЭлемент.БанковскийСчетКонтрагента = ТекЭлементСправочникаБСК;
			 СтрокаДоговорыКонтрагентов.Изменено = Истина;
		 Иначе
			 СтрокаДоговорыКонтрагентов.Изменено = Ложь;
		 КонецЕсли;
	 Иначе
		 Изменено = Ложь;
	 КонецЕсли;
	 
 КонецПроцедуры
 
 &НаСервере 
 Процедура ПроверкаДоговорыКвПустыеПоля(ТекЭлемент, СтрокаДоговорыКонтрагентов)   
	 
	 Если СтрокаДоговорыКонтрагентов.НаименованиеДляПечати <> "" Тогда
		 Если ТекЭлемент.НаименованиеДляПечати = "" ИЛИ  
			 ТекЭлемент.НаименованиеДляПечати = Неопределено Тогда
			 ТекЭлемент.НаименованиеДляПечати = СтрокаДоговорыКонтрагентов.НаименованиеДляПечати;
			 СтрокаДоговорыКонтрагентов.Изменено = Истина;
		 Иначе
			Изменено = Ложь;
		 КонецЕсли;
		 Изменено = Ложь;
	 КонецЕсли;
	 
	 Если СтрокаДоговорыКонтрагентов.Комментарий <> "" Тогда 
		 Если ТекЭлемент.Комментарий = Неопределено 
			 ИЛИ ТекЭлемент.Комментарий = "" Тогда
			 ТекЭлемент.Комментарий = СтрокаДоговорыКонтрагентов.Комментарий; 
