&НаСервере
Функция	ПолучитьЗначениеПризнакаТара(СтрокаПризнакиНоменклатуры, бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса)
	
	Если СтрокаПризнакиНоменклатуры.КодПризнака = "003/00" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "10/01"  
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "10/04" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "10/09"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "11" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "4"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "41/01"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "41/02" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MULTIL"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "TZR" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "БРУТТО" 
		Тогда
		бит_Значение = Истина;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "ANALOG" Тогда
		бит_Значение = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаПризнакиНоменклатуры.ЗначениеПризнака); 
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "CEX1" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "CEXV_OSNMA"
		Тогда
		ПараметрыОтбора = Новый Структура; 
		Если СтрокаПризнакиНоменклатуры.ЗначениеПризнака = "" Тогда
			бит_Значение = Неопределено;
		Иначе
			ПараметрыОтбора.Вставить("Код",Число(СтрокаПризнакиНоменклатуры.ЗначениеПризнака)); 
			Значение = ВсеПодразделенияБезПрификса.НайтиСтроки(ПараметрыОтбора);
			Если Значение.Количество() > 0 Тогда  
				бит_Значение = Значение[0].Ссылка;
			Иначе
				бит_Значение = Неопределено;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "GR6" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "ISP_NAPR"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "ISP_OUTSID"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KAT_UNIV" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KODGR6"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KODMAR"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KODRAZ"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KPROD" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MATERIALPF"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "RAZMER"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "TYPE_MAT"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "VIDIZ_OSNM"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "WISP"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "PGR"
		Тогда
		ПараметрыОтбора = Новый Структура;
		Отбор = Новый Структура; 
		ДлинаНаименования = Метаданные.Справочники.бит_ДополнительныеПризнакиНоменклатуры.ДлинаНаименования;
		НаименованиеДопПризнака = Лев(СтрокаПризнакиНоменклатуры.ЗначениеПризнака, ДлинаНаименования);


		Отбор.Вставить("Наименование", НаименованиеДопПризнака); 
		Отбор.Вставить("Владелец", бит_Признак[0].Значение);   
		ПараметрыОтбора.Вставить("Отбор", Отбор);
        Значение = Справочники.бит_ДополнительныеПризнакиНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если Значение = Неопределено Или Значение.Количество() = 0 Тогда
			ДополнительныйПризнак = Справочники.бит_ДополнительныеПризнакиНоменклатуры.СоздатьЭлемент();
			ДополнительныйПризнак.Наименование = СтрокаПризнакиНоменклатуры.ЗначениеПризнака;
			ДополнительныйПризнак.Владелец = бит_Признак[0].Значение; 
			ДополнительныйПризнак.Записать();
			Значение = ДополнительныйПризнак;
		КонецЕсли;
		бит_Значение = Значение;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "MARKA" Тогда
		Значение = Справочники.Марки.НайтиПоНаименованию(СтрокаПризнакиНоменклатуры.ЗначениеПризнака);	
		Если Значение = Неопределено Или Значение.Пустая() Тогда
			Марка = Справочники.Марки.СоздатьЭлемент();
			Марка.Наименование = СтрокаПризнакиНоменклатуры.ЗначениеПризнака;
			Марка.Записать();
			Значение = Марка.Ссылка;
		КонецЕсли; 
		НоменклатураТ = бит_Номенклатура.ПолучитьОбъект();
		НоменклатураТ.Марка = Значение;
		НоменклатураТ.Записать();
		бит_Значение = Значение;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "PRP" Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаПризнакиНоменклатуры.ЗначениеПризнака);	
		Если Не(Номенклатура.Пустая()) Тогда
			НоменклатураЭлемент = Номенклатура.ПолучитьОбъект();
			НоменклатураЭлемент.ПометкаУдаления = Истина;
			НоменклатураЭлемент.Записать();
			бит_Значение = Ложь;
		Иначе бит_Значение = Истина;	
		КонецЕсли;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "DIAMETRSB"  
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "GOST_NAME" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "LIMIT"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KPR" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF1"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF2"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF3"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF4"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF5"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF6"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF7"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF8"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "MKF9"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "NETTO_NOM"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "OTD_MAT"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "OUTNAM"
		Тогда 
		бит_Значение = СтрокаПризнакиНоменклатуры.ЗначениеПризнака; 
	Иначе
		бит_Значение = Неопределено;
	КонецЕсли;	
	
	Возврат бит_Значение;
	
