	ОписаниеЧисло5_0 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла5_0); 
	КвалификаторЧисла5_2 = Новый КвалификаторыЧисла(7,2);
	ОписаниеЧисло5_2 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла5_2); 
	КвалификаторЧисла5_3 = Новый КвалификаторыЧисла(8,3);
	ОписаниеЧисло5_3 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла5_3); 
