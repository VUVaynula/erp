&НаСервере
Функция ЕстьСуществующаяЗаписьПризнакаВКеше(СсылкаНоменклатуры, СсылкаПризнака, КешДанных)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("бит_Номенклатура", СсылкаНоменклатуры);
	ПараметрыОтбора.Вставить("бит_Признак", СсылкаПризнака);
	
	Возврат КешДанных.СуществующиеЗаписи.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
	
КонецФункции

&НаСервере
Функция ПостроитьКешДанныхДляТаблицыПризнаков(ТаблицаПризнаков)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Новый ТаблицаЗначений);
	Результат.Вставить("СуществующиеЗаписи", Новый ТаблицаЗначений);
	Результат.Вставить("Признаки", Новый ТаблицаЗначений);
	
	Если ТаблицаПризнаков = Неопределено Или ТаблицаПризнаков.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивНоменклатуры = ТаблицаПризнаков.Выгрузить(, "Наименование");
	МассивАртикулов = ТаблицаПризнаков.Выгрузить(, "Код");
	МассивКодовПризнаков = ТаблицаПризнаков.Выгрузить(, "КодПризнака");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК СсылкаНоменклатура,
	|	Номенклатура.Наименование КАК НаименованиеНоменклатура,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование В(&МассивНоменклатуры)
	|	И Номенклатура.Артикул В(&МассивАртикулов)
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура,
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Признак КАК бит_Признак
	|ИЗ
	|	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	|ГДЕ
	|	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура.Наименование В(&МассивНоменклатуры)
	|	И бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура.Артикул В(&МассивАртикулов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПризнакиНоменклатуры.Ссылка КАК Ссылка,
	|	бит_ПризнакиНоменклатуры.Код КАК Код
	|ИЗ
	|	ПланВидовХарактеристик.бит_ПризнакиНоменклатуры КАК бит_ПризнакиНоменклатуры
	|ГДЕ
	|	бит_ПризнакиНоменклатуры.Код В(&МассивКодовПризнаков)";
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов);
	Запрос.УстановитьПараметр("МассивКодовПризнаков", МассивКодовПризнаков);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Результат.Номенклатура = РезультатЗапроса[0].Выгрузить();
	Результат.СуществующиеЗаписи = РезультатЗапроса[1].Выгрузить();
	Результат.Признаки = РезультатЗапроса[2].Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере 
Процедура СоздатьЭлементыПризнакиНоменклатуры()
	
	КешДанных = ПостроитьКешДанныхДляТаблицыПризнаков(СозданиеПризнакиНоменклатуры);
	ВсеПодразделенияБезПрификса = ПолучитьВсеПодразделенияБезПрификса();

	Для каждого СтрокаПризнакиНоменклатуры Из СозданиеПризнакиНоменклатуры Цикл
		РезультатПодготовки = ПодготовитьДанныеСтрокиПризнакаДляЗаписи(СтрокаПризнакиНоменклатуры, КешДанных, ВсеПодразделенияБезПрификса);
		Если РезультатПодготовки.ТекстОшибки <> "" Тогда
			СтрокаПризнакиНоменклатуры.Создано = Ложь;
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.бит_ЗначенияПризнаковНоменклатуры.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.бит_Номенклатура = РезультатПодготовки.СсылкаНоменклатура;
		МенеджерЗаписи.бит_Признак = РезультатПодготовки.СсылкаПризнак;
		МенеджерЗаписи.бит_ПризнакСертификации = РезультатПодготовки.СсылкаПризнак.бит_ПризнакСертификации;
		МенеджерЗаписи.бит_Значение = РезультатПодготовки.ЗначениеДляЗаписи;
		
		Попытка	
			МенеджерЗаписи.Записать();  
			СтрокаПризнакиНоменклатуры.Создано = Истина;
			СтрокаПризнакиНоменклатуры.Предупреждение = Ложь;
		Исключение 
			СтрокаПризнакиНоменклатуры.Создано = Ложь;
		КонецПопытки;	
		
	КонецЦикла;	
	//ВсеПодразделенияБезПрификса = ПолучитьВсеПодразделенияБезПрификса();
	//
	//Для каждого СтрокаПризнакиНоменклатуры Из СозданиеПризнакиНоменклатуры Цикл
	//	
	//	// Проверяем, что все необходимые данные заполнены
