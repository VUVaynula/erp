&НаСервере 
Процедура ЗаполнитьПустыеЗначенияПартнер(ЭлементКонтрагенты, СтрокаПартнеры)
	
	Если ЭлементКонтрагенты.КодПоОКПО = "" ИЛИ ЭлементКонтрагенты.КодПоОКПО = Неопределено Тогда
		Если СтрокаПартнеры.КодПоОКПО <> "" Тогда
			ЭлементКонтрагенты.КодПоОКПО = СтрокаПартнеры.КодПоОКПО;
			СтрокаПартнеры.Изменено = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементКонтрагенты.СтранаРегистрации.Пустая() И СтрокаПартнеры.СтранаРегистрации <> "" Тогда
		СтранаРегистрации = ПроверитСтранаРегистрации(СтрокаПартнеры.СтранаРегистрации); 
		Если СтранаРегистрации <> Неопределено Тогда
			ЭлементКонтрагенты.СтранаРегистрации = СтранаРегистрации;  
			СтрокаПартнеры.Изменено = Истина; 
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементКонтрагенты.НаименованиеПолное = "" ИЛИ ЭлементКонтрагенты.НаименованиеПолное = Неопределено Тогда  
		ЭлементКонтрагенты.НаименованиеПолное = СтрокаПартнеры.НаименованиеПолное;
		СтрокаПартнеры.Изменено = Истина;
	КонецЕсли;  
	
	ЭлементПартнер = ЭлементКонтрагенты.Партнер.ПолучитьОбъект();

	//Если ЭлементПартнер.ГруппаДоступа.Пустая() Тогда
	//	Если ЭлементПартнер.Клиент Тогда	
	//		ЭлементПартнер.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.НайтиПоНаименованию("Продажи"); 
	//	Иначе 	
	//		ЭлементПартнер.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.НайтиПоНаименованию("Прочие отношения");
	//	КонецЕсли;
	//	СтрокаПартнеры.Изменено = Истина;
	//КонецЕсли;
	
	Попытка
		ЭлементПартнер.Записать();
	Исключение 
		СтрокаПартнеры.Изменено = Ложь;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьКонтактнуюИнформациюКонтрагентПартнер(ЭлементПриемник, СтрокаПартнеры)
	
	ЗаполнитьАдресаКонтрагентПартнер(ЭлементПриемник, СтрокаПартнеры);
    	
	Если СтрокаПартнеры.КонтактнаяИнформацияНомерТелефона <> "" Тогда  
		МассивНомерТелефона = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		СтрокаПартнеры.КонтактнаяИнформацияНомерТелефона, ",");	
		Для Индекс = 0 По МассивНомерТелефона.Количество() - 1 Цикл 
			ЭлементКонтактнаяИнформацияКонтрагент = ЭлементПриемник.КонтактнаяИнформация.Добавить();
			ЭлементКонтактнаяИнформацияКонтрагент.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон; 
			Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
				ЭлементКонтактнаяИнформацияКонтрагент.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;	
			Иначе
				ЭлементКонтактнаяИнформацияКонтрагент.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			КонецЕсли;
           	ЭлементКонтактнаяИнформацияКонтрагент.Представление = МассивНомерТелефона[Индекс];
			ЭлементКонтактнаяИнформацияКонтрагент.НомерТелефона = МассивНомерТелефона[Индекс]; 
			Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
				ЭлементКонтактнаяИнформацияКонтрагент.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;	
			Иначе
				ЭлементКонтактнаяИнформацияКонтрагент.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
			КонецЕсли;
            ЭлементКонтактнаяИнформацияКонтрагент.Значение = МассивНомерТелефона[Индекс];
			Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
			ЭлементКонтактнаяИнформацияКонтрагент.ДействуетС = Дата;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрокаПартнеры.Факс <> "" Тогда 
		МассивФакс = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПартнеры.Факс, ",");
		Для Индекс = 0 По МассивФакс.Количество() - 1 Цикл 
			ЭлементКонтактнаяИнформацияКонтрагент = ЭлементПриемник.КонтактнаяИнформация.Добавить();
			ЭлементКонтактнаяИнформацияКонтрагент.Тип = Перечисления.ТипыКонтактнойИнформации.Факс;
			ЭлементКонтактнаяИнформацияКонтрагент.Вид = Справочники.ВидыКонтактнойИнформации.ФаксКонтрагенты;
			ЭлементКонтактнаяИнформацияКонтрагент.Представление = МассивФакс[Индекс];
			ЭлементКонтактнаяИнформацияКонтрагент.НомерТелефона = МассивФакс[Индекс];
			ЭлементКонтактнаяИнформацияКонтрагент.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ФаксКонтрагенты;
			Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
			ЭлементКонтактнаяИнформацияКонтрагент.ДействуетС = Дата;  
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
		
КонецПроцедуры  

&НаСервере 
Процедура ЗаполнитьАдресаКонтрагентПартнер(ЭлементПриемник, СтрокаПартнеры)

	Если СтрокаПартнеры.КонтактнаяИнформацияТип <> "" Тогда
		
		ЭлементКонтактнаяИнформацияКонтрагент = ЭлементПриемник.КонтактнаяИнформация.Добавить();
		ЭлементКонтактнаяИнформацияКонтрагент.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес; 
		ЭлементКонтактнаяИнформацияКонтрагент.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента; 
		ЭлементКонтактнаяИнформацияКонтрагент.Представление = СтрокаПартнеры.КонтактнаяИнформацияТип;
		ЭлементКонтактнаяИнформацияКонтрагент.Страна = СтрокаПартнеры.КонтактнаяИнформацияСтрана;
		ЭлементКонтактнаяИнформацияКонтрагент.Регион = СтрокаПартнеры.КонтактнаяИнформацияРегион;
		ЭлементКонтактнаяИнформацияКонтрагент.Город = СтрокаПартнеры.КонтактнаяИнформацияГород;
		ЭлементКонтактнаяИнформацияКонтрагент.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
		ЭлементКонтактнаяИнформацияКонтрагент.ДействуетС = Дата; 
		КонецЕсли;
		
		ЭлементКонтактнаяИнформацияКонтрагент = ЭлементПриемник.КонтактнаяИнформация.Добавить();
		ЭлементКонтактнаяИнформацияКонтрагент.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
