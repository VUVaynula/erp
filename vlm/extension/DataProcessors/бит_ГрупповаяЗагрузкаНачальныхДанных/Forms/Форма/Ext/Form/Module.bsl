&НаСервере 
Процедура ЗаполнитьТаблицуИсточникОходыСпецификаций(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточник = ИсточникОходыСпецификаций.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточник.КодРодителя = ТекстКолонки;           
		СтрИсточник.Родитель = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;   
		СтрИсточник.ИДТехмаршрутаРодителя = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;    
	    СтрИсточник.НомерОперации = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст; 	
		СтрИсточник.КодОперации = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		СтрИсточник.ТипОборудования = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;  
		СтрИсточник.ОсновнойМаршрут = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;     
		СтрИсточник.ОткходыКодВн = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;    
		СтрИсточник.КраткоеНаименование = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;	
		СтрИсточник.Норма = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;	
		
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникОходыСпецификаций.Удалить(СтрИсточник);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ДействияСТаблицамиОходыСпецификаций(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникОходыСпецификаций.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникОходыСпецификаций(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеОходыСпецификаций.Видимость 	= Истина;
		Элементы.ПроверкиОходыСпецификаций.Видимость 	= Истина;
		Элементы.ОшибокОходыСпецификаций.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиОходыСпецификаций();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыОходыСпецификаций();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыОходыСпецификаций();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.РесурсныеСпецификации.ФормаСписка"); 
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиОходыСпецификаций()
	
	УсловноеОформление.Элементы.Очистить(); 
	
	МассивНоменклатураИсточник = ИсточникОходыСпецификаций.Выгрузить( , "КодРодителя"); 
	МассивНоменклатураОтход = ИсточникОходыСпецификаций.Выгрузить( , "ОткходыКодВн"); 
    МассивОпераций = ИсточникОходыСпецификаций.Выгрузить( , "КодОперации");  
	МассивСпецификаций = ИсточникОходыСпецификаций.Выгрузить( , "Родитель");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В(&МассивНоменклатураИсточник)
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В(&МассивНоменклатураОтход)
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РесурсныеСпецификацииВыходныеИзделия.Ссылка КАК Ссылка,
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура КАК Номенклатура,
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ЭтапыПроизводстваВидыРабочихЦентров.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	ЭтапыПроизводстваВидыРабочихЦентров.ВидРабочегоЦентра.Наименование КАК ВидРабочегоЦентраНаименование
		|ИЗ
		|	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства.ВидыРабочихЦентров КАК ЭтапыПроизводстваВидыРабочихЦентров
		|		ПО РесурсныеСпецификацииВыходныеИзделия.Ссылка = ЭтапыПроизводстваВидыРабочихЦентров.Ссылка.Владелец
		|ГДЕ
		|	РесурсныеСпецификацииВыходныеИзделия.Номенклатура.Артикул В(&МассивНоменклатураИсточник)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТехнологическиеОперации.Наименование КАК Наименование,
		|	ТехнологическиеОперации.Ссылка КАК Ссылка,
		|	ТехнологическиеОперации.бит_КодОперации КАК бит_КодОперации,
		|	ТехнологическиеОперации.бит_КодОперации.Наименование КАК бит_КодОперацииНаименование
		|ИЗ
		|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
		|ГДЕ
		|	ТехнологическиеОперации.бит_КодОперации.Наименование В(&МассивОпераций)";
		
	Запрос.УстановитьПараметр("МассивНоменклатураИсточник", МассивНоменклатураИсточник);
	Запрос.УстановитьПараметр("МассивНоменклатураОтход", МассивНоменклатураОтход);
	Запрос.УстановитьПараметр("МассивОпераций", МассивОпераций);
	Запрос.УстановитьПараметр("МассивСпецификаций", МассивСпецификаций);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаНоменклатураИсточник = РезультатЗапроса[0].Выгрузить();
	ВыборкаНоменклатураОтход = РезультатЗапроса[1].Выгрузить();
	ВыборкаОпераций = РезультатЗапроса[3].Выгрузить();
	ВыборкаСпецификаций = РезультатЗапроса[2].Выгрузить();
	
	ЗаполнениеТаблицОходыСпецификаций(ВыборкаНоменклатураИсточник, ВыборкаНоменклатураОтход, ВыборкаОпераций, ВыборкаСпецификаций);
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнениеТаблицОходыСпецификаций(ВыборкаНоменклатураИсточник, ВыборкаНоменклатураОтход, ВыборкаОпераций, ВыборкаСпецификаций)
		
   	Для каждого СтрокаОходыСпецификаций Из ИсточникОходыСпецификаций Цикл 
		
		ТекстСообщения = "";
		
		Если ЗначениеЗаполнено(СтрокаОходыСпецификаций.КодРодителя) Тогда
			Изделие = ВыборкаНоменклатураИсточник.Найти(СтрокаОходыСпецификаций.КодРодителя);
			Если Изделие = Неопределено Тогда
				ТекстСообщения = ТекстСообщения + "Выпускаемая номенклатура не найдена! ";
			Иначе 
				Изделие = Изделие.Ссылка;
			КонецЕсли;
		Иначе
			ТекстСообщения = ТекстСообщения + "Выпускаемая номенклатура не найдена! ";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаОходыСпецификаций.ОткходыКодВн) Тогда
			Отход = ВыборкаНоменклатураОтход.Найти(СтрокаОходыСпецификаций.ОткходыКодВн);
			Если Отход = Неопределено Тогда
				ТекстСообщения = ТекстСообщения + "Отход не найден! ";
			Иначе 
				Отход = Отход.Ссылка;
			КонецЕсли;
		Иначе
			ТекстСообщения = ТекстСообщения + "Отход не найден! ";
		КонецЕсли;
	
		КодОперации = ВыборкаОпераций.Найти(СтрокаОходыСпецификаций.КодОперации);
		Если КодОперации = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Операция не найдена! ";
		Иначе
			//КодОперации = КодОперации.Ссылка;
			//Операция = Справочники.ТехнологическиеОперации.НайтиПоРеквизиту("бит_КодОперации", КодОперации);
			Операция = КодОперации.Ссылка;
		КонецЕсли;
		
		КоличествоОтходов = -1;
		Спецификация = ВыборкаСпецификаций.НайтиСтроки(новый Структура("НоменклатураАртикул, ВидРабочегоЦентраНаименование", СтрокаОходыСпецификаций.КодРодителя, СтрокаОходыСпецификаций.ТипОборудования)); 
        Если Спецификация.Количество() =0 Тогда
			ТекстСообщения = ТекстСообщения + "Спецификация не найдена! ";
		Иначе  
			Спецификация = Спецификация[0].Ссылка; 
			ТекущаяСпецификация = Спецификация.ПолучитьОбъект();
			КоличествоОтходов = ТекущаяСпецификация.ВозвратныеОтходы.Количество();
		КонецЕсли;
		
		Если ТекстСообщения <> "" Тогда	
			СтрокаОшибокОходыСпецификаций = ОшибокОходыСпецификаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиОходыСпецификаций(СтрокаОшибокОходыСпецификаций, 
			                                                         СтрокаОходыСпецификаций);
			СтрокаОшибокОходыСпецификаций.Ошибка = ТекстСообщения;
		ИначеЕсли КоличествоОтходов < 1 Тогда
			СтрокаСозданиеОходыСпецификаций = СозданиеОходыСпецификаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиОходыСпецификаций(СтрокаСозданиеОходыСпецификаций,
			                                                         СтрокаОходыСпецификаций);
			СтрокаСозданиеОходыСпецификаций.НоменклатураИсточник = Изделие; 
			СтрокаСозданиеОходыСпецификаций.НоменклатураОтход = Отход;
			СтрокаСозданиеОходыСпецификаций.Операция = Операция;
			СтрокаСозданиеОходыСпецификаций.Спецификация = Спецификация;
		Иначе 
			СтрокаПроверкиОходыСпецификаций = ПроверкиОходыСпецификаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиОходыСпецификаций(СтрокаПроверкиОходыСпецификаций, 
			                                                         СтрокаОходыСпецификаций); 
			СтрокаПроверкиОходыСпецификаций.НоменклатураИсточник = Изделие; 
			СтрокаПроверкиОходыСпецификаций.НоменклатураОтход = Отход;
			СтрокаПроверкиОходыСпецификаций.Операция = Операция;
			СтрокаПроверкиОходыСпецификаций.Спецификация = Спецификация;
	    КонецЕсли; 
	КонецЦикла;
	
	СозданиеОходыСпецификаций.Сортировать("КодРодителя Возр");
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиОходыСпецификаций(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.КодРодителя = СтрокаИсточник.КодРодителя;             
	СтрокаПриемник.Родитель = СтрокаИсточник.Родитель;    
	СтрокаПриемник.ИДТехмаршрутаРодителя = СтрокаИсточник.ИДТехмаршрутаРодителя;
	СтрокаПриемник.НомерОперации = СтрокаИсточник.НомерОперации;  
	СтрокаПриемник.КодОперации = СтрокаИсточник.КодОперации;                    
	СтрокаПриемник.ТипОборудования = СтрокаИсточник.ТипОборудования;          
	СтрокаПриемник.ОсновнойМаршрут = СтрокаИсточник.ОсновнойМаршрут;            
	СтрокаПриемник.ОткходыКодВн = СтрокаИсточник.ОткходыКодВн;              
	СтрокаПриемник.КраткоеНаименование = СтрокаИсточник.КраткоеНаименование; 			 
	СтрокаПриемник.Норма = СтрокаИсточник.Норма; 			   
	
КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементыТаблицыОходыСпецификаций()
	
	ПерегруппированныеОтходы = ПерегруппировкаОтходовПоСпецификациям(); 
	СозданиеОходыСпецификаций.Очистить();
	Для Каждого ТекущаяОтходы из ПерегруппированныеОтходы Цикл
		
		ЗаполнитьОтходы(ТекущаяОтходы.Значение);
		
	КонецЦикла;
	
	Для каждого ТекущаяОтходы Из ПерегруппированныеОтходы Цикл
		ВыводРезультатаСозданияОтходов(ТекущаяОтходы); 
	КонецЦикла;
    	
	ИзменениеУсловногоОформленияСозданияОходыСпецификаций();
    	
КонецПроцедуры 

&НаСервере 
Процедура ВыводРезультатаСозданияОтходов(ТекущаяОтходы)
	
	Для Каждого Строка из ТекущаяОтходы.Значение Цикл
		 НоваяСтрока = СозданиеОходыСпецификаций.Добавить();
		 ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры

