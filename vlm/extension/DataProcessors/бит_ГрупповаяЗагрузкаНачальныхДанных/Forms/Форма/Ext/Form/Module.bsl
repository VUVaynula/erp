		МенеджерЗаписи.Записать(); 
		Исключение
		КонецПопытки;
		
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "04082022"  
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KODDOP_PF"
