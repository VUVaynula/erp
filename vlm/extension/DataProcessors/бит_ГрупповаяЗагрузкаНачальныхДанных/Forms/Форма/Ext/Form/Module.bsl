    Признаки.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки)); 
	Признаки.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
    Признаки.Колонки.Добавить("бит_ПризнакСертификации", Новый ОписаниеТипов("Булево")); 
			
	Возврат Признаки;

КонецФункции	

&НаСервере
Функция ПолучитьВсеПодразделенияБезПрификса();
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СОКРЛП(СтруктураПредприятия.Код) КАК Код,
		|	СтруктураПредприятия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	СтруктураПредприятия.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаПодразделений = Новый ТаблицаЗначений;
	КвалификаторЧисла4_0 = Новый КвалификаторыЧисла(4,2);
	ТаблицаПодразделений.Колонки.Добавить("Код", Новый ОписаниеТипов("Число", , , КвалификаторЧисла4_0));
	ТаблицаПодразделений.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	Для Каждого Запись Из РезультатЗапроса Цикл
		
		Значение = ТаблицаПодразделений.Добавить();
        //Значение.Код = Число(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Запись.Код));
		Значение.Код = Запись.Код; 
		Значение.Ссылка = Запись.Ссылка;
		
	 КонецЦикла; 
		
	Возврат ТаблицаПодразделений; 
	
КонецФункции

&НаСервере 
Процедура СоздатьПризнакиНоменклатуры(СтруктураПризнаков)
	
	Для каждого Признак Из СтруктураПризнаков Цикл    
		Если ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.НайтиПоКоду(Признак.Код).Пустая() Тогда 
			Элемент = ПланыВидовХарактеристик.бит_ПризнакиНоменклатуры.СоздатьЭлемент();
			Элемент.Код = Признак.Код;
			Элемент.Наименование = Признак.Наименование;
	        Элемент.ТипЗначения = Признак.ТипЗначения;
			Элемент.бит_ПризнакСертификации = Признак.бит_ПризнакСертификации;  
			Попытка	
				Элемент.Записать(); 
			Исключение
				ТекстСообщения = "Не удалось создать признак " +  Элемент.Наименование;
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	
#КонецОбласти

#Область СозданияАтрибутыКонтрагентов
&НаКлиенте 
Процедура ДействияСТаблицамиАтрибутыКонтрагентов(ПредставлениеИсточника)
	
	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникАтрибутыКонтрагентов.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникАтрибутыКонтрагентов(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеАтрибутыКонтрагентов.Видимость 	= Истина;
		Элементы.ПроверкиАтрибутыКонтрагентов.Видимость 	= Истина;
		Элементы.ОшибокАтрибутыКонтрагентов.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиАтрибутыКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыАтрибутыКонтрагентов();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыАтрибутыКонтрагентов();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.Контрагенты.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникАтрибутыКонтрагентов(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникАтрибутыКонтрагентов = ИсточникАтрибутыКонтрагентов.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточникАтрибутыКонтрагентов.Наименование = ТекстКолонки;  
		СтрИсточникАтрибутыКонтрагентов.ИДКлиента = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
	    СтрИсточникАтрибутыКонтрагентов.ИНН = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;
		СтрИсточникАтрибутыКонтрагентов.Код = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточникАтрибутыКонтрагентов.НаименоваиеАтрибута = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		СтрИсточникАтрибутыКонтрагентов.Значение = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст;
							
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникАтрибутыКонтрагентов.Удалить(СтрИсточникАтрибутыКонтрагентов);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиАтрибутыКонтрагентов()
	
	УсловноеОформление.Элементы.Очистить();
	
	МассивКонтрагентов = ИсточникАтрибутыКонтрагентов.Выгрузить( , "ИДКлиента");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.бит_ИДКлиента КАК ИДКлиента
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.бит_ИДКлиента В (&МассивКонтрагентов)
	|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗначенияАтрибутовКонтрагентов.бит_Контрагент КАК Контрагент,
	|	бит_ЗначенияАтрибутовКонтрагентов.бит_Признак.Код КАК ПризнакКод,
	|	бит_ЗначенияАтрибутовКонтрагентов.бит_Значение КАК Значение,
	|	бит_ЗначенияАтрибутовКонтрагентов.бит_Контрагент.бит_ИДКлиента КАК ИДКлиента
	|ИЗ
	|	РегистрСведений.бит_ЗначенияАтрибутовКонтрагентов КАК бит_ЗначенияАтрибутовКонтрагентов
	|ГДЕ
	|	бит_ЗначенияАтрибутовКонтрагентов.бит_Контрагент.бит_ИДКлиента В(&МассивКонтрагентов)";
	
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаКонтрагенты = РезультатЗапроса[0].Выгрузить();
	ВыборкаАтрибут = РезультатЗапроса[1].Выгрузить();		
	ЗаполнениеТаблицАтрибутыКонтрагентов(ВыборкаКонтрагенты, ВыборкаАтрибут);
   
КонецПроцедуры

&НаСервере 
Процедура ЗаполнениеТаблицАтрибутыКонтрагентов(ВыборкаКонтрагенты, ВыборкаАтрибут)
			
	Для каждого СтрокаАтрибутыКонтрагентов Из ИсточникАтрибутыКонтрагентов Цикл
		
		ТекстСообщения = ""; 
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИДКлиента", СтрокаАтрибутыКонтрагентов.ИДКлиента);
        ИдентификаторКонтрагента = ВыборкаКонтрагенты.НайтиСтроки(ПараметрыОтбора);
		Если ИдентификаторКонтрагента = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Контрагент не найден! "; 
		ИначеЕсли ИдентификаторКонтрагента.Количество() = 0 Тогда
			ТекстСообщения = ТекстСообщения + "Контрагент не найден! "
		Иначе	
			Если Не ИдентификаторКонтрагента[0].ИНН = СтрокаАтрибутыКонтрагентов.ИНН Тогда
			ТекстСообщения = ТекстСообщения + "Контрагент не найден! "  
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура;
	    ПараметрыОтбора.Вставить("ИДКлиента", СтрокаАтрибутыКонтрагентов.ИДКлиента); 
		ПараметрыОтбора.Вставить("ПризнакКод", СтрокаАтрибутыКонтрагентов.Код);
	    Атрибут = ВыборкаАтрибут.НайтиСтроки(ПараметрыОтбора);
					
		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокАтрибутыКонтрагентов = ОшибокАтрибутыКонтрагентов.Добавить();
			ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаОшибокАтрибутыКонтрагентов, 
			СтрокаАтрибутыКонтрагентов);
			СтрокаОшибокАтрибутыКонтрагентов.Ошибка = ТекстСообщения;
		ИначеЕсли Атрибут.Количество() > 0 Тогда 
			СтрокаПроверкиАтрибутыКонтрагентов = ПроверкиАтрибутыКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаПроверкиАтрибутыКонтрагентов, 
			СтрокаАтрибутыКонтрагентов);
		Иначе 
			СтрокаСозданиеАтрибутыКонтрагентов = СозданиеАтрибутыКонтрагентов.Добавить(); 
			ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаСозданиеАтрибутыКонтрагентов,
			СтрокаАтрибутыКонтрагентов);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаПриемник, СтрокаИсточник)  
		                 
	СтрокаПриемник.ИДКлиента = СтрокаИсточник.ИДКлиента; 
	СтрокаПриемник.ИНН = СтрокаИсточник.ИНН;
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование;
	СтрокаПриемник.Код = СтрокаИсточник.Код;
	СтрокаПриемник.НаименоваиеАтрибута = СтрокаИсточник.НаименоваиеАтрибута;
	СтрокаПриемник.Значение = СтрокаИсточник.Значение;
	
КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементыАтрибутыКонтрагентов()
	
	Для каждого СтрокаАтрибутыКонтрагентов Из СозданиеАтрибутыКонтрагентов Цикл
		
		бит_Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("бит_ИДКлиента", СтрокаАтрибутыКонтрагентов.ИДКлиента); 
		        	
		Если СтрокаАтрибутыКонтрагентов.Код = "OKVED"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP1"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP2"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP3" 
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP4"
			Тогда
			ПараметрыОтбора = Новый Структура;
			Отбор = Новый Структура;
			Отбор.Вставить("Код", СтрокаАтрибутыКонтрагентов.Код);   
			ПараметрыОтбора.Вставить("Отбор", Отбор);
			бит_Атрибут = ПланыВидовХарактеристик.бит_ПризнакиКонтрагентов.ПолучитьДанныеВыбора(ПараметрыОтбора);
			Если бит_Атрибут = Неопределено
				Или бит_Атрибут.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;

			ДействияПоСтратегииАтрибут(СтрокаАтрибутыКонтрагентов, бит_Контрагент, бит_Атрибут);
		ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "BYH_PHONE"	
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "EMAIL"
			Тогда
			ДействияПоСтратегииКонтактнаяИнформация(СтрокаАтрибутыКонтрагентов, бит_Контрагент);
		ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "KPP"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "KPP_FILIAL"
            ИЛИ СтрокаАтрибутыКонтрагентов.Код = "OGRN" 
			Тогда
			ДействияПоСтратегииИзменениеКонтрагента(СтрокаАтрибутыКонтрагентов, бит_Контрагент);
		КонецЕсли;
				
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеАтрибутыКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеАтрибутыКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для Каждого элПоля Из Элементы.СозданиеАтрибутыКонтрагентов.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;
			
КонецПроцедуры 

&НаСервере
Процедура ДействияПоСтратегииАтрибут(СтрокаАтрибутыКонтрагентов, бит_Контрагент, бит_Атрибут)
	
	бит_Значение = ПолучитьЗначениеАтрибута(СтрокаАтрибутыКонтрагентов, бит_Атрибут, бит_Контрагент); 
	
	Если бит_Значение <> Неопределено Тогда 
		Если ТипЗнч(бит_Значение) = Тип("СправочникСсылка.Номенклатура")    
			Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.ПодразделенияОрганизаций") 
			Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.бит_ДополнительныеАтрибутыКонтрагентов") 
			Или ТипЗнч(бит_Значение) = Тип("СправочникСсылка.Марки")
			Тогда
			Если НЕ (бит_Значение.Пустая()) Тогда 
				МенеджерЗаписи = РегистрыСведений.бит_ЗначенияАтрибутовКонтрагентов.СоздатьМенеджерЗаписи();
				
				МенеджерЗаписи.бит_Контрагент = бит_Контрагент;
				МенеджерЗаписи.бит_Признак = бит_Атрибут[0].Значение;
				МенеджерЗаписи.бит_Значение = бит_Значение;
				
				Попытка	
					МенеджерЗаписи.Записать();  
					СтрокаАтрибутыКонтрагентов.Создано = Истина;
				Исключение
					СтрокаАтрибутыКонтрагентов.Создано = Ложь;
				КонецПопытки;	
			КонецЕсли;  
		ИначеЕсли ТипЗнч(бит_Значение) = Тип("Строка") и бит_Значение <> "" Тогда 
			МенеджерЗаписи = РегистрыСведений.бит_ЗначенияАтрибутовКонтрагентов.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.бит_Контрагент = бит_Контрагент;
			МенеджерЗаписи.бит_Признак = бит_Атрибут[0].Значение;
			МенеджерЗаписи.бит_Значение = бит_Значение;
			
			Попытка	
				МенеджерЗаписи.Записать();  
				СтрокаАтрибутыКонтрагентов.Создано = Истина;
			Исключение
				СтрокаАтрибутыКонтрагентов.Создано = Ложь;
			КонецПопытки;	
			
		КонецЕсли;
	КонецЕсли;  
		
КонецПроцедуры	

&НаСервере
Процедура ДействияПоСтратегииКонтактнаяИнформация(СтрокаАтрибутыКонтрагентов, бит_Контрагент)
	
	Контрагент = бит_Контрагент.Партнер.ПолучитьОбъект();
    Партнер = бит_Контрагент.Партнер.ПолучитьОбъект();
	
	Если СтрокаАтрибутыКонтрагентов.Код = "BYH_PHONE" Тогда 
				 
		Контакты =  Партнер.КонтактнаяИнформация;
		ЗаписьНеУникальна = Ложь;
		Для Каждого Запись из Контакты Цикл
			
			Если Запись.Представление = СтрокаАтрибутыКонтрагентов.Значение Тогда
				ЗаписьНеУникальна = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЗаписьНеУникальна Тогда
			СтрокаОшибокАтрибутыКонтрагентов = ОшибокАтрибутыКонтрагентов.Добавить();
			ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаОшибокАтрибутыКонтрагентов, 
			СтрокаАтрибутыКонтрагентов);
			СтрокаОшибокАтрибутыКонтрагентов.Ошибка = "Телефон не уникален";	 
		Иначе	 
			КонтактнаяИнформация = Партнер.КонтактнаяИнформация.Добавить();
			КонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			КонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.бит_ТелефонБухгалтерииПартнера;
			КонтактнаяИнформация.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.бит_ТелефонБухгалтерииПартнера;
			Текст =  СтрокаАтрибутыКонтрагентов.Значение;
			Комментарий = "";
			КонтактнаяИнформация.Значение = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияПоПредставлению(Текст, КонтактнаяИнформация.Вид, Комментарий);
			КонтактнаяИнформация.Представление = Текст;
			ЗначенияПолей = УправлениеКонтактнойИнформациейЛокализация.КонтактнаяИнформацияИзJSONВXML(КонтактнаяИнформация.Значение, Перечисления.ТипыКонтактнойИнформации.Телефон);
			КонтактнаяИнформация.ЗначенияПолей = ЗначенияПолей;
			//ЗаполнитьРеквизитыТабличнойЧастиДляТелефона(КонтактнаяИнформация, СтрокаАтрибутыКонтрагентов.Значение);
			
			Попытка	
				Партнер.Записать();
				СтрокаАтрибутыКонтрагентов.Создано = Истина;
			Исключение
				СтрокаАтрибутыКонтрагентов.Создано = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "EMAIL" Тогда
		
		Контакты =  Партнер.КонтактнаяИнформация;
		ЗаписьНеУникальна = Ложь;
		Для Каждого Запись из Контакты Цикл
			
			Если Запись.Представление = СтрокаАтрибутыКонтрагентов.Значение Тогда
				ЗаписьНеУникальна = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЗаписьНеУникальна Тогда
			СтрокаОшибокАтрибутыКонтрагентов = ОшибокАтрибутыКонтрагентов.Добавить();
			ЗаполнитьСтрокуТаблицыАтрибутыКонтрагентов(СтрокаОшибокАтрибутыКонтрагентов, 
			СтрокаАтрибутыКонтрагентов);
			СтрокаОшибокАтрибутыКонтрагентов.Ошибка = "EMAIL не уникален";	 
		Иначе	 
			
			
			КонтактнаяИнформация = Партнер.КонтактнаяИнформация.Добавить();
			КонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			КонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
			
			КонтактнаяИнформация.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
			
			Текст =  СтрокаАтрибутыКонтрагентов.Значение;
			Комментарий = "";
			КонтактнаяИнформация.Значение = УправлениеКонтактнойИнформациейСлужебныйВызовСервера.КонтактнаяИнформацияПоПредставлению(Текст, КонтактнаяИнформация.Вид, Комментарий);
			КонтактнаяИнформация.Представление = Текст;
			ЗначенияПолей = УправлениеКонтактнойИнформациейЛокализация.КонтактнаяИнформацияИзJSONВXML(КонтактнаяИнформация.Значение, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			КонтактнаяИнформация.ЗначенияПолей = ЗначенияПолей;
			Результат = ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(КонтактнаяИнформация.Представление, Ложь);
			
			Если Результат.Количество() > 0 Тогда
				КонтактнаяИнформация.АдресЭП = Результат[0].Адрес;
				
				Поз = СтрНайти(КонтактнаяИнформация.АдресЭП, "@");
				Если Поз <> 0 Тогда
					КонтактнаяИнформация.ДоменноеИмяСервера = Сред(КонтактнаяИнформация.АдресЭП, Поз+1);
				КонецЕсли;
			КонецЕсли;
			
			Попытка	
				Партнер.Записать();
				СтрокаАтрибутыКонтрагентов.Создано = Истина;
			Исключение
				СтрокаАтрибутыКонтрагентов.Создано = Ложь;
			КонецПопытки;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьРеквизитыТабличнойЧастиДляТелефона(СтрокаТабличнойЧасти, Телефон)
	
	Если НЕ ЗначениеЗаполнено(Телефон) Тогда
		Возврат;
	КонецЕсли;
	
	// Умолчания
	СтрокаТабличнойЧасти.НомерТелефонаБезКодов = "";
	СтрокаТабличнойЧасти.НомерТелефона         = "";
	
	КодСтраны     = Телефон.CountryCode;
	КодГорода     = Телефон.AreaCode;
	НомерТелефона = Телефон.Number;
	
	Если СтрНачинаетсяС(КодСтраны, "+") Тогда
		КодСтраны = Сред(КодСтраны, 2);
	КонецЕсли;
	
	Поз = СтрНайти(НомерТелефона, ",");
	Если Поз <> 0 Тогда
		НомерТелефона = Лев(НомерТелефона, Поз-1);
	КонецЕсли;
	
	Поз = СтрНайти(НомерТелефона, Символы.ПС);
	Если Поз <> 0 Тогда
		НомерТелефона = Лев(НомерТелефона, Поз-1);
	КонецЕсли;
	
	СтрокаТабличнойЧасти.НомерТелефонаБезКодов = УбратьРазделителиВНомерТелефона(НомерТелефона);
	СтрокаТабличнойЧасти.НомерТелефона         = УбратьРазделителиВНомерТелефона(Строка(КодСтраны) + КодГорода + НомерТелефона);
	
КонецПроцедуры

&НаСервере
Функция УбратьРазделителиВНомерТелефона(Знач НомерТелефона)
	
	Поз = СтрНайти(НомерТелефона, ",");
	Если Поз <> 0 Тогда
		НомерТелефона = Лев(НомерТелефона, Поз-1);
	КонецЕсли;
	
	НомерТелефона = СтрЗаменить(НомерТелефона, "-", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, " ", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "+", "");
	
	Возврат НомерТелефона;
	
КонецФункции

&НаСервере
Процедура ДействияПоСтратегииИзменениеКонтрагента(СтрокаАтрибутыКонтрагентов, бит_Контрагент)
	
	Контрагент = бит_Контрагент.ПолучитьОбъект();
	
	Если СтрокаАтрибутыКонтрагентов.Код = "KPP"
		ИЛИ СтрокаАтрибутыКонтрагентов.Код = "KPP_FILIAL" Тогда
		Если Контрагент.КПП = Неопределено Или Контрагент.КПП = "" Тогда
			Контрагент.КПП = СтрокаАтрибутыКонтрагентов.Значение;
			Попытка	
				Контрагент.Записать();  
				СтрокаАтрибутыКонтрагентов.Создано = Истина;
			Исключение
				СтрокаАтрибутыКонтрагентов.Создано = Ложь;
			КонецПопытки;
		Иначе
		СтрокаАтрибутыКонтрагентов.Создано = Ложь;
		КонецЕсли;	
	ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "OGRN" Тогда
		Если Контрагент.РегистрационныйНомер = Неопределено Или Контрагент.РегистрационныйНомер = "" Тогда
			Контрагент.РегистрационныйНомер = СтрокаАтрибутыКонтрагентов.Значение;
			Попытка	
				Контрагент.Записать();  
				СтрокаАтрибутыКонтрагентов.Создано = Истина;
			Исключение
				СтрокаАтрибутыКонтрагентов.Создано = Ложь;
			КонецПопытки;
		Иначе
		СтрокаАтрибутыКонтрагентов.Создано = Ложь;	
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеАтрибута(СтрокаАтрибутыКонтрагентов, бит_Атрибут, бит_Контрагент)
	
	Если Объект.ИдентификаторСправочника = "АтрибутыКонтрагентов" Тогда  
		
		бит_Значение = ПолучитьЗначениеАтрибутыКонтрагентов(СтрокаАтрибутыКонтрагентов, бит_Атрибут, бит_Контрагент); 
		
	КонецЕсли;
	
	Возврат бит_Значение;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеАтрибутыКонтрагентов(СтрокаАтрибутыКонтрагентов, бит_Атрибут, бит_Контрагент)
		
	Если СтрокаАтрибутыКонтрагентов.Код = "OKVED" 
		Или СтрокаАтрибутыКонтрагентов.Код = "VP1"
		Или СтрокаАтрибутыКонтрагентов.Код = "VP2"
		Или СтрокаАтрибутыКонтрагентов.Код = "VP3"
		Тогда 
		бит_Значение = СтрокаАтрибутыКонтрагентов.Значение;
	ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "VP4" Тогда
		ПараметрыОтбора = Новый Структура;
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", СтрокаАтрибутыКонтрагентов.Значение); 
		Отбор.Вставить("Владелец", бит_Атрибут[0].Значение);   
		ПараметрыОтбора.Вставить("Отбор", Отбор);
		Значение = Справочники.бит_ДополнительныеАтрибутыКонтрагентов.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если Значение = Неопределено Или Значение.Количество() = 0 Тогда
			ДополнительныйАтрибут = Справочники.бит_ДополнительныеАтрибутыКонтрагентов.СоздатьЭлемент();
			ДополнительныйАтрибут.Наименование = СтрокаАтрибутыКонтрагентов.Значение;
			ДополнительныйАтрибут.Владелец = бит_Атрибут[0].Значение; 
			ДополнительныйАтрибут.Записать();
			Значение = ДополнительныйАтрибут;
		Иначе
		    Значение = Значение[0].Значение;	
		КонецЕсли;
		бит_Значение = Значение;
	Иначе
		бит_Значение = Неопределено;
	КонецЕсли;	
	
	Возврат бит_Значение;

КонецФункции	
	
&НаСервере 
Процедура ПроверитьЭлементыАтрибутыКонтрагентов() 

	Для каждого СтрокаАтрибутыКонтрагентов Из СозданиеАтрибутыКонтрагентов Цикл
		
		ПараметрыОтбора = Новый Структура;
		Отбор = Новый Структура;
		Отбор.Вставить("бит_ИДКлиента", СтрокаАтрибутыКонтрагентов.ИДКлиента); 
		ПараметрыОтбора.Вставить("Отбор", Отбор);
		бит_Контрагент = Справочники.Контрагенты.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если Не (бит_Контрагент = Неопределено
			Или бит_Контрагент.Количество() = 0) Тогда 
			бит_Контрагент = бит_Контрагент[0].Значение;
			//бит_Контрагент = бит_Контрагент.Значение;
		КонецЕсли;
        	
		Если СтрокаАтрибутыКонтрагентов.Код = "OKVED"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP1"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP2"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP3" 
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "VP4"
			Тогда
			ПараметрыОтбора = Новый Структура;
			Отбор = Новый Структура;
			Отбор.Вставить("Код", СтрокаАтрибутыКонтрагентов.Код);   
			ПараметрыОтбора.Вставить("Отбор", Отбор);
			бит_Атрибут = ПланыВидовХарактеристик.бит_ПризнакиКонтрагентов.ПолучитьДанныеВыбора(ПараметрыОтбора);
			Если бит_Атрибут = Неопределено
				Или бит_Атрибут.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;

			ДействияПоСтратегииАтрибут(СтрокаАтрибутыКонтрагентов, бит_Контрагент, бит_Атрибут);
		ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "BYH_PHONE"	
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "EMAIL"
			Тогда
			ДействияПоСтратегииКонтактнаяИнформация(СтрокаАтрибутыКонтрагентов, бит_Контрагент);
		ИначеЕсли СтрокаАтрибутыКонтрагентов.Код = "KPP"
			ИЛИ СтрокаАтрибутыКонтрагентов.Код = "KPP_FILIAL"
            ИЛИ СтрокаАтрибутыКонтрагентов.Код = "OGRN" 
			Тогда
			ДействияПоСтратегииИзменениеКонтрагента(СтрокаАтрибутыКонтрагентов, бит_Контрагент);
		КонецЕсли;
				
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиАтрибутыКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиАтрибутыКонтрагентов.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.ПроверкиАтрибутыКонтрагентов.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьАтрибутыКонтрагентов(Команда)
	
	ЗаполнитьАтрибутыКонтрагентовНаСервере()
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьАтрибутыКонтрагентовНаСервере()
	
	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутыКонтрагентов();
	
#Область ОписаниеТиповПризнаков	
    КвалификаторыСтроки50 = Новый КвалификаторыСтроки(50);
	ОписаниеСтроки50 = Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки50);
    ОписаниеДопЗначение = Новый ОписаниеТипов("СправочникСсылка.бит_ДополнительныеАтрибутыКонтрагентов");
#КонецОбласти

#Область ЗаполненияПризнаков	
	Признак = СтруктураАтрибутов.Добавить();
    Признак.Код = "OKVED";
	Признак.Наименование = "ОКВЭД";
	Признак.ТипЗначения = ОписаниеСтроки50;
	
	
	Признак = СтруктураАтрибутов.Добавить();
    Признак.Код = "VP1";
	Признак.Наименование = "Покупатель (для сделки ВП Волмаг)";
	Признак.ТипЗначения = ОписаниеСтроки50;
	 
	
	Признак = СтруктураАтрибутов.Добавить();
    Признак.Код = "VP2";
	Признак.Наименование = "Начальник отдела (для сделки ВП Волмаг)";
	Признак.ТипЗначения = ОписаниеСтроки50;
	
	
	Признак = СтруктураАтрибутов.Добавить();
    Признак.Код = "VP3";
	Признак.Наименование = "Название отдела (для сделки ВП Волмаг";
	Признак.ТипЗначения = ОписаниеСтроки50;
	
		
	Признак = СтруктураАтрибутов.Добавить();
    Признак.Код = "VP4";
	Признак.Наименование = "Должность ответственного лица (для сделки ВП Волмаг)";
	Признак.ТипЗначения = ОписаниеДопЗначение;
	 
#КонецОбласти
		
