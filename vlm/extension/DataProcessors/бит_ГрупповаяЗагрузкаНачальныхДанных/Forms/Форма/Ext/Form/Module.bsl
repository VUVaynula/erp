			НоваяОперация.МожноПовторить = Ложь;
			НоваяОперация.МожноПропустить = Ложь;
			НоваяОперация.СодержитТехнологическийПроцесс = Ложь;
			//НоваяОперация.ТехнологическийПроцесс = //пустое
			НоваяОперация.КоэффициентТехнологическогоПроцесса = 0;
			НоваяОперация.Спецификация = ЗаполняемаяСпецификация;
			//НоваяОперация.Основание = //пустое
			НоваяОперация.Контроль = Перечисления.ВариантыКонтроляТехнологическихОпераций.НеТребуется;
			//НоваяОперация.Участок = //пустое
			Если ЗначениеЗаполнено(ТекущаяСтрока.КодОперацииСсылка) Тогда
				НоваяОперация.бит_КодОперации = ТекущаяСтрока.КодОперацииСсылка; 
			ИначеЕсли ЗначениеЗаполнено(Справочники.бит_КодыОпераций.НайтиПоНаименованию("ТекущаяСтрока.КодОперации")) Тогда
				НоваяОперация.бит_КодОперации = Справочники.бит_КодыОпераций.НайтиПоНаименованию("ТекущаяСтрока.КодОперации");
			Иначе
				НоваяОперация.бит_КодОперации = СоздатьКодОперации(ТекущаяСтрока.КодОперации, ТекущаяСтрока.НаименованиеОперации);
			КонецЕсли;
			//ЛТ33
			НоваяОперация.бит_АгрегирующийКоэффициент = ?(ТекущаяСтрока.АгрегКоэф_Материалов = 0, 1, ТекущаяСтрока.АгрегКоэф_Материалов); 
			
			Попытка  
				НоваяОперация.Записать(); 
				ТекОперация = НоваяОперация.Ссылка; 
			Исключение
				СтрокаОшибокСпецификации = ОшибокСпецификации.Добавить(); 
				СтрокаОшибокСпецификации.ИДТехмаршрутаРодителя = ТекущаяСтрока.ИДТехмаршрутаРодителя;
				СтрокаОшибокСпецификации.НомерОперации = ТекущаяСтрока.НомерОперации;
				СтрокаОшибокСпецификации.КодОперации = ТекущаяСтрока.КодОперации;
				СтрокаОшибокСпецификации.НаименованиеОперации = ТекущаяСтрока.НаименованиеОперации;
				СтрокаОшибокСпецификации.КодЦеха = ТекущаяСтрока.КодЦеха;
				СтрокаОшибокСпецификации.НаименованиеЦеха = ТекущаяСтрока.НаименованиеЦеха; 
				СтрокаОшибокСпецификации.КодОборудования = ТекущаяСтрока.КодОборудования;
				СтрокаОшибокСпецификации.НаименованиеОборудования = ТекущаяСтрока.НаименованиеОборудования;
				СтрокаОшибокСпецификации.НормаВыработки = ТекущаяСтрока.НормаВыработки;
				СтрокаОшибокСпецификации.ПризнакОснМаршрута = ТекущаяСтрока.ПризнакОснМаршрута;
				//СтрокаОшибокСпецификации.АгрегКоэф_Материалов = ТекущаяСтрока.АгрегКоэф_Материалов;
				СтрокаОшибокСпецификации.Ошибка = "Операция не создана!";	
				
			КонецПопытки;
					
			ИтераторОпераций = ИтераторОпераций + 1; 
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если ТипЗнч(НоваяОперация) = Тип("СправочникСсылка.ТехнологическиеОперации") Тогда 
		ЗаполняемаяСпецификация.ВыходныеИзделия[0].Операция = НоваяОперация;
		Для Каждого Строка Из ЗаполняемаяСпецификация.МатериалыИУслуги Цикл
			Строка.Операция = НоваяОперация;
			Строка.ОперацияРедактирование = НоваяОперация;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере 
Функция СоздатьКодОперации(КодОперации, НаименованиеОперации)
	
	ТекущийКодОперации = Справочники.бит_КодыОпераций.СоздатьЭлемент();
	ТекущийКодОперации.Наименование = КодОперации;
	ТекущийКодОперации.НаименованиеОперации = НаименованиеОперации;
	
	Попытка
		ТекущийКодОперации.Записать();
		Код =  ТекущийКодОперации.Ссылка;
	Исключение
		Код = Справочники.бит_КодыОпераций.ПустаяСсылка();
	КонецПопытки;
	
	Возврат Код;
	
КонецФункции

&НаСервере 
Процедура ПолучитьВремяРаботы(НоваяОперация, ТекущаяСтрока)
	
	Если ТекущаяСтрока.НормаВыработки = 0 Тогда
		НоваяОперация.ВремяШтучное = 0;
		НоваяОперация.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Час;
	Иначе
		КоличествоИзделийВЧас = 1 / ТекущаяСтрока.НормаВыработки; 
		КоличествоИзделийВМинуту = КоличествоИзделийВЧас * 60;
		Если КоличествоИзделийВМинуту < 0.1 Тогда
			КоличествоИзделийВСекунду = КоличествоИзделийВМинуту * 60; 
			НоваяОперация.ВремяШтучное = КоличествоИзделийВСекунду;
			НоваяОперация.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Секунда;
		Иначе
			НоваяОперация.ВремяШтучное = КоличествоИзделийВМинуту;  
			НоваяОперация.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута; 
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

