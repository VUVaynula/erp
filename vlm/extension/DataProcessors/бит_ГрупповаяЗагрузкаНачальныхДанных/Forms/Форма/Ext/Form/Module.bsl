&НаСервере 
Функция ПерегруппировкаТаблтцыЗначенийПоСпецификациям()
	
	ПерегруппированныеСпецификации = Новый Структура; 
	ИдентификаторУпорядочивания = 0;
	ТекущаяСпецификация = СозданиеСпецификации.Выгрузить();
	ТекущаяСпецификация.Очистить();
	ИдентификаторРодителя = Неопределено;
	
	
	КодОборудования = Неопределено;
	//Тригер = Неопределено;
	//КолонкиКлюча = "ИдРодителя,КодОборудования";
	КолонкиКлюча = "КодРодителя,КодОборудования";
	мКлючи = СтрРазделить(КолонкиКлюча, ",");
	УникальныеСтроки = СозданиеСпецификации.Выгрузить(, КолонкиКлюча);
	УникальныеСтроки.Свернуть(КолонкиКлюча);
	Для стр = 0 по УникальныеСтроки.Количество() - 1 Цикл 
		СтруктураОтбора = Новый Структура;
		Для каждого текКлюч из мКлючи Цикл
			СтруктураОтбора.Вставить(текКлюч, УникальныеСтроки[стр][текКлюч]);
		КонецЦикла;
		строкиПоКлючу = СозданиеСпецификации.НайтиСтроки(СтруктураОтбора);
		//НадоПрерывать = Ложь;
		Для каждого найдСтрока Из строкиПоКлючу Цикл   
			// исключим приемо сдаточные работы. их добавляют к другим операциям
			Если найдСтрока.НаименованиеОперации = "ПРИЕМО-СДАТОЧНЫЕ ИСПЫТАНИЯ ГОТОВОГО ИЗДЕЛИЯ" Тогда 
				//Надо прерывать. не наша итерация
				//НадоПрерывать = Истина;
				Продолжить;
			КонецЕсли;
			
		//----
			ТекущаяСтрокаСпецификации = ТекущаяСпецификация.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрокаСпецификации, найдСтрока);
			// перенесем норму выработки
			Если ТекущаяСтрокаСпецификации.НормаВыработки = 0 И ТекущаяСтрокаСпецификации.ПризнакОснМаршрута = 0 Тогда
				строкиНормаВырботки =  СозданиеСпецификации.НайтиСтроки(новый Структура("КодРодителя, КодОперации, ПризнакОснМаршрута", ТекущаяСтрокаСпецификации.КодРодителя, ТекущаяСтрокаСпецификации.КодОперации, 1));	
				Если строкиНормаВырботки.количество() Тогда
					ТекущаяСтрокаСпецификации.НормаВыработки = строкиНормаВырботки[0].НормаВыработки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;  
		//Если НадоПрерывать = Истина Тогда
		//	Продолжить;
		//КонецЕсли;
		
		// теперь проверим наличие приемо сдаточных операций
		//строкиПоКлючу = СозданиеСпецификации.НайтиСтроки(Новый Структура("КодРодителя, ИДТехмаршрутаРодителя, НаименованиеОперации", строкиПоКлючу[0].КодРодителя, строкиПоКлючу[0].ИДТехмаршрутаРодителя, "ПРИЕМО-СДАТОЧНЫЕ ИСПЫТАНИЯ ГОТОВОГО ИЗДЕЛИЯ"));
		//Для каждого найдСтрока Из строкиПоКлючу Цикл
		//	ТекущаяСтрокаСпецификации = ТекущаяСпецификация.Добавить();
		//	ЗаполнитьЗначенияСвойств(ТекущаяСтрокаСпецификации, найдСтрока);
		//КонецЦикла; 
		Если ТекущаяСпецификация.Количество() Тогда
			//ПерегруппированныеСпецификации.Вставить("Спецификация" + стр, ТекущаяСпецификация.Скопировать());
			ПерегруппированныеСпецификации.Вставить("Спец" + формат(стр, "ЧГ=0"), ТекущаяСпецификация.Скопировать());
			ТекущаяСпецификация.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПерегруппированныеСпецификации;
	
КонецФункции 

