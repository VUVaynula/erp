		 КонецЕсли;	
		 Если СтрокаИсточникПартнеры.СтранаРегистрации = "<Неизвестная>" или СтрокаИсточникПартнеры.СтранаРегистрации = "" Тогда 
			 СтрокаИсточникПартнеры.СтранаРегистрации = "Россия" ;   
