&НаКлиенте 
Процедура ДействияСТаблицамиВидыНоменклатуры(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникВидыНоменклатуры.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникВидыНоменклатуры(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеВидыНоменклатуры.Видимость 	= Истина;
		Элементы.ПроверкиВидыНоменклатуры.Видимость 	= Истина;
		Элементы.ОшибокВидыНоменклатуры.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиВидыНоменклатуры();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыВидыНоменклатуры();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыВидыНоменклатуры();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.ВидыНоменклатуры.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникВидыНоменклатуры(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникВидыН = ИсточникВидыНоменклатуры.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;   
		СтрИсточникВидыН.Наименование = ТекстКолонки; 
		СтрИсточникВидыН.Родитель = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточникВидыН.ВариантОформленияПродажи = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточникВидыН.ВестиУчетПоГТД = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;
		СтрИсточникВидыН.ВестиУчетСертификатовНоменклатуры = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
		СтрИсточникВидыН.ВладелецСерий = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;
		СтрИсточникВидыН.ВладелецТоварныхКатегорий = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;
		СтрИсточникВидыН.ВладелецХарактеристик = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;
		СтрИсточникВидыН.ЗапретРедактированияНаименованияДляПечатиНоменклатуры = 
		                                              ПредставлениеИсточника.Область(НомерСтроки, 19).Текст;
		СтрИсточникВидыН.ЗапретРедактированияНаименованияДляПечатиХарактеристики =
		                                              ПредставлениеИсточника.Область(НомерСтроки, 20).Текст;
		СтрИсточникВидыН.ЗапретРедактированияРабочегоНаименованияНоменклатуры = 
		                                              ПредставлениеИсточника.Область(НомерСтроки, 21).Текст;
		СтрИсточникВидыН.ЗапретРедактированияРабочегоНаименованияХарактеристики = 
		                                              ПредставлениеИсточника.Область(НомерСтроки, 22).Текст;
		СтрИсточникВидыН.ИспользованиеХарактеристик = ПредставлениеИсточника.Область(НомерСтроки, 24).Текст; 
		СтрИсточникВидыН.КоэффициентЕдиницыДляОтчетов = ПредставлениеИсточника.Область(НомерСтроки, 34).Текст;
		СтрИсточникВидыН.НаименованиеДляПечати = ПредставлениеИсточника.Область(НомерСтроки, 39).Текст;
		СтрИсточникВидыН.ТипНоменклатуры = ПредставлениеИсточника.Область(НомерСтроки, 51).Текст;
		СтрИсточникВидыН.СтавкаНДС = ПредставлениеИсточника.Область(НомерСтроки, 53).Текст;
		СтрИсточникВидыН.ОсобенностьУчета = ПредставлениеИсточника.Область(НомерСтроки, 71).Текст;
					
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникВидыНоменклатуры.Удалить(СтрИсточникВидыН);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиВидыНоменклатуры() 
	
	УсловноеОформление.Элементы.Очистить();
	
	МассивНаименований = ИсточникВидыНоменклатуры.Выгрузить( , "Наименование");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Ссылка,
	|	ВидыНоменклатуры.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.Наименование В(&МассивНаименований)
	|	И ВидыНоменклатуры.ЭтоГруппа = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивНаименований", МассивНаименований);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНаименований = РезультатЗапроса.Выгрузить();
	
	Для каждого СтрокаВидыНоменклатуры Из ИсточникВидыНоменклатуры Цикл 
		Наименование = ВыборкаНаименований.Найти(СтрокаВидыНоменклатуры.Наименование);
		
		Если Наименование = Неопределено Тогда
			СтрокаСозданиеВидыНоменклатуры = СозданиеВидыНоменклатуры.Добавить(); 
			ЗаполнитьСтрокуТаблицыВидыНоменклатуры(СтрокаСозданиеВидыНоменклатуры,
			СтрокаВидыНоменклатуры);
		Иначе 
			СтрокаПроверкиВидыНоменклатуры = ПроверкиВидыНоменклатуры.Добавить(); 
			ЗаполнитьСтрокуТаблицыВидыНоменклатуры(СтрокаПроверкиВидыНоменклатуры, 
			СтрокаВидыНоменклатуры);
		КонецЕсли;
		
	КонецЦикла;	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыВидыНоменклатуры(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.Родитель = СтрокаИсточник.Родитель;
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование; 
	СтрокаПриемник.ВариантОформленияПродажи = СтрокаИсточник.ВариантОформленияПродажи;
	СтрокаПриемник.ВестиУчетПоГТД = ПреобразоватьКТИпуБулевоВН(СтрокаИсточник.ВестиУчетПоГТД);
	СтрокаПриемник.ВестиУчетСертификатовНоменклатуры = Неопределено;
    СтрокаПриемник.ВладелецСерий = СтрокаИсточник.ВладелецСерий;
	СтрокаПриемник.ВладелецТоварныхКатегорий = СтрокаИсточник.ВладелецТоварныхКатегорий;
	СтрокаПриемник.ВладелецХарактеристик = СтрокаИсточник.ВладелецХарактеристик;   
	СтрокаПриемник.ЗапретРедактированияНаименованияДляПечатиНоменклатуры = 
	               ПреобразоватьКТИпуБулевоВН(СтрокаИсточник.ЗапретРедактированияНаименованияДляПечатиНоменклатуры);  
	СтрокаПриемник.ЗапретРедактированияНаименованияДляПечатиХарактеристики = 
	               ПреобразоватьКТИпуБулевоВН(СтрокаИсточник.ЗапретРедактированияНаименованияДляПечатиХарактеристики);
	СтрокаПриемник.ЗапретРедактированияРабочегоНаименованияНоменклатуры = 
	               ПреобразоватьКТИпуБулевоВН(СтрокаИсточник.ЗапретРедактированияРабочегоНаименованияНоменклатуры);
    СтрокаПриемник.ЗапретРедактированияРабочегоНаименованияХарактеристики = 
	               ПреобразоватьКТИпуБулевоВН(СтрокаИсточник.ЗапретРедактированияРабочегоНаименованияХарактеристики);
    СтрокаПриемник.ИспользованиеХарактеристик = Ложь;   
	СтрокаПриемник.КоэффициентЕдиницыДляОтчетов = СтрокаИсточник.КоэффициентЕдиницыДляОтчетов;
