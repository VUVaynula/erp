КонецПроцедуры 

&НаСервере
Функция ПолучитьСтруктуруАтрибутыКонтрагентов()        
	
	Атрибуты = Новый ТаблицаЗначений;  
	КвалификаторыСтроки = Новый КвалификаторыСтроки(10);
	Атрибуты.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки));
	КвалификаторыСтроки = Новый КвалификаторыСтроки(150);
    Атрибуты.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки)); 
	Атрибуты.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
    			
	Возврат Атрибуты;

КонецФункции	

&НаСервере 
Процедура СоздатьАтрибутыКонтрагентов(СтруктураАтрибутов) 
		
	Для каждого Атрибут Из СтруктураАтрибутов Цикл  
		Элемент = ПланыВидовХарактеристик.бит_ПризнакиКонтрагентов.СоздатьЭлемент();
		Элемент.Код = Атрибут.Код;
		Элемент.Наименование = Атрибут.Наименование;
        Элемент.ТипЗначения = Атрибут.ТипЗначения;
		Попытка	
			Элемент.Записать(); 
		Исключение
			ТекстСообщения = "Не удалось создать атрибут " +  Элемент.Наименование;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;	
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти   

 #Область СозданияВидыРабочихЦентров  

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникВидыРабочихЦентров(ПредставлениеИсточника)             
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточник = ИсточникВидыРабочихЦентров.Добавить();	            
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточник.Наименование = ТекстКолонки;           
		СтрИсточник.Подразделение = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточник.ЕдиницаИзмеренияДоступностиРЦ = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;
	    СтрИсточник.ЕдиницаВремениПереналадки = ПредставлениеИсточника.Область(НомерСтроки, 13).Текст;	
		СтрИсточник.Описание = ПредставлениеИсточника.Область(НомерСтроки, 14).Текст;
		СтрИсточник.ЕдиницаИзмеренияЗагрузки = ПредставлениеИсточника.Область(НомерСтроки, 17).Текст;
		СтрИсточник.ВариантЗагрузки = ПредставлениеИсточника.Область(НомерСтроки, 18).Текст;
		СтрИсточник.ЕдиницаИзмерения = ПредставлениеИсточника.Область(НомерСтроки, 20).Текст;
			
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникВидыРабочихЦентров.Удалить(СтрИсточник);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ДействияСТаблицамиВидыРабочихЦентров(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникВидыРабочихЦентров.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникВидыРабочихЦентров(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеВидыРабочихЦентров.Видимость 	= Истина;
		Элементы.ПроверкиВидыРабочихЦентров.Видимость 	= Истина;
		Элементы.ОшибокВидыРабочихЦентров.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиВидыРабочихЦентров();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыВидыРабочихЦентров();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыВидыРабочихЦентров();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.ВидыРабочихЦентров.ФормаСписка"); 
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиВидыРабочихЦентров()
	
	УсловноеОформление.Элементы.Очистить();
	
	МассивКодовВРЦ = ИсточникВидыРабочихЦентров.Выгрузить( , "Описание");
	//МассивПодразделений = ИсточникВидыРабочихЦентров.Выгрузить( , "Подразделение");
	ВсеПодразделенияБезПрификса = ПолучитьВсеПодразделенияБезПрификса();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабочихЦентров.Ссылка КАК Ссылка,
		|	ВидыРабочихЦентров.Наименование КАК Наименование,
		|	ВидыРабочихЦентров.бит_КодВРЦ КАК бит_КодВРЦ
		|ИЗ
		|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
		|ГДЕ
		|	ВидыРабочихЦентров.ЭтоГруппа = ЛОЖЬ
		|	И ВидыРабочихЦентров.бит_КодВРЦ В (&МассивКодовВРЦ)";
		
	Запрос.УстановитьПараметр("МассивКодовВРЦ", МассивКодовВРЦ);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();  
	
	Для каждого СтрокаВидыРабочихЦентров Из ИсточникВидыРабочихЦентров Цикл 
		
		ТекстСообщения = ""; 
		ТекущееПодразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
		Если Не ЗначениеЗаполнено(СтрокаВидыРабочихЦентров.Подразделение) Тогда
			ТекстСообщения = ТекстСообщения + "Подразделение не найдено! ";
		ИначеЕсли СтрокаВидыРабочихЦентров.Подразделение = "Основное производство" 
			Или СтрокаВидыРабочихЦентров.Подразделение = "ОСНОВНОЕ ПРОИЗВОДСТВО"
			Или СтрокаВидыРабочихЦентров.Подразделение = "1" Тогда
			ТекущееПодразделение = Справочники.СтруктураПредприятия.НайтиПоКоду("1"); 
			//ТекущееПодразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Основное производство"); 
			
		ИначеЕсли  СтрокаВидыРабочихЦентров.Подразделение = "Цех №2"
			Или СтрокаВидыРабочихЦентров.Подразделение = "2" Тогда
			ТекущееПодразделение = Справочники.СтруктураПредприятия.НайтиПоКоду("2");
			//ТекущееПодразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Цех №2"); 
		Иначе
			ТекстСообщения = ТекстСообщения + "Подразделение не удалось сопоставить! ";
			//ПараметрыОтбора = Новый Структура; 
			//ПараметрыОтбора.Вставить("Код", Число(СтрокаВидыРабочихЦентров.Подразделение)); 
			//Подразлеление = ВсеПодразделенияБезПрификса.НайтиСтроки(ПараметрыОтбора);
			//Если Подразлеление.Количество() = 0 Или  Подразлеление.Количество() > 1 Тогда  
			//	ТекстСообщения = ТекстСообщения + "Подразделение не удалось сопоставить! ";
			//Иначе
			//	ТекущееПодразделение = Подразлеление[0].Ссылка;
			//КонецЕсли;	
		КонецЕсли; 
				
		СтрокаВРЦ = РезультатЗапроса.Найти(СтрокаВидыРабочихЦентров.Описание);
		Если ТекстСообщения <> "" Тогда	
			СтрокаОшибокВидыРабочихЦентров = ОшибокВидыРабочихЦентров.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиВидыРабочихЦентров(СтрокаОшибокВидыРабочихЦентров, 
			                                                         СтрокаВидыРабочихЦентров, ТекущееПодразделение);
			СтрокаОшибокВидыРабочихЦентров.Ошибка = ТекстСообщения;
			СтрокаОшибокВидыРабочихЦентров.Подразделение = СтрокаВидыРабочихЦентров.Подразделение;
		ИначеЕсли СтрокаВРЦ = Неопределено Тогда
			СтрокаСозданиеВидыРабочихЦентров = СозданиеВидыРабочихЦентров.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиВидыРабочихЦентров(СтрокаСозданиеВидыРабочихЦентров,
			                                                         СтрокаВидыРабочихЦентров, ТекущееПодразделение);
		Иначе 
			СтрокаПроверкиВидыРабочихЦентров = ПроверкиВидыРабочихЦентров.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиВидыРабочихЦентров(СтрокаПроверкиВидыРабочихЦентров, 
			                                                         СтрокаВидыРабочихЦентров, ТекущееПодразделение);
	    КонецЕсли; 
    КонецЦикла;
		
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиВидыРабочихЦентров(СтрокаПриемник, СтрокаИсточник, ТекущееПодразделение)
	
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование;
	СтрокаПриемник.Подразделение = ТекущееПодразделение;
	СтрокаПриемник.ЕдиницаИзмеренияДоступностиРЦ = СтрокаИсточник.ЕдиницаИзмеренияДоступностиРЦ;
	СтрокаПриемник.ЕдиницаВремениПереналадки = СтрокаИсточник.ЕдиницаВремениПереналадки;
	СтрокаПриемник.Описание = СтрокаИсточник.Описание;
	СтрокаПриемник.ЕдиницаИзмеренияЗагрузки = СтрокаИсточник.ЕдиницаИзмеренияЗагрузки;
	СтрокаПриемник.ВариантЗагрузки = СтрокаИсточник.ВариантЗагрузки;
	СтрокаПриемник.ЕдиницаИзмерения = СтрокаИсточник.ЕдиницаИзмерения;
	
КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементыТаблицыВидыРабочихЦентров()
	
	//ОсновноеПодразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("ОСНОВНОЕ ПРОИЗВОДСТВО");
	//ЦехДва = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Цех №2");
	
	Для каждого СтрокаВидыРабочихЦентров Из  СозданиеВидыРабочихЦентров Цикл
		Если СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ" 
			Или СтрокаВидыРабочихЦентров.Наименование = "Цех1 (волочил)"
			Или СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ КОРПУС 2/2" 
			Или СтрокаВидыРабочихЦентров.Наименование = "Цех4 (БПИ)" 
			Или СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ КОРПУС 2/5" 
			Или СтрокаВидыРабочихЦентров.Наименование = "КОРПУС 3/6" 
			Или СтрокаВидыРабочихЦентров.Наименование = "Цех7 (по про-ву сил. каб. низ. и сред. напряжения)" 
			Или СтрокаВидыРабочихЦентров.Наименование = "КОРПУС 5/8" 
			Или СтрокаВидыРабочихЦентров.Наименование = "простой" 
			Или СтрокаВидыРабочихЦентров.Наименование = "НОВОЕ ОБОРУДОВАНИЕ" 
			Или СтрокаВидыРабочихЦентров.Наименование = "КОРПУС 3/12" 
			Или СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ РУЧНАЯ ОПЕРАЦИЯ КОРПУС 3/12" 
			Или СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ РУЧНАЯ ОПЕРАЦИЯ Цех20 (по производству тары)" 
			Или СтрокаВидыРабочихЦентров.Наименование = "РУЧНАЯ ОПЕРАЦИЯ Цех29 (по переработке отходов)"
			Или СтрокаВидыРабочихЦентров.Наименование = "Нет оборудования"
		Тогда
		Продолжить;
		КонецЕсли;
			
	ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СоздатьЭлемент();
	ВидРабочегоЦентра.Наименование = СтрокаВидыРабочихЦентров.Наименование; 
	//Если СтрокаВидыРабочихЦентров.Подразделение = "ОСНОВНОЕ ПРОИЗВОДСТВО" Тогда
	//ВидРабочегоЦентра.Подразделение	= ОсновноеПодразделение;
	//ИначеЕсли СтрокаВидыРабочихЦентров.Подразделение = "Цех №2" Тогда
	//ВидРабочегоЦентра.Подразделение	= ЦехДва;
	//КонецЕсли;
	ВидРабочегоЦентра.Подразделение	= СтрокаВидыРабочихЦентров.Подразделение;
	ВидРабочегоЦентра.МинимальныйЗначимыйБуфер = 0;
	ВидРабочегоЦентра.УчитыватьДоступностьПоГрафикуРаботы = Истина;
    ВидРабочегоЦентра.МаксимальнаяДоступностьРЦ = 1;
    ВидРабочегоЦентра.ЕдиницаИзмеренияДоступностиРЦ = Перечисления.ЕдиницыИзмеренияВремени.Час;
	ВидРабочегоЦентра.ПериодОжидания = 0;
	ВидРабочегоЦентра.ИспользуютсяВариантыНаладки = Ложь;
	//ВидРабочегоЦентра.ЕдиницаВремениПереналадки = Неопределено;
    ВидРабочегоЦентра.Описание = СтрокаВидыРабочихЦентров.Описание;
	ВидРабочегоЦентра.бит_КодВРЦ = СтрокаВидыРабочихЦентров.Описание; 
	ВидРабочегоЦентра.РезервДоступности = 0;
	ВидРабочегоЦентра.ПараллельнаяЗагрузка = Ложь;
	//ВидРабочегоЦентра.ЕдиницаИзмеренияЗагрузки = Неопределено;
	//ВидРабочегоЦентра.ВариантЗагрузки = Неопределено;
	ВидРабочегоЦентра.ВремяРаботы = 0;
	ВидРабочегоЦентра.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Минута;
	ВидРабочегоЦентра.ПланироватьРаботуРабочихЦентров = Истина;
	ВидРабочегоЦентра.КоличествоРабочихЦентров = 0;
    ВидРабочегоЦентра.ВводитьДоступностьДляВидаРЦ = Ложь;
	   //ВидРабочегоЦентра.УдалитьПланироватьРаботу = Ложь;
	
	Попытка	
		ВидРабочегоЦентра.Записать();
		СтрокаВидыРабочихЦентров.Создано = Истина;
	Исключение
		СтрокаВидыРабочихЦентров.Создано = Ложь;
	КонецПопытки;	
		
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеВидыРабочихЦентров.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеВидыРабочихЦентров.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.СозданиеВидыРабочихЦентров.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ПроверитьЭлементыТаблицыВидыРабочихЦентров()
	
	Для каждого СтрокаВидыРабочихЦентров Из ПроверкиВидыРабочихЦентров Цикл 
		
		ТекущийВРЦ = Справочники.ВидыРабочихЦентров.НайтиПоРеквизиту("бит_КодВРЦ", СтрокаВидыРабочихЦентров.Описание);

		Если Не ЗначениеЗаполнено(ТекущийВРЦ.Подразделение) Тогда
			 ТекущийВРЦ.Подразделение = СтрокаВидыРабочихЦентров.Подразделение;
			 СтрокаВидыРабочихЦентров.Изменено = Истина;
		КонецЕсли;	
		
		Если ТекущийВРЦ.Описание = "" Тогда
			 ТекущийВРЦ.Описание = СтрокаВидыРабочихЦентров.Описание;
			 СтрокаВидыРабочихЦентров.Изменено = Истина;
		 КонецЕсли;
		 
		Если СтрокаВидыРабочихЦентров.Изменено Тогда
			
			Попытка
				ТекущийВРЦ.Записать();
			Исключение 
				СтрокаВидыРабочихЦентров.Изменено = Ложь;
			КонецПопытки;
		КонецЕсли;
	    		
		КонецЦикла;
	
	ИзменениеУсловногоОформленияВидыРабочихЦентров();
	
КонецПроцедуры

 &НаСервере 
Процедура ИзменениеУсловногоОформленияВидыРабочихЦентров()

 	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиВидыРабочихЦентров.Изменено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин); 
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиВидыРабочихЦентров.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиВидыРабочихЦентров.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры	

#КонецОбласти

 #Область СозданияРабочиеЦентры  

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникРабочиеЦентры(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточник = ИсточникРабочиеЦентры.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточник.Наименование = ТекстКолонки;           
		СтрИсточник.ВидРабочегоЦентра = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;   
		СтрИсточник.КоэффициентВремениРаботы = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;    
	    СтрИсточник.МаксимальнаяЗагрузка = ПредставлениеИсточника.Область(НомерСтроки, 6).Текст; 	
		СтрИсточник.Описание = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;             
		СтрИсточник.Подразделение = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;  
		СтрИсточник.КодРабЦентра = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;     
			
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникРабочиеЦентры.Удалить(СтрИсточник);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ДействияСТаблицамиРабочиеЦентры(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникРабочиеЦентры.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникРабочиеЦентры(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеРабочиеЦентры.Видимость 	= Истина;
		Элементы.ПроверкиРабочиеЦентры.Видимость 	= Истина;
		Элементы.ОшибокРабочиеЦентры.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиРабочиеЦентры();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыРабочиеЦентры();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыРабочиеЦентры();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.РабочиеЦентры.ФормаСписка"); 
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиРабочиеЦентры()
	
	УсловноеОформление.Элементы.Очистить(); 
	
	МассивВРЦ = ИсточникРабочиеЦентры.Выгрузить( , "ВидРабочегоЦентра");
    МассивКодРЦ = ИсточникРабочиеЦентры.Выгрузить( , "КодРабЦентра");
 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабочихЦентров.Ссылка КАК Ссылка,
		|	ВидыРабочихЦентров.Наименование КАК Наименование,
		|	ВидыРабочихЦентров.Описание КАК Описание
		|ИЗ
		|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
		|ГДЕ
		|	ВидыРабочихЦентров.ЭтоГруппа = ЛОЖЬ
		|	И ВидыРабочихЦентров.Наименование В(&МассивВРЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеЦентры.Ссылка КАК Ссылка,
		|	РабочиеЦентры.Наименование КАК Наименование,
		|	РабочиеЦентры.бит_КодРабЦентра КАК бит_КодРабЦентра
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	РабочиеЦентры.ЭтоГруппа = ЛОЖЬ
		|	И РабочиеЦентры.бит_КодРабЦентра В (&МассивКодРЦ)";
		
	Запрос.УстановитьПараметр("МассивВРЦ", МассивВРЦ);
	Запрос.УстановитьПараметр("МассивКодРЦ", МассивКодРЦ);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаВРЦ = РезультатЗапроса[0].Выгрузить();
	ВыборкаРЦ = РезультатЗапроса[1].Выгрузить();		
	ЗаполнениеТаблицРабочиеЦентры(ВыборкаВРЦ, ВыборкаРЦ);
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнениеТаблицРабочиеЦентры(ВыборкаВРЦ, ВыборкаРЦ);

   	Для каждого СтрокаРабочиеЦентры Из ИсточникРабочиеЦентры Цикл 
			
		ТекстСообщения = ""; 
		СтрокаВРЦ = ВыборкаВРЦ.Найти(СтрокаРабочиеЦентры.ВидРабочегоЦентра);
		Если СтрокаВРЦ = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Вид рабочих центров не найден! ";	
		КонецЕсли;
		
		СтрокаРЦ = ВыборкаРЦ.Найти(СтрокаРабочиеЦентры.КодРабЦентра);
		Если ТекстСообщения <> "" Тогда	
			СтрокаОшибокРабочиеЦентры = ОшибокРабочиеЦентры.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиРабочиеЦентры(СтрокаОшибокРабочиеЦентры, 
			                                                         СтрокаРабочиеЦентры);
			СтрокаОшибокРабочиеЦентры.Ошибка = ТекстСообщения;
		ИначеЕсли СтрокаРЦ = Неопределено Тогда
			СтрокаСозданиеРабочиеЦентры = СозданиеРабочиеЦентры.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиРабочиеЦентры(СтрокаСозданиеРабочиеЦентры,
			                                                         СтрокаРабочиеЦентры);
		Иначе 
			СтрокаПроверкиРабочиеЦентры = ПроверкиРабочиеЦентры.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиРабочиеЦентры(СтрокаПроверкиРабочиеЦентры, 
			                                                         СтрокаРабочиеЦентры);
	    КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиРабочиеЦентры(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.Наименование = СтрокаИсточник.Наименование;
	СтрокаПриемник.ВидРабочегоЦентра = СтрокаИсточник.ВидРабочегоЦентра;
	СтрокаПриемник.КоэффициентВремениРаботы = СтрокаИсточник.КоэффициентВремениРаботы;
	СтрокаПриемник.МаксимальнаяЗагрузка = СтрокаИсточник.МаксимальнаяЗагрузка;
	СтрокаПриемник.Описание = СтрокаИсточник.Описание;
	СтрокаПриемник.Подразделение = СтрокаИсточник.Подразделение;
	СтрокаПриемник.КодРабЦентра = СтрокаИсточник.КодРабЦентра;
	 
КонецПроцедуры

&НаСервере 
Процедура СоздатьЭлементыТаблицыРабочиеЦентры()
	
	Для каждого СтрокаРабочиеЦентры Из СозданиеРабочиеЦентры Цикл
					
		Если СтрокаРабочиеЦентры.ВидРабочегоЦентра = "КОРПУС 3/12" 
			Или СтрокаРабочиеЦентры.ВидРабочегоЦентра = "КОРПУС 5/8"
			Или СтрокаРабочиеЦентры.ВидРабочегоЦентра = "Цех4 (БПИ)" 
			Или СтрокаРабочиеЦентры.ВидРабочегоЦентра = "Цех42" 
			Или СтрокаРабочиеЦентры.ВидРабочегоЦентра = "Нет оборудования" Тогда
			Продолжить;
		КонецЕсли;
		
		РабочийЦентр = Справочники.РабочиеЦентры.СоздатьЭлемент();
		РабочийЦентр.Наименование = СтрокаРабочиеЦентры.Наименование;
		РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.НайтиПоНаименованию(
		СтрокаРабочиеЦентры.ВидРабочегоЦентра);
		РабочийЦентр.КоэффициентВремениРаботы = 1;
		РабочийЦентр.МаксимальнаяЗагрузка = 0;
		РабочийЦентр.Описание = СтрокаРабочиеЦентры.Описание;
		РабочийЦентр.РасценкаРабота = 0;
		РабочийЦентр.РасценкаПереналадка = 0;
		//РабочийЦентр.Участок = Неопределено;  Справочники.ПроизводственныеУчастки.ПустаяСсылка() 
		РабочийЦентр.бит_КодРабЦентра = СтрокаРабочиеЦентры.КодРабЦентра;
		
		Попытка	
			РабочийЦентр.Записать();
			СтрокаРабочиеЦентры.Создано = Истина;
		Исключение
			СтрокаРабочиеЦентры.Создано = Ложь;
		КонецПопытки;
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеРабочиеЦентры.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеРабочиеЦентры.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.СозданиеРабочиеЦентры.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры

&НаСервере 
