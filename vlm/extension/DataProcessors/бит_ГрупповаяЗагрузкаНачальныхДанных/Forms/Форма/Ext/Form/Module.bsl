#Область СозданияБанковскихСчетовОрганизации

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникБанковскиеСчетаОрганизаций(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникСчетаО = ИсточникБанковскиеСчетаОрганизаций.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
		СтрИсточникСчетаО.Владелец = ТекстКолонки;           
		СтрИсточникСчетаО.НомерСчета = ПредставлениеИсточника.Область(НомерСтроки, 3).Текст;
		СтрИсточникСчетаО.ТекстНазначения = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
	    СтрИсточникСчетаО.ВалютаДенежныхСредств = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;	
		СтрИсточникСчетаО.БИКБанка = ПредставлениеИсточника.Область(НомерСтроки, 9).Текст;
		СтрИсточникСчетаО.НаименованиеБанка = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;
		СтрИсточникСчетаО.КоррСчетБанка = ПредставлениеИсточника.Область(НомерСтроки, 12).Текст;
			
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникБанковскиеСчетаОрганизаций.Удалить(СтрИсточникСчетаО);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ДействияСТаблицамиБанковскиеСчетаОрганизаций(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникБанковскиеСчетаОрганизаций.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникБанковскиеСчетаОрганизаций(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеБанковскиеСчетаОрганизаций.Видимость 	= Истина;
		Элементы.ПроверкиБанковскиеСчетаОрганизаций.Видимость 	= Истина;
		Элементы.ОшибокБанковскиеСчетаОрганизаций.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиБанковскиеСчетаОрганизаций();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыБанковскиеСчетаОрганизаций();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыБанковскиеСчетаОрганизаций();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.БанковскиеСчетаОрганизаций.ФормаСписка"); 
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры  

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиБанковскиеСчетаОрганизаций()
	
	УсловноеОформление.Элементы.Очистить();
	
	Для каждого СтрокаИсточникБанковскиеСчетаОрганизаций Из ИсточникБанковскиеСчетаОрганизаций Цикл     
		Если СтрокаИсточникБанковскиеСчетаОрганизаций.ВалютаДенежныхСредств = "RUB" Тогда 
			 СтрокаИсточникБанковскиеСчетаОрганизаций.ВалютаДенежныхСредств = "руб.";   
		КонецЕсли;		
	КонецЦикла;  
	МассивВалют = ИсточникБанковскиеСчетаОрганизаций.Выгрузить( , "ВалютаДенежныхСредств");
	МассивНомерСчета = ИсточникБанковскиеСчетаОрганизаций.Выгрузить( , "НомерСчета");
	МассивБик = ИсточникБанковскиеСчетаОрганизаций.Выгрузить( , "БИКБанка");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлассификаторБанков.Ссылка КАК Ссылка,
		|	КлассификаторБанков.Код КАК Код,
		|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
		|ПОМЕСТИТЬ КлассификаторБаковБик
		|ИЗ
		|	Справочник.КлассификаторБанков КАК КлассификаторБанков
		|ГДЕ
		|	КлассификаторБанков.Код В(&МассивБик)
		|	И КлассификаторБанков.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КлассификаторБанков.Ссылка КАК Ссылка,
		|	КлассификаторБанков.Код КАК Код,
		|	КлассификаторБанков.СВИФТБИК КАК СВИФТБИК
		|ПОМЕСТИТЬ КлассификаторБаковСВИФТ
		|ИЗ
		|	Справочник.КлассификаторБанков КАК КлассификаторБанков
		|ГДЕ
		|	КлассификаторБанков.СВИФТБИК В(&МассивБик)
		|	И КлассификаторБанков.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КлассификаторБаковБик.Ссылка КАК Ссылка,
		|	КлассификаторБаковБик.Код КАК Код,
		|	КлассификаторБаковБик.СВИФТБИК КАК СВИФТБИК
		|ИЗ
		|	КлассификаторБаковБик КАК КлассификаторБаковБик
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КлассификаторБаковСВИФТ.Ссылка,
		|	КлассификаторБаковСВИФТ.Код,
		|	КлассификаторБаковСВИФТ.СВИФТБИК
		|ИЗ
		|	КлассификаторБаковСВИФТ КАК КлассификаторБаковСВИФТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код,
		|	Валюты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	Валюты.Наименование В(&МассивВалют)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БанковскиеСчетаОрганизаций.Ссылка КАК Ссылка,
		|	БанковскиеСчетаОрганизаций.НомерСчета КАК НомерСчета
		|ИЗ
		|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
		|ГДЕ
		|	БанковскиеСчетаОрганизаций.НомерСчета В(&МассивНомерСчета)
		|	И БанковскиеСчетаОрганизаций.ЭтоГруппа = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивБик", МассивБик);
	Запрос.УстановитьПараметр("МассивВалют", МассивВалют);
	Запрос.УстановитьПараметр("МассивНомерСчета", МассивНомерСчета);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаБик = РезультатЗапроса[2].Выгрузить();
	ВыборкаВалют = РезультатЗапроса[3].Выгрузить();
	ВыборкаНомерСчета = РезультатЗапроса[4].Выгрузить();  
	
	Для каждого СтрокаБанковскиеСчетаОрганизаций Из ИсточникБанковскиеСчетаОрганизаций Цикл 
		
		ТекстСообщения = ""; 
		
		ИдентификаторIBAN = ЕстьБуквыВСтроке(СтрокаБанковскиеСчетаОрганизаций.НомерСчета);
		Если НЕ ИдентификаторIBAN Тогда
			ИдентификаторБик = ВыборкаБик.Найти(СтрокаБанковскиеСчетаОрганизаций.БИКБанка);
			Если ИдентификаторБик = Неопределено Тогда
				ТекстСообщения = ТекстСообщения + "Банк не найден! ";
			КонецЕсли; 
		КонецЕсли;
		
		ИдентификаторВалюта = ВыборкаВалют.Найти(СтрокаБанковскиеСчетаОрганизаций.ВалютаДенежныхСредств);
		Если ИдентификаторВалюта = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Валюта не найдена! ";
		КонецЕсли;
		
		Если СтрокаБанковскиеСчетаОрганизаций.НомерСчета = "" ИЛИ 
			 СтрокаБанковскиеСчетаОрганизаций.НомерСчета = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Номер счета не указан! ";
		КонецЕсли;
		
		СтрокаНомерСчета = ВыборкаНомерСчета.Найти(СтрокаБанковскиеСчетаОрганизаций.НомерСчета);
		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокБанковскиеСчетаОрганизаций = ОшибокБанковскиеСчетаОрганизаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаОрганизаций(СтрокаОшибокБанковскиеСчетаОрганизаций, 
			                                                         СтрокаБанковскиеСчетаОрганизаций);
			СтрокаОшибокБанковскиеСчетаОрганизаций.Ошибка = ТекстСообщения;
		ИначеЕсли СтрокаНомерСчета = Неопределено Тогда
			СтрокаСозданиеБанковскиеСчетаОрганизаций = СозданиеБанковскиеСчетаОрганизаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаОрганизаций(СтрокаСозданиеБанковскиеСчетаОрганизаций,
			                                                         СтрокаБанковскиеСчетаОрганизаций);
		Иначе 
			СтрокаПроверкиБанковскиеСчетаОрганизаций = ПроверкиБанковскиеСчетаОрганизаций.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаОрганизаций(СтрокаПроверкиБанковскиеСчетаОрганизаций, 
			                                                         СтрокаБанковскиеСчетаОрганизаций);
        КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыПроверкиБанковскиеСчетаОрганизаций(СтрокаПриемник, СтрокаИсточник)
	
	СтрокаПриемник.Владелец = СтрокаИсточник.Владелец; 
	СтрокаПриемник.НомерСчета = СтрокаИсточник.НомерСчета;
	СтрокаПриемник.ТекстНазначения = СтрокаИсточник.ТекстНазначения;
	СтрокаПриемник.ВалютаДенежныхСредств = СтрокаИсточник.ВалютаДенежныхСредств;
	СтрокаПриемник.БИКБанка = СтрокаИсточник.БИКБанка;
	СтрокаПриемник.НаименованиеБанка = СтрокаИсточник.НаименованиеБанка;   
	СтрокаПриемник.КоррСчетБанка = СтрокаИсточник.КоррСчетБанка; 
	
КонецПроцедуры	

&НаСервере 
Процедура СоздатьЭлементыТаблицыБанковскиеСчетаОрганизаций()
	
	Для каждого СтрокаБанковскиеСчетаОрганизаций Из  СозданиеБанковскиеСчетаОрганизаций Цикл
		
		БанковскийСчетаОрганизаций = Справочники.БанковскиеСчетаОрганизаций.СоздатьЭлемент();
		БанковскийСчетаОрганизаций.Владелец = Справочники.Организации.ОрганизацияПоУмолчанию();
		БанковскийСчетаОрганизаций.ТипСчета = Перечисления.ТипыБанковскихСчетов.Расчетный;
		БанковскийСчетаОрганизаций.ВалютаДенежныхСредств = 
		Справочники.Валюты.НайтиПоНаименованию(СтрокаБанковскиеСчетаОрганизаций.ВалютаДенежныхСредств);
		НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаБанковскиеСчетаОрганизаций.НомерСчета), " ", ""), ".", ""));
		БанковскийСчетаОрганизаций.НомерСчета = НомерСчета;
		БанковскийСчетаОрганизаций.ВариантВыводаМесяца = Перечисления.ВариантыВыводаМесяцаВДатеДокумента.Числом;
		БанковскийСчетаОрганизаций.ТекстНазначения = СтрокаБанковскиеСчетаОрганизаций.ТекстНазначения; 
		
		Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			БанковскийСчетаОрганизаций.ИностранныйБанк = Истина;
			Если Сред(НомерСчета, 1, 4) = "IBAN" Тогда
				НомерСчета = Сред(НомерСчета, 5);
				БанковскийСчетаОрганизаций.НомерСчета = НомерСчета;
			КонецЕсли;
			Если ДенежныеСредстваКлиентСервер.ПравильнаяДлинаIBAN(НомерСчета) Тогда
				БанковскийСчетаОрганизаций.ЭтоIBAN = Истина;
				ОпределитьСтрануИБанкПоIBAN(БанковскийСчетаОрганизаций); 
				БанковскийСчетаОрганизаций.РучноеИзменениеРеквизитовБанка = Истина;
			КонецЕсли;
		Иначе
			Банк = Справочники.КлассификаторБанков.НайтиПоКоду(СтрокаБанковскиеСчетаОрганизаций.БИКБанка);
			
			Если Банк = Неопределено Тогда
				Банк = Справочники.КлассификаторБанков.НайтиПоРеквизиту("СВИФТБИК", СтрокаБанковскиеСчетаОрганизаций.БИКБанка);
			КонецЕсли;
			
			СоответствиеРеквизитовБанка = УстановитьСоответствиеРеквизитовБанка();
			СтруктураРеквизитов = Новый Структура;
			ИменаРеквизитов = СтрРазделить(РеквизитыБанка(), ",", Ложь);
			
			Для каждого ИмяРеквизита Из ИменаРеквизитов Цикл
				СтруктураРеквизитов.Вставить(ИмяРеквизита, СоответствиеРеквизитовБанка[СокрЛП(ИмяРеквизита)]);
			КонецЦикла;
			
			СтруктураРеквизитов.Вставить("БИКБанка", "Код");
			СтруктураРеквизитов.Вставить("СВИФТБанка", "СВИФТБИК");
			СтруктураРеквизитов.Вставить("НаименованиеБанкаМеждународное", "МеждународноеНаименование");
			РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк, СтруктураРеквизитов);
			ЗаполнитьЗначенияСвойств(БанковскийСчетаОрганизаций, РеквизитыБанка);
			
			БанковскийСчетаОрганизаций.Банк = Банк;
		КонецЕсли;  
		Если БанковскийСчетаОрганизаций.ВалютаДенежныхСредств.Пустая() Тогда
			БанковскийСчетаОрганизаций.ВалютаДенежныхСредств = Справочники.Валюты.ПолучитьВалютуПоУмолчанию();
		КонецЕсли;
		ШаблонНаименования = НСтр("ru = '%1, %2'; |en = '%1, %2'"); 
		НаименованиеО = СокрЛП(БанковскийСчетаОрганизаций.Владелец.Наименование);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), НаименованиеО);
		
		БанковскийСчетаОрганизаций.Наименование = СтрокаНаименования;
		
		Попытка	
			БанковскийСчетаОрганизаций.Записать();
			СтрокаБанковскиеСчетаОрганизаций.Создано = Истина;
		Исключение
			СтрокаБанковскиеСчетаОрганизаций.Создано = Ложь;
		КонецПопытки;	
		
	КонецЦикла;	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеБанковскиеСчетаОрганизаций.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина;  
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);  
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СозданиеБанковскиеСчетаОрганизаций.Создано");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь;  
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
	
	Для каждого элПоля Из Элементы.СозданиеБанковскиеСчетаОрганизаций.ПодчиненныеЭлементы Цикл
      ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	  ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
      ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	  ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
    КонецЦикла;

КонецПроцедуры

&НаСервере 
Процедура ПроверитьЭлементыТаблицыБанковскиеСчетаОрганизаций()
	
	Для каждого СтрокаБанковскиеСчетаОрганизаций Из ПроверкиБанковскиеСчетаОрганизаций Цикл 
		
		НомерСчета = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(СтрокаБанковскиеСчетаОрганизаций.НомерСчета), " ", ""), ".", ""));
		ТекущийЭлементСправочника = Справочники.БанковскиеСчетаОрганизаций.НайтиПоРеквизиту("НомерСчета", НомерСчета);
		ТекущийЭлементСправочника = ТекущийЭлементСправочника.ПолучитьОбъект();
		
		Если (ТекущийЭлементСправочника.ТекстНазначения = Неопределено ИЛИ ТекущийЭлементСправочника.ТекстНазначения = "") И 
			СтрокаБанковскиеСчетаОрганизаций.ТекстНазначения <> "" Тогда
			ТекущийЭлементСправочника.ТекстНазначения = СтрокаБанковскиеСчетаОрганизаций.ТекстНазначения;
			СтрокаБанковскиеСчетаОрганизаций.Изменено = Истина;
		КонецЕсли;
		
		Если ТекущийЭлементСправочника.ВалютаДенежныхСредств = Неопределено 
		 ИЛИ ТекущийЭлементСправочника.ВалютаДенежныхСредств.Пустая() Тогда
			ТекущийЭлементСправочника.ВалютаДенежныхСредств = 
			                      Справочники.Валюты.НайтиПоНаименованию(СтрокаБанковскиеСчетаОрганизаций.ВалютаДенежныхСредств);
			СтрокаБанковскиеСчетаОрганизаций.Изменено = Истина;
		КонецЕсли;
		
		Если ТекущийЭлементСправочника.ПометкаУдаления = Истина Тогда
			 ТекущийЭлементСправочника.ПометкаУдаления = Ложь;
			 СтрокаБанковскиеСчетаОрганизаций.Изменено = Истина;
		 КонецЕсли;
		 
		ОбработкаДанныхБанка(ТекущийЭлементСправочника, СтрокаБанковскиеСчетаОрганизаций);
		
		ШаблонНаименования = НСтр("ru = '%1, %2'; |en = '%1, %2'"); 
		НаименованиеО = СокрЛП(ТекущийЭлементСправочника.Владелец.Наименование);
		СтрокаНаименования = СтрШаблон(ШаблонНаименования, Прав(СокрЛП(НомерСчета), 4), НаименованиеО);
		Если ТекущийЭлементСправочника.Наименование <> СтрокаНаименования Тогда
			 ТекущийЭлементСправочника.Наименование = СтрокаНаименования;
			 СтрокаБанковскиеСчетаОрганизаций.Изменено = Истина;
		 КонецЕсли;
		 
		 Если ЕстьБуквыВСтроке(НомерСчета) Тогда
			 ТекущийЭлементСправочника.РучноеИзменениеРеквизитовБанка = Истина;
		 КонецЕсли;
		
		Если СтрокаБанковскиеСчетаОрганизаций.Изменено Тогда
			
			Попытка
				ТекущийЭлементСправочника.Записать();
			Исключение 
				СтрокаБанковскиеСчетаОрганизаций.Изменено = Ложь;
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменениеУсловногоОформленияБанковскиеСчетаОрганизаций();
	
КонецПроцедуры

 &НаСервере 
Процедура ИзменениеУсловногоОформленияБанковскиеСчетаОрганизаций()

 	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиБанковскиеСчетаОрганизаций.Изменено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Истина; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин); 
	
	ЭлементУсловногоОформления2 = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиБанковскиеСчетаОрганизаций.Изменено"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Ложь; 
	ЭлементУсловногоОформления2.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Хаки); 
	
	Для каждого элПоля Из Элементы.ПроверкиБанковскиеСчетаОрганизаций.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле2 = ЭлементУсловногоОформления2.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
		ОформляемоеПоле2.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
КонецПроцедуры	
#КонецОбласти

#Область СозданияПартнеровКонтрагентов

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникПартнеры(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникПартнеры = ИсточникПартнеры.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;	    
		СтрИсточникПартнеры.Наименование = ТекстКолонки;                        
		СтрИсточникПартнеры.НаименованиеПолное = ПредставлениеИсточника.Область(НомерСтроки, 2).Текст;
		СтрИсточникПартнеры.ЮридическоеФизическоеЛицо = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточникПартнеры.СтранаРегистрации = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		СтрИсточникПартнеры.ИНН = ПредставлениеИсточника.Область(НомерСтроки, 7).Текст;
		СтрИсточникПартнеры.КПП = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
		СтрИсточникПартнеры.Партнер = ПредставлениеИсточника.Область(НомерСтроки, 10).Текст;
		СтрИсточникПартнеры.ЮрФизЛицо = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст; 
		СтрИсточникПартнеры.КодПоОКПО = ПредставлениеИсточника.Область(НомерСтроки, 13).Текст; 
		СтрИсточникПартнеры.КонтактнаяИнформацияТип = ПредставлениеИсточника.Область(НомерСтроки, 17).Текст;
		СтрИсточникПартнеры.КонтактнаяИнформацияСтрана = ПредставлениеИсточника.Область(НомерСтроки, 21).Текст;
		СтрИсточникПартнеры.КонтактнаяИнформацияРегион = ПредставлениеИсточника.Область(НомерСтроки, 22).Текст;
		СтрИсточникПартнеры.КонтактнаяИнформацияГород = ПредставлениеИсточника.Область(НомерСтроки, 23).Текст;
		СтрИсточникПартнеры.КонтактнаяИнформацияНомерТелефона = ПредставлениеИсточника.Область(НомерСтроки, 26).Текст;
		СтрИсточникПартнеры.Факс = ПредставлениеИсточника.Область(НомерСтроки, 38).Текст;
		СтрИсточникПартнеры.РуководительОрганизацииДолжность = ПредставлениеИсточника.Область(НомерСтроки, 39).Текст;
		СтрИсточникПартнеры.РуководительОрганизацииФИО = ПредставлениеИсточника.Область(НомерСтроки, 40).Текст; 
		СтрИсточникПартнеры.НаименованиеСФормойСобственности = ПредставлениеИсточника.Область(НомерСтроки, 41).Текст;
		СтрИсточникПартнеры.Счет = ПредставлениеИсточника.Область(НомерСтроки, 42).Текст;
		СтрИсточникПартнеры.ФормаСобственности = ПредставлениеИсточника.Область(НомерСтроки, 43).Текст;
		СтрИсточникПартнеры.Зона = ПредставлениеИсточника.Область(НомерСтроки, 44).Текст;
		СтрИсточникПартнеры.ИДКлиента = ПредставлениеИсточника.Область(НомерСтроки, 45).Текст;
		
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникПартнеры.Удалить(СтрИсточникПартнеры);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ДействияСТаблицамиПартнеры(ПредставлениеИсточника)
	
	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникПартнеры.Видимость 				= Истина;
		ЗаполнитьТаблицуИсточникПартнеры(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеПартнеры.Видимость 					= Истина;
		Элементы.ПроверкиПартнеры.Видимость 					= Истина;
		Элементы.ОшибокПартнеры.Видимость 						= Истина;
        ЗаполнитьТаблицыПроверкиПартнеры(); 
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыТаблицыПартнеры();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыТаблицыПартнеры();
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.Партнеры.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры 

