&НаСервере 
Процедура ЗаполнитьОтходы(ТекущаяОтходы)
	
	ЗаполняемаяСпецификация = ТекущаяОтходы[0].Спецификация;
	ЗаполняемаяСпецификация = ЗаполняемаяСпецификация.ПолучитьОбъект(); 
	ЗаполняемаяСпецификация.Статус = Перечисления.СтатусыСпецификаций.ВРазработке;
	ЗаполняемаяСпецификация.Записать();
	
	//ТекущаяОтходы.Свернуть("КодРодителя, Родитель, НомерОперации, КодОперации, ТипОборудования, ОсновнойМаршрут, ОткходыКодВн, КраткоеНаименование, Норма, Создано, НоменклатураОтход, Операция, Спецификация");  //ОсновнойМаршрут под вопросом и ТипОборудования исключить
	ТекущаяОтходы.Свернуть("КодРодителя, Родитель, НомерОперации, КодОперации, ОткходыКодВн, КраткоеНаименование, Норма, Создано, НоменклатураОтход, Операция, Спецификация");
	
	Для каждого Строка Из ТекущаяОтходы Цикл  
		
		Если ЗначениеЗаполнено(Строка.Норма) Тогда	
			Если Строка.Норма = 0 Или Строка.Норма = "0" Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				
				СтрокаОтходов = ЗаполняемаяСпецификация.ВозвратныеОтходы.Добавить();  
				СтрокаОтходов.Номенклатура = Строка.НоменклатураОтход;
				Норма =  Строка.Норма; 
				//СтрокаОтходов.КоличествоУпаковок = 1 * Норма /100; 
				СтрокаОтходов.КоличествоУпаковок = Норма;
				СтрокаОтходов.СтатьяКалькуляции = Справочники.СтатьиКалькуляции.НайтиПоНаименованию("Возвратные отходы");
				СтрокаОтходов.СпособАвтовыбораНоменклатуры = Перечисления.СпособыАвтовыбораНоменклатуры.УказываетсяВНСИ;
				СтрокаОтходов.СпособАвтовыбораХарактеристики = Перечисления.СпособыАвтовыбораХарактеристики.УказываетсяВНСИ;
				СтрокаОтходов.ОбработатьПоСпецификации = Ложь;
				СтрокаОтходов.Операция = Строка.Операция; 
				//СтрокаОтходов.ОперацияРедактирование = Строка.Операция; 
				СтрокаОтходов.Этап = ЗаполняемаяСпецификация.ОсновноеИзделиеЭтап;
				//СтрокаОтходов.ЭтапРедактирование = ЗаполняемаяСпецификация.ОсновноеИзделиеЭтап;
				//СтрокаОтходов.КлючСвязи =  // непонятно какой брать 
				ЗаполняемаяСпецификация.Записать(); 
				Строка.Создано = Истина
			Исключение
			КонецПопытки;	
		Иначе 
			Продолжить;
		КонецЕсли;
		
		
	КонецЦикла; 
	ЗаполняемаяСпецификация.Статус = Перечисления.СтатусыСпецификаций.Действует;
	ЗаполняемаяСпецификация.Записать(); 
	  
КонецПроцедуры

