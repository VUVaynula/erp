	Если  БазоваяЕдИзм = ЕдИзмМатериал.Получить(Ключ) Тогда
		СтрокаТЗМатериалыИУслуги.Упаковка = БазоваяЕдИзм;
		СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = КоличествоМатериала;
		Если Строка.ЕдИзм = "ТН" Тогда 
			СтрокаТЗМатериалыИУслуги.Упаковка = ЕдИзмМатериал.Получить(Ключ);
			СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = КоличествоМатериала *1000;
		КонецЕсли;
	Иначе 
		ЕдИзмМатериал = ЕдИзмМатериал.Получить(Ключ);
		СтрокаТЗМатериалыИУслуги.Упаковка = Строка.Материал.ЕдиницаИзмерения;
		СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = КоличествоМатериала * ЕдИзмМатериал.Числитель / ЕдИзмМатериал.Знаменатель;
		Если Строка.ЕдИзм = "ТН" Тогда 
			СтрокаТЗМатериалыИУслуги.Упаковка = ЕдИзмМатериал.Получить(Ключ);
			СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = КоличествоМатериала *1000;
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

&НаСервере 
Процедура ЗаполнениеКоличестваИЕдИзмМатериалаПоЛТ33(Строка, СтрокаТЗМатериалыИУслуги)
	
	БазоваяЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	ЕдИзмМатериал = Неопределено; 
	КоличествоМатериала = Строка.КолвоПозицииВарианта;
	Если Строка.ЕдИзм = "КМ" Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("008");
		Ключ = "008";
	//ИначеЕсли Строка.ЕдИзм = "ТН" Тогда
	//	ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("168");
	//	 Ключ = "168";
	//ИначеЕсли Строка.ЕдИзм = "КГ" Тогда
	//	ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("166");
	//	Ключ = "166"; 
	ИначеЕсли (Строка.ЕдИзм = "КГ") или (Строка.ЕдИзм = "ТН") Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("166");
		Ключ = "166";
	ИначеЕсли Строка.ЕдИзм = "М" Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("006");
		Ключ = "006"; 
	ИначеЕсли Строка.ЕдИзм = "КВМ" Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("055");
		Ключ = "055";
	ИначеЕсли Строка.ЕдИзм = "КУБМ" Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("113");
		Ключ = "113";
	ИначеЕсли Строка.ЕдИзм = "ТШТ" Тогда
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("798");
		Ключ = "798";	
	Иначе
		ЕдИзмМатериал = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(Строка.ЕдИзм);
	КонецЕсли;
	
	Если ЕдИзмМатериал  = Неопределено Тогда
		СтрокаОшибокСпецификации = ОшибокСпецификации.Добавить(); 
		ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаОшибокСпецификации, 
		Строка);
		СтрокаОшибокСпецификации.Ошибка = "Материал записан с некорректной единицей измерения!";
		ЕдИзмМатериал =  Строка.Материал.ЕдиницаИзмерения;
	КонецЕсли;
 
	//СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход = (Число(Строка.ТехнОтход) - 1) * 100;
	Если ЗначениеЗаполнено(Строка.ТехнОтход) Тогда
		Если Строка.ТехнОтход > 0 Тогда
			бит_ТехОтход = Строка.ТехнОтход;
			Если Строка.ТехнОтход >= 1 Тогда
				СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход = (Строка.ТехнОтход - 1) * 100;
			Иначе
				СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход = Строка.ТехнОтход * 100;
			КонецЕсли;  
		Иначе
			СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход = Строка.ТехнОтход;	
		КонецЕсли;
	Иначе
		бит_ТехОтход = 0;
	КонецЕсли;
	СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки = Строка.КоэфтУкрутки;
			
	БазоваяЕдИзм = Строка.Материал.ЕдиницаИзмерения;
	Если (Строка.ЕдИзм = "КГ") 
		Или (Строка.ЕдИзм = "ТН")  
		Или (Строка.ЕдИзм = "М")
		Или  (Строка.ЕдИзм = "КМ") 
		Или  (Строка.ЕдИзм = "КВМ") 
		Или  (Строка.ЕдИзм = "КУБМ")
		Или  (Строка.ЕдИзм = "ТШТ") Тогда
		ЕдИзм = ЕдИзмМатериал.Получить(Ключ); 
	Иначе
		ЕдИзм = ЕдИзмМатериал; 
	КонецЕсли;
	
	Если  БазоваяЕдИзм = ЕдИзм Тогда
		СтрокаТЗМатериалыИУслуги.Упаковка = БазоваяЕдИзм;
		СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции = КоличествоМатериала; 
		Если Строка.ЕдИзм = "ТН" Тогда 
			СтрокаТЗМатериалыИУслуги.Упаковка = ЕдИзмМатериал.Получить(Ключ);
			СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции = КоличествоМатериала *1000;
		КонецЕсли;
	Иначе
		СтрокаТЗМатериалыИУслуги.Упаковка = Строка.Материал.ЕдиницаИзмерения;
		СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции = КоличествоМатериала * ЕдИзм.Числитель / ЕдИзм.Знаменатель;
		Если Строка.ЕдИзм = "ТН" Тогда 
			СтрокаТЗМатериалыИУслуги.Упаковка = ЕдИзмМатериал.Получить(Ключ);
			СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции = КоличествоМатериала *1000;
		КонецЕсли;
	КонецЕсли;	
	
	
	Если ЕстьМеталлосодержащаяТокопроводящаяЖила(СтрокаТЗМатериалыИУслуги.Номенклатура) Тогда
		Если бит_ТехОтход = 0 Тогда 
			СтрокаТЗМатериалыИУслуги.бит_АгрегирующийКоэффициент = Строка.АгрегКоэф_Материалов;
			СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции * 
			?(СтрокаТЗМатериалыИУслуги.бит_АгрегирующийКоэффициент = 0, 1, СтрокаТЗМатериалыИУслуги.бит_АгрегирующийКоэффициент) * 
			?(СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки = 0, 1, СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки);
		Иначе
			СтрокаТЗМатериалыИУслуги.бит_АгрегирующийКоэффициент = 0;
			СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции * 
			(1 + СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход/100) * 
			?(СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки = 0, 1, СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки);
		КонецЕсли;
	Иначе  
		СтрокаТЗМатериалыИУслуги.бит_АгрегирующийКоэффициент = 0;		  
		СтрокаТЗМатериалыИУслуги.КоличествоУпаковок = СтрокаТЗМатериалыИУслуги.бит_КоличествоПозиции * 
		(1 + СтрокаТЗМатериалыИУслуги.бит_ТехнологическийОтход/100) * 
		?(СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки = 0, 1, СтрокаТЗМатериалыИУслуги.бит_КоэффициентУкрутки);
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьМеталлосодержащаяТокопроводящаяЖила(Номенклатура) 
		
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации В(&мПризнаков)
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак В(&мПризнаков)");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("мПризнаков", Справочники.бит_ЗначенияПоУмолчанию.ПризнакиДляРасчетаАгрегКоэффициента.Значения.ВыгрузитьКолонку("Значение")); 

	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

 &НаСервере 
Процедура СозданиеЭтапов(ТекущаяСпецификация, ЗаполняемаяСпецификация, Этап, ВсеПодразделенияБезПрификса)
	     
	   НовыйЭтап = Справочники.ЭтапыПроизводства.СоздатьЭлемент();
	   НовыйЭтап.Наименование = ЗаполняемаяСпецификация.Номенклатура.Наименование;
	   НовыйЭтап.Владелец = ЗаполняемаяСпецификация.Ссылка;
	   НовыйЭтап.НомерЭтапа = 1;
	   НовыйЭтап.НомерСледующегоЭтапа = 0;  
	   ВыпускающийЦех = ТекущаяСпецификация[0].НаименованиеЦеха;
	   Если ВыпускающийЦех = "ОСНОВНОЕ ПРОИЗВОДСТВО" Тогда
		   НовыйЭтап.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("ОСНОВНОЕ ПРОИЗВОДСТВО");
	   ИначеЕсли ВыпускающийЦех = "Цех №2" Тогда 
		   НовыйЭтап.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Цех №2");
	   Иначе
		   СтрокаОшибокСпецификации = ОшибокСпецификации.Добавить(); 
		   ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаОшибокСпецификации, 
		   ТекущаяСпецификация[0]);
		   СтрокаОшибокСпецификации.Ошибка = "Подразделение этапа не сопоставлено!";
		   НовыйЭтап.Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();    
	   КонецЕсли;   
	   НовыйЭтап.ОдновременноПроизводимоеКоличествоЕдиницПартийИзделий = 0; // но это не точно
	   НовыйЭтап.ПланироватьРаботуВидовРабочихЦентров = Истина;
	   НовыйЭтап.ПредварительныйБуфер = 0;
	   НовыйЭтап.ЗавершающийБуфер = 0;
	   НовыйЭтап.ЕдиницаИзмеренияПредварительногоБуфера =  Перечисления.ЕдиницыИзмеренияВремени.День; //Стоит день, но возможно нужно подбирать
	   НовыйЭтап.ЕдиницаИзмеренияЗавершающегоБуфера =  Перечисления.ЕдиницыИзмеренияВремени.День; //Стоит день, но возможно нужно подбирать
	   НовыйЭтап.Непрерывный = Ложь; // но это не точно
	   НовыйЭтап.ПроизводствоНаСтороне = Ложь;
	   НовыйЭтап.МаксимальноеКоличествоЕдиницПартийИзделия = 0;
	   НовыйЭтап.ЗанимаемаяМощность = 100;
	   НовыйЭтап.КоэффициентМаршрутнойКарты = 0;
	   НовыйЭтап.ЕстьПараметризацияРесурсов = Ложь;
	   //НовыйЭтап.УдалитьВидыРабочихЦентровСФормуламиОбновлены = Ложь;
	   //НовыйЭтап.УдалитьОдновременноПроизводимоеКоличествоЕдиницПартийИзделий = 1;
	  НовыйЭтап.ПорядокРаботыВидовРабочихЦентров = Перечисления.ПорядокРаботыВидовРабочихЦентров.Одновременно;  
	  
	   ТЗЭтапа = ТекущаяСпецификация.Скопировать(, "ИДТехмаршрутаРодителя, НомерОперации, КодОперации, НаименованиеОперации, КодЦеха, НаименованиеЦеха, КодОборудования, НаименованиеОборудования, НормаВыработки, ПризнакОснМаршрута, ВРЦ");
	   ТЗЭтапа.Свернуть("ИДТехмаршрутаРодителя, НомерОперации, КодОперации, НаименованиеОперации, КодЦеха, НаименованиеЦеха, КодОборудования, НаименованиеОборудования, НормаВыработки, ПризнакОснМаршрута,ВРЦ");
	   ПроверкаНаличияОсновногоМаршрута(ТЗЭтапа);
	   ТЗЭтапа.Сортировать("НомерОперации Возр, ПризнакОснМаршрута Убыв");
	   ЗаполнениеВРЦАльтернативныеВРЦ(НовыйЭтап, ТЗЭтапа);
	  
	   Если НовыйЭтап.ВидыРабочихЦентров.Количество() = 0 
		   Или (НовыйЭтап.ВидыРабочихЦентров.Количество() = 1 и НовыйЭтап.ВидыРабочихЦентров[0].ВремяРаботы = 0) Тогда 
		   НовыйЭтап.ПланироватьРаботуВидовРабочихЦентров = Ложь; 
		   НовыйЭтап.ДлительностьЭтапа = 1; 
		   НовыйЭтап.ЕдиницаИзмеренияДлительностиЭтапа = Перечисления.ЕдиницыИзмеренияВремени.Час;
	   Иначе
		   ПодобратьИнтервалПланирования(НовыйЭтап);
		   НовыйЭтап.ПорядокРаботыВидовРабочихЦентров = Перечисления.ПорядокРаботыВидовРабочихЦентров.Последовательно; 
	   КонецЕсли; 
		
	   Попытка  
		   НовыйЭтап.Записать();   
		   ЗаполняемаяСпецификация.ОсновноеИзделиеЭтап = НовыйЭтап;
		   ЗаполняемаяСпецификация.ВыходныеИзделия[0].Этап = НовыйЭтап;
		   Для Каждого Материал из ЗаполняемаяСпецификация.МатериалыИУслуги Цикл
			   Материал.Этап = НовыйЭтап; 
			   Материал.ЭтапРедактирование = НовыйЭтап;
		   КонецЦикла;	 
		   Этап = НовыйЭтап;
		Исключение
			Для Каждого Запись Из ТекущаяСпецификация Цикл
			СтрокаОшибокСпецификации = ОшибокСпецификации.Добавить(); 
			ЗаполнитьСтрокуТаблицыПроверкиСпецификации(СтрокаОшибокСпецификации, 
			                                                         Запись);
			СтрокаОшибокСпецификации.Ошибка = "Этап не записан/записан некорректно!";	
			КонецЦикла;	
		КонецПопытки; 
		
КонецПроцедуры

&НаСервере 
Процедура ПроверкаНаличияОсновногоМаршрута(ТЗЭтапа)
	
	ИдентификаторОснМаршрута = 1;
	СтрокаОсновногоМаршрута = ТЗЭтапа.Найти(ИдентификаторОснМаршрута, "ПризнакОснМаршрута");
	Если СтрокаОсновногоМаршрута = Неопределено Тогда
		ТЗЭтапа.Сортировать("ИДТехмаршрутаРодителя Убыв");
		ТекИдентификатор = Неопределено;
		Для Каждого Строка из ТЗЭтапа Цикл
			
			Если ТекИдентификатор = Строка.ИДТехмаршрутаРодителя или ТекИдентификатор = Неопределено Тогда 
				Строка.ПризнакОснМаршрута = 1;
			КонецЕсли;
			
			ТекИдентификатор =  Строка.ИДТехмаршрутаРодителя;
			
		КонецЦикла;	
	КонецЕсли; 

КонецПроцедуры

 &НаСервере 
Процедура ЗаполнениеВРЦАльтернативныеВРЦ(НовыйЭтап, ТЗЭтапа)
	
	НомерОпрации = Неопределено; 
	 
