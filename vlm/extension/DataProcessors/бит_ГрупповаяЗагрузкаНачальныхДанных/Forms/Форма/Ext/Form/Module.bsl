	 |	УпаковкиЕдиницыИзмерения.Наименование = &Наименование";
	
	 Запрос.УстановитьПараметр("Наименование", ЕдиницаИзмерения);
	 
	 РезультатЗапроса = Запрос.Выполнить().Выбрать();
