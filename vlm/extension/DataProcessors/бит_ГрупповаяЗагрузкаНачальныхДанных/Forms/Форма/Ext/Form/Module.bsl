		ДоговорКонтрагента.Комментарий = СтрокаДоговорыКонтрагентов.Комментарий; 
		ДоговорКонтрагента.ДатаНачалаДействия = СтрокаДоговорыКонтрагентов.ДатаНачалаДействия;
		ДоговорКонтрагента.ДатаОкончанияДействия = СтрокаДоговорыКонтрагентов.ДатаОкончанияДействия;
		ДоговорКонтрагента.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		ДоговорКонтрагента.Контрагент = Контрагент; 
		ДоговорКонтрагента.Менеджер = Справочники.Пользователи.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.Менеджер);
		ДоговорКонтрагента.НаименованиеДляПечати = СтрокаДоговорыКонтрагентов.НаименованиеДляПечати;
		ДоговорКонтрагента.Дата = СтрокаДоговорыКонтрагентов.ДатаНачалаДействия;
		ДоговорКонтрагента.Номер = СтрокаДоговорыКонтрагентов.Номер;
		ДоговорКонтрагента.Партнер = Контрагент.Партнер;
		ДоговорКонтрагента.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;
		////
		//Если СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор" Тогда
		//	ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		//Иначе
		//	ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
		//КонецЕсли;
		//Если ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
		//	
		//	ДоговорКонтрагента.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		//Иначе 
		//	ДоговорКонтрагента.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		//КонецЕсли; 
		////
		
		ДоговорКонтрагентаЗаполнениеТипНазначения(СтрокаДоговорыКонтрагентов, ДоговорКонтрагента);
		Если ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
			ДоговорКонтрагента.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ИначеЕсли ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком Тогда 
			ДоговорКонтрагента.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		КонецЕсли;
		ДоговорКонтрагента.ЗакупкаПодДеятельностьОпределяетсяВДокументе = Истина;
        ДоговорКонтрагента.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;
		ДоговорКонтрагента.Согласован = Истина;  
		ДоговорКонтрагента.НалогообложениеНДСОпределяетсяВДокументе = Истина; 
		ДоговорКонтрагента.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", 
		Перечисления.СтавкиНДС.НДС20); 
		ДоговорКонтрагента.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		Если КонтактноеЛицо = Неопределено Тогда
			//ДоговорКонтрагента.КонтактноеЛицо =
			//                Справочники.КонтактныеЛицаПартнеров.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.КонтактноеЛицо,,,Контрагент.Партнер); 
			Если СтрокаДоговоры.Количество() = 1 и ЗначениеЗаполнено(СтрокаДоговорыКонтрагентов.КонтактноеЛицо) Тогда
				//ДоговорКонтрагента.КонтактноеЛицо = СтрокаДоговоры[0].Ссылка; 
				ДоговорКонтрагента.КонтактноеЛицо =
			                Справочники.КонтактныеЛицаПартнеров.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.КонтактноеЛицо,,,Контрагент.Партнер); 
			ИначеЕсли ЗначениеЗаполнено(СтрокаДоговорыКонтрагентов.КонтактноеЛицо) Тогда
				ДоговорКонтрагента.КонтактноеЛицо = Справочники.КонтактныеЛицаПартнеров.НайтиПоНаименованию(СтрокаДоговорыКонтрагентов.КонтактноеЛицо,Истина,,Контрагент.Партнер);
			Иначе 
				ДоговорКонтрагента.КонтактноеЛицо = Справочники.КонтактныеЛицаПартнеров.ПустаяСсылка();
			КонецЕсли;	
		Иначе 
			ДоговорКонтрагента.КонтактноеЛицо = КонтактноеЛицо;
		КонецЕсли;
		
		Если ДоговорКонтрагента.КонтактноеЛицо.Владелец <> Контрагент.Партнер Тогда 
			ДоговорКонтрагента.КонтактноеЛицо = Справочники.КонтактныеЛицаПартнеров.ПустаяСсылка();
		КонецЕсли;	
			
		ДоговорКонтрагента.Сумма = СтрокаДоговорыКонтрагентов.Сумма;
		
		Попытка	
			ДоговорКонтрагента.Записать();
			СтрокаДоговорыКонтрагентов.Создано = Истина;
		Исключение
			СтрокаДоговорыКонтрагентов.Создано = Ложь;
		КонецПопытки; 
		
		КонецЕсли;
КонецПроцедуры 

&НаСервере                                                                         
Процедура ДоговорКонтрагентаЗаполнениеТипНазначения(СтрокаДоговорыКонтрагентов, ДоговорКонтрагента)
	
	ТипДоговора = ПроверкаТипаДоговора(СтрокаДоговорыКонтрагентов);
	Если ТипДоговора = "Реализация" Тогда 
		ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		//ДоговорКонтрагента.Назначение = Справочники.Назначения.НайтиПоНаименованию(ДоговорКонтрагента.ТипДоговора);
	ИначеЕсли ТипДоговора = "Закупка" Тогда  
		ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
		//ДоговорКонтрагента.Назначение = Справочники.Назначения.НайтиПоНаименованию(ДоговорКонтрагента.ТипДоговора)
	ИначеЕсли ТипДоговора = "Импорт" Тогда  
		ДоговорКонтрагента.ТипДоговора = Перечисления.ТипыДоговоров.Импорт;
		//ДоговорКонтрагента.Назначение = Справочники.Назначения.НайтиПоНаименованию(ДоговорКонтрагента.ТипДоговора)
	КонецЕсли;	

КонецПроцедуры

&НаСервере                                                                         
Функция  ПроверкаТипаДоговора(СтрокаДоговорыКонтрагентов)	
	
	ТипДоговора = "";
	Если СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор" 
		Или СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор оказания услуг (выполнения работ)" Тогда
		
		Если СтрокаДоговорыКонтрагентов.Назначение = "Покупатель" 
             Или СтрокаДоговорыКонтрагентов.Назначение = "" Тогда
			   ТипДоговора = "Реализация";
		ИначеЕсли СтрокаДоговорыКонтрагентов.Назначение = "Поставщик" Тогда	   
		       ТипДоговора = "Закупка"; 
		КонецЕсли;
		   
	//ИначеЕсли СтрокаДоговорыКонтрагентов.ТипДоговора = "ДОГОВОР аренды"	Тогда
	//	
	//	Если СтрокаДоговорыКонтрагентов.Назначение = "Покупатель" 
	//         Или СтрокаДоговорыКонтрагентов.Назначение = "" Тогда
	//		   ТипДоговора = "Реализация";
	//	   КонецЕсли; 
		   
	ИначеЕсли СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор купли-продажи"	Тогда
		
		Если СтрокаДоговорыКонтрагентов.Назначение = "Покупатель" 
             Или СтрокаДоговорыКонтрагентов.Назначение = "" Тогда
			   ТипДоговора = "Реализация";
		ИначеЕсли СтрокаДоговорыКонтрагентов.Назначение = "Поставщик" Тогда	   
		       ТипДоговора = "Закупка"; 
		КонецЕсли;

		//ТипДоговора = "Реализация"; 

	ИначеЕсли СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор перевозки" Тогда
		
		Если СтрокаДоговорыКонтрагентов.Назначение = "Покупатель" 
             Или СтрокаДоговорыКонтрагентов.Назначение = "" Тогда
			   ТипДоговора = "Реализация";
        КонецЕсли;
			   
	ИначеЕсли СтрокаДоговорыКонтрагентов.ТипДоговора = "Договор поставки" Тогда
		
		Если СтрокаДоговорыКонтрагентов.Назначение = "Покупатель" 
             Или СтрокаДоговорыКонтрагентов.Назначение = "" Тогда
			   ТипДоговора = "Реализация";
		ИначеЕсли СтрокаДоговорыКонтрагентов.Назначение = "Поставщик" Тогда	   
		       ТипДоговора = "Закупка"; 
		КонецЕсли;
		   
		//ТипДоговора = "Закупка";
		
	ИначеЕсли СтрокаДоговорыКонтрагентов.ТипДоговора = "Контракт"	Тогда  
		
		Если СтрокаДоговорыКонтрагентов.Назначение = "Поставщик" Тогда	   
		       ТипДоговора = "Закупка"; 
		   КонецЕсли;

	КонецЕсли;	
		
	Возврат ТипДоговора;
	
КонецФункции

