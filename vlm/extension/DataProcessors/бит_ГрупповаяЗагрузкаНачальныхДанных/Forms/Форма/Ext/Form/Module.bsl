&НаКлиенте 
Процедура ДействияСТаблицамиНоменклатура(ПредставлениеИсточника)        

	Если ИдентификаторСостояния = "Состояние1" Тогда
		Элементы.ИсточникНоменклатура.Видимость 	= Истина;
		ЗаполнитьТаблицуИсточникНоменклатура(ПредставлениеИсточника);
	ИначеЕсли ИдентификаторСостояния = "Состояние2" Тогда 
		Элементы.СозданиеНоменклатура.Видимость 	= Истина;
		Элементы.ПроверкиНоменклатура.Видимость 	= Истина;
		Элементы.ОшибокНоменклатура.Видимость 	= Истина;
		ЗаполнитьТаблицыПроверкиНоменклатура();
	ИначеЕсли ИдентификаторСостояния = "Состояние3" Тогда
		СоздатьЭлементыНоменклатура();
	ИначеЕсли ИдентификаторСостояния = "Состояние4" Тогда
	    ПроверитьЭлементыНоменклатура();	
	ИначеЕсли ИдентификаторСостояния = "Состояние5" Тогда
		ОткрытьФорму("Справочник.Номенклатура.ФормаСписка");
	Иначе
		Возврат;
	КонецЕсли; 
			
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицуИсточникНоменклатура(ПредставлениеИсточника)
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	Пока НЕ ФлагПрерывания Цикл 
		НомерСтроки = НомерСтроки + 1;
		СтрИсточникНоменклатура = ИсточникНоменклатура.Добавить();	 
		
		ТекстКолонки = ПредставлениеИсточника.Область(Формат(НомерСтроки, "ЧГ=0"), 2).Текст;
		СтрИсточникНоменклатура.Наименование = ТекстКолонки;  
		СтрИсточникНоменклатура.Родитель = ПредставлениеИсточника.Область(НомерСтроки, 1).Текст;
	    СтрИсточникНоменклатура.ЕдиницаИзмерения = ПредставлениеИсточника.Область(НомерСтроки, 4).Текст;
		СтрИсточникНоменклатура.Артикул = ПредставлениеИсточника.Область(НомерСтроки, 5).Текст;
		СтрИсточникНоменклатура.ВесЗнаменатель = ПредставлениеИсточника.Область(НомерСтроки, 8).Текст;
		СтрИсточникНоменклатура.ВесЧислитель = ПредставлениеИсточника.Область(НомерСтроки, 11).Текст;
		СтрИсточникНоменклатура.ВидНоменклатуры = ПредставлениеИсточника.Область(НомерСтроки, 15).Текст;
		СтрИсточникНоменклатура.ИспользоватьИндивидуальныйШаблонЭтикетки =
		                                                       ПредставлениеИсточника.Область(НомерСтроки, 29).Текст; 
		СтрИсточникНоменклатура.ШаблонЭтикетки = ПредставлениеИсточника.Область(НомерСтроки, 67).Текст; 
        СтрИсточникНоменклатура.ИспользоватьУпаковки = ПредставлениеИсточника.Область(НомерСтроки, 30).Текст;
		СтрИсточникНоменклатура.ОбъемДАЛ = ПредставлениеИсточника.Область(НомерСтроки, 37).Текст;
		СтрИсточникНоменклатура.СтавкаНДС = ПредставлениеИсточника.Область(НомерСтроки, 45).Текст;
		СтрИсточникНоменклатура.ТипНоменклатуры = ПредставлениеИсточника.Область(НомерСтроки, 46).Текст;
		СтрИсточникНоменклатура.КоэффициентЕдиницыДляОтчетов = ПредставлениеИсточника.Область(НомерСтроки, 66).Текст;
		СтрИсточникНоменклатура.ВладелецСерий = ПредставлениеИсточника.Область(НомерСтроки, 79).Текст;
		СтрИсточникНоменклатура.ВладелецХарактеристик = ПредставлениеИсточника.Область(НомерСтроки, 80).Текст;
		СтрИсточникНоменклатура.ВладелецТоварныхКатегорий = ПредставлениеИсточника.Область(НомерСтроки, 81).Текст;
		СтрИсточникНоменклатура.ОсобенностьУчета = ПредставлениеИсточника.Область(НомерСтроки, 83).Текст;
						
		Если ПустаяСтрока(ТекстКолонки) Тогда
			ФлагПрерывания = Истина;
			ИсточникНоменклатура.Удалить(СтрИсточникНоменклатура);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнитьТаблицыПроверкиНоменклатура()
	
	УсловноеОформление.Элементы.Очистить();
	 
	МассивНаименований = ИсточникНоменклатура.Выгрузить( , "Наименование");
	МассивАртикулов = ИсточникНоменклатура.Выгрузить( , "Артикул");
	МассивВидНоменклатуры = ИсточникНоменклатура.Выгрузить( , "ВидНоменклатуры");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК СсылкаНоменклатура,
	|	Номенклатура.Наименование КАК НаименованиеНоменклатура,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование В(&МассивНаименований)
	|	И Номенклатура.Артикул В(&МассивАртикулов)
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК СсылкаВидыНоменклатуры,
	|	ВидыНоменклатуры.Наименование КАК НаименованиеВидыНоменклатуры
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.Наименование В(&МассивВидНоменклатуры)
	|	И ВидыНоменклатуры.ЭтоГруппа = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивНаименований", МассивНаименований);
	Запрос.УстановитьПараметр("МассивВидНоменклатуры", МассивВидНоменклатуры);
    Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаНоменклатура = РезультатЗапроса[0].Выгрузить();
	ВыборкаВидыНоменклатуры = РезультатЗапроса[1].Выгрузить();
		
	ЗаполнениеТаблицНоменклатура(ВыборкаНоменклатура, ВыборкаВидыНоменклатуры);    	 
КонецПроцедуры 

&НаСервере 
Процедура ЗаполнениеТаблицНоменклатура(ВыборкаНоменклатура, ВыборкаВидыНоменклатуры)
	
	//ИдентификаторЕденицИзмеренияКМ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоРеквизиту("Наименование", "км/1000 м"); 
	ИдентификаторЕденицИзмеренияКМ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("км"); 
	Если ИдентификаторЕденицИзмеренияКМ.Пустая() Тогда
		ИдентификаторЕденицИзмеренияКМ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("008");
	КонецЕсли;	
	
	ИдентификаторЕденицИзмеренияКГ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("кг"); 
	Если ИдентификаторЕденицИзмеренияКГ.Пустая() Тогда
		ИдентификаторЕденицИзмеренияКГ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("166");
	КонецЕсли;  
	
	ИдентификаторЕденицИзмеренияТ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("т"); 
	Если ИдентификаторЕденицИзмеренияТ.Пустая() Тогда
		ИдентификаторЕденицИзмеренияТ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("168");
	КонецЕсли;
	
	Для каждого СтрокаНоменклатура Из ИсточникНоменклатура Цикл
		
		ТекстСообщения = ""; 
				
		ИдентификаторВидыНоменклатуры = ВыборкаВидыНоменклатуры.Найти(СтрокаНоменклатура.ВидНоменклатуры);
		Если ИдентификаторВидыНоменклатуры = Неопределено Тогда
			ТекстСообщения = ТекстСообщения + "Вид номенклатуры не найден! ";  
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СтрокаПоиска", СтрокаНоменклатура.ТипНоменклатуры);
		ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если ТипНоменклатуры.Количество() = 0 Тогда
			ТекстСообщения = ТекстСообщения + "Тип номенклатуры не найден! ";
		КонецЕсли;
		
		Отбор = Новый Структура();
        Отбор.Вставить("НаименованиеНоменклатура", СтрокаНоменклатура.Наименование); 
		Отбор.Вставить("Артикул", СтрокаНоменклатура.Артикул); 
		Наименование = ВыборкаНоменклатура.НайтиСтроки(Отбор);


		Если ТекстСообщения <> "" Тогда
			СтрокаОшибокНоменклатура = ОшибокНоменклатура.Добавить();
			ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаОшибокНоменклатура, 
			СтрокаНоменклатура);
			СтрокаОшибокНоменклатура.Ошибка = ТекстСообщения;
		ИначеЕсли Наименование.Количество() > 0  Тогда 
			СтрокаПроверкиНоменклатура = ПроверкиНоменклатура.Добавить(); 
			ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаПроверкиНоменклатура, 
			СтрокаНоменклатура);
		Иначе 
			СтрокаСозданиеНоменклатура = СозданиеНоменклатура.Добавить(); 
			ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаСозданиеНоменклатура,
			СтрокаНоменклатура);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры	

&НаСервере 
Процедура ЗаполнитьСтрокуТаблицыНоменклатура(СтрокаПриемник, СтрокаИсточник)  
		                 
	СтрокаПриемник.Родитель = СтрокаИсточник.Родитель; 
