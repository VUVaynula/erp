			ЭлементКонтактнаяИнформацияКонтрагент.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента; 
			ЭлементКонтактнаяИнформацияКонтрагент.Представление = СтрокаПартнеры.КонтактнаяИнформацияТип;
			ЭлементКонтактнаяИнформацияКонтрагент.Страна = СтрокаПартнеры.КонтактнаяИнформацияСтрана;
			ЭлементКонтактнаяИнформацияКонтрагент.Регион = СтрокаПартнеры.КонтактнаяИнформацияРегион;
			ЭлементКонтактнаяИнформацияКонтрагент.Город = СтрокаПартнеры.КонтактнаяИнформацияГород;
			ЭлементКонтактнаяИнформацияКонтрагент.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента;
			Если ТипЗнч(ЭлементПриемник) =  Тип("СправочникСсылка.Контрагенты") Тогда
			ЭлементКонтактнаяИнформацияКонтрагент.ДействуетС = Дата;
			КонецЕсли;
           		
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры	

&НаСервере 
Функция ПроверитСтранаРегистрации(СтранаРегистрации)
	
	СтраныРегистрации = КорректировкаНаименованияСтраныРегистрации(СтранаРегистрации);
	СтраныРегистрации = ВРег(СтранаРегистрации);
	СправочникСтранаРегистрации = Справочники.СтраныМира.ДанныеСтраныМира( ,СтраныРегистрации);
	Если  ТипЗнч(СправочникСтранаРегистрации) = Тип("Структура") Тогда
		  СправочникСтранаРегистрации = СправочникСтранаРегистрации.Ссылка;
	КонецЕсли;
	  
	Если СправочникСтранаРегистрации = Неопределено Тогда  
		
		КлассификаторСтрана = Справочники.СтраныМира.ДанныеКлассификатораСтранМираПоНаименованию(СтраныРегистрации);
		Если КлассификаторСтрана <> Неопределено Тогда
			Если КлассификаторСтрана.Количество() > 0 Тогда
				
				СправочникСтранаРегистрации = Справочники.СтраныМира.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(СправочникСтранаРегистрации, КлассификаторСтрана);
				СправочникСтранаРегистрации.Записать();
				СправочникСтранаРегистрации = СправочникСтранаРегистрации.Ссылка;
				
			КонецЕсли;
		Иначе
			СправочникСтранаРегистрации = Неопределено;
		КонецЕсли;
		
	//Иначе
	//	СправочникСтранаРегистрации = СправочникСтранаРегистрации.Ссылка;	
	КонецЕсли; 
	
	Возврат СправочникСтранаРегистрации;

КонецФункции	

&НаСервере
Функция КорректировкаНаименованияСтраныРегистрации(СтранаРегистрации)
	
	Если СтранаРегистрации = "Великобритания" Тогда
		СтранаРегистрации = "СОЕДИНЕННОЕ КОРОЛЕВСТВО";
	ИначеЕсли СтранаРегистрации = "Иран" Тогда
		СтранаРегистрации = "ИРАН (ИСЛАМСКАЯ РЕСПУБЛИКА)";
	ИначеЕсли СтранаРегистрации = "Кыргызстан" Тогда
		СтранаРегистрации = "КИРГИЗИЯ";
	ИначеЕсли СтранаРегистрации = "Молдова" Тогда
		СтранаРегистрации = "МОЛДОВА, РЕСПУБЛИКА"; 
	ИначеЕсли СтранаРегистрации = "ОАЭ" Тогда
		СтранаРегистрации = "ОБЪЕДИНЕННЫЕ АРАБСКИЕ ЭМИРАТЫ";
	ИначеЕсли СтранаРегистрации = "США" Тогда
		СтранаРегистрации = "СОЕДИНЕННЫЕ ШТАТЫ"; 
	ИначеЕсли СтранаРегистрации = "Туркмения" Тогда
		СтранаРегистрации = "ТУРКМЕНИСТАН";
	Иначе 
		Возврат СтранаРегистрации;	 
	КонецЕсли;
	
	Возврат СтранаРегистрации;

КонецФункции

