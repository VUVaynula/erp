&НаКлиенте 
Процедура ЗаполнитьТаблицу(ПредставлениеИсточника = Неопределено)
	
	Если Объект.ИдентификаторСправочника = "БанковскиеСчетаКонтрагентов" Тогда
		ДействияСТаблицамиБанковскиеСчетаКонтрагентов(ПредставлениеИсточника);
	ИначеЕсли Объект.ИдентификаторСправочника = "БанковскиеСчетаОрганизаций" Тогда
		ДействияСТаблицамиБанковскиеСчетаОрганизаций(ПредставлениеИсточника);
	ИначеЕсли Объект.ИдентификаторСправочника = "Контрагенты" 
		  ИЛИ Объект.ИдентификаторСправочника = "Партнеры" Тогда
		ДействияСТаблицамиПартнеры(ПредставлениеИсточника);
	ИначеЕсли Объект.ИдентификаторСправочника = "ДоговорыКонтрагентов" Тогда
		ДействияСТаблицамиДоговорыКонтрагентов(ПредставлениеИсточника);  
	ИначеЕсли Объект.ИдентификаторСправочника = "ВидыНоменклатуры" Тогда
		ДействияСТаблицамиВидыНоменклатуры(ПредставлениеИсточника);  
	ИначеЕсли Объект.ИдентификаторСправочника = "Номенклатура" Тогда
		ДействияСТаблицамиНоменклатура(ПредставлениеИсточника);
	ИначеЕсли Объект.ИдентификаторСправочника = "ПризнакиНоменклатуры" 
		Или Объект.ИдентификаторСправочника = "ПризнакиОтходов"
		Или Объект.ИдентификаторСправочника = "ПризнакиТара" Тогда
		ДействияСТаблицамиПризнакиНоменклатуры(ПредставлениеИсточника);	
	ИначеЕсли Объект.ИдентификаторСправочника = "Банки" Тогда
		ДействияСТаблицамиБанки(ПредставлениеИсточника); 
	ИначеЕсли Объект.ИдентификаторСправочника = "АтрибутыКонтрагентов" Тогда
		ДействияСТаблицамиАтрибутыКонтрагентов(ПредставлениеИсточника);	
		ИначеЕсли Объект.ИдентификаторСправочника = "ВидыРабочихЦентров" Тогда
		ДействияСТаблицамиВидыРабочихЦентров(ПредставлениеИсточника);  	
	ИначеЕсли Объект.ИдентификаторСправочника = "РабочиеЦентры" Тогда
		ДействияСТаблицамиРабочиеЦентры(ПредставлениеИсточника);  	
	ИначеЕсли Объект.ИдентификаторСправочника = "Спецификации" Тогда
		ДействияСТаблицамиСпецификации(ПредставлениеИсточника); 
	ИначеЕсли Объект.ИдентификаторСправочника = "ОходыСпецификаций" Тогда
		ДействияСТаблицамиОходыСпецификаций(ПредставлениеИсточника);	
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеНазад(Команда)
	
	ИдентификаторСостояния = "Состояние0";
	Элементы.ЭтапыЗагрузки.ТекущаяСтраница = Элементы.ЭтапыЗагрузки.ПодчиненныеЭлементы.Приветствие;
	ТаблицыСкрытьОчиститьСопоставление();
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеДалее(Команда)
	
	ИдентификаторСостояния = "Состояние2";
	Элементы.ЭтапыЗагрузки.ТекущаяСтраница = Элементы.ЭтапыЗагрузки.ПодчиненныеЭлементы.Создание; 
	Элементы.СозданиеЗагрузить.Видимость = Ложь;
	Элементы.СозданиеПроверить.Видимость = Ложь;
	Элементы.СозданиеЗагрузить.Доступность = Ложь;
	Элементы.СозданиеПроверить.Доступность = Ложь;
	Элементы.СозданиеВсеРавноЗагрузить.Видимость = Ложь;
	Элементы.СозданиеВсеРавноЗагрузить.Доступность = Ложь;
	Элементы.ЗаполнитьПризнакиНоменклатуры.Видимость = Ложь;
    Элементы.ЗаполнитьПризнакиНоменклатуры.Доступность = Ложь;
	Элементы.ЗаполнитьАтрибутыКонтрагентов.Видимость = Ложь;
    Элементы.ЗаполнитьАтрибутыКонтрагентов.Доступность = Ложь;
	
    ЗаполнитьТаблицу();  
	ПриСменеСтраницы(Элементы.Группа9, Элементы.ЭтапыЗагрузки.ТекущаяСтраница.ПодчиненныеЭлементы.Группа9.ТекущаяСтраница);
		
КонецПроцедуры

