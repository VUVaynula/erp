&НаСервере 
Процедура ПредварительноЗаполнитьСпецификацию(ТекущаяСпецификация, ЗаполняемаяСпецификация)
	
	ЗаполняемаяСпецификация.Статус = Перечисления.СтатусыСпецификаций.ВРазработке;
	Если ТекущаяСпецификация[0].ПризнакОснМаршрута <> 1 Тогда
		ЗаполняемаяСпецификация.НачалоДействия = Дата - 1;
	Иначе
		ЗаполняемаяСпецификация.НачалоДействия = Дата;
	КонецЕсли;
	ЗаполняемаяСпецификация.Ответственный = Пользователи.ТекущийПользователь();
	ЗаполняемаяСпецификация.Наименование =  ТекущаяСпецификация[0].Родитель + ", " + ТекущаяСпецификация[0].ВРЦ.бит_КрНоим;
	ЗаполняемаяСпецификация.ВариантНазначения = Перечисления.ВариантыНазначенияСпецификации.Номенклатура;
