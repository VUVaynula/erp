&НаСервере
Функция ПолучитьЗначениеПризнака(СтрокаПризнакиНоменклатуры, бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса)
	
	Если Объект.ИдентификаторСправочника = "ПризнакиНоменклатуры" Тогда  
		бит_Значение = ПолучитьЗначениеПризнакаНоменкллатуры(СтрокаПризнакиНоменклатуры,
																бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса); 
	ИначеЕсли Объект.ИдентификаторСправочника = "ПризнакиОтходов" Тогда  
		бит_Значение = ПолучитьЗначениеПризнакаОтход(СтрокаПризнакиНоменклатуры, 
																бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса);	
	ИначеЕсли Объект.ИдентификаторСправочника = "ПризнакиТара" Тогда 
		бит_Значение = ПолучитьЗначениеПризнакаТара(СтрокаПризнакиНоменклатуры, 
																бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса);	
	КонецЕсли;
	
	Возврат бит_Значение;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеПризнакаОтход(СтрокаПризнакиНоменклатуры, бит_Признак, бит_Номенклатура, ВсеПодразделенияБезПрификса)
		
	Если СтрокаПризнакиНоменклатуры.КодПризнака = "003/00" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "10/06"  
		Тогда
		бит_Значение = Истина;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "CEXV_OSNMA" Тогда
		ПараметрыОтбора = Новый Структура; 
		Если СтрокаПризнакиНоменклатуры.ЗначениеПризнака = "" Тогда
			бит_Значение = Неопределено;
		Иначе
			ПараметрыОтбора.Вставить("Код",Число(СтрокаПризнакиНоменклатуры.ЗначениеПризнака)); 
			Значение = ВсеПодразделенияБезПрификса.НайтиСтроки(ПараметрыОтбора);
			Если Значение.Количество() > 0 Тогда  
				бит_Значение = Значение[0].Ссылка;
			Иначе
				бит_Значение = Неопределено;
			КонецЕсли;
		КонецЕсли;
	 ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "ISP_OUTSID" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KODMAR"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "KPROD" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "NAPR" 
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "RAZMER"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "TYPE_MAT"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "TYPE_VZOTX"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "VID_OTX"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "VIDIZ_OSNM"
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "WISP"
		Тогда
		ПараметрыОтбора = Новый Структура;
		Отбор = Новый Структура;  
		ДлинаНаименования = Метаданные.Справочники.бит_ДополнительныеПризнакиНоменклатуры.ДлинаНаименования;
		НаименованиеДопПризнака = Лев(СтрокаПризнакиНоменклатуры.ЗначениеПризнака, ДлинаНаименования);

		Отбор.Вставить("Наименование", НаименованиеДопПризнака); 
		Отбор.Вставить("Владелец", бит_Признак[0].Значение);   
		ПараметрыОтбора.Вставить("Отбор", Отбор);
        Значение = Справочники.бит_ДополнительныеПризнакиНоменклатуры.ПолучитьДанныеВыбора(ПараметрыОтбора);
		Если Значение = Неопределено Или Значение.Количество() = 0 Тогда
			ДополнительныйПризнак = Справочники.бит_ДополнительныеПризнакиНоменклатуры.СоздатьЭлемент();
			ДополнительныйПризнак.Наименование = СтрокаПризнакиНоменклатуры.ЗначениеПризнака;
			ДополнительныйПризнак.Владелец = бит_Признак[0].Значение; 
			ДополнительныйПризнак.Записать();
			Значение = ДополнительныйПризнак;
		КонецЕсли;
		бит_Значение = Значение;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "MARKA" Тогда
		Значение = Справочники.Марки.НайтиПоНаименованию(СтрокаПризнакиНоменклатуры.ЗначениеПризнака);	
		Если Значение = Неопределено Или Значение.Пустая() Тогда
			Марка = Справочники.Марки.СоздатьЭлемент();
			Марка.Наименование = СтрокаПризнакиНоменклатуры.ЗначениеПризнака;
			Марка.Записать();
			Значение = Марка.Ссылка;
		КонецЕсли;
		НоменклатураТ = бит_Номенклатура.ПолучитьОбъект();
		НоменклатураТ.Марка = Значение;
		НоменклатураТ.Записать();
		бит_Значение = Значение;
	ИначеЕсли СтрокаПризнакиНоменклатуры.КодПризнака = "MKF2"  
		Или СтрокаПризнакиНоменклатуры.КодПризнака = "SECH"
		 Тогда 
		бит_Значение = СтрокаПризнакиНоменклатуры.ЗначениеПризнака; 
	Иначе
		бит_Значение = Неопределено;
	КонецЕсли;	
	
	Возврат бит_Значение;
	
КонецФункции	
	
