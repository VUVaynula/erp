&НаСервере
Процедура НайтиКонтроллераНаСервере()
	
	Запрос = Новый Запрос("ВЫБРАТЬ Первые 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники.ДополнительныеРеквизиты КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Свойство = &ШтампКонтроллера
	|	И Сотрудники.Значение.Наименование = &Значение");  
	
	СвойствоШтампКонтроллера = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШтампКонтроллера, , Истина); 

	Запрос.УстановитьПараметр("ШтампКонтроллера", СвойствоШтампКонтроллера);
	Запрос.УстановитьПараметр("Значение", ШтампКонтроллёра);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Контроллёр = Выборка.Ссылка;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сотрудник не найден");
		Контроллёр = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

