&НаКлиенте
Процедура ОткрытьФормуВыбора(Знач Ключ, Знач Параметр, Знач ДопПараметр = "")
	
	ПФ = новый Структура;
	ПФ.Вставить("ЗакрыватьПриВыборе", Истина);
	ПФ.Вставить("МножественныйВыбор", Ложь);
	ПФ.Вставить("РежимВыбора", Истина);
	Если ЗначениеЗаполнено(Ключ) Тогда
		ПФ.Вставить("Ключ", Ключ);
		ПФ.Вставить("ТекущаяСтрока", Ключ);
	КонецЕсли;                   
	
	Если ДопПараметр = "Тара" Тогда
		ПФ.Вставить("Отбор", Новый Структура("ТипНоменклатуры", ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МногооборотнаяТара")));
	ИначеЕсли ДопПараметр = "Серия" Тогда
		ПФ.Вставить("ВидНоменклатуры", ВладелецСерийВидаНоменклатуры(Номенклатура));
		// По умолчанию только показаны серии, у которых реквизит "Завешено" = Ложь. У пользователя должна быть возможность убрать этот отбор.
	КонецЕсли;
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыбора", ЭтотОбъект, Параметр + ДопПараметр);
	
	Форма = ОткрытьФорму("Справочник." + Параметр + ".ФормаВыбора", ПФ, ЭтаФорма,,,,ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Если ДопПараметр = "Серия" Тогда
		ПользовательскийОтбор = Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Форма.Список.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
		ПользовательскийОтбор.Элементы.Очистить();
	//    	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список,"бит_Завешено", Ложь, ВидСравненияКомпоновкиДанных.Равно, , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ, Новый УникальныйИдентификатор);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВладелецСерийВидаНоменклатуры(Номенклатура)
	
	ТекВид = Номенклатура.ВидНоменклатуры;
	Пока ЗначениеЗаполнено(ТекВид.ВладелецСерий) Цикл
		ТекВид = ТекВид.ВладелецСерий;
	КонецЦикла;    
	
	Возврат ТекВид;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбора(ВыбранноеЗначение, ДопПараметр) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметр = "СерииНоменклатурыСерия" Тогда
		Серия = ВыбранноеЗначение;	
		ПриИзмененииСерии();
	ИначеЕсли ДопПараметр = "Номенклатура" Тогда
		Номенклатура = ВыбранноеЗначение; 
		ПриИзмененииНоменклатуры();
	ИначеЕсли ДопПараметр = "бит_СменыВесовщика" Тогда
		СменаВесовщика = ВыбранноеЗначение;   
	ИначеЕсли ДопПараметр = "Сотрудники" Тогда
		Контроллёр = ВыбранноеЗначение;
		ПриИзмененииКонтроллера();
	ИначеЕсли ДопПараметр = "Пользователи" Тогда
		Весовщик = ВыбранноеЗначение;
		//ПриИзмененииВесовщика(); 
	ИначеЕсли ДопПараметр = "НоменклатураТара" Тогда
		Тара = ВыбранноеЗначение;   
		МассаТары = МассаТарыКГ(Тара);
		ПересчитатьНетто();
	ИначеЕсли ДопПараметр = "ШКНоменклатуры" Тогда
		ОбработатьШтрихкод(ВыбранноеЗначение, "Номенклатура");  
		ПриИзмененииНоменклатуры(); 
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ПоказатьПредупреждение( , "Номенклатура по штрихкоду не найдена");
		КонецЕсли;		
	ИначеЕсли ДопПараметр = "ШКСерии" Тогда                   
		ОбработатьШтрихкод(ВыбранноеЗначение, "СерииНоменклатуры");
		ПослеОбработкиШКСерииНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСерии()
	Если ЗначениеЗаполнено(Серия) Тогда
		
		ДопСвойство = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШтампЭмалировщика, , Истина);
	
		ШтампЭмалировщика = УправлениеСвойствами.ЗначениеСвойства(Серия.бит_Эмалировщик, ДопСвойство);
	 
	КонецЕсли;
КонецПроцедуры               

&НаКлиенте
Процедура ПересчитатьНетто()             
	
	МассаНетто = Макс(0, МассаБрутто - МассаТары);
	
КонецПроцедуры                           

&НаСервереБезКонтекста
Функция МассаТарыКГ(Знач Тара)
	
	Если Не ЗначениеЗаполнено(Тара) или Тара.ВесИспользовать = Ложь Тогда
		Масса = 0;
	Иначе
		кг = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("166");
		Масса = Тара.ВесЧислитель / ?(ЗначениеЗаполнено(Тара.ВесЗнаменатель), Тара.ВесЗнаменатель, 1);
		Если Тара.ЕдиницаИзмерения <> кг Тогда
			Масса = Масса * ?(ЗначениеЗаполнено(Тара.ЕдиницаИзмерения.Числитель), Тара.ЕдиницаИзмерения.Числитель, 1) / ?(ЗначениеЗаполнено(Тара.ЕдиницаИзмерения.Знаменатель), Тара.ЕдиницаИзмерения.Знаменатель, 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Масса;
КонецФункции             

&НаКлиенте
Процедура НайтиНоменклатуруПоШК(Команда)                                                                                         
	
	ОчиститьСообщения();
	Оповещение = Новый ОписаниеОповещения("ПослеВыбора", ЭтотОбъект, "ШКНоменклатуры");    
	
	ЗаголовокФормыВводаСерий = НСтр("ru = 'Введите штрихкод номенклатуры';
									|en = 'Enter barcode batch'");
	ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение,,ЗаголовокФормыВводаСерий);

КонецПроцедуры

