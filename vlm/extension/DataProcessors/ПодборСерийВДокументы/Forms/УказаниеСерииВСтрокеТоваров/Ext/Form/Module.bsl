	бит_НомерЗаказа = Новый РеквизитФормы("бит_НомерЗаказа", ОписаниеЧисло10_0, , "(бит) № заказа");
	бит_Брутто = Новый РеквизитФормы("бит_Брутто", ОписаниеЧисло9_3, , "(бит) Брутто, кг");
	бит_ТипТары = Новый РеквизитФормы("бит_ТипТары", Описаниебит_ДополнительныеПризнакиНоменклатуры, , "(бит) Тип тары");
	бит_Штрихкод = Новый РеквизитФормы("бит_Штрихкод", ОписаниеСтроки, , "(бит) Штрихкод");
    	
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_НомерЗавеса);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_НомерЗаказа);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_Брутто);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_ТипТары);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_Штрихкод);
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизитыОстаткиСерий);
	
	//(бит) Намотки
	НовыйЭлемент = Элементы.Вставить("ОстаткиСерийбит_НомерЗавеса", Тип("ПолеФормы"), Элементы.ОстаткиСерий, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
