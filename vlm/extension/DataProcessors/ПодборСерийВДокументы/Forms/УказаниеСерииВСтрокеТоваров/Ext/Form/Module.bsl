	НовыйЭлемент.ПутьКДанным = "ОстаткиСерий.бит_ТипТары";
	
	//(бит) Штрихкод
	НовыйЭлемент = Элементы.Вставить("ОстаткиСерийбит_Штрихкод", Тип("ПолеФормы"), Элементы.ОстаткиСерий, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОстаткиСерий.бит_Штрихкод";
		
	НоваяГруппа  = Элементы.Вставить("бит_ГруппаДополнительныеРеквизиты",Тип("ГруппаФормы"), Элементы.СтраницаВводСерии, Элементы.ГруппаДополнительныеРеквизиты);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Истина; 
	НоваяГруппа.Заголовок = "(бит) Дополнтельно";  
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;  
	
	//(бит)  № завеса
	НовыйЭлемент = Элементы.Вставить("бит_НомерЗавеса", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_НомерЗавеса";
	
	//(бит) № заказа
	НовыйЭлемент = Элементы.Вставить("бит_НомерЗаказа", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_НомерЗаказа";
	
	//(бит) Брутто, кг
	НовыйЭлемент = Элементы.Вставить("бит_Брутто", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_Брутто";
	
	//(бит) Тип тары
	НовыйЭлемент = Элементы.Вставить("бит_ТипТары", Тип("ПолеФормы"), Элементы.бит_ГруппаДополнительныеРеквизиты, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_ТипТары";
	
