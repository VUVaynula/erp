	НовыйЭлемент = Элементы.Вставить("ОстаткиСерийбит_НомерЗаказа", Тип("ПолеФормы"), Элементы.ОстаткиСерий, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ОстаткиСерий.бит_НомерЗаказа";
		
	//(бит) Брутто, кг
	НовыйЭлемент = Элементы.Вставить("ОстаткиСерийбит_Брутто", Тип("ПолеФормы"), Элементы.ОстаткиСерий, Неопределено);
