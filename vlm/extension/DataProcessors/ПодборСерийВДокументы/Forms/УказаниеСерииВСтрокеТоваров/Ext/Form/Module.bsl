	// Первыйбит ЛТ8.10.9 ЛапшовГ "GVLapshov@1cbit.ru" 28.04.2025 +
	
	КвалификаторЧисла10_0 = Новый КвалификаторыЧисла(10,0);
	ОписаниеЧисло10_0 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла10_0);
	КвалификаторЧисла9_3 = Новый КвалификаторыЧисла(9,3);
	ОписаниеЧисло9_3 = Новый ОписаниеТипов("Число", , , КвалификаторЧисла9_3);
	КвалификаторыСтроки200 = Новый КвалификаторыСтроки(200);
	ОписаниеСтроки = Новый ОписаниеТипов("Строка", , , КвалификаторыСтроки200);
	Описаниебит_ДополнительныеПризнакиНоменклатуры = Новый ОписаниеТипов("СправочникСсылка.бит_ДополнительныеПризнакиНоменклатуры");
		
	ДобавляемыеРеквизитыОстаткиСерий =  Новый Массив; 
	
	бит_НомерЗавесаОстатки = Новый РеквизитФормы("бит_НомерЗавеса", ОписаниеЧисло10_0, "ОстаткиСерий", "(бит) № завеса");
	бит_НомерЗаказаОстатки = Новый РеквизитФормы("бит_НомерЗаказа", ОписаниеЧисло10_0, "ОстаткиСерий", "(бит) № заказа");
	бит_БруттоОстатки = Новый РеквизитФормы("бит_Брутто", ОписаниеЧисло9_3, "ОстаткиСерий", "(бит) Брутто, кг");
	бит_ТипТарыОстатки = Новый РеквизитФормы("бит_ТипТары", Описаниебит_ДополнительныеПризнакиНоменклатуры, "ОстаткиСерий", "(бит) Тип тары");
	бит_ШтрихкодОстатки = Новый РеквизитФормы("бит_Штрихкод", ОписаниеСтроки, "ОстаткиСерий", "(бит) Штрихкод");
	
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_НомерЗавесаОстатки);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_НомерЗаказаОстатки);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_БруттоОстатки);
    ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_ТипТарыОстатки);
	ДобавляемыеРеквизитыОстаткиСерий.Добавить(бит_ШтрихкодОстатки);
	
