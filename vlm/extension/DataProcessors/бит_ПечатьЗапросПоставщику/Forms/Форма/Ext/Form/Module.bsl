&НаСервере
Функция ПечатьНаСервере()
		
	ЭтаОбработка = РеквизитФормыВЗначение("Объект");
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.Документ);

	ОбъектыПечати = Новый СписокЗначений;
	КодЯзыка = Неопределено;
	Возврат ЭтаОбработка.СформироватьПечатнуюФормуЗапросПоставщику(МассивОбъектов, ОбъектыПечати);
		
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	ТабличныйДокумент = ПечатьНаСервере();
	ТабличныйДокумент.Показать("(бит) Запрос поставщику");
КонецПроцедуры
