&НаКлиенте
Процедура ОтправитьНаСвободныйСклад(Команда)
	ОтправитьНаСвободныйСкладНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСвободныйСкладНаСервере()
	
	ТаблицаБэкапа = ПартияЗавесов.Выгрузить();
	Если ТаблицаБэкапа.Найти(Истина, "ПеремещатьНаСвободныйСклад") = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("нет строк к перемещению на свободный склад");
		Возврат;
	КонецЕсли;
	тзбэк = ТаблицаИсходныхДанных.Выгрузить();
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	тз.Номенклатура КАК Номенклатура,
	                      |	тз.Тара КАК Тара,
	                      |	тз.Серия КАК Серия,
	                      |	тз.Назначение КАК Назначение,
	                      |	тз.Количество КАК Количество,
	                      |	тз.ПеремещатьНаСвободныйСклад КАК ПеремещатьНаСвободныйСклад,
						  |	тз.ТараЗаказаКлиента КАК ТараЗаказаКлиента
	                      |ПОМЕСТИТЬ тз
	                      |ИЗ
	                      |	&тз КАК тз
						  |ГДЕ
	                      |	тз.ТараЗаказаКлиента = тз.Тара
						  |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	тзбэк.Номенклатура КАК Номенклатура,
	                      |	тзбэк.Тара КАК Тара,
	                      |	тзбэк.Серия КАК Серия,
	                      |	тзбэк.Назначение КАК Назначение,
	                      |	тзбэк.Количество КАК Количество,
	                      |	тзбэк.ПартияЗавеса КАК ПартияЗавеса,
						  |	тзбэк.ТараЗаказаКлиента КАК ТараЗаказаКлиента
	                      |ПОМЕСТИТЬ тзбэк
	                      |ИЗ
	                      |	&тзбэк КАК тзбэк
						  |ГДЕ
	                      |	тзбэк.ТараЗаказаКлиента = тзбэк.Тара
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	тз.Номенклатура КАК Номенклатура,
	                      |	тз.Тара КАК Тара,
	                      |	тз.Серия КАК Серия,
	                      |	тз.Назначение КАК Назначение,
	                      |	тз.Количество КАК Количество,
	                      |	тзбэк.ПартияЗавеса КАК ПартияЗавеса
	                      |ИЗ
	                      |	тз КАК тз
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ тзбэк КАК тзбэк
	                      |		ПО тз.Номенклатура = тзбэк.Номенклатура
	                      |			И тз.Тара = тзбэк.Тара
	                      |			И тз.Серия = тзбэк.Серия
	                      |			И тз.Назначение = тзбэк.Назначение
	                      |			И тз.Количество = тзбэк.Количество
	                      |ГДЕ
	                      |	тз.ПеремещатьНаСвободныйСклад
	                      |ИТОГИ ПО
	                      |	Назначение");
	Запрос.УстановитьПараметр("тз", ТаблицаБэкапа);
	Запрос.УстановитьПараметр("тзбэк", тзбэк);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДатаДок = ТекущаяДатаСеанса(); 
	Пока Выборка.Следующий() Цикл
		Док = Документы.КорректировкаНазначенияТоваров.СоздатьДокумент();
		Док.Дата = ДатаДок;
		Док.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		Док.ВидОперации = Перечисления.ВидыОперацийКорректировкиНазначения.ПроизвольнаяКорректировкаНазначений;  
		Док.Назначение = Выборка.Назначение;
		Док.Автор = Пользователи.ТекущийПользователь();
		Док.Ответственный = Док.Автор;
		Док.Комментарий = "#Арм кладовщика";
		
		Детали = Выборка.Выбрать();  
		//ДатаДок = ТекущаяДатаСеанса();
		
		соотвПартийЗавесов = Новый Соответствие;
		мСтрокПоКлючу = Новый Массив;
		
		Пока Детали.Следующий() Цикл
			нов = Док.Товары.Добавить();
			нов.Номенклатура = Детали.Номенклатура;
			нов.Упаковка = Детали.Номенклатура.ЕдиницаИзмерения;
			нов.Серия = Детали.Серия; 
			нов.СтатусУказанияСерий = 14;
			нов.Количество = Детали.Количество;
			нов.КоличествоУпаковок = Детали.Количество;
			нов.Склад = СкладПоУмолчанию;	    
			нов.Помещение = ПомещениеПоУмолчанию;
			нов.ИсходноеНазначение = Детали.Назначение;
			нов.Ячейка = ОпределитьЯчейку(нов.Номенклатура, нов.Серия, Выборка.Назначение);
			// отметим в завесе что уже не надо назначение
			СтруктураОтбора = Новый Структура("Номенклатура, Тара, Серия, Назначение, Количество", Детали.Номенклатура, Детали.Тара, Детали.Серия, Детали.Назначение, Детали.Количество);
			СтрокаПоКлючу = ТаблицаИсходныхДанных.НайтиСтроки(СтруктураОтбора);
			
			ДокЗавеса = соотвПартийЗавесов.Получить(СтрокаПоКлючу[0].ПартияЗавеса);
			Если ДокЗавеса = Неопределено Тогда
				ДокЗавеса = СтрокаПоКлючу[0].ПартияЗавеса.ПолучитьОбъект();
			КонецЕсли;
			//теперь найдем строку в документе партия завеса
			СтрокаПоКлючу = ДокЗавеса.ДанныеСмены.НайтиСтроки(СтруктураОтбора);
			// и очистим назначение
			Если СтрокаПоКлючу.Количество() > 0 Тогда
				СтрокаПоКлючу[0].Назначение = Справочники.Назначения.ПустаяСсылка();
			КонецЕсли;
			//снимем галку в партиях завесов
			СтрокаПоКлючу = ПартияЗавесов.НайтиСтроки(СтруктураОтбора);
			мСтрокПоКлючу.Добавить(СтрокаПоКлючу[0]);
		КонецЦикла;
		
		Попытка
			// запишем сам док размещения
			Док.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ размещения успешно проведен!", Док.Ссылка);
			// запишем в партиях завесов пустое назначение
			Для каждого стр из соотвПартийЗавесов Цикл 	
				стр.Значение.Записать();	
			КонецЦикла;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Партии завесов обнулены!");
			// снимем галки в таблице
			Для каждого стр из мСтрокПоКлючу Цикл
				стр.ПеремещатьНаСвободныйСклад = Ложь;
				стр.Назначение = Справочники.Назначения.ПустаяСсылка();
			КонецЦикла;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Все процедуры выполнены успешно!");
			
		Исключение                              
			Док.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось отправить позиции на свободный склад по причине " 
															+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
															, Док.Ссылка);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ОпределитьЯчейку(Номенклатура, Серия, Назначение)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	                      |	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыВЯчейках.Остатки(
	                      |			&Период,
	                      |			Номенклатура = &Номенклатура
	                      |				И Серия = &Серия
	                      |				И Назначение = &Назначение) КАК ТоварыВЯчейкахОстатки");
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("Назначение", Назначение);   
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ячейка = Выборка.Ячейка;
	иначе
		Ячейка = Справочники.СкладскиеЯчейки.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Ячейка;

