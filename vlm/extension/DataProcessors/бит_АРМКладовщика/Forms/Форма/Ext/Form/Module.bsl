&НаСервере
Процедура ВидимостьИДоступность()
	
	ДоступностьКнопокКоманднойРаботы = ТаблицаИсходныхДанных.Количество() > 0; 
	
	Элементы.ФормаРазместитьВЗонуПриемки.Доступность = ДоступностьКнопокКоманднойРаботы;
	Элементы.ФормаОтправитьНаСвободныйСклад.Доступность = ДоступностьКнопокКоманднойРаботы;
	Элементы.ФормаСоздатьЗаданиеНаОтбор.Доступность = ДоступностьКнопокКоманднойРаботы;
	Элементы.ФормаСнятьОтборы.Доступность = ДоступностьКнопокКоманднойРаботы;	
	
	КопияТаблицы = ТаблицаИсходныхДанных.Выгрузить(, "ПартияЗавеса");
	КопияТаблицы.Свернуть("ПартияЗавеса");
	
	Заголовок = "(бит) АРМ кладовщика";
	Если КопияТаблицы.Количество() Тогда
		Заголовок = Заголовок + СтрШаблон(". Загружено завесов: %1, позиций: %2", КопияТаблицы.Количество(), ПартияЗавесов.Количество());
	КонецЕсли;
	ЭтаФорма.Заголовок = Заголовок;
	
КонецПроцедуры

&НаКлиенте
Процедура СкладПоУмолчаниюПриИзменении(Элемент)
	ПроверитьСкладскоеПомещение();
КонецПроцедуры

&НаСервере
Процедура ПроверитьСкладскоеПомещение()
	
	Если ЗначениеЗаполнено(СкладПоУмолчанию) Тогда
		Если ЗначениеЗаполнено(ПомещениеПоУмолчанию) Тогда
			Если ПомещениеПоУмолчанию.Владелец <> СкладПоУмолчанию Тогда
				ПомещениеПоУмолчанию = Справочники.СкладскиеПомещения.ПустаяСсылка();
				НайтиСкладскоеПомещение();
			КонецЕсли;
		Иначе                             
			НайтиСкладскоеПомещение();
		КонецЕсли;
	Иначе       
		ПомещениеПоУмолчанию = Справочники.СкладскиеПомещения.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры                   

&НаСервере
Процедура НайтиСкладскоеПомещение()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СкладскиеПомещения.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.СкладскиеПомещения КАК СкладскиеПомещения
	                      |ГДЕ
	                      |	СкладскиеПомещения.Владелец = &Владелец
	                      |	И НЕ СкладскиеПомещения.ПометкаУдаления");
	Запрос.УстановитьПараметр("Владелец", СкладПоУмолчанию);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 1 Тогда 
		ПомещениеПоУмолчанию = Результат[0].Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПартияЗавесовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПартияЗавесовПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПомещениеПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЯчеййкаЗоныПриемкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;                       
	Если ЗначениеЗаполнено(СкладПоУмолчанию) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЯчейкиЗоныПриемки", ЭтотОбъект);
		ПФ = Новый Структура;
		ПФ.Вставить("РежимВыбора", Истина);            
		ПФ.Вставить("МножественныйВыбор", Ложь);
		ПФ.Вставить("ЗакрыватьПриВыборе", Истина);
		ПФ.Вставить("Отбор", Новый Структура("Владелец", СкладПоУмолчанию));
		ОткрытьФорму("Справочник.СкладскиеЯчейки.Форма.ФормаВыбора", ПФ, ЭтаФорма, УникальныйИдентификатор, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выбрать склад по умолчанию");
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВыбораЯчейкиЗоныПриемки(ВыбранноеЗначение, ДопПараметры) Экспорт

	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ЯчейкаЗоныПриемки = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЯчеййкаЗоныПриемкиПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ЯчейкаЗоныПриемки) 
		И ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ЯчейкаЗоныПриемки, "Владелец") <> СкладПоУмолчанию Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранная ячейка " + ЯчейкаЗоныПриемки + " не относится к складу " + СкладПоУмолчанию + ". Значение очищено");
    	ЯчейкаЗоныПриемки = ПредопределенноеЗначение("Справочник.СкладскиеЯчейки.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
