&НаКлиенте
Процедура ИнициализироватьФорму(ВыбЗначения)
	
	ОбнулитьФорму();
	ЗагрузитьДанныеНаСервере(ВыбЗначения);                               
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьФорму()
	
	ТаблицаИсходныхДанных.Очистить();	
	ПартияЗавесов.Очистить();
	ТекущаяНоменклатураВНазначении.Очистить();
	ИнформацияОЗаказе.Очистить();
	
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(ВыбЗначения)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	бит_ПартияЗавесовДанныеСмены.Номенклатура КАК Номенклатура,
	                      |	бит_ПартияЗавесовДанныеСмены.Тара КАК Тара,
	                      |	бит_ПартияЗавесовДанныеСмены.Серия КАК Серия,
	                      |	бит_ПартияЗавесовДанныеСмены.Назначение КАК Назначение,
	                      |	бит_ПартияЗавесовДанныеСмены.Весовщик КАК Весовщик,
	                      |	бит_ПартияЗавесовДанныеСмены.Контроллер КАК Контроллер,
	                      |	бит_ПартияЗавесовДанныеСмены.Количество КАК Количество,
	                      |	бит_ПартияЗавесовДанныеСмены.Ссылка КАК ПартияЗавеса
	                      |ИЗ
	                      |	Документ.бит_ПартияЗавесов.ДанныеСмены КАК бит_ПартияЗавесовДанныеСмены
	                      |ГДЕ
	                      |	бит_ПартияЗавесовДанныеСмены.Ссылка В(&мПартииЗавесов)");
	Запрос.УстановитьПараметр("мПартииЗавесов", ВыбЗначения); 
	Таблица = Запрос.Выполнить().Выгрузить();
	// блок 0 сохраним результат выборки  
	Таблица.Колонки.Добавить("ТараЗаказаКлиента", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	
	Для каждого стр из Таблица Цикл
		стр.ЗаказКлиента = НайтиЗаказКлиентаПоНазначению(стр.Назначение, стр.Номенклатура); 
		Если ЗначениеЗаполнено(стр.ЗаказКлиента) Тогда
			СтрокаТовары = стр.ЗаказКлиента.Товары.Найти(стр.Номенклатура, "Номенклатура");
			Если СтрокаТовары <> Неопределено И ЗначениеЗаполнено(СтрокаТовары.бит_Тара) Тогда
				стр.ТараЗаказаКлиента = СтрокаТовары.бит_Тара;
			Иначе                       
				стр.ТараЗаказаКлиента = стр.Номенклатура.бит_СтандартныйТипТары;
			КонецЕсли; 
		Иначе
			стр.ТараЗаказаКлиента = стр.Тара;
		КонецЕсли;			
	КонецЦикла;
		
	ТаблицаИсходныхДанных.Загрузить(Таблица);
	// блок 1 это кнопки
	// блок 2 Таблица 5  
	ЗаполнитьПартиюЗавесовБезФильтров(Таблица);
	// блок 3 таблица 6
	ДанныеДляЗагрузки = Таблица.Скопировать();                  
	ДанныеДляЗагрузки.Свернуть("Номенклатура, Назначение");
	ТекущаяНоменклатураВНазначении.Загрузить(ДанныеДляЗагрузки);  
	
	ВидимостьИДоступность();   
	
КонецПроцедуры

#КонецОбласти

