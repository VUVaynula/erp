&НаСервереБезКонтекста
Функция ОпределитьПлановоеКоличествоДляЗаказа(ЗаказКлиента, Номенклатура, бит_Толеранс) 
	// Расчет: Количество по заказу (данное значение берется из документа "Заказ клиента" - ТЧ Товары - поле "Количество" * (1 + Толеранс/100)
    Результат = 0;
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		ТЧТовары = ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		Для каждого стр из ТЧТовары Цикл
			Результат = Результат + стр.Количество;	
		КонецЦикла;
		Результат = Результат * (1 + ЗаказКлиента.бит_Толеранс / 100);
	КонецЕсли;                                                        
	
	Возврат Результат;
	
КонецФункции  

&НаСервереБезКонтекста
Функция РазмещеноНаСкладеПодНазначение(Номенклатура, Назначение)

	Запрос = новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Остаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	                      |			,
	                      |			Номенклатура = &Номенклатура
	                      |				И Назначение = &Назначение) КАК ТоварыНаСкладахОстатки");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Остаток = Результат.Остаток;
	Иначе
		Остаток = 0;
	КонецЕсли;
	
	Возврат Остаток;
	
