&НаСервере
Функция СоздатьЗаданиеНаОтборНаСервере()

	Док = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Размещение; 
	//Док.ЗонаОтгрузки = 
	Док.ЗонаПриемки = ЯчейкаЗоныПриемки;
	Док.Исполнитель = Пользователи.АвторизованныйПользователь();
	Док.Комментарий = "Создан из АРМ Кладовщика по завесам";
    Док.Ответственный = Док.Исполнитель;
	//Док.РабочийУчасток = 
	//Док.Распоряжение = 
	Док.Склад = СкладПоУмолчанию;	
	Док.Помещение = ПомещениеПоУмолчанию;
	Док.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
	Для каждого стр из ПартияЗавесов Цикл 
		Если стр.Тара <> стр.ТараЗаказаКлиента Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке с %1 по номенклатуре %2 тара в серии не равна таре в заказе", стр.ЗаказКлиента, стр.Номенклатура));
			Продолжить;
		КонецЕсли;
		нов = Док.ТоварыРазмещение.Добавить();
		нов.Количество = стр.Количество;
		нов.КоличествоУпаковок = стр.Количество;
		нов.Номенклатура = стр.Номенклатура;
		нов.Упаковка = стр.Номенклатура.ЕдиницаИзмерения;
		нов.Назначение = стр.Назначение;
		//нов.Ячейка = 
		нов.Серия = стр.Серия;
		нов.ВесУпаковки = 1;
		нов.СтатусУказанияСерий = 14;
	КонецЦикла;
	//Док.ОбъемРазмещение = 	
	Док.ВесРазмещение = Док.ТоварыРазмещение.Итог("Количество");  
	Если Док.ТоварыРазмещение.Количество() Тогда
		Док.Записать(); 
		Результат = Док.Ссылка;
	Иначе           
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат; 

КонецФункции

