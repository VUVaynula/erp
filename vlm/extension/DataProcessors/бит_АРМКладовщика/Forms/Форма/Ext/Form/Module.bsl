&НаКлиенте
Процедура СоздатьЗаданиеНаОтбор(Команда)    
	
	Если ПартияЗавесов.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет строк для обработки");
		Возврат;
	КонецЕсли;
	
	Док = СоздатьЗаданиеНаОтборНаСервере(); 
	Если Док <> Неопределено Тогда
		ОткрытьЗначение(Док);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ не создан");
	КонецЕсли;
	
