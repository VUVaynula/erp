&НаКлиенте
Процедура ПартияЗавесовПеремещатьНаСвободныйСкладПриИзменении(Элемент)
	
	ТД = элементы.ПартияЗавесов.ТекущиеДанные;
	Если ТД.ПеремещатьНаСвободныйСклад И Не ЗначениеЗаполнено(ТД.Назначение) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке не заполнено назначение");
		ТД.ПеремещатьНаСвободныйСклад = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореТекущейПары()
	
	ТД = Элементы.ТекущаяНоменклатураВНазначении.ТекущиеДанные;
	Если ТД.Выбрано = Истина Тогда
		Для каждого стр из ТекущаяНоменклатураВНазначении Цикл
			Если стр.Выбрано Тогда
				стр.Выбрано = Ложь;
			КонецЕсли;
		КонецЦикла;
		ТД.Выбрано = Истина;
		ПрименитьФильтрыПартияЗавесов(ТД.Номенклатура, ТД.Назначение);
		ЗаполнитьИнформациюОЗаказе(ТД.Номенклатура, ТД.Назначение);
	Иначе
		СнятьОтборыСоВсехСтрок();
	КонецЕсли;
	
КонецПроцедуры
// -------------------------------------------------------------------------------------

&НаКлиенте
Процедура ПрименитьФильтрыПартияЗавесов(Номенклатура, Назначение)                 
	
	ПартияЗавесов.Очистить();
	СтрокиПоКлючу = ТаблицаИсходныхДанных.НайтиСтроки(Новый Структура("Номенклатура, Назначение", Номенклатура, Назначение));
	Для каждого стр из СтрокиПоКлючу Цикл
		нов = ПартияЗавесов.Добавить();
		ЗаполнитьЗначенияСвойств(нов, стр);
	КонецЦикла;
	Элементы.ПартияЗавесов.Заголовок = СтрШаблон("Фильтр: показаны позиции по заказу №%1", Назначение);
	Элементы.ПартияЗавесов.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИнформациюОЗаказе(Номенклатура, Назначение)
	
	ИнформацияОЗаказе.Очистить();
	ТаблицаДляЗаполнения = ТаблицаИсходныхДанных.Выгрузить();
	ТаблицаДляЗаполнения.Свернуть("Номенклатура, Назначение", "Количество");
	
	СтрокиПоКлючу = ТаблицаДляЗаполнения.НайтиСтроки(Новый Структура("Номенклатура, Назначение", Номенклатура, Назначение));
	Для каждого стр из СтрокиПоКлючу Цикл
		нов = ИнформацияОЗаказе.Добавить(); 
		ЗаполнитьЗначенияСвойств(нов, стр, "Назначение, Номенклатура");
		нов.ЗаказКлиента = НайтиЗаказКлиентаПоНазначению(стр.Назначение, стр.Номенклатура);                                  
		нов.ВПриемке = нов.ВПриемке + стр.Количество; // по идее итерация всегда будет одна и можно брать кол-во из строки, но пока оставим так.
		нов.РазмещеноНаСкладеПодНазначение = РазмещеноНаСкладеПодНазначение(Номенклатура, Назначение);
		Если ЗначениеЗаполнено(нов.ЗаказКлиента) и Типзнч(нов.ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			нов.Толеранс = нов.ЗаказКлиента.бит_Толеранс;
			нов.ПлановоеКоличествоДляЗаказа = ОпределитьПлановоеКоличествоДляЗаказа(нов.ЗаказКлиента, нов.Номенклатура, нов.Толеранс);	
		КонецЕсли;  
		//Расчет: Размещено на складе + В приемке
		нов.Итого = нов.РазмещеноНаСкладеПодНазначение + нов.ВПриемке; 
		//Расчет: Плановое количество для заказа - Итого
		нов.Отклонение = нов.ПлановоеКоличествоДляЗаказа - нов.Итого;  	 
	КонецЦикла;
	
КонецПроцедуры                                                                          

&НаСервереБезКонтекста
Функция НайтиЗаказКлиентаПоНазначению(Знач Назначение, Знач Номенклатура);                                  
	Возврат Назначение.Заказ;
КонецФункции
