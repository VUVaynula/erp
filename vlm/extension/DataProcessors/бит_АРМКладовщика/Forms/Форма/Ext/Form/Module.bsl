&НаСервереБезКонтекста
Функция НайтиЭтапПоСерии(Знач Номенклатура, Знач Серия)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка КАК Этап
	                      |ИЗ
	                      |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	                      |ГДЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура
	                      |	И ЭтапПроизводства2_2ВыходныеИзделия.Серия = &Серия
	                      |	И НЕ ЭтапПроизводства2_2ВыходныеИзделия.Ссылка.ПометкаУдаления");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Серия", Серия);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 1 Тогда
		Отправитель = Результат[0].Этап;
	Иначе             
		Отправитель = Неопределено;
	КонецЕсли;
	
	Возврат Отправитель;
	
