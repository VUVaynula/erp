	Если СтрокаПункта = Неопределено Тогда
		ДоставкаТоваровКлиентСервер.ОтобразитьНедогрузПерегруз(ЭтотОбъект, Неопределено);
		#Вставка
		// {{ПервыйБИТ ЛистТребовани [ЛТ 2.4] [AVZhelansky@1cbit.ru] [17.06.2025 14:45:11] +
		ДанныеКоличествоМест = Новый Структура;
		ДанныеКоличествоМест.Вставить("бит_КоличествоМест", 0);
		ДанныеКоличествоМест.Вставить("бит_КоличествоМестПлан", 0);
		бит_КонтрольКоличестваМестКлиентСервер.бит_ОтобразитьНехваткуМеста(ЭтаФорма, ДанныеКоличествоМест);	
		// }}ПервыйБИТ ЛистТребовани [ЛТ 2.4] [AVZhelansky@1cbit.ru] [17.06.2025 14:45:13] -
		#КонецВставки
	Иначе
		ДоставкаТоваровКлиентСервер.ОтобразитьНедогрузПерегруз(ЭтотОбъект, СтрокаЗаданиеПоСтрокеПункта(СтрокаПункта));
		#Вставка
		// {{ПервыйБИТ ЛистТребовани [ЛТ 2.4] [AVZhelansky@1cbit.ru] [17.06.2025 14:45:11] + 
		ДанныеКоличествоМест = Новый Структура;
		ДанныеКоличествоМест.Вставить("бит_КоличествоМест", СтрокаЗаданиеПоСтрокеПункта(СтрокаПункта).бит_КоличествоМест);
		ДанныеКоличествоМест.Вставить("бит_КоличествоМестПлан", бит_ПолучитьКоличествоМестПлан(СтрокаЗаданиеПоСтрокеПункта(СтрокаПункта).Транспорт));
		бит_КонтрольКоличестваМестКлиентСервер.бит_ОтобразитьНехваткуМеста(ЭтаФорма, ДанныеКоличествоМест);	
		// }}ПервыйБИТ ЛистТребовани [ЛТ 2.4] [AVZhelansky@1cbit.ru] [17.06.2025 14:45:13] -
		#КонецВставки
	КонецЕсли;

	Если СтрокаПункта = Неопределено
		Или СтрокаПункта.КоличествоРаспоряжений = 0 Тогда
		Элементы.СтраницыРаспоряжения.ТекущаяСтраница = Элементы.СтраницаРаспоряженийНет;
	Иначе
		Элементы.СтраницыРаспоряжения.ТекущаяСтраница = Элементы.СтраницаРаспоряженияЕсть;
		Текст = НСтр("ru = 'Распоряжения (%количество%)';
		|en = 'References (%количество%)'");
		НадписьРаспоряжения = СтрЗаменить(Текст, "%количество%", СтрокаПункта.КоличествоРаспоряжений);
