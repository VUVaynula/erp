
&НаКлиенте
Асинх Процедура Гоу(Команда)
	ответ = Ждать ВопросАсинх("Вы точно знаете что делаете?", РежимДиалогаВопрос.ДаНет); 
	Если ответ = КодВозвратаДиалога.Да Тогда    
		ЗапуститьОбработкуНаСервере();
	КонецЕсли; 
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Готово");
КонецПроцедуры

&НаСервере
Процедура ЗапуститьОбработкуНаСервере()
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(РС) Тогда
		ТекстЗамены = " И РесурсныеСпецификации.Ссылка = &Ссылка ";
		Запрос.УстановитьПараметр("Ссылка", РС);
	Иначе
		ТекстЗамены = "";
	КонецЕсли;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ
	                      |	РесурсныеСпецификации.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ РС
	                      |ИЗ
	                      |	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
	                      |ГДЕ
	                      |	НЕ РесурсныеСпецификации.ПометкаУдаления
	                      |	%1
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЭтапыПроизводства.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ Этапы
	                      |ИЗ
	                      |	Справочник.ЭтапыПроизводства КАК ЭтапыПроизводства
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РС КАК РС
	                      |		ПО ЭтапыПроизводства.Владелец = РС.Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТехнологическиеОперации.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Этапы КАК Этапы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	                      |		ПО Этапы.Ссылка = ТехнологическиеОперации.Владелец", ТекстЗамены);
	
	Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ВыборкаТО = Результат[2].Выбрать();
	Пока ВыборкаТО.Следующий() Цикл
		ТО = ВыборкаТО.Ссылка.ПолучитьОбъект();	
		ТО.РабочийЦентр = Неопределено;
		ТО.ОбменДанными.Загрузка = Истина;
		ТО.Записать();
	КонецЦикла;
	
	ВидыПоРодителям = ПолучитьВидыРабочихЦентровПоРодителям();
	
	ВыборкаЭ = Результат[1].Выбрать();
	Пока ВыборкаЭ.Следующий() Цикл
		ЭО = ВыборкаЭ.Ссылка.ПолучитьОбъект();
		ЗаполнитьТЧ(ЭО, ВидыПоРодителям);
		ЭО.ОбменДанными.Загрузка = Истина;
		ЭО.Записать();
	КонецЦикла;
	
КонецПроцедуры          

&НаСервере
Функция ПолучитьВидыРабочихЦентровПоРодителям()
	
	ВидыПоРодителям = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыРабочихЦентров.Ссылка КАК ВидРабочегоЦентра,
	|	ВидыРабочихЦентров.Родитель КАК Родитель
	|ИЗ
	|	Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
	|ГДЕ
	|	НЕ ВидыРабочихЦентров.ЭтоГруппа
	|	И НЕ ВидыРабочихЦентров.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МассивВидов = ВидыПоРодителям.Получить(Выборка.Родитель);
		
		Если МассивВидов = Неопределено Тогда
			МассивВидов = Новый Массив;
			ВидыПоРодителям.Вставить(Выборка.Родитель, МассивВидов);
		КонецЕсли;
		
		МассивВидов.Добавить(Выборка.ВидРабочегоЦентра);
		
	КонецЦикла;
	
	Возврат ВидыПоРодителям;
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьТЧ(ВРЦОбъект, ВидыПоРодителям) 
	
	ВРЦОбъект.АльтернативныеВидыРабочихЦентров.Очистить();

	Для Каждого СтрокаВида Из ВРЦОбъект.ВидыРабочихЦентров Цикл
		
		ОсновнойВид = СтрокаВида.ВидРабочегоЦентра;
		
		Если НЕ ЗначениеЗаполнено(ОсновнойВид) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивВидов = ВидыПоРодителям.Получить(ОсновнойВид.Родитель);
		
		Если МассивВидов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ВидРабочегоЦентра Из МассивВидов Цикл
			
			Если ВидРабочегоЦентра = ОсновнойВид Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ВРЦОбъект.АльтернативныеВидыРабочихЦентров.Добавить();
			
			// Копируем остальные одинаковые колонки из основной строки
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВида, , "КлючСвязи, ВидРабочегоЦентра");
			
			// Подставляем альтернативный вид
			НоваяСтрока.ВидРабочегоЦентра = ВидРабочегоЦентра;
			НоваяСтрока.КлючСвязиВидыРабочихЦентров = СтрокаВида.КлючСвязи;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
