

&НаСервере
Процедура бит_ДоработатьЗапросСпискаДокументовПроизводства(ТекстЗапроса)

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	// Работаем с последним запросом пакета.
	ПоследнийЗапросПакета = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	ОператорЗапроса = ПоследнийЗапросПакета.Операторы[0];
	// Основной источник существующего запроса: РегистрСведений.РеестрДокументов КАК РеестрДокументовПереопределяемый
	ОсновнойИсточник = ОператорЗапроса.Источники[0];
	//////////////////////////////////////////////////////////////////////////////
	// Документ ПроизводствоБезЗаказа нужен для получения бит_Перемотка.
	ИсточникПроизводствоБезЗаказа = ОператорЗапроса.Источники.Добавить("Документ.ПроизводствоБезЗаказа", "бит_ПроизводствоБезЗаказа");
	ОсновнойИсточник.Соединения.Добавить(ИсточникПроизводствоБезЗаказа, "РеестрДокументовПереопределяемый.Ссылка = бит_ПроизводствоБезЗаказа.Ссылка");

	//////////////////////////////////////////////////////////////////////////////
	// Данные по завешиванию продукции.
	//
	// На выходе вложенного запроса одна строка на документ:
	// КоличествоСтрок
	// ЕстьНезавешенные
	// ЕстьНесоответствиеМассы

	ТекстЗапросаЗавешивания = "ВЫБРАТЬ
	|	Продукция.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок,
	|
	|	МАКСИМУМ(
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(
	|				Продукция.Серия.бит_Завешено,
	|				ЛОЖЬ) = ЛОЖЬ
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ
	|	) КАК ЕстьНезавешенные,
	|
	|	МАКСИМУМ(
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(
	|				Продукция.Серия.бит_Завешено,
	|				ЛОЖЬ) = ИСТИНА
	|				И ЕСТЬNULL(
	|					Продукция.Серия.бит_МассаНетто,
	|					0) <> Продукция.Количество
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ
	|	) КАК ЕстьНесоответствиеМассы
	|
	|ИЗ
	|	Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК Продукция
	|
	|СГРУППИРОВАТЬ ПО
	|	Продукция.Ссылка";

	ИсточникЗавешивания = ОператорЗапроса.Источники.Добавить(Тип("ВложенныйЗапросСхемыЗапроса"), "бит_Завешивание");

	ИсточникЗавешивания.Источник.Запрос.УстановитьТекстЗапроса(ТекстЗапросаЗавешивания);

	ОсновнойИсточник.Соединения.Добавить(ИсточникЗавешивания, "РеестрДокументовПереопределяемый.Ссылка = бит_Завешивание.Ссылка");

	//////////////////////////////////////////////////////////////////////////////
	// бит_Перемотка

	ОператорЗапроса.ВыбираемыеПоля.Добавить("ЕСТЬNULL(бит_ПроизводствоБезЗаказа.бит_Перемотка, ЛОЖЬ)");

	ПоследнийЗапросПакета.Колонки[ПоследнийЗапросПакета.Колонки.Количество() - 1].Псевдоним = "бит_Перемотка";

	//////////////////////////////////////////////////////////////////////////////
	// бит_СтатусЗавешивания
	//
	// 0 - не ПроизводствоБезЗаказа / нет продукции
	// 1 - зеленый
	// 2 - оранжевый
	// 3 - красный
	//
	// Приоритет:
	// 1. Есть незавешенная серия -> оранжевый.
	// 2. Все завешены, но масса не совпадает -> красный.
	// 3. Все завешены и масса совпадает -> зеленый.

	ВыражениеСтатуса = "ВЫБОР
	|	КОГДА бит_ПроизводствоБезЗаказа.Ссылка ЕСТЬ NULL
	|		ТОГДА 0
	|
	|	КОГДА ЕСТЬNULL(
	|		бит_Завешивание.КоличествоСтрок,
	|		0) = 0
	|		ТОГДА 0
	|
	|	КОГДА ЕСТЬNULL(
	|		бит_Завешивание.ЕстьНезавешенные,
	|		0) = 1
	|		ТОГДА 2
	|
	|	КОГДА ЕСТЬNULL(
	|		бит_Завешивание.ЕстьНесоответствиеМассы,
	|		0) = 1
	|		ТОГДА 3
	|
	|	ИНАЧЕ 1
	|КОНЕЦ";

	ОператорЗапроса.ВыбираемыеПоля.Добавить(ВыражениеСтатуса);

	ПоследнийЗапросПакета.Колонки[ПоследнийЗапросПакета.Колонки.Количество() - 1].Псевдоним = "бит_СтатусЗавешивания";

	//////////////////////////////////////////////////////////////////////////////

	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();

КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура бит_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	// НастройкиДинамическихСписков
	ИнициироватьНастройкиДинамическихСписков();
	// Конец НастройкиДинамическихСписков

	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);

	Если ПустаяСтрока(Параметры.КлючНазначенияФормы) Тогда
		КлючНазначенияИспользования = КлючНазначенияФормыПоУмолчанию();
	Иначе
		КлючНазначенияИспользования = Параметры.КлючНазначенияФормы;
	КонецЕсли;

	Если КлючНазначенияИспользования = КлючНазначенияФормыПоУмолчанию() Тогда
		КлючНастроек = "";
	Иначе
		КлючНастроек = КлючНазначенияИспользования;
	КонецЕсли;

	НавигационнаяСсылка = "e1cib/app/Обработка.ЖурналДокументовПроизводства";

	ВосстановитьНастройки(Параметры);

	ТЗХозОперацииИТипыДокументов = ОбщегоНазначенияУТ.ДоступныеХозяйственныеОперацииИДокументы(ОписаниеОперацийИТиповДокументов(),
	ОтборХозяйственныеОперации, ОтборТипыДокументов, КлючНастроек);
	ТЗХозОперацииИТипыДокументов.Сортировать("Порядок");

	ХозяйственныеОперацииИДокументы.Загрузить(ТЗХозОперацииИТипыДокументов);

	ИспользуетсяОграничениеПоОрганизации = УправлениеДоступом.ЕстьОграничениеТаблицыПоВидуДоступа(
	"РегистрСведений.РеестрДокументов", "Организации", "ГруппыПартнеров,Организации,Подразделения,Склады");

	ИспользуетсяОграничениеПоСкладу = УправлениеДоступом.ЕстьОграничениеТаблицыПоВидуДоступа(
	"РегистрСведений.РеестрДокументов", "Склады", "ГруппыПартнеров,Организации,Подразделения,Склады");

	ИспользуетсяОграничениеПоПодразделению = УправлениеДоступом.ЕстьОграничениеТаблицыПоВидуДоступа(
	"РегистрСведений.РеестрДокументов", "Подразделения", "ГруппыПартнеров,Организации,Подразделения,Склады");

	НастроитьФормуПоВыбраннымОперациямИДокументам(ТЗХозОперацииИТипыДокументов);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтаФорма, Элементы.ГруппаГлобальныеКоманды);
	// Конец ИнтеграцияС1СДокументооборотом

	// ПроверкаДокументовВРеглУчете
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	ЗаполнитьЗначенияСвойств(СвойстваСписка, СписокДокументыПроизводства);
	ПроверкаДокументовСервер.ДоработатьЗапросДинамическогоСпискаЖурналаДокументов(СвойстваСписка.ТекстЗапроса, "РеестрДокументовПереопределяемый");
	#Вставка     
	// {{ПервыйБИТ ЛистТребований [БИТ]  [VUVaynula@1cbit.ru] [11.08.2026 19:55:21] +        
	бит_ДоработатьЗапросСпискаДокументовПроизводства(СвойстваСписка.ТекстЗапроса);
	// }}ПервыйБИТ ЛистТребований [БИТ]  [VUVaynula@1cbit.ru] [11.08.2026 19:55:21] -
	#КонецВставки
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокДокументыПроизводства, СвойстваСписка);
	// Конец ПроверкаДокументовВРеглУчете

	ИспользуемыеТипыДокументов = ТЗХозОперацииИТипыДокументов.ВыгрузитьКолонку("ТипДокумента");
	ИспользуемыеТипыДокументов.Добавить(Тип("ДокументСсылка.Сторно"));

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый ОписаниеТипов(ИспользуемыеТипыДокументов);
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокДокументыПроизводстваКоманднаяПанель;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ДополнительныеПараметры = Новый Структура("МестоРазмещенияДанныхПроверкиРегл", Элементы.ГруппаРеглПроверка);
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка, ДополнительныеПараметры);
	#Вставка     
	// {{ПервыйБИТ ЛистТребований [БИТ]  [VUVaynula@1cbit.ru] [11.08.2026 19:58:01] +        
	бит_ДобавитьКолонкиСписка();
	бит_УстановитьУсловноеОформление();
	// }}ПервыйБИТ ЛистТребований [БИТ]  [VUVaynula@1cbit.ru] [11.08.2026 19:58:01] -
	#КонецВставки

