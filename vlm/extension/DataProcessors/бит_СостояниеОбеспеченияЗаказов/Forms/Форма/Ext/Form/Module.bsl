&НаСервере
Процедура ПроверкаНаНаличиеПодобногоДокумента(Документ)
	// {{ПервыйБИТ ЛистТребований [5.31]  [VUVaynula@1cbit.ru] [14.05.2025 14:02:49] +        
	тзДанныеДокумента = Документ.Продукция.Выгрузить(, "Номенклатура, Количество, Склад, Назначение, ДатаПотребности");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	                      |	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК Количество,
	                      |	ЗаказНаПроизводство2_2Продукция.Назначение КАК Назначение,
	                      |	ЗаказНаПроизводство2_2Продукция.Склад КАК Склад,
	                      |	&ДатаПотребности КАК ДатаПотребности
	                      |ПОМЕСТИТЬ втДанныеБазы
	                      |ИЗ
	                      |	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	                      |ГДЕ
	                      |	ЗаказНаПроизводство2_2Продукция.Ссылка.Проведен
	                      |	И ЗаказНаПроизводство2_2Продукция.Ссылка.ДатаПотребности = &ДатаПотребности
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗаказНаПроизводство2_2Продукция.Номенклатура,
	                      |	ЗаказНаПроизводство2_2Продукция.Назначение,
	                      |	ЗаказНаПроизводство2_2Продукция.Склад
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	тзДанныеДокумента.Номенклатура КАК Номенклатура,
	                      |	тзДанныеДокумента.Количество КАК Количество,
	                      |	тзДанныеДокумента.Назначение КАК Назначение,
	                      |	тзДанныеДокумента.Склад КАК Склад,
	                      |	тзДанныеДокумента.ДатаПотребности КАК ДатаПотребности
	                      |ПОМЕСТИТЬ тзДанныеДокумента
	                      |ИЗ
	                      |	&тзДанныеДокумента КАК тзДанныеДокумента
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	влДанныеДокумента.Номенклатура КАК Номенклатура,
	                      |	влДанныеДокумента.Назначение КАК Назначение,
	                      |	влДанныеДокумента.Склад КАК Склад,
	                      |	влДанныеДокумента.ДатаПотребности КАК ДатаПотребности,
	                      |	влДанныеДокумента.Количество - ЕСТЬNULL(втДанныеБазы.Количество, 0) КАК Количество,
						  |	ЕСТЬNULL(втДанныеБазы.Количество, 0) КАК КоличествоВЗаказах
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		тзДанныеДокумента.Номенклатура КАК Номенклатура,
	                      |		СУММА(тзДанныеДокумента.Количество) КАК Количество,
	                      |		тзДанныеДокумента.Назначение КАК Назначение,
	                      |		тзДанныеДокумента.Склад КАК Склад,
	                      |		тзДанныеДокумента.ДатаПотребности КАК ДатаПотребности
	                      |	ИЗ
	                      |		тзДанныеДокумента КАК тзДанныеДокумента
	                      |	
	                      |	СГРУППИРОВАТЬ ПО
	                      |		тзДанныеДокумента.Номенклатура,
	                      |		тзДанныеДокумента.Склад,
	                      |		тзДанныеДокумента.ДатаПотребности,
	                      |		тзДанныеДокумента.Назначение) КАК влДанныеДокумента
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеБазы КАК втДанныеБазы
	                      |		ПО влДанныеДокумента.Номенклатура = втДанныеБазы.Номенклатура
	                      |			И влДанныеДокумента.Назначение = втДанныеБазы.Назначение
	                      |			И влДанныеДокумента.Склад = втДанныеБазы.Склад
	                      |			И влДанныеДокумента.ДатаПотребности = втДанныеБазы.ДатаПотребности
	                      |ГДЕ
	                      |	влДанныеДокумента.Количество - ЕСТЬNULL(втДанныеБазы.Количество, 0) > 0");	
	Запрос.УстановитьПараметр("ДатаПотребности", Документ.ДатаПотребности); 
	Запрос.УстановитьПараметр("тзДанныеДокумента", тзДанныеДокумента); 
	
	Результат = Запрос.Выполнить().Выгрузить(); 
	Если Результат.Количество() = 0 Тогда
		Документ.Продукция.Очистить();
	Иначе         
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура");
		СтруктураОтбора.Вставить("Назначение");
		СтруктураОтбора.Вставить("Склад");
		СтруктураОтбора.Вставить("ДатаПотребности");
		
		сч = Документ.Продукция.Количество() - 1;
		Пока сч >= 0 Цикл
			ТекСтрока = Документ.Продукция[сч];
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, ТекСтрока);
			мНайденныеСтроки = Результат.НайтиСтроки(СтруктураОтбора);
			Если мНайденныеСтроки.Количество() = 0 Тогда   
				Документ.Продукция.Удалить(ТекСтрока);
			Иначе
				ТекСтрока.Количество = мНайденныеСтроки[0].Количество;
				ТекСтрока.КоличествоУпаковок = ТекСтрока.Количество;
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
