&НаСервере
Процедура ОбработатьКлючиНаСервере(мКлючейРегистра)
	// {{ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 20:23:19] +        
    ТД = Новый ТаблицаЗначений;
	ТД.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	ТД.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	//ТД.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТД.Колонки.Добавить("МаркаБренд"  , Новый ОписаниеТипов("СправочникСсылка.Марки"));
	ТД.Колонки.Добавить("РазмерГотовойПродукции");
	ТД.Колонки.Добавить("ВидИсполненияГотовойПродукции");
	ТД.Колонки.Добавить("ИзготовитьК", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТД.Колонки.Добавить("Обособлено", Новый ОписаниеТипов("Булево"));
	ТД.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения")); 
	ТД.Колонки.Добавить("Склад",	Новый ОписаниеТипов("СправочникСсылка.Склады")); 
	ТД.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", ,, Новый КвалификаторыЧисла(15, 2)));
	ТД.Колонки.Добавить("Спецификация", Новый ОписаниеТипов("СправочникСсылка.РесурсныеСпецификации")); 
	
	мЗаказовКИсправлению = новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МАКСИМУМ(ВЫБОР
	                      |			КОГДА бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &ПризнакВИД
	                      |				ТОГДА бит_ЗначенияПризнаковНоменклатуры.бит_Значение
	                      |		КОНЕЦ) КАК ЗначениеВИД,
	                      |	МАКСИМУМ(ВЫБОР
	                      |			КОГДА бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &ПризнакРазмер
	                      |				ТОГДА бит_ЗначенияПризнаковНоменклатуры.бит_Значение
	                      |		КОНЕЦ) КАК ЗначениеРазмер
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И (бит_ЗначенияПризнаковНоменклатуры.бит_Признак В (&ПризнакВИД, &ПризнакРазмер)
	                      |			ИЛИ бит_ЗначенияПризнаковНоменклатуры.бит_Признак В (&ПризнакВИД, &ПризнакРазмер))");
	Запрос.УстановитьПараметр("ПризнакВИД", Справочники.бит_ЗначенияПоУмолчанию.ПризнакВидИсполненияГотовойПродукции.Значение);
	Запрос.УстановитьПараметр("ПризнакРазмер", Справочники.бит_ЗначенияПоУмолчанию.ПризнакРазмерГотовойПродукции.Значение);
	Для каждого ключЗаписи из  мКлючейРегистра Цикл
		Запись = регистрыСведений.РаспределениеЗапасов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ключЗаписи);
		Запись.Прочитать();   
		Если ТипЗнч(Запись.ЗаказНаОтгрузку) <> Тип("ДокументСсылка.ЗаказКлиента") Или Не ЗначениеЗаполнено(Запись.ЗаказНаОтгрузку) Тогда
			Продолжить;
		КонецЕсли;
		нов = ТД.Добавить();                 
		
		нов.ЗаказКлиента = Запись.ЗаказНаОтгрузку; 
		нов.Склад = Запись.ЗаказНаОтгрузку.Склад;
		
		нов.Номенклатура = Запись.Номенклатура; 
		нов.МаркаБренд	= Запись.Номенклатура.Марка;
		
		Запрос.УстановитьПараметр("Номенклатура", Запись.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			нов.РазмерГотовойПродукции = Выборка.ЗначениеРазмер;
			нов.ВидИсполненияГотовойПродукции = Выборка.ЗначениеВид;  
		КонецЕсли;
		
			мСтрокЗаказа = Запись.ЗаказНаОтгрузку.Товары.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, ДатаОтгрузки", Запись.Номенклатура, Запись.Характеристика, Запись.ЖелаемаяДатаОтгрузки));
			Если мСтрокЗаказа.Количество() Тогда
				нов.ИзготовитьК = мСтрокЗаказа[0].бит_ИзготовитьК;
				нов.Обособлено = мСтрокЗаказа[0].Обособленно;
			КонецЕсли; 
		нов.Количество = Запись.Зарезервировано + Запись.Обеспечено + Запись.НеОбеспечено; 
		нов.Назначение = Запись.Назначение;
		
		Если нов.Обособлено = Ложь И мЗаказовКИсправлению.Найти(нов.ЗаказКлиента) = Неопределено Тогда
			мЗаказовКИсправлению.Добавить(нов.ЗаказКлиента);
			нов.Обособлено = Истина; // авансом
		КонецЕсли;
		
	КонецЦикла;
	//Отработаем требование про галку обособленно
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Обособлено", Ложь);  
	СтруктураОтбора.Вставить("ЗаказКлиента");
	
	СтруктураОтбораТоваров = Новый Структура;
	СтруктураОтбораТоваров.Вставить("Обособлено", Ложь);  
	СтруктураОтбораТоваров.Вставить("Номенклатура");
	
	Для каждого Заказ из мЗаказовКИсправлению Цикл
		СтруктураОтбора.ЗаказКлиента = Заказ;
		мСтроки = ТД.НайтиСтроки(СтруктураОтбора);
		мНоменклатур = Новый Массив;
		Для каждого стр из мСтроки Цикл      
			мНоменклатур.Добавить(стр.Номенклатура);
		КонецЦикла;
		
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		Для каждого стр из ЗаказОбъект.Товары Цикл
			Если стр.Обособленно = Ложь И мНоменклатур.Найти(стр.Номенклатура) <> Неопределено Тогда
				стр.Обособленно = Истина;
			КонецЕсли;
		КонецЦикла;
		ЗаказОбъект.Записать();
	КонецЦикла;
    // ----
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	РесурсныеСпецификации.Ссылка КАК Ссылка,
	                      |	МАКСИМУМ(РесурсныеСпецификации.НачалоДействия) КАК НачалоДействия,
	                      |	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура КАК ОсновноеИзделиеНоменклатура
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
	                      |ГДЕ
	                      |	РесурсныеСпецификации.Статус = Значение(Перечисление.СтатусыСпецификаций.Действует)
	                      |	И РесурсныеСпецификации.ОсновноеИзделиеНоменклатура В(&мНоменклатура)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	РесурсныеСпецификации.Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	РесурсныеСпецификации.Ссылка КАК Спецификация,
	                      |	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура КАК Номенклатура
	                      |ИЗ
	                      |	вт КАК вт
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
	                      |		ПО вт.Ссылка = РесурсныеСпецификации.Ссылка
	                      |			И вт.НачалоДействия = РесурсныеСпецификации.НачалоДействия
	                      |			И вт.ОсновноеИзделиеНоменклатура = РесурсныеСпецификации.ОсновноеИзделиеНоменклатура"); 
	Запрос.УстановитьПараметр("мНоменклатура", ТД.ВыгрузитьКолонку("Номенклатура"));
	Выборка = Запрос.Выполнить().Выбрать();
	соотвСпецификации = Новый Соответствие;
	Пока Выборка.Следующий() Цикл          
		соотвСпецификации.Вставить(Выборка.Номенклатура, Выборка.Спецификация);
	КонецЦикла;
	
	ТаблицаУникальных = ТД.Скопировать(, "МаркаБренд,РазмерГотовойПродукции,ВидИсполненияГотовойПродукции,ИзготовитьК");
	ТаблицаУникальных.Свернуть("МаркаБренд,РазмерГотовойПродукции,ВидИсполненияГотовойПродукции,ИзготовитьК");
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("МаркаБренд");
	СтруктураОтбора.Вставить("РазмерГотовойПродукции");
	СтруктураОтбора.Вставить("ВидИсполненияГотовойПродукции");
	СтруктураОтбора.Вставить("ИзготовитьК");
	
	Для каждого уникЗапись Из ТаблицаУникальных Цикл
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, уникЗапись);
		
		МассивСтрок = ТД.НайтиСтроки(СтруктураОтбора);
		
		Документ = СоздатьШапкуЗаказаНаПроизводство(уникЗапись.ИзготовитьК);
		ЗаполнитьТЧЗаказаНаПроизводство(Документ, МассивСтрок, соотвСпецификации);
		ПроверкаНаНаличиеПодобногоДокумента(Документ);
		Если Документ.Продукция.Количество() = 0 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По всем выделенным строкам уже созданы заказы на производство");
			Продолжить;
		КонецЕсли;
		
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан " + Документ, Документ.Ссылка); 
		Исключение            
			Документ.Записать();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ был записан. " + Документ + ". Проведение не удалось по причине " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Документ.Ссылка);
		КонецПопытки;
	КонецЦикла; 
	// }}ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 20:23:19] -
