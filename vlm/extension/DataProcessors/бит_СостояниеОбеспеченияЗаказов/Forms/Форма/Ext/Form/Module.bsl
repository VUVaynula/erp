&НаСервере
Процедура ЗаполнитьТЧЗаказаНаПроизводство(Документ, ДанныеЗаполнения, соотвСпецификации)
	// {{ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 21:02:27] +     
	мЗаказКлиента = Новый Массив;
	мНазначения = Новый Массив;
	Для каждого стр из ДанныеЗаполнения Цикл
		нов = Документ.Продукция.Добавить();
		нов.Номенклатура =	стр.Номенклатура;
		//нов.Характеристика	Не заполнять	
		//нов.Упаковка	Не заполнять	
		нов.Количество = стр.Количество; 
		нов.КоличествоУпаковок = стр.Количество;
		нов.Спецификация = соотвСпецификации.Получить(стр.Номенклатура);
		нов.Склад = стр.Склад;	
		//нов.Подразделение-получатель	Не заполнять	
		нов.Назначение = стр.Назначение; // Заполнять в соответствии с пунктом 6b	
		нов.ДатаПотребности = Документ.ДатаПотребности; //Значение реквизита "Изготовить к" из ТЧ документа "Заказ клиента", указанного в назначении.	
		//нов.Отменено	Нет 	
		//нов.Причина отмены	Не заполнять	
		//нов.Доля стоимости	Не заполнять	
		//нов.Доля стоимости на единицу	Не заполнять	
		//нов.Списать на расходы	Нет	
		//нов.Статья расходов / активов	Не заполнять	
		//нов.Аналитика расходов	Не заполнять	
		//нов.Аналитика активов/пассивов	Не заполнять	
		//нов.Ключ номенклатура	// Создать новый для каждой строки ТЧ // автоматом создает
		
		Если мЗаказКлиента.Найти(стр.ЗаказКлиента) = Неопределено Тогда
			мЗаказКлиента.Добавить(стр.ЗаказКлиента);
		КонецЕсли; 
		Если мНазначения.Найти(стр.Назначение) = Неопределено Тогда
			мНазначения.Добавить(стр.Назначение);
		КонецЕсли;
	КонецЦикла;          
		
	Если мЗаказКлиента.Количество() = 1 Тогда 
		Документ.ДокументОснование = мЗаказКлиента[0];
	КонецЕсли;  
	Если мНазначения.Количество() = 1 Тогда 
		Документ.Назначение = мНазначения[0];
	КонецЕсли;   
	Если Документ.Продукция.Количество() Тогда
		Документ.ТипПроизводственногоПроцесса = Документ.Продукция[0].Спецификация.ТипПроизводственногоПроцесса; // Реквизит "ТипПроизводственногоПроцесса" ресурсной спецификации, указанной реквизите "Спецификация" ТЧ "Продукция" документа "Заказ на производство"	
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 21:02:27] -
