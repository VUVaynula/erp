&НаКлиенте
Процедура бит_СоздатьЗаказНаПроизводство(Команда)
	// {{ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 20:20:35] +        
	мКлючейРегистра = Новый Массив;
	
	ВыбранныеСтроки = Элементы.Список.ВыделенныеСтроки;
    Для каждого стр из ВыбранныеСтроки Цикл
		Если ТипЗнч(стр) = Тип("РегистрСведенийКлючЗаписи.РаспределениеЗапасов") Тогда
			мКлючейРегистра.Добавить(стр);
		КонецЕсли;	
    КонецЦикла;
	
	ВыбранныеСтроки = Элементы.СписокЗаказы.ВыделенныеСтроки;
    Для каждого стр из ВыбранныеСтроки Цикл
		Если ТипЗнч(стр) = Тип("РегистрСведенийКлючЗаписи.РаспределениеЗапасов") Тогда
			мКлючейРегистра.Добавить(стр);
		КонецЕсли;
	КонецЦикла;    
	
	ОбработатьКлючиНаСервере(мКлючейРегистра);  
	Элементы.СписокЗаказы.Обновить(); 
	Элементы.Список.Обновить();
    // }}ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 20:20:35] -
