&НаСервере
Функция СоздатьШапкуЗаказаНаПроизводство(ИзготовитьК)
	// {{ПервыйБИТ ЛистТребований [ЛТ №5.31]  [VUVaynula@1cbit.ru] [02.05.2025 21:02:27] +        
	Документ = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Автор = Пользователи.АвторизованныйПользователь();
	Документ.ВариантОбособления = Константы.ВариантОбособленияМатериаловВПроизводстве.Получить();
	Документ.ДатаПотребности = ИзготовитьК;
	Документ.ДатаПотребностиУказываетсяВСтроках = ?(ЗначениеЗаполнено(ИзготовитьК), Истина, Ложь); 
