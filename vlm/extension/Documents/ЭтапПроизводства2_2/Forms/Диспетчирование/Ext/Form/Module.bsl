&НаСервереБезКонтекста
Процедура бит_ПересчитатьОбеспечение(Знач ЭтапОбъект)
	
	Всего = 0;
	Для Каждого стр из ЭтапОбъект.ВыходныеИзделия Цикл
		Если стр.Отменено Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + стр.Количество; 
	КонецЦикла;      
	
	Спецификация = ЭтапОбъект.Спецификация; 
	Если Спецификация.ОсновноеИзделиеУпаковка.Знаменатель = 0 Тогда
		КоэфУпакРС = 1;
	Иначе
		КоэфУпакРС = Спецификация.ОсновноеИзделиеУпаковка.Числитель / Спецификация.ОсновноеИзделиеУпаковка.Знаменатель;
	КонецЕсли;
	КоэфРС = Спецификация.ОсновноеИзделиеКоличествоУпаковок * КоэфУпакРС;  
	Если КоэфРС = 0 Тогда 
		КоэфРС = 1;
	КонецЕсли;	
	
	тзОбеспечениеИзСпецификации = ЭтапОбъект.Спецификация.МатериалыИУслуги.Выгрузить();
	Для каждого стрОбеспечениеЭтапа из ЭтапОбъект.ОбеспечениеМатериаламиИРаботами Цикл
		// не берем отмененные и те где пользователь сам указал серию а значит и количество)
		Если стрОбеспечениеЭтапа.Отменено 
			или ЗначениеЗаполнено(стрОбеспечениеЭтапа.Серия) Тогда
			Продолжить;
		КонецЕсли;
		
		мСтрокСпецификации = тзОбеспечениеИзСпецификации.НайтиСтроки(Новый Структура("Номенклатура, КлючСвязи", стрОбеспечениеЭтапа.Номенклатура, стрОбеспечениеЭтапа.КлючСвязиСпецификация));
		Если мСтрокСпецификации.Количество() Тогда
			новКоличество = Всего * мСтрокСпецификации[0].КоличествоУпаковок / КоэфРС;
			
			стрОбеспечениеЭтапа.Количество = новКоличество;
			стрОбеспечениеЭтапа.КоличествоУпаковок = новКоличество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

