&НаСервереБезКонтекста
Процедура ОбработатьЗакрытиеЭтапаНаСервере(Знач текЭтап)
	// {{ПервыйБИТ ЛистТребований [Доработка закрытия этапов]  [VUVaynula@1cbit.ru] [26.05.2026 11:18:18] +        
	ЭтапОбъект = текЭтап.ПолучитьОбъект();
	Для каждого стр из ЭтапОбъект.ОбеспечениеМатериаламиИРаботами Цикл
		Если стр.Номенклатура.ВидНоменклатуры.ИспользоватьСерии = Истина
			И Не ЗначениеЗаполнено(стр.Серия) 
			И не стр.Отменено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны серии в таблице Обеспечение " + текЭтап, текЭтап);
			Возврат;
		КонецЕсли; 
		Если Не стр.Отменено Тогда
			стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоФакт = 0;           
	ПричинаОтмены = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПричинаЗаменыОборудования, , Истина);
	Для каждого стр из ЭтапОбъект.ВыходныеИзделия Цикл 
		Если стр.Отменено Тогда 
			Продолжить;
		ИначеЕсли стр.Произведено Тогда 	
			КоличествоФакт = КоличествоФакт + стр.Количество;
		Иначе
			стр.Отменено = Истина;
			стр.ПричинаОтмены = ПричинаОтмены;
		КонецЕсли;
	КонецЦикла;
	ЭтапОбъект.КоличествоУпаковокОтменено = ЭтапОбъект.КоличествоУпаковокПлан - КоличествоФакт;  
	ЭтапОбъект.ОтразитьКоличествоОтмененоВТЧ(ПричинаОтмены);
	
	// пересчитаем обеспечение
	бит_ПересчитатьОбеспечение(ЭтапОбъект);
	// вкладка расход                                                                                 
	бит_ПересчитатьРасход(ЭтапОбъект);
	
	ЭтапОбъект.ДатаПроизводства = КонецДня(ТекущаяДатаСеанса());
	ЭтапОбъект.ФактическоеОкончаниеЭтапа = КонецДня(ТекущаяДатаСеанса());
	
	бит_ЗаписатьЭтап(ЭтапОбъект);

	// }}ПервыйБИТ ЛистТребований [Доработка закрытия этапов]  [VUVaynula@1cbit.ru] [26.05.2026 11:18:18] -
