Процедура СкорректироватьКоличествоПобочногоВыходаВОперациях(Запрос)
	// Получаем:
	// 1. документы операций;
	// 2. фактический выпуск ГП по операции без учета серий;
	// 3. нормы возвратных отходов из ресурсной спецификации;
	// 4. расчетное количество возвратного отхода по факту выпуска.

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПроизводственнаяОперация2_2.Ссылка КАК ПроизводственнаяОперация,
	|	ПроизводственнаяОперация2_2.Этап КАК Этап,
	|	ПроизводственнаяОперация2_2.Этап.Спецификация КАК Спецификация,
	|	ПроизводственнаяОперация2_2.Этап.Спецификация.ОсновноеИзделиеКоличествоУпаковок КАК КоличествоГППоСпецификации,
	|	ПроизводственнаяОперация2_2.Этап.Спецификация.ОсновноеИзделиеУпаковка КАК УпаковкаГППоСпецификации
	|ПОМЕСТИТЬ втОперации
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
	|ГДЕ
	|	ПроизводственнаяОперация2_2.Этап В(&мЭтапов)
	|	И ПроизводственнаяОперация2_2.Проведен
	|	И ПроизводственнаяОперация2_2.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПроизводственныхОпераций.Выполнена)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка КАК ПроизводственнаяОперация,
	|	СУММА(ПроизводственнаяОперация2_2ВыходныеИзделия.Количество) КАК КоличествоГПФакт
	|ПОМЕСТИТЬ втГППоОперациям
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2.ВыходныеИзделия КАК ПроизводственнаяОперация2_2ВыходныеИзделия
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВидыГП КАК ВидыГП
	|		ПО ПроизводственнаяОперация2_2ВыходныеИзделия.Номенклатура.ВидНоменклатуры = ВидыГП.Значение
	|ГДЕ
	|	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка В
	|			(ВЫБРАТЬ
	|				втОперации.ПроизводственнаяОперация
	|			ИЗ
	|				втОперации КАК втОперации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОперации.ПроизводственнаяОперация КАК ПроизводственнаяОперация,
	|	втОперации.Спецификация КАК Спецификация,
	|	втГППоОперациям.КоличествоГПФакт КАК КоличествоГПФакт,
	|	втОперации.КоличествоГППоСпецификации КАК КоличествоГППоСпецификации,
	|	втОперации.УпаковкаГППоСпецификации КАК УпаковкаГППоСпецификации,
	|	ВЫБОР    
	|		КОГДА втОперации.УпаковкаГППоСпецификации.Знаменатель есть null
	|			ТОГДА 1
	|		КОГДА втОперации.УпаковкаГППоСпецификации.Знаменатель = 0
	|			ТОГДА 1
	|		КОГДА втОперации.УпаковкаГППоСпецификации.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ втОперации.УпаковкаГППоСпецификации.Числитель / втОперации.УпаковкаГППоСпецификации.Знаменатель
	|	КОНЕЦ КАК КоэфУпаковкиГП,
	|	ВЫБОР     
	|		КОГДА РесурсныеСпецификацииВозвратныеОтходы.Упаковка.Знаменатель есть null
	|			ТОГДА 1
	|		КОГДА РесурсныеСпецификацииВозвратныеОтходы.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		КОГДА РесурсныеСпецификацииВозвратныеОтходы.Упаковка.Числитель = 0
	|			ТОГДА 1
	|		ИНАЧЕ РесурсныеСпецификацииВозвратныеОтходы.Упаковка.Числитель / РесурсныеСпецификацииВозвратныеОтходы.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоэфУпаковкиОтхода,
	|	РесурсныеСпецификацииВозвратныеОтходы.Номенклатура КАК Номенклатура,
	|	РесурсныеСпецификацииВозвратныеОтходы.Характеристика КАК Характеристика,
	|	РесурсныеСпецификацииВозвратныеОтходы.Упаковка КАК Упаковка,
	|	РесурсныеСпецификацииВозвратныеОтходы.КоличествоУпаковок КАК КоличествоОтходаПоСпецификации
	|ИЗ
	|	втОперации КАК втОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втГППоОперациям КАК втГППоОперациям
	|		ПО втОперации.ПроизводственнаяОперация = втГППоОперациям.ПроизводственнаяОперация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.ВозвратныеОтходы КАК РесурсныеСпецификацииВозвратныеОтходы
	|		ПО втОперации.Спецификация = РесурсныеСпецификацииВозвратныеОтходы.Ссылка
	|ГДЕ
	|	втГППоОперациям.КоличествоГПФакт > 0
	|	И втОперации.КоличествоГППоСпецификации > 0";

	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивВидовГП = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыГотовойПродукцииВПроизводственнойОперации);
	СоответствиеОпераций = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		КоэфУпаковкиГП = Выборка.КоэфУпаковкиГП; 
		КоэфУпаковкиОтхода = Выборка.КоэфУпаковкиОтхода;

		// Норма отхода на единицу ГП.
		// Сначала приводим норму отхода и количество ГП спецификации к базовым единицам.
		КоличествоГПСпецификацииВБазовойЕдинице = Выборка.КоличествоГППоСпецификации * КоэфУпаковкиГП;
		КоличествоОтходаСпецификацииВБазовойЕдинице = Выборка.КоличествоОтходаПоСпецификации * КоэфУпаковкиОтхода;

		НормаОтходаНаЕдиницуГП = КоличествоОтходаСпецификацииВБазовойЕдинице / КоличествоГПСпецификацииВБазовойЕдинице;
		// Фактическое количество отхода в базовой единице.
		КоличествоОтходаФактВБазовойЕдинице = Выборка.КоличествоГПФакт * КоэфУпаковкиГП * НормаОтходаНаЕдиницуГП;
		// Возвращаем в единицу / упаковку строки возвратного отхода.
		КоличествоОтходаФакт = КоличествоОтходаФактВБазовойЕдинице / КоэфУпаковкиОтхода;

		СтрокиОперации = СоответствиеОпераций.Получить(Выборка.ПроизводственнаяОперация);
		Если СтрокиОперации = Неопределено Тогда
			СтрокиОперации = Новый ТаблицаЗначений;
			СтрокиОперации.Колонки.Добавить("Номенклатура");
			СтрокиОперации.Колонки.Добавить("Характеристика");
			СтрокиОперации.Колонки.Добавить("Упаковка");
			СтрокиОперации.Колонки.Добавить("Количество");
			СоответствиеОпераций.Вставить(Выборка.ПроизводственнаяОперация, СтрокиОперации);
		КонецЕсли;

		НоваяСтрока = СтрокиОперации.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Характеристика = Выборка.Характеристика;
		НоваяСтрока.Упаковка = Выборка.Упаковка;
		НоваяСтрока.Количество = КоличествоОтходаФакт;

	КонецЦикла;
	
	// обработаем то что нашли по итогу
	Для Каждого ЭлементОперации Из СоответствиеОпераций Цикл
		
		ОперацияОбъект = ЭлементОперации.Ключ.ПолучитьОбъект();
		ТаблицаОтходов = ЭлементОперации.Значение;

		Для Каждого СтрокаРасчета Из ТаблицаОтходов Цикл
			
			стрОтбора = Новый Структура("Номенклатура, Характеристика", СтрокаРасчета.Номенклатура, СтрокаРасчета.Характеристика);
			СтрокиОперации = ОперацияОбъект.ВыходныеИзделия.НайтиСтроки(стрОтбора);
			Для Каждого СтрокаОперации Из СтрокиОперации Цикл
				
				// на всякий случай проверим тут
				Если МассивВидовГП.Найти(СтрокаОперации.Номенклатура.ВидНоменклатуры) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				СтрокаОперации.Количество = СтрокаРасчета.Количество;
				СтрокаОперации.КоличествоУпаковок = СтрокаРасчета.Количество;

				Если ЗначениеЗаполнено(СтрокаРасчета.Упаковка) Тогда
					СтрокаОперации.Упаковка = СтрокаРасчета.Упаковка;
				КонецЕсли;

			КонецЦикла;

		КонецЦикла;
        Попытка
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось скорректировать количество возвратных отходов для " 
																+ ОперацияОбъект.Ссылка 
																+ " по причине " 
																+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), ОперацияОбъект.Ссылка); 
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры
 
#КонецЕсли

&ИзменениеИКонтроль("ТекстЗапросаЗаполненияСтатусовУказанияСерийОбеспечениеМатериаламиИРаботами")
Функция бит_ТекстЗапросаЗаполненияСтатусовУказанияСерийОбеспечениеМатериаламиИРаботами()

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Склад КАК Склад,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Серия КАК Серия,
