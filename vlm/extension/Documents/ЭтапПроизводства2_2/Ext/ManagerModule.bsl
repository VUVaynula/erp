#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура бит_ПерезаполнитьПоОперациям(Знач мЭтапов) Экспорт 
	// {{ПервыйБИТ ЛистТребований [ЛТ5.26]  [VUVaynula@1cbit.ru] [02.12.2025 0:35:51] +        
	Если мЭтапов.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("мЭтапов", мЭтапов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ЗначенияПоУмолчаниюЗначения.Значение КАК Значение
	               |ПОМЕСТИТЬ ВидыГП
	               |ИЗ
	               |	Справочник.бит_ЗначенияПоУмолчанию.Значения КАК бит_ЗначенияПоУмолчаниюЗначения
	               |ГДЕ
	               |	бит_ЗначенияПоУмолчаниюЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.бит_ЗначенияПоУмолчанию.ВидыНоменклатурыГотовойПродукцииВПроизводственнойОперации)
	               |";
	Запрос.Выполнить();
	
	// сначала скорректируем количество в операциях
	СкорректироватьКоличествоПобочногоВыходаВОперациях(Запрос);
	
	// теперь сама трансляция
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка КАК ПроизводственнаяОперация,
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Номенклатура КАК Номенклатура,
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Серия КАК СерияНоменклатуры,
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Количество КАК Количество,
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка.Этап КАК Этап,
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка.СменноеЗадание.Дата КАК ДатаПроизводства
	               |ПОМЕСТИТЬ База
	               |ИЗ
	               |	Документ.ПроизводственнаяОперация2_2.ВыходныеИзделия КАК ПроизводственнаяОперация2_2ВыходныеИзделия
	               |ГДЕ
	               |	ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка.Этап В(&мЭтапов)
	               |	И ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка.Проведен
	               |	И ПроизводственнаяОперация2_2ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПроизводственныхОпераций.Выполнена)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	База.Этап КАК Этап,
	               |	База.Номенклатура КАК Номенклатура,
	               |	База.СерияНоменклатуры КАК Серия,
	               |	База.ДатаПроизводства КАК ДатаПроизводства,
	               |	СУММА(База.Количество) КАК Количество
	               |ИЗ
	               |	База КАК База
	               |ГДЕ
	               |	База.Номенклатура.ВидНоменклатуры В
	               |			(ВЫБРАТЬ
	               |				ВидыГП.Значение
	               |			ИЗ
	               |				ВидыГП)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	База.Этап,
	               |	База.Номенклатура,
	               |	База.СерияНоменклатуры,
	               |	База.ДатаПроизводства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	База.Этап КАК Этап,
	               |	База.Номенклатура КАК Номенклатура,
	               |	База.СерияНоменклатуры КАК Серия,
	               |	База.ДатаПроизводства КАК ДатаПроизводства,
	               |	СУММА(База.Количество) КАК Количество
	               |ИЗ
	               |	База КАК База
	               |ГДЕ
	               |	НЕ База.Номенклатура.ВидНоменклатуры В
	               |				(ВЫБРАТЬ
	               |					ВидыГП.Значение
	               |				ИЗ
	               |					ВидыГП)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	База.Этап,
	               |	База.Номенклатура,
	               |	База.СерияНоменклатуры,
	               |	База.ДатаПроизводства";

	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
    тзВыходныеИзделияБаза = МассивРезультатовЗапроса[1].Выгрузить();
	тзПобочныйВыходБаза = МассивРезультатовЗапроса[2].Выгрузить();
	
	КГ = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("166");
	
	Для каждого текЭтап Из мЭтапов Цикл
		// собсно гемор перезаполнения бегин                                                         
		СтруктураПоиска = Новый Структура("Этап", текЭтап);
		СтрокиВыходныеИзделияБазаРаспределения = тзВыходныеИзделияБаза.НайтиСтроки(СтруктураПоиска); 
		СтрокиПобочкаБазаРаспределения = тзПобочныйВыходБаза.НайтиСтроки(СтруктураПоиска); 
		
		Если СтрокиВыходныеИзделияБазаРаспределения.Количество() = 0 Тогда
			Продолжить; // попытаться стоило
		КонецЕсли;               
		
		ЭтапОбъект = ТекЭтап.ПолучитьОбъект();
		ЭтапОбъект.ВыходныеИзделия.Очистить();
		
		// -----------Коэффициент пересчета из спецификации---------------------------
		Спецификация = текЭтап.Спецификация; 
		Если Спецификация.ОсновноеИзделиеУпаковка.Знаменатель = 0 Тогда
			КоэфУпакРС = 1;
		Иначе
			КоэфУпакРС = Спецификация.ОсновноеИзделиеУпаковка.Числитель / Спецификация.ОсновноеИзделиеУпаковка.Знаменатель;
		КонецЕсли;
			
		КоэфРС = Спецификация.ОсновноеИзделиеКоличествоУпаковок * КоэфУпакРС;  
		Если КоэфРС = 0 Тогда 
			КоэфРС = 1;
		КонецЕсли;
		КоэффициентПересчета = текЭтап.КоличествоУпаковокФакт / КоэфРС;
		// --------------------------------------
		тзЭтапаВыходныеИзделия = текЭтап.ВыходныеИзделия.Выгрузить();
		// --------------------------------------
		// вернем на место отмененные
		//СтрокиПоКлючу = тзЭтапаВыходныеИзделия.НайтиСтроки(Новый Структура("Отменено", Истина));
		//Для каждого СтрОтмены Из СтрокиПоКлючу Цикл
		//	нов = ЭтапОбъект.ВыходныеИзделия.Добавить();
		//	ЗаполнитьЗначенияСвойств(нов, СтрОтмены);
		//КонецЦикла;
		// свернем то что было в этапе
		тзЭтапаВыходныеИзделия.Свернуть("Номенклатура, Характеристика, Получатель, Упаковка, Назначение, Подразделение, Отменено, ПричинаОтмены", "Количество, КоличествоУпаковок");
		тзЭтапаВыходныеИзделия.Колонки.Добавить("Серия");
		тзЭтапаВыходныеИзделия.Колонки.Добавить("ДатаПроизводства");
		тзЭтапаВыходныеИзделия.Колонки.Добавить("Произведено");
		// заполним переменные
		СтатьяКалькуляции = Справочники.СтатьиКалькуляции.ПустаяСсылка();
		Получатель = Неопределено;
		Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
		Если ЭтапОбъект.ПобочныеИзделия.Количество() Тогда
			СтатьяКалькуляции = ЭтапОбъект.ПобочныеИзделия[0].СтатьяКалькуляции;
			Получатель = ЭтапОбъект.ПобочныеИзделия[0].Получатель;
			Подразделение = ЭтапОбъект.ПобочныеИзделия[0].Подразделение;
			
			тзПобочные = ЭтапОбъект.ПобочныеИзделия.Выгрузить();
			ЭтапОбъект.ПобочныеИзделия.Очистить();
			// вернем отмененные
			СтрокиПоКлючу = тзПобочные.НайтиСтроки(Новый Структура("Отменено", Истина));
			Для каждого СтрОтмены Из СтрокиПоКлючу Цикл
				нов = ЭтапОбъект.ПобочныеИзделия.Добавить();
				ЗаполнитьЗначенияСвойств(нов, СтрОтмены);
			КонецЦикла;
		КонецЕсли;
		
		// с побочными все просто: 
		// 1. закидываем все что есть в операциях  
		КодСтроки = 1;
		Для каждого стр из СтрокиПобочкаБазаРаспределения Цикл
			нов = ЭтапОбъект.ПобочныеИзделия.Добавить();
			нов.Номенклатура = стр.Номенклатура;
			нов.КоличествоУпаковок = стр.Количество;
			нов.Количество = стр.Количество;
			нов.Получатель = Получатель;
			нов.Серия = стр.Серия;
			нов.ДатаПроизводства = стр.ДатаПроизводства;  
			нов.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			нов.СтатьяКалькуляции = СтатьяКалькуляции;
			
			нов.КодСтроки = КодСтроки;
			КодСтроки = КодСтроки + 1;
			
			нов.Период = КонецМесяца(стр.ДатаПроизводства);
			нов.Подразделение = Подразделение;
			
			нов.Произведено = Истина;
			
			нов.КлючНоменклатура = Новый УникальныйИдентификатор;
		КонецЦикла;
		// 2. Добиваем тем что есть в спецификации
		Для каждого стрСпецификации из Спецификация.ВозвратныеОтходы Цикл
				СтрокиПоКлючу = ЭтапОбъект.ПобочныеИзделия.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", стрСпецификации.Номенклатура, стрСпецификации.Характеристика));
				КоличествоВЭтапе = 0;
				Для каждого стрПобочки из СтрокиПоКлючу Цикл
					КоличествоВЭтапе = КоличествоВЭтапе + стрПобочки.Количество;
				КонецЦикла;
				Если КоличествоВЭтапе < стрСпецификации.КоличествоУпаковок * КоэффициентПересчета Тогда
					нов = ЭтапОбъект.ПобочныеИзделия.Добавить();
					нов.Номенклатура = стрСпецификации.Номенклатура;
					нов.КоличествоУпаковок = (стрСпецификации.КоличествоУпаковок * КоэффициентПересчета) - КоличествоВЭтапе;
					нов.Количество = нов.КоличествоУпаковок;
					нов.Получатель = Получатель;
					нов.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
					нов.СтатьяКалькуляции = СтатьяКалькуляции;
			        нов.КодСтроки = КодСтроки;
					КодСтроки = КодСтроки + 1;
			
					нов.Подразделение = Подразделение;
			
					нов.КлючНоменклатура = Новый УникальныйИдентификатор;
				КонецЕсли;
		КонецЦикла;                                                                             
		
		// -------------------------------------------------------------------------------------
		// для выходных изделий в таблице к распределению есть колонки 
		// Номенклатура, Серия, ДатаПроизводства, Количество. добавляем строки. откусываем количество от 
		// тзЭтапаВыходныеИзделия: Номенклатура, Получатель, Упаковка, Назначение, Подразделение", "Количество
		// то есть ищем по номенклатуре
		// все что останется - пойдет к производству без серии. если не хватит - ставим флаг и потом пересчитаем обеспечение
    	// Флаг превышения количества хоть в одной строке
		ФлагПревышения = Ложь;
		Если тзЭтапаВыходныеИзделия.Количество() Тогда
        	СтрокаЭталон = тзЭтапаВыходныеИзделия[0];
		Иначе              
			СтрокаЭталон = Неопределено;
		КонецЕсли;
		СтрДок = Неопределено;             
		
		// СтрокиВыходныеИзделияБазаРаспределения - это список номенклатур которые прилетели из операции. 
    	Для Каждого ОпорнаяСтрока Из СтрокиВыходныеИзделияБазаРаспределения Цикл
        	// Ищем строки документа с той же номенклатурой и пустой серией
			// отмененные не трогаем
        	МассивСтрок = тзЭтапаВыходныеИзделия.НайтиСтроки(Новый Структура("Номенклатура, Серия, Отменено", ОпорнаяСтрока.Номенклатура, Неопределено, Ложь));
			Для Каждого СтрДок Из МассивСтрок Цикл              
				СтрокаЭталон = СтрДок;
                // ----------------------------
				Если ОпорнаяСтрока.Количество = 0 Тогда
					Продолжить;
				КонецЕсли;   
				// ----------------------------
				Если СтрДок.Количество > ОпорнаяСтрока.Количество Тогда
                	// Создаем новую строку и копируем все свойства из исходной строки документа
                	НовСтр = тзЭтапаВыходныеИзделия.Добавить();
                	ЗаполнитьЗначенияСвойств(НовСтр, СтрДок);
                	// Заполняем уникальные поля
                	НовСтр.Серия             = ОпорнаяСтрока.Серия;
                	НовСтр.ДатаПроизводства  = ОпорнаяСтрока.ДатаПроизводства;
                	НовСтр.Количество        = ОпорнаяСтрока.Количество;
					НовСтр.КоличествоУпаковок = ОпорнаяСтрока.Количество;
					НовСтр.Произведено       = Истина;
                	// Уменьшаем количество в исходной строке
                	СтрДок.Количество = СтрДок.Количество - ОпорнаяСтрока.Количество;
					СтрДок.КоличествоУпаковок = СтрДок.Количество;
					
					ОпорнаяСтрока.Количество = 0;
            	Иначе
                	// Если количество строки документа меньше или равно распределению 
					ФлагПревышения = ФлагПревышения Или (СтрДок.Количество < ОпорнаяСтрока.Количество);
					
                	СтрДок.Серия             = ОпорнаяСтрока.Серия;
                	СтрДок.ДатаПроизводства  = ОпорнаяСтрока.ДатаПроизводства;
					СтрДок.Количество		 = ОпорнаяСтрока.Количество;
					СтрДок.КоличествоУпаковок = ОпорнаяСтрока.Количество;
               		СтрДок.Произведено       = Истина;
					
					ОпорнаяСтрока.Количество = 0;
				КонецЕсли;
        	КонецЦикла;
        	// Если после распределения остался остаток → создаем новую строку
        	Если ОпорнаяСтрока.Количество > 0 Тогда
            	НовСтр = тзЭтапаВыходныеИзделия.Добавить();
				Если ЗначениеЗаполнено(СтрокаЭталон) Тогда
            		ЗаполнитьЗначенияСвойств(НовСтр, СтрокаЭталон);
				КонецЕсли;
	            НовСтр.Серия             = ОпорнаяСтрока.Серия;
	            НовСтр.ДатаПроизводства  = ОпорнаяСтрока.ДатаПроизводства;
	            НовСтр.Количество		 = ОпорнаяСтрока.Количество;
				НовСтр.КоличествоУпаковок = ОпорнаяСтрока.Количество;
	            НовСтр.Произведено       = Истина;
	            ФлагПревышения = Истина;
        	КонецЕсли;
    	КонецЦикла;
        // Загружаем обратно в документ
    	ЭтапОбъект.ВыходныеИзделия.Загрузить(тзЭтапаВыходныеИзделия);
		
		// посчитаем итог по этапу
		Всего = 0;
		Для каждого стрПроизведено из ЭтапОбъект.ВыходныеИзделия Цикл
			Если стрПроизведено.Произведено Тогда
				Всего = Всего + стрПроизведено.Количество;
			КонецЕсли;
		КонецЦикла;
		ЭтапОбъект.КоличествоУпаковокФакт = Всего;                   
		
		// обеспечение и далее
		// посчитаем количество произведенной ГП
		ВсегоПоФакту = 0;
		Для Каждого стр из ЭтапОбъект.ВыходныеИзделия Цикл
			Если стр.Отменено Тогда
				Продолжить;
			КонецЕсли;
			ВсегоПоФакту = ВсегоПоФакту + стр.Количество; 
		КонецЦикла;
		
		тзОбеспечениеИзСпецификации = ЭтапОбъект.Спецификация.МатериалыИУслуги.Выгрузить();
		Для каждого стрОбеспечениеЭтапа из ЭтапОбъект.ОбеспечениеМатериаламиИРаботами Цикл
			Если стрОбеспечениеЭтапа.Отменено Тогда
				Продолжить;
			КонецЕсли;
			
			мСтрокСпецификации = тзОбеспечениеИзСпецификации.НайтиСтроки(Новый Структура("Номенклатура, КлючСвязи", стрОбеспечениеЭтапа.Номенклатура, стрОбеспечениеЭтапа.КлючСвязиСпецификация));
			Если мСтрокСпецификации.Количество() Тогда
				новКоличество = ВсегоПоФакту * мСтрокСпецификации[0].КоличествоУпаковок / КоэфРС;
				
				Если новКоличество > стрОбеспечениеЭтапа.Количество Тогда
					стрОбеспечениеЭтапа.Количество = новКоличество;
					стрОбеспечениеЭтапа.КоличествоУпаковок = новКоличество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		Если не ЗначениеЗаполнено(ЭтапОбъект.ДатаПроизводства) Тогда
			ЭтапОбъект.ДатаПроизводства = КонецДня(ТекущаяДатаСеанса());
		КонецЕсли;
		
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(ЭтапОбъект, Документы.ЭтапПроизводства2_2));
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтапОбъект, ПараметрыУказанияСерий.ВыходныеИзделия);
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтапОбъект, ПараметрыУказанияСерий.ПобочныеИзделия);
		//Для каждого стр Из ЭтапОбъект.ВыходныеИзделия Цикл  
