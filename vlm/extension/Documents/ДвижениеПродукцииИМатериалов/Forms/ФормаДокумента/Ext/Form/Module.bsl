 
 &НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ5.33] [ASHolyavko@1cbit.ru] [04.03.2026] +        
	//Механизм подбора серий заменен по аналогии из документа ЗаказМатериаловВПроизводство
	
	Элементы.ТоварыУказатьСерии.Видимость = Ложь;
	
	ОписаниеКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3));
	ОписаниеБулево = Новый ОписаниеТипов("Булево", );	                                           
	ОписаниеСклады = Новый ОписаниеТипов(Новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	МассивРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("ДоступныеОстаткиПараметрыВстраивания", Новый ОписаниеТипов());
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("Доступно", ОписаниеКоличества, "Объект.Товары");
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ОтгружатьЕслиДоступно", ОписаниеБулево, "Объект.Товары");
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("Обособленно", ОписаниеБулево, "Объект.Товары");
	МассивРеквизитов.Добавить(НовыйРеквизит);           
	
	НовыйРеквизит = Новый РеквизитФормы("Склад", ОписаниеСклады, "Объект.Товары");
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("ТоварыДоступно", Тип("ПолеФормы"), Элементы.Товары);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.Товары.Доступно";
	НовыйЭлемент.Видимость = Ложь;
	
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("ТоварыВариантОбеспечения", Тип("ПолеФормы"), Элементы.Товары);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.Товары.ВариантОбеспечения";
	НовыйЭлемент.Видимость = Ложь;
		
	ПараметрыВстраивания = Документы.ДвижениеПродукцииИМатериалов.ДоступныеОстаткиПараметрыВстраивания();
	ОбеспечениеВДокументахСервер.ДоступныеОстаткиПриСозданииНаСервере(ЭтотОбъект, ПараметрыВстраивания);
	
	ОбновитьКолонкуДоступноСервер();
	
	// }}ПервыйБИТ ЛистТребований [ЛТ5.33] [ASHolyavko@1cbit.ru] [04.03.2026] -
	
КонецПроцедуры

&НаКлиенте
