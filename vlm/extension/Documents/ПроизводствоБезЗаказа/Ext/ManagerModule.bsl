Функция ПодготовитьШтрихкод(Знач Штрихкод, Знач ВесСтрокой) Экспорт
// {{ПервыйБИТ ЛистТребований [АРМ Завесы]  [VUVaynula@1cbit.ru] [27.11.2025 22:37:17] +	
	Если СтрДлина(Штрихкод) = 13 И Лев(Штрихкод, 2) = "2_" Тогда
		Диапазон = ЗначениеНастроекПовтИсп.ДиапазонВесовыхШтрихкодовПоУмолчанию();
		
		Если Диапазон = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Не определены диапазоны весовых штрихкодов.';
									|en = 'Weight barcode ranges are not determined.'");	
		КонецЕсли;
		
		Строка = Диапазон + Сред(Штрихкод, 3, 5) + Лев(ВесСтрокой, 5);
		Возврат Строка + РегистрыСведений.ШтрихкодыНоменклатуры.КонтрольныйСимволEAN(Строка, 13);
	КонецЕсли;
	
	Возврат Штрихкод; 
// }}ПервыйБИТ ЛистТребований [АРМ Завесы]  [VUVaynula@1cbit.ru] [27.11.2025 22:37:17] -	
