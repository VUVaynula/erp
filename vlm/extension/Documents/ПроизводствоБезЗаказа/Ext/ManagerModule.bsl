Функция МассаТарыКГ(Знач Тара)
// {{ПервыйБИТ ЛистТребований [АРМ Завесы]  [VUVaynula@1cbit.ru] [27.11.2025 22:37:17] +	
	Если Не ЗначениеЗаполнено(Тара) или Тара.ВесИспользовать = Ложь Тогда
		Масса = 0;
	Иначе
		кг = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("166");
		Масса = Тара.ВесЧислитель / ?(ЗначениеЗаполнено(Тара.ВесЗнаменатель), Тара.ВесЗнаменатель, 1);
		Если Тара.ЕдиницаИзмерения <> кг Тогда
			Масса = Масса * ?(ЗначениеЗаполнено(Тара.ЕдиницаИзмерения.Числитель), Тара.ЕдиницаИзмерения.Числитель, 1) / ?(ЗначениеЗаполнено(Тара.ЕдиницаИзмерения.Знаменатель), Тара.ЕдиницаИзмерения.Знаменатель, 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Масса;
// }}ПервыйБИТ ЛистТребований [АРМ Завесы]  [VUVaynula@1cbit.ru] [27.11.2025 22:37:17] -	
