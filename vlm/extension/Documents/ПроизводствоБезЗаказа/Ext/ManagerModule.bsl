		нов.НомерСерии = стр.Серия;
		Если ЗначениеЗаполнено(стр.Серия) Тогда
			нов.ШКСерии = Справочники.СерииНоменклатуры.СгенерироватьСтрокуШК(стр.Серия);
		КонецЕсли;
		нов.СтандартGOST = ПолучитьЗначениеПризнака(стр.Номенклатура, Справочники.бит_ЗначенияПоУмолчанию.ПризнакГОСТ);
		нов.РазмерRAZMER = ПолучитьЗначениеПризнака(Стр.Номенклатура, Справочники.бит_ЗначенияПоУмолчанию.ПризнакРазмерГотовойПродукции);
