&ИзменениеИКонтроль("ТаблицаСерияПриИзменении")
Процедура бит_ТаблицаСерияПриИзменении(ИмяТЧ)

	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;

	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();

	ВыбранноеЗначение.Значение						= ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки	= ТекущиеДанные.ПолучитьИдентификатор();

	НоменклатураКлиент.ОбработатьУказаниеСерии(
	ЭтаФорма,
	ПараметрыУказанияСерий[ИмяТЧ],
	ВыбранноеЗначение,
	ТекущиеДанные);

	СтруктураДействий = Новый Структура;

	Если ЦенообразованиеКлиент.НеобходимПересчетЦеныПриИзменении(ТекущиеДанные.Номенклатура, "Серия", Объект.Дата) Тогда

		Если ИмяТЧ = "ВыходныеИзделия" Тогда
			СтруктураДействий.Вставить("ПроверитьЗаполнитьДолюСтоимости", ПараметрыРаспределенияЗатрат);
		КонецЕсли;

		Если (ИмяТЧ = "ВыходныеИзделия" И ИспользоватьПлановуюСтоимость)
			Или ИмяТЧ = "ПобочныеИзделия" Тогда

			СтруктураПараметров = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияЦеныВСтрокеТЧ(Объект);
			СтруктураПараметров.Вставить("ВидЦены", Объект.ВидЦены);
			СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", СтруктураПараметров);
			СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");

		КонецЕсли;

	КонецЕсли;
	#Вставка 
	// {{ПервыйБИТ ЛистТребований [исправления после сквозного]  [VUVaynula@1cbit.ru] [16.03.2026 10:43:22] +        
	Если ИмяТЧ = "ВыходныеИзделия" И ЗначениеЗаполнено(ТекущиеДанные.Серия) Тогда
		
		Количество = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Серия, "бит_МассаНетто");
		Если Количество > 0 Тогда
			ТекущиеДанные.Количество = Количество;
		КонецЕсли;
		
	    ТекущиеДанные.бит_ШтампЭмалировщика = бит_ШтампЭмалировщика(ТекущиеДанные.Серия);
		
		ТекущиеДанные.бит_Тара = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Серия, "бит_ТипТары");
	
		ТекущиеДанные.бит_МассаТарыКг = бит_ПересчитатьМассуТары(ТекущиеДанные.бит_Тара);
	
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [исправления после сквозного]  [VUVaynula@1cbit.ru] [16.03.2026 10:43:22] -
	#КонецВставки

	Если Не СтруктураДействий.Количество() = 0 Тогда
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;

КонецПроцедуры  

