		Масса = бит_Тара.ВесЧислитель / ?(ЗначениеЗаполнено(бит_Тара.ВесЗнаменатель), бит_Тара.ВесЗнаменатель, 1);
		Если бит_Тара.ЕдиницаИзмерения <> КГ() Тогда
			бит_МассаТарыКг = Масса * ?(ЗначениеЗаполнено(бит_Тара.ЕдиницаИзмерения.Числитель), бит_Тара.ЕдиницаИзмерения.Числитель, 1) / ?(ЗначениеЗаполнено(бит_Тара.ЕдиницаИзмерения.Знаменатель), бит_Тара.ЕдиницаИзмерения.Знаменатель, 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат бит_МассаТарыКг;
