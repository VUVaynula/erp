&НаКлиенте
Перем ФормаДлительнойОперации;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для каждого стр из Объект.Товары Цикл
		Если стр.Отменено Тогда
			Продолжить;
		КонецЕсли;
		нов = ТаблицаТоваров.Добавить();    
		ЗаполнитьЗначенияСвойств(нов, стр, "НомерСтроки,Номенклатура,Количество");
		нов.Спецификация = ОпределитьПоследнююСпецификацию(нов.Номенклатура, ТекущаяДатаСеанса()); 
		нов.СрокИзготовления = ПустойСрок();
	КонецЦикла;
	СрокИзготовленияЗаказа = Дата("00010101");     
	Элементы.Ошибки.Видимость = Ошибки.Количество();
	ДинамическаяСтруктура = Истина;
	
	ЗаполнитьДлительныеОперацииФормы();
	
КонецПроцедуры                               

#Область Вспомогалки

&НаКлиентеНаСервереБезКонтекста
Функция ПустойСрок()
	Возврат "Не определён";
КонецФункции

&НаСервере
Процедура ЗаполнитьДлительныеОперацииФормы()
	
	НоваяСтрока = ДлительныеОперацииФормы.Добавить();
	НоваяСтрока.Имя = ИмяДлительнойОперацииСрокиВыпуска();
	НоваяСтрока.НачатьОжидание = Ложь;
	НоваяСтрока.ДлительнаяОперация = Неопределено;
	
	НоваяСтрока = ДлительныеОперацииФормы.Добавить();
	НоваяСтрока.Имя = ИмяДлительнойОперацииЗагрузкаОборудования();
	НоваяСтрока.НачатьОжидание = Ложь;
	НоваяСтрока.ДлительнаяОперация = Неопределено;
	
	НоваяСтрока = ДлительныеОперацииФормы.Добавить();
	НоваяСтрока.Имя = ИмяДлительнойОперацииОбеспечениеМатериалами();
	НоваяСтрока.НачатьОжидание = Ложь;
	НоваяСтрока.ДлительнаяОперация = Неопределено;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ОпределитьПоследнююСпецификацию(Номенклатура, ДатаРасчета)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	РесурсныеСпецификации.НачалоДействия КАК НачалоДействия,
		|	РесурсныеСпецификации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
		|ГДЕ
		|	РесурсныеСпецификации.ОсновноеИзделиеНоменклатура = &ОсновноеИзделиеНоменклатура
		|	И РесурсныеСпецификации.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует)
		|	И НЕ РесурсныеСпецификации.ПометкаУдаления
		|	И РесурсныеСпецификации.НачалоДействия <= &ДатаРасчета
	//	|	И РесурсныеСпецификации.КонецДействия >= &ДатаРасчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоДействия УБЫВ
		|");	
	Запрос.УстановитьПараметр("ОсновноеИзделиеНоменклатура", Номенклатура);
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Спецификация = Выборка.Ссылка;
	Иначе
		Спецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Спецификация;
	
КонецФункции          

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)  
	
	сВозврата = Новый Соответствие;
	Для каждого стр из ТаблицаТоваров Цикл
		Если ЗначениеЗаполнено(стр.СрокИзготовления) И ТипЗнч(стр.СрокИзготовления) = Тип("Дата") Тогда
			сВозврата.Вставить(стр.НомерСтроки, стр.СрокИзготовления);
		КонецЕсли;
	КонецЦикла;
	Закрыть(сВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСрокИзготовленияЗаказа(Команда)
	КомандаРассчитатьСрокИзготовления();
КонецПроцедуры                      

&НаКлиенте
Процедура КомандаРассчитатьСрокИзготовления() 
	
	РасчетЗавершен = Ложь;
    СрокИзготовленияЗаказа = Дата("00010101");
	
	Если ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
		УдалитьЗаказНаПроизводство();
	КонецЕсли;
	Ошибки.Очистить();
	
	Если ВоеннаяПродукция Тогда
		РассчитатьНаСервере(); 
		РассчитатьОбщийСрокИзготовления();  
		Элементы.Ошибки.Видимость = Ошибки.Количество();
	Иначе
		НастройкиПроизводства = Неопределено;
		РассчитатьНаСервере(НастройкиПроизводства); 
	    РасчетЗавершение(НастройкиПроизводства);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура УдалитьЗаказНаПроизводство()

		ДокОбъект = ЗаказНаПроизводство.ПолучитьОбъект();
		ДокОбъект.УстановитьПометкуУдаления(Истина);
		
		// удалим регистратор графика производства
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	ДоступностьВидовРабочихЦентров.Регистратор КАК Ссылка
		                      |ИЗ
		                      |	РегистрНакопления.ДоступностьВидовРабочихЦентров КАК ДоступностьВидовРабочихЦентров
		                      |ГДЕ
		                      |	ДоступностьВидовРабочихЦентров.Распоряжение = &Распоряжение");
		Запрос.УстановитьПараметр("Распоряжение", ДокОбъект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			РегистраторОбъект = Выборка.Ссылка.ПолучитьОбъект();
			РегистраторОбъект.УстановитьПометкуУдаления(Истина);
			РегистраторОбъект = Выборка.Ссылка.ПолучитьОбъект();
			РегистраторОбъект.Удалить(); 
		КонецЦикла;
		// теперь удалим сам заказ на производство
		ДокОбъект = ЗаказНаПроизводство.ПолучитьОбъект();
		ДокОбъект.Удалить();   
		ЗаказНаПроизводство	 = Документы.ЗаказНаПроизводство2_2.ПустаяСсылка();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьОбщийСрокИзготовления()
	
	тСроки = ТаблицаТоваров.Выгрузить( , "СрокИзготовления");
	тСроки.Сортировать("СрокИзготовления убыв");
	СрокИзготовленияЗаказа = тСроки[0].СрокИзготовления;
	Если ВариантОтгрузки = 1 Тогда
		Для каждого стр из ТаблицаТоваров Цикл
			стр.СрокИзготовления = СрокИзготовленияЗаказа;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере(НастройкиПроизводства = Неопределено)  
	
	ДатаРасчета = ТекущаяДатаСеанса();
	// ----------------------------------------------------------
	Если ВоеннаяПродукция Тогда     
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	бит_СрокиИзготовленияВПиРиски.Номенклатура КАК Номенклатура,
		|	бит_СрокиИзготовленияВПиРиски.СрокБазовыйДни + бит_СрокиИзготовленияВПиРиски.РискУвеличенияСрокаДни КАК Срок
		|ИЗ
		|	РегистрСведений.бит_СрокиИзготовленияВПиРиски КАК бит_СрокиИзготовленияВПиРиски
		|ГДЕ
		|	бит_СрокиИзготовленияВПиРиски.Номенклатура В (&мНоменклатура)
		|	И бит_СрокиИзготовленияВПиРиски.ВоеннаяПродукция
		|");
		Запрос.УстановитьПараметр("мНоменклатура", ТаблицаТоваров.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
		Результат = Запрос.Выполнить().Выгрузить();
		Для каждого стр из ТаблицаТоваров Цикл
			СтрокаПоКлючу = Результат.Найти(стр.Номенклатура, "Номенклатура");
			Если СтрокаПоКлючу <> Неопределено Тогда
				стр.СрокИзготовления = НачалоДня(ДатаРасчета) + СтрокаПоКлючу.Срок * 86400;
			КонецЕсли;
		КонецЦикла;
		
	Иначе 
		// Создание заказа на производство
		Результат = Новый Структура("АдресТовары,Основание,Склад");
		СтруктураВозврата = АдресТовары();
		Результат.АдресТовары = СтруктураВозврата.АдресТовары;
		Результат.Основание = Объект.Ссылка;
		Результат.Склад = СтруктураВозврата.ОдинСклад;
		
		Док = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
		Док.Заполнить(Результат);
		Док.Дата = ТекущаяДатаСеанса(); 
		Док.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.КПроизводству;  
		Для каждого стр из Док.Продукция Цикл
			стр.ДатаПотребности = Док.Дата;
		КонецЦикла;
		
		Док.ДополнительныеСвойства.Вставить("бит_ПредварительныйРасчет", Истина); // чтобы статус заказа клиента не менялся в подписке при проведении заказа на производство
		
		Док.Записать(РежимЗаписиДокумента.Проведение);  
		ЗаказНаПроизводство = Док.Ссылка;   
		Документы.ЗаказНаПроизводство2_2.ПротоколРасчетаСтруктурыЗаказа(ЗаказНаПроизводство);
		// расчет динамического планирования	
		ПлюсПятьСекунд = ТекущаяДатаСеанса() + 20;                      
		Результат = Документы.ЗаказНаПроизводство2_2.ПротоколРасчетаСтруктурыЗаказа(ЗаказНаПроизводство);
		Пока Результат.Состояние <> 1 Или ТекущаяДатаСеанса() <= ПлюсПятьСекунд Цикл
			Результат = Документы.ЗаказНаПроизводство2_2.ПротоколРасчетаСтруктурыЗаказа(ЗаказНаПроизводство);
		КонецЦикла;
		//планировать
		НастройкиПроизводства = Обработки.ПланированиеГрафикаПроизводства2_2.НастройкиПланированияПредварительногоГрафика();
		НастройкиПроизводства.ЗаказНаПроизводство = Док.Ссылка;
		НастройкиПроизводства.ДинамическаяСтруктура = Истина;
		НастройкиПроизводства.ПланироватьГрафик = Истина;

	КонецЕсли;     
	
КонецПроцедуры   

&НаКлиенте
Процедура РасчетЗавершение(НастройкиРасчета, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ НастройкиРасчета = Неопределено Тогда
		
		Результат = ПланироватьГрафикВФоновомРежиме(НастройкиРасчета);
		ЗаполнитьРеквизитыФоновойОперации(Результат);
		
		Если Результат.ЗаданиеВыполнено Тогда
			ЗавершеноПланированиеГрафикаВФоновомРежиме();
		Иначе
			НачатьОжиданиеФоновойОперации();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыФоновойОперации(Результат)
	
	АдресХранилищаФоноваяОперация = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеФоновойОперации()
	
	ПодключитьОбработчикОжиданияФоновойОперации();
	ОткрытьФормуДлительнойОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбработчикОжиданияФоновойОперации()
	
	ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
	ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала = 1.2;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДлительнойОперации()
	
	ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
 	
	Попытка
		
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда
				
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				
				Если ТекущаяФоноваяОперация = ИмяФоновойОперацииПланированиеГрафика() Тогда
					ЗавершеноПланированиеГрафикаВФоновомРежиме();
				ИначеЕсли ТекущаяФоноваяОперация = ИмяФоновойОперацииСохранениеГрафика() Тогда
					ЗавершеноСохранениеГрафикаВФоновомРежиме();
				ИначеЕсли ТекущаяФоноваяОперация = ИмяФоновойОперацииУдалениеРезультатов() Тогда
					ЗавершеноУдалениеРезультатовПланированияВФоновомРежиме();
				КонецЕсли;
								
			Иначе
				
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания",
					ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФоновойОперацииСохранениеГрафика()
	
	Возврат "СохранениеГрафика";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФоновойОперацииУдалениеРезультатов()
	
	Возврат "УдалениеРезультатов";
	
КонецФункции
&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции
//----------------------------------------------------------------------------
&НаСервере
Функция АдресТовары()
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтрокиВДокументе,
		|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Значение(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
		|	Товары.Упаковка КАК Упаковка,
		|	Товары.Количество КАК КЗаказу,
		|	Товары.Склад КАК Склад,
		|	Товары.Подразделение КАК Подразделение,
		|	Товары.ДатаОтгрузки КАК ДатаОтгрузки
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК Товары
		|ГДЕ
		|	Товары.НомерСтроки в (&мНомеровСтрок)  
		|	И Товары.Ссылка = &ДокументСсылка
		|ИНДЕКСИРОВАТЬ ПО
		|   Номенклатура
		|;
		|
		|///////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.НомерСтрокиВДокументе КАК НомерСтрокиВДокументе,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	ЕСТЬNULL(СтавкиНДСНоменклатуры.СтавкаНДС, ЕСТЬNULL(ОсновныеСтавкиНДС.СтавкаНДС,
		|		ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка))) КАК СтавкаНДС,
		|	Товары.Назначение КАК Назначение,
		|	Товары.Упаковка КАК Упаковка,
		|	Товары.КЗаказу * ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) КАК Количество,
		|	Товары.КЗаказу КАК КоличествоУпаковок,
		|	Товары.Склад КАК Склад,
		|	Товары.Подразделение КАК Подразделение,
		|	Товары.ДатаОтгрузки КАК ДатаОтгрузки,
		|	ВЫБОР КОГДА Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ТОГДА
		|				Товары.Подразделение
		|			ИНАЧЕ
		|				Товары.Склад
		|		КОНЕЦ КАК Получатель,
		|	ВЫБОР КОГДА Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) ТОГДА
		|			ИСТИНА
		|		ИНАЧЕ
		|			ЛОЖЬ
		|		КОНЕЦ КАК СписатьНаРасходы
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ВсеУпаковки
		|		ПО ВсеУпаковки.Ссылка = Товары.Упаковка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНДСНоменклатуры.СрезПоследних(&Период,
		|			Страна = &СтранаРегистрации ИЛИ Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтавкиНДСНоменклатуры
		|		ПО СтавкиНДСНоменклатуры.Номенклатура = Товары.Номенклатура 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеСтавкиНДС.СрезПоследних(&Период, Страна = &СтранаРегистрации) КАК ОсновныеСтавкиНДС
		|		ПО ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтрокиВДокументе
		|;
		|
		|////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА МИНИМУМ(Товары.Склад) = МАКСИМУМ(Товары.Склад)
		|			ТОГДА МИНИМУМ(Товары.Склад)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|	КОНЕЦ КАК ОдинСклад
		|ИЗ
		|	Товары КАК Товары
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Товары.Склад) = ТИП(Справочник.Склады) И Товары.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"ВсеУпаковки.Ссылка",
		"Товары.Номенклатура"));
		
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Дата, Организация");
	Запрос.УстановитьПараметр("мНомеровСтрок", ТаблицаТоваров.Выгрузить(, "НомерСтроки").ВыгрузитьКолонку("НомерСтроки"));
	Запрос.УстановитьПараметр("ДокументСсылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СтранаРегистрации", ЗначениеНастроекКлиентСерверПовтИсп.СтранаРегистрацииОрганизации(ЗначенияРеквизитов.Организация));
	
	Результаты = Запрос.ВыполнитьПакет();
	тТоваров = Результаты[Результаты.ВГраница() - 1].Выгрузить();
	АдресТовары = ПоместитьВоВременноеХранилище(тТоваров);
	Выборка = Результаты[Результаты.ВГраница()].Выбрать();
	ОдинСклад = Справочники.Склады.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		ОдинСклад = Выборка.ОдинСклад;
	КонецЕсли;
	
	Возврат Новый Структура("АдресТовары,ОдинСклад", АдресТовары, ОдинСклад);
	
КонецФункции

