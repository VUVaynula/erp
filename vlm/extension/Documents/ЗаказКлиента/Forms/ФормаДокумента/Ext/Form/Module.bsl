&НаКлиенте
Процедура ПересчитатьИтогиВоеннаяПриемка()
	// {{ПервыйБИТ ЛистТребований [ЛТ 3.17]  [VUVaynula@1cbit.ru] [20.03.2025 17:32:51] +        
	ИтогИзготовлено = "";
	ИтогПроверено = "";                    
	Изготовлено = 0;
	Проверено = 0;
	
	Если Объект.бит_ВоеннаяПриемка Тогда
		
		Для Каждого стр Из Объект.Товары Цикл
			Если стр.бит_Изготовлено Тогда 
				Изготовлено = Изготовлено + 1;
			КонецЕсли;
			Если стр.бит_Проверено Тогда
				Проверено = Проверено + 1;
			КонецЕсли;
		КонецЦикла;	
		
		ВсегоСтрок = Объект.Товары.Количество(); 
		
		// Рассчитывается как отношение количества номенклатурных позиций с установленным признаком «Изготовлено» 
		// к общему количеству строк в табличной части.
		//  Формула: (Количество строк с признаком "Изготовлено" / Общее количество строк) * 100.
		ИтогИзготовлено = Окр((Изготовлено / ВсегоСтрок) * 100, 2);
		ИтогПроверено 	= Окр((Проверено   / ВсегоСтрок) * 100, 2);     
		
	КонецЕсли;  
	
	Элементы.бит_ТоварыИзготовлено.ТекстПодвала = ИтогИзготовлено; 
	Элементы.бит_ТоварыПроверено.ТекстПодвала = ИтогПроверено; 
	// }}ПервыйБИТ ЛистТребований [ЛТ 3.17]  [VUVaynula@1cbit.ru] [20.03.2025 17:32:51] -
КонецПроцедуры

