Процедура бит_РасчитатьВес(ТекущиеДанные)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	Если ТекущиеДанные <> Неопределено Тогда
		
		ВесНетто = бит_ПолучитьВесНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.Упаковка);
		ТекущиеДанные.бит_ВесНетто = ВесНетто * ТекущиеДанные.КоличествоУпаковок;
		
		// {{ПервыйБИТ ЛистТребований [исправление после сквозного]  [VUVaynula@1cbit.ru] [17.03.2026 9:03:19] +        
		Если ЗначениеЗаполнено(ТекущиеДанные.бит_Тара) Тогда
			ВесТары = бит_ПолучитьВесНоменклатуры(ТекущиеДанные.бит_Тара, ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.бит_Тара, "ЕдиницаИзмерения"));
		Иначе         
			ВесТары = 0;
		КонецЕсли;
		ТекущиеДанные.бит_ВесБрутто = ТекущиеДанные.бит_ВесНетто + ВесТары;
		// }}ПервыйБИТ ЛистТребований [исправление после сквозного]  [VUVaynula@1cbit.ru] [17.03.2026 9:03:19] -
	КонецЕсли;
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
