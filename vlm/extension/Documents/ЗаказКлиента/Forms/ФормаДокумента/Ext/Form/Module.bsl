&НаКлиенте
Процедура ПослеРасчетаСроковПроизводства(Результат, ДопПараметры) Экспорт
	// {{ПервыйБИТ ЛистТребований [3.1]  [VUVaynula@1cbit.ru] [22.05.2025 22:35:36] +        
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда                
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("НомерСтроки");
		Объект.бит_ОбщийСрокИзготовленияЗаказа = Дата("00010101");
		Для каждого стр из Результат Цикл
			СтруктураПоиска.НомерСтроки = стр.Ключ;
			СтрокаПоКлючу = Объект.Товары.НайтиСтроки(СтруктураПоиска);
			СтрокаПоКлючу[0].ДатаОтгрузки = стр.Значение; 
			СтрокаПоКлючу[0].бит_СрокИзготовления = СтрокаПоКлючу[0].ДатаОтгрузки;
			Объект.бит_ОбщийСрокИзготовленияЗаказа = Макс(Объект.бит_ОбщийСрокИзготовленияЗаказа, стр.Значение);
		КонецЦикла;   
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [3.1]  [VUVaynula@1cbit.ru] [22.05.2025 22:35:36] -
КонецПроцедуры

