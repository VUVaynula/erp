	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_бит_СменноеЗадание";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СменноеЗадание.ПФ_MXL_бит_СменноеЗадание");
	ОбластьШапка 	   = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаШапка = Макет.ПолучитьОбласть("СтрокаШапка");
	ОбластьПодвал	   = Макет.ПолучитьОбласть("Подвал");
	
	Первый = Истина;
	Для каждого ДокументСменноеЗадание Из МассивОбъектов Цикл
		
		Если ДокументСменноеЗадание.Статус = Перечисления.СтатусыСменныхЗаданий.Формируется Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ДокументСменноеЗадание + ": Печатная форма не предназначена для документа в статусе 'Формируется'", ДокументСменноеЗадание); 
			Продолжить;
		КонецЕсли;
		Если Первый Тогда
			Первый = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
