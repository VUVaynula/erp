&НаКлиенте
Процедура РассчитатьРаспределение(ТД)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.26]  [VUVaynula@1cbit.ru] [19.11.2025 22:46:52] +        
	РаспределениеГотовойПродукцииПоТаре.Очистить();  
	Структура = Новый Структура;
	Для Каждого стр Из Элементы.ВыходныеИзделия.ПодчиненныеЭлементы Цикл
		Имя = СтрЗаменить(стр.имя, "ВыходныеИзделия", "");
		Структура.Вставить(Имя, ТД[Имя]);
	КонецЦикла;
	РаспределитьНаСервере(Структура);
	// }}ПервыйБИТ ЛистТребований [ЛТ5.26]  [VUVaynula@1cbit.ru] [19.11.2025 22:46:52] -
КонецПроцедуры

&НаСервере
Процедура РаспределитьНаСервере(Структура)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.26]  [VUVaynula@1cbit.ru] [30.11.2025 13:41:10] +        
	Если Структура.Номенклатура.ВидНоменклатуры.ИспользоватьСерии = Ложь Тогда
		Возврат;
	КонецЕсли;                         
	РаспределениеГотовойПродукцииПоТаре.Очистить();
	
	КоличествоКРаспределению = Структура.Количество;
	// берем все серии из регистра по операции и номенклатуре
	Запрос = Новый Запрос("ВЫБРАТЬ
