&НаСервере
Функция СгенерироватьСерииДляЭтикетокНаСервере(Структура)
	 // Если в регистре сведений  "Серии этикеток в сменном задании" отсутствуют записи для выделенной производственной операции
	 // , то система генерирует новые серии номенклатуры по количеству этикеток из шага 3

	 // Если в регистре сведений  "Серии этикеток в сменном задании" присутствуют записи для выделенной производственной операции, 
	 // то в случае нехватки количества записей по рассчитанному количеству этикеток сгенерировать новые серии.

	 // Если в регистре сведений  "Серии этикеток в сменном задании" присутствуют записи для выделенной производственной операции 
	 // и их достаточно для указанного на шаге 3 количества этикеток, то генерация новых не производится.
	 
	 // сначала заменим нормативную массу во всех сериях произв.операции на новую
	 	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	бит_СерииЭтикетокВСменномЗадании.СерияНоменклатуры КАК Серия
	                      |ИЗ
	                      |	РегистрСведений.бит_СерииЭтикетокВСменномЗадании КАК бит_СерииЭтикетокВСменномЗадании
	                      |ГДЕ
	                      |	бит_СерииЭтикетокВСменномЗадании.ПроизводственнаяОперация В(&мДокументов)");
	Запрос.УстановитьПараметр("мДокументов", Структура.Операция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СерияОбъект = Выборка.Серия.ПолучитьОбъект();	
		СерияОбъект.бит_Завешено = Ложь;
		СерияОбъект.бит_НормативнаяМасса = Структура.МассаНеттоКГ;
		СерияОбъект.Записать();
	КонецЦикла;
	//-----------------------------
	 Запрос = Новый Запрос("ВЫБРАТЬ
	                       |	бит_СерииЭтикетокВСменномЗадании.ПроизводственнаяОперация КАК ПроизводственнаяОперация,
	                       |	бит_СерииЭтикетокВСменномЗадании.Номенклатура КАК Номенклатура,
	                       |	бит_СерииЭтикетокВСменномЗадании.СерияНоменклатуры КАК СерияНоменклатуры,
	                       |	бит_СерииЭтикетокВСменномЗадании.СерияНоменклатуры.Номер КАК СерияНоменклатурыНомер,
	                       |	бит_СерииЭтикетокВСменномЗадании.Напечатано КАК Напечатано
	                       |ИЗ
	                       |	РегистрСведений.бит_СерииЭтикетокВСменномЗадании КАК бит_СерииЭтикетокВСменномЗадании
	                       |ГДЕ
	                       |	бит_СерииЭтикетокВСменномЗадании.ПроизводственнаяОперация = &ПроизводственнаяОперация
	                       |	И бит_СерииЭтикетокВСменномЗадании.Номенклатура = &Номенклатура
	                       |
	                       |УПОРЯДОЧИТЬ ПО
	                       |	СерияНоменклатурыНомер");      
	 
	 Запрос.УстановитьПараметр("ПроизводственнаяОперация", Структура.Операция);
	 Запрос.УстановитьПараметр("Номенклатура", Структура.Номенклатура);
	 ТЗаписей = Запрос.Выполнить().Выгрузить();
	 НеобходимоСгенерировать = Структура.КоличествоЭтикеток - ТЗаписей.Количество();
	 Если НеобходимоСгенерировать > 0 Тогда
		 Если Структура.Номенклатура.ВидНоменклатуры.ИспользоватьСерии = Истина Тогда
			 Для сч = 1 по НеобходимоСгенерировать Цикл
				 // создадим серию
				 СерияОбъект = Справочники.СерииНоменклатуры.СоздатьЭлемент();        
				 ВладелецСерий = Структура.Номенклатура.ВидНоменклатуры;
				 Пока ЗначениеЗаполнено(ВладелецСерий.ВладелецСерий) Цикл
					 ВладелецСерий = ВладелецСерий.ВладелецСерий;
				 КонецЦикла;
				 СерияОбъект.ВидНоменклатуры = ВладелецСерий;
				 СерияОбъект.ДатаПроизводства = Объект.Дата;   
				 СерияОбъект.бит_Эмалировщик = Структура.Исполнитель;
				 СерияОбъект.бит_НормативнаяМасса = Структура.МассаНеттоКГ;
				 // {{ПервыйБИТ ЛистТребований [УПО12427]  [VUVaynula@1cbit.ru] [03.08.2026 1:10:58] +        
				 СерияОбъект.бит_ВидРабочегоЦентра  = Структура.Операция.ВидРабочегоЦентра;
				 СерияОбъект.бит_Смена				= Объект.Смена;
				 // }}ПервыйБИТ ЛистТребований [УПО12427]  [VUVaynula@1cbit.ru] [03.08.2026 1:10:58] -
				 МаксимальныйНомерИзСправочника = Справочники.СерииНоменклатуры.ВычислитьМаксимальныйНомерСерии( СерияОбъект.ВидНоменклатуры);
				 МаксимальныйНомерИзСправочника = МаксимальныйНомерИзСправочника + 1;
				 СерияОбъект.Номер = Формат(МаксимальныйНомерИзСправочника, "ЧЦ=8; ЧВН=; ЧГ=");
				 
				 СерияОбъект.бит_Штрихкод = СерияОбъект.Номер;
				 
				 СерияОбъект.Записать();
				 // добавим её в таблицу - это будет готовый набор записей для регистра
				 нов = тЗаписей.Добавить();
				 нов.ПроизводственнаяОперация = Структура.Операция;
				 нов.Номенклатура = Структура.Номенклатура;
				 нов.СерияНоменклатуры = СерияОбъект.Ссылка;
				 нов.Напечатано = Истина;
			 КонецЦикла;
			 
			 // Запишем в регистр
			 нз = РегистрыСведений.бит_СерииЭтикетокВСменномЗадании.СоздатьНаборЗаписей();
			 нз.Отбор.ПроизводственнаяОперация.Установить(Структура.Операция);
			 нз.Отбор.Номенклатура.Установить(Структура.Номенклатура);
			 нз.Прочитать();
			 нз.Загрузить(ТЗаписей);
			 нз.Записать();
			 
			 МассивСерий = ТЗаписей.ВыгрузитьКолонку("СерияНоменклатуры");
		 Иначе 
			 // серии не используются. заполним пустыми
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида номенклатуры серии не используются"); 
			 МассивСерий = Новый Массив;
			 Для сч = 1 По Структура.КоличествоЭтикеток Цикл
				 МассивСерий.Добавить(Справочники.СерииНоменклатуры.ПустаяСсылка());
			 КонецЦикла;
		 КонецЕсли;
	 Иначе             
		 // этикеток хватает возьмем столько 
		 МассивСерий = Новый Массив;
		 Для сч = 0 По Структура.КоличествоЭтикеток - 1 Цикл
			 МассивСерий.Добавить(ТЗаписей[сч].СерияНоменклатуры);
		 КонецЦикла;
	 КонецЕсли;
	 Если МассивСерий.Количество() = 0 Тогда 
		 Возврат Неопределено;
	 КонецЕсли;
	 
	 Структура.МассивСерий = МассивСерий;
	 
	 Адрес = РегистрыСведений.бит_СерииЭтикетокВСменномЗадании.СформироватьДанныеДляПечатиЭтикетокИзСменногоЗадания(Структура);
	 
	 Возврат Адрес;
	 
КонецФункции

