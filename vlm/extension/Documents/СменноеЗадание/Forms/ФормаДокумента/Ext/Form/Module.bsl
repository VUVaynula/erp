			МассивСтрок.Добавить(НСтр("ru = 'В статусе';
			|en = 'In the status'"));
			МассивСтрок.Добавить(" ");

			// Создана
			Содержимое = ?(Форма.ВСтатусеСоздана = 0, НСтр("ru = 'Создана';
			|en = 'Created'"),
