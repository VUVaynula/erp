&НаСервереБезКонтекста
Процедура СобратьДанныеПоПроизводственнойОперацииДляЭтикеток(Знач ПроизводственнаяОперация, Структура)
// {{ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [19.11.2025 15:50:54] +        
	Этап = ПроизводственнаяОперация.Этап;
	Спецификация = Этап.Спецификация;
	Номенклатура = Спецификация.ОсновноеИзделиеНоменклатура;            
	// -------------------
	СтрокиИзделия = ПроизводственнаяОперация.ВыходныеИзделия.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	КоличествоКИзготовлению = 0;
	Для каждого стр из СтрокиИзделия Цикл
		КоличествоКИзготовлению = КоличествоКИзготовлению + стр.Количество;
	КонецЦикла;
	// -------------------
	ВидРабочегоЦентра = ПроизводственнаяОперация.ВидРабочегоЦентра;  
	// -------------------
	ЭлементРазмерГотовойПродукции = Справочники.бит_ЗначенияПоУмолчанию.ПризнакРазмерГотовойПродукции;
	ПризнакРазмерГотовойПродукции = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(ЭлементРазмерГотовойПродукции, , Истина);
	
	Запрос = новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК Значение
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = &Номенклатура
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &Признак");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Признак", ПризнакРазмерГотовойПродукции);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РазмерГотовойПродукции = Выборка.Значение;
	Иначе                     
		РазмерГотовойПродукции = 0;
	КонецЕсли;
	// -------------------
	Тара = Номенклатура.бит_СтандартныйТипТары;
	// повторим процедуры из производственной операции, т.к. все вычисляется на лету на форме
	Если ЗначениеЗаполнено(Этап) Тогда 
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ КАК НазначениеЗаказ
	                      |ИЗ
	                      |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	                      |ГДЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = &Этап
	                      |	И ЭтапПроизводства2_2ВыходныеИзделия.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)"); 
		Запрос.УстановитьПараметр("Этап", Этап);
		Результат = Запрос.Выполнить().Выбрать();
	    Если Результат.Количество() = 1 Тогда 
			Результат.Следующий();
			Заказ = Результат.НазначениеЗаказ;
			Если ЗначениеЗаполнено(Заказ) И ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда        
				СтрокаЗаказа = Заказ.Товары.Найти(Номенклатура, "Номенклатура");
				Если СтрокаЗаказа <> Неопределено Тогда
					Тара = СтрокаЗаказа.бит_Тара;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-------МассаНеттоКГ-------------
	МассаНеттоКГ = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_СерииЭтикетокВСменномЗадании.СерияНоменклатуры.бит_НормативнаяМасса КАК МассаНеттоКГ
	                      |ИЗ
	                      |	РегистрСведений.бит_СерииЭтикетокВСменномЗадании КАК бит_СерииЭтикетокВСменномЗадании
	                      |ГДЕ
	                      |	бит_СерииЭтикетокВСменномЗадании.ПроизводственнаяОперация = &ПроизводственнаяОперация
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_СерииЭтикетокВСменномЗадании.СерияНоменклатуры) КАК КоличествоСерий
	                      |ИЗ
	                      |	РегистрСведений.бит_СерииЭтикетокВСменномЗадании КАК бит_СерииЭтикетокВСменномЗадании
	                      |ГДЕ
	                      |	бит_СерииЭтикетокВСменномЗадании.ПроизводственнаяОперация = &ПроизводственнаяОперация");
	Запрос.УстановитьПараметр("ПроизводственнаяОперация", ПроизводственнаяОперация);
	Результат = Запрос.ВыполнитьПакет();
	Выборка = Результат[0].Выбрать();
	Если Выборка.Следующий() Тогда
		МассаНеттоКГ = Выборка.МассаНеттоКГ;
	Иначе
