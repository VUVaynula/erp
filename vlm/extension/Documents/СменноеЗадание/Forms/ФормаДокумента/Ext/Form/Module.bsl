		Элементы["бит_СтраницаПростоиЗаСмену"].Видимость = НЕ ОперацииИзРегистра; 
		
		#КонецВставки // }}ПервыйБИТ ЛистТребований [УчетОтходов] [ASHolyavko@1cbit.ru] [11.08.2026] -
			
	КонецЕсли;

	Если СтруктураРеквизитов.Свойство("Статус")
