&НаСервере
Функция ПолучитьСписокВРЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизводственнаяОперация2_2.ВидРабочегоЦентра КАК ВидРабочегоЦентра
		|ИЗ
		|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация2_2
		|ГДЕ
		|	ПроизводственнаяОперация2_2.СменноеЗадание = &СменноеЗадание
		|
		|СГРУППИРОВАТЬ ПО
		|	ПроизводственнаяОперация2_2.ВидРабочегоЦентра";
	
	Запрос.УстановитьПараметр("СменноеЗадание", Объект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидРабочегоЦентра");
	
