			МассивСтрок.Добавить(КомандаОтбор);

			МассивСтрок.Добавить(", ");

			// Пропущена
			Содержимое = ?(Форма.ВСтатусеПропущена = 0, НСтр("ru = 'Пропущена';
			|en = 'Skipped'"),
