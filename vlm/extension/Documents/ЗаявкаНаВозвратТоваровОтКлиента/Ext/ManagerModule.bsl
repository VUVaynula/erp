Процедура ЗаполнитьДанныеЗаполненияАктСрезки(Документ, ДанныеЗаполнения)
	
	Запрос = новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	бит_НумерацияАктовСрезаСрезПоследних.НомерАкта КАК НомерАкта
	                      |ИЗ
	                      |	РегистрСведений.бит_НумерацияАктовСреза.СрезПоследних(, Документ = &Документ) КАК бит_НумерацияАктовСрезаСрезПоследних");
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Номер = Выборка.НомерАкта;
	Иначе
		Номер = "_______";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ.бит_ДатаСоставленияАкта) Тогда
		Дата = Формат(Документ.бит_ДатаСоставленияАкта, "ДФ='''""''dd''""'' MMMM yyyy ''г'''");
	Иначе      
		Дата = "'__' ___________ 20___ г.";
	КонецЕсли;
		
	ДанныеЗаполнения.Вставить("Номер", Номер); 
	ДанныеЗаполнения.Вставить("Дата", Дата);
	Причина = "" + Символы.Таб + "На основании акта анализа №" + Документ.Номер + " " + Документ.Контрагент.Наименование + " от " 
				+ Формат(Документ.бит_ДатаСоставленияАкта,"ДФ=dd.MM.yyyy") 
				+ " ниже перечисленный эмальпровод является окончательным браком и подлежит срезке";
	ДанныеЗаполнения.Вставить("Причина", Причина);  
	
	СдалиВОтходы = "";
    СдалиНаСклад = "";                                             
	Разделитель = Символы.ПС;
    СдалиНаСкладСдалиВотходы(Документ, СдалиВОтходы, СдалиНаСклад, Разделитель);
	
	ДанныеЗаполнения.Вставить("Маркоразмеры", СдалиВОтходы);
	ДанныеЗаполнения.Вставить("ИнженерТехнолог",   Документ.бит_ИнженерТехнолог); 
	ДанныеЗаполнения.Вставить("МастерКонтрольный", Документ.бит_МастерКонтрольный); 
	
КонецПроцедуры 

#КонецОбласти

Процедура СдалиНаСкладСдалиВотходы(Знач Документ, СдалиВОтходы, СдалиНаСклад, РазделительСтрок = Неопределено)
	
	Если РазделительСтрок = Неопределено Тогда
		РазделительСтрок = ";";
	КонецЕсли;
	
	СдалиНаСклад = ""; 
	СдалиВОтходы = "";
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, бит_ФактическиСданоНаСкладКг, бит_ОкончательныйБракКг, бит_ФактическийТипТары");
	тВозвращаемыеТовары.Свернуть("Номенклатура, бит_ФактическийТипТары", "бит_ФактическиСданоНаСкладКг, бит_ОкончательныйБракКг");
	ШаблонСклад = "[Номенклатура] в количестве [бит_ФактическиСданоНаСкладКг] кг";
	ШаблонОтходы = "[Номенклатура] в количестве [бит_ОкончательныйБракКг] кг";
	Для Каждого стр из тВозвращаемыеТовары Цикл  
		РазделительСклад  = ?(СдалиНаСклад = "", "", "" + РазделительСтрок + " "); 
		РазделительОтходы = ?(СдалиВОтходы = "", "", "" + РазделительСтрок + " "); 
		
		ТекСтруктура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(стр);
		
		Если стр.бит_ФактическиСданоНаСкладКг > 0 Тогда 
			ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонСклад, ТекСтруктура);
			СдалиНаСклад = СдалиНаСклад + РазделительСклад + ТекущаяСтрока;	
		КонецЕсли;
		ТекущаяСтрока = "";
		Если стр.бит_ОкончательныйБракКг > 0 Тогда  
			ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОтходы, ТекСтруктура);
			СдалиВОтходы = СдалиВОтходы + РазделительОтходы + ТекущаяСтрока;	
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьГородКонтрагента(Знач Документ)
	
	Город = "";
	КонтактнаяИнформация = Документ.Контрагент.КонтактнаяИнформация.Выгрузить();
	Если КонтактнаяИнформация <> Неопределено И КонтактнаяИнформация.Количество() > 0 Тогда
		Инд = 0;
		Пока Инд < КонтактнаяИнформация.Количество() Цикл
			Если КонтактнаяИнформация[Инд].Вид.ИмяПредопределенныхДанных = "ЮрАдресКонтрагента" Тогда
				Если ЗначениеЗаполнено(КонтактнаяИнформация[Инд].Город) Тогда
					Город = КонтактнаяИнформация[Инд].Город;
					Город = ?(Лев(Город, 1) = "г", Город, "г. " + Город);
				КонецЕсли;
			КонецЕсли;
			Инд = Инд+1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Город;

