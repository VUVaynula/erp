Процедура ЗаполнитьДанныеЗаполненияОтветНаПретензию(Документ, ДанныеЗаполнения) 
	
	ДанныеЗаполнения.Вставить("ДатаИсходящего", Формат(Документ.бит_ДатаИсходящего, "ДФ=dd.MM.yyyy"));
	ДанныеЗаполнения.Вставить("НомерИсходящего", Документ.бит_НомерИсходящего);
	ДанныеЗаполнения.Вставить("НомерВходящего", Документ.бит_НомерВходящего);
	ДанныеЗаполнения.Вставить("ДатаВходящего", Формат(Документ.бит_ДатаВходящего, "ДФ=dd.MM.yyyy"));
	Если ЗначениеЗаполнено(Документ.КонтактноеЛицо.ДолжностьПоВизитке) Тогда
		ДолжностьПоВизиткеДатПадеж = ПолучитьСклоненияСтроки(СокрЛП(Документ.КонтактноеЛицо.ДолжностьПоВизитке),, "ПД=Дательный")[0];   
	Иначе                            
		ДолжностьПоВизиткеДатПадеж = "________________";
	КонецЕсли;	
	ДанныеЗаполнения.Вставить("ДолжностьПоВизиткеДатПадеж", ДолжностьПоВизиткеДатПадеж);

	ДанныеЗаполнения.Вставить("Контрагент", Документ.Контрагент.Наименование);        
	
	ФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Документ.КонтактноеЛицо.Наименование);
	Если ЗначениеЗаполнено(ФИО) Тогда
		ФИОДП = ПолучитьСклоненияСтроки(СокрЛП(ФИО),, "ПД=Дательный")[0];
	Иначе
		ФИОДП = "________________";
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("КонтЛицоДатПадеж", ФИОДП); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК Номенклатура,
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК Значение
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура В(&мНоменклатура)
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &ПризнакГост
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура,
	                      |	бит_ЗначенияПризнаковНоменклатуры.бит_Значение
	                      |ИЗ
	                      |	РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
	                      |ГДЕ
	                      |	НЕ бит_ЗначенияПризнаковНоменклатуры.бит_ПризнакСертификации
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура В(&мНоменклатура)
	                      |	И бит_ЗначенияПризнаковНоменклатуры.бит_Признак = &ПризнакГост");  
	Запрос.УстановитьПараметр("мНоменклатура", Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	ПризнакГост = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПризнакГОСТ, Документ, Истина);
	//.Значение; 
	//Если Не ЗначениеЗаполнено(ПризнакГост) Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить признак ГОСТ в значениях по умолчанию", Справочники.бит_ЗначенияПоУмолчанию.ПризнакГОСТ);
	//КонецЕсли;
	Запрос.УстановитьПараметр("ПризнакГост", ПризнакГост);
	тГОСТ = Запрос.Выполнить().Выгрузить();   
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, Количество");
	тВозвращаемыеТовары.Свернуть("Номенклатура", "Количество");
	НоменклатураГОСТКоличество = "";
	Шаблон = "[Номенклатура] [ГОСТ] в количестве [Количество] [ЕдИзм]";
	Для каждого стр из тВозвращаемыеТовары Цикл    
		Разделитель = ?(НоменклатураГОСТКоличество = "", "", ", "); 
		
		ТекСтруктура = Новый Структура;
		ТекСтруктура.Вставить("Номенклатура", стр.Номенклатура);
		ТекСтруктура.Вставить("Количество"	, стр.Количество);
		ТекСтруктура.Вставить("ЕдИзм"		, стр.Номенклатура.ЕдиницаИзмерения);
		
		строкаГОСТ = тГОСТ.Найти(стр.Номенклатура, "Номенклатура");  
		Если строкаГОСТ = Неопределено Тогда
			ГОСТ = "";
		Иначе
			ГОСТ = строкаГОСТ.Значение;
		КонецЕсли;
		ТекСтруктура.Вставить("ГОСТ", ГОСТ);
		
		ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ТекСтруктура);
		НоменклатураГОСТКоличество = НоменклатураГОСТКоличество + Разделитель + ТекущаяСтрока;
	КонецЦикла;
	ДанныеЗаполнения.Вставить("НоменклатураГОСТКоличество", НоменклатураГОСТКоличество);
	
КонецПроцедуры 

