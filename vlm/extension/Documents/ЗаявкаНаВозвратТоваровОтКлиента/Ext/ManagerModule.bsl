Функция НапечататьОфисныйДокумент(МассивОбъектов, Идентификатор) 
	// {{ПервыйБИТ ЛистТребований [ЛТ9.3]  [VUVaynula@1cbit.ru] [26.07.2025 23:07:31] +        
	ОфисныеДокументы = Новый Соответствие;
	
    Шаблон = "[Организация] - [Контрагент] [НазваниеДокумента] №[Номер] от [Дата]";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов, "Организация, Контрагент, Номер, Дата, Ссылка");
	
    Для Каждого Ссылка Из МассивОбъектов Цикл
		
		Если Идентификатор = "бит_АктАнализа" Тогда
			НазваниеДокумента = "Акт анализа";
			АдресДокумента = СформироватьАктАнализа(Ссылка);
		ИначеЕсли Идентификатор = "бит_ОтветНаПретензию" Тогда
			НазваниеДокумента = "Ответ на претензию";
			АдресДокумента = СформироватьОтветНаПретензию(Ссылка);
		ИначеЕсли Идентификатор = "бит_СлужебнаяЗаписка" Тогда
			НазваниеДокумента = "Служебная записка";
			АдресДокумента = СформироватьСлужебнаяЗаписка(Ссылка);
		ИначеЕсли Идентификатор = "бит_АктСрезки" Тогда
			НазваниеДокумента = "Акт срезки";
			АдресДокумента = СформироватьАктСрезки(Ссылка);
		КонецЕсли;
		
		РеквизитыДокумента = ЗначенияРеквизитов[Ссылка];
		РеквизитыДокумента.Дата = Формат(РеквизитыДокумента.Дата, "ДФ=dd.MM.yyyy");
		РеквизитыДокумента.Вставить("НазваниеДокумента", НазваниеДокумента);
		ИмяДокумента = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, РеквизитыДокумента) + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=ddMMyyyyhhmmss");
		ОфисныеДокументы.Вставить(АдресДокумента, ИмяДокумента);
	КонецЦикла;
	
	Возврат ОфисныеДокументы;
	// }}ПервыйБИТ ЛистТребований [ЛТ9.3]  [VUVaynula@1cbit.ru] [26.07.2025 23:07:31] -
