		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "бит_АктАнализа");
		Если ПечатнаяФорма <> Неопределено Тогда           
			ОфисныеДокументы = НапечататьОфисныйДокумент(МассивОбъектов, "бит_АктАнализа");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
			ПечатнаяФорма.СинонимМакета = "(бит) Акт анализа";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "бит_ОтветНаПретензию") Тогда
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "бит_ОтветНаПретензию");
		Если ПечатнаяФорма <> Неопределено Тогда           
			ОфисныеДокументы = НапечататьОфисныйДокумент(МассивОбъектов, "бит_ОтветНаПретензию");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
			ПечатнаяФорма.СинонимМакета = "(бит) Ответ на претензию";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "бит_СлужебнаяЗаписка") Тогда
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "бит_СлужебнаяЗаписка");
		Если ПечатнаяФорма <> Неопределено Тогда           
			ОфисныеДокументы = НапечататьОфисныйДокумент(МассивОбъектов, "бит_СлужебнаяЗаписка");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
			ПечатнаяФорма.СинонимМакета = "(бит) Служебная записка";
		КонецЕсли;
		Возврат;
	КонецЕсли;
