Процедура ЗаполнитьДанныеЗаполненияСлужебнаяЗаписка(Документ, ДанныеЗаполнения)

	ДанныеЗаполнения.Вставить("Организация", Документ.Организация);
	ДанныеЗаполнения.Вставить("ТекущаяДата", Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy")); 
	ДанныеЗаполнения.Вставить("НомерДокумента", Документ.Номер);
	ДанныеЗаполнения.Вставить("Контрагент", Документ.Контрагент);
	ДанныеЗаполнения.Вставить("ГородКонтрагента", ПолучитьГородКонтрагента(Документ)); 
	ДанныеЗаполнения.Вставить("ВидДокумента", Документ.бит_ВидДокумента);
	ДанныеЗаполнения.Вставить("НомерВх", Документ.бит_НомерВходящего);
	ДанныеЗаполнения.Вставить("ДатаВх", Формат(Документ.бит_ДатаВходящего,"ДФ=dd.MM.yyyy"));  
	
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, КоличествоУпаковок, Упаковка, бит_ФактическиВозвращеноКг, бит_КоличествоТары, бит_ТипТары");
	тВозвращаемыеТовары.Свернуть("Номенклатура, Упаковка, бит_ТипТары", "КоличествоУпаковок, бит_ФактическиВозвращеноКг, бит_КоличествоТары");
	Провод = "";
	Шаблон = "[Номенклатура] в количестве [КоличествоУпаковок] (фактически возвращено – [бит_ФактическиВозвращеноКг])";
	Для каждого стр из тВозвращаемыеТовары Цикл
		Разделитель = ?(Провод = "", "", "; "); 
		ТекСтруктура = Новый Структура;
		ТекСтруктура.Вставить("Номенклатура", стр.Номенклатура);
		ТекСтруктура.Вставить("КоличествоУпаковок", "" + стр.КоличествоУпаковок + " " + ?(ЗначениеЗаполнено(стр.Упаковка), стр.Упаковка, стр.Номенклатура.ЕдиницаИзмерения));
		
		Тара = СокрЛП("" + стр.бит_КоличествоТары + " " + стр.бит_ТипТары); 
		бит_ФактическиВозвращеноКг = "" + стр.бит_ФактическиВозвращеноКг + " кг" + ?(ЗначениеЗаполнено(Тара), ", " + Тара + ")", "");
		ТекСтруктура.Вставить("бит_ФактическиВозвращеноКг", бит_ФактическиВозвращеноКг);
		
		ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ТекСтруктура);
		Провод = Провод + Разделитель + ТекущаяСтрока;
	КонецЦикла;
	ДанныеЗаполнения.Вставить("Провод", Провод);
	ДанныеЗаполнения.Вставить("Дефект", Документ.бит_НаименованиеДефекта);  
	
	//ДатаПоступления = Дата("00010101");
	//Для каждого стр из Документ.ВозвращаемыеТовары Цикл
	//	ДатаПоступления = Макс(ДатаПоступления, стр.ДатаПоступления);  
	//КонецЦикла;
	//ДанныеЗаполнения.Вставить("ДатаВозврата", Формат(ДатаПоступления, "ДФ=dd.MM.yyyy"));
	ДанныеЗаполнения.Вставить("ДатаВозврата", Формат(Документ.бит_ДатаПоступления, "ДФ=dd.MM.yyyy"));

	Если Документ.бит_НарушенияПриТранспортировкеВозврата = Перечисления.бит_ДаНет.Да Тогда
		Нарушения = "Нарушения транспортировки при возврате продукции есть";
	Иначе
		Нарушения = "Нарушений транспортировки при возврате продукции нет";
	КонецЕсли;                 
	ДанныеЗаполнения.Вставить("НарушенияТранспортировки", Нарушения);
	
	ДанныеЗаполнения.Вставить("МестоОбнаруженияДефекта", НРег(Документ.бит_МестоОбнаруженияДефекта));
	
	СменаДата = "";
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "бит_Смена, бит_ДатаИзготовления");
	тВозвращаемыеТовары.Свернуть("бит_Смена, бит_ДатаИзготовления");
	Для Каждого стр Из тВозвращаемыеТовары Цикл
		Разделитель = ?(СменаДата = "", "", "; ");	
		СменаДата = СменаДата + Разделитель + стр.бит_Смена + "/" + Формат(стр.бит_ДатаИзготовления,"ДФ=dd.MM.yyyy");
	КонецЦикла;
	ДанныеЗаполнения.Вставить("СменаДата", СменаДата);
	
	ДанныеЗаполнения.Вставить("ПризнаниеРекламации", Документ.бит_ПризнаниеРекламации); 
	ДанныеЗаполнения.Вставить("ЗаключениеКомиссии", Документ.бит_ЗаключениеКомиссии); 
	ДанныеЗаполнения.Вставить("МероприятияПоПредупреждениюДефекта", Документ.бит_МероприятияПоПредупреждениюДефекта); 
	
	СдалиВОтходы = "";
    СдалиНаСклад = "";
    СдалиНаСкладСдалиВотходы(Документ, СдалиВОтходы, СдалиНаСклад);
	ДанныеЗаполнения.Вставить("СдалиНаСкладВКоличествеЕдИзм", СдалиНаСклад);
	ДанныеЗаполнения.Вставить("СдалиВОтходыВКоличествеЕдИзм", СдалиВОтходы); 
	
	ДанныеЗаполнения.Вставить("АктАнализа", "Акт анализа №" + Документ.Номер + "/" + Формат(Документ.Дата, "ДФ=yy") + " от " + Формат(Документ.бит_ДатаСоставленияАкта, "ДФ=dd.MM.yyyy"));
	
	
