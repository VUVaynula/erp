Процедура ЗаполнитьДанныеЗаполненияАктАнализа(Документ, ДанныеЗаполнения) 
	
	//ДанныеЗаполнения = Новый Структура;
	//-------------------------
	ДатаСоставленияАктаСтрокой = Формат(Документ.бит_ДатаСоставленияАкта, "ДФ='""«""dd""»"" MMMM yyyy ""г.""'"); 
	ДанныеЗаполнения.Вставить("ДатаАкт1", ДатаСоставленияАктаСтрокой);
	ДанныеЗаполнения.Вставить("НомерАкт", Документ.Номер);
	ДанныеЗаполнения.Вставить("ГодАкт"  , Формат(Документ.бит_ДатаСоставленияАкта, "ДФ=yy"));
	ДанныеЗаполнения.Вставить("ДатаАкт2", ДатаСоставленияАктаСтрокой);     
	
	Город = ПолучитьГородКонтрагента(Документ);

	ДанныеЗаполнения.Вставить("ОрганизацияГород", Документ.Контрагент.Наименование + " " + Город); 
	
	ДанныеЗаполнения.Вставить("СписокДокументов", "" + Документ.бит_ВидДокумента + " №" + Документ.бит_НомерВходящего + " " + Формат(Документ.бит_ДатаВходящего, "ДФ=dd.MM.yyyy"));
	
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура");
	тВозвращаемыеТовары.Свернуть("Номенклатура");
	ДанныеЗаполнения.Вставить("МаркаПродукции", СтрСоединить(тВозвращаемыеТовары.ВыгрузитьКолонку("Номенклатура"), ","));
	
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, бит_ФактическиВозвращеноКг, бит_ТипТары, бит_КоличествоТары");
	тВозвращаемыеТовары.Свернуть("Номенклатура, бит_ТипТары", "бит_КоличествоТары, бит_ФактическиВозвращеноКг");
	ВозвратПродукции = "";
	Для Каждого стр из тВозвращаемыеТовары Цикл  
		Разделитель = ?(ВозвратПродукции = "", "", "; ");     
		КоличествоТара = "" + стр.бит_КоличествоТары + " " + стр.бит_ТипТары;
		Если ЗначениеЗаполнено(СокрЛП(КоличествоТара)) Тогда
			КоличествоТара = " (" + КоличествоТара + ")";
		Иначе             
			КоличествоТара = "";
		КонецЕсли;
		ТекущаяСтрока = "" + стр.Номенклатура + " - " + стр.бит_ФактическиВозвращеноКг + " кг " + КоличествоТара;
		ВозвратПродукции = ВозвратПродукции + Разделитель + ТекущаяСтрока;
	КонецЦикла;                
	ДанныеЗаполнения.Вставить("ВозвратПродукции", ВозвратПродукции);
	
	ДатаИзготовления = "";
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, бит_Машина, бит_Ход, бит_Смена, бит_ДатаИзготовления");   
	тВозвращаемыеТовары.Свернуть("Номенклатура, бит_Машина, бит_Ход, бит_Смена, бит_ДатаИзготовления");
	Шаблон = "[Номенклатура], [бит_Машина]/[бит_Ход], от [бит_Смена]/[бит_ДатаИзготовления]";
	Для каждого стр из тВозвращаемыеТовары Цикл     
		Разделитель = ?(ДатаИзготовления = "", "", "; ");     
		ТекСтруктура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(стр);
		ТекСтруктура.бит_ДатаИзготовления = Формат(ТекСтруктура.бит_ДатаИзготовления, "ДФ=dd.MM.yyyy");
		ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ТекСтруктура);
		ДатаИзготовления = "" + ДатаИзготовления + Разделитель + ТекущаяСтрока;
	КонецЦикла;
	ДанныеЗаполнения.Вставить("ДатаИзготовления", ДатаИзготовления);

	ДанныеЗаполнения.Вставить("МестоОбнаружения", НРег(Документ.бит_МестоОбнаруженияДефекта));
	
	СписокНесоответствий = "";
	тВозвращаемыеТовары = Документ.ВозвращаемыеТовары.Выгрузить(, "Номенклатура, бит_НесоответствиеПоПретензии");
	тВозвращаемыеТовары.Свернуть("Номенклатура, бит_НесоответствиеПоПретензии");   
	Шаблон = "[Номенклатура] - [бит_НесоответствиеПоПретензии]";
	Для каждого стр из тВозвращаемыеТовары Цикл
		Разделитель = ?(СписокНесоответствий = "", "", "; ");  
		ТекСтруктура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(стр);
		ТекущаяСтрока = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ТекСтруктура);
		СписокНесоответствий = СписокНесоответствий + Разделитель + ТекущаяСтрока;
	КонецЦикла;
	ДанныеЗаполнения.Вставить("СписокНесоответствий", СписокНесоответствий);
	
	//ДатаВозврата = Дата("00010101");
	//Для Каждого стр из Документ.ВозвращаемыеТовары Цикл 
	//	ДатаВозврата = Макс(ДатаВозврата, стр.ДатаПоступления);
	//КонецЦикла;                
	//ДанныеЗаполнения.Вставить("ДатаВозврата", Формат(ДатаВозврата, "ДФ=dd.MM.yyyy"));
	ДанныеЗаполнения.Вставить("ДатаВозврата", Формат(Документ.бит_ДатаПоступления, "ДФ=dd.MM.yyyy"));

	Если Документ.бит_НарушенияПриТранспортировкеВозврата = Перечисления.бит_ДаНет.Да Тогда
		Нарушения = "Нарушения транспортировки при возврате продукции есть";
	Иначе
		Нарушения = "Нарушений транспортировки при возврате продукции нет";
	КонецЕсли;                 
	ДанныеЗаполнения.Вставить("Нарушения", Нарушения);

	ДанныеЗаполнения.Вставить("МестоОбнаруж", НРег(Документ.бит_МестоОбнаруженияДефекта));
	ДанныеЗаполнения.Вставить("НаименваниеДефекта", Документ.бит_НаименованиеДефекта);
	ДанныеЗаполнения.Вставить("ПричинаДефекта", Документ.бит_ПричинаДефекта);
	
	тВиновники = Документ.бит_Виновники.Выгрузить(, "ФИО");
	тВиновники.Свернуть("ФИО");   
	ДанныеЗаполнения.Вставить("Виновники", СтрСоединить(тВиновники.ВыгрузитьКолонку("ФИО"), ", "));
	
	СдалиВОтходы = "";
    СдалиНаСклад = "";
    СдалиНаСкладСдалиВотходы(Документ, СдалиВОтходы, СдалиНаСклад);
              
	ДанныеЗаполнения.Вставить("СдалиНаСклад", СдалиНаСклад);
