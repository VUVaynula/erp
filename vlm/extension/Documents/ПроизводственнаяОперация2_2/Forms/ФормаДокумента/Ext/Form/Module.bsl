&НаКлиенте
Процедура бит_СтатусПриИзмененииПосле(Элемент)
	
	// {{ПервыйБИТ ЛистТребований [ЛТ5.11] [ASHolyavko@1cbit.ru] [19.08.2025] +        
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.Выполнена")
		ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.НеВыполнена") Тогда
		
		Элементы["бит_Выполнено100ПроцентовВыпуска"].Доступность = Истина;
		Элементы["бит_Выполнено100ПроцентовВремени"].Доступность = Истина;
		
	Иначе
		
		Элементы["бит_Выполнено100ПроцентовВыпуска"].Доступность = Ложь;
		Элементы["бит_Выполнено100ПроцентовВремени"].Доступность = Ложь;
		
	КонецЕсли;
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.Выполнена") Тогда 
		//И ПолучитьРеквизитСсылкиОбъекта("Статус") <> ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.Выполнена") Тогда
		
		РасчитатьПроцентВыполнениеПоВыпуску();
		РасчитатьПроцентВыполнениеПоВремени();
		
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.НеВыполнена") Тогда
		
		// 4.При установке статуса документа "Не выполнена" устанавливать значение реквизитов 
		// "(бит)Выполнение по времени, %" =0 и "(бит)Выполнение по выпуску, %" = 0
		Объект.бит_ВыполнениеПоВремениПроцент = 0;
		Объект.бит_ВыполнениеПоВыпускуПроцент = 0;
		
	ИначеЕсли Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.Выполнена")
		И Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыПроизводственныхОпераций.НеВыполнена") Тогда 
		//И ПолучитьРеквизитСсылкиОбъекта("Статус") <> Объект.Статус Тогда	
			
		//5. При установке любых других статусов документа, кроме "Выполнена" и "Не выполнена", требуется производить очистку реквизитов (если они заполнены):
		//	
		//	(бит)"Выполнение по выпуску, %"
		//	(бит)"Выполнение по времени, %"
		//	(бит)Причина занижения нормы выпуска
		//	(бит)Причина занижения нормы времени
		//	(бит)Выполнено 100% выпуска
		//	(бит)Выполнено 100% времени	
		
		Объект.бит_ВыполнениеПоВыпускуПроцент = Неопределено;
		Объект.бит_ВыполнениеПоВремениПроцент = Неопределено;
