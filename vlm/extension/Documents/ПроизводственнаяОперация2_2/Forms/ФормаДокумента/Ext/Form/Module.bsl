&НаСервере
Функция Заполнить_бит_КомментарийЗаказаКлиента(ПерезаполнятьКомментарий = Истина)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.29]  [VUVaynula@1cbit.ru] [13.08.2025 22:37:41] +        
	Если Не ЗначениеЗаполнено(Объект.Этап) // нет этапа - нет назначения
		//Или ЗначениеЗаполнено(Объект.Этап.Этап) // если у этапа заполнен этап значит он в иерархии. значит ничего не заполняем. "
		Тогда 
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Назначение.Заказ КАК НазначениеЗаказ
	                      |ИЗ
	                      |	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	                      |ГДЕ
	                      |	ЭтапПроизводства2_2ВыходныеИзделия.Ссылка = &Этап
	                      |	И ЭтапПроизводства2_2ВыходныеИзделия.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)"); 
	Запрос.УстановитьПараметр("Этап", Объект.Этап);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Количество() = 1 Тогда 
		Результат.Следующий();
		Заказ = Результат.НазначениеЗаказ; 
		//ЭтаФорма.бит_ЗаказКлиента = Заказ;
		Если ЗначениеЗаполнено(Заказ) И ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказКлиента") И ПерезаполнятьКомментарий Тогда
			ЭтаФорма.бит_КомментарийЗаказаКлиента = Заказ.Комментарий;
		КонецЕсли;
	КонецЕсли;
	Возврат Заказ;
	// }}ПервыйБИТ ЛистТребований [ЛТ5.29]  [VUVaynula@1cbit.ru] [13.08.2025 22:37:41] -
КонецФункции

