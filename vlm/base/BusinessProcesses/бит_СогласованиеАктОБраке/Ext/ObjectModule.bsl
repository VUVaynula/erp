#Область СлужебныеПроцедурыИФункции  

Процедура ЗаполнитьДокументПоОтбору(Знач ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.Свойство("Предмет") Тогда
		
		ТипПредмета = ТипЗнч(ДанныеЗаполнения.Предмет);
		
		Если ТипПредмета = Тип("ДокументСсылка.бит_АктОБраке") Тогда
			ЗаполнитьБизнесПроцессНаОснованиибит_АктОБраке(ДанныеЗаполнения.Предмет);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьБизнесПроцессНаОснованиибит_АктОБраке(ДокументОснование)
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	бит_АктОБраке.Ссылка           КАК Предмет,
		|	бит_АктОБраке.Дата КАК ДатаСогласования,
		|   ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиЗадачи.Обычная) КАК Важность, 
		|	бит_АктОБраке.бит_Статус           КАК Статус,
		|	НЕ бит_АктОБраке.Проведен      КАК ЕстьОшибкиПроведен,
		|	ЛОЖЬ КАК ЕстьОшибкиСтатус
       	|ИЗ
		|	Документ.бит_АктОБраке КАК бит_АктОБраке
		|ГДЕ
		|	бит_АктОБраке.Ссылка = &ДокументОснование
		|");
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	МассивДопустимыхСтатусов = Новый Массив();
	МассивДопустимыхСтатусов.Добавить(Перечисления.бит_СтатусыОБраке.АктСформированСК);
	
	ОбщегоНазначенияУТ.ПроверитьВозможностьВводаНаОсновании(
		Выборка.Предмет,
		Выборка.Статус,
		Выборка.ЕстьОшибкиПроведен,
		Выборка.ЕстьОшибкиСтатус,
		МассивДопустимыхСтатусов);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	
КонецПроцедуры

Процедура ИнициализироватьБизнесПроцесс()
	
	Автор = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

#КонецОбласти

#Область Прочее
Функция СоздатьЗадачу(Знач ТочкаМаршрутаБизнесПроцесса)
	
	Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	
	Задача.Дата                          = ТекущаяДатаСеанса();
	Задача.ДатаНачала                    = ТекущаяДатаСеанса();
	Задача.Автор                         = Автор;
	Задача.Наименование = "Необходимо произвести дальнейшее оформление Акта о браке N" + Предмет.Номер + " от " + Предмет.Дата;
	Задача.Описание                      = Предмет.Примечание;
	Задача.Предмет                       = Предмет;
	Задача.Важность                      = Важность;
	Задача.РольИсполнителя               = ПолучитьРольИсполнителя(ТочкаМаршрутаБизнесПроцесса); 
	Задача.ОсновнойОбъектАдресации       = ТочкаМаршрутаБизнесПроцесса.ОсновнойОбъектАдресации;
	Задача.ДополнительныйОбъектАдресации = ТочкаМаршрутаБизнесПроцесса.ДополнительныйОбъектАдресации;
	Задача.БизнесПроцесс                 = Ссылка;
	Задача.СрокИсполнения                = ПолучитьСрокИсполнения();
	Задача.ТочкаМаршрута                 = ТочкаМаршрутаБизнесПроцесса;
	
	Возврат Задача; 

КонецФункции 

Функция ПолучитьИсполнителя(РольИсполнителя) 
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
		|ИЗ
		|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		|ГДЕ
		|	ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя";
	
	Запрос.УстановитьПараметр("РольИсполнителя", РольИсполнителя);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий(); 
		
	Возврат ВыборкаДетальныеЗаписи.Исполнитель;

	
КонецФункции

Функция ПолучитьРольИсполнителя(ТочкаМаршрута) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОчередностьЭтаповСогласований.бит_РольИсполнителя КАК бит_РольИсполнителя,
		|	бит_ОчередностьЭтаповСогласований.бит_СтатусДокумента КАК бит_СтатусДокумента,
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа КАК бит_НомерЭтапа
		|ИЗ
		|	РегистрСведений.бит_ОчередностьЭтаповСогласований КАК бит_ОчередностьЭтаповСогласований
		|ГДЕ
		|	(бит_ОчередностьЭтаповСогласований.бит_Цех = &Цех
		|			ИЛИ бит_ОчередностьЭтаповСогласований.бит_Цех = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
		|	И бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа";
	
	Запрос.УстановитьПараметр("Цех", Предмет.Цех);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЭтоУспешный = Истина;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = Предмет.ТекущийСтатус 
			и Предмет.Статус <>  Предмет.ТекущийСтатус Тогда 
			ВыборкаДетальныеЗаписи.Следующий();
			Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента =  Предмет.Статус Тогда
				ВыборкаДетальныеЗаписи.Следующий();
               	РольИсполнителя = ВыборкаДетальныеЗаписи.бит_РольИсполнителя;
				Прервать;
			Иначе 
				ЭтоУспешный = Ложь;  
				НомерЭтапа = ВыборкаДетальныеЗаписи.бит_НомерЭтапа;
				Прервать; 			
			КонецЕсли;
		ИначеЕсли Предмет.Статус = Перечисления.бит_СтатусыОБраке.АктСформированСК 
			И ВыборкаДетальныеЗаписи.бит_СтатусДокумента =  Предмет.Статус Тогда
			  ВыборкаДетальныеЗаписи.Следующий();
              РольИсполнителя = ВыборкаДетальныеЗаписи.бит_РольИсполнителя;
              Прервать;
		КонецЕсли;
	КонецЦикла;

	
	Если не ЭтоУспешный Тогда  
		ВыборкаДетальныеЗаписи.Сбросить();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.бит_НомерЭтапа = НомерЭтапа - 2 Тогда
				Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = Предмет.Статус Тогда
					ВыборкаДетальныеЗаписи.Следующий();
					РольИсполнителя = ВыборкаДетальныеЗаписи.бит_РольИсполнителя;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат РольИсполнителя;

КонецФункции

Функция  ПолучитьСрокИсполнения();
	
	Если Статус = Перечисления.бит_СтатусыОБраке.АктСформированСК Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + (86400 *4));
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.ОформленМастером Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.ВыполненРасчетМатериаловТехнолог Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.ВыполненРасчетНормировщиком Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.СогласованНачальникомЦеха Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.ОформленБухгалтером Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.ПереданНаКомиссию Тогда 
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	ИначеЕсли  Статус = Перечисления.бит_СтатусыОБраке.РассмотренНаКомиссии Тогда
		Возврат  КонецДня(ТекущаяДатаСеанса() + 86400);
	КонецЕсли;
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	ДатаСогласования = КонецДня(ТекущаяДатаСеанса() + 864000);  
	
