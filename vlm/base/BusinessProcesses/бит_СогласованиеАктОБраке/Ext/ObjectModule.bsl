Процедура ВыборВариантаОбработкаВыбораВарианта(ТочкаВыбораВарианта, Результат)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа КАК бит_НомерЭтапа,
		|	бит_ОчередностьЭтаповСогласований.бит_СтатусДокумента КАК бит_СтатусДокумента
		|ИЗ
		|	РегистрСведений.бит_ОчередностьЭтаповСогласований КАК бит_ОчередностьЭтаповСогласований
		|ГДЕ
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа <> 0
		|	И (бит_ОчередностьЭтаповСогласований.бит_Цех = &Цех
		|			ИЛИ бит_ОчередностьЭтаповСогласований.бит_Цех = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
		|
        |УПОРЯДОЧИТЬ ПО
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа";
	
	Запрос.УстановитьПараметр("Цех", Предмет.Цех);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЭтоУспешный = Истина;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = Предмет.ТекущийСтатус 
			и Предмет.Статус <>  Предмет.ТекущийСтатус	Тогда 
			ВыборкаДетальныеЗаписи.Следующий();
			Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента =  Предмет.Статус Тогда
				ЭтапСогласования = ВыборкаДетальныеЗаписи.бит_СтатусДокумента;
				Прервать;
			Иначе 
				ЭтоУспешный = Ложь;  
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	
	Если не ЭтоУспешный Тогда  
	ЭтапСогласования = Предмет.Статус;
	КонецЕсли;
		
	Если ЭтапСогласования = Перечисления.бит_СтатусыОБраке.ОформленМастером Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант2;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.ВыполненРасчетМатериаловТехнолог Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант3;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.ВыполненРасчетНормировщиком Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант4;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.СогласованНачальникомЦеха Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант5;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.ОформленБухгалтером Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант6;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.ПереданНаКомиссию Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант7;
	ИначеЕсли ЭтапСогласования = Перечисления.бит_СтатусыОБраке.РассмотренНаКомиссии Тогда
		Результат = ТочкаВыбораВарианта.Варианты.Вариант8;
	Иначе
		Результат = ТочкаВыбораВарианта.Варианты.Вариант1;
	КонецЕсли;

