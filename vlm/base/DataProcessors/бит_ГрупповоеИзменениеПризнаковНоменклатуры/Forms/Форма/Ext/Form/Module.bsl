&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаВыбораГруппИЭлементов" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			
			Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
				
				Для Каждого ЭлМассива Из ВыбранноеЗначение Цикл
									
					//Если НЕ ЭлМассива.ЭтоГруппа Тогда
						
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("Номенклатура", ЭлМассива);
						
						Если Объект.ТаблицаНоменклатуры.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
							НоваяСтрока = Объект.ТаблицаНоменклатуры.Добавить();
							НоваяСтрока.Номенклатура = ЭлМассива;
						КонецЕсли;
						
					//КонецЕсли;
					
				КонецЦикла;	
				
			Иначе
								
				//Если НЕ ВыбранноеЗначение.ЭтоГруппа Тогда
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("Номенклатура", ВыбранноеЗначение);
					
					Если Объект.ТаблицаНоменклатуры.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
						НоваяСтрока = Объект.ТаблицаНоменклатуры.Добавить();
						НоваяСтрока.Номенклатура = ВыбранноеЗначение;
					КонецЕсли;
					
				//КонецЕсли;
				
			КонецЕсли;
	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "ПланВидовХарактеристик.бит_ПризнакиНоменклатуры.ФормаВыбора" Тогда
	
		Если ВыбранноеЗначение <> Неопределено Тогда
			
			Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
				
				Для Каждого ЭлМассива Из ВыбранноеЗначение Цикл
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("Признак", ЭлМассива);
					
					Если Объект.ТаблицаПризнаков.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
						НоваяСтрока = Объект.ТаблицаПризнаков.Добавить();
						НоваяСтрока.Признак = ЭлМассива;
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе	
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Признак", ВыбранноеЗначение);
				
				Если Объект.ТаблицаПризнаков.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
					НоваяСтрока = Объект.ТаблицаПризнаков.Добавить();
					НоваяСтрока.Признак = ВыбранноеЗначение;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Модифицированность = Ложь;
	
КонецПроцедуры


