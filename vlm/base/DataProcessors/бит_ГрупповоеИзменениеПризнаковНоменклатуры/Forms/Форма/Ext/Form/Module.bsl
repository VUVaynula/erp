&НаКлиенте
Процедура ЗаписатьПризнаки(Команда)
	
	СтруктураПараметров = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьПризнакиЗавершение", ЭтотОбъект, СтруктураПараметров); 
	ПоказатьВопрос(ОписаниеОповещения, "Записать признаки ноенклатуры?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьПризнакиЗавершение(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Если НоменклатураЗаполненаИЗначенияУстановлены() Тогда
			ЗаписатьПризнакиНаСервере();	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	                

&НаКлиенте
Функция  НоменклатураЗаполненаИЗначенияУстановлены()

	МожноЗаписыватьПризнаки = Истина;
	
	Для Каждого СтрокаНоменклатуры Из Объект.ТаблицаНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура) Тогда
			
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Поле = "Объект.ТаблицаНоменклатуры" + "[" + Формат(Число(СтрокаНоменклатуры.НомерСтроки - 1), "ЧГ=0") + "].Номенклатура"; 
			СообщениеПользователю.Текст = "В строке " + СтрокаНоменклатуры.НомерСтроки + " не заполнена номенклатура!";
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			
			МожноЗаписыватьПризнаки = Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаПризнак Из Объект.ТаблицаПризнаков Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПризнак.Признак) Тогда
			
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Поле = "Объект.ТаблицаПризнаков" + "[" + Формат(Число(СтрокаПризнак.НомерСтроки - 1), "ЧГ=0") + "].Признак"; 
			СообщениеПользователю.Текст = "В строке " + СтрокаПризнак.НомерСтроки + " не заполнен признак!";
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			
			МожноЗаписыватьПризнаки = Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаПризнак Из Объект.ТаблицаПризнаков Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПризнак.ЗначениеПризнака) Тогда
			
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Поле = "Объект.ТаблицаПризнаков" + "[" + Формат(Число(СтрокаПризнак.НомерСтроки - 1), "ЧГ=0") + "].ЗначениеПризнака"; 
			СообщениеПользователю.Текст = "В строке " + СтрокаПризнак.НомерСтроки + " не заполнено значение признака!";
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			
			МожноЗаписыватьПризнаки = Ложь;
			
		КонецЕсли;
	КонецЦикла;

	
	Возврат МожноЗаписыватьПризнаки;

КонецФункции

&НаСервере
Процедура ЗаписатьПризнакиНаСервере()    

	Для Каждого СтрокаНоменклатуры Из Объект.ТаблицаНоменклатуры Цикл
		Для Каждого СтрокаПризнак Из Объект.ТаблицаПризнаков Цикл
			
			ЗаписьРегистра = РегистрыСведений.бит_ЗначенияПризнаковНоменклатуры.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.бит_Номенклатура = СтрокаНоменклатуры.Номенклатура;
			ЗаписьРегистра.бит_Признак = СтрокаПризнак.Признак;
			ЗаписьРегистра.бит_ПризнакСертификации = СтрокаПризнак.Признак.бит_ПризнакСертификации;
			ЗаписьРегистра.бит_Значение = СтрокаПризнак.ЗначениеПризнака;
			ЗаписьРегистра.Записать(Истина);
			
		КонецЦикла;
	КонецЦикла;
	
	Сообщить("Запись признаков завершена!");
	
КонецПроцедуры


