	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",	
		Новый Структура("ЗакрыватьПриВыборе, РежимВыбора, МножественныйВыбор", Ложь, Истина, Истина),
		ЭтаФорма, , , , ,
		//Новый ОписаниеОповещения("ПриЗакрытииФормыПодбора",	ЭтаФорма,"Подбор"),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

