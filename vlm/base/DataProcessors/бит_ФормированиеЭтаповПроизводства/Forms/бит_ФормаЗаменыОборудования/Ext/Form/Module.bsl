&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДанныеСтроки = Параметры.ДанныеСтроки;     
	//КодОперации = ДанныеСтроки.КодОперации;
	ОтделяемоеКоличество = 0;  
	Оборудование = ДанныеСтроки.бит_ВРЦ; 
	Спецификация = ДанныеСтроки.Спецификация; 
	//Номенклатура = ДанныеСтроки.Номенклатура;
	Элементы.Оборудование.СписокВыбора.ЗагрузитьЗначения(ДанныеСтроки.мВРЦ);
	Если ДанныеСтроки.Режим = "РазделениеПотребности" Тогда
		Элементы.РежимЗамена.Видимость = Ложь;
	Иначе                                     
		Элементы.РежимРазделение.Видимость = Ложь;  
		Элементы.ОтделяемоеКоличество.Видимость = Ложь;  
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеПриИзменении(Элемент)  
	
	ПриИзмененииОборудования(); 
	
КонецПроцедуры

&НаКлиенте
Процедура Ок(Команда)
	
	Если ОтделяемоеКоличество = 0 И ДанныеСтроки.Режим = "РазделениеПотребности" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать отделяемое количество"); 
	ИначеЕсли Не ЗначениеЗаполнено(Оборудование) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать оборудование");
	ИначеЕсли Не ЗначениеЗаполнено(Спецификация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать спецификацию");
	Иначе
		Закрыть(Новый Структура("ОтделяемоеКоличество, ВРЦ, Спецификация, ДанныеСтроки", ОтделяемоеКоличество, Оборудование, Спецификация, ДанныеСтроки));	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтделяемоеКоличествоПриИзменении(Элемент)
	
	Если ОтделяемоеКоличество >= ДанныеСтроки.Количество Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Остаток в строке должен быть больше нуля");    
		ОтделяемоеКоличество = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	
	ПриИзмененииОборудования(); 
	
КонецПроцедуры                 

&НаКлиенте
Процедура ПриИзмененииОборудования() 
	
	мСпецификаций = бит_ВидыРабочихЦентров.ОпределитьСпецификации(ДанныеСтроки.Номенклатура, Оборудование, ДанныеСтроки.КодОперации);
	Элементы.Спецификация.СписокВыбора.Очистить(); 
	Элементы.Спецификация.СписокВыбора.ЗагрузитьЗначения(мСпецификаций);
	Если мСпецификаций.Количество() Тогда
		Спецификация = мСпецификаций[0];
	КонецЕсли;
	
КонецПроцедуры
