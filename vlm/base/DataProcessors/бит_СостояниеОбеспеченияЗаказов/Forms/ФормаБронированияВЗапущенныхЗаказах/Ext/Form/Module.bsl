&НаКлиенте
Процедура ЗаказыНаПроизводствоПриАктивизацииСтроки(Элемент)
	
	ТД = Элементы.ЗаказыНаПроизводство.ТекущиеДанные;
	Если ТД <> Неопределено Тогда   
		ЗаказНаПроизводствоТекущий = ТД.ЗаказНаПроизводство;
		ПерезаполнитьТЧЗаказа(ТД.ЗаказНаПроизводство);   
	Иначе
		ЗаказНаПроизводствоТекущий = ПредопределенноеЗначение("Документ.ЗаказНаПроизводство2_2.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьТЧЗаказа(ЗаказНаПроизводство, Доступно = Неопределено)
	
	//Если Доступно = Неопределено Тогда
		Доступно = 0;
	//КонецЕсли;
	
	ТаблицаТоваров.Очистить();
	Для каждого стр из ЗаказНаПроизводство.Продукция Цикл 
		Если стр.Номенклатура <> Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		
		нов = ТаблицаТоваров.Добавить(); 
		нов.НомерСтроки = стр.НомерСтроки;
		нов.Назначение = стр.Назначение;
		нов.Количество = стр.Количество;
		Если ЗначениеЗаполнено(стр.Назначение) 
			И ЗначениеЗаполнено(стр.Назначение.Заказ) 
			И ТипЗнч(стр.Назначение.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				нов.КомментарийКЗаказу = стр.Назначение.Заказ.Комментарий;     
				нов.Толеранс = стр.Назначение.Заказ.бит_Толеранс;
		КонецЕсли;
		 
		Если Не ЗначениеЗаполнено(стр.Назначение) Тогда
			Доступно = Доступно + стр.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
