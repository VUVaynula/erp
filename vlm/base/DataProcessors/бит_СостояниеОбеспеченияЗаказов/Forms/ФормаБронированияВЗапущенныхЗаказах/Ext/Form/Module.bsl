&НаСервере
Процедура ЗаполнитьТЧЗаказыНаПроизводство()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Т.Распоряжение КАК ЗаказНаПроизводство,
	                      |	ИСТИНА КАК ТребуетсяПланирование
	                      |ПОМЕСТИТЬ втТребуетсяПланирование
	                      |ИЗ
	                      |	РегистрСведений.ЗаданияКРасчетуГрафикаПроизводства КАК Т
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ
	                      |	Т.ЗаказНаПроизводство,
	                      |	ИСТИНА
	                      |ИЗ
	                      |	РегистрСведений.ЗаданияКРасчетуСтруктурыЗаказаГрафикПроизводства КАК Т
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ВЫРАЗИТЬ(ЗапасыИПотребностиОбороты.Регистратор КАК Документ.ЗаказНаПроизводство2_2) КАК ЗаказНаПроизводство,
	                      |	ЗапасыИПотребностиОбороты.Номенклатура КАК Номенклатура
	                      |ПОМЕСТИТЬ втЗаказы
	                      |ИЗ
	                      |	РегистрНакопления.ЗапасыИПотребности.Обороты(
	                      |			,
	                      |			,
	                      |			Регистратор,
	                      |			Заказ ССЫЛКА Документ.ЗаказНаПроизводство2_2
	                      |				И Номенклатура = &Номенклатура) КАК ЗапасыИПотребностиОбороты
	                      |ГДЕ
	                      |	ЗапасыИПотребностиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаПроизводство2_2
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	втЗаказы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	                      |	втЗаказы.ЗаказНаПроизводство.ДатаПотребности КАК ЖелаемаяДатаВыпуска,
	                      |	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК ОбъемВЗаказе,
	                      |	СУММА(ВЫБОР
	                      |			КОГДА ЗаказНаПроизводство2_2Продукция.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	                      |				ТОГДА ЗаказНаПроизводство2_2Продукция.Количество
	                      |			ИНАЧЕ 0
	                      |		КОНЕЦ) КАК ДоступноКБронированию,
	                      |	влПлановаяДата.ПлановаяДатаВыпуска КАК ПлановаяДатаВыпуска,
	                      |	ЕСТЬNULL(втТребуетсяПланирование.ТребуетсяПланирование, ЛОЖЬ) КАК ТребуетсяПерепланирование
	                      |ИЗ
	                      |	втЗаказы КАК втЗаказы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	                      |		ПО втЗаказы.ЗаказНаПроизводство = ЗаказНаПроизводство2_2Продукция.Ссылка
	                      |			И втЗаказы.Номенклатура = ЗаказНаПроизводство2_2Продукция.Номенклатура
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			втЗаказы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	                      |			МАКСИМУМ(ЕСТЬNULL(ГрафикЭтаповПроизводства2_2.Окончание, ДАТАВРЕМЯ(1, 1, 1))) КАК ПлановаяДатаВыпуска
	                      |		ИЗ
	                      |			втЗаказы КАК втЗаказы
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК ГрафикЭтаповПроизводства2_2
	                      |				ПО втЗаказы.ЗаказНаПроизводство = ГрафикЭтаповПроизводства2_2.ЗаказНаПроизводство
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			втЗаказы.ЗаказНаПроизводство) КАК влПлановаяДата
	                      |		ПО втЗаказы.ЗаказНаПроизводство = влПлановаяДата.ЗаказНаПроизводство
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втТребуетсяПланирование КАК втТребуетсяПланирование
	                      |		ПО втЗаказы.ЗаказНаПроизводство = втТребуетсяПланирование.ЗаказНаПроизводство
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	втЗаказы.ЗаказНаПроизводство,
	                      |	втЗаказы.ЗаказНаПроизводство.ДатаПотребности,
	                      |	влПлановаяДата.ПлановаяДатаВыпуска,
	                      |	ЕСТЬNULL(втТребуетсяПланирование.ТребуетсяПланирование, ЛОЖЬ)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ЗаказНаПроизводство"); 
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ЗаказыНаПроизводство.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

