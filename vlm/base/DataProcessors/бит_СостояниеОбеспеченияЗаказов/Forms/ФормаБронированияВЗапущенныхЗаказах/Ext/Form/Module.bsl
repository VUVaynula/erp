			КонецЕсли;	
		КонецЦикла;  
		Источник.бит_ИтогоНетто = Источник.Товары.Итог("бит_ВесНетто");
		Источник.бит_ИтогоБрутто = Источник.Товары.Итог("бит_ВесБрутто");
		
КонецПроцедуры

#Область ИЗФормыРасширенияЗаказКлиента

&НаСервереБезКонтекста
Функция ПолучитьНамоткуНоменклатуры(НоменклатураГП, УпаковкаГП, НоменклатураТара)

 	// {{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] +
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НамоткаНоменклатуры.НоменклатураГП КАК НоменклатураГП,
		|	бит_НамоткаНоменклатуры.ЕдИзм КАК ЕдИзм,
		|	бит_НамоткаНоменклатуры.НоменклатураТара КАК НоменклатураТара,
		|	бит_НамоткаНоменклатуры.Намотка КАК Намотка,
		|	бит_НамоткаНоменклатуры.Несопоставимо КАК Несопоставимо
		|ИЗ
		|	РегистрСведений.бит_НамоткаНоменклатуры КАК бит_НамоткаНоменклатуры
		|ГДЕ
		|	бит_НамоткаНоменклатуры.НоменклатураГП = &НоменклатураГП
		//|	И бит_НамоткаНоменклатуры.ЕдИзм = &ЕдИзм
		|	И бит_НамоткаНоменклатуры.НоменклатураТара = &НоменклатураТара";
	
	Запрос.УстановитьПараметр("ЕдИзм", УпаковкаГП);
	Запрос.УстановитьПараметр("НоменклатураГП", НоменклатураГП);
	Запрос.УстановитьПараметр("НоменклатураТара", НоменклатураТара);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Несопоставимо Тогда
			
			Возврат - 1;	
			
		Иначе
			
			Возврат ВыборкаДетальныеЗаписи.Намотка;	
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат -1;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] -
  
КонецФункции

&НаСервереБезКонтекста
Процедура РасчитатьВес(ТекущиеДанные, Намотка)
	// взято из расширения из формы заказа клиента
	
	// {{ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] +
	
	//_1 "Вес нетто, т" - автоматический расчет (например 1км ГП весит 0,01т - заказали 10 км ГП - Вес нетто = 0,1т)
	//_2 "Вес брутто, т" - автоматический расчет 
	//(например 1км ГП весит 0,01т; 1 шт Тары весит 0,01т - заказали 10 км ГП 
	//(согласно Регистру сведений на 1 шт Тары максимально наматывается 5 км, т.е. необходимо 2шт Тары для намотки 10 км ГП) - Вес брутто = 0,12т)
	//_3 "Тип тары" (номенклатура) - заполняется из справочника Номенклатура - Вид номенклатуры - Тара
	//_4 "Количество тары" - автоматический расчет 
	//(например заказали 10 км ГП, указали Тип тары 
	//(согласно Регистру сведений на 1 шт Тары максимально наматывается 5 км) - Количество тары = 2 шт)
	//_5 "Намотка" - автоматическое заполнение из Регистра сведений (максимальное значение). 
	//При необходимости (по запросу клиента) изменяется на меньшее значение и производится автоматический пересчет значений "Количество тары", "Вес брутто".
				
	Если ТекущиеДанные <> Неопределено Тогда
		
		ВесНетто = ПолучитьВесНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.Упаковка);
		ТекущиеДанные.бит_ВесНетто = ВесНетто * ТекущиеДанные.КоличествоУпаковок;
		
		Если Намотка <> 0 Тогда
			ТекущиеДанные.бит_КоличествоТары = ТекущиеДанные.КоличествоУпаковок / Намотка;
		Иначе
			ТекущиеДанные.бит_КоличествоТары = 0;
			ТекущиеДанные.бит_Намотка = 0;	
		КонецЕсли;	
			
		Если Цел(ТекущиеДанные.бит_КоличествоТары) <> ТекущиеДанные.бит_КоличествоТары Тогда
			ТекущиеДанные.бит_КоличествоТары = Цел(ТекущиеДанные.бит_КоличествоТары) + 1;	
		КонецЕсли;
		
		ВесНетто = ПолучитьВесНоменклатуры(ТекущиеДанные.бит_ТипТары, ТекущиеДанные.Упаковка);
		ТекущиеДанные.бит_ВесБрутто = ТекущиеДанные.бит_ВесНетто + (ВесНетто * ТекущиеДанные.бит_КоличествоТары);
		
	КонецЕсли;
	// }}ПервыйБИТ ЛистТребований [ЛТ8] [ASHolyavko@1cbit.ru] [20.08.2024] -
	
КонецПроцедуры

&НаСервереБезКонтекста
