
&НаКлиенте
Процедура ЗаказКлиентаНомерОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначение(ЗаказКлиента);
КонецПроцедуры

&НаКлиенте
Процедура Распределить(Команда)
	
	Если КРаспределению = 0 Тогда
		Возврат;
	КонецЕсли;
	ТД = Элементы.ЗаказыНаПроизводство.ТекущиеДанные;
	Если ТД = Неопределено Или ТД.ДоступноКБронированию = 0 Тогда
		Возврат;
	КонецЕсли;
	Забронировано = 0;                                  
	
	ЗабронироватьНаСервере(ТД.ДоступноКБронированию, ЗаказКлиента, Номенклатура, ЗаказНаПроизводствоТекущий, Забронировано, КРаспределению);

	Если Забронировано > 0 Тогда   
		КРаспределению = КРаспределению - Забронировано;  
		ПерезаполнитьТЧЗаказа(ЗаказНаПроизводствоТекущий, ТД.ДоступноКБронированию); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗабронироватьНаСервере(Знач ДоступноКБронированию, ЗаказКлиента, Номенклатура, ЗаказНаПроизводство, Забронировано, КРаспределению) 
	                             
	// ДоступноКБронированию - сколько можно распределить по заказу на производство. это количество должно быть обособлено
	// проверим, что в заказе клиента для этой Номенклатуры указано обособление
	СтрокиЗаказаКлиента = ЗаказКлиента.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	ОбособленныхВЗаказеКлиента = 0;  
	НеОбособленныхВЗаказеКлиента = 0;   
	мНеобособленныхСтрок = Новый Массив;     
	Дораспределено = 0;
		
	Для Каждого стр Из СтрокиЗаказаКлиента Цикл
		Если стр.Обособленно Тогда
			ОбособленныхВЗаказеКлиента = ОбособленныхВЗаказеКлиента + стр.Количество;
		Иначе
			мНеобособленныхСтрок.Добавить(стр);
			НеОбособленныхВЗаказеКлиента = НеОбособленныхВЗаказеКлиента + стр.Количество;
		КонецЕсли;
	КонецЦикла; 
	
	Если ОбособленныхВЗаказеКлиента < ДоступноКБронированию И НеОбособленныхВЗаказеКлиента > 0 Тогда // надо обособить в заказе клиента 
		КДораспределениюПоЗаказу = Мин(ДоступноКБронированию - ОбособленныхВЗаказеКлиента, НеОбособленныхВЗаказеКлиента);        
		Дораспределено = 0;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Из " + ЗаказКлиента + " возможно дополнительно обособить " + КДораспределениюПоЗаказу + " " + Номенклатура.ЕдиницаИзмерения);
		Если КДораспределениюПоЗаказу > 0 Тогда
		// найдем наиболее подходящую строку по заказу (вдруг их несколько)  
			ЗаказОбъект = ЗаказКлиента.ПолучитьОбъект();   
			СтрокиЗаказаКлиента = ЗаказОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура, Обособленно", Номенклатура, Ложь));
			
			СтруктураДействий = Новый Структура;
			ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, ЗаказОбъект);
			//ДобавитьДействияОбеспечения(СтруктураДействий, "ДоступноВДругихСтроках", ЗаказОбъект);
			
			Для Каждого стр Из СтрокиЗаказаКлиента Цикл
				Если стр.Количество <= КДораспределениюПоЗаказу Тогда
						// обособляем всю строку
						стр.Обособленно = Истина;                
						КДораспределениюПоЗаказу = КДораспределениюПоЗаказу - стр.Количество; 
						Дораспределено = Дораспределено + стр.Количество;
						// кусочек типового кода
						стр.ВариантОбеспечения = ОбеспечениеВДокументахКлиентСервер.ОбособленноПриИзменении(стр.Обособленно, стр.ВариантОбеспечения, стр.Номенклатура.ТипНоменклатуры);
					Иначе
						//разбиваем строку.
						нов = ЗаказОбъект.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(нов, стр, , "НомерСтроки, ИдентификаторСтроки, КлючСвязи, КодСтроки"); 
						
						стр.Обособленно = Истина;
						стр.КоличествоУпаковок = КДораспределениюПоЗаказу;  
						Дораспределено = Дораспределено + КДораспределениюПоЗаказу;
						// кусочек типового кода
						стр.ВариантОбеспечения = ОбеспечениеВДокументахКлиентСервер.ОбособленноПриИзменении(стр.Обособленно, стр.ВариантОбеспечения, стр.Номенклатура.ТипНоменклатуры);
						
						нов.КоличествоУпаковок  = стр.КоличествоУпаковок - КДораспределениюПоЗаказу;
						нов.ИдентификаторСтроки = Новый УникальныйИдентификатор;
						
						ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(стр, СтруктураДействий, Неопределено);
						ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(нов, СтруктураДействий, Неопределено);
						
						КДораспределениюПоЗаказу = 0; 
					КонецЕсли;
					
					Если КДораспределениюПоЗаказу = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла; 
				
			//ДоступноКБронированию = ОбособленныхВЗаказеКлиента + Дораспределено;
			
			Попытка	  
				СвернутьСтрокиТЧТоварыЗаказаКлиента(ЗаказОбъект);
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);  
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В " + ЗаказКлиента + " дополнительно обособлено " + Дораспределено + " " + Номенклатура.ЕдиницаИзмерения);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сделать обособлене в " + ЗаказКлиента + " по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));				
				Возврат;
			КонецПопытки; 
		КонецЕсли;
	КонецЕсли;
	ДоступноКБронированию = Мин(ОбособленныхВЗаказеКлиента + Дораспределено, КРаспределению);
	
	// теперь найдем назначение
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Назначения.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Назначения КАК Назначения
	                      |ГДЕ
	                      |	Назначения.Заказ = &Заказ");
	Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Назначение = Выборка.Ссылка;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти назначение для " + ЗаказКлиента);
		Возврат;
	КонецЕсли;
	/// -------------------------------------------------------------------------------------------------
	// теперь в текущем заказе на производство надо указать назначение
	ЗаказНаПроизводствоОбъект = ЗаказНаПроизводство.ПолучитьОбъект();
	ЗабронированоТеоретически = 0;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПроизводствоКлиентСервер.ПараметрыПересчетаКоличестваЕдиниц());
	Если ЗаказНаПроизводствоОбъект.ТипПроизводственногоПроцесса = ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.БезСпецификаций") Тогда
		ПараметрыРаспределенияЗатрат = Новый ФиксированнаяСтруктура(Документы.ЗаказНаПроизводство2_2.ПараметрыРаспределенияЗатрат(ЗаказНаПроизводствоОбъект));
		СтруктураДействий.Вставить("ПроверитьЗаполнитьДолюСтоимости", ПараметрыРаспределенияЗатрат);
	КонецЕсли;
	
	Для каждого стр Из ЗаказНаПроизводствоОбъект.Продукция Цикл
		Если Не стр.Назначение.Пустая() Или стр.Номенклатура <> Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		Если стр.Количество <= ДоступноКБронированию Тогда
			стр.Назначение = Назначение;	        
			ДоступноКБронированию = ДоступноКБронированию - стр.Количество; 
			ЗабронированоТеоретически = ЗабронированоТеоретически + стр.Количество;
		Иначе                                                                      
			// разбиваем строку
			нов = ЗаказНаПроизводствоОбъект.Продукция.Добавить();
			ЗаполнитьЗначенияСвойств(нов, стр, , "НомерСтроки, КлючНоменклатура");
			стр.КоличествоУпаковок = ДоступноКБронированию;  
			стр.Назначение = Назначение;
			
			ЗабронированоТеоретически = ЗабронированоТеоретически + ДоступноКБронированию;      
			ДоступноКБронированию = 0;
			нов.КоличествоУпаковок = нов.КоличествоУпаковок - стр.КоличествоУпаковок; 
			нов.КлючНоменклатура = Новый УникальныйИдентификатор;
			
			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(стр, СтруктураДействий, Неопределено);
			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(нов, СтруктураДействий, Неопределено);
			
		КонецЕсли;
		Если ДоступноКБронированию = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Попытка 
		ЗаказНаПроизводствоОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Забронировано = ЗабронированоТеоретически;         
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Забронировано " + Забронировано + " " + Номенклатура.ЕдиницаИзмерения);
	Исключение     
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать " + ЗаказНаПроизводство + " по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;  
	
КонецПроцедуры

