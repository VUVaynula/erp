&НаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Объект)
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомСкидкиБонуснымиБаллами");
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗависимыеРеквизиты()
	
	Возврат Новый Структура(
		"БезВозвратнойТары,ОтмененоБезВозвратнойТары,Отменено",
		"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки,СуммаАвтоматическойСкидки,СуммаБонусныхБалловКСписаниюВВалюте",
		"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки,СуммаАвтоматическойСкидки,СуммаБонусныхБалловКСписаниюВВалюте",
		"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки,СуммаАвтоматическойСкидки,СуммаБонусныхБалловКСписаниюВВалюте");
	
КонецФункции

&НаКлиенте
Процедура СнятьБронь(Команда)
	
	ТД = Элементы.ТаблицаТоваров.ТекущиеДанные;
	Если ТД = Неопределено Или ТД.Назначение = ПредопределенноеЗначение("Справочник.Назначения.ПустаяСсылка") Тогда 
		Возврат;
	КонецЕсли;
	ОтменитьНазначениеВЗаказеНаПроизводствоНаСервере(ТД.НомерСтроки);
	
	ТекДанныеПоСтрокеЗаказа = Элементы.ЗаказыНаПроизводство.ТекущиеДанные;
	Если ТекДанныеПоСтрокеЗаказа <> Неопределено Тогда
		ПерезаполнитьТЧЗаказа(ЗаказНаПроизводствоТекущий, ТекДанныеПоСтрокеЗаказа.ДоступноКБронированию); 	
	Иначе                                                 
		ПерезаполнитьТЧЗаказа(ЗаказНаПроизводствоТекущий);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьНазначениеВЗаказеНаПроизводствоНаСервере(НомерСтроки)
	
	ЗаказОбъект = ЗаказНаПроизводствоТекущий.ПолучитьОбъект();
	СтрокаТЧ = ЗаказОбъект.Продукция.Найти(НомерСтроки, "НомерСтроки");
	СтрокаТЧ.Назначение = Справочники.Назначения.ПустаяСсылка();  
	СвернутьТЧЗаказаНаПроизводство(ЗаказОбъект);
	ЗаказОбъект.Записать();
	
КонецПроцедуры 


Процедура СвернутьТЧЗаказаНаПроизводство(Источник)
	 Запрос = Новый Запрос("ВЫБРАТЬ
	                       |	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	                       |	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика,
	                       |	ЗаказНаПроизводство2_2Продукция.Упаковка КАК Упаковка,
	                       |	ЗаказНаПроизводство2_2Продукция.КоличествоУпаковок КАК КоличествоУпаковок,
	                       |	ЗаказНаПроизводство2_2Продукция.Количество КАК Количество,
	                       |	ЗаказНаПроизводство2_2Продукция.Спецификация КАК Спецификация,
	                       |	ЗаказНаПроизводство2_2Продукция.Склад КАК Склад,
	                       |	ЗаказНаПроизводство2_2Продукция.Подразделение КАК Подразделение,
	                       |	ЗаказНаПроизводство2_2Продукция.Назначение КАК Назначение,
	                       |	ЗаказНаПроизводство2_2Продукция.ДатаПотребности КАК ДатаПотребности,
	                       |	ЗаказНаПроизводство2_2Продукция.Отменено КАК Отменено,
	                       |	ЗаказНаПроизводство2_2Продукция.ПричинаОтмены КАК ПричинаОтмены,
	                       |	ЗаказНаПроизводство2_2Продукция.ДоляСтоимости КАК ДоляСтоимости,
	                       |	ЗаказНаПроизводство2_2Продукция.ДоляСтоимостиНаЕдиницу КАК ДоляСтоимостиНаЕдиницу,
