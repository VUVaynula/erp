&НаКлиенте
Процедура бит_НормаВыработкиПриИзменении(Элемент)  
	
	ЕстьИзмененияПараметров = Истина;
	
	Если бит_НормаВыработки = 0 Тогда
		бит_НормаВремени = 0;
		ВремяШтучное = 0;
	Иначе		
		ВремяШтучноеЕдИзм = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Минута");
		бит_НормаВремени = 1 / бит_НормаВыработки;
		ВремяШтучное = бит_НормаВремени * 60; 
	КонецЕсли;                              
	
	Если ТаблицаНакладных.Количество() Тогда 
		Для каждого стр из ТаблицаНакладных Цикл
			стр.бит_НормаВыработки = бит_НормаВыработки;
			стр.бит_НормаВремени = бит_НормаВремени;
			стр.ВремяШтучное = ВремяШтучное;
			стр.ВремяШтучноеЕдИзм = ВремяШтучноеЕдИзм;
			стр.бит_РучнойВводНормыВыработки = ОпределитьРучноеИзменениеВыработки(стр);
		КонецЦикла;	
		ЗаполнитьПоказателиПоНеколькимОперациям();
	Иначе
		бит_РучнойВводНормыВыработки = ОпределитьРучноеИзменениеВыработки(ЭтаФорма); 
		Для каждого стр из ВидыРабот Цикл
			Если стр.ЗначениеВидимость Тогда  // то что относится к текущей операции/этапу
				стр.Количество = бит_НормаВремени; // время выполнения переведем в часы
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры                 

&НаКлиенте
Функция ОпределитьРучноеИзменениеВыработки(Коллекция)

	// посчитаем выработку со всей машины параметрически, то есть по данным выпуска со всей машины
	Возврат Коллекция["бит_НормаВыработки"] <> Коллекция["бит_ВыработкаПроводаСоВсейМашины"];  

