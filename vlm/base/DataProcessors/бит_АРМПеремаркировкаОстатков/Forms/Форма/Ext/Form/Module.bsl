		|	ВыходныеИзделия.Номенклатура КАК НоваяНоменклатура,
		|	ВыходныеИзделия.Серия КАК НоваяСерия,
		|	ОтборРазмещениеТоваровТоварыРазмещение.Ячейка КАК ЯчейкаРазмещения,
		|	МатериалыИРаботы.Серия.бит_ТипТары КАК Тара,
		|	МатериалыИРаботы.КоличествоУпаковок КАК Количество,
		|	МатериалыИРаботы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Документ.ПроизводствоБезЗаказа.МатериалыИРаботы КАК МатериалыИРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК ВыходныеИзделия
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтборРазмещениеТоваров.ТоварыРазмещение КАК ОтборРазмещениеТоваровТоварыРазмещение
		|			ПО ВыходныеИзделия.Ссылка = ОтборРазмещениеТоваровТоварыРазмещение.Ссылка.бит_ПроизводствоБезЗаказа
		|				И ВыходныеИзделия.Номенклатура = ОтборРазмещениеТоваровТоварыРазмещение.Номенклатура
		|				И ВыходныеИзделия.Серия = ОтборРазмещениеТоваровТоварыРазмещение.Серия
		|		ПО МатериалыИРаботы.Ссылка = ВыходныеИзделия.Ссылка
		|			И МатериалыИРаботы.НомерСтроки = ВыходныеИзделия.НомерСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТовары
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтборРазмещениеТоваров.ТоварыОтбор КАК ОтборРазмещениеТоваровТоварыОтбор
		|			ПО РасходныйОрдерНаТоварыТовары.Ссылка = ОтборРазмещениеТоваровТоварыОтбор.Ссылка.Распоряжение
		|				И РасходныйОрдерНаТоварыТовары.Номенклатура = ОтборРазмещениеТоваровТоварыОтбор.Номенклатура
		|				И РасходныйОрдерНаТоварыТовары.Серия = ОтборРазмещениеТоваровТоварыОтбор.Серия
		|		ПО МатериалыИРаботы.Ссылка = РасходныйОрдерНаТоварыТовары.Распоряжение
		|			И МатериалыИРаботы.Номенклатура = РасходныйОрдерНаТоварыТовары.Номенклатура
		|			И МатериалыИРаботы.Серия = РасходныйОрдерНаТоварыТовары.Серия
		|ГДЕ
		|	ВыходныеИзделия.Ссылка = &Ссылка
		|	И МатериалыИРаботы.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		//ОбластьСтрокаТаблицы.Параметры.НомерСтроки = СтрокаМатериалы.НомерСтроки;
		//ОбластьСтрокаТаблицы.Параметры.НоменклатураДляПеремаркировки = СтрокаМатериалы.Номенклатура;
		//ОбластьСтрокаТаблицы.Параметры.СерияДляПеремаркировки = СтрокаМатериалы.Серия;
		//ОбластьСтрокаТаблицы.Параметры.НоваяНоменклатура = ДокументСсылка.ВыходныеИзделия[СтрокаМатериалы.НомерСтроки - 1].Номенклатура;
		//ОбластьСтрокаТаблицы.Параметры.НоваяСерия = ДокументСсылка.ВыходныеИзделия[СтрокаМатериалы.НомерСтроки - 1].Серия;
		//ОбластьСтрокаТаблицы.Параметры.Тара = СтрокаМатериалы.Серия.бит_ТипТары;
		//ОбластьСтрокаТаблицы.Параметры.Количество = СтрокаМатериалы.КоличествоУпаковок;
		//ОбластьСтрокаТаблицы.Параметры.ЕдиницаИзмерения = СтрокаМатериалы.Номенклатура.ЕдиницаИзмерения;
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ВыборкаДетальныеЗаписи);
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
	КонецЦикла;
		
	//Для Каждого СтрокаМатериалы Из ДокументСсылка.МатериалыИРаботы Цикл
	//	
	//	ОбластьСтрокаТаблицы.Параметры.НомерСтроки = СтрокаМатериалы.НомерСтроки;
	//	ОбластьСтрокаТаблицы.Параметры.НоменклатураДляПеремаркировки = СтрокаМатериалы.Номенклатура;
	//	ОбластьСтрокаТаблицы.Параметры.СерияДляПеремаркировки = СтрокаМатериалы.Серия;
	//	ОбластьСтрокаТаблицы.Параметры.НоваяНоменклатура = ДокументСсылка.ВыходныеИзделия[СтрокаМатериалы.НомерСтроки - 1].Номенклатура;
	//	ОбластьСтрокаТаблицы.Параметры.НоваяСерия = ДокументСсылка.ВыходныеИзделия[СтрокаМатериалы.НомерСтроки - 1].Серия;
	//	ОбластьСтрокаТаблицы.Параметры.Тара = СтрокаМатериалы.Серия.бит_ТипТары;
	//	ОбластьСтрокаТаблицы.Параметры.Количество = СтрокаМатериалы.КоличествоУпаковок;
	//	ОбластьСтрокаТаблицы.Параметры.ЕдиницаИзмерения = СтрокаМатериалы.Номенклатура.ЕдиницаИзмерения;
	//	
	//	ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
	//	
	//КонецЦикла;
		
	ОбластьПодвал.Параметры.ТекстИтого = "Итого серий " + ДокументСсылка.МатериалыИРаботы.Количество() + " штуки," + ДокументСсылка.МатериалыИРаботы.Итог("КоличествоУпаковок") + " " + ДокументСсылка.МатериалыИРаботы[0].Номенклатура.ЕдиницаИзмерения;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;

