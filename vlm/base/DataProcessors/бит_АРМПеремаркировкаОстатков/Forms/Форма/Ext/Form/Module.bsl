	ОбластьШапка.Параметры.НомерДатаДокумента = ДокументСсылка.Номер + " от " + Формат(ДокументСсылка.Дата, "ДФ='dd.MM.yyyy ""г.""'");
	ОбластьШапка.Параметры.Подразделение = ДокументСсылка.Подразделение;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
