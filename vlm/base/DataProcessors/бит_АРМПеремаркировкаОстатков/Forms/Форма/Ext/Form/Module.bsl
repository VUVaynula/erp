&НаСервере
Функция ПолучитьСтруктуруСтрок(ДокументСсылка)
	
	мСтрок = Новый Массив;	
	
	Для Каждого СтрокаТЧ Из ДокументСсылка.ВыходныеИзделия Цикл
		
		//Если Не ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена серия в строке " + СтрокаТЧ.НомерСтроки);
		//	Продолжить;
		//КонецЕсли;
		//Если Не ЗначениеЗаполнено(СтрокаТЧ.бит_Тара) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена тара в строке " + СтрокаТЧ.НомерСтроки);
		//	Продолжить;
		//КонецЕсли;
		
		//ТД = Элементы.ВыходныеИзделия.ДанныеСтроки(СтрокаТЧ);
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
		Структура.Вставить("Серия",СтрокаТЧ.Серия);
		Структура.Вставить("Тара", СтрокаТЧ.бит_Тара);
		Структура.Вставить("Спецификация", СтрокаТЧ.Спецификация); 
		Структура.Вставить("ВидРабочегоЦентра", СтрокаТЧ.Серия.бит_ВидРабочегоЦентра);
		Структура.Вставить("МассаНеттоКГ", СтрокаТЧ.Количество);
		Структура.Вставить("ШтампЭмалировщика", СтрокаТЧ.Серия.бит_Эмалировщик.Код);
		Структура.Вставить("ШтампКонтролера", СтрокаТЧ.бит_ШтампКонтролера);
		Структура.Вставить("Смена", СтрокаТЧ.Серия.бит_Смена);
