&НаКлиенте
Процедура ПечатьЛистаПеремаркировки(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаСерииДляПеремаркировки" Тогда
		ТекущиеДанные = Элементы.СписокДокументовПеремаркировки.ТекущиеДанные;
	Иначе	
		ТекущиеДанные = Элементы.СкладскиеДокументы.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные <> Неопределено 
		И ТипЗнч(ТекущиеДанные.ДокументСсылка) = Тип("ДокументСсылка.ПроизводствоБезЗаказа") Тогда
		
		ТабличныйДокумент = СформироватьПечатьЛистаПеремаркировкиНаСервере(ТекущиеДанные.ДокументСсылка);
		
		КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ЛистПеремаркировки");
		КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
		КоллекцияПечатныхФорм[0].Экземпляров = 1;
		КоллекцияПечатныхФорм[0].СинонимМакета = "ЛистПеремаркировки";  // используется для формирования имени файла при сохранении из общей формы печати документов
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьПечатьЛистаПеремаркировкиНаСервере(ДокументСсылка)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Обрабаботка = РеквизитФормыВЗначение("Объект");
	
	Макет = Обрабаботка.ПолучитьМакет("МакетЛистПеремаркировки");
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("ОбластьСтрокаТаблицы");
