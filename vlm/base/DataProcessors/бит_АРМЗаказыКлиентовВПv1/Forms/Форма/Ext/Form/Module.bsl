#КонецОбласти

&НаКлиенте
Процедура СписокЗаказовПриАктивизацииСтроки(Элемент)
	
	ТД = Элементы.СписокЗаказов1.ТекущиеДанные;
	Если ТД <> Неопределено Тогда
		ТекЗаказ = ТД.Ссылка;
		Дата = ОбщегоНазначенияКлиент.ДатаСеанса();//ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекЗаказ, "Дата");
	Иначе
		ТекЗаказ = ПредопределенноеЗначение("Документ.ЗаказКлиента.ПустаяСсылка");       
		Дата = Дата("00010101");
	КонецЕсли;  
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НоменклатураЗаказа, "ЗаказКлиента", ТекЗаказ, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НоменклатураЗаказа, "ДатаЗаказа", Дата, Истина);
	
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ОплатыПоЗаказу, "ЗаказКлиента", ТекЗаказ, Истина);
	
КонецПроцедуры                      

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Календарь = Справочники.бит_ЗначенияПоУмолчанию.КалендарьПоУмолчанию;
	Если Календарь.Значения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен календарь по умолчанию 'Российская Федерация'", Календарь);
		Закрыть();
	КонецЕсли;
	Календарь = Календарь.Значения[0].Значение;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокЗаказов1, "Календарь", Календарь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокЗаказов1, "КоличествоРабочихДней", 10, Истина); 
	
	ТекЗаказ = ПредопределенноеЗначение("Документ.ЗаказКлиента.ПустаяСсылка"); 
	Дата = Дата("00010101");
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НоменклатураЗаказа, "ЗаказКлиента", ТекЗаказ, Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НоменклатураЗаказа, "ДатаЗаказа", Дата, Истина);

    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ОплатыПоЗаказу, "ЗаказКлиента", ТекЗаказ, Истина);	
    
КонецПроцедуры
