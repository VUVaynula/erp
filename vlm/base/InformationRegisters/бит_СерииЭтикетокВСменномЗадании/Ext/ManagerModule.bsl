Функция СформироватьДанныеДляПечатиЭтикетокИзСменногоЗадания(Структура) Экспорт
// {{ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [19.11.2025 20:08:45] +        

	//ТабличныйДокумент = Новый ТабличныйДокумент;

	//ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЭТИКЕТКАДЛЯСМЕННОГОЗАДАНИЯ";

	ПризнакМаркаГотовойПродукции = ПолучитьЗначениеПризнака(Структура.Номенклатура, Справочники.бит_ЗначенияПоУмолчанию.ПризнакMARKA);
	ЗначениеГост = ПолучитьЗначениеПризнака(Структура.Номенклатура, Справочники.бит_ЗначенияПоУмолчанию.ПризнакГОСТ);
	ЗначениеРазмер = ПолучитьЗначениеПризнака(Структура.Номенклатура, Справочники.бит_ЗначенияПоУмолчанию.ПризнакРазмерГотовойПродукции);
	
	ДопСвойство = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШтампЭмалировщика, , Истина);
	ШтампЭмалировщика = УправлениеСвойствами.ЗначениеСвойства(Структура.Исполнитель, ДопСвойство);
	 
	Штрихкод = ПолучитьШтрихкодНоменклатуры46(Структура.Номенклатура);

	МашинаХод = "м. " + Структура.ВидРабочегоЦентра.Родитель + " x. " + Структура.ВидРабочегоЦентра; // ЛТ 5.36 поменял с РЦ на ВРЦ
	
	ТипЧисло10_2 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10,2));
	ТипШаблон = Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенников");
	ТипДата = Новый ОписаниеТипов("Дата");
	ТипСтрока1020 = Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(1020));
	
	ТаблицаЗначений = новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЗначений.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));	
	ТаблицаЗначений.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));	 	
	ТаблицаЗначений.Колонки.Добавить("Цена", ТипЧисло10_2);	
	ТаблицаЗначений.Колонки.Добавить("ЦенаДополнительно", ТипЧисло10_2);
	ТаблицаЗначений.Колонки.Добавить("Штрихкод", ТипСтрока1020); 
	//ТаблицаЗначений.Колонки.Добавить("ШКод", ТипСтрока400); 
	ТаблицаЗначений.Колонки.Добавить("ШаблонЦенника", ТипШаблон);
	ТаблицаЗначений.Колонки.Добавить("КоличествоЦенников", ТипЧисло10_2);
	ТаблицаЗначений.Колонки.Добавить("ШаблонЭтикетки", ТипШаблон);	
	ТаблицаЗначений.Колонки.Добавить("ШаблонЭтикеткиПодготовлено", ТипШаблон);
	ТаблицаЗначений.Колонки.Добавить("КоличествоЭтикеток", ТипЧисло10_2);
	ТаблицаЗначений.Колонки.Добавить("ОстатокНаСкладе", ТипЧисло10_2);
	ТаблицаЗначений.Колонки.Добавить("КоличествоВДокументе", ТипЧисло10_2);
	ТаблицаЗначений.Колонки.Добавить("Весовой", Новый ОписаниеТипов("Булево"));	
	ТаблицаЗначений.Колонки.Добавить("ДатаПоследнегоИзмененияЦены", ТипДата);
	ТаблицаЗначений.Колонки.Добавить("ДатаПоследнегоИзмененияЦеныДополнительно", ТипДата);
	
	//ТипДопЗначениеБит = Новый ОписаниеТипов("СправочникСсылка.бит_ДополнительныеПризнакиНоменклатуры");	
	
	ТаблицаЗначений.Колонки.Добавить("МаркаГотовойПродукции", ТипСтрока1020);	  
	ТаблицаЗначений.Колонки.Добавить("НомерСерии", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТаблицаЗначений.Колонки.Добавить("ШКСерии", ТипСтрока1020); 
	ТаблицаЗначений.Колонки.Добавить("СтандартGOST", ТипСтрока1020);
	ТаблицаЗначений.Колонки.Добавить("РазмерRAZMER", ТипСтрока1020);
	ТаблицаЗначений.Колонки.Добавить("МашинаХод", ТипСтрока1020);
	ТаблицаЗначений.Колонки.Добавить("СменаДата", ТипСтрока1020);
	ТаблицаЗначений.Колонки.Добавить("ШтампЭмалировщика", ТипСтрока1020);
	
	//МассивДанныхДляПечати = Новый Массив;
	Для каждого текСерия из Структура.МассивСерий Цикл
		нов = ТаблицаЗначений.Добавить();
		нов.Номенклатура = Структура.Номенклатура;
		нов.Штрихкод = Штрихкод;
		//нов.ШКод = Штрихкод;	
		нов.КоличествоЭтикеток = 1;
		
		нов.МаркаГотовойПродукции = ПризнакМаркаГотовойПродукции;	  
		нов.НомерСерии = текСерия;
		нов.ШКСерии = Справочники.СерииНоменклатуры.СгенерироватьСтрокуШК(текСерия);
		нов.СтандартGOST = ЗначениеГост;
		нов.РазмерRAZMER = ЗначениеРазмер;
		нов.МашинаХод = МашинаХод;
		нов.СменаДата = Структура.Смена.Наименование + "/" + формат(текСерия.ДатаПроизводства, "ДФ=dd.MM.yyyy");
		нов.ШтампЭмалировщика = ШтампЭмалировщика;
	КонецЦикла;
	
	Адрес = ПоместитьВоВременноеХранилище(ТаблицаЗначений);
	
	Возврат Адрес;
// }}ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [19.11.2025 20:08:45] -	
