
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьСменноеЗадание();
КонецПроцедуры

&НаКлиенте
Процедура ПроизводственнаяОперацияПриИзменении(Элемент)
	ЗаполнитьСменноеЗадание();
КонецПроцедуры                

&НаКлиенте
Процедура ЗаполнитьСменноеЗадание()
	
	Если ЗначениеЗаполнено(Запись.ПроизводственнаяОперация) 
		И ТипЗнч(Запись.ПроизводственнаяОперация) = Тип("ДокументСсылка.ПроизводственнаяОперация2_2") Тогда
		Элементы.СменноеЗадание.Видимость = Истина;              
		Смена = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Запись.ПроизводственнаяОперация, "СменноеЗадание");
		Элементы.СменноеЗадание.Заголовок = "" + Смена;
	Иначе
		Элементы.СменноеЗадание.Видимость = Ложь;
		Смена = ПредопределенноеЗначение("Документ.СменноеЗадание.ПустаяСсылка");
		Элементы.СменноеЗадание.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СменноеЗаданиеНажатие(Элемент)
	ОткрытьЗначение(Смена);
КонецПроцедуры
