	//Первыйбит ЛТ1.3 ЛапшовГ "GVLapshov@1cbit.ru" 03.02.2025 +
	Если Параметры.Свойство("Отбор") Тогда
		Если Параметры.Отбор.Свойство("Номенклатура") Тогда
			Запись.бит_Номенклатура = Параметры.Отбор.Номенклатура;
