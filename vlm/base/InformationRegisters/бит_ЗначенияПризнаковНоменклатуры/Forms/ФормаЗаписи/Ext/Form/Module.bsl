	КонецЕсли; 
	
	Если Параметры.Свойство("Источник") Тогда
		Запись.бит_Номенклатура = Параметры.Источник;
	КонецЕсли;
	//Первыйбит ЛТ1.3 ЛапшовГ "GVLapshov@1cbit.ru" 03.02.2025 -
КонецПроцедуры

