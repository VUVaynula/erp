
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запись.ДатаДобавления = ТекущаяДатаСеанса();
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	Запись.ВидРабочегоЦентра = ПолучитьВидРЦ();
КонецПроцедуры      

&НаСервере
Функция ПолучитьВидРЦ()
	
	ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
	Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		Спецификация = бит_ОбщегоНазначенияСервер.СпецификацияНоменклатуры(Запись.Номенклатура, Запись.ДатаДобавления);
		Операция = Неопределено;
		бит_ОбщегоНазначенияСервер.ПолучитьПоследниеЭтапОперацияПоСпецификации(Спецификация, , Операция);
		Если Операция <> Неопределено Тогда
			ВидРабочегоЦентра = Операция.РабочийЦентр;
		Иначе                   
			ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВидРабочегоЦентра;
	
КонецФункции
