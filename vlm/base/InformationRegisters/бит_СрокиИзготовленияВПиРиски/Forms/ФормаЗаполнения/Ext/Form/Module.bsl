
&НаКлиенте
асинх Процедура Записать(Команда)
	
	текст = НСтр("ru='Записать данные в регистр?'");	
	
	Обещание = ВопросАсинх(текст, РежимДиалогаВопрос.ДаНет);
	Результат = Ждать Обещание; 
	Если Результат = КодВозвратаДиалога.Да Тогда	
		ЗаписатьНаСервере();   
		Элементы.СписокНоменклатура.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	Если Вариант = 0 Тогда
		Схема = Элементы.СписокНоменклатура.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	    Настройки = Элементы.СписокНоменклатура.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	    
	    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
	    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	    
	    Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		Для каждого стр из Результат Цикл
			МЗ = РегистрыСведений.бит_СрокиИзготовленияВПиРиски.СоздатьМенеджерЗаписи(); 
			МЗ.Номенклатура = стр.Номенклатура;
			МЗ.ВидРабочегоЦентра = ВидРабочегоЦентра;
			МЗ.ВоеннаяПродукция = ВоеннаяПродукция;
			МЗ.СрокБазовыйДни = СрокБазовыйДни;
			МЗ.РискУвеличенияСрокаДни = РискУвеличенияСрокаДни;
			МЗ.ДатаДобавления = Дата;
			МЗ.Пользователь = Пользователь;
			МЗ.Записать(); 
		КонецЦикла;	
	Иначе
		Результат = Элементы.СписокНоменклатура.ВыделенныеСтроки;
		Для каждого стр из Результат Цикл
			МЗ = РегистрыСведений.бит_СрокиИзготовленияВПиРиски.СоздатьМенеджерЗаписи(); 
			МЗ.Номенклатура = стр;
			МЗ.ВидРабочегоЦентра = ВидРабочегоЦентра;
			МЗ.ВоеннаяПродукция = ВоеннаяПродукция;
			МЗ.СрокБазовыйДни = СрокБазовыйДни;
			МЗ.РискУвеличенияСрокаДни = РискУвеличенияСрокаДни;
			МЗ.ДатаДобавления = Дата;
			МЗ.Пользователь = Пользователь;
			МЗ.Записать(); 
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Дата = ТекущаяДатаСеанса();
	Пользователь = Пользователи.АвторизованныйПользователь();
КонецПроцедуры
