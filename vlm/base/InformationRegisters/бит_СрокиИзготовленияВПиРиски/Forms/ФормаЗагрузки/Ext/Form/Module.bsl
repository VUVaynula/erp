&НаКлиенте
Процедура Далее(Команда)
    Естьошибки = Ложь;
	Для сч = 2 по ТабличныйДокумент.ВысотаТаблицы Цикл                                        
		СоставноеНазвание = СокрЛП(ТабличныйДокумент.Область("R"+Формат(сч, "Ч=0")+"C1").Текст);
		СоставноеНазвание = СоставноеНазвание + ?(СоставноеНазвание = "", "", " ") + СокрЛП(ТабличныйДокумент.Область("R"+Формат(сч, "Ч=0")+"C2").Текст);
		СоставноеНазвание = СоставноеНазвание + ?(СоставноеНазвание = "", "", " ") + СокрЛП(ТабличныйДокумент.Область("R"+Формат(сч, "Ч=0")+"C3").Текст);
		ТабличныйДокумент.Область("R"+Формат(сч, "Ч=0")+"C5").Текст	= СоставноеНазвание;	
		
		ДатаСтрока = СокрЛП(ТабличныйДокумент.Область("R"+Формат(сч, "Ч=0")+"C12").Текст);	
		Попытка
			чДаты = СтрРазделить(ДатаСтрока, ".");
			ДатаЧислом = Дата(чДаты[2]+чДаты[1]+чДаты[0]);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("в строке " + сч + " не удалось преобразовать " + ДатаСтрока + " к дате");
			Естьошибки = Истина;
		КонецПопытки;
	КонецЦикла;

	Если Естьошибки Тогда
		Возврат;
	КонецЕсли;
	
	
	ЗаполненыНоменклатураКодАртикулШтрихкод = ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C5").Текст);
			
	Если Не ЗаполненыНоменклатураКодАртикулШтрихкод Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Необходимо скопировать колонки в таблицу из внешнего файла.';
													|en = 'You must copy columns to the table from an external file.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C6").Текст) И Не ЗначениеЗаполнено(ТабличныйДокумент.Область("R2C7").Текст)  Тогда 
		ПоказатьПредупреждение(Неопределено, "Не заполнен вид рабочего центра");
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	Состояние(НСтр("ru = 'Осуществляется сопоставление введенных данных с данными информационной базы. Пожалуйста подождите...';
					|en = 'Entered data is being mapped with the infobase data. Please wait...'"),,,БиблиотекаКартинок.Информация32);
	СопоставитьДанныеТабличногоДокументаСДаннымиИБ();

	Элементы.Шаги.ТекущаяСтраница = Элементы.Шаг2;
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	Элементы.Шаги.ТекущаяСтраница = Элементы.Шаг1;
КонецПроцедуры

&НаКлиенте
асинх Процедура ПеренестиТовары(Команда)
	
	текст = НСтр("ru='Записать данные в регистр?'");	
	
	Обещание = ВопросАсинх(текст, РежимДиалогаВопрос.ДаНет);
	Результат = Ждать Обещание; 
	Если Результат = КодВозвратаДиалога.Да Тогда	
		ЗаписатьНаСервере();   
	КонецЕсли;
    ОбщегоНазначенияКлиент.СообщитьПользователю("Обработка завершена");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	тзТовары = Товары.Выгрузить(, "Номенклатура, ВРЦ, ВП, Срок, Риск, Пользователь, Дата");
	тзТовары.Свернуть("Номенклатура, ВРЦ, ВП, Срок, Риск, Пользователь, Дата");
	//Дата = ТекущаяДатаСеанса();
	//Пользователь = Пользователи.АвторизованныйПользователь();
	Для каждого стр из тзТовары Цикл
		Если Не ЗначениеЗаполнено(стр.Срок) и Не ЗначениеЗаполнено(стр.Риск) 
			Или Не ЗначениеЗаполнено(стр.Номенклатура)
			Или Не ЗначениеЗаполнено(стр.ВРЦ) Тогда
			Продолжить;
		КонецЕсли;
		
		МЗ = РегистрыСведений.бит_СрокиИзготовленияВПиРиски.СоздатьМенеджерЗаписи(); 
		МЗ.Номенклатура = стр.Номенклатура;
		МЗ.ВидРабочегоЦентра = стр.ВРЦ;
		МЗ.ВоеннаяПродукция = стр.ВП;
		МЗ.СрокБазовыйДни = стр.Срок;
		МЗ.РискУвеличенияСрокаДни = стр.Риск;
		МЗ.ДатаДобавления = стр.Дата;
		МЗ.Пользователь = стр.Пользователь; 
		МЗ.Записать(); 
	КонецЦикла;
	
КонецПроцедуры

