		//	НайденныйВРЦПоКлючу = ТаблицаВРЦ.НайтиСтроки(Новый Структура("НаименованиеПоиск", СтрокаПоискаВРЦ));
		//	Для каждого ВРЦПоКлючу из НайденныйВРЦПоКлючу Цикл
		//		ДобавитьПодобранныйВРЦ(НомерСтроки, ВРЦПоКлючу.ВРЦ);
		//	КонецЦикла;
		//КонецЕсли;
		
		// Заполнение тч Товары.
		НоваяСтрокаТовары = Товары.Добавить();  
		НоваяСтрокаТовары.ЗагружаемаяМарка         	 = НоваяСтрока.Марка;
		НоваяСтрокаТовары.ЗагружаемоеСечение         = НоваяСтрока.Сечение;
		НоваяСтрокаТовары.ЗагружаемоеИсполнение      = НоваяСтрока.Исполнение; 
