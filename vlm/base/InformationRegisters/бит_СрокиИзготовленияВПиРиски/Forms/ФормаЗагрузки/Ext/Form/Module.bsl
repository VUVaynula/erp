&НаКлиентеНаСервереБезКонтекста
Функция ПрисвоитьЧисловоеЗначениеПриЗаполненииТЧ(Приемник, СтрокаИсточникЧисловогоЗначения, АбсолютныйНомерСтроки, НазваниеКолонки, ВысотаШапки = 0)
	
	Успех = Истина;
	
	ЗначениеДляПриведения = СтрЗаменить(СтрокаИсточникЧисловогоЗначения, " ", "");
	Если ЗначениеЗаполнено(ЗначениеДляПриведения) Тогда
		мТипов = Новый Массив;
		мТипов.Добавить(Тип("Число"));
		мТипов.Добавить(Тип("ОписаниеТипов"));
		ОписаниеТиповЧ = Новый ОписаниеТипов(мТипов);
		ПриведенноеЗначение = ОписаниеТиповЧ.ПривестиЗначение(ЗначениеДляПриведения);
		Если Не ПриведенноеЗначение = Неопределено Тогда
			Приемник = ПриведенноеЗначение;			
		Иначе
			Успех = Ложь;
			ТекстОшибки = НСтр("ru = 'В строке %НомерСтроки%, колонке ""%Колонка%"" введено значение ""%Значение%"", не являющееся числом.';
								|en = 'In line %НомерСтроки% in column ""%Колонка%"", value ""%Значение%"" is entered. The value is not a digit.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", АбсолютныйНомерСтроки-ВысотаШапки);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Колонка%", НазваниеКолонки);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Значение%", СтрокаИсточникЧисловогоЗначения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;	
	Иначе
		Приемник = 0;
	КонецЕсли;
	
	Возврат Успех; 
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрисвоитьБулевоЗначениеПриЗаполненииТЧ(Приемник, СтрокаИсточникЗначения)
	
	Успех = Истина;
	
	ЗначениеДляПриведения = СтрЗаменить(ВРег(СтрокаИсточникЗначения), "ЛОЖЬ", "");
	ЗначениеДляПриведения = СтрЗаменить(ЗначениеДляПриведения, "0", "");
	ЗначениеДляПриведения = СтрЗаменить(ВРег(ЗначениеДляПриведения), "НЕТ", "");
	ЗначениеДляПриведения = СтрЗаменить(ВРег(ЗначениеДляПриведения), "-", "");
	
	Приемник = ЗначениеЗаполнено(ЗначениеДляПриведения);

	Возврат Успех;                                    
	
КонецФункции


&НаКлиентеНаСервереБезКонтекста
Функция ПрисвоитьДату(Приемник, СтрокаИсточникЗначения)
	
	Успех = Истина;
	
	ДатаСтрока = СокрЛП(СтрокаИсточникЗначения);	
	Попытка
		чДаты = СтрРазделить(ДатаСтрока, ".");
		Приемник = Дата(чДаты[2]+чДаты[1]+чДаты[0]);
	Исключение
		Успех = Ложь;
	КонецПопытки;

	Возврат Успех;                                    
	
КонецФункции

&НаСервере
функция ВРЦ(Номенклатура, ДатаДобавления)
	
	ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Спецификация = бит_ОбщегоНазначенияСервер.СпецификацияНоменклатуры(Номенклатура, ДатаДобавления);
		Операция = Неопределено;
		бит_ОбщегоНазначенияСервер.ПолучитьПоследниеЭтапОперацияПоСпецификации(Спецификация, , Операция);
		Если Операция <> Неопределено Тогда
			ВидРабочегоЦентра = Операция.РабочийЦентр;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВидРабочегоЦентра;

КонецФункции

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)   

	ТД = Элементы.товары.ТекущиеДанные;
	Если ТД = Неопределено ТОгда
		Возврат;
	КонецЕсли;
	ТД.ВРЦ = ВРЦ(ТД.Номенклатура, ТД.Дата);

КонецПроцедуры

#КонецОбласти
