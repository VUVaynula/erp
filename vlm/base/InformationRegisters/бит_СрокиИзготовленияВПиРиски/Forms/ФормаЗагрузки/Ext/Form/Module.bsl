			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерСтроки%", НомерСтроки-ВысотаШапки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;                  
		
		Если ЗначениеЗаполнено(НоваяСтрокаТовары.Номенклатура) Тогда 	
			НоваяСтрокаТовары.ВРЦ = ВРЦ(НоваяСтрокаТовары.Номенклатура, НоваяСтрокаТовары.Дата);
		КонецЕсли;
		
