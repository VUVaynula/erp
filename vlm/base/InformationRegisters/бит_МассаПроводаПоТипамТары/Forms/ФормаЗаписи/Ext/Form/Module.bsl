

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбязательностьРеквизитов();  
	ДоступностьЭлементовФормы();
КонецПроцедуры                

&НаКлиенте
Процедура ОбязательностьРеквизитов()                  
	
	Элементы.Номенклатура.АвтоОтметкаНезаполненного = Не ЗначениеЗаполнено(Запись.Материал) 
														Или Не ЗначениеЗаполнено(Запись.Размер);
														
	Элементы.Размер.АвтоОтметкаНезаполненного = Не ЗначениеЗаполнено(Запись.Номенклатура);													
	
	Элементы.Материал.АвтоОтметкаНезаполненного = Не ЗначениеЗаполнено(Запись.Номенклатура);
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПризнакРазмерГотовойПродукции = Справочники.бит_ЗначенияПоУмолчанию.ПризнакРазмерГотовойПродукции;
    РазмерГотовойПродукции = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(ПризнакРазмерГотовойПродукции, , Истина);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", РазмерГотовойПродукции);
	
	НовыйМассив = Новый Массив;
    НовыйМассив.Добавить(НовыйПараметр);
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
    
    Элементы.Размер.ПараметрыВыбора = НовыеПараметры;
	
	Элементы.ДекорацияПодсказка.Заголовок = "Доступен ввод комбинаций данных:
	|1. 'Вид рабочего центра' + 'Размер' + 'Тара' + 'Материал' + 'Масса нетто кг'
	|2. 'Вид рабочего центра' + 'Тара' + 'Материал' + 'Масса нетто кг'";
КонецПроцедуры


&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)                                 
	
	ДоступностьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерПриИзменении(Элемент)

	ДоступностьЭлементовФормы();

КонецПроцедуры                  

&НаКлиенте
Процедура МатериалПриИзменении(Элемент)
	
	ДоступностьЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ДоступностьЭлементовФормы()
	
	Элементы.Размер.Доступность   = Не ЗначениеЗаполнено(Запись.Номенклатура);
	Элементы.Материал.Доступность = Не ЗначениеЗаполнено(Запись.Номенклатура);

	Элементы.Номенклатура.Доступность = Не ЗначениеЗаполнено(Запись.Размер) И Не ЗначениеЗаполнено(Запись.Материал);
	Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		Запись.Размер = ПредопределенноеЗначение("Справочник.бит_ДополнительныеПризнакиНоменклатуры.ПустаяСсылка");
		Запись.Материал = ПредопределенноеЗначение("Перечисление.бит_МатериалПровода.ПустаяСсылка");
	КонецЕсли;
	
	ОбязательностьРеквизитов();
	
КонецПроцедуры
