
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// {{ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [14.11.2025 14:32:48] +        
	// Номенклатура Не обязательно если заполнены Размер и Материал, иначе нет.
	// Размер обязательно если не заполнена номенклатура
	// Материал обязательно если не заполнена номенклатура
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	вт.Номенклатура КАК Номенклатура,
	                      |	вт.Размер КАК Размер,
	                      |	вт.Материал КАК Материал
	                      |ПОМЕСТИТЬ вт
	                      |ИЗ
	                      |	&вт КАК вт
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	МАКСИМУМ(ВЫБОР
	                      |			КОГДА вт.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                      |				ТОГДА ЛОЖЬ
	                      |			КОГДА вт.Материал <> ЗНАЧЕНИЕ(Перечисление.бит_МатериалПровода.ПустаяСсылка)
	                      |					И вт.Размер <> ЗНАЧЕНИЕ(Справочник.бит_ДополнительныеПризнакиНоменклатуры.ПустаяСсылка)
	                      |				ТОГДА ЛОЖЬ
	                      |			ИНАЧЕ ИСТИНА
	                      |		КОНЕЦ) КАК Ошибка
	                      |ИЗ
	                      |	вт КАК вт");
	Запрос.УстановитьПараметр("вт", ЭтотОбъект.Выгрузить(, "Номенклатура, Размер, Материал"));
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Отказ = Результат.Ошибка;
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены обязательные поля");
	КонецЕсли;
	
	// }}ПервыйБИТ ЛистТребований [ЛТ5.30]  [VUVaynula@1cbit.ru] [14.11.2025 14:32:48] -
КонецПроцедуры
