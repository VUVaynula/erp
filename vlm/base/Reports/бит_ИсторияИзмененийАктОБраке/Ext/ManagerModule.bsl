Процедура ПриОпределенииНастроек(Настройки) Экспорт 
	
	 Настройки.ДобавитьКомандыОтчетов = Истина;
     Настройки.Размещение.Добавить(Метаданные.Документы.бит_АктОБраке);
	 
КонецПроцедуры   
   
Функция ДобавитьКомандуОтчета(КомандыОтчетов, ИсточникВызова = "") Экспорт

	 Если ПравоДоступа("Просмотр", Метаданные.Отчеты.бит_ИсторияИзмененийАктОБраке) Тогда
			
		КомандаОтчет = КомандыОтчетов.Добавить();
		
		КомандаОтчет.Менеджер = Метаданные.Отчеты.бит_ИсторияИзмененийАктОБраке.ПолноеИмя();
		КомандаОтчет.Представление = НСтр("ru = 'История изменений документа Акт о браке'");
		КомандаОтчет.МножественныйВыбор = Истина;
		КомандаОтчет.Важность = "Обычное";
		КомандаОтчет.КлючВарианта = "Основной";
		Возврат КомандаОтчет;
		
	 КонецЕсли;

	 Возврат Неопределено;

 КонецФункции  
 
 Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	 
	 Параметры = ЭтаФорма.Параметры;
     Если Параметры.Свойство("ПараметрКоманды") Тогда
          ЭтаФорма.ФормаПараметры.Отбор.Вставить("Ссылка", Параметры.ПараметрКоманды);
	  КонецЕсли;
	  
КонецПроцедуры
 
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	НастройкиВарианта.Описание = НСтр("ru = 'Основной'"); 
	НастройкиВарианта.ОпределитьНастройкиФормы = Истина;
	
КонецПроцедуры