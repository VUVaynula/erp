		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_БракВозвратСрезкаПродукции.Номенклатура КАК Номенклатура,
	бит_БракВозвратСрезкаПродукции.ВиновноеЛицо КАК ФИОВиновника,
	бит_БракВозвратСрезкаПродукции.КоличествоИсправимогоБракаПоВинеРаботника КАК ИсправленныйБракКоличество,
	бит_БракВозвратСрезкаПродукции.СтоимостьИсправимогоБракаПоВинеРаботника КАК ИсправленныйБракСумма,
	бит_БракВозвратСрезкаПродукции.КоличествоОкончательногоБракаПоВинеРаботника КАК ОкончательныйБракКоличество,
	бит_БракВозвратСрезкаПродукции.СтоимостьОкончательногоБракаПоВинеРаботника КАК ОкончательныйБракСумма,
	НАЧАЛОПЕРИОДА(бит_БракВозвратСрезкаПродукции.Регистратор.Дата, ДЕНЬ) КАК Период,
	бит_БракВозвратСрезкаПродукции.Регистратор.Номер + ВЫБОР
		КОГДА бит_БракВозвратСрезкаПродукции.Регистратор ССЫЛКА Документ.ЗаявкаНаВозвратТоваровОтКлиента
			ТОГДА "(В)"
		ИНАЧЕ ""
	КОНЕЦ КАК АктНомер,
	бит_БракВозвратСрезкаПродукции.Регистратор КАК Регистратор
ПОМЕСТИТЬ База
ИЗ
	РегистрСведений.бит_БракВозвратСрезкаПродукции КАК бит_БракВозвратСрезкаПродукции
ГДЕ
	бит_БракВозвратСрезкаПродукции.Статус В (ЗНАЧЕНИЕ(Перечисление.бит_СтатусыОБраке.РассмотренНаКомиссии), ЗНАЧЕНИЕ(Перечисление.бит_СтатусРекламации.Признана), ЗНАЧЕНИЕ(Перечисление.бит_СтатусРекламации.ПризнанаЧастично))
{ГДЕ
	(НАЧАЛОПЕРИОДА(бит_БракВозвратСрезкаПродукции.Регистратор.Дата, ДЕНЬ) &gt;= &amp;НачалоПериода),
	(КОНЕЦПЕРИОДА(бит_БракВозвратСрезкаПродукции.Регистратор.Дата, ДЕНЬ) &lt;= &amp;КонецПериода)}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	База.Номенклатура КАК Номенклатура,
	База.ФИОВиновника КАК ФИОВиновника,
	СУММА(База.ИсправленныйБракКоличество) КАК ИсправленныйБракКоличество,
	СУММА(База.ИсправленныйБракСумма) КАК ИсправленныйБракСумма,
	СУММА(База.ОкончательныйБракКоличество) КАК ОкончательныйБракКоличество,
	СУММА(База.ОкончательныйБракСумма) КАК ОкончательныйБракСумма,
	База.Период КАК Период,
	База.АктНомер КАК АктНомер,
	ЕСТЬNULL(влПризнакМАРКА.Маркоразмер, "") КАК Маркоразмер,
	База.Регистратор КАК Регистратор
ИЗ
	База КАК База
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура КАК бит_Номенклатура,
			бит_ЗначенияПризнаковНоменклатуры.бит_Значение КАК Маркоразмер
		ИЗ
			РегистрСведений.бит_ЗначенияПризнаковНоменклатуры КАК бит_ЗначенияПризнаковНоменклатуры
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ База КАК База
				ПО бит_ЗначенияПризнаковНоменклатуры.бит_Номенклатура = База.Номенклатура
		ГДЕ
			бит_ЗначенияПризнаковНоменклатуры.бит_Признак В
					(ВЫБРАТЬ ПЕРВЫЕ 1
						бит_ЗначенияПоУмолчаниюЗначения.Значение КАК Значение
					ИЗ
						Справочник.бит_ЗначенияПоУмолчанию.Значения КАК бит_ЗначенияПоУмолчаниюЗначения
					ГДЕ
						бит_ЗначенияПоУмолчаниюЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.бит_ЗначенияПоУмолчанию.ПризнакMARKA))) КАК влПризнакМАРКА
		ПО (влПризнакМАРКА.бит_Номенклатура = База.Номенклатура)

СГРУППИРОВАТЬ ПО
	База.АктНомер,
	База.Период,
	ЕСТЬNULL(влПризнакМАРКА.Маркоразмер, ""),
	База.Номенклатура,
	База.ФИОВиновника,
	База.Регистратор

УПОРЯДОЧИТЬ ПО
	АктНомер</query>
