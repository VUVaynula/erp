		|	вт_Сотрудники.СуммаГПХ КАК Всего,
		|	вт_Сотрудники.ЭтоГПХ КАК ЭтоГПХ,
		|	СоставГруппСотрудников.ГруппаСотрудников КАК Служба
		|ИЗ
		|	вт_Сотрудники КАК вт_Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппСотрудников КАК СоставГруппСотрудников
		|		ПО вт_Сотрудники.Сотрудник = СоставГруппСотрудников.Сотрудник
		|ГДЕ
		|	вт_Сотрудники.ЭтоГПХ
		|	И ВЫБОР
		|			КОГДА &ГруппаСотрудников <> ЗНАЧЕНИЕ(Справочник.ГруппыСотрудников.ПустаяСсылка)
		|				ТОГДА СоставГруппСотрудников.ГруппаСотрудников = &ГруппаСотрудников
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_Сотрудники.Должность,
		|	вт_Сотрудники.Организация,
		|	вт_Сотрудники.Подразделение,
		|	вт_Сотрудники.Сотрудник,
		|	вт_Сотрудники.СуммаГПХ,
		|	вт_Сотрудники.ЭтоГПХ,
		|	СоставГруппСотрудников.ГруппаСотрудников,
		|	вт_Сотрудники.СуммаГПХ";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ГруппаСотрудников", Объект.Служба);
	Запрос.УстановитьПараметр("Должность", Объект.Должность);
	Запрос.УстановитьПараметр("Сотрудник", Объект.Сотрудник);
	Запрос.УстановитьПараметр("ДолжностиДляНормативнойПремии", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ДолжностиДляРасчетаВыполнениеПоВыпускуПроцентВНормативнойПремии, ЭтотОбъект, Ложь));
	
	Запрос.УстановитьПараметр("НачислениеОтпуска", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.НачислениеОтпуска, ЭтотОбъект, Ложь));
	Запрос.УстановитьПараметр("ПоказательНормативнаяЗарплата", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПоказательНормативнаяЗарплата, ЭтотОбъект, Истина));
	Запрос.УстановитьПараметр("ЗаполнениеИтогоНачислений", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ЗаполнениеИтогоНачислений, ЭтотОбъект, Ложь));
	Запрос.УстановитьПараметр("ЗаполнениеПримечание", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ЗаполнениеПримечание, ЭтотОбъект, Ложь));
    	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеНормативнойПремии =  РезультатЗапроса[РезультатЗапроса.Количество()-3].Выгрузить();
	Расшифровка =  РезультатЗапроса[РезультатЗапроса.Количество()-2].Выгрузить();
	ГПХ =  РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
	
	Объект.ДанныеНормативнойПремии.Загрузить(ДанныеНормативнойПремии);
	Объект.Расшифровка.Загрузить(Расшифровка);
	
	Для Каждого СтрокаТЧ Из Объект.ДанныеНормативнойПремии Цикл
		СтрокаТЧ.НормативнаяПремияИтого = Окр(СтрокаТЧ.НормативнаяПремияИтого, 0);	
	КонецЦикла;
	
	//ИТОГО:
	//
	//Нормативная ЗП
	//План, ч
	//Факт, ч
	//Итого начислений
	//Оклад
	//Нормативная премия
	//ВСЕГО
	//Вычет за брак
	//Нормативная премия ИТОГО
	
	НормативнаяЗП = 0;
	План = 0;
	Факт = 0;
	ИтогоНачислений = 0;
	ИтогоНачисленийБезОтпуска = 0;
	Оклад = 0;
	НормативнаяПремия = 0;
	Всего = 0;
	ВычетЗаБрак = 0;
	НормативнаяПремияИтого = 0;
	
	Если ДанныеНормативнойПремии.Количество() <> 0 Тогда
		
		Для Каждого СтрокаТЧ Из ДанныеНормативнойПремии Цикл
				
			НормативнаяЗП = НормативнаяЗП + СтрокаТЧ.НормативнаяЗП;
			План = План + СтрокаТЧ.План;
			Факт = Факт + СтрокаТЧ.Факт;
			ИтогоНачислений = ИтогоНачислений + СтрокаТЧ.ИтогоНачислений;
			ИтогоНачисленийБезОтпуска = ИтогоНачисленийБезОтпуска + СтрокаТЧ.ИтогоНачисленийБезОтпуска;;
			Оклад = Оклад + СтрокаТЧ.Оклад;
			НормативнаяПремия = НормативнаяПремия + СтрокаТЧ.НормативнаяПремия;
			Всего = Всего + СтрокаТЧ.Всего;
			//ВычетЗаБрак = ВычетЗаБрак + СтрокаТЧ.ВычетЗаБрак;
			НормативнаяПремияИтого = НормативнаяПремияИтого + Окр(СтрокаТЧ.НормативнаяПремияИтого, 0);	
			
		КонецЦикла;
		
		НоваяСтрока = Объект.ДанныеНормативнойПремии.Добавить();
		НоваяСтрока.Служба = "ИТОГО:";
		
		НоваяСтрока.НормативнаяЗП = НормативнаяЗП;
		НоваяСтрока.План = План;
		НоваяСтрока.Факт = Факт;
		НоваяСтрока.ИтогоНачислений = ИтогоНачислений;
		НоваяСтрока.ИтогоНачисленийБезОтпуска = ИтогоНачисленийБезОтпуска;
		НоваяСтрока.Оклад = Оклад;
		НоваяСтрока.НормативнаяПремия = НормативнаяПремия;
		НоваяСтрока.Всего = Всего;
		НоваяСтрока.ВычетЗаБрак = ВычетЗаБрак;
		НоваяСтрока.НормативнаяПремияИтого = НормативнаяПремияИтого;
		НоваяСтрока.ЭтоИтоговаяСтрока = Истина;
		
	КонецЕсли;
	
	ИтогоНачисленийГПХ = 0;
	
	Если ГПХ.Количество() <> 0 Тогда
		
		Для Каждого СтрокаГПХ Из ГПХ Цикл
			НоваяСтрока = Объект.ДанныеНормативнойПремии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГПХ);
			ИтогоНачисленийГПХ = ИтогоНачисленийГПХ + НоваяСтрока.ИтогоНачислений;
		КонецЦикла;
		
		НоваяСтрока = Объект.ДанныеНормативнойПремии.Добавить();
		НоваяСтрока.Служба = "ИТОГО С ГПХ:";
		НоваяСтрока.ЭтоГПХ = Истина;
		НоваяСтрока.ИтогоНачислений = ИтогоНачислений + ИтогоНачисленийГПХ;
		НоваяСтрока.Всего = Всего + ИтогоНачисленийГПХ;
		НоваяСтрока.ЭтоИтоговаяСтрока = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РасчитатьПремиюЗаМногостаночноеОбслуживаниеНаСервре()

	Объект.ДанныеПремииЗаМногостаночноеОбслуживание.Очистить();
	Объект.ДанныеПремииЗаМногостаночноеОбслуживаниеДополнительноеВремя.Очистить();
	Объект.ПремииЗаМногостаночноеОбслуживаниеРасшифровка.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадроваяИсторияСотрудниковИнтервальный.Организация КАК Организация,
		|	КадроваяИсторияСотрудниковИнтервальный.Подразделение КАК Подразделение,
		|	КадроваяИсторияСотрудниковИнтервальный.Должность КАК Должность,
		|	КадроваяИсторияСотрудниковИнтервальный.Сотрудник КАК Сотрудник,
		|	КадроваяИсторияСотрудниковИнтервальный.ДатаНачала КАК ДатаНачала,
		|	КадроваяИсторияСотрудниковИнтервальный.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ вт_Сотрудники
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудниковИнтервальный КАК КадроваяИсторияСотрудниковИнтервальный
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗанятостьПозицийШтатногоРасписанияИнтервальный КАК ЗанятостьПозицийШтатногоРасписанияИнтервальный
		|		ПО КадроваяИсторияСотрудниковИнтервальный.Сотрудник = ЗанятостьПозицийШтатногоРасписанияИнтервальный.Сотрудник
		|			И КадроваяИсторияСотрудниковИнтервальный.ДатаОкончания = ЗанятостьПозицийШтатногоРасписанияИнтервальный.ДатаОкончания
		|			И КадроваяИсторияСотрудниковИнтервальный.ГоловнаяОрганизация = ЗанятостьПозицийШтатногоРасписанияИнтервальный.ГоловнаяОрганизация
		|			И КадроваяИсторияСотрудниковИнтервальный.ФизическоеЛицо = ЗанятостьПозицийШтатногоРасписанияИнтервальный.ФизическоеЛицо
		|ГДЕ
		|	КадроваяИсторияСотрудниковИнтервальный.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &Должность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
		|				ТОГДА КадроваяИсторияСотрудниковИнтервальный.Должность = &Должность
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|				ТОГДА КадроваяИсторияСотрудниковИнтервальный.Сотрудник = &Сотрудник
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И КадроваяИсторияСотрудниковИнтервальный.ДатаНачала < &ДатаОкончания
		|	И КадроваяИсторияСотрудниковИнтервальный.ДатаОкончания > &ДатаНачала
		|	И ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания.бит_ВыплачиваетсяПремияЗаМногостаночноеОбслуживание
		|	И ВЫБОР
		|			КОГДА &Подразделение <> ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
		|				ТОГДА КадроваяИсторияСотрудниковИнтервальный.Подразделение = &Подразделение
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Регистратор КАК ПроизводственнаяОперация,
		|	вт_Сотрудники.Организация КАК Организация,
		|	вт_Сотрудники.Подразделение КАК Подразделение,
		|	вт_Сотрудники.Должность КАК Должность,
		|	вт_Сотрудники.Сотрудник КАК Сотрудник,
		|	вт_Сотрудники.ДатаНачала КАК ДатаНачала,
		|	вт_Сотрудники.ДатаОкончания КАК ДатаОкончания,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Период КАК Период,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.ВремяВыполненияФакт КАК КоличествоЧасов,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.ДополнительноеОборудование КАК ДополнительноеОборудование,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Сверхурочное КАК Сверхурочное,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.НоменклатураВыпуска КАК Номенклатура,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.КоличествоПлан КАК ВесПлан,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.КоличествоФакт КАК ВесФакт,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.ВремяВыполненияФакт КАК НормоЧасы,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.СменноеЗадание КАК СменноеЗадание,
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.СменноеЗадание.Дата КАК СменноеЗаданиеДата
		|ПОМЕСТИТЬ вт_ПремиальныеПоказатели
		|ИЗ
		|	вт_Сотрудники КАК вт_Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты КАК бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты
		|		ПО вт_Сотрудники.Организация = бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Регистратор.Организация
		|			И вт_Сотрудники.Сотрудник = бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Регистратор.Исполнитель
		|ГДЕ
		|	бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И бит_ПремиальныеПоказателиОперацийДляРасчетаЗаработнойПлаты.Регистратор.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПремиальныеПоказатели.Период КАК Дата,
		|	вт_ПремиальныеПоказатели.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	МАКСИМУМ(бит_ЧТСЗаМногостаночность.Период) КАК Период
		|ПОМЕСТИТЬ вт_ДатыЧТС
		|ИЗ
		|	вт_ПремиальныеПоказатели КАК вт_ПремиальныеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЧТСЗаМногостаночность КАК бит_ЧТСЗаМногостаночность
		|		ПО вт_ПремиальныеПоказатели.ВидРабочегоЦентра = бит_ЧТСЗаМногостаночность.ВидРЦ
		|			И вт_ПремиальныеПоказатели.Период >= бит_ЧТСЗаМногостаночность.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПремиальныеПоказатели.Период,
		|	вт_ПремиальныеПоказатели.ВидРабочегоЦентра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ДатыЧТС.Дата КАК Дата,
		|	вт_ДатыЧТС.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	вт_ДатыЧТС.Период КАК Период,
		|	бит_ЧТСЗаМногостаночность.ЧТСДляПремии КАК ЧТСДляПремии
		|ПОМЕСТИТЬ ЗначенияЧТССрез
		|ИЗ
		|	вт_ДатыЧТС КАК вт_ДатыЧТС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЧТСЗаМногостаночность КАК бит_ЧТСЗаМногостаночность
		|		ПО вт_ДатыЧТС.ВидРабочегоЦентра = бит_ЧТСЗаМногостаночность.ВидРЦ
		|			И вт_ДатыЧТС.Период = бит_ЧТСЗаМногостаночность.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПремиальныеПоказатели.ПроизводственнаяОперация КАК ПроизводственнаяОперация,
		|	вт_ПремиальныеПоказатели.Организация КАК Организация,
		|	вт_ПремиальныеПоказатели.Подразделение КАК Подразделение,
		|	вт_ПремиальныеПоказатели.Должность КАК Должность,
		|	вт_ПремиальныеПоказатели.Сотрудник КАК Сотрудник,
		|	вт_ПремиальныеПоказатели.ДатаНачала КАК ДатаНачала,
		|	вт_ПремиальныеПоказатели.ДатаОкончания КАК ДатаОкончания,
		|	вт_ПремиальныеПоказатели.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	вт_ПремиальныеПоказатели.Период КАК Период,
		|	вт_ПремиальныеПоказатели.КоличествоЧасов КАК КоличествоЧасов,
		|	ЗначенияЧТССрез.ЧТСДляПремии КАК ЧТСДляПремии,
		|	вт_ПремиальныеПоказатели.ДополнительноеОборудование КАК ДополнительноеОборудование,
		|	вт_ПремиальныеПоказатели.Сверхурочное КАК Сверхурочное,
