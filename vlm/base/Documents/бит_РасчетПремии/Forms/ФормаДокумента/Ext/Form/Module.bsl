		|	вт_ПремиальныеПоказатели КАК вт_ПремиальныеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияЧТССрез КАК ЗначенияЧТССрез
		|		ПО вт_ПремиальныеПоказатели.ВидРабочегоЦентра = ЗначенияЧТССрез.ВидРабочегоЦентра
		|			И вт_ПремиальныеПоказатели.Период = ЗначенияЧТССрез.Дата
		|ГДЕ
		|	НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|	И вт_ПремиальныеПоказатели.Сверхурочное
		|	И ЕСТЬNULL(вт_ПремиальныеПоказатели.КоличествоЧасов * ЗначенияЧТССрез.ЧТСДляПремии, 0) <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПремиальныеПоказатели.Сотрудник,
		|	вт_ПремиальныеПоказатели.Подразделение,
		|	вт_ПремиальныеПоказатели.Должность,
		|	вт_ПремиальныеПоказатели.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПремиальныеПоказатели.Организация КАК Организация,
		|	вт_ПремиальныеПоказатели.Подразделение КАК Подразделение,
		|	вт_ПремиальныеПоказатели.Должность КАК Должность,
		|	вт_ПремиальныеПоказатели.Сотрудник КАК Сотрудник,
		|	вт_ПремиальныеПоказатели.ДатаНачала КАК ДатаНачала,
		|	вт_ПремиальныеПоказатели.ДатаОкончания КАК ДатаОкончания,
		|	вт_ПремиальныеПоказатели.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	вт_ПремиальныеПоказатели.Период КАК Период,
		|	вт_ПремиальныеПоказатели.КоличествоЧасов КАК КоличествоНормочасов,
		|	вт_ПремиальныеПоказатели.ДополнительноеОборудование КАК ДополнительноеОборудование,
		|	вт_ПремиальныеПоказатели.Сверхурочное КАК Сверхурочное,
		|	ВЫБОР
		|		КОГДА НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|				И вт_ПремиальныеПоказатели.Сверхурочное
		|			ТОГДА 1.5
		|		ИНАЧЕ 1
		|	КОНЕЦ * вт_ПремиальныеПоказатели.КоличествоЧасов * ЗначенияЧТССрез.ЧТСДляПремии КАК Сумма,
		|	вт_ПремиальныеПоказатели.НоменклатураВыпуска КАК НоменклатураВыпуска,
		|	вт_ПремиальныеПоказатели.СменноеЗадание КАК СменноеЗадание,
		|	ВЫБОР
		|		КОГДА НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|				И вт_ПремиальныеПоказатели.Сверхурочное
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДополнительноеВремя
		|ИЗ
		|	вт_ПремиальныеПоказатели КАК вт_ПремиальныеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияЧТССрез КАК ЗначенияЧТССрез
		|		ПО вт_ПремиальныеПоказатели.ВидРабочегоЦентра = ЗначенияЧТССрез.ВидРабочегоЦентра
		|			И вт_ПремиальныеПоказатели.Период = ЗначенияЧТССрез.Дата
		|ГДЕ
		|	(НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|				И НЕ вт_ПремиальныеПоказатели.Сверхурочное
		|			ИЛИ НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|				И вт_ПремиальныеПоказатели.Сверхурочное)
		|	И ЕСТЬNULL(ВЫБОР
		|				КОГДА НЕ вт_ПремиальныеПоказатели.ДополнительноеОборудование
		|						И вт_ПремиальныеПоказатели.Сверхурочное
		|					ТОГДА 1.5
		|				ИНАЧЕ 1
		|			КОНЕЦ * вт_ПремиальныеПоказатели.КоличествоЧасов * ЗначенияЧТССрез.ЧТСДляПремии, 0) <> 0";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("Должность", Объект.Должность);
	Запрос.УстановитьПараметр("Сотрудник", Объект.Сотрудник);
	//Запрос.УстановитьПараметр("ЧтсЗаСложность", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ЧТСЗаСложность, ЭтотОбъект, Истина));
	Запрос.УстановитьПараметр("СписокСложногоОборудованияДляПремии", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.СписокСложногоОборудованияДляПремии, ЭтотОбъект, Ложь));
	Запрос.УстановитьПараметр("РЦ201_202ДляПремии", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.РЦ201_202ДляПремии, ЭтотОбъект, Ложь));
	Запрос.УстановитьПараметр("НоменклатураВыпуска", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.СписокНоменклатурыДляРЦ201_202ДляПремии, ЭтотОбъект, Ложь));
    	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеПремииЗаСложность =  РезультатЗапроса[4].Выгрузить();
	ДанныеПремииЗаСложностьДополнительноеВремя =  РезультатЗапроса[5].Выгрузить();
	Расшифровка =  РезультатЗапроса[6].Выгрузить();
	
	Объект.ДанныеПремииЗаСложность.Загрузить(ДанныеПремииЗаСложность);
	Объект.ДанныеПремииЗаСложностьДополнительноеВремя.Загрузить(ДанныеПремииЗаСложностьДополнительноеВремя);
	Объект.ПремииЗаСложностьРасшифровка.Загрузить(Расшифровка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода", Объект.ДатаНачала, Объект.ДатаОкончания);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыФормы, Элементы.ВыборПериода, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачала    = РезультатВыбора.НачалоПериода;
	Объект.ДатаОкончания = РезультатВыбора.КонецПериода;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументДанныеДляРасчетаЗарплаты(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросСформироватьДокумент", ЭтотОбъект); 
 	ПоказатьВопрос(ОписаниеОповещения, "Вы действительно хотите сформировать документ?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросСформироватьДокумент(РезультатВопроса, СтруктураПараметров) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		НовыйДокумент = СформироватьДокументДанныеДляРасчетаЗарплатыНаСервере();	
		
		Если НовыйДокумент <> Неопределено Тогда
			
			ПараметрыФормы = новый Структура;
			ПараметрыФормы.вставить("Ключ", НовыйДокумент);
			ОткрытьФорму("Документ.ДанныеДляРасчетаЗарплаты.ФормаОбъекта", ПараметрыФормы);
			
		Иначе
			
			Сообщить("Нет данных для заполения документа!");	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция СформироватьДокументДанныеДляРасчетаЗарплатыНаСервере()
	
	НовыйДокумент = Документы.ДанныеДляРасчетаЗарплаты.СоздатьДокумент();
	НовыйДокумент.Дата = КонецМесяца(Объект.ДатаОкончания);
	НовыйДокумент.Организация = Объект.Организация;
	НовыйДокумент.Подразделение = Объект.Подразделение;
	НовыйДокумент.ПериодОкончания = КонецМесяца(Объект.ДатаОкончания);
	НовыйДокумент.Сотрудник = Объект.Сотрудник;
	НовыйДокумент.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокумент.Период = НачалоМесяца(Объект.ДатаОкончания);
	           
	ПоказательНормативнаяПремия = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПоказательНормативнаяПремия, ЭтотОбъект, Истина);
	ПоказательПремияЗаМногостаночноеОбслуживание = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПоказательПремияЗаМногостаночноеОбслуживание, ЭтотОбъект, Истина);
	ПоказательПремияЗаСложностьОборудования = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПоказательПремияЗаСложностьОборудования, ЭтотОбъект, Истина);
	
	Если Объект.ВидРасчетаПремии = ПредопределенноеЗначение("Перечисление.бит_ВидыРасчетаПремии.Нормативная") Тогда
		
		ВидДокумента = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШаблонДокументаНормативнаяПремия, ЭтотОбъект, Истина);	
				
		Для Каждого СтрокаПремии Из Объект.ДанныеНормативнойПремии Цикл
			
			Если СтрокаПремии.НормативнаяПремияИтого <> 0 Тогда
				
				Если НЕ СтрокаПремии.ЭтоИтоговаяСтрока Тогда
					
					НоваяСтрокаПремии = НовыйДокумент.ЗначенияПоказателей.Добавить();
					
					НоваяСтрокаПремии.Объект = СтрокаПремии.Сотрудник;
					НоваяСтрокаПремии.Показатель = ПоказательНормативнаяПремия;
					НоваяСтрокаПремии.Значение = СтрокаПремии.НормативнаяПремияИтого;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НовыйДокумент.ЗначенияПоказателей.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидРасчетаПремии = ПредопределенноеЗначение("Перечисление.бит_ВидыРасчетаПремии.ЗаМногостаночноеОбслуживание") Тогда
		
		ВидДокумента = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШаблонДокументаПремияЗаМногостаночноеОбслуживание, ЭтотОбъект, Истина);	
		
		Если Объект.ДанныеПремииЗаМногостаночноеОбслуживание.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого СтрокаПремии Из Объект.ДанныеПремииЗаМногостаночноеОбслуживание Цикл
		
			НоваяСтрокаПремии = НовыйДокумент.ЗначенияПоказателей.Добавить();
			
			НоваяСтрокаПремии.Объект = СтрокаПремии.Сотрудник;
			НоваяСтрокаПремии.Показатель = ПоказательПремияЗаМногостаночноеОбслуживание;
			НоваяСтрокаПремии.Значение = СтрокаПремии.Сумма;
			
		КонецЦикла;
	
	ИначеЕсли Объект.ВидРасчетаПремии = ПредопределенноеЗначение("Перечисление.бит_ВидыРасчетаПремии.ЗаСложность") Тогда
		
		ВидДокумента = Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ШаблонДокументаПремияЗаСложностьОборудования, ЭтотОбъект, Истина);	
		
		Если Объект.ДанныеПремииЗаСложность.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого СтрокаПремии Из Объект.ДанныеПремииЗаСложность Цикл
			
			НоваяСтрокаПремии = НовыйДокумент.ЗначенияПоказателей.Добавить();
			
			НоваяСтрокаПремии.Объект = СтрокаПремии.Сотрудник;
			НоваяСтрокаПремии.Показатель = ПоказательПремияЗаСложностьОборудования;
			НоваяСтрокаПремии.Значение = СтрокаПремии.Сумма;
		
		КонецЦикла;
		
	КонецЕсли;
	
	НовыйДокумент.ВидДокумента = ВидДокумента;
	
	НовыйДокумент.Записать();
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ПровереноПриИзменении(Элемент)
	УстановитьБоступностьКнопкиСформировать();
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьБоступностьКнопкиСформировать();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьБоступностьКнопкиСформировать()
	
	Элементы.СформироватьДокументДанныеДляРасчетаЗарплаты.Доступность = Объект.Проведен И Объект.Проверено;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеНормативнойПремииПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДанныеНормативнойПремии.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Сотрудник", ТекущиеДанные.Сотрудник));
		
		Элементы.Расшифровка.ОтборСтрок = ОтборСтрок;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеНормативнойПремииВычетЗаБракПриИзменении(Элемент)
	
	//Расчетное значение:
	//
	//1. Для сотрудников производства Нормативная премия от %выполнения - Вычет за брак
	//	
	//2. Для всех остальных сотрудников Нормативная премия - Вычет за брак 
	//		
	//		Необходимо предусмотреть возможность ручной корректировки расчетной суммы.
	
	ТекущиеДанные = Элементы.ДанныеНормативнойПремии.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.НормативнаяПремияИтого = ТекущиеДанные.НормативнаяПремияОтПроцентаВыполнения - ТекущиеДанные.ВычетЗаБрак;	
		РассчетИтога();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчетИтога()
	
	ВычетЗаБрак = 0; 
	НормативнаяПремияИтого = 0;
	
	НормативнаяЗП = 0;
	План = 0;         
	Факт = 0;
	ИтогоНачислений = 0;
	ИтогоНачисленийБезОтпуска = 0;
	Оклад = 0;
	НормативнаяПремия = 0;
	Всего = 0;
	НормативнаяПремияИтого = 0;
	Примечание = 0;
	СуммаОтпуска = 0;
	
	
	Для Каждого СтрокаТЧ Из Объект.ДанныеНормативнойПремии Цикл
		
		Если НЕ СтрокаТЧ.ЭтоГПХ 
			И НЕ СтрокаТЧ.ЭтоИтоговаяСтрока Тогда
			
			СтрокаТЧ.НормативнаяПремияИтого = Окр(СтрокаТЧ.НормативнаяПремияИтого, 0);
			
			ВычетЗаБрак = ВычетЗаБрак + СтрокаТЧ.ВычетЗаБрак;
			НормативнаяПремияИтого = НормативнаяПремияИтого + СтрокаТЧ.НормативнаяПремияИтого;
			
			НормативнаяЗП = НормативнаяЗП + СтрокаТЧ.НормативнаяЗП;
			План = План + СтрокаТЧ.План;         
			Факт = Факт + СтрокаТЧ.Факт;
			ИтогоНачислений = ИтогоНачислений + СтрокаТЧ.ИтогоНачислений;
			ИтогоНачисленийБезОтпуска = ИтогоНачисленийБезОтпуска + СтрокаТЧ.ИтогоНачисленийБезОтпуска;
			Оклад = Оклад + СтрокаТЧ.Оклад;
			НормативнаяПремия = НормативнаяПремия + СтрокаТЧ.НормативнаяПремия;
			Всего = Всего + СтрокаТЧ.Всего;
			//НормативнаяПремияИтого = НормативнаяПремияИтого + СтрокаТЧ.НормативнаяПремияИтого;
			Примечание = Примечание + СтрокаТЧ.Примечание;
			СуммаОтпуска = СуммаОтпуска + СтрокаТЧ.СуммаОтпуска;
			
		ИначеЕсли НЕ СтрокаТЧ.ЭтоГПХ 
			И СтрокаТЧ.ЭтоИтоговаяСтрока Тогда
			
			СтрокаТЧ.ВычетЗаБрак = ВычетЗаБрак;
			СтрокаТЧ.НормативнаяПремияИтого = НормативнаяПремияИтого;
			
			СтрокаТЧ.НормативнаяЗП = НормативнаяЗП;
			СтрокаТЧ.План = План;         
			СтрокаТЧ.Факт = Факт;
			СтрокаТЧ.ИтогоНачислений = ИтогоНачислений;
			СтрокаТЧ.ИтогоНачисленийБезОтпуска = ИтогоНачисленийБезОтпуска;
			СтрокаТЧ.Оклад = Оклад;
			СтрокаТЧ.НормативнаяПремия = НормативнаяПремия;
			СтрокаТЧ.Всего = 0;
			//СтрокаТЧ.НормативнаяПремияИтого = Всего;
			СтрокаТЧ.Примечание = Примечание;
			СтрокаТЧ.СуммаОтпуска = СуммаОтпуска;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ДанныеНормативнойПремииПослеУдаления(Элемент)
	РассчетИтога();
КонецПроцедуры


&НаКлиенте
Процедура ДанныеНормативнойПремииПередУдалением(Элемент, Отказ)    
	
	ТекущиеДанные = Элементы.ДанныеНормативнойПремии.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.ЭтоИтоговаяСтрока Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДанныеНормативнойПремииНормативнаяПремияИтогоПриИзменении(Элемент)
	РассчетИтога();
КонецПроцедуры
	
