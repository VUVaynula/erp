&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Проверено Тогда
		
		Если РольДоступна("ПолныеПрава")
			ИЛИ РольДоступна("Администрирование")
			ИЛИ РольДоступна("бит_НормативнаяПремияПослеПроверкиРедактирование") Тогда
			
			ЭтаФорма.ТолькоПросмотр = Ложь;
		Иначе
			
			ЭтаФорма.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СформироватьДокументДанныеДляРасчетаЗарплаты.Доступность = Объект.Проведен И Объект.Проверено;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.Свойство("ВидПремии") Тогда
			
			Объект.ВидРасчетаПремии = Параметры.ВидПремии;
					
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.ВидРасчетаПремии = Перечисления.бит_ВидыРасчетаПремии.Нормативная Тогда
		Элементы.Подразделение.Видимость = Ложь;
		Элементы.НормативнаяПремия.Видимость = Истина;
		Элементы.ПремияЗаМногостаночноеОбслуживание.Видимость = Ложь;
		Элементы.ПремияЗаСложность.Видимость = Ложь;
	ИначеЕсли Объект.ВидРасчетаПремии = Перечисления.бит_ВидыРасчетаПремии.ЗаМногостаночноеОбслуживание Тогда
		Элементы.Служба.Видимость = Ложь;
		Элементы.НормативнаяПремия.Видимость = Ложь;
		Элементы.ПремияЗаМногостаночноеОбслуживание.Видимость = Истина;
		Элементы.ПремияЗаСложность.Видимость = Ложь;
	ИначеЕсли Объект.ВидРасчетаПремии = Перечисления.бит_ВидыРасчетаПремии.ЗаСложность Тогда
		Элементы.Служба.Видимость = Ложь;
		Элементы.НормативнаяПремия.Видимость = Ложь;
		Элементы.ПремияЗаМногостаночноеОбслуживание.Видимость = Ложь;
		Элементы.ПремияЗаСложность.Видимость = Истина;
	КонецЕсли;	
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	////Условное оформление
	//Элемент = УсловноеОформление.Элементы.Добавить();
	//   Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Истина);	
	//Элемент.Использование = Истина;                                      
	//
	//ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	//ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СформироватьДокументДанныеДляРасчетаЗарплаты.Имя);
	//
	//ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	//ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	//
	////ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	////ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Проведен");
	////ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	////ОтборЭлемента.ПравоеЗначение =Истина;
	////ОтборЭлемента.Использование = Истина;
	//
	//ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Проверено");
	//ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	//ОтборЭлемента.ПравоеЗначение =Истина;
	//ОтборЭлемента.Использование = Истина; 
	
	ЭлементОформленияГолубой = УсловноеОформление.Элементы.Добавить();
    ЭлементОформленияГолубой.Использование = Истина;
    ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.ЛососьСветлый);
	ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
    
    ЭлементУсловияГолубой                = ЭлементОформленияГолубой.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементУсловияГолубой.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ДанныеНормативнойПремии.Уволен");
    ЭлементУсловияГолубой.ПравоеЗначение = Истина; 
    ЭлементУсловияГолубой.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементУсловияГолубой.Использование  = Истина;
    
    ОформляемоеПоле      = ЭлементОформленияГолубой.Поля.Элементы.Добавить();
    ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеНормативнойПремии");
	
	ЭлементОформленияГолубой = УсловноеОформление.Элементы.Добавить();
    ЭлементОформленияГолубой.Использование = Истина;
    ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЗеленый);
	ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
    
    ЭлементУсловияГолубой                = ЭлементОформленияГолубой.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементУсловияГолубой.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ДанныеНормативнойПремии.Служба");
    ЭлементУсловияГолубой.ПравоеЗначение = "ИТОГО:"; 
    ЭлементУсловияГолубой.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементУсловияГолубой.Использование  = Истина;
    
    ОформляемоеПоле      = ЭлементОформленияГолубой.Поля.Элементы.Добавить();
    ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеНормативнойПремии");
	
	ЭлементОформленияГолубой = УсловноеОформление.Элементы.Добавить();
    ЭлементОформленияГолубой.Использование = Истина;
    ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ЦветФона",  WebЦвета.СветлоЗолотистый);
	ЭлементОформленияГолубой.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",  Истина);
    
    ЭлементУсловияГолубой                = ЭлементОформленияГолубой.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементУсловияГолубой.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.ДанныеНормативнойПремии.Служба");
    ЭлементУсловияГолубой.ПравоеЗначение = "ИТОГО С ГПХ:"; 
    ЭлементУсловияГолубой.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементУсловияГолубой.Использование  = Истина;
    
    ОформляемоеПоле      = ЭлементОформленияГолубой.Поля.Элементы.Добавить();
    ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеНормативнойПремии");
	
КонецПроцедуры

