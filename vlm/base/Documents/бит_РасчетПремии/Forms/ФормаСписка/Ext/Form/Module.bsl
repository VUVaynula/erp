
&НаКлиенте
Процедура СоздатьНормативнаяПремия(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидПремии", ПредопределенноеЗначение("Перечисление.бит_ВидыРасчетаПремии.Нормативная"));
	
	ОткрытьФорму("Документ.бит_РасчетПремии.ФормаОбъекта", ПараметрыФормы);	
	
КонецПроцедуры

