&НаКлиенте
Процедура ДанныеСменыСерияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;   
	ТД = Элементы.ДанныеСмены.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если не ЗначениеЗаполнено(ТД.Номенклатура) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала нужно указать номенклатуру");
		Возврат;
	КонецЕсли;
	
	ПФ = новый Структура;
	ПФ.Вставить("ЗакрыватьПриВыборе", Истина);
	ПФ.Вставить("МножественныйВыбор", Ложь);
	ПФ.Вставить("РежимВыбора", Истина);
	Если ЗначениеЗаполнено(ТД.Серия) Тогда
		ПФ.Вставить("Ключ", ТД.Серия);
		ПФ.Вставить("ТекущаяСтрока", ТД.Серия);
	КонецЕсли;                   
	ПФ.Вставить("ВидНоменклатуры", ВладелецСерийВидаНоменклатуры(ТД.Номенклатура));
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыбора", ЭтотОбъект, ТД);
	
	Форма = ОткрытьФорму("Справочник.СерииНоменклатуры.ФормаВыбора", ПФ, ЭтаФорма,,,,ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ПользовательскийОтбор = Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Форма.Список.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	ПользовательскийОтбор.Элементы.Очистить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список,"бит_Завешено", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный, Новый УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбора(ВыбранноеЗначение, ТД) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТД.Серия = ВыбранноеЗначение;	
	ПриИзмененииСерии(ТД);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВладелецСерийВидаНоменклатуры(Номенклатура)
	
	ТекВид = Номенклатура.ВидНоменклатуры;
	Пока ЗначениеЗаполнено(ТекВид.ВладелецСерий) Цикл
		ТекВид = ТекВид.ВладелецСерий;
	КонецЦикла;    
	
	Возврат ТекВид;
	
КонецФункции

&НаКлиенте
Процедура ДанныеСменыНоменклатураПриИзменении(Элемент)
	
	ТД = Элементы.ДанныеСмены.ТекущиеДанные;
	СерияСоответствуетРеквизитам(ТД);
	
КонецПроцедуры                     

&НаКлиенте
Функция СерияСоответствуетРеквизитам(ТД)
	
	Если ЗначениеЗаполнено(ТД.Серия) Тогда
		Если Не ЗначениеЗаполнено(ТД.Номенклатура) 
			Или (ВладелецСерийВидаНоменклатуры(ТД.Номенклатура) <> ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТД.Серия, "ВидНоменклатуры")) Тогда
			
			ТД.Серия = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");  
			
			Возврат Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ДанныеСменыСерияПриИзменении(Элемент)
	
	ТД = Элементы.ДанныеСмены.ТекущиеДанные;
	ПриИзмененииСерии(ТД);
	
КонецПроцедуры                                             

&НаКлиенте
Процедура ПриИзмененииСерии(ТД)
	Если СерияСоответствуетРеквизитам(ТД) И ЗначениеЗаполнено(ТД.Серия) Тогда
		
		ДанныеСерии = СобратьДанныеСерииНаСервере(ТД.Серия);	
		Если не ЗначениеЗаполнено(ТД.Тара) Тогда
			ТД.Тара = ДанныеСерии.Тара;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТД.Весовщик) Тогда
			ТД.Весовщик = ДанныеСерии.Весовщик;
		КонецЕсли;
		Если не ЗначениеЗаполнено(ТД.Контроллер) Тогда
			ТД.Контроллер = ДанныеСерии.Контроллер;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТД.Количество) Тогда
			ТД.Количество = ДанныеСерии.Количество;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТД.Номенклатура) и ЗначениеЗаполнено(ТД.Серия) Тогда
		ТД.Назначение = НайтиНазначениеНаСервереБезКонтекста(ТД.Номенклатура, ТД.Серия);
	КонецЕсли;
	
КонецПроцедуры          

&НаСервереБезКонтекста
Функция НайтиНазначениеНаСервереБезКонтекста(Номенклатура, Серия)
	
	Возврат Документы.бит_ПартияЗавесов.НайтиНазначение(Номенклатура, Серия);
	
КонецФункции

&НаСервереБезКонтекста
Функция СобратьДанныеСерииНаСервере(Серия)
	
	Структура = Новый Структура;
	Структура.Вставить("Тара", Серия.бит_ТипТары);
	Структура.Вставить("Количество", Серия.бит_МассаНетто);
	Структура.Вставить("Контроллер", Серия.бит_Контроллёр);
	Структура.Вставить("Весовщик", Серия.бит_Весовщик);
	
	Возврат Структура;
	
КонецФункции

