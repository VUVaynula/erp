&НаСервере 
Процедура УстановитьУсловноеОформление()
    //Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
 	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Дата");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше; 
	ЭлементОтбора.ПравоеЗначение = ТекущаяДатаСеанса() - 864000; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось); 
    
	Для каждого элПоля Из Элементы.Список.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.бит_Статус");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.ПравоеЗначение = Перечисления.бит_СтатусыОБраке.РассмотренНаКомиссии; 
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый); 
    
	Для каждого элПоля Из Элементы.Список.ПодчиненныеЭлементы Цикл
		ОформляемоеПоле1 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле1.Поле = Новый ПолеКомпоновкиДанных(элПоля.Имя);
	КонецЦикла;
	
	Попытка
		Элементы.СписокКонтекстноеМенюСкопировать.Видимость   = Ложь;
		Элементы.СписокКонтекстноеМенюСкопировать.Доступность = Ложь;
		Элементы.ФормаСкопировать.Видимость                   = Ложь;
		Элементы.ФормаСкопировать.Доступность                 = Ложь;
	Исключение
	КонецПопытки;
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры


