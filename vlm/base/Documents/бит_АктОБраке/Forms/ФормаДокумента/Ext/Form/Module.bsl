&НаКлиенте
Процедура ДанныеОБракеСотрудникНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Смена) Тогда
		
		СотрудникиОтбора = ПолучитьСотрудниковОтбораНаСервере();
		
		Если СотрудникиОтбора.Количество() <> 0 
			И ТипЗнч(СотрудникиОтбора[0].Значение) = Тип("СправочникСсылка.Сотрудники") Тогда
		
			ФормаВыбора = ПолучитьФорму("Справочник.Сотрудники.ФормаВыбора",, Элемент);
		
		ИначеЕсли СотрудникиОтбора.Количество() <> 0 
			И ТипЗнч(СотрудникиОтбора[0].Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
			
			//ПараметрыОтркытия = Новый Структура;
			//ПараметрыОтркытия.Вставить("Организация", ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.ЗаказНаПроизводство, "Организация"));
			                            
			ФормаВыбора = ПолучитьФорму("Справочник.ФизическиеЛица.Форма.ФормаВыбораУП",, Элемент);
			
		Иначе
			  
			ФормаВыбора = ПолучитьФорму("Справочник.Сотрудники.ФормаВыбора",, Элемент);
			
		КонецЕсли;
		
		ЭлементОтбора = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных ("Ссылка");
		ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение     = СотрудникиОтбора;
		ЭлементОтбора.Использование      = Истина;
		ЭлементОтбора.РежимОтображения     = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ФормаВыбора.Открыть();	
		
		
		
	Иначе
		
		ТекстСообщения = "Сменное задание не выбрано!";
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтходыМатериалыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Отходы.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.ПрямыеЗатраты = ПолучитьСуммуПрямыхЗатрат(ТекущиеДанные.Материал);
		ОтходыКоличествоПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуПрямыхЗатрат(Номенклатура, БезОтбораПоСтатьям = Ложь)   
	
	ОсновнаяСпецификация = ПолучитьОсновнуюСпецификацию(Номенклатура, Объект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлановыеМатериальныеЗатратыОбороты.Калькуляция КАК Калькуляция,
		|	ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация КАК ПартияСпецификация,
		|	МАКСИМУМ(ПлановыеМатериальныеЗатратыОбороты.Калькуляция.Дата) КАК КалькуляцияДата
		|ПОМЕСТИТЬ вт_ПлановыеМатериальныеЗатраты
		|ИЗ
		|	РегистрНакопления.ПлановыеМатериальныеЗатраты.Обороты КАК ПлановыеМатериальныеЗатратыОбороты
		|ГДЕ
		|	ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация = &ПартияСпецификация
		|	И ПлановыеМатериальныеЗатратыОбороты.Калькуляция.Дата <= &ДатаДокумента
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация,
		|	ПлановыеМатериальныеЗатратыОбороты.Калькуляция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПлановыеПрочиеЗатратыОбороты.Калькуляция КАК Калькуляция,
		|	ПлановыеПрочиеЗатратыОбороты.ПартияСпецификация КАК ПартияСпецификация,
		|	МАКСИМУМ(ПлановыеПрочиеЗатратыОбороты.Калькуляция.Дата) КАК КалькуляцияДата
		|ПОМЕСТИТЬ вт_ПлановыеПрочиеЗатраты
		|ИЗ
		|	РегистрНакопления.ПлановыеПрочиеЗатраты.Обороты(, , , ) КАК ПлановыеПрочиеЗатратыОбороты
		|ГДЕ
		|	ПлановыеПрочиеЗатратыОбороты.ПартияСпецификация = &ПартияСпецификация
		|	И ПлановыеПрочиеЗатратыОбороты.Калькуляция.Дата <= &ДатаДокумента
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлановыеПрочиеЗатратыОбороты.ПартияСпецификация,
		|	ПлановыеПрочиеЗатратыОбороты.Калькуляция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПлановыеТрудозатратыОбороты.Калькуляция КАК Калькуляция,
		|	ПлановыеТрудозатратыОбороты.ПартияСпецификация КАК ПартияСпецификация,
		|	МАКСИМУМ(ПлановыеТрудозатратыОбороты.Калькуляция.Дата) КАК КалькуляцияДата
		|ПОМЕСТИТЬ вт_ПлановыеТрудозатратыОбороты
		|ИЗ
		|	РегистрНакопления.ПлановыеТрудозатраты.Обороты(, , , ) КАК ПлановыеТрудозатратыОбороты
		|ГДЕ
		|	ПлановыеТрудозатратыОбороты.ПартияСпецификация = &ПартияСпецификация
		|	И ПлановыеТрудозатратыОбороты.Калькуляция.Дата <= &ДатаДокумента
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлановыеТрудозатратыОбороты.ПартияСпецификация,
		|	ПлановыеТрудозатратыОбороты.Калькуляция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПлановыеМатериальныеЗатраты.Калькуляция КАК Калькуляция,
		|	вт_ПлановыеМатериальныеЗатраты.ПартияСпецификация КАК ПартияСпецификация,
		|	вт_ПлановыеМатериальныеЗатраты.КалькуляцияДата КАК КалькуляцияДата,
		|	СУММА(ЕСТЬNULL(ПлановыеМатериальныеЗатратыОбороты.СтоимостьБезНДСОборот, 0)) КАК СтоимостьОборот
		|ПОМЕСТИТЬ вт_Итого
		|ИЗ
		|	вт_ПлановыеМатериальныеЗатраты КАК вт_ПлановыеМатериальныеЗатраты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПлановыеМатериальныеЗатраты.Обороты КАК ПлановыеМатериальныеЗатратыОбороты
		|		ПО вт_ПлановыеМатериальныеЗатраты.Калькуляция = ПлановыеМатериальныеЗатратыОбороты.Калькуляция
		|			И вт_ПлановыеМатериальныеЗатраты.КалькуляцияДата = ПлановыеМатериальныеЗатратыОбороты.Калькуляция.Дата
		|			И вт_ПлановыеМатериальныеЗатраты.ПартияСпецификация = ПлановыеМатериальныеЗатратыОбороты.ПартияСпецификация
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &БезОтбораПоСтатьям
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ПлановыеМатериальныеЗатратыОбороты.СтатьяКалькуляции В (&СтатьяКалькуляции)
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПлановыеМатериальныеЗатраты.ПартияСпецификация,
		|	вт_ПлановыеМатериальныеЗатраты.Калькуляция,
		|	вт_ПлановыеМатериальныеЗатраты.КалькуляцияДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ПлановыеПрочиеЗатраты.Калькуляция,
		|	вт_ПлановыеПрочиеЗатраты.ПартияСпецификация,
		|	вт_ПлановыеПрочиеЗатраты.КалькуляцияДата,
		|	СУММА(ЕСТЬNULL(ПлановыеПрочиеЗатратыОбороты.СтоимостьБезНДСОборот, 0))
		|ИЗ
		|	вт_ПлановыеПрочиеЗатраты КАК вт_ПлановыеПрочиеЗатраты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПлановыеПрочиеЗатраты.Обороты(, , , ) КАК ПлановыеПрочиеЗатратыОбороты
		|		ПО вт_ПлановыеПрочиеЗатраты.Калькуляция = ПлановыеПрочиеЗатратыОбороты.Калькуляция
		|			И вт_ПлановыеПрочиеЗатраты.КалькуляцияДата = ПлановыеПрочиеЗатратыОбороты.Калькуляция.Дата
		|			И вт_ПлановыеПрочиеЗатраты.ПартияСпецификация = ПлановыеПрочиеЗатратыОбороты.ПартияСпецификация
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &БезОтбораПоСтатьям
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ПлановыеПрочиеЗатратыОбороты.СтатьяКалькуляции В (&СтатьяКалькуляции)
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПлановыеПрочиеЗатраты.ПартияСпецификация,
		|	вт_ПлановыеПрочиеЗатраты.Калькуляция,
		|	вт_ПлановыеПрочиеЗатраты.КалькуляцияДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ПлановыеТрудозатратыОбороты.Калькуляция,
		|	вт_ПлановыеТрудозатратыОбороты.ПартияСпецификация,
		|	вт_ПлановыеТрудозатратыОбороты.КалькуляцияДата,
		|	СУММА(ЕСТЬNULL(ПлановыеТрудозатратыОбороты.СтоимостьОборот, 0))
		|ИЗ
		|	вт_ПлановыеТрудозатратыОбороты КАК вт_ПлановыеТрудозатратыОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПлановыеТрудозатраты.Обороты(, , , ) КАК ПлановыеТрудозатратыОбороты
		|		ПО вт_ПлановыеТрудозатратыОбороты.Калькуляция = ПлановыеТрудозатратыОбороты.Калькуляция
		|			И вт_ПлановыеТрудозатратыОбороты.КалькуляцияДата = ПлановыеТрудозатратыОбороты.Калькуляция.Дата
		|			И вт_ПлановыеТрудозатратыОбороты.ПартияСпецификация = ПлановыеТрудозатратыОбороты.ПартияСпецификация
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &БезОтбораПоСтатьям
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ПлановыеТрудозатратыОбороты.СтатьяКалькуляции В (&СтатьяКалькуляции)
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПлановыеТрудозатратыОбороты.ПартияСпецификация,
		|	вт_ПлановыеТрудозатратыОбороты.Калькуляция,
		|	вт_ПлановыеТрудозатратыОбороты.КалькуляцияДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(вт_Итого.СтоимостьОборот) КАК СтоимостьОборот
		|ИЗ
		|	вт_Итого КАК вт_Итого";
	
	Запрос.УстановитьПараметр("ДатаДокумента", Объект.Дата);
	Запрос.УстановитьПараметр("ПартияСпецификация", ОсновнаяСпецификация);
	Запрос.УстановитьПараметр("СтатьяКалькуляции", Справочники.бит_ЗначенияПоУмолчанию.ПолучитьМассивЗначений(Справочники.бит_ЗначенияПоУмолчанию.ПрямыеЗатратыВАктахБрака, ЭтотОбъект));
	Запрос.УстановитьПараметр("БезОтбораПоСтатьям", БезОтбораПоСтатьям);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.СтоимостьОборот
	КонецЦикла;
	
	Возврат 0;

КонецФункции  

&НаСервере
Функция ПолучитьОсновнуюСпецификацию(Номенклатура, НачалоПроизводства)
	
	ПараметрыВыбораСпецификаций = УправлениеДаннымиОбИзделияхКлиентСервер.ПараметрыВыбораСпецификаций();
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоНоменклатуре", Истина);
	ПараметрыВыбораСпецификаций.Вставить("ПолучитьСпецификацииПоСпискуНоменклатуры", Ложь);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеПараметрыНазначения", Новый Массив);
	ПараметрыВыбораСпецификаций.Вставить("ИгнорируемыеУточненияПрименения", Новый Массив);
	
	ДанныеОбИзделии = УправлениеДаннымиОбИзделияхКлиентСервер.СтруктураДанныхОбИзделииДляВыбораСпецификации();
	ДанныеОбИзделии.Номенклатура = Номенклатура;	
	ДанныеОбИзделии.НачалоПроизводства = НачалоПроизводства;
	
	Результат = УправлениеДаннымиОбИзделиях.СпецификацииИзделия(ДанныеОбИзделии, ПараметрыВыбораСпецификаций);
	
	ИсключитьСпецификацию = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Спецификации             = Новый Массив;
	ПриоритетнаяСпецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	
	Для Индекс = 0 По Результат.ВГраница() Цикл
		ТекущаяСпецификация = Результат[Индекс].Спецификация;
		Если ПриоритетнаяСпецификация.Пустая()
				И Результат[Индекс].ПодбираетсяАвтоматически = Истина Тогда
			ПриоритетнаяСпецификация = ТекущаяСпецификация;
		КонецЕсли;
		Если ТекущаяСпецификация <> ИсключитьСпецификацию Тогда
			Спецификации.Добавить(ТекущаяСпецификация);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ПриоритетнаяСпецификация;
	
КонецФункции

&НаСервере
Процедура ВосстановлениеПриИзмененииНаСервере()
	
	ИтогоКУдержанию = 0;
	
	Для Каждого СтрокаТЧ Из Объект.Восстановление Цикл
		ИтогоКУдержанию = ИтогоКУдержанию + СтрокаТЧ.Сумма;
	КонецЦикла;                                            
	
	Объект.ИтогоКУдержаниюВосстановление = ИтогоКУдержанию;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановлениеПриИзменении(Элемент)
	ВосстановлениеПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтходыПриИзмененииНаСервере()
	
	ИтогоКУдержанию = 0;
	
	Для Каждого СтрокаТЧ Из Объект.Отходы Цикл
		ИтогоКУдержанию = ИтогоКУдержанию + СтрокаТЧ.КУдержанию;
	КонецЦикла;                                            
	
	Объект.ИтогоКУдержаниюОтходы = ИтогоКУдержанию;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтходыПриИзменении(Элемент)
	ОтходыПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПеремаркировкаКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Перемаркировка.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.КУдержанию = (ТекущиеДанные.ПолнаяСебестоимостьЗабракованнойНоменклатуры - ТекущиеДанные.ПолнаяСебестоимостьПеремаркированнойНоменклатуры) * ТекущиеДанные.Количество;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеремаркировкаНоменклатураЗабракованнаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Перемаркировка.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.ПолнаяСебестоимостьЗабракованнойНоменклатуры = ПолучитьСуммуПрямыхЗатрат(ТекущиеДанные.НоменклатураЗабракованная, Истина);
		ПеремаркировкаКоличествоПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеремаркировкаПеремаркированоВПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Перемаркировка.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.ПолнаяСебестоимостьПеремаркированнойНоменклатуры = ПолучитьСуммуПрямыхЗатрат(ТекущиеДанные.ПеремаркированоВ, Истина);
		ПеремаркировкаКоличествоПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеремаркировкаПриИзменении(Элемент)
	
	ИтогоКУдержанию = 0;
	
	Для Каждого СтрокаТЧ Из Объект.Перемаркировка Цикл
		ИтогоКУдержанию = ИтогоКУдержанию + СтрокаТЧ.КУдержанию;
	КонецЦикла;                                            
	
	Объект.ИтогоКУдержаниюПеремаркировка = ИтогоКУдержанию;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуНаСервере()
	Объект.ОбщийУщербКУдержанию = Объект.ИтогоКУдержаниюОтходы + Объект.ИтогоКУдержаниюВосстановление + Объект.ИтогоКУдержаниюПеремаркировка;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСумму(Команда)
	РассчитатьСуммуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтходыСуммаПлановоУчетнаяПриИзменении(Элемент)
	ОтходыКоличествоПриИзменении(Неопределено);
КонецПроцедуры
