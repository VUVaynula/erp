&НаСервере
Процедура ДополнитьЗадачу()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.Предмет = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачаИсполнителя.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
		ВыборкаДетальныеЗаписи.Следующий();  
		ТекущаяЗадача = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ТекущаяЗадача.ПринятаКИсполнению = Истина;
		ТекущаяЗадача.ДатаПринятияКИсполнению = ТекущаяДатаСеанса();  
	КонецЕсли;
    //Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -		
КонецПроцедуры	

&НаКлиенте                       
Процедура бит_ПроверкаДоступностиОбьекта()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Если Не Объект.ДоступностьФормы и Объект.Проведен Тогда
		Элементы.ГруппаШапка.Доступность = Ложь;
		Элементы.Страницы.Доступность = Ложь;
	Иначе
		Элементы.ГруппаШапка.Доступность = Истина;
		Элементы.Страницы.Доступность = Истина;
	КонецЕсли;
	 
	Если Объект.Проведен Тогда
		Элементы.бит_ПринятьВРаботу.Доступность = Истина;
	Иначе 
		Элементы.бит_ПринятьВРаботу.Доступность = Ложь;
	КонецЕсли;		 
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры 

