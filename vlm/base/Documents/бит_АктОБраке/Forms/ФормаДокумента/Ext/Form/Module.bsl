Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Если Объект.Статус.Пустая() Тогда
		
		Объект.Статус = Перечисления.бит_СтатусыОБраке.АктСформированСК;  
		Объект.ТекущийСтатус = Перечисления.бит_СтатусыОБраке.АктСформированСК; 
		
	КонецЕсли;  
	
	Объект.ТекущийСтатус = Объект.Статус;
	
	Если РольДоступна("бит_КонтрольКачестваЧтение") Тогда 
		Элементы.бит_ПринятьВРаботу.Доступность = Ложь;	 
	КонецЕсли; 
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.УспешностьСогласования = 1;	 
	КонецЕсли;	 
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
