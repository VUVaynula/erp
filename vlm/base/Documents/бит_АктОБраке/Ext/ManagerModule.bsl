#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс
#Область ДляВызоваИзДругихПодсистем
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт  
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	КомандаОтчет = Отчеты.бит_ИсторияИзмененийАктОБраке.ДобавитьКомандуОтчета(КомандыОтчетов, Параметры);
	Если КомандаОтчет <> Неопределено Тогда
		КомандаОтчет.ВидимостьВФормах = "ФормаДокумента,ФормаСписка";; 
		КомандаОтчет.Порядок = 1;
	КонецЕсли;
    //Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры
#КонецОбласти 

#Область Печать
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	//Первыйбит ЛТ9.9 ЛапшовГ "GVLapshov@1cbit.ru" 14.03.2025 + 
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "бит_АктОБраке";
	КомандаПечати.Представление = НСтр("ru = '(бит) Акт о браке'"); 
	//Первыйбит ЛТ9.9 ЛапшовГ "GVLapshov@1cbit.ru" 14.03.2025 -
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	//Первыйбит ЛТ9.9 ЛапшовГ "GVLapshov@1cbit.ru" 14.03.2025 +
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "бит_АктОБраке");
	Если ПечатнаяФорма <> Неопределено Тогда
		
		Заголовок = НСтр("ru = '(бит) Акт о браке'");
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"бит_АктОБраке", 
		Заголовок,
		бит_СформироватьПечатнуюФормуАктОБраке(МассивОбъектов),
		,
		"Документ.бит_АктОБраке.бит_ПФMXL_АктОБраке");
	КонецЕсли; 
	//Первыйбит ЛТ9.9 ЛапшовГ "GVLapshov@1cbit.ru" 14.03.2025 -

КонецПроцедуры   

Функция бит_СформироватьПечатнуюФормуАктОБраке(МассивОбъектов)
	
	//Первыйбит ЛТ9.9 ЛапшовГ "GVLapshov@1cbit.ru" 14.03.2025 +
	
	УстановитьПривилегированныйРежим(Истина);  
	ПараметрыПечати = ИСТИНА;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	ТабличныйДокумент.КлючПараметровПечати = "бит_АктОБраке";
	
	Выборка = ВыборкаДанныхДляПечати(МассивОбъектов);
	
	ВыборкаШапка = Выборка.ВыборкаШапка;
			
	Если ВыборкаШапка.Количество() > 1 Тогда
		ТекстСообщения = "По акту не может быть забраковано больше одного изделия!"; 
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено; 
	КонецЕсли;	
    
	Макет = ПолучитьМакет("бит_ПФMXL_АктОБраке");

	//Шапка
	ВыборкаШапка = ВыборкаШапка[0];
	
	ПричиныБрака = ВыборкаШапка.Ссылка.ПричиныБрака;	
	
	ОбластьШапка 							= Макет.ПолучитьОбласть("Шапка");
	//ОбластьШапка.Параметры.Номер 	= ВыборкаШапка.Номер;
	 
	//ОбластьШапка.Параметры.Цех 	= ВыборкаШапка.Цех; 
	//ОбластьШапка.Параметры.Участок 	= ВыборкаШапка.Участок; 
	//ОбластьШапка.Параметры.Смена 	= ВыборкаШапка.Смена; 
	//ОбластьШапка.Параметры.МаркаИзделия 	= ВыборкаШапка.МаркаИзделия; 
	//ОбластьШапка.Параметры.ОперацияОбнаружения 	= ВыборкаШапка.ОперацияОбнаружения; 
	//ОбластьШапка.Параметры.ТабНомер 	= ВыборкаШапка.ТабНомер;  
	//ОбластьШапка.Параметры.Сотрудник 	= ВыборкаШапка.Сотрудник;    	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаШапка);
	ОбластьШапка.Параметры.Дата 	= Формат(ВыборкаШапка.Дата, "ДЛФ=Д");
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьПустаяСтрока 					= Макет.ПолучитьОбласть("ПустаяСтрока");
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	ОбластьШапкаТЧДанныеОБраке 				= Макет.ПолучитьОбласть("ШапкаТЧДанныеОБраке");
	ТабличныйДокумент.Вывести(ОбластьШапкаТЧДанныеОБраке);
	
	ОбластьСтрокаТЧДанныеОБраке 			= Макет.ПолучитьОбласть("СтрокаТЧДанныеОБраке");
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.НомерБарабана 	= ВыборкаШапка.НомерБарабана; 
	
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.ВидБрака 	= ВыборкаШапка.ВидБрака;      
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.Количество 	= ВыборкаШапка.Количество; 
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.ЕдиницаИзмерения 	= ВыборкаШапка.ЕдиницаИзмерения; 
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.Отходы 	= ВыборкаШапка.Отходы;    
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.Восстановление 	= ВыборкаШапка.Восстановление; 
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.ПослеРазбраковки 	= ВыборкаШапка.ПослеРазбраковки; 
	//ОбластьСтрокаТЧДанныеОБраке.Параметры.Виновник 	= ВыборкаШапка.Виновник;   
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТЧДанныеОБраке.Параметры, ВыборкаШапка);
	ТабличныйДокумент.Вывести(ОбластьСтрокаТЧДанныеОБраке);

	//КалькуляцияБракабезЗП  
	ВыборкаОтход = Выборка.ВыборкаОтход;
	ВыборкаВосстановление = Выборка.ВыборкаВосстановление;
	
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	ОбластьШапкаТЧКББезЗП 					= Макет.ПолучитьОбласть("ШапкаТЧКББезЗП");
	ТабличныйДокумент.Вывести(ОбластьШапкаТЧКББезЗП);
    ОбластьШапкаТЧКББезЗПОтходы 			= Макет.ПолучитьОбласть("ШапкаТЧКББезЗПОтходы");
	ОбластьШапкаТЧКББезЗПОтходы.Параметры.ВидОтходов 	= ?(ЗначениеЗаполнено(ВыборкаШапка.ВидОтхода), ВыборкаШапка.ВидОтхода , "без отходов");
    ТабличныйДокумент.Вывести(ОбластьШапкаТЧКББезЗПОтходы); 
	
	ОбластьСтрокаТЧКББезЗПОтходы 			= Макет.ПолучитьОбласть("СтрокаТЧКББезЗПОтходы");
	ОтходыКоличество = 0;
	ОтходыСуммаПлановоУчетная = 0;
	ОтходыСуммаВозможногоИспользования = 0;
	КУдержанию = 0;
	Если ВыборкаОтход.Количество() = 0 Тогда
		ТабличныйДокумент.Вывести(ОбластьСтрокаТЧКББезЗПОтходы);
	Иначе
		Для Каждого Запись Из ВыборкаОтход Цикл
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыМатериал 	= Запись.Материал;	
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыКоличество 	= Запись.Количество;
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыЕдиницаИзмерения 	= Запись.ЕдиницаИзмерения;
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыЦенаПлановоУчетная 	= Запись.ЦенаПлановоУчетная;
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыСуммаПлановоУчетная 	= Запись.СуммаПлановоУчетная;
			//ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыСтоимостьВозможногоИспользования 	= Запись.СтоимостьВозможногоИспользования;
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.СтрокаТЧКББезЗПОтходыСуммаВозможногоИспользования 	= Запись.СуммаВозможногоИспользования;
			ОбластьСтрокаТЧКББезЗПОтходы.Параметры.КУдержанию 	= Запись.КУдержанию;
			ТабличныйДокумент.Вывести(ОбластьСтрокаТЧКББезЗПОтходы);
			ОтходыКоличество = ОтходыКоличество + Запись.Количество;
			ОтходыСуммаПлановоУчетная = ОтходыСуммаПлановоУчетная + Запись.СуммаПлановоУчетная;
			ОтходыСуммаВозможногоИспользования = ОтходыСуммаВозможногоИспользования +  Запись.СуммаВозможногоИспользования;
			//КУдержанию = КУдержанию + Запись.СуммаПлановоУчетная - Запись.СуммаВозможногоИспользования;
			КУдержанию = КУдержанию + Запись.КУдержанию; 
		КонецЦикла;
	КонецЕсли;
	
    ОбластьИтогТЧКББезЗПОтходы 				= Макет.ПолучитьОбласть("ИтогТЧКББезЗПОтходы");
	ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыКоличество 	= ОтходыКоличество;
	//ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыЕдиницаИзмерения 	= "х";
	//ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыЦенаПлановоУчетная 	= "х";
	ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыСуммаПлановоУчетная 	= ОтходыСуммаПлановоУчетная;
	//ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыСтоимостьВозможногоИспользования 	= "х";
	ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыСуммаВозможногоИспользования = ОтходыСуммаВозможногоИспользования;
	ОбластьИтогТЧКББезЗПОтходы.Параметры.ИтогТЧКББезЗПОтходыКУдержанию 	= КУдержанию;
	ТабличныйДокумент.Вывести(ОбластьИтогТЧКББезЗПОтходы);
	
	
	
	
	ВыборкаПеремаркировка = Выборка.ВыборкаПеремаркировка;
	
	КУдержанию = 0;
	
	Пока ВыборкаВосстановление.Следующий() Цикл
				
		ВосстановлениеКоличество = 0;
		ВосстановлениеСуммаПлановоУчетная = 0;
		
		//ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.ВидВосстановления = ВыборкаВосстановление.ВидОперации;
		ОбластьШапкаТЧКББезЗПВосстановление		= Макет.ПолучитьОбласть("ШапкаТЧКББезЗПВосстановление");
		ОбластьШапкаТЧКББезЗПВосстановление.Параметры.ВидВосстановления = ВыборкаВосстановление.ВидОперации;	
		ТабличныйДокумент.Вывести(ОбластьШапкаТЧКББезЗПВосстановление);
		
		ВыборкаДетальныеЗаписи = ВыборкаВосстановление.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ОбластьСтрокаТЧКББезЗПВосстановление 	= Макет.ПолучитьОбласть("СтрокаТЧКББезЗПВосстановление");
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеМатериал 	= ВыборкаДетальныеЗаписи.Материал;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеКоличество 	= ВыборкаДетальныеЗаписи.Количество;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеЕдиницаИзмерения 	= ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;		
			
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеСуммаПлановоУчетная 	= ВыборкаДетальныеЗаписи.Сумма;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.КУдержанию 	= ВыборкаДетальныеЗаписи.Сумма;
			ТабличныйДокумент.Вывести(ОбластьСтрокаТЧКББезЗПВосстановление);
			
			ВосстановлениеКоличество = ВосстановлениеКоличество + ВыборкаДетальныеЗаписи.Количество;
			ВосстановлениеСуммаПлановоУчетная = ВосстановлениеСуммаПлановоУчетная + ВыборкаДетальныеЗаписи.Сумма;
			//КонецЦикла; 
			
			КУдержанию = КУдержанию + ВыборкаДетальныеЗаписи.Сумма;
			
		КонецЦикла;
				
	КонецЦикла;
	
	Если ВыборкаПеремаркировка.Количество() <> 0 Тогда
		
		ОбластьШапкаТЧКББезЗПВосстановление		= Макет.ПолучитьОбласть("ШапкаТЧКББезЗПВосстановление");
		ОбластьШапкаТЧКББезЗПВосстановление.Параметры.ВидВосстановления = "перемаркировка";	
		ТабличныйДокумент.Вывести(ОбластьШапкаТЧКББезЗПВосстановление);
		
		Для Каждого Запись Из ВыборкаПеремаркировка Цикл
			ОбластьСтрокаТЧКББезЗПВосстановление 	= Макет.ПолучитьОбласть("СтрокаТЧКББезЗПВосстановление");
			
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеМатериал 	= Запись.Материал;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеКоличество 	= Запись.Количество;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеЕдиницаИзмерения 	= Запись.ЕдиницаИзмерения;
			
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.СтрокаТЧКББезЗПВосстановлениеСуммаПлановоУчетная	= Запись.ПолнаяСебестоимостьЗабракованнойНоменклатуры;
			ОбластьСтрокаТЧКББезЗПВосстановление.Параметры.КУдержанию 	= Запись.КУдержанию;
			ТабличныйДокумент.Вывести(ОбластьСтрокаТЧКББезЗПВосстановление);
			
			КУдержанию = КУдержанию + Запись.КУдержанию;
			
		КонецЦикла;
		
	КонецЕсли;

	
    ОбластьИтогТЧКББезЗПВосстановление = Макет.ПолучитьОбласть("ИтогТЧКББезЗПВосстановление");
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеКоличество 	= ВосстановлениеКоличество;
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеЕдиницаИзмерения 	= "х";
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеЦенаПлановоУчетная 	= "х";
	ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеСуммаПлановоУчетная = ВосстановлениеСуммаПлановоУчетная;
	ОбластьИтогТЧКББезЗПВосстановление.Параметры.КУдержанию = КУдержанию;
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеСтоимостьВозможногоИспользования 	= "х";
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеСуммаВозможногоИспользования 	= "х";
	//ОбластьИтогТЧКББезЗПВосстановление.Параметры.ИтогТЧКББезЗПВосстановлениеКУдержанию 	= "х";
	ТабличныйДокумент.Вывести(ОбластьИтогТЧКББезЗПВосстановление);

	//КалькуляцияБракаСЗП
