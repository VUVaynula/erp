Функция ПроверкаНачалаСогласования()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СогласованиеАктОБраке.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.бит_СогласованиеАктОБраке КАК бит_СогласованиеАктОБраке
		|ГДЕ
		|	бит_СогласованиеАктОБраке.Предмет = &Предмет
		|	И бит_СогласованиеАктОБраке.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Предмет", Ссылка);  
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если   РезультатЗапроса.Количество() > 0 Тогда
		Возврат Истина
	Иначе
		Возврат Ложь;
	КонецЕсли;
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецФункции	

Процедура ВыполнитьЗаписьВРегистрИстории(Статус)
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Попытка	
		Набор = РегистрыСведений.бит_ИсторияИзмененийСсогласованияАктовОБраке.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Запись = Набор.Добавить();
		Запись.Период = ТекущаяДатаСеанса();
		Запись.бит_Цех = Цех;
		Запись.бит_Исполнитель = Пользователи.ТекущийПользователь();
		Запись.бит_Действие = УспешностьСогласования;
		Запись.бит_ДатаРегистрацииСтатуса = ДатаРегистрацииСтатуса;
		Запись.бит_ДатаУстановкиСтатуса = ТекущаяДатаСеанса();             
		Запись.бит_СтатусДокумента = Статус;
		Запись.бит_Примечание = Примечание;
		Набор.Записать(Ложь); 
	Исключение
		ТекстСообщения = "Не удалось провести документ с таким набором данных!";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки; 
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -	
КонецПроцедуры

Процедура ПроверкаУспешностиСогласования(Отказ)  
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа КАК бит_НомерЭтапа,
		|	бит_ОчередностьЭтаповСогласований.бит_СтатусДокумента КАК бит_СтатусДокумента
		|ИЗ
		|	РегистрСведений.бит_ОчередностьЭтаповСогласований КАК бит_ОчередностьЭтаповСогласований
		|ГДЕ
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа <> 0 
		|	И (бит_ОчередностьЭтаповСогласований.бит_Цех = &Цех
		|			ИЛИ бит_ОчередностьЭтаповСогласований.бит_Цех = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ОчередностьЭтаповСогласований.бит_НомерЭтапа";
	
	Запрос.УстановитьПараметр("Цех", Цех);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НомерЭтапа = - 1; 
	Итератор = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = ТекущийСтатус
			И  НомерЭтапа < 0 Тогда 
			ВыборкаДетальныеЗаписи.Следующий();
			Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = Статус Тогда
				ЭтапВыполнен();
				Прервать;
			ИначеЕсли НомерЭтапа < 0 Тогда 
				НомерЭтапа = ВыборкаДетальныеЗаписи.бит_НомерЭтапа;
				ВыборкаДетальныеЗаписи.Сбросить();
				Итератор = Итератор +1;
			КонецЕсли;
			
		КонецЕсли;
		Если НомерЭтапа > 0 И 
			ВыборкаДетальныеЗаписи.бит_НомерЭтапа = НомерЭтапа - 2 Тогда
			Если ВыборкаДетальныеЗаписи.бит_СтатусДокумента = Статус Тогда
				ЭтапНеВыполнен();
				Прервать;
			Иначе 
				ТекстСообщения = "Статус указан не верно!";
				Отказ = Истина;  
				бит_ДоступностьФормы = Истина;
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
		КонецЕсли;
		Если Итератор > 20 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;  
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры 

Процедура ЭтапВыполнен()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +				
	ТекущаяЗадача = ПолучитьЗадачу();
	Если Не ТекущаяЗадача = Неопределено Тогда 
		ТекущаяЗадача = ТекущаяЗадача.ПолучитьОбъект(); 
		ТекущаяЗадача.Исполнитель = Пользователи.ТекущийПользователь();
		ТекущаяЗадача.Дата = ТекущаяДатаСеанса();
		ТекущаяЗадача.ДатаИсполнения = ТекущаяДатаСеанса();
		ТекущаяЗадача.ВыполнитьЗадачу();  
		УспешностьСогласования = 1;
		ТекущийСтатус = Статус;
	КонецЕсли;
    //Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры	
	
Процедура ЭтапНеВыполнен()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	УспешностьСогласования = 0;
    ВыполнитьЗаписьВРегистрИстории(ТекущийСтатус);
	ЗаполнитьПрошлыйЭтап();
	ТекущаяЗадача = ПолучитьЗадачу();
	Если Не ТекущаяЗадача = Неопределено Тогда 
		ТекущаяЗадача = ТекущаяЗадача.ПолучитьОбъект(); 
		БизнесПроцесс = ТекущаяЗадача.БизнесПроцесс.ПолучитьОбъект();
		БизнесПроцесс.Статус = Статус; 
		БизнесПроцесс.Записать();
		ТекущаяЗадача.Исполнитель = Пользователи.ТекущийПользователь();
		ТекущаяЗадача.ДатаИсполнения = ТекущаяДатаСеанса();
		ТекущаяЗадача.ВыполнитьЗадачу();
	КонецЕсли;
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецПроцедуры

Функция  ПолучитьЗадачу() 
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.Предмет = &Ссылка
		|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачаИсполнителя.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
		ВыборкаДетальныеЗаписи.Следующий();  
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
КонецФункции	

Процедура ЗаполнитьПрошлыйЭтап()
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Запрос = Новый Запрос;
