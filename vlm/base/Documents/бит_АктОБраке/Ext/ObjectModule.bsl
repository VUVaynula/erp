			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.бит_БракВозвратСрезкаПродукции.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
                      |	бит_АктОБракеВосстановление.Материал КАК Номенклатура,
                      |	СУММА(бит_АктОБракеВосстановление.Количество) КАК ВосстановлениеКоличество,
                      |	СУММА(бит_АктОБракеВосстановление.Сумма) КАК ВосстановлениеСумма
                      |ПОМЕСТИТЬ Восстановление
                      |ИЗ
                      |	Документ.бит_АктОБраке.Восстановление КАК бит_АктОБракеВосстановление
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеОБраке КАК ДанныеОБраке
                      |		ПО бит_АктОБракеВосстановление.Материал = ДанныеОБраке.Номенклатура
                      |ГДЕ
                      |	бит_АктОБракеВосстановление.Ссылка = &Ссылка
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	бит_АктОБракеВосстановление.Материал
                      |;
                      |
                      |////////////////////////////////////////////////////////////////////////////////
                      |ВЫБРАТЬ
                      |	бит_АктОБракеОтходы.Материал КАК Материал,
                      |	СУММА(бит_АктОБракеОтходы.Количество) КАК ОтходыКоличество,
                      |	СУММА(бит_АктОБракеОтходы.КУдержанию) КАК ОтходыКУдержанию
                      |ПОМЕСТИТЬ отходы
                      |ИЗ
                      |	ДанныеОБраке КАК ДанныеОБраке
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.бит_АктОБраке.Отходы КАК бит_АктОБракеОтходы
                      |		ПО ДанныеОБраке.Номенклатура = бит_АктОБракеОтходы.Материал
                      |ГДЕ
                      |	бит_АктОБракеОтходы.Ссылка = &Ссылка
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	бит_АктОБракеОтходы.Материал
                      |;
                      |
                      |////////////////////////////////////////////////////////////////////////////////
                      |ВЫБРАТЬ
                      |	ДанныеОБраке.Номенклатура КАК Номенклатура,
                      |	ЕстьNull(Восстановление.ВосстановлениеКоличество,0) КАК ВосстановлениеКоличество,
                      |	ЕстьNull(Восстановление.ВосстановлениеСумма,0) КАК ВосстановлениеСумма,
                      |	ЕстьNull(отходы.ОтходыКоличество,0) КАК ОтходыКоличество,
                      |	ЕстьNull(отходы.ОтходыКУдержанию,0) КАК ОтходыКУдержанию
                      |ИЗ
                      |	ДанныеОБраке КАК ДанныеОБраке
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Восстановление КАК Восстановление
                      |		ПО ДанныеОБраке.Номенклатура = Восстановление.Номенклатура
                      |		ЛЕВОЕ СОЕДИНЕНИЕ отходы КАК отходы
                      |		ПО ДанныеОБраке.Номенклатура = отходы.Материал";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Регистратор = ЭтотОбъект.Ссылка;
			НоваяЗапись.Документ = ЭтотОбъект.Ссылка;
			НоваяЗапись.Период = ЭтотОбъект.Дата;
		
			НоваяЗапись.Номенклатура = Выборка.Номенклатура;
			
			НоваяЗапись.Статус 		 = ЭтотОбъект.Статус;
			НоваяЗапись.ВиновноеЛицо = тзВиновник[0].Виновник;
			
			НоваяЗапись.КоличествоИсправимогоБракаПоВинеРаботника 	 = Выборка.ВосстановлениеКоличество;
			НоваяЗапись.СтоимостьИсправимогоБракаПоВинеРаботника 	 = Выборка.ВосстановлениеСумма;
			НоваяЗапись.КоличествоОкончательногоБракаПоВинеРаботника = Выборка.ОтходыКоличество;
