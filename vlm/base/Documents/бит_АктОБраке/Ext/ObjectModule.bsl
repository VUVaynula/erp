
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 +
	Если УспешностьСогласования = -1 Тогда
		УспешностьСогласования = 1
	КонецЕсли;
	
	Если ТекущийСтатус <> Статус и Проведен Тогда 
		ВыполнитьЗаписьВРегистрИстории(Статус);
	КонецЕсли;
	
	Если ПроверкаНачалаСогласования() Тогда 
		ПроверкаУспешностиСогласования(Отказ);
	КонецЕсли;                        
	
	Если ТекущийСтатус = Перечисления.бит_СтатусыОБраке.АктСформированСК и НачатоСогласование = Ложь Тогда
		
		ДатаУстановкиСтатуса = ТекущаяДатаСеанса();
		Движения.бит_ИсторияИзмененийСсогласованияАктовОБраке.Записывать = Истина;
		Движение = Движения.бит_ИсторияИзмененийСсогласованияАктовОБраке.Добавить(); 
		
		Движение.Период = ТекущаяДатаСеанса();
		Движение.бит_Цех = Цех;
		Движение.бит_СтатусДокумента = Статус;
		Движение.бит_Действие = УспешностьСогласования;
		Движение.бит_Исполнитель = Пользователи.ТекущийПользователь();
		Движение.бит_ДатаРегистрацииСтатуса = ДатаРегистрацииСтатуса;
		Движение.бит_ДатаУстановкиСтатуса = ДатаУстановкиСтатуса;
		Движение.бит_Примечание = Примечание;
		
	КонецЕсли;	 
	
	Если не ПроверкаНачалаСогласования() Тогда
		
		НовйБизнесПроцесс = БизнесПроцессы.бит_СогласованиеАктОБраке.СоздатьБизнесПроцесс();
		НовйБизнесПроцесс.Дата = ТекущаяДатаСеанса(); 
		НовйБизнесПроцесс.Предмет  = Ссылка;
		НовйБизнесПроцесс.Автор = Пользователи.ТекущийПользователь();
		НовйБизнесПроцесс.ДатаНачала = ТекущаяДатаСеанса();
		НовйБизнесПроцесс.ДатаЗавершения = ТекущаяДатаСеанса() + 864000;  
		НовйБизнесПроцесс.Статус = Статус; 
		СтрокаРецензии = НовйБизнесПроцесс.Рецензии.Добавить();
		
		НовйБизнесПроцесс.Записать();
		НовйБизнесПроцесс.Старт();  
		ДатаУстановкиСтатуса = ТекущаяДатаСеанса();
		ТекущийСтатус = Статус;
		НачатоСогласование = Истина; 
		ДатаРегистрацииСтатуса = ТекущаяДатаСеанса();
		ДоступностьФормы = Ложь;
		
	КонецЕсли;	    
	
	ДоступностьФормы = Ложь;
	Исполнитель = Пользователи.ТекущийПользователь();
	//Первыйбит ЛТ24 ЛапшовГ "GVLapshov@1cbit.ru" 06.12.2024 -
	
	// {{ПервыйБИТ ЛистТребований [ЛТ9.10]  [VUVaynula@1cbit.ru] [03.09.2025 15:53:19] +        
	Если Не Отказ Тогда 
		// найдем виновника. по условиям он должен быть один на весь документ. пустые допускаются, но в движения не попадут.
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
		Запрос.Текст ="ВЫБРАТЬ
		              |	бит_АктОБракеДанныеОБраке.Номенклатура КАК Номенклатура,
		              |	бит_АктОБракеДанныеОБраке.Виновник КАК Виновник
		              |ПОМЕСТИТЬ ДанныеОБраке
		              |ИЗ
		              |	Документ.бит_АктОБраке.ДанныеОБраке КАК бит_АктОБракеДанныеОБраке
		              |ГДЕ
		              |	бит_АктОБракеДанныеОБраке.Ссылка = &Ссылка
		              |	И бит_АктОБракеДанныеОБраке.Виновник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		              |	И бит_АктОБракеДанныеОБраке.Виновник ССЫЛКА Справочник.Сотрудники
		              |
		              |СГРУППИРОВАТЬ ПО
		              |	бит_АктОБракеДанныеОБраке.Номенклатура,
		              |	бит_АктОБракеДанныеОБраке.Виновник
		              |;
		              |
		              |////////////////////////////////////////////////////////////////////////////////
		              |ВЫБРАТЬ РАЗЛИЧНЫЕ
		              |	ДанныеОБраке.Виновник КАК Виновник
		              |ИЗ
		              |	ДанныеОБраке КАК ДанныеОБраке";   
