				УпаковкаЧислитель = ?(СтрокаДокумента.Упаковка.Числитель = Неопределено, 1, СтрокаДокумента.Упаковка.Числитель);    
				УпаковкаЗнаменатель = ?(СтрокаДокумента.Упаковка.Знаменатель = Неопределено, 1, СтрокаДокумента.Упаковка.Знаменатель); 
				УпаковкаЧислитель = ?(УпаковкаЧислитель = 0, 1, СтрокаДокумента.Упаковка.Числитель);    
				УпаковкаЗнаменатель = ?(УпаковкаЗнаменатель = 0, 1, СтрокаДокумента.Упаковка.Знаменатель);
				ФактическиОтгружено = Отгружено / УпаковкаЧислитель * УпаковкаЗнаменатель; 
