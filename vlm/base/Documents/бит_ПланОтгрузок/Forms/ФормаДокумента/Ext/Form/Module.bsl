#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	ПорядокОформленияНакладныхОрдеров = Константы.ПорядокОформленияНакладныхРасходныхОрдеров.Получить();
	
	Если ПорядокОформленияНакладныхОрдеров = Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаОрдера Тогда
		Если Не ЗначениеЗаполнено(Объект.бит_Ответственный) Тогда
			Объект.бит_Ответственный = ПользователиКлиентСервер.ТекущийПользователь();	 
		КонецЕсли;
		
		Если Не Константы.ИспользоватьНесколькоОрганизаций.Получить() 
			И Не ЗначениеЗаполнено(Объект.бит_Организация) Тогда
			Объект.бит_Организация = Справочники.Организации.ОрганизацияПоУмолчанию(); 
		КонецЕсли;
	Иначе
		Отказ = Истина;
		ТекстСообщения = "Некорректно указан порядок оформления накладных,расходных ордеров!";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	Объект.бит_Автор = ПользователиКлиентСервер.ТекущийПользователь(); 
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
КонецПроцедуры
