#Область Локальные 
&НаКлиенте
Процедура бит_ИзменениеПериода(Команда)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	Если ЗначениеЗаполнено(Объект.бит_НачалоПериода) Или ЗначениеЗаполнено(Объект.бит_КонецПериода) Тогда
		НачалоПериода = Объект.бит_НачалоПериода;
		КонецПериода = Объект.бит_КонецПериода;	
	Иначе
		НачалоПериода = ТекущаяДата();
		КонецПериода = ТекущаяДата();
	КонецЕсли;
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыПодбора.Вставить("КонецПериода", КонецПериода); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаДень", ПараметрыПодбора, ЭтотОбъект, , , , ОписаниеОповещения);
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	НачалоПериода = НачалоНедели(РезультатВыбора.НачалоПериода);	
	КонецПериода = КонецНедели(РезультатВыбора.КонецПериода);
	ОкончаниеДляПроверки = КонецНедели(РезультатВыбора.НачалоПериода);
	Если КонецПериода = ОкончаниеДляПроверки Тогда
		Объект.бит_НачалоПериода = НачалоПериода;
		Объект.бит_КонецПериода = КонецПериода;
	Иначе 
		Объект.бит_НачалоПериода = НачалоПериода;
		Объект.бит_КонецПериода = ОкончаниеДляПроверки;
    КонецЕсли;
		
	ЭтаФорма.ОбновитьОтображениеДанных();
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 -
КонецПроцедуры

&НаКлиенте
Процедура бит_Заполнить(Команда)
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
	ТекстСообщения = "";
	
	Если Не (ЗначениеЗаполнено(Объект.бит_НачалоПериода) и ЗначениеЗаполнено(Объект.бит_КонецПериода)) Тогда
		ТекстСообщения = "Период не заполнен! ";	
	КонецЕсли;
	
	Если Не (ЗначениеЗаполнено(Объект.бит_Организация)) Тогда
		ТекстСообщения = ТекстСообщения + "Организация не указана! ";	
	КонецЕсли;
	
	Если ТекстСообщения = "" Тогда   
		Если Объект.бит_НачалоПериода > ТекущаяДата() Тогда
			Объект.бит_Товары.Очистить();
			бит_ПолучитьДанныеЗаполнеияСтратегияДо();
		Иначе
			бит_ПолучитьДанныеЗаполнеияСтратегияПосле();
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 +
КонецПроцедуры

&НаСервере
Процедура бит_ПолучитьДанныеЗаполнеияСтратегияДо()
	// Первыйбит ЛТ3.13 ЛапшовГ "GVLapshov@1cbit.ru" 01.04.2025 + 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.ДатаОтгрузки КАК ДатаОтгрузки,   
		|	ЗаказКлиентаТовары.бит_СрокИзготовления КАК СрокИзготовления,
		|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
		|	ЗаказКлиентаТовары.КодСтроки КАК КодСтроки,
		|	ЗаказКлиента.Партнер КАК Партнер,
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.бит_ВесНетто КАК бит_ВесНетто,
		|	ЗаказКлиента.Менеджер КАК Менеджер,
		|	ЗаказКлиента.Комментарий КАК Комментарий,
		|	ЗаказКлиента.Назначение КАК Назначение,
		|	ЗаказКлиентаТовары.Серия КАК Серия,
		|	ЕСТЬNULL(ЗаказКлиентаТовары.Упаковка.Числитель, 1) КАК УпаковкаЧислитель,
		|	ЕСТЬNULL(ЗаказКлиентаТовары.Упаковка.Знаменатель, 1) КАК УпаковкаЗнаменатель
		|ПОМЕСТИТЬ ВТ_ЗаказКлиента
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ПО (ЗаказКлиентаТовары.Ссылка = ЗаказКлиента.Ссылка)
		|ГДЕ
		|	ЗаказКлиентаТовары.ДатаОтгрузки >= &НачалоПериода
		|	И ЗаказКлиентаТовары.ДатаОтгрузки <= &КонецПериода
		|	И ЗаказКлиента.ПометкаУдаления = ЛОЖЬ
		|	И ЗаказКлиента.Проведен = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗапасыИПотребностиОстатки.Заказ КАК Заказ,
		|	ЗапасыИПотребностиОстатки.Номенклатура КАК Номенклатура,
		|	ЗапасыИПотребностиОстатки.Назначение КАК Назначение
		|ПОМЕСТИТЬ ВТ_ЗапасыИПотребности
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности КАК ЗапасыИПотребностиОстатки
		|ГДЕ
		|	(ЗапасыИПотребностиОстатки.Заказ ССЫЛКА Документ.ЗаказНаПроизводство
		|			ИЛИ ЗапасыИПотребностиОстатки.Заказ ССЫЛКА Документ.ЗаказНаПроизводство2_2)
		|	И ЗапасыИПотребностиОстатки.Номенклатура В
		|			(ВЫБРАТЬ
		|				ВТ_ЗаказКлиента.Номенклатура КАК Номенклатура
		|			ИЗ
		|				ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента)
		|	И ЗапасыИПотребностиОстатки.Назначение В
		|			(ВЫБРАТЬ
		|				ВТ_ЗаказКлиента.Назначение КАК Назначение
		|			ИЗ
		|				ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РаспоряженияНаОтгрузку.Номенклатура КАК Номенклатура,
		|	РаспоряженияНаОтгрузку.Распоряжение.Назначение КАК Назначение,
		|	РаспоряженияНаОтгрузку.Серия КАК Серия,
		|	РаспоряженияНаОтгрузку.Распоряжение КАК ДокументОтгрузки,
		|	РаспоряженияНаОтгрузку.КодСтроки КАК КодСтроки,
		|	- СУММА(РаспоряженияНаОтгрузку.КОформлению) КАК КОтгрузкеРасход
		|ПОМЕСТИТЬ ВТ_ТоварыКОтгрузке
		|ИЗ
		|	РегистрНакопления.РаспоряженияНаОтгрузку КАК РаспоряженияНаОтгрузку
		|ГДЕ
		|	РаспоряженияНаОтгрузку.Распоряжение В
		|			(ВЫБРАТЬ
		|				ВТ_ЗаказКлиента.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента)
		|	И РаспоряженияНаОтгрузку.КОформлению <= 0
		|
		|СГРУППИРОВАТЬ ПО
		|	РаспоряженияНаОтгрузку.Номенклатура,
		|	РаспоряженияНаОтгрузку.Распоряжение.Назначение,
		|	РаспоряженияНаОтгрузку.Серия,
		|	РаспоряженияНаОтгрузку.Распоряжение,
		|	РаспоряженияНаОтгрузку.КодСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗаказКлиента.ДатаОтгрузки КАК Дата,  
		|	ВТ_ЗаказКлиента.СрокИзготовления КАК СрокИзготовления,
		|	ВТ_ЗаказКлиента.Ссылка КАК ЗаказКлиента,
		|	ВТ_ЗапасыИПотребности.Заказ КАК ЗаказНаПроизводство,
		|	ВТ_ЗаказКлиента.Партнер КАК Клиент,
		|	ВТ_ЗаказКлиента.Номенклатура КАК Номенклатура,
		|	ВТ_ЗаказКлиента.бит_ВесНетто КАК бит_ВесНетто,
		|	ВТ_ТоварыКОтгрузке.КОтгрузкеРасход / ВТ_ЗаказКлиента.УпаковкаЧислитель * ВТ_ЗаказКлиента.УпаковкаЗнаменатель КАК КОтгрузкеРасход,
		|	ВТ_ЗаказКлиента.бит_ВесНетто - ВТ_ТоварыКОтгрузке.КОтгрузкеРасход / ВТ_ЗаказКлиента.УпаковкаЧислитель * ВТ_ЗаказКлиента.УпаковкаЗнаменатель КАК Отклонение,
		|	ВТ_ЗаказКлиента.Менеджер КАК Менеджер,
		|	ВТ_ЗаказКлиента.КодСтроки КАК КодСтроки,
		|	ВТ_ЗаказКлиента.Комментарий КАК Комментарий
		|ИЗ
		|	ВТ_ТоварыКОтгрузке КАК ВТ_ТоварыКОтгрузке
		|		ПРАВОЕ СОЕДИНЕНИЕ ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗапасыИПотребности КАК ВТ_ЗапасыИПотребности
		|			ПО ВТ_ЗаказКлиента.Номенклатура = ВТ_ЗапасыИПотребности.Номенклатура
		|				И ВТ_ЗаказКлиента.Назначение = ВТ_ЗапасыИПотребности.Назначение
		|		ПО (ВТ_ЗаказКлиента.Номенклатура = ВТ_ТоварыКОтгрузке.Номенклатура)
		|			И (ВТ_ТоварыКОтгрузке.Назначение = ВТ_ЗаказКлиента.Назначение
		|				ИЛИ ВТ_ТоварыКОтгрузке.ДокументОтгрузки = ВТ_ЗаказКлиента.Ссылка)
		|			И (ВТ_ЗаказКлиента.КодСтроки = ВТ_ТоварыКОтгрузке.КодСтроки)";
	
	Запрос.УстановитьПараметр("КонецПериода", Объект.бит_КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.бит_НачалоПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТовары = Объект.бит_Товары.Добавить();
		СтрокаТовары.бит_ДатаОтгрузки = ВыборкаДетальныеЗаписи.Дата;   
		СтрокаТовары.бит_СрокИзготовления = ВыборкаДетальныеЗаписи.СрокИзготовления;   // исправление после сквозного
		СтрокаТовары.бит_НомерЗаказаКлиента = ВыборкаДетальныеЗаписи.ЗаказКлиента;
		СтрокаТовары.бит_НомерЗаказаНаПроизводство = ВыборкаДетальныеЗаписи.ЗаказНаПроизводство;
		//СтрокаТовары.бит_СрокИсполнения =
		СтрокаТовары.бит_Клиент = ВыборкаДетальныеЗаписи.Клиент;
		СтрокаТовары.бит_Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		СтрокаТовары.бит_КОтгрузке = ВыборкаДетальныеЗаписи.бит_ВесНетто;
		СтрокаТовары.бит_ФактическиОтгружено = ВыборкаДетальныеЗаписи.КОтгрузкеРасход;
		СтрокаТовары.бит_Откл = ВыборкаДетальныеЗаписи.Отклонение;
		Если СтрокаТовары.бит_Откл < 0 Тогда
			СтрокаТовары.бит_Перегрузка = - ВыборкаДетальныеЗаписи.Отклонение;
